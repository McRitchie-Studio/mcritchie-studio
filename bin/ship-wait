#!/usr/bin/env sh
# bin/ship-wait — the old name of bin/submit-wait, kept as an alias for one release.
#
# bin/submit-wait hands a task to review and stops at `submitted`; the old name read as
# a production ship, which is `bin/release ship` and the stage `shipped`. Sessions
# already running call the old name through the fixed-path tooling, so this alias
# prints one line and execs the new script with the whole argument line, untouched.
# It parses nothing: bin/submit-wait owns --help and every refusal.
set -eu

# `pwd -P`: reached through the fixed-path symlink (<projects>/.agents/bin/ship-wait),
# the physical directory is the installed tree, where bin/submit-wait sits beside this file.
script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd -P)
echo "bin/ship-wait is renamed bin/submit-wait; running $script_dir/submit-wait (the old name goes after one release)." >&2
exec "$script_dir/submit-wait" "$@"
