<%# locals: (card:, message:, request_row:) %>
<%# The domain card (stored as kind "address"), one stack (Alex, 2026-10-18): Ray's suggestions as bare-name chips, then ONE name field with the fixed .mcritchie.studio suffix inside it (the visitor types only the name), then Use Domain. The first available suggestion (or the domain already chosen) is preselected and fills the field. THE FIELD IS THE SOURCE OF TRUTH (build_domain.js): the chip whose name is exactly the field's value glows; an edit that matches no chip fades the glow; typing a name back, or another chip's name, lights that chip. A chip tap fills the field without focusing it (no keyboard pops up on a phone). Use Domain glows whenever the name is valid and not known to be taken. The field is cleaned as it is typed (the server's AppRequest.normalize_subdomain) and checked live (/build/check); a chip we know is taken is drawn disabled. Use Domain sets the domain through BuildIntake::Choice and relays the visitor's turn, and Ray answers with the summary and Build My App. The server checks again on every tap and again at Build, so the live answer is advice, not a lock. %>
<% names = card["names"] %>
<% taken = names.index_with { |name| AppRequest.unavailable_reason(name, except: request_row) } %>
<% chosen = request_row.subdomain %>
<% value = chosen.presence || names.find { |name| taken[name].nil? } || names.first %>
<%= form_with url: build_request_intake_path(request_row.token), method: :patch,
      class: "rounded-2xl border #{chosen ? 'border-primary' : 'border-subtle'} bg-surface p-3 sm:p-4",
      data: { test: "build-card-address", build_address: build_check_path, chosen: chosen.present? } do %>
  <%= hidden_field_tag :field, "address" %>
  <%= hidden_field_tag :message_id, message.id %>
  <%= hidden_field_tag :client_id, SecureRandom.uuid %>
  <p class="text-center text-base font-semibold text-heading mb-3" id="build-domain-heading-<%= message.id %>">Pick a domain</p>
  <div class="mx-auto flex max-w-sm flex-col items-stretch gap-3" data-test="build-address-stack">
    <div class="flex flex-wrap items-center justify-center gap-2" role="group" aria-labelledby="build-domain-heading-<%= message.id %>" data-test="build-address-suggestions">
      <% names.each do |name| %>
        <button type="button" class="build-domain-chip max-w-full break-all rounded-full border border-subtle px-3 py-1.5 font-mono text-xs text-body hover:border-primary aria-pressed:bg-primary/10 aria-pressed:text-heading disabled:opacity-50 disabled:line-through disabled:cursor-not-allowed"
                aria-pressed="<%= name == value %>" data-build-domain-name="<%= name %>" data-test="build-address-suggestion"
                <%= "disabled" if taken[name] && name != chosen %> title="<%= taken[name] if name != chosen %>"><%= name %></button>
      <% end %>
    </div>
    <label class="block">
      <span class="sr-only">Your domain name</span>
      <span class="flex items-stretch rounded-xl border border-subtle bg-surface focus-within:border-primary overflow-hidden" data-test="build-address-field">
        <input type="text" name="subdomain" value="<%= value %>" required autocomplete="off" spellcheck="false" autocapitalize="none" maxlength="30"
               aria-describedby="build-domain-status-<%= message.id %>" class="min-w-0 flex-1 bg-transparent pl-3 py-2 font-mono text-sm text-heading text-right focus:outline-none"
               data-build-address-input data-test="build-address-input">
        <span class="flex items-center pr-3 font-mono text-sm text-muted whitespace-nowrap select-none" aria-hidden="true" data-test="build-address-suffix">.<%= AppRequest::PARENT_DOMAIN %></span>
      </span>
    </label>
    <p class="text-xs text-center min-h-4 data-[state=available]:text-success-ink data-[state=taken]:text-danger-ink text-muted" aria-live="polite"
       id="build-domain-status-<%= message.id %>" data-build-address-status data-test="build-address-availability"></p>
    <button type="submit" class="build-domain-cta btn btn-primary w-full" data-build-address-submit data-build-glow="<%= value.present? && taken[value].nil? || value == chosen %>"
            data-test="build-choose-address">Use Domain</button>
  </div>
<% end %>
