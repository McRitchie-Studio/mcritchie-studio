<%# The pill call to action, an inline element for any block to centre.
    Locals: url, label, bg, color. %>
<a href="<%= url %>" target="_blank" style="display:inline-block;background-color:<%= bg %>;color:<%= color %>;font-size:18px;font-weight:900;letter-spacing:.5px;text-decoration:none;padding:17px 40px;border-radius:999px;"><%= label %> &rarr;</a>
