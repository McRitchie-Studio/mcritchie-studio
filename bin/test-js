#!/usr/bin/env bash
# [unit] The JavaScript unit tests (test/javascript, for app/javascript/board).
#
# node:test and node:assert only: no npm install. studio-engine's shared importmap
# hook (test/javascript/support/register.mjs) maps the importmap's "board/*"
# specifiers onto app/javascript/board so the modules run unchanged. The hook ships
# in the gem, so this links it first (`bin/rails node_tooling:link`, ~2s, which
# needs the bundle and refuses a node_modules shared with another checkout). CI
# runs this in the `javascript` job (.github/workflows/reusable-ci.yml).
set -euo pipefail
cd "$(dirname "$0")/.."

bin/rails node_tooling:link >/dev/null

files=("$@")
if [ ${#files[@]} -eq 0 ]; then
  files=(test/javascript/*_test.js)
fi

exec node --import ./test/javascript/support/register.mjs --test "${files[@]}"
