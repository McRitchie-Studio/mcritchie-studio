<% content_for :title, "AI Builder Multiple Commit History" %>

<section class="space-y-6">
  <%# The engine page header: the trail runs Basement › AI Builder Multiple, so the old
      Dashboard button is its parent crumb; the dashboard's builder table is a page
      elsewhere, in the Links menu (docs/PAGE_HEADER.md). %>
  <%= render "studio/page_header", title: "AI Builder Commit Cache History",
        crumbs: studio_crumbs(:admin_ai_builder_multiple_commit_history), crumb_label: "Commit History",
        menu: [{ label: "Dashboard", href: admin_ai_builder_multiple_path },
               { label: "Tracked Builders", href: admin_ai_builder_multiple_path(builder_limit: @builder_limit, anchor: "tracked-builders") }] %>
  <p class="text-secondary max-w-3xl">
    Full five-year Saturday-Friday UTC commit cache table for tracked builders. This is public GitHub builder activity, not true productivity.
  </p>

  <%= render "commit_log_table",
        title: @commit_log_title,
        description: @commit_log_description,
        action: @commit_log_action,
        ranges: @commit_log_ranges,
        rows: @commit_log_rows,
        overview: @overview %>
</section>
