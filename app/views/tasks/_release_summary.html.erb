<%# Shared meta row + member pills for the Current and Last release modules.
    Locals:
      release  the Release to render (required)
      variant  :current (full-color, active) or :last (dimmed/muted history)
    The two modules were ~90 percent identical; only the colors, the section
    label, and the timestamp branch differ, all driven off the variant below. %>
<% rel = local_assigns.fetch(:release) %>
<% variant = local_assigns.fetch(:variant) %>
<% current = variant == :current %>
<% members = rel.tasks.order(:position).to_a %>
<% label_text = current ? "Current Release" : "Last Release" %>
<% slug_class = current ? "text-sm text-heading" : "text-sm text-muted" %>
<%# Static literals (no user input) marked html_safe so the apostrophe stays a
    literal ' in the title attribute, byte-for-byte with the prior inline HTML. %>
<% branch_title = (current ? "persistent integration branch (feature PRs merge into it; ff's to main on ship)" : "persistent integration branch").html_safe %>
<% meta_color = current ? "text-secondary" : "text-muted" %>
<% link_class = current ? "text-primary hover:underline" : "text-secondary hover:underline" %>
<% pill_class = current ? "px-2 py-1 rounded bg-inset text-xs text-body hover:text-heading flex items-center gap-1.5 border border-subtle" : "px-2 py-1 rounded bg-inset text-xs text-muted hover:text-body flex items-center gap-1.5 border border-subtle" %>
<div class="flex items-center justify-between flex-wrap gap-3">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-[11px] uppercase tracking-wide text-muted font-semibold"><%= label_text %></span>
        <code class="<%= slug_class %>"><%= rel.slug %></code>
        <span class="px-2 py-0.5 rounded text-xs font-bold <%= release_state_classes(rel.state) %>"><%= rel.state %></span>
        <% if rel.branch.present? %><code class="text-xs text-muted" title="<%= branch_title %>"><%= rel.branch %></code><% end %>
      </div>
      <div class="flex items-center gap-4 text-xs <%= meta_color %> flex-wrap">
        <span><%= members.size %> task<%= "s" unless members.size == 1 %></span>
        <% if rel.qa_url.present? %><%= link_to "QA ↗", rel.qa_url, target: "_blank", rel: "noopener", class: link_class %><% end %>
        <% if rel.production_url.present? %><%= link_to "Prod ↗", rel.production_url, target: "_blank", rel: "noopener", class: link_class %><% end %>
        <% if rel.deployed_sha.present? %><code class="text-muted" title="deployed SHA"><%= rel.deployed_sha.first(7) %></code><% end %>
        <% if rel.shipped_at %><span class="text-muted">shipped <%= time_ago_in_words(rel.shipped_at) %> ago</span><% elsif current && rel.assembled_at %><span class="text-muted">assembled <%= time_ago_in_words(rel.assembled_at) %> ago</span><% end %>
      </div>
    </div>
    <% if members.any? %>
      <div class="mt-3 flex flex-wrap gap-2">
        <% members.each do |t| %>
          <%= link_to task_path(t.slug), class: pill_class do %>
            <%= app_emoji_badge(t.devops_repositories) %>
            <%= truncate(t.title, length: 42) %>
            <% if (deploy_target = deploy_target_label(t)) %>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-surface-alt text-secondary border border-subtle" title="Deploy target"><%= deploy_target %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
