<%# The standing Google Calendar connection page (/admin/google_calendar): the status, the connected account, the next week's events as proof the read works, and one button (Connect, or Disconnect once an account is connected). The OAuth client and encryption setup shows only when one of them is missing, by NAME only. It renders no token and no part of one, and no value of any env var. %>
<% source = if @connection.nil? then :none
            elsif !@readable then :unreadable
            elsif !@connection.can_read_calendar? then :no_calendar
            elsif @read_error then :read_failed
            else :connected
            end %>
<% badge = {
     connected: ["Connected", "bg-success/10 text-success-ink border-success/40"],
     no_calendar: ["Connected without the calendar", "bg-warning/10 text-warning-ink border-warning/40"],
     read_failed: ["Connected, but the read failed", "bg-warning/10 text-warning-ink border-warning/40"],
     unreadable: ["Not connected: the stored connection cannot be read", "bg-warning/10 text-warning-ink border-warning/40"],
     none: ["Not connected", "bg-warning/10 text-warning-ink border-warning/40"]
   }.fetch(source) %>
<%# An unreadable row counts as not connected: Connect replaces it. %>
<% connected = @connection && @readable %>
<% can_connect = @configured && @encryption_ready %>
<% stamp = ->(time) { time.in_time_zone("America/Denver").strftime("%a %b %-d, %-l:%M %p %Z") } %>
<section class="max-w-3xl mx-auto px-4 py-10 space-y-6" data-test="google-calendar-connection" data-source="<%= source %>">
  <div>
    <h1 class="text-3xl font-bold text-heading">Google Calendar connection</h1>
    <p class="text-secondary mt-2">
      The Google account whose calendar this server reads. It can read events and nothing else. No token is shown here.
    </p>
  </div>

  <div class="card p-4 space-y-3" data-test="google-calendar-status">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
      <div class="min-w-0 space-y-2">
        <span class="badge text-xs <%= badge.last %>" data-test="google-calendar-badge"><%= badge.first %></span>
        <% if connected %>
          <p class="text-sm text-body" data-test="google-calendar-account">
            <span class="font-semibold text-heading break-all" data-field="account"><%= @connection.email %></span>
            <span class="block text-muted text-xs" data-field="connected">Connected <%= stamp.(@connection.connected_at) %><% if @connection.connected_by.present? %> by <%= @connection.connected_by %><% end %></span>
          </p>
        <% end %>
      </div>
      <% if connected %>
        <%= button_to "Disconnect", admin_google_calendar_disconnect_path, method: :delete, class: "btn btn-danger btn-sm w-full sm:w-auto",
                      form: { class: "shrink-0", data: { test: "google-calendar-disconnect", turbo_confirm: "Delete the stored Google Calendar connection and revoke it?" } } %>
      <% elsif can_connect %>
        <%= link_to "Connect Google Calendar", admin_google_calendar_connect_path,
                    class: "btn btn-primary btn-sm w-full sm:w-auto shrink-0 text-center", data: { test: "google-calendar-connect", turbo: false } %>
      <% end %>
    </div>
    <% unless source == :connected %>
      <p class="text-body text-sm" data-test="google-calendar-detail">
        <% if source == :no_calendar %>The calendar permission was unticked on Google's screen. Disconnect, then connect again and leave it ticked.
        <% elsif source == :read_failed %><%= @read_error %>
        <% elsif source == :unreadable %>A connection is stored, but it was encrypted with keys this server no longer has. Connect again to replace it.
        <% elsif can_connect %>Nothing connects this server to a Google calendar. Connect as the account whose meetings the agents should read.
        <% else %>Nothing connects this server to a Google calendar, and Connect is off until the setup below is done.
        <% end %>
      </p>
    <% end %>
  </div>

  <% if @events %>
    <div class="card p-4 text-sm" data-test="google-calendar-events" data-count="<%= @events.size %>">
      <h2 class="font-semibold text-heading">Next 7 days · <%= pluralize(@events.size, "event") %></h2>
      <% if @events.empty? %>
        <p class="mt-2 text-muted">No events in the next week.</p>
      <% else %>
        <ul class="mt-2 divide-y divide-subtle">
          <% @events.first(10).each do |event| %>
            <li class="py-2 flex flex-col sm:flex-row sm:justify-between gap-1" data-test="google-calendar-event">
              <span class="text-heading break-words min-w-0"><%= event.title %></span>
              <span class="text-muted text-xs shrink-0">
                <%= event.all_day ? event.starts_at.strftime("%a %b %-d · all day") : stamp.(event.starts_at) %>
                <% if event.attendees.positive? %> · <%= pluralize(event.attendees, "guest") %><% end %>
              </span>
            </li>
          <% end %>
        </ul>
        <% if @events.size > 10 %><p class="mt-2 text-muted text-xs">and <%= @events.size - 10 %> more</p><% end %>
      <% end %>
    </div>
  <% end %>

  <% unless @configured && @encryption_ready %>
    <dl class="card p-4 space-y-3 text-sm border-warning/40" data-test="google-calendar-server">
      <% unless @configured %>
        <div>
          <dt class="text-muted text-xs mb-1">OAuth client</dt>
          <dd class="text-body break-words" data-field="client" data-set="false">
            <span class="font-semibold text-warning-ink">Not set.</span>
            Set <span class="font-mono text-xs">GOOGLE_CONNECT_CLIENT_ID</span> and <span class="font-mono text-xs">GOOGLE_CONNECT_CLIENT_SECRET</span>.
            <span class="text-muted">Its redirect URI must be <span class="font-mono text-xs break-all"><%= @callback_url %></span></span>
          </dd>
        </div>
      <% end %>
      <% unless @encryption_ready %>
        <div>
          <dt class="text-muted text-xs mb-1">Encryption</dt>
          <dd class="text-body break-words" data-field="encryption" data-ready="false">
            <span class="font-semibold text-warning-ink">Not ready.</span> Set <span class="font-mono text-xs"><%= GoogleCalendarConnection::ENCRYPTION_ENV.join(", ") %></span>: without them no connection can be stored.
          </dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</section>
