+async fn apply_session_start_thread_name(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    thread_name: Option<String>,
+) {
+    apply_hook_thread_name(sess, turn_context, thread_name, true).await;
+}
+
+async fn apply_hook_thread_name(
+    sess: &Arc<Session>,
+    turn_context: &Arc<TurnContext>,
+    thread_name: Option<String>,
+    record_identity_context: bool,
+) {
+    let Some(thread_name) = thread_name
+        .as_deref()
+        .and_then(crate::util::normalize_thread_name)
+    else {
+        return;
+    };
+    let thread_id = sess.thread_id();
+
+    if let Err(error) = persist_session_thread_name(sess, thread_id, thread_name.clone()).await {
+        tracing::warn!(
+            %thread_id,
+            error = %error,
+            "failed to persist SessionStart thread name"
+        );
+    }
+
+    sess.send_event(
+        turn_context,
+        EventMsg::ThreadNameUpdated(ThreadNameUpdatedEvent {
+            thread_id,
+            thread_name: Some(thread_name.clone()),
+            silent: true,
+        }),
+    )
+    .await;
+
+    if record_identity_context {
+        record_additional_contexts(
+            sess,
+            turn_context,
+            vec![session_identity_context_from_thread_name(&thread_name)],
+        )
+        .await;
+    }
+}
+
+fn session_identity_context_from_thread_name(thread_name: &str) -> String {
+    format!(
+        "McRitchie session marker: {thread_name}. Treat this marker as your session identity. If asked what Pokemon or session mascot you are, answer from this marker instead of inventing one."
+    )
+}
+
+async fn persist_session_thread_name(
+    sess: &Arc<Session>,
+    thread_id: codex_protocol::ThreadId,
+    thread_name: String,
+) -> codex_thread_store::ThreadStoreResult<()> {
+    let patch = ThreadMetadataPatch {
+        name: Some(Some(thread_name)),
+        ..Default::default()
+    };
+    if let Some(live_thread) = sess.services.live_thread.as_ref() {
+        live_thread
+            .update_metadata(patch, /*include_archived*/ false)
+            .await?;
+    } else {
+        sess.services
+            .thread_store
+            .update_thread_metadata(UpdateThreadMetadataParams {
+                thread_id,
+                patch,
+                include_archived: false,
+            })
+            .await?;
+    }
+    Ok(())
+}
