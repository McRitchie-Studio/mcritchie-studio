#!/bin/bash
# gh-app-git-credential — a git credential helper that answers `get` with a
# freshly-minted GitHub App INSTALLATION token, so git/gh operate as one of the
# org's two app identities instead of a personal access token.
#
# The two identities (2026-07-29 org migration — every repo now lives under the
# McRitchie-Studio org; fine-grained PATs died because they cannot call the
# check-runs API at all, which the CI gates read):
#   github.mcritchie-agent    — build/review lanes: contents + pull-requests +
#                               checks-read + actions + workflows. The DEFAULT.
#   github.mcritchie-deployer — ship lane: contents + actions + checks-read +
#                               secrets. NO pull-request scope — the deployer
#                               cannot open or merge PRs by design.
#
# Contract:
#   GH_APP_ITEM selects the 1Password item (default github.mcritchie-agent);
#   ship lanes export GH_APP_ITEM=github.mcritchie-deployer. Credentials load
#   from op://$VAULT/$GH_APP_ITEM — field `app-id` plus the `.pem` FILE
#   ($VAULT is per-identity: see bin/lib/op_vaults.rb)
#   ATTACHMENT (the concealed `private key` field is NOT the key). `get` and
#   `erase` are BOTH answered; only `store` is a silent no-op. `erase` is how a
#   REJECTED token is retired: git calls it with the password that just 401'd,
#   and this script turns that into `bin/gh-token --reject "$token"` (see the
#   `erase` branch below). That is the only signal anyone gets that a cached
#   token went bad before its clock ran out.
#
#   `--help`/`-h` PRINTS USAGE AND MINTS NOTHING, and an argument this script
#   cannot account for REFUSES instead of falling into a `get`. Both live in the
#   guard directly below `set -u`, ahead of every other line in the file.
#
#   THE SHARED SESSION IS TRIED FIRST (see the block below). bin/gh-token holds
#   the hour-long installation token and shares it across sibling agent
#   processes, so a warm git operation costs ZERO 1Password reads. Only a cache
#   miss falls through to the mint path, which reads the App key and is the
#   original behaviour. Until 2026-08-29 every git operation took the mint path.
#
# Wire it (global, one time):
#   git config --global credential."https://github.com".helper \
#     "/Users/alex/projects/mcritchie-studio/bin/gh-app-git-credential"
#
# Test seams (unit tests only — production stays op-backed):
#   GH_APP_OP_BIN     — the `op` binary to shell out to (default: op on PATH).
#   GH_APP_MINT_CMD   — replaces the sibling minter invocation (may carry args).
#   GH_APP_TOKEN_CMD  — replaces the bin/gh-token invocation used for the shared
#                       session read and for `--reject` on erase. A test that
#                       leaves this unpinned runs the REAL bin/gh-token.
set -u

# ── ACCOUNT FOR EVERY ARGUMENT BEFORE ANYTHING IS MINTED ─────────────────────
#
# WHAT THIS COST. `ACTION` reads only $1, and the dispatch below accepted
# `get|erase` and dropped everything else into `*) exit 0`. So `get --help` WAS a
# `get`: $2 was never read, the `get` arm reads no stdin, and the script ran
# straight to completion. Measured through the suite's pinned spies on
# 2026-08-31, that one line reached the shared-session read, THREE 1Password
# reads, and the minter, and printed `password=<token>` to the terminal. Against
# real credentials that is a live GitHub App installation token on someone's
# screen and, on a cold cache, WRITTEN to <projects>/.agents/github-tokens.json —
# plus three reads against the account-wide daily quota whose exhaustion the
# header above records as eighteen hours of downtime.
#
# `--help` is the universal safe probe, reached for PRECISELY because it is
# expected to do nothing. This defect made the safest available action the most
# expensive one.
#
# THE BARE PROBE WAS WORSE. `gh-app-git-credential` alone hit `*) exit 0` and
# said nothing at all — silent success, which reads as "the probe worked".
#
# WHY SHELL AND NOT bin/lib/cli_arg_guard.rb, the house guard with five
# consumers. That guard is Ruby, and this script is what EVERY git operation on
# this machine goes through. The header above records Carl's ruling from the
# two-vault review — this helper must not depend on Ruby, because an rbenv or
# GUI-git failure here breaks every lane at once — and requiring Ruby to read
# argv would put that dependency ahead of even the warm-cache path, which today
# costs no Ruby at all. So this is the same refusal in the same idiom as the
# shell scripts fixed alongside it: bin/setup-1pass-token, bin/ecosystem-build.
# Guarded by test/lib/bin_help_flag_class_test.rb and, behaviourally, by
# test/commands/gh_app_git_credential_test.rb, which asserts by RECEIPT that a
# probe reaches none of the three legs.
#
# WHAT IT DELIBERATELY DOES NOT REFUSE: a single unrecognized OPERATION.
# gitcredentials(7) is explicit — "If a helper receives any other operation, it
# should silently ignore the request" — so `store`, and whatever git adds next
# (it added `capability` in 2.46), stay a quiet exit 0. Only an ARGUMENT this
# script cannot account for refuses. Inverting that would break every git
# operation on the day git grows an operation.
usage() {
  cat <<'USAGE'
Usage: gh-app-git-credential <get|store|erase>

A git credential helper: GIT invokes it, with exactly one operation and the
request on stdin. You almost never do.

  get           answer with username/password for github.com — SERVES OR MINTS
                a live GitHub App installation token on every call
  erase         retire a rejected token from the shared session cache (stdin)
  store         accepted and ignored, by design: this helper owns the lifecycle
  --help, -h    this text — MINTS NOTHING, reads no 1Password, and neither
                prints a token nor writes one to the shared session cache

Identity: GH_APP_ITEM (default github.mcritchie-agent; ship lanes export
          github.mcritchie-deployer).

To inspect the shared session WITHOUT minting one:  bin/gh-token --status
USAGE
}

# `$#` is tested BEFORE "$@" is ever iterated: macOS ships bash 3.2, where "$@"
# with no positional parameters is an unbound-variable error under `set -u`.
if [ "$#" -eq 0 ]; then
  echo "gh-app-git-credential: no operation given — NOTHING was minted. git invokes this with one of get/store/erase." >&2
  usage >&2
  exit 2
fi

# ANY position, on purpose: `get --help` is the same request as `--help`, and a
# guard that only reads $1 hands the mint to the second spelling.
for arg in "$@"; do
  case "$arg" in
    --help|-h) usage; exit 0 ;;
  esac
done

if [ "$#" -gt 1 ]; then
  shift
  echo "gh-app-git-credential: unrecognized argument(s): $* — NOTHING was minted, no 1Password read was spent, and no token was printed or written to disk." >&2
  usage >&2
  exit 2
fi

ACTION="${1:-}"
case "$ACTION" in
  get|erase) ;;
  # store stays a silent no-op: git offers to persist a credential we own the
  # lifecycle of, and writing it anywhere else would fork the source of truth.
  *) exit 0 ;;
esac

ITEM="${GH_APP_ITEM:-github.mcritchie-agent}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
OP_BIN="${GH_APP_OP_BIN:-op}"
MINT_CMD="${GH_APP_MINT_CMD:-$SCRIPT_DIR/gh-app-mint-token}"
GH_TOKEN_CMD="${GH_APP_TOKEN_CMD:-$SCRIPT_DIR/gh-token}"

# ── 1Password read attribution ────────────────────────────────────────────────
# Route every `op` call through op_metered so the read is recorded against THIS
# script (bin/lib/op-meter.sh; query with bin/op-reads). Sourcing is OPTIONAL by
# construction: if the shim is missing or unreadable, op_metered falls back to
# running the binary directly. A metering problem must never cost this script its
# credential read — every consumer here has a working fallback for a rate-limited
# or absent `op`, and that survived a full-day 1Password outage.
OP_METER_VIA="gh-app-git-credential"
OP_METER_SH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/op-meter.sh"
# shellcheck source=lib/op-meter.sh
[ -r "$OP_METER_SH" ] && . "$OP_METER_SH" || true
command -v op_metered >/dev/null 2>&1 || op_metered() { local __b="$1"; shift; "$__b" "$@"; }

fail() { echo "gh-app-git-credential: $1" >&2; exit 1; }

# NAME THE COMMAND, NOT JUST THE OBSTACLE. This message used to end with
# "...needs OP_ADMIN_SERVICE_ACCOUNT_TOKEN, which an ordinary agent shell does not
# carry, by design" — true, and it reads as a WALL when it is a door. On
# 2026-08-30 an agent hit exactly that line, concluded the ship lane was not
# self-service, and put a hand-mint chore on the operator while a production
# deploy waited; the token had been installed for two days and one `source` fixed
# it. So: if the machine is provisioned, print the line to run. If it is not,
# that is the operator's one-time step and we say so instead. Mirrors
# OpVaults.diagnose, which owns the same three-outcome rule on the Ruby side.
admin_remedy() {
  case "$ITEM" in
    *deployer*) ;;
    *) return 0 ;;
  esac
  [ -n "${OP_ADMIN_SERVICE_ACCOUNT_TOKEN:-}" ] && return 0
  if [ -f "$HOME/.zprofile.admin" ]; then
    printf '%s' "This machine IS provisioned — run \`source ~/.zprofile.admin\` in THIS shell (and export GH_APP_ITEM before minting), then retry. "
  else
    printf '%s' "This machine has no ~/.zprofile.admin — install it once with \`bin/setup-1pass-token --admin\`. "
  fi
}

# ── A REJECTED SESSION IS RETIRED, EXACTLY ONCE ───────────────────────────────
#
# PROVEN, NOT ASSUMED (2026-08-30, against a local server that answers every
# request with 401): git calls this helper with `get`, and when the credential it
# returned is REJECTED it calls it a second time with `erase`, handing the
# rejected password back on stdin. That is the ONLY signal a credential helper
# ever receives that a token has gone bad — the helper never sees the 401 itself,
# so without this branch a cached-but-revoked session is re-served on every
# subsequent git operation until it ages out of the cache on the clock alone.
#
# WHY WE MATCH THE PASSWORD RATHER THAN PURGING BLIND. The cache is SHARED across
# sibling agent processes. Between our `get` and git's `erase`, another agent may
# already have hit the same rejection and minted a replacement into the other
# slot. A blind purge would throw that fresh token away and send every sibling
# back to 1Password — the exact cost this file exists to avoid. Purging only the
# slot whose token IS the rejected one leaves a newer session untouched.
#
# THAT MATCH IS ALSO WHAT MAKES IT EXACTLY ONCE. After the purge the rejected
# token is no longer in the cache, so a second `erase` carrying the same password
# matches nothing and does nothing. The next `get` finds a cold slot and mints
# once. No counter, no state file, no retry budget to get wrong.
#
# FAILURE HERE IS NEVER FATAL. `erase` is bookkeeping on a path git has already
# decided has failed; making git fail harder because the cleanup failed would
# turn a recoverable auth error into a broken remote. We always exit 0.
if [ "$ACTION" = "erase" ]; then
  REJECTED="$(sed -n "s/^password=//p" | head -1)"
  if [ -n "$REJECTED" ]; then
    GH_APP_ITEM="$ITEM" "$GH_TOKEN_CMD" --reject "$REJECTED" >/dev/null 2>&1 || true
  fi
  exit 0
fi

# ── THE SHARED SESSION COMES FIRST ────────────────────────────────────────────
#
# WHY THIS EXISTS (measured 2026-08-29). The GitHub App flow is: PRIVATE KEY ->
# sign a JWT -> INSTALLATION TOKEN, and GitHub caps that token at one hour. The
# token is the session; the key is a long-lived secret that changes on rotation.
# This helper used to re-derive the session from the key on EVERY git operation:
# three 1Password reads (item get + two op read) per push, per fetch, per repo,
# per agent. Its own header said tokens are "minted fresh per call and never
# cached" — accurate, and the reason a day of ordinary work spent the account's
# 1000-read daily quota and stopped every lane for eighteen hours.
#
# THIS PARAGRAPH USED TO BE THE ONLY RECORD OF THAT, which is why it had to be
# re-derived from scratch on 2026-08-31 when 247 reads went missing in three
# hours. It is no longer: every `op` call below is routed through op_metered, so
# `bin/op-reads` answers "what spent the quota" as a query. If you are reading
# this paragraph while investigating a spend, run that first.
#
# `bin/gh-token` already caches the session, shares it across sibling agent
# PROCESSES, and re-mints only when it ages out. Asking it first turns a warm
# git operation into ZERO 1Password reads and a cold one into two, once an hour.
#
# WHY THE FALLBACK STAYS. Carl's review of the two-vault work argued against
# making this helper depend on Ruby: it is on the path EVERY git operation needs,
# so an rbenv or GUI-git failure here breaks all of them at once. So the cache is
# an OPTIMISATION, not a dependency — if bin/gh-token is missing, non-executable,
# or silent for any reason, we fall through to the original mint path below and
# behave exactly as before. A slow git operation is survivable; a broken one is not.
#
# THE DEPLOYER IS DELIBERATELY EXCLUDED. `never-cache-deployer-token` shipped
# CACHEABLE_IDENTITIES = %w[agent] precisely so a build lane cannot lift a
# deployer token off disk. bin/gh-token honours that itself and returns nothing
# for the deployer, so this call simply falls through — do NOT "fix" that by
# making the deployer cacheable.
# NO `-x` GUARD, deliberately. An earlier draft wrapped this in
# `if [ -x "$GH_TOKEN_CMD" ]`, and a mutation proved that guard DEAD: removing it
# failed no test, because `|| true` and `2>/dev/null` already absorb a missing or
# non-executable command and leave CACHED empty. Defensive code that cannot be
# observed to do anything is worse than none — it reads as protection while
# protecting nothing. The shape check below is the real guard.
CACHED="$(GH_APP_ITEM="$ITEM" "$GH_TOKEN_CMD" 2>/dev/null || true)"
case "$CACHED" in
  gh[su]_*)
    echo "username=x-access-token"
    echo "password=$CACHED"
    exit 0
    ;;
esac

# stderr passes through deliberately: a signed-out `op` and a missing item are
# different failures, and swallowing stderr made them indistinguishable.
# VAULT AND TOKEN ARE PER-IDENTITY. bin/lib/op_vaults.rb is the source of truth;
# this shell reader mirrors its defaults and honours the same overrides, because
# a service account sees only the vaults granted to it and the deployer's
# credentials deliberately live somewhere an agent shell cannot read.
case "$ITEM" in
  *deployer*) VAULT="${MCR_OP_VAULT_ADMIN:-studio-agents-admin}"
              if [ -n "${OP_ADMIN_SERVICE_ACCOUNT_TOKEN:-}" ]; then
                export OP_SERVICE_ACCOUNT_TOKEN="$OP_ADMIN_SERVICE_ACCOUNT_TOKEN"
              fi ;;
  *)          VAULT="${MCR_OP_VAULT_AGENT:-studio-agents}" ;;
esac

ITEM_JSON="$(op_metered "$OP_BIN" item get "$ITEM" --vault "$VAULT" --format json)" \
  || fail "1Password read failed for item '$ITEM' in vault '$VAULT' (op item get). $(admin_remedy)A service account sees only the vaults granted to it — check \`op vault list\`."

# The private key rides as a FILE attachment on the item; pick the .pem file
# (falling back to the only/first attachment for items carrying exactly one).
PEM_FILE="$(printf '%s' "$ITEM_JSON" | ruby -rjson -e '
  files = JSON.parse($stdin.read)["files"] || []
  file = files.find { |f| f["name"].to_s.end_with?(".pem") } || files.first
  abort "no file attachment on the item" unless file
  puts file.fetch("name")
')" || fail "item '$ITEM' has no .pem file attachment (the key is the FILE attachment, not the concealed field)"

APP_ID="$(op_metered "$OP_BIN" read "op://$VAULT/$ITEM/app-id")" \
  || fail "op read failed for op://$VAULT/$ITEM/app-id"
PEM="$(op_metered "$OP_BIN" read "op://$VAULT/$ITEM/$PEM_FILE")" \
  || fail "op read failed for the '$PEM_FILE' attachment on '$ITEM'"

# shellcheck disable=SC2086 — MINT_CMD may deliberately carry arguments.
TOKEN="$(GH_APP_ID="$APP_ID" GH_APP_PEM="$PEM" $MINT_CMD)" \
  || fail "token mint failed (identity '$ITEM')"

echo "username=x-access-token"
echo "password=$TOKEN"
