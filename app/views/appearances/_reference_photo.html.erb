<%# ONE CANDIDATE PHOTOGRAPH. Renders identically whether it was chosen or
    rejected, and whether it is a persisted search hit or one of the two unsaved
    floor rows Appearances::ReferenceSet builds in memory, so the gallery cannot
    drift from the list the identity was built from.

    Locals:
      photo       AppearanceReferencePhoto, possibly unsaved.
      calibration optional. Truthy on the scouting page only: adds the mint
                  evidence chip, the score reasoning, and the operator's
                  keep/drop control. The character-model page passes nothing and
                  renders exactly as it did before this local existed.
      person_name optional. Required by the score reasoning, which reports
                  whether the title names the person.

    READ THROUGH local_assigns RATHER THAN A BARE NAME. An undefined local raises
    in a partial, and these two are absent on the look page by design, so the
    presence check has to be a Hash lookup. It is deliberately NOT block_given? —
    inside a partial that inherits the layout's own yield and is true when nobody
    passed a block here at all. %>
<% calibration = local_assigns[:calibration] %>
<% person_name = local_assigns[:person_name] %>
<% chip = reference_source_chip(photo) %>
<% host = reference_photo_host(photo) %>
<%# data-test / data-source / data-chosen are the handles the component and e2e
    tiers select on. They assert STRUCTURE — how many tiles, which verdict, which
    source — rather than the caption prose, which is copy and will be reworded. %>
<figure data-test="reference-photo"
        data-source="<%= photo.source %>"
        data-chosen="<%= photo.chosen? %>"
        data-rejection="<%= photo.rejection_reason %>"
        class="group rounded-lg border overflow-hidden bg-surface-alt flex flex-col
               <%= photo.chosen? ? "border-success/40" : "border-subtle" %>">

  <% if photo.rejection_reason == AppearanceReferencePhoto::REJECTED_UNFETCHABLE %>
    <%# A URL WE REFUSED IS NOT RENDERED, AND NOT LINKED.
        This row exists because Appearances::FetchableUrl judged the URL unsafe to
        hand a remote fetcher — and an img tag hands it to the operator's own
        browser instead, which is the same request from a machine INSIDE our
        network rather than outside it. A loopback or private-range URL is exactly
        the one this page must not fetch, so the tile shows the address as TEXT and
        stops there. Seeing that the search offered it is the whole value of the
        row; fetching it is none of it. %>
    <div class="aspect-square bg-inset flex flex-col items-center justify-center gap-1 p-2 text-center">
      <span class="text-lg opacity-50" aria-hidden="true">&#9888;</span>
      <span class="text-3xs text-muted break-all leading-tight"><%= photo.image_url %></span>
      <span class="text-3xs text-muted">not fetched</span>
    </div>
  <% else %>
    <%# LINKS TO THE IMAGE ITSELF, not to the page it was found on. Judging a search
        hit means looking at the photograph at full size first; the page it came from
        is one line down, for when the crop is not enough to decide.

        rel and referrerpolicy are not decoration: these are third-party URLs a
        search engine handed us, and neither the tab nor the referrer needs to carry
        anything of ours to them. %>
    <a href="<%= photo.image_url %>" target="_blank" rel="noopener noreferrer nofollow"
       referrerpolicy="no-referrer"
       class="block aspect-square bg-inset overflow-hidden
              <%= photo.chosen? ? "" : "opacity-60 group-hover:opacity-100 transition-opacity" %>">
      <%# A FAILED IMAGE SHOWS ITS ALT TEXT, which is why alt carries the title or the
          host rather than being empty: plenty of search hits 404 or refuse hotlinking,
          and an empty alt turns every one of those into an identical blank square.

          The type utilities are ON THE IMG on purpose — a broken image renders its alt
          in the img element's own font, so without them the fallback text sets at body
          size and spills out of a thumbnail-sized tile. %>
      <%# THE THUMBNAIL IS RENDERED AND THE ORIGINAL IS LINKED, which is not a
          micro-optimisation but the difference between a gallery that paints and one
          that does not. MEASURED 2026-09-26: twenty Commons originals at 1-3 MB each
          earn an HTTP 429 from the third one onward, and a third of the tiles came up
          as grey alt-text. `display_url` falls back to the original wherever no
          thumbnail was reported, so a Serper row and every row filed before that column
          existed still render. %>
      <img src="<%= photo.display_url %>" loading="lazy" referrerpolicy="no-referrer"
           alt="<%= photo.title.presence || host || "reference photo" %>"
           class="w-full h-full object-cover text-3xs text-muted leading-tight p-1">
    </a>
  <% end %>

  <figcaption class="p-2 space-y-1 flex-1 flex flex-col">
    <div class="flex items-center gap-1 flex-wrap">
      <span class="badge text-3xs <%= chip[:classes] %>"><%= chip[:label] %></span>
      <% if photo.chosen? %>
        <span class="badge text-3xs bg-success/10 text-success-ink border-success/40">in the model</span>
      <% else %>
        <span class="badge text-3xs bg-surface text-muted border-subtle"><%= rejection_label(photo) %></span>
      <% end %>
      <%# THE FACE SCORE IS WHAT ORDERED THIS GALLERY, so it is printed on every
          photograph that has one. Without it the operator sees a new order and no
          reason for it, and cannot tell a ranking that worked from one that did
          nothing. A row with no score says nothing rather than showing a zero —
          "nobody looked" and "looked and saw no face" are opposite judgements. %>
      <% if photo.face_scored? %>
        <span class="badge text-3xs <%= face_score_chip(photo) %>"
              title="How clearly this photo shows the face, judged 0-100">
          face <%= photo.face_score_percent %>
        </span>
      <% end %>
      <% if photo.position.present? %>
        <span class="text-3xs text-muted">hit <%= photo.position %></span>
      <% end %>
    </div>

    <%# THE TITLE THE PROVIDER GAVE IT, which is the fastest way to spot the one
        failure the face score cannot catch: a CLEAR photograph of the WRONG
        PERSON. A bare-faced stranger scores higher than a helmeted shot of your
        man and will rank above it, so the operator has to be able to read the name
        without opening the tile. Measured: "Drew Hutton" was hit 5 in a real
        Wikimedia answer for "Drew Lock". %>
    <% if photo.title.present? %>
      <p class="text-3xs text-body line-clamp-2 leading-tight" title="<%= photo.title %>">
        <%= photo.title %>
      </p>
    <% end %>

    <% if host.present? %>
      <p class="text-3xs text-muted truncate" title="<%= photo.origin_url %>">
        <%# page_link_url, NEVER the raw page_url. The column holds whatever the
            provider put in its answer, and only http and https may reach an href —
            the model carries the judgement and the two shapes it refuses. %>
        <% if photo.page_link_url.present? %>
          <%= link_to host, photo.page_link_url, target: "_blank",
                rel: "noopener noreferrer nofollow", referrerpolicy: "no-referrer",
                class: "hover:text-primary" %>
        <% else %>
          <%= host %>
        <% end %>
      </p>
    <% end %>

    <% if photo.width.present? && photo.height.present? %>
      <p class="text-3xs text-muted mt-auto"><%= photo.width %>x<%= photo.height %></p>
    <% end %>

    <% if calibration %>
      <%# THE SCOUTING BLOCK. Everything above is the tile the look page shows; this
          is what turns it into something arguable. Three additions, in the order the
          operator reads them: can it mint, why did it score what it scored, and what
          do YOU think. %>
      <div class="pt-1.5 mt-1.5 border-t border-subtle space-y-1.5">
        <% if photo.mime_type.present? %>
          <%# THE ARCHIVE'S OWN ADMISSION OF WHAT THE FILE IS. On a real Commons
              answer more than half the rows report a document mime type, and this is
              the cheapest place the operator can see that without opening anything. %>
          <p class="text-3xs text-muted font-mono truncate" title="Reported by the provider">
            <%= photo.mime_type %>
          </p>
        <% end %>

        <% evidence = mint_evidence(photo) %>
        <% if evidence %>
          <span class="badge text-3xs <%= mint_evidence_classes(evidence[:tone]) %>"
                title="<%= evidence[:title] %>">
            <%= evidence[:label] %>
          </span>
        <% end %>

        <% reasons = photo_merit_reasons(photo, person_name) %>
        <% if reasons.any? %>
          <div class="flex flex-wrap gap-1" data-test="merit-reasons">
            <% reasons.each do |reason| %>
              <span class="badge text-3xs <%= merit_reason_classes(reason[:tone]) %>">
                <%= reason[:label] %>
              </span>
            <% end %>
          </div>
        <% end %>

        <% if photo.persisted? %>
          <%# THE OPERATOR'S CONTROL, and it renders only on a PERSISTED row.
              Appearances::ReferenceSet builds the two floor rows in memory, so they
              have no slug to address and no row to write to. Offering a button that
              could not save is the one thing worse than not offering one. %>
          <%= render "photo_scouting/verdict_control", photo: photo %>
        <% else %>
          <%# A FLOOR ROW SAYS WHY IT HAS NO CONTROL rather than just lacking one.
              Our mirrored headshot and the URL the operator typed are INPUTS we
              control, not things a search found, so they are not part of the set being
              calibrated — and they are built in memory, so there is nothing to write a
              verdict to either way. An absent control with no explanation reads as a
              bug on the one tile that leads the picks gallery. %>
          <p data-test="not-calibratable" class="text-3xs text-muted leading-tight">
            not from the search &mdash; nothing to judge
          </p>
        <% end %>
      </div>
    <% end %>
  </figcaption>
</figure>
