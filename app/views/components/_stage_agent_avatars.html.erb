<%# locals: (task:, agents:, variant: :stack, events: nil, mascot: nil, board: :deploy) %>
<%#
  The line above is a Rails strict-locals signature, so Rails itself supplies every
  default — `variant` is :stack, `events`/`mascot` are nil, and `board` is :deploy —
  without any local_assigns.fetch. `mascot` is the one exception that still reads
  through local_assigns below (line 27): its default must differ per caller — the
  board passes a preloaded mascot (which may be nil), while the detail page omits it
  and falls back to a DB lookup. (Strict-locals defaults are NOT keys in
  local_assigns, so that fetch block genuinely runs when mascot is omitted.)

  Per-stage agent attribution across a task's WHOLE journey — who designed, built,
  submitted, reviewed, assembled, and shipped it, with the time each stage took.

  Source: stage_agent_groups(task, agents) reads the task's TaskEvents +
  (review only) reviewers metadata (see StageAgentsHelper). Build-lane stages show
  the event's actor (the feature agent); reviewed shows the 2 senior reviewers;
  assembled shows Steffon; shipped shows Avi. A task renders nothing only when it
  has no stage events with a crew to attribute — the partial then renders nothing
  at all (no empty container).

  variant:
    :stack    (default) one near-fully stacked circle per lane (Build · Review ·
              Deploy) carrying that lane's duration or a live build counter — the
              board card glance; the lane row flex-wraps so a full crew never
              spills a narrow column.
    :detailed grouped per stage with a studio-engine badge, names, weights, and
              the full humanized duration — the task detail.

  Avatars are theme-token only (ring-surface separators, surface-alt pills) so
  dark/light parity holds; faces reuse the components/agent_avatar primitive
  (image with a deterministic initials fallback).
%>
<%# Build-lane crew wears the task's mascot. Callers (the board) pass it from a
    preloaded map to avoid an N+1; the detail page resolves it here. %>
<% mascot = local_assigns.fetch(:mascot) { Pokemon.find_by(slug: task.devops["mascot"].to_s.presence) } %>
<% entries = stage_agent_groups(task, agents, events: events, mascot: mascot) %>
<% if entries.any? %>
  <% if variant.to_sym == :detailed %>
    <div class="bg-surface-alt rounded-lg p-3" data-test="stage-agent-avatars">
      <p class="label-upper mb-3">Stage crew</p>
      <div class="space-y-3">
        <% entries.group_by(&:stage).each do |stage, stage_entries| %>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <%= render "components/badge", text: Task::STAGE_LABELS.fetch(stage, stage.humanize), scheme: stage_scheme(stage) %>
            <% stage_entries.each do |entry| %>
              <div class="flex items-center gap-2">
                <div class="relative rounded-full ring-2 ring-surface">
                  <%= render "components/agent_avatar", agent: entry, size: "xs" %>
                </div>
                <div class="leading-tight">
                  <p class="text-sm text-heading flex items-center gap-1.5">
                    <%= entry.name %>
                    <% if entry.weight.present? %>
                      <span class="px-1 py-px rounded text-[9px] font-bold uppercase tracking-wide
                                   <%= entry.heavy? ? 'bg-primary/15 text-primary border border-primary/30' : 'bg-surface text-muted border border-subtle' %>"
                            title="<%= entry.heavy? ? 'Heavy (deep) review' : 'Light review' %>">
                        <%= entry.weight %>
                      </span>
                    <% end %>
                  </p>
                  <% if (spent = humanize_stage_duration(entry.seconds)) %>
                    <p class="text-xs text-muted"><%= spent %> in <%= entry.from_label %></p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%#
      Board-card glance (a dashboard, not the read view): collapse each lane to ONE
      stacked circle — Build · Review · Deploy — so a full crew fits a small card;
      the row also flex-wraps as a final guard against spilling a narrow column.
      Each cluster stacks its faces (priority on top) and shows the one duration that
      matters for the lane (build total / longer review / QA→prod). The build lane
      ticks a LIVE counter while the task is still being built. The detail page
      (:detailed) still shows every stage per-usual.
    %>
    <% columns = crew_columns(task, entries, board: board, mascot: mascot) %>
    <%# Crew avatars shrink on the dense Deploy board (six narrow lanes) and stay larger
        on the roomier Build board; the stack overlap tracks the size to keep a small peek
        of each face — 8px on Build (sm = w-10 face, -space-x-8 = 32px) and 4px on Deploy
        (xs = w-8 face, -space-x-7 = 28px). %>
    <% crew_size = board == :build ? "sm" : "xs" %>
    <% crew_overlap = board == :build ? "-space-x-8" : "-space-x-7" %>
    <%# When the task is blocked, the LAST filled compartment is where it stalled
        (a block lands from reviewed or assembled) — its timer turns into a red ✕. %>
    <% blocked = task.stage == "blocked" %>
    <% block_idx = (columns.rindex { |c| c.stacked.any? } if blocked) %>
    <%# Fixed grid (3 columns, or 4 only once shipped — blocked mirrors Assembled's
        three) so the crew is one solid row; each compartment centered in its column,
        an unreached stage left blank. The Build board (/tasks) splits the build
        steps; Deploy collapses them. %>
    <div class="grid <%= columns.size == 4 ? 'grid-cols-4' : 'grid-cols-3' %> gap-1 mt-2 mb-1"
         data-test="stage-agent-avatars" title="Stage crew">
      <% columns.each_with_index do |cluster, ci| %>
        <%# Filled compartments hug the left (the real crew); an empty slot centers in
            its column so the dashed placeholders read as a tidy centered row. %>
        <div class="flex <%= cluster.stacked.any? ? "justify-start" : "justify-center" %>">
          <% if cluster.stacked.any? %>
            <div class="relative" data-test="crew-cluster" data-lane="<%= cluster.lane %>">
              <%# Stack runs lead-FIRST (highest on the LEFT): the lead is leftmost and lifted
                  (z-30) so its glow sits on top; the next gets a subtler ring; deeper avatars
                  blend and peek out to the right. The whole stack scales on card hover
                  (transform only, so siblings don't shift). %>
              <div class="flex items-center <%= crew_overlap %> transition-transform duration-150 group-hover:scale-110">
                <% cluster.stacked.reverse.each_with_index do |entry, i| %>
                  <div class="rounded-full relative ring-2 <%= i == 0 ? "z-30 ring-primary/70" : (i == 1 ? "z-20 ring-primary/50" : "z-10 ring-surface") %>"
                       title="<%= [entry.name, (entry.weight.presence && "(#{entry.weight})")].compact.join(' ') %>">
                    <%= render "components/agent_avatar", agent: entry, size: crew_size %>
                  </div>
                <% end %>
              </div>
              <% if blocked && ci == block_idx %>
                <%# Blocked here — the latest agent's timer becomes a red ✕. %>
                <span class="absolute -bottom-1 -left-1 z-40 px-1 py-px rounded-full text-[10px] font-bold leading-none
                             bg-red-500/30 text-red-200 border border-red-400/70 ring-1 ring-surface"
                      data-test="crew-blocked" title="Blocked at this stage">✕</span>
              <% elsif cluster.live_since %>
                <%# Live elapsed counter (s → m → h → d → w), ticking each second. %>
                <span class="absolute -bottom-1 -left-1 z-40 px-1 py-px rounded-full text-[9px] font-semibold leading-none
                             bg-green-500/30 text-green-100 border border-green-400/60 ring-1 ring-surface tabular-nums animate-pulse"
                      data-test="crew-live"
                      x-data="{ start: <%= cluster.live_since.to_i %>, now: Math.floor(Date.now() / 1000) }"
                      x-init="setInterval(() => now = Math.floor(Date.now() / 1000), 1000)"
                      x-text="window.elapsedLabel(now - start)">…</span>
              <% elsif cluster.seconds.to_i.positive? %>
                <span class="absolute -bottom-1 -left-1 z-40 px-1 py-px rounded-full text-[9px] font-semibold leading-none
                             bg-surface-alt text-secondary border border-subtle ring-1 ring-surface tabular-nums"
                      data-test="crew-duration"><%= compact_stage_duration(cluster.seconds) %></span>
              <% end %>
            </div>
          <% else %>
            <%# Unreached pipeline stage — a dashed placeholder circle marks the slot. %>
            <div class="rounded-full border-2 border-dashed border-muted/50 <%= crew_size == "sm" ? "w-10 h-10" : "w-8 h-8" %>"
                 data-test="crew-empty" data-lane="<%= cluster.lane %>"></div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
