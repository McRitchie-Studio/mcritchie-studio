<%# Shared kanban board for /tasks (Build lane) and /deployments (Deploy lane).
    Locals:
      stages          — array of stage keys to render as columns
      title           — header heading
      archived:       — show the Archived toggle + a toggle-hidden archived column
      current_release — render the current-release module above the board when present
      last_release    — most-recent shipped release, rendered read-only beneath current %>
<% archived = local_assigns.fetch(:archived, false) %>
<% current_release = local_assigns.fetch(:current_release, nil) %>
<% last_release = local_assigns.fetch(:last_release, nil) %>
<%# Blocked tasks live in the Building column (a block means more building to do), so the
    board never renders a standalone Blocked column on either page. %>
<% columns = (archived ? (stages + ["archived"]) : stages).reject { |s| s == "blocked" } %>
<%# Mascot lookup — the 151 are tiny, so one query beats an N+1 across cards. %>
<% pokemon_by_slug = Pokemon.all.index_by(&:slug) %>
<%# Build board (/tasks) splits the build steps; Deploy board (/deployments) shows the pipeline. %>
<% crew_board = stages.include?("reviewed") ? :deploy : :build %>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

<%= render "components/elapsed_label_script" %>
<%# kanbanBoard must be defined inline (before Alpine CDN defer evaluates x-data) %>
<script>
function kanbanBoard() {
  return {
    _pendingMoves: {},
    agentFilter: '',
    hiddenApps: [],
    showArchived: false,
    showAllCols: false,
    toasts: [],

    stageLabels: <%= raw Task::STAGE_LABELS.to_json %>,

    matchesFilter(agent) {
      return !this.agentFilter || agent === this.agentFilter;
    },

    // App filter — a toggled-off app hides all its cards (exclusion). Each card
    // carries its repos as a comma string and hides if ANY of them is toggled off.
    // Mirrors the agentFilter pattern: client-side only, resets on reload.
    toggleApp(app) {
      const i = this.hiddenApps.indexOf(app);
      if (i === -1) { this.hiddenApps.push(app); } else { this.hiddenApps.splice(i, 1); }
    },
    appHidden(app) {
      return this.hiddenApps.includes(app);
    },
    appVisible(csv) {
      if (!csv) return true; // a task with no mapped repo always shows
      return !csv.split(',').some(a => this.hiddenApps.includes(a));
    },

    init() {
      this.$nextTick(() => this.initSortables());
    },

    initSortables() {
      document.querySelectorAll('.kanban-dropzone').forEach(zone => {
        Sortable.create(zone, {
          group: 'kanban',
          animation: 150,
          ghostClass: 'opacity-30',
          draggable: '.kanban-card',
          filter: '.kanban-empty',
          onEnd: (evt) => this.handleSortEnd(evt)
        });
      });
    },

    async handleSortEnd(evt) {
      const card = evt.item;
      const slug = card.dataset.slug;
      const fromZone = evt.from;
      const toZone = evt.to;
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

      // A same-zone drop is an in-place reorder — it must NEVER change the task's
      // stage. This is what guards a blocked card: it rides the Building dropzone
      // (data-stage="building") yet is tagged data-stage="blocked", so reordering
      // it would otherwise read oldStage="blocked" vs newStage="building" and
      // silently PATCH it un-blocked. Source the stage from the DROPZONES, not the
      // card, and only PATCH on a real cross-column move (fromZone !== toZone).
      if (fromZone !== toZone) {
        const newStage = toZone.dataset.stage;
        try {
          const resp = await fetch('/tasks/' + slug + '.json', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ task: { stage: newStage } })
          });
          if (!resp.ok) {
            const err = await resp.json().catch(() => ({}));
            throw new Error(err.error || 'Failed (' + resp.status + ')');
          }
          card.dataset.stage = newStage;
          this.showToast('Task moved to ' + this.stageLabels[newStage], 'success');
        } catch (err) {
          // Revert: drop the card back into its SOURCE zone, which always exists
          // (a blocked card's source zone is dropzone-building — there is no
          // dropzone-blocked to look up).
          fromZone.insertBefore(card, fromZone.querySelector('.kanban-empty'));
          card.classList.add('ring-2', 'ring-red-500');
          setTimeout(() => card.classList.remove('ring-2', 'ring-red-500'), 1500);
          this.showToast(err.message || 'Move failed', 'error');
          this.updateCounts();
          return;
        }
      }

      // Save order of destination column
      const slugs = Array.from(toZone.querySelectorAll('.kanban-card')).map(c => c.dataset.slug);
      try {
        await fetch('/tasks/reorder.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ slugs: slugs })
        });
      } catch (err) {
        // Reorder save failed silently — positions will be stale but functional
      }

      this.updateCounts();
    },

    // A blocked task has no Blocked column — it lives in the Building dropzone, so
    // map blocked → building when resolving a stage back to its on-board dropzone.
    zoneForStage(stage) {
      return document.getElementById('dropzone-' + (stage === 'blocked' ? 'building' : stage));
    },

    updateCounts() {
      document.querySelectorAll('[data-stage-count]').forEach(badge => {
        const stage = badge.dataset.stageCount;
        const zone = document.getElementById('dropzone-' + stage);
        if (zone) {
          const count = zone.querySelectorAll('.kanban-card').length;
          badge.textContent = count;
          const empty = zone.querySelector('.kanban-empty');
          if (empty) empty.style.display = count === 0 ? 'flex' : 'none';
        }
      });
    },

    async archiveTask(slug) {
      if (this._pendingMoves[slug]) return;
      this._pendingMoves[slug] = true;

      const card = document.getElementById('card-' + slug);
      const oldStage = card?.dataset.stage;
      const archivedZone = document.getElementById('dropzone-archived');

      if (card && archivedZone) {
        archivedZone.insertBefore(card, archivedZone.querySelector('.kanban-empty'));
        card.dataset.stage = 'archived';
        this.updateCounts();
      }

      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/tasks/' + slug + '/archive.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
        });
        if (!resp.ok) throw new Error('Archive failed');
        this.showToast('Task archived', 'success');
      } catch (err) {
        if (card && oldStage) {
          const oldZone = this.zoneForStage(oldStage);
          if (oldZone) {
            oldZone.insertBefore(card, oldZone.querySelector('.kanban-empty'));
            card.dataset.stage = oldStage;
            this.updateCounts();
          }
        }
        this.showToast(err.message, 'error');
      } finally {
        delete this._pendingMoves[slug];
      }
    },

    async deleteTask(slug) {
      if (!confirm('Delete this task?')) return;
      if (this._pendingMoves[slug]) return;
      this._pendingMoves[slug] = true;

      const card = document.getElementById('card-' + slug);

      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/tasks/' + slug + '.json', {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken }
        });
        if (!resp.ok) throw new Error('Delete failed');
        if (card) card.remove();
        this.updateCounts();
        this.showToast('Task deleted', 'success');
      } catch (err) {
        this.showToast(err.message, 'error');
      } finally {
        delete this._pendingMoves[slug];
      }
    },

    showToast(message, type) {
      const id = Date.now();
      const toast = { id, message, type, visible: true };
      this.toasts.push(toast);
      setTimeout(() => {
        const t = this.toasts.find(t => t.id === id);
        if (t) t.visible = false;
        setTimeout(() => { this.toasts = this.toasts.filter(t => t.id !== id); }, 300);
      }, 3000);
    }
  }
}
</script>

<section x-data="kanbanBoard()" class="min-h-screen">
  <!-- Header — Dashboard/Stages as small links above the title; the title says
       where you are, and the Tasks/Deployments toggle (right) switches boards. -->
  <div class="mb-6">
    <%= render "board_top_links", current: local_assigns[:current_page] %>
    <div class="flex items-center gap-4 flex-wrap">
      <h2 class="text-2xl font-bold text-heading"><%= title %></h2>
      <%# Toggle sits directly right of the title (where you are → switch boards);
          New Task / Archived are pushed to the far right with ml-auto. %>
      <%= render "page_nav", current: local_assigns[:current_page] %>
      <% if columns.size > 4 %>
        <%# Below ~1250px the upstream lanes collapse (Building stays — it carries
            blocked, needs-attention tasks); this reveals all six (x-scroll).
            Hidden at wider widths where all six already fit. %>
        <button type="button" @click="showAllCols = !showAllCols"
                class="hidden max-[1250px]:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition bg-surface text-secondary border border-subtle hover:text-heading"
                :class="showAllCols ? 'bg-primary text-white border-primary' : ''">
          <span>All Stages</span>
        </button>
      <% end %>
      <div class="ml-auto flex items-center gap-2 flex-wrap">
        <% if archived %>
          <button @click="showArchived = !showArchived"
                  :class="showArchived ? 'bg-primary text-white' : 'bg-surface text-secondary border border-subtle hover:text-heading'"
                  class="px-3 py-1.5 rounded-lg text-sm font-medium transition">
            Archived
          </button>
        <% end %>
        <% if logged_in? %>
          <%= link_to "New Task", new_task_path, class: "btn btn-primary" %>
        <% end %>
      </div>
    </div>
  </div>

  <% if current_release || last_release %>
    <!-- Current Release (with empty state) + Last Release (read-only history): side by side on lg+, stacked below -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6 items-start">
      <%= render "current_release", release: current_release %>
      <%= render "last_release", release: last_release %>
    </div>
  <% end %>

  <%# App filter — toggle a repo to hide all its cards (client-side, like the agent
      filter). Built from the repos actually present on the board, so an app only
      appears once it has a task; unmapped slugs (e.g. rolio, pre-emoji) still show
      as a text chip. Sits right above the stage-header row. %>
  <% board_apps = (@tasks_by_stage&.values&.flatten || []).flat_map(&:devops_repositories).uniq.sort %>
  <% if board_apps.any? %>
    <div class="flex flex-wrap items-center gap-2 mb-4">
      <span class="text-xs font-semibold uppercase tracking-wider text-muted mr-1">Apps</span>
      <% board_apps.each do |app| %>
        <button type="button"
                @click="toggleApp('<%= app %>')"
                :class="appHidden('<%= app %>') ? 'opacity-40 line-through' : 'hover:border-primary/40 hover:text-heading'"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-surface text-secondary border border-subtle transition">
          <% if (emoji = app_emoji(app)) %><span class="leading-none"><%= emoji %></span><% end %>
          <span><%= app %></span>
        </button>
      <% end %>
    </div>
  <% end %>

  <!-- Kanban Board -->
  <div class="flex gap-4 overflow-x-auto pb-4">
    <% columns.each_with_index do |stage, idx| %>
      <%# Blocked tasks surface at the TOP of Building (a block means more building to do),
          on BOTH boards. The count badge + the cards both reflect that. %>
      <% column_tasks = @tasks_by_stage[stage] || [] %>
      <% column_tasks = (@tasks_by_stage["blocked"] || []) + column_tasks if stage == "building" %>
      <%# On a six-lane board (Deployments) the upstream lanes collapse below ~1250px
          unless "All Stages" is on, leaving just the last three (reviewed · assembled
          · shipped). Building collapses with them; blocked/needs-attention tasks ride
          the Building lane, so a stalled task stays reachable via "All Stages" at narrow. %>
      <% collapsible = columns.size > 4 && idx < columns.size - 3 %>
      <div class="flex-1 min-w-[190px]"
           <% if stage == 'archived' %>x-show="showArchived" x-cloak<% end %>
           <% if collapsible %>:class="showAllCols ? '' : 'max-[1250px]:hidden'"<% end %>>
        <!-- Column Header -->
        <div class="mb-3 px-1">
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-heading uppercase tracking-wider">
              <%= Task::STAGE_LABELS.fetch(stage) %>
            </h3>
            <span class="stage-count inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full text-xs font-bold
              <%= task_stage_count_classes(stage) %>"
              data-stage-count="<%= stage %>">
              <%= column_tasks.size %>
            </span>
          </div>
          <%# Kickoff-chip row, reserved at a fixed height on EVERY column (empty for
              designed/building) so all dropzones start at the same y — no height jog. %>
          <% if local_assigns[:show_kickoffs] %>
            <div class="mt-2 min-h-[26px]">
              <% if (kick = devops_kickoffs[stage]) %>
                <%= render "kickoff_chip", command: kick %>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Drop Zone -->
        <div id="dropzone-<%= stage %>"
             data-stage="<%= stage %>"
             class="kanban-dropzone rounded-xl border-2 border-dashed min-h-[calc(100vh-220px)] p-2 space-y-2 transition-colors duration-150 border-subtle">

          <% column_tasks.each do |task| %>
            <%# Blocked cards wear a reddish hue (the crew also flags the stall point). %>
            <% card_tone = task.blocked? ? "bg-red-950/40 border-red-800/60 hover:border-red-600/70 hover:bg-red-900/40" : "bg-surface border-subtle hover:border-primary/40 hover:bg-surface-alt" %>
            <div id="card-<%= task.slug %>"
                 data-slug="<%= task.slug %>"
                 data-stage="<%= task.stage %>"
                 data-agent="<%= task.agent_slug %>"
                 data-apps="<%= task.devops_repositories.join(",") %>"
                 data-href="<%= task_path(task.slug) %>"
                 x-data="{ hovered: false, mx: 0, my: 0 }"
                 x-show="matchesFilter('<%= task.agent_slug %>') && appVisible('<%= task.devops_repositories.join(",") %>')"
                 @mouseenter="hovered = true"
                 @mouseleave="hovered = false"
                 @mousedown="mx = $event.clientX; my = $event.clientY"
                 @click="if (Math.abs($event.clientX - mx) < 6 && Math.abs($event.clientY - my) < 6 && !$event.target.closest('a, button')) window.location = $el.dataset.href"
                 class="kanban-card relative <%= card_tone %> rounded-lg border p-3 cursor-pointer transition group">

              <%# Title — spans the full card width, fades at the overflowing edge
                  and scrolls to its end while the card is hovered (feature 1).
                  Archive/delete moved to the footer so nothing covers it. %>
              <a href="<%= task_path(task.slug) %>"
                 class="block mb-1.5 hover:text-primary transition"
                 title="<%= task.title %>">
                <%= render "components/overflow_fade", text: task.title, scroll_when: "hovered",
                      class: "text-heading font-semibold text-sm" %>
              </a>

              <%# Slug (left) + affected-app emojis (right) on one line. The slug fades on
                  the right when it overflows (transparency mask, same as the footer) and
                  the emojis sit OUTSIDE the fade as a normal flex item — no solid bg
                  gradient, so nothing mismatches the card colour on hover. %>
              <div class="flex items-center gap-1 mt-0.5 mb-1.5">
                <code class="block text-[10px] font-mono text-muted whitespace-nowrap overflow-hidden min-w-0 flex-1"
                      style="mask-image: linear-gradient(to right, #000 88%, transparent); -webkit-mask-image: linear-gradient(to right, #000 88%, transparent)"><%= task.slug %></code>
                <%= app_emoji_badge(task.devops_repositories, css: "shrink-0 text-xs leading-none") %>
              </div>

              <%# Stage crew (agent-events summary) sits directly under the slug — build-lane
                  stages wear the task's mascot; deploy-lane shows who reviewed/assembled/
                  shipped. Renders nothing when there are no events. %>
              <%= render "components/stage_agent_avatars", task: task, agents: @agents, variant: :stack, board: crew_board, mascot: pokemon_by_slug[task.devops_field("mascot")] %>

              <%# Session resume + live cue live on the task READ view now (off the board
                  cards). The board signals "live" via the pulsing crew time badge. %>

              <%# Planning badges (size / MIG / REL), right-aligned — only rendered when
                  one is present, so the card never carries an empty meta row. The URG /
                  HIGH priority badges and the assignee chip were dropped; the crew above
                  and the stage attribute the rest. %>
              <% if task.po_size.present? || task.requires_migration || task.requires_release_conductor? %>
                <div class="flex items-center justify-end gap-1 mb-1">
                  <% if task.po_size.present? %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-surface-alt text-secondary border border-subtle" title="po_size (official planning size)"><%= task.po_size == "xl" ? "XL" : task.po_size[0].upcase %></span>
                  <% end %>
                  <% if task.requires_migration %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-orange-900/50 text-orange-300 border border-orange-700/50" title="Requires backend_migration lane">MIG</span>
                  <% end %>
                  <% if task.requires_release_conductor? %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-orange-900/50 text-orange-300 border border-orange-700/50" title="Requires release_train lane">REL</span>
                  <% end %>
                </div>
              <% end %>

              <%# Secondary meta row — release-train badge + QA/Prod links — only when
                  there's something to show. The kind/gem badges are gone (features are
                  implicit; bug/docs/gem surface as an emoji on the footer line), and
                  Local/PR moved down to the timestamp line. %>
              <% if task.devops? && (task.devops_release_train.present? || task.devops_url("qa") || task.devops_url("production")) %>
                <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-1.5">
                  <% if task.devops_release_train.present? %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-surface-alt text-secondary border border-subtle"><%= task.devops_release_train %></span>
                  <% end %>
                  <% if (qa_url = task.devops_url("qa")) %>
                    <%= link_to "QA", qa_url, class: "text-[10px] text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
                  <% end %>
                  <% if (production_url = task.devops_url("production")) %>
                    <%= link_to "Prod", production_url, class: "text-[10px] text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
                  <% end %>
                </div>
              <% end %>

              <% if task.stage == 'failed' && task.error_message.present? %>
                <p class="text-xs text-red-400/80 truncate mt-1"><%= task.error_message %></p>
              <% end %>

              <% if (latest_activity = @latest_task_activities[task.slug]) %>
                <%# The activity type (+ note count) now rides INSIDE the message
                    box, top-left, as a small white label; the message scrolls on
                    a single line below it (fades at the overflow, steady scroll on
                    hover). %>
                <div class="mt-2 rounded-md border border-subtle bg-inset/60 px-2 py-1.5" data-test="activity-box">
                  <div class="flex items-center gap-1.5 mb-0.5">
                    <span class="text-[9px] font-semibold uppercase tracking-wide text-heading">
                      <%= latest_activity.activity_type_label %>
                    </span>
                    <% if (activity_count = @task_activity_counts[task.slug].to_i) > 1 %>
                      <span class="text-[9px] text-muted normal-case tracking-normal"><%= activity_count %> notes</span>
                    <% end %>
                  </div>
                  <%= render "components/overflow_fade", text: latest_activity.description, scroll_when: "hovered",
                        class: "text-[11px] text-secondary" %>
                </div>
              <% end %>

              <%# Footer meta line: Local + PR links + relative time on a SINGLE line that
                  fades on the right when it overflows the column (mirrors the slug row, so
                  the timestamp never wraps). The type emojis — gem (💎) then bug (🐛) /
                  docs (📚) — sit OUTSIDE the fade so they stay crisp. Features stay unmarked. %>
              <div class="flex items-center gap-2 mt-1 text-[10px]">
                <div class="flex items-center gap-2 min-w-0 flex-1 whitespace-nowrap overflow-hidden"
                     style="mask-image: linear-gradient(to right, #000 88%, transparent); -webkit-mask-image: linear-gradient(to right, #000 88%, transparent)">
                  <% if task.devops? && (local_url = task.devops_url("local")) %>
                    <%= link_to "Local", local_url, class: "text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
                  <% end %>
                  <% if task.devops? && (pr_url = task.devops_url("pr")) %>
                    <%= link_to "PR", pr_url, class: "text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
                  <% end %>
                  <span class="text-muted"><%= time_ago_in_words(task.created_at) %> ago</span>
                </div>
                <% kind_emoji = { "bug" => "🐛", "docs" => "📚" }[task.devops_kind] %>
                <% if task.gem_release? || kind_emoji %>
                  <span class="flex items-center gap-1.5 leading-none shrink-0">
                    <% if task.gem_release? %>
                      <span title="Gem release — published to RubyGems producer-first (before consuming apps)">💎</span>
                    <% end %>
                    <% if kind_emoji %>
                      <span title="<%= task.devops_kind %> task"><%= kind_emoji %></span>
                    <% end %>
                  </span>
                <% end %>
              </div>

              <%# Footer — archive + delete actions. Bleeds to the card edges with
                  a slightly inset background; each tints on hover. @click.stop
                  keeps them from triggering the card-open click (feature 2). %>
              <div class="-mx-3 -mb-3 mt-2 flex border-t border-subtle bg-inset/60 rounded-b-lg overflow-hidden">
                <% if task.stage != 'archived' %>
                  <button type="button" @click.stop="archiveTask('<%= task.slug %>')"
                          class="flex-1 inline-flex items-center justify-center gap-1 px-2 py-1.5 text-[11px] font-medium text-muted hover:text-yellow-300 hover:bg-yellow-900/20 transition" title="Archive">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                    </svg>
                    <span>Archive</span>
                  </button>
                <% end %>
                <button type="button" @click.stop="deleteTask('<%= task.slug %>')"
                        class="flex-1 inline-flex items-center justify-center gap-1 px-2 py-1.5 text-[11px] font-medium text-muted hover:text-red-300 hover:bg-red-900/20 transition <%= 'border-l border-subtle' unless task.stage == 'archived' %>" title="Delete">
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                  </svg>
                  <span>Delete</span>
                </button>
              </div>
            </div>
          <% end %>

          <!-- Empty State -->
          <div class="kanban-empty flex items-center justify-center h-24 text-muted text-sm"
               <% if (@tasks_by_stage[stage] || []).any? %>style="display: none"<% end %>>
            Drop tasks here
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Toasts -->
  <div class="fixed top-4 right-4 z-50 space-y-2">
    <template x-for="toast in toasts" :key="toast.id">
      <div x-show="toast.visible"
           x-transition:enter="transition ease-out duration-300"
           x-transition:enter-start="opacity-0 translate-x-8"
           x-transition:enter-end="opacity-100 translate-x-0"
           x-transition:leave="transition ease-in duration-200"
           x-transition:leave-start="opacity-100 translate-x-0"
           x-transition:leave-end="opacity-0 translate-x-8"
           :class="toast.type === 'success' ? 'bg-mint-900/90 border-mint-700 text-mint-300' : 'bg-red-900/90 border-red-700 text-red-300'"
           class="px-4 py-2.5 rounded-lg border text-sm font-medium shadow-lg backdrop-blur-sm">
        <span x-text="toast.message"></span>
      </div>
    </template>
  </div>
</section>
