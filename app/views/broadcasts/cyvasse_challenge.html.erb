<%# Return style "challenge" (task cyvasse-three-return-emails): short and
    game-forward. Three sentences and one button that drops the reader into a
    game; no stats, no history. No merge field is required
    (Broadcasts::CyvasseReturn). One tracked play link. %>
<% play_url = broadcast_link(:play, Broadcast::TEMPLATE_LINKS["cyvasse_challenge"]["play"]) %>
<% named = @merge_fields.nil? || Broadcasts::CyvasseReturn.username?(@merge_fields) %>
<% p_style = "margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;" %>
<% content_for :email_reason, "You&rsquo;re receiving this because you have an account on Cyvasse.".html_safe %>
<%= render "broadcasts/email_head",
      hero_file: "cyvasse_header_live.jpg",
      hero_alt:  "A Cyvasse board mid-game: a horse lines up its double jump",
      preheader: "The dragon is back on the board. Hit Play and you're in a game in seconds.",
      title:     "Your move.",
      subtitle:  "A game of Cyvasse is waiting for you." %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:28px 32px 8px 32px;">
      <p style="<%= p_style %>"><%= named ? "#{merge_field(:username)}," : "Hi \u{1F44B}\u{1F3FB}" %></p>
      <p style="<%= p_style %>" data-block="body">The dragon is back on the board. Cyvasse has been rebuilt from the ground up, and your account came with it.</p>
      <p style="<%= p_style %>" data-block="play">Hit <strong>Play</strong> and you&rsquo;re in a game in seconds, 30 seconds a move. Win, and you&rsquo;re on the leaderboard.</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;font-weight:700;" data-block="dare">Still remember how to keep your king behind the mountains?</p>
    </td>
  </tr>

  <tr>
    <td style="padding:22px 32px 8px 32px;text-align:center;">
      <%= render "broadcasts/button", url: play_url, label: "Make your move &rarr;".html_safe, color: "#8E82FE", full_width: true %>
    </td>
  </tr>

  <tr>
    <td style="padding:20px 32px 28px 32px;">
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">&mdash; Alex</p>
    </td>
  </tr>
</table>
