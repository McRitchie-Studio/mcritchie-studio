#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/atomic-event — the agent's SELF-NARRATION CLI. The agent declares the
# meaningful SPANS of its own trajectory as it works:
#
#   bin/atomic-event start --category Explore --reason "find issue with api"
#   … (the agent's raw tool-calls attribute server-side to this open span) …
#   bin/atomic-event end   --outcome "located the nil-guard in AtomicAction.capture"
#
# `start` opens a span (auto-closing any prior open one); `end` closes the
# session's open span with an outcome. There is NO per-call classifier and NO
# reader sub-agent — the agent narrates. Raw tool-calls attribute to whichever
# span is open (see AtomicAction.capture), so the span vocabulary + outcomes are
# the coarse, meaningful layer over the raw stream.
#
# Targets the SAME endpoint as bin/atomic-capture-hook (ATOMIC_CAPTURE_URL,
# default http://localhost:3000) — events and actions MUST land on the same
# server for the server-side span attribution to work. Sources the agent token
# the same way bin/atomic-capture-hook / bin/task do (AGENT_API_SECRET → 1Password
# → repo .env), and reuses the hook's on-disk token cache.
#
# NON-FATAL: this never breaks the agent's flow. Every error is swallowed, a one
# line note goes to stderr, and the process always exits 0.

require "json"
require "net/http"
require "uri"
require "time"
require "fileutils"

class AtomicEventCli
  CATEGORIES = %w[
    Explore Edit Verify Version Workflow Delegate Clarify Remote Research Plan
  ].freeze

  OPEN_TIMEOUT = 2
  READ_TIMEOUT = 5

  OP = "/opt/homebrew/bin/op"
  SECRET_REF = "op://agents/Agent API Secret/AGENT_API_SECRET"
  TOKEN_REFRESH_MARGIN = 300

  def initialize(env: ENV, out: $stdout, err: $stderr)
    @env = env
    @out = out
    @err = err
  end

  # Entry point. Parses argv, dispatches start/end, and ALWAYS returns (the main
  # guard exits 0 regardless) — nothing here may break the calling session.
  def run(argv)
    command = argv.shift
    flags = parse_flags(argv)

    case command
    when "start" then start(flags)
    when "end"   then finish(flags)
    else
      warn_note("usage: atomic-event start --category <C> --reason <text> | " \
                "end [--outcome <text>]")
    end
  rescue StandardError => e
    warn_note("atomic-event failed (ignored): #{e.class}: #{e.message}")
  end

  # ── Commands ──────────────────────────────────────────────────────────────

  def start(flags)
    sid = resolve_session_id(flags)
    return warn_note("atomic-event: no session id — nothing to narrate") unless present?(sid)

    category = flags["category"].to_s.strip
    reason   = flags["reason"].to_s.strip
    return warn_note("atomic-event start needs --category and --reason") if category.empty? || reason.empty?
    unless CATEGORIES.include?(category)
      return warn_note("atomic-event: unknown --category #{category.inspect} " \
                       "(one of: #{CATEGORIES.join(', ')})")
    end

    marker = resolve_marker(session_id: sid)
    res = post("/api/v1/atomic_events", {
      "session_id" => sid,
      "category"   => category,
      "reason"     => reason,
      "task_slug"  => marker["task_slug"],
      "mascot"     => marker["mascot"],
      "stage"      => marker["stage"]
    }.compact)

    report(res, "opened #{category} · #{reason}")
  end

  def finish(flags)
    sid = resolve_session_id(flags)
    return warn_note("atomic-event: no session id — nothing to narrate") unless present?(sid)

    outcome = flags["outcome"].to_s.strip
    res = post("/api/v1/atomic_events/close", {
      "session_id" => sid,
      "outcome"    => outcome
    }.reject { |_, v| v.to_s.empty? })

    report(res, outcome.empty? ? "closed span" : "closed · #{outcome}")
  end

  # ── argv + session/marker resolution ──────────────────────────────────────

  # Minimal --flag value parser (repeats: last wins). Bare/unknown args ignored.
  def parse_flags(argv)
    flags = {}
    i = 0
    while i < argv.length
      arg = argv[i]
      if arg.start_with?("--")
        flags[arg.delete_prefix("--")] = argv[i + 1]
        i += 2
      else
        i += 1
      end
    end
    flags
  end

  # --session override (tests / explicit), else the agent session id the harness
  # exposes (Claude: CLAUDE_CODE_SESSION_ID, Codex: CODEX_THREAD_ID).
  def resolve_session_id(flags)
    explicit = flags["session"].to_s.strip
    return explicit unless explicit.empty?

    claude = @env["CLAUDE_CODE_SESSION_ID"].to_s.strip
    return claude unless claude.empty?

    @env["CODEX_THREAD_ID"].to_s.strip
  end

  # task_slug / mascot / stage the way the capture hook resolves them: the nearest
  # .agent-context.json walking up from cwd (the worktree desk) wins, else the
  # per-session marker. Never raises.
  def resolve_marker(session_id:)
    data = read_context_marker(Dir.pwd) || read_session_marker(session_id) || {}
    {
      "task_slug" => first_present(data, "task_record_slug", "task_slug", "slug"),
      "mascot"    => blank_to_nil(data["mascot"]),
      "stage"     => blank_to_nil(data["stage"])
    }
  rescue StandardError
    { "task_slug" => nil, "mascot" => nil, "stage" => nil }
  end

  # ── HTTP + auth (cached token, mirrors the capture hook) ───────────────────

  def post(path, body)
    tok = token
    return nil unless tok

    res = http_json(:post, path, body, bearer: tok)
    invalidate_token! if res && res.code.to_i == 401
    res
  rescue StandardError => e
    warn_note("atomic-event POST #{path} failed (ignored): #{e.class}")
    nil
  end

  def report(res, ok_message)
    if res && res.code.to_i.between?(200, 299)
      @out.puts("atomic-event: #{ok_message}")
    elsif res
      warn_note("atomic-event: server said #{res.code} (ignored)")
    else
      warn_note("atomic-event: no response (ignored)")
    end
  end

  private

  def base_url
    url = @env["ATOMIC_CAPTURE_URL"].to_s.strip
    url.empty? ? "http://localhost:3000" : url
  end

  def token
    cached = read_cached_token
    return cached if cached

    secret = agent_secret
    return nil unless secret

    res = http_json(:post, "/api/v1/auth", { "secret" => secret }, bearer: nil)
    return nil unless res && res.code.to_i.between?(200, 299)

    body = JSON.parse(res.body) rescue {}
    tok = body["token"]
    write_cached_token(tok, body["expires_at"]) if present?(tok)
    tok
  rescue StandardError
    nil
  end

  def token_cache_path
    File.join(projects_dir, ".agents", "atomic-capture", "token.json")
  end

  def read_cached_token
    path = token_cache_path
    return nil unless File.file?(path)

    data = JSON.parse(File.read(path))
    return nil unless present?(data["token"])

    if present?(data["expires_at"])
      expires = Time.parse(data["expires_at"])
      return nil if Time.now >= (expires - TOKEN_REFRESH_MARGIN)
    end
    data["token"]
  rescue StandardError
    nil
  end

  def write_cached_token(tok, expires_at)
    path = token_cache_path
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, JSON.generate("token" => tok, "expires_at" => expires_at))
  rescue StandardError
    nil
  end

  def invalidate_token!
    File.delete(token_cache_path)
  rescue StandardError
    nil
  end

  # ENV, then 1Password, then repo .env — same order as bin/task / the hook.
  def agent_secret
    env = @env["AGENT_API_SECRET"].to_s
    return env unless env.empty?

    if File.executable?(OP)
      op = begin
        IO.popen([OP, "read", SECRET_REF], err: File::NULL, &:read).to_s.strip
      rescue StandardError
        ""
      end
      return op unless op.empty?
    end

    dotenv = File.join(repo_root, ".env")
    if File.file?(dotenv)
      line = File.readlines(dotenv).find { |l| l.start_with?("AGENT_API_SECRET=") }
      return line.split("=", 2)[1].to_s.strip if line
    end
    nil
  rescue StandardError
    nil
  end

  def http_json(method, path, body, bearer:)
    uri = URI.join(base_url, path)
    klass = { get: Net::HTTP::Get, post: Net::HTTP::Post }.fetch(method)
    req = klass.new(uri)
    req["Authorization"] = "Bearer #{bearer}" if bearer
    if body
      req["Content-Type"] = "application/json"
      req.body = JSON.generate(body)
    end
    http = Net::HTTP.new(uri.host, uri.port)
    http.use_ssl = (uri.scheme == "https")
    http.open_timeout = OPEN_TIMEOUT
    http.read_timeout = READ_TIMEOUT
    http.request(req)
  rescue StandardError
    nil
  end

  # ── Marker files (mirror bin/atomic-capture-hook) ──────────────────────────

  def read_context_marker(cwd)
    dir = present?(cwd) ? File.expand_path(cwd) : nil
    return nil unless dir

    loop do
      path = File.join(dir, ".agent-context.json")
      return JSON.parse(File.read(path)) if File.file?(path)

      parent = File.dirname(dir)
      return nil if parent == dir

      dir = parent
    end
  rescue StandardError
    nil
  end

  def read_session_marker(session_id)
    sid = session_id.to_s.strip
    return nil if sid.empty?

    safe = sid.gsub(/[^A-Za-z0-9._-]/, "")
    path = File.join(projects_dir, ".agents", "sessions", "#{safe}.json")
    return nil unless File.file?(path)

    JSON.parse(File.read(path))
  rescue StandardError
    nil
  end

  # ── Paths + tiny helpers ───────────────────────────────────────────────────

  def projects_dir
    dir = @env["CLAUDE_PROJECTS_DIR"].to_s.strip
    dir.empty? ? default_projects_dir : File.expand_path(dir)
  end

  def repo_root
    File.expand_path("..", __dir__)
  end

  def default_projects_dir
    candidate = File.expand_path("../..", __dir__)
    if File.basename(candidate) == ".worktrees"
      File.expand_path("../..", candidate)
    else
      candidate
    end
  end

  def first_present(hash, *keys)
    keys.each do |key|
      value = hash[key]
      return value if present?(value)
    end
    nil
  end

  def blank_to_nil(value)
    present?(value) ? value : nil
  end

  def present?(value)
    !value.nil? && value != false && !value.to_s.strip.empty?
  end

  def warn_note(message)
    @err.puts(message)
    nil
  end
end

# Only run when invoked directly (not when `load`ed by a test).
if $PROGRAM_NAME == __FILE__
  AtomicEventCli.new.run(ARGV)
  exit 0 # ALWAYS succeed — narration must never fail the session
end
