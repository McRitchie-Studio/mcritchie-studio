<%# locals: (preview:) %>
<% entry = preview.entry %>
<div class="rounded-2xl border border-subtle bg-surface overflow-hidden" data-test="asset-preview" data-key="<%= entry.key %>">
  <div class="bg-inset flex items-center justify-center">
    <% case entry.kind %>
    <% when :image %>
      <img src="<%= preview.url %>" alt="<%= entry.name %>" class="max-h-[60vh] w-full object-contain">
    <% when :video %>
      <video src="<%= preview.url %>" controls preload="metadata" playsinline class="max-h-[60vh] w-full bg-black"></video>
    <% else %>
      <p class="px-4 py-10 text-sm text-muted" data-test="asset-preview-none">No preview for this type.</p>
    <% end %>
  </div>
  <div class="p-4 space-y-3">
    <p class="font-semibold text-heading break-all"><%= entry.name %></p>
    <dl class="grid grid-cols-[auto_minmax(0,1fr)] gap-x-4 gap-y-1 text-sm">
      <dt class="text-muted">Size</dt>
      <dd class="text-body" data-test="asset-preview-size"><%= number_to_human_size(entry.size) %></dd>
      <dt class="text-muted">Type</dt>
      <dd class="text-body break-all" data-test="asset-preview-type"><%= entry.mime %></dd>
      <dt class="text-muted">Modified</dt>
      <dd class="text-body" data-test="asset-preview-modified">
        <% if entry.last_modified %>
          <time datetime="<%= entry.last_modified.utc.iso8601 %>"><%= entry.last_modified.utc.strftime("%Y-%m-%d %H:%M UTC") %></time>
        <% else %>
          unknown
        <% end %>
      </dd>
      <dt class="text-muted">Key</dt>
      <dd class="text-body break-all text-xs font-mono"><%= entry.key %></dd>
    </dl>
    <a href="<%= preview.url %>" target="_blank" rel="noopener" class="btn btn-outline btn-sm">Open signed link</a>
    <p class="text-xs text-muted">Signed links expire after 15 minutes.</p>
  </div>
</div>
