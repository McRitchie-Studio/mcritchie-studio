<%# "How was your first game": a short personal note to someone who played the
    rebuilt Cyvasse (task first-game-feedback-survey), asking how it felt. One
    button, to Cyvasse's survey through the click tracker, which adds the
    reader's token as ?ref= so the answer is credited to them. The subject comes from
    Broadcasts::CyvasseFirstGame; no merge field is required. %>
<% links      = Broadcast::TEMPLATE_LINKS["cyvasse_first_game"] %>
<% survey_url = broadcast_link(:survey, links["survey"]) %>
<% build_url  = broadcast_link(:build, links["build"]) %>
<% username   = merge_field(:username, fallback: "") %>
<% p_style    = "margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;" %>
<% content_for :email_reason, "You&rsquo;re receiving this because you played Cyvasse.".html_safe %>
<%= render "broadcasts/email_head",
      hero_file: "cyvasse_header_live.jpg",
      hero_alt:  "A Cyvasse board mid-game",
      preheader: "Five quick questions about your first game. Alex reads every answer.",
      title:     "How was your first game?",
      subtitle:  "Thank you for playing the new Cyvasse." %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:28px 32px 8px 32px;">
      <p style="<%= p_style %>">Hi<%= " #{username}" if username.present? %>,</p>
      <p style="<%= p_style %>" data-block="body">Thank you for playing Cyvasse. We rebuilt it from scratch, and you&rsquo;re one of the first people to play the new version.</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">How did it feel? Five quick questions, and I read every answer.</p>
    </td>
  </tr>

  <tr>
    <td style="padding:22px 32px 8px 32px;text-align:center;">
      <%= render "broadcasts/button", url: survey_url, label: "Tell us how it went &rarr;".html_safe, color: "#8E82FE", full_width: true %>
    </td>
  </tr>

  <tr>
    <td style="padding:20px 32px 8px 32px;">
      <p style="margin:0 0 4px 0;font-size:16px;line-height:1.65;color:#2b3440;">Thanks,</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">&mdash; Alex</p>
    </td>
  </tr>

  <tr>
    <td style="padding:14px 32px 28px 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #eef1f4;">
        <tr><td style="padding-top:16px;font-size:13px;line-height:1.6;color:#94a3b8;"><strong style="color:#64748b;">P.S.</strong> Cyvasse is built at McRitchie Studio, where we turn an idea into a working app. Got one of your own? <a href="<%= build_url %>" style="color:#8E82FE;font-weight:700;text-decoration:none;">Describe it and we&rsquo;ll build it &rarr;</a></td></tr>
      </table>
    </td>
  </tr>
</table>
