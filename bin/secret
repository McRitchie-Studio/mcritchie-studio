#!/usr/bin/env bash
# bin/secret <vault> <item> [field] — print a 1Password secret VALUE to stdout.
#
# The value goes to stdout (so `SECRET="$(bin/secret agents agent.heroku 'api key')"`
# works); all diagnostics go to stderr; the value is never logged or echoed.
# Verifies the op CLI is present and authenticated first. This is the sanctioned
# replacement for hand-rolling `op read` chains in agent scripts.
set -euo pipefail

# SECRET_OP_BIN is a TEST SEAM, mirroring GH_APP_OP_BIN (bin/gh-app-git-credential)
# and GH_TOKEN_OP_BIN (bin/gh-token). Every other `op` consumer in this stack had
# one; this script did not, and the absence had a cost — its fallback behaviour
# could not be tested without SPENDING REAL READS against the operator's live
# vault, because the hardcoded path ignores PATH and so ignores any stand-in a
# test puts there. Measured while writing test/commands/op_meter_fallback_test.rb:
# a booby-trapped `op` first on PATH was silently bypassed and the suite talked to
# 1Password for real.
OP="${SECRET_OP_BIN:-/opt/homebrew/bin/op}"

# ── 1Password read attribution ────────────────────────────────────────────────
# Route every `op` call through op_metered so the read is recorded against THIS
# script (bin/lib/op-meter.sh; query with bin/op-reads). Sourcing is OPTIONAL by
# construction: if the shim is missing or unreadable, op_metered falls back to
# running the binary directly. A metering problem must never cost this script its
# credential read — every consumer here has a working fallback for a rate-limited
# or absent `op`, and that survived a full-day 1Password outage.
OP_METER_VIA="secret"
OP_METER_SH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/lib/op-meter.sh"
# shellcheck source=lib/op-meter.sh
[ -r "$OP_METER_SH" ] && . "$OP_METER_SH" || true
command -v op_metered >/dev/null 2>&1 || op_metered() { local __b="$1"; shift; "$__b" "$@"; }
vault="${1:-}"
item="${2:-}"
field="${3:-password}"

if [ -z "$vault" ] || [ -z "$item" ]; then
  echo "usage: bin/secret <vault> <item> [field]   (field defaults to 'password')" >&2
  exit 2
fi

[ -x "$OP" ] || { echo "secret: 1Password CLI not found at $OP" >&2; exit 1; }
op_metered "$OP" whoami >/dev/null 2>&1 || {
  echo "secret: op is not authenticated. Run 'op signin' or set OP_SERVICE_ACCOUNT_TOKEN (see bin/setup-1pass-token)." >&2
  exit 1
}

ref="op://${vault}/${item}/${field}"
value="$(op_metered "$OP" read "$ref" 2>/dev/null)" || {
  echo "secret: could not read ${ref} (check vault/item/field against credential-inventory.md)" >&2
  exit 1
}
[ -n "$value" ] || { echo "secret: empty value at ${ref}" >&2; exit 1; }

printf '%s' "$value"
