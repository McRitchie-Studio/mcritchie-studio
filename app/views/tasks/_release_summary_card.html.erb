<%# THE RELEASES SUMMARY CARD — the second /deployments summary card. The operator's
    spec, and nothing past it: features per app in the emoji-count convention
    ("🪎 4  🐊 2  🧱 1"), when the last release shipped, and the Pokémon that ran it.
    The full Next + Last release cards — tracker, member pills, links, seal — open in the
    sidebar, ids intact, so every release broadcast and animation still lands there.

    NEXT reads one of two things, and says which:
      a candidate is open  → its members per app, its state, its conductor and a live
                             in-progress clock;
      nothing is open      → what is QUEUED on `accepted` per app — exactly what the
                             next sweep will promote. "None active" alone was what the
                             old card said most of the day, which answered nothing.

    LAST reads the most recent shipped release: the ship time in the reader's own clock
    (the engine's at-time primitive), the conductor's sprite and name, how long it took,
    its smoke seal, and its members per app.

    #release-summary-card IS A BROADCAST SLOT. DeploymentsBroadcaster.app_ladder replaces
    it: every release event and every `merged` stamp change already fires that push, and
    those are exactly what move these counts. CI ticks skip it — nothing here reads CI.

    Locals: current_release, last_release, cards (the ladder cards, for queued counts) %>
<% rel = local_assigns[:current_release] %>
<% last = local_assigns[:last_release] %>
<% cards = local_assigns.fetch(:cards, []) %>
<% next_counts = rel ? release_member_repo_counts(rel.tasks.to_a) : release_queued_repo_counts(cards) %>
<% last_counts = last ? release_member_repo_counts(last.tasks.to_a) : [] %>
<% queued_total = rel ? nil : cards.sum { |card| card.parked_at("accepted") } %>
<%= tag.div(**deploy_summary_card_options("releases", test: "release-summary-card", id: "release-summary-card"),
            "data-rendered-at": (Time.current.to_f * 1000).to_i) do %>
  <%= render "tasks/summary_card_header", panel: "releases", title: "Releases",
             meta: rel ? "candidate open" : nil %>

  <div class="mt-3 flex flex-1 flex-col gap-3">
    <%# NEXT %>
    <section class="min-w-0" data-test="release-summary-next" data-state="<%= rel ? "open" : "queued" %>">
      <div class="flex items-baseline justify-between gap-2">
        <span class="text-[10px] font-semibold uppercase tracking-wide text-muted">Next</span>
        <% if rel %>
          <span class="truncate text-[11px] font-medium text-heading" data-test="release-summary-next-state"><%= release_state_label(rel, current: true) %></span>
        <% else %>
          <span class="text-[11px] italic text-muted" data-test="release-summary-next-state">none active</span>
        <% end %>
      </div>
      <% if next_counts.any? %>
        <div class="mt-1.5">
          <%= render "tasks/app_count_cluster", entries: next_counts, test_id: "release-summary-next-counts" %>
        </div>
      <% end %>
      <p class="mt-1 truncate text-[11px] text-muted" data-test="release-summary-next-note">
        <% if rel %>
          <% if (mascot = rel.mascot) %><span style="<%= "color: #{mascot.signature_color};" if mascot.signature_color.present? %>"><%= mascot.name %></span> · <% end %>
          <span class="tabular-nums" data-release-ticker data-since="<%= rel.created_at.to_i %>" data-prefix="in progress · ">in progress · <%= release_elapsed_clock(rel) %></span>
        <% elsif queued_total.positive? %>
          <%= pluralize(queued_total, "task") %> queued on accepted
        <% else %>
          nothing queued on accepted
        <% end %>
      </p>
    </section>

    <div class="border-t border-subtle/70"></div>

    <%# LAST %>
    <section class="min-w-0" data-test="release-summary-last">
      <% if last %>
        <div class="flex items-baseline justify-between gap-2">
          <span class="text-[10px] font-semibold uppercase tracking-wide text-muted">Last</span>
          <span class="flex min-w-0 items-center gap-1.5 text-[11px] font-medium text-heading" data-test="release-summary-last-shipped">
            <% if (seal = last.smoke_seal) %>
              <span class="leading-none" data-test="release-summary-seal" data-seal-status="<%= seal.status %>" title="<%= release_smoke_seal_title(seal) %>"><%= seal.badge %></span>
            <% end %>
            <span class="truncate"><%= release_state_label(last) %></span>
          </span>
        </div>
        <% last_mascot = last.mascot %>
        <% timing = release_timing_label(last) %>
        <% if last_mascot || timing %>
          <div class="mt-1.5 flex min-w-0 items-center gap-1.5 text-xs text-secondary" data-test="release-summary-last-conductor">
            <% if last_mascot %>
              <% if last_mascot.sprite_url.present? %>
                <img src="<%= last_mascot.sprite_url %>" alt="" width="24" height="24" loading="lazy" class="h-6 w-6 shrink-0" style="image-rendering: pixelated;">
              <% end %>
              <span class="truncate font-medium" data-test="release-summary-last-mascot"
                    style="<%= "color: #{last_mascot.signature_color};" if last_mascot.signature_color.present? %>"><%= last_mascot.name %></span>
            <% end %>
            <% if timing %><span class="shrink-0 text-muted"><%= last_mascot ? "· " : "" %><%= timing %></span><% end %>
          </div>
        <% end %>
        <% if last_counts.any? %>
          <div class="mt-1.5">
            <%= render "tasks/app_count_cluster", entries: last_counts, test_id: "release-summary-last-counts" %>
          </div>
        <% end %>
      <% else %>
        <div class="flex items-baseline justify-between gap-2">
          <span class="text-[10px] font-semibold uppercase tracking-wide text-muted">Last</span>
          <span class="text-[11px] italic text-muted">none yet</span>
        </div>
      <% end %>
    </section>
  </div>
<% end %>
