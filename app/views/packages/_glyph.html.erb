<%# A drawn row mark (WorkspacePackage::GLYPHS), sized to sit beside the brand logos in a row's lead. app: a browser window with a spark, read as "your custom app". %>
<% case name %>
<% when "app" %>
  <svg class="h-4 w-4 md:h-5 md:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"
       role="img" aria-label="Your custom app" data-test="glyph" data-glyph="app">
    <rect x="3" y="4" width="18" height="16" rx="3"/>
    <path d="M3 9h18"/>
    <circle cx="6.5" cy="6.5" r="0.6" fill="currentColor" stroke="none"/>
    <circle cx="9" cy="6.5" r="0.6" fill="currentColor" stroke="none"/>
    <path d="M12 12.2l.9 2 2 .9-2 .9-.9 2-.9-2-2-.9 2-.9z" fill="currentColor"/>
  </svg>
<% end %>
