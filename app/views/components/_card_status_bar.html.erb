<%# locals: (scheme:, label:, action_label: nil, href: nil, new_tab: true, flashing: false, test_id: nil, title: nil, icon: nil, link_data: {}) %>
<%#
  Full-length card status bar — one reusable, card-width notice/CTA used on the
  board task card. When `href` is present the whole bar is a link (@click.stop so
  it doesn't ALSO fire the card-open click); otherwise it renders a static notice
  div. `action_label` appends "· <verb> →" to signal the click destination.

  `flashing` adds a seeded pulse: it reads the card-level --task-pulse-delay /
  --task-pulse-duration custom properties (set per-card by TaskCardComponent from a slug
  hash) so many flashing bars across the board pulse OUT of phase — irregular,
  not a synchronized strobe.
%>
<% schemes = {
     amber:  "bg-warning text-black border-warning/40 shadow-sm hover:brightness-110",
     red:    "bg-danger text-white border-danger shadow-sm hover:brightness-110",
     violet: "bg-primary text-white border-primary/40 shadow-sm hover:brightness-110",
     mint:   "bg-success text-black border-success/40 shadow-sm hover:brightness-110",
   } %>
<% tone = schemes.fetch(scheme.to_sym, schemes[:amber]) %>
<%# The label-CTA VARIANT of the shared components/_card_bar shell: centered, bold,
    tiny type, plus this bar's tone. The shell owns the card_bar_base_classes geometry
    (width/radius/border/inset) so this bar, the blocker-summary bar, and the CI meter
    all read as one evenly-stacked set. `flashing` adds the seeded out-of-phase pulse. %>
<% content_classes = "flex items-center justify-center gap-1.5 text-3xs font-bold leading-tight #{tone} #{'motion-safe:animate-pulse' if flashing}" %>
<% pulse_style = ("animation-delay: var(--task-pulse-delay, 0s); animation-duration: var(--task-pulse-duration, 2s);" if flashing) %>
<% bar_body = capture do %><% if icon %><span aria-hidden="true"><%= icon %></span><% end %><span><%= label %></span><% if action_label %><span class="opacity-60">·</span><span class="font-semibold"><%= action_label %></span><span aria-hidden="true">→</span><% end %><% end %>
<%= render "components/card_bar",
      body: bar_body, class_extra: content_classes, link_class_extra: "transition cursor-pointer",
      style: pulse_style, href: href, new_tab: new_tab,
      test_id: test_id, title: title, link_data: link_data %>
