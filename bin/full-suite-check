#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/full-suite-check — run the FULL test suite + FULL rubocop, then record
# fingerprint-bound evidence on a task so bin/dor-check can credit it.
#
# This is the WRITE half of the full-suite gate (bin/dor-check is the READ half;
# the shared format lives in bin/lib/full_suite_gate.rb). It exists because the
# devops retro found builds passing only the FILES they touched while the full
# suite or rubocop broke — surfacing post-merge. Running this before handoff is
# the one command that proves the WHOLE suite + lint is green on the EXACT code
# you're shipping.
#
# It runs two lanes, from the repo root:
#   full-suite : the repo's OWN CI test command, VERBATIM — read from its
#                .github/workflows/ci.yml (bin/lib/ci_test_command.rb); today, for
#                every Rails repo here, `bin/rails db:test:prepare test test:system`
#   rubocop    : bin/rubocop         (NO path args = the whole repo)
#
# The full-suite lane RUNS WHAT CI RUNS, and that is the point. It used to run
# `bin/rails test`, which SKIPS test/system — so the CI-INDEPENDENT cert (the
# route you take precisely BECAUSE you're not waiting on CI's verdict, and the
# ONLY route available for a repo whose CI bin/dor-check can't read) tested
# strictly LESS than CI: green cert, ZERO system coverage. Reading the command
# from ci.yml instead of hard-coding one means the two cannot drift apart again.
# Do NOT "simplify" the command's shape — `bin/rails test test:system` is BROKEN
# (`test` is a real rails command, so `test:system` parses as a PATH and dies with
# LoadError). See bin/lib/ci_test_command.rb; the shape is pinned by a test.
# For each lane that passes it stamps a checks_run line tagged with the current
# code fingerprint, e.g. "[full-suite@<tree-hash>] ...". A lane that FAILS is not
# recorded (no green evidence), and the command exits non-zero.
#
# Usage:
#   bin/full-suite-check <task-slug>     # run both lanes; record evidence on the task
#   bin/full-suite-check <task-slug> --print   # run + print the evidence lines, don't record
#   bin/full-suite-check --print               # run standalone (no task), just print
#
# Test-scope telemetry: each lane self-reports a kind=test_scope AgentAction
# (event_slug=<lane key>, result_slug=pass|fail, duration_ms) through the SAME
# `bin/agent-activity action` verb bin/release.rb's run_test_scope uses, so a
# LOCAL cert run is a gradeable unit in /alex/pipeline like a release run. It is
# best-effort/non-fatal, gated on a live session, and inert when no activity is
# open (the verb self-checks) — telemetry NEVER breaks or slows a cert. The lane
# keys are registered under `full_suite_scopes:` in config/devops_test_suites.yml.
# CI telemetry emits the SAME test_scope verdicts for a PR's GitHub Actions run —
# not from CI (no board token there) but by LOCAL INGESTION: bin/ci-scope-capture
# reads `gh pr checks` and self-reports them through this exact `action` verb
# (`ci_scopes:` in the same registry). Same source, another origin.
#
# Test/CI seams (so the orchestration is exercisable without a real multi-minute run):
#   FULL_SUITE_TEST_DB_RESET_CMD  override the test DB reset command
#                                (default: bin/rails db:test:purge db:test:prepare)
#   FULL_SUITE_SKIP_TEST_DB_RESET set to 1 only for non-Rails harness tests
#   FULL_SUITE_TEST_CMD     override the test lane command   (default: the repo's own
#                           ci.yml test command; bin/lib/ci_test_command.rb). Also
#                           overrides the REFUSAL — an explicit command is the
#                           operator saying "run THIS", so nothing is resolved.
#   MCR_SYSTEM_TEST_BROWSER force the headless-Chrome probe (1 present / 0 absent);
#                           tests only — see bin/lib/system_test_browser.rb
#   MCR_SYSTEM_TEST_MACOS_CHROME  override the probe's macOS Chrome.app path;
#                           tests only — see bin/lib/system_test_browser.rb
#   FULL_SUITE_RUBOCOP_CMD  override the rubocop lane command (default: bin/rubocop)
#   FULL_SUITE_ROOT         repo dir to run + fingerprint in (default: the cwd's
#                           git toplevel, else this repo); an explicit value
#                           bypasses the task-root guard (a deliberate root)
#   FULL_SUITE_TASK_BIN     board CLI (default: bin/task; tests stub it)
#   FULL_SUITE_GATE_BIN     gate CLI  (default: bin/gate; tests stub it)
#   FULL_SUITE_AGENT_ACTIVITY  override the narration CLI path (default: bin/agent-activity);
#                              tests point it at a stub that logs the emit argv
#
# Exit code: 0 = both lanes green (evidence recorded), 1 = a lane failed or no
# fingerprint (nothing certified).

require "optparse"
require "json"
require "shellwords" # the pasteable recovery commands are SHELL-quoted, not inspect'd
require_relative "lib/full_suite_gate"
require_relative "lib/repo_root"
require_relative "lib/session_identity"
require_relative "lib/cert_emission"
require_relative "lib/cert_root_guard"
require_relative "lib/ci_test_command"
require_relative "lib/system_test_browser"
require_relative "lib/cert_tree_guard"
require_relative "lib/cert_orphan_guard"
require_relative "lib/cert_process"

# ROOT = the gate script's OWN repo (the hub). CONFIG (lib/) is required relative
# to __dir__, and the board is reached via TASK_BIN — both stay anchored here. The
# CODE we run + fingerprint, though, roots at the agent's worktree (below).
ROOT = File.expand_path("..", __dir__)
TASK_BIN = ENV.fetch("FULL_SUITE_TASK_BIN", File.expand_path("task", __dir__))
GATE_BIN = ENV.fetch("FULL_SUITE_GATE_BIN", File.expand_path("gate", __dir__))

# The narration CLI — the SAME emit seam bin/release.rb's run_test_scope
# self-reports through (its agent_action shells this exact `action` verb). We fire
# it FORGET-fully for telemetry only; FULL_SUITE_AGENT_ACTIVITY overrides it for
# tests (a stub that logs argv instead of POSTing).
AGENT_ACTIVITY = ENV.fetch("FULL_SUITE_AGENT_ACTIVITY", File.expand_path("agent-activity", __dir__))

# Stable test-scope key per cert lane — registered under `full_suite_scopes:` in
# config/devops_test_suites.yml (which supplies each key's phase/tier/host chips
# on the /alex/pipeline Test-runs band). NEVER rename a key casually: emitted
# telemetry and grading key off it. A label absent from this map emits nothing.
LANE_SCOPES = {
  "test-db-reset" => "full_suite_db_reset",
  "full-suite"    => "full_suite_test",
  "rubocop"       => "full_suite_rubocop"
}.freeze

options = { print: false }
OptionParser.new do |o|
  o.banner = "Usage: bin/full-suite-check <task-slug> [--print] | --install-hook | --uninstall-hook"
  o.on("--print", "Print the evidence lines instead of recording them on the task") { options[:print] = true }
  o.on("--install-hook", "Install an opt-in pre-push hook that runs this gate before each push") { options[:install_hook] = true }
  o.on("--uninstall-hook", "Remove the pre-push hook installed by --install-hook") { options[:uninstall_hook] = true }
  o.on("-h", "--help", "Show this help") do
    puts o
    exit 0
  end
end.parse!

slug = ARGV.shift
# Run + fingerprint the CODE at the agent's worktree (cwd's git toplevel), so a
# task in a SATELLITE worktree certifies the satellite — not the hub this script
# lives in. FULL_SUITE_ROOT overrides (the CI/test seam); falls back to ROOT when
# cwd isn't in a git tree. For a mcritchie-studio worktree this is the same dir.
root = RepoRoot.code_root(ENV["FULL_SUITE_ROOT"], ROOT)

# --- opt-in pre-push hook installer -------------------------------------------
# "Pre-commit hooks always run" (git-protocol.md) — but a FULL suite on every
# commit is untenable, so the gate ships as an OPT-IN pre-push hook (the house
# convention favours pre-push for heavy checks). Nothing is wired by default; you
# run the installer. The hook runs this same gate (full suite + rubocop) and
# blocks the push if red — the push-time mirror of bin/dor-check's merge gate.
HOOK_MARKER = "# managed by: bin/full-suite-check --install-hook"

def hooks_dir(root)
  out = IO.popen(["git", "-C", root, "rev-parse", "--git-path", "hooks"], err: File::NULL, &:read).to_s.strip
  out.empty? ? nil : File.absolute_path(out, root)
end

def install_pre_push_hook(root)
  dir = hooks_dir(root) or abort "full-suite-check: not a git repo at #{root} — can't install the hook."
  require "fileutils"
  FileUtils.mkdir_p(dir)
  path = File.join(dir, "pre-push")
  if File.exist?(path) && !File.read(path).include?(HOOK_MARKER)
    abort "full-suite-check: #{path} already exists and isn't ours — leaving it. Inspect it, then add " \
          "`exec bin/full-suite-check --print` yourself (or move it aside and re-run --install-hook)."
  end
  File.write(path, <<~HOOK)
    #!/bin/sh
    #{HOOK_MARKER}
    # Opt-in: runs the FULL test suite + FULL rubocop before every push and blocks
    # the push if either is red — the same gate bin/dor-check enforces at handoff.
    # Remove with `bin/full-suite-check --uninstall-hook`. Never bypass (--no-verify).
    exec bin/full-suite-check --print
  HOOK
  FileUtils.chmod("+x", path)
  warn "full-suite-check: installed opt-in pre-push hook → #{path}"
  warn "full-suite-check: it runs the full suite + rubocop before each push; disable with --uninstall-hook."
end

def uninstall_pre_push_hook(root)
  dir = hooks_dir(root)
  path = dir && File.join(dir, "pre-push")
  if path && File.exist?(path) && File.read(path).include?(HOOK_MARKER)
    File.delete(path)
    warn "full-suite-check: removed the opt-in pre-push hook → #{path}"
  else
    warn "full-suite-check: no managed pre-push hook to remove."
  end
end

if options[:install_hook]
  install_pre_push_hook(root)
  exit 0
elsif options[:uninstall_hook]
  uninstall_pre_push_hook(root)
  exit 0
end

# --- task-root guard -----------------------------------------------------------
# The evidence stamps `root`'s fingerprint against the TASK — so when a slug is
# given and the root was resolved IMPLICITLY (cwd, no FULL_SUITE_ROOT), the root
# must BE the task's tree (its branch, or its .worktrees/<worktree_slug> dir).
# Run from the wrong checkout — the hub primary on main, say — this used to
# green-certify a tree the task never touched (fail-GREEN, live 2026-07-12).
# Refuse BEFORE any lane runs or gate/checkpoint write. bin/lib/cert_root_guard.rb.
if slug && ENV["FULL_SUITE_ROOT"].to_s.strip.empty?
  wrong_root = CertRootGuard.refusal(task_bin: TASK_BIN, slug: slug, root: root)
  abort "full-suite-check: #{wrong_root}" if wrong_root
end

# --- dirty-tree guard ----------------------------------------------------------
# Same family as the root guard above, same fail-GREEN shape: the root guard stops
# a cert of the wrong TREE, this one stops a cert of an UNCOMMITTED tree. The
# fingerprint hashes the WORKING tree (git add -A + write-tree), so certifying with
# edits still uncommitted stamps GREEN evidence over code the PR never receives —
# live on 2026-07-14, when a worktree's 146 lines of certified work never reached
# PR #537. Certify AFTER the final commit; this makes that a rule, not a memory.
# Same gating as the root guard: only with a slug (no slug → --print/the opt-in
# pre-push hook, which records nothing) and only on an IMPLICIT root (an explicit
# FULL_SUITE_ROOT is the deliberate CI/test seam). The index is refreshed before it
# is read, so a stat-stale tree cannot false-refuse. bin/lib/cert_tree_guard.rb.
if slug && ENV["FULL_SUITE_ROOT"].to_s.strip.empty?
  dirty = CertTreeGuard.refusal(command: "bin/full-suite-check", root: root)
  abort "full-suite-check: #{dirty}" if dirty
end

# The test lane runs WHAT CI RUNS for the repo being certified — read from its own
# .github/workflows/ci.yml, verbatim (bin/lib/ci_test_command.rb). Hard-coding
# `bin/rails test` here is what let this "CI-independent" cert skip test/system
# entirely; resolving from ci.yml means the two can't drift apart again.
#
# The resolver judges CI by what it RUNS (does the step run tests?), never by a
# `bin/rails` mention — a setup step parked ahead of the real one would otherwise
# BE the "full-suite lane": it runs, exits 0, and stamps green having run ZERO
# tests. And it REFUSES, loudly, whatever it cannot SEE or cannot RUN: a suite
# split across steps, jobs or workflow files; a suite behind a wrapper it cannot
# invoke verbatim; a job with no readable steps; a readable `test` job with no test
# command in it at all; a command whose text does not say what it runs. A cert that
# cannot find CI's whole suite must say so, not quietly certify something narrower.
# An explicit FULL_SUITE_TEST_CMD is the operator saying "run THIS" — it overrides
# both the resolution and the refusal.
#
# This resolution MUST stay above the system-tier browser guard below — that guard
# consumes test_cmd (SystemTestBrowser.system_tier?(test_cmd)), so reordering it
# below the guard raises NameError.
test_cmd = ENV.fetch("FULL_SUITE_TEST_CMD") do
  ci_refusal = CiTestCommand.refusal(root)
  abort "full-suite-check: #{ci_refusal}" if ci_refusal

  CiTestCommand.resolve(root)
end
rubocop_cmd = ENV.fetch("FULL_SUITE_RUBOCOP_CMD", "bin/rubocop")
test_db_reset_cmd = ENV.fetch("FULL_SUITE_TEST_DB_RESET_CMD", "bin/rails db:test:purge db:test:prepare")
skip_test_db_reset = ENV.fetch("FULL_SUITE_SKIP_TEST_DB_RESET", "") == "1"

# --- system-tier browser guard -------------------------------------------------
# The test lane now carries the SYSTEM tier, and system tests drive a real headless
# Chrome. On a host with no Chrome, Selenium fails INSIDE the suite — a driver error
# that reads as a RED SUITE and sends the builder hunting a bug that isn't in their
# diff. Assert the browser UP FRONT (before any lane runs, before the g1_cert
# attempt opens) and fail in the ENV class instead. The release gate's twin of this
# guard lives in bin/release.rb; they share bin/lib/system_test_browser.rb.
#
# Note the calibration: this guard is ONLY about a missing browser. A failing ASSET
# build is NOT env — a broken stylesheet in your own diff can legitimately fail the
# suite, and must stay red.
if SystemTestBrowser.system_tier?(test_cmd) && !SystemTestBrowser.available?
  abort "full-suite-check: the test lane runs the SYSTEM tier (`#{test_cmd}`) but this host has NO Chrome — " \
        "headless Chrome is required to drive test/system, and without it Selenium fails inside the suite and " \
        "looks exactly like a red suite. This is an ENV problem on this host, NOT a regression in your diff — " \
        "nothing certified, nothing to hunt. #{SystemTestBrowser::INSTALL_HINT}"
end

# The live agent session id (Claude or Codex), or "" when none — the telemetry
# session gate. Blank means "no session to attribute to": skip the emit entirely,
# exactly as bin/release.rb's agent_activity does (`return unless session`).
def agent_session_id
  SessionIdentity.id
end

# Best-effort test-scope telemetry — the local-cert MIRROR of bin/release.rb's
# run_test_scope. Emits ONE kind=test_scope AgentAction per lane through the SAME
# `bin/agent-activity action` verb release.rb self-reports through, tagged
# event_slug=<scope key>, result_slug=pass|fail, duration_ms=<wall-clock>. So a
# local `bin/full-suite-check` cert becomes a gradeable unit in /alex/pipeline
# exactly like a release run.
#
# GUARDS mirror run_test_scope EXACTLY so telemetry NEVER breaks or slows a cert:
#   - session gate: no CLAUDE_CODE_SESSION_ID / CODEX_THREAD_ID → skip the
#     shell-out (agent_activity's own `return unless session`).
#   - span gate: the `action` verb SELF-CHECKS the open-activity marker and no-ops
#     when none is open — so a cert run outside a narrated activity emits nothing.
#   - best-effort: output is discarded, every error is swallowed, and the verb
#     always exits 0 — the LANE's own pass/fail is the only load-bearing result.
def emit_test_scope(scope, ok, duration_ms, cmd)
  return unless scope
  return if agent_session_id.empty?

  verdict = ok ? "pass" : "fail"
  summary = "test scope #{scope} #{ok ? 'COMPLETED' : 'FAILED'} · local · #{verdict} · " \
            "#{format('%.1fs', duration_ms / 1000.0)} · #{cmd}"
  system(AGENT_ACTIVITY, "action",
         "--summary", summary,
         "--kind", "test_scope",
         "--event-slug", scope,
         "--result-slug", verdict,
         "--duration-ms", duration_ms.to_s,
         "--key-method", cmd.to_s,
         out: File::NULL, err: File::NULL)
rescue StandardError
  nil # telemetry never breaks a cert — the lane result the caller returns is what matters
end

# Best-effort G1 gate-run markers (open / per-lane sop / close --failed), the
# "cert" checkpoint TaskEvent, and the checks_run read: shared with
# bin/fast-check (CertEmission), parameterized on this script's TASK_BIN/
# GATE_BIN. Skips when there's no task slug (--print / hook-install runs);
# fire-and-forget — a gate write never breaks a cert. The GREEN path leaves the
# g1_cert window: this cert OWNS it now — opens at start, one sop per lane, and
# closes it itself (--success on green / --failed on red). dor-check no longer
# touches g1_cert; its DoR verdict is the separate dor/dor_review gates.
def emit_cert_checkpoint(slug, status)
  CertEmission.emit_cert_checkpoint(TASK_BIN, slug, status)
end

def emit_gate(slug, *args)
  CertEmission.emit_gate(GATE_BIN, slug, *args)
end

# The lane runs in its OWN process group (CertProcess) so a signal aimed at this cert
# reaps the SUITE with it. This lane is the MOST exposed of the two certs: it is a
# multi-minute full suite (it will outrun any agent-harness timeout), and its
# test-db-reset lane leads with `db:test:purge` — a DROP DATABASE that PG refuses
# outright while an orphan holds a connection. See bin/lib/cert_process.rb.
def run_lane(label, cmd, root, env: {}, gate_slug: nil)
  warn "== #{label}: #{cmd} =="
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  ok = CertProcess.run(env, cmd, chdir: root, root: root, lane: label)
  duration_ms = ((Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) * 1000).round
  warn(ok ? "   #{label}: PASS" : "   #{label}: FAIL")
  emit_test_scope(LANE_SCOPES[label], ok, duration_ms, cmd)
  CertEmission.emit_gate_sop(GATE_BIN, gate_slug, label, cmd, ok, duration_ms) if gate_slug
  ok
end

# --- orphan guard ----------------------------------------------------------------
# Same policy as bin/fast-check: reap a previous cert's orphaned process group (it is
# what holds the test DB and makes `db:test:purge` raise PG::ObjectInUse), REFUSE a
# live concurrent cert (two suites on one worktree test DB corrupt each other and
# SIGSEGV Ruby), and NAME any other session holding the DB rather than walking into
# it blind. Runs before ANY lane. bin/lib/cert_orphan_guard.rb.
unless ENV["FULL_SUITE_SKIP_ORPHAN_GUARD"] == "1"
  guard_verdict, guard_payload = CertOrphanGuard.preflight(root: root)
  abort "full-suite-check: #{guard_payload}" if guard_verdict == :refuse

  Array(guard_payload).each { |notice| warn "full-suite-check: #{notice}" }
end

# Open the Local Certification testing phase (durable checkpoint on the task)
# and the G1 Cert gate attempt (durable GateRun; sops accrue per lane below).
# Skip on --print (a dry run must not write to the durable record).
gate_slug = options[:print] ? nil : slug
emit_cert_checkpoint(slug, "started") unless options[:print]
emit_gate(gate_slug, "open", "task", gate_slug.to_s, "g1_cert") if gate_slug

unless skip_test_db_reset
  reset_ok = run_lane("test-db-reset", test_db_reset_cmd, root, env: { "RAILS_ENV" => "test" }, gate_slug: gate_slug)
  unless reset_ok
    warn "full-suite-check: test database reset failed; not certifying a possibly polluted Rails suite."
    emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed") if gate_slug
    exit 1
  end
end

test_ok = run_lane("full-suite", test_cmd, root, gate_slug: gate_slug)
rubocop_ok = run_lane("rubocop", rubocop_cmd, root, gate_slug: gate_slug)

# Close the Local Certification testing phase (fires whether the cert passed or
# failed — the pass/fail lives in checks_run; this only bounds the phase window).
emit_cert_checkpoint(slug, "completed") unless options[:print]

fingerprint = FullSuiteGate.fingerprint(root)
if fingerprint.nil?
  warn "full-suite-check: could not fingerprint the code at #{root} (no git repo / identity?) — nothing certified."
  exit 1
end

lanes = { FullSuiteGate::TEST_LANE => test_ok, FullSuiteGate::RUBOCOP_LANE => rubocop_ok }
details = {
  FullSuiteGate::TEST_LANE => "#{test_cmd} green",
  FullSuiteGate::RUBOCOP_LANE => "#{rubocop_cmd} clean"
}

passed_lines = lanes.select { |_, ok| ok }.map do |lane, _|
  FullSuiteGate.evidence_line(lane, fingerprint, details[lane])
end

# Print the green evidence lines on stdout (parseable; the rest is on stderr).
passed_lines.each { |line| puts line }

unless lanes.values.all?
  failed = lanes.reject { |_, ok| ok }.keys.join(", ")
  warn "full-suite-check: lane(s) RED: #{failed}. Fix, then re-run — no evidence recorded for the red lane(s)."
  # A red lane is a G1 verdict: close the attempt failed (the re-run opens n+1).
  emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--failed") if gate_slug
  exit 1
end

# Both lanes green — cert self-closes the g1_cert attempt success (dor-check no
# longer owns G1's close; its DoR verdict is the separate dor/dor_review gates).
emit_gate(gate_slug, "close", "task", gate_slug.to_s, "g1_cert", "--success") if gate_slug

if options[:print] || slug.nil?
  warn "full-suite-check: both lanes green at #{fingerprint[0, 12]}." \
       "#{slug.nil? ? " (no task slug — evidence printed, not recorded)" : " (--print: not recorded)"}"
  exit 0
end

# Read the current checks_run — the BASELINE the read-back below verifies against.
# If it can't be read, ABORT rather than certify blind: an unverifiable write is
# exactly the failure this gate exists to catch.
existing = CertEmission.fetch_checks(TASK_BIN, slug)
if existing.nil?
  warn "full-suite-check: ran green but couldn't read #{slug.inspect}'s checks_run (bin/task show), so the " \
       "write cannot be verified. Not writing. Re-run, or record by hand: bin/task update #{slug} " \
       "#{passed_lines.map { |l| "--checks #{Shellwords.escape(l)}" }.join(' ')}"
  exit 1
end

# Record the green evidence as a PURE-EVIDENCE write: ONLY the lines these lanes
# own. The cert must NOT resend its snapshot of the author's lines — that is an
# author write, and it replaces the author namespace with content read BEFORE the
# lanes ran, clobbering any tier line the board gained since (a multi-minute suite
# leaves a wide window). Sending just the evidence lets the write funnel
# (bin/task's build_devops + Task#preserve_cert_evidence, lib/cert_evidence.rb)
# merge against the board's CURRENT state at write time: the author namespace is
# carried forward, and these lanes' prior lines are superseded.
record_args = passed_lines.flat_map { |line| ["--checks", line] }
unless system(TASK_BIN, "update", slug, *record_args)
  warn "full-suite-check: ran green but FAILED to record evidence on #{slug.inspect} (bin/task update). Re-run."
  exit 1
end

# "Preserved" is VERIFIED, never declared (regression 2026-07-20, shared with
# bin/fast-check): read the board back and check every pre-existing line
# survived the write. The fresh evidence lines' own write is covered by
# bin/task update's exit status above.
# Everything the write does NOT supersede — every prior line except the lanes
# this cert just stamped (their fresh lines replace the old by design).
kept = existing.reject { |prior| prior.match?(FullSuiteGate.evidence_re(FullSuiteGate::LANES)) }
summary = "full-suite-check: both lanes green at #{fingerprint[0, 12]} — evidence recorded on #{slug}"
if kept.empty?
  warn "#{summary} (no pre-existing checks lines to preserve)."
  exit 0
end

missing = CertEmission.missing_after_write(TASK_BIN, slug, kept)
if missing.nil?
  warn "#{summary}, but the read-back failed — UNVERIFIED that the #{kept.size} pre-existing checks line(s) " \
       "survived. Verify: bin/task show #{slug} -v."
elsif missing.any?
  warn "full-suite-check: evidence recorded on #{slug}, but the read-back is MISSING #{missing.size} " \
       "pre-existing checks line(s):"
  missing.each { |lost| warn "  #{lost}" }
  # The remedy re-records the UNION — survivors AND lost. `--checks` replaces
  # the author namespace, so a lost-lines-only command would itself drop the
  # lines that survived (round-2 review catch, 2026-07-20). SHELL-quoted, not
  # String#inspect: the command is meant to be PASTED (round-3 catch).
  warn "full-suite-check: re-record the full pre-existing set (survivors AND lost — resending only the lost " \
       "lines would drop the survivors): bin/task update #{slug} " \
       "#{kept.map { |line_kept| "--checks #{Shellwords.escape(line_kept)}" }.join(' ')}"
  exit 1
else
  warn "#{summary} (read-back confirms all #{kept.size} pre-existing checks line(s) kept)."
end
exit 0
