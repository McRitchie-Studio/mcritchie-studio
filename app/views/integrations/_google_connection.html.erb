<%# Signed in only (IntegrationsController#index sets the Google connections for a signed-in user and nobody else): one ability's connection (calendar, gmail or drive), on that card's Sign in row. An admin's is the household's, through /admin/google; with own true it is the viewer's own, through /integrations/google. Connect when no readable connection grants it and the server can take one (Gmail's opens the admin-trust modal first, modals/_gmail_admin); otherwise the account, Disconnect and who reads it (integrations/_google_who_reads). Both come back to this page. No token renders. %>
<% name = GoogleConnection::ABILITY_NAMES.fetch(ability) %>
<% own = local_assigns.fetch(:own, false) %>
<div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1" data-test="google-connection" data-ability="<%= ability %>" data-state="<%= connection ? 'connected' : 'none' %>">
  <% if connection %>
    <span class="min-w-0 text-body [overflow-wrap:anywhere]" data-test="google-account">Connected as <span class="font-medium text-heading"><%= connection.email %></span></span>
    <%= button_to "Disconnect", (own ? integrations_google_disconnect_path(ability:, return_to: integrations_path) : admin_google_disconnect_path(ability:, return_to: integrations_path)), method: :delete,
                  class: "btn btn-neutral btn-sm",
                  form: { class: "inline-flex", data: { test: "google-disconnect", turbo_confirm: "Disconnect #{name} for #{connection.email}?" } } %>
    <span class="basis-full"><%= render "integrations/google_who_reads", connection: %></span>
  <% elsif connectable %>
    <% href = own ? integrations_google_connect_path(ability:, return_to: integrations_path) : admin_google_connect_path(ability:, return_to: integrations_path) %>
    <% if ability.to_sym == :gmail %>
      <%# Gmail first opens the admin-trust modal (modals/_gmail_admin); its Continue follows the same href. %>
      <button type="button" class="btn btn-primary btn-sm" data-test="google-connect" data-opens="gmail-admin"
              data-href="<%= href %>" data-client-id="<%= GoogleConnect::OAuthClient.client_id %>" data-aria-label="<%= GmailAdminModalHelper::TITLE %>"
              @click="$store.modals.open('gmail-admin', { href: $el.dataset.href, clientId: $el.dataset.clientId, ariaLabel: $el.dataset.ariaLabel })">Connect <%= name %></button>
    <% else %>
      <%= link_to "Connect #{name}", href, class: "btn btn-primary btn-sm", data: { test: "google-connect", turbo: false } %>
    <% end %>
  <% end %>
</div>
