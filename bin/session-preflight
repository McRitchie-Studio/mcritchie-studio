#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/session-preflight — deterministic start-of-session task check.
#
# This is the front gate that complements bin/dor-check:
#   * session-preflight runs BEFORE work starts and asks "what can bite me?"
#   * dor-check runs BEFORE handoff and asks "is this ready to review?"
#
# It stays read-only. Network-backed checks degrade to warnings when unavailable,
# while local deterministic drift checks can fail the preflight.
#
# Usage:
#   bin/session-preflight <task-slug>
#   bin/session-preflight <task-slug> --json
#   bin/session-preflight --file task.json --no-gh --no-install-docs --no-fetch

require "json"
require "net/http"
require "open3"
require "optparse"
require "pathname"
require "time"
require "uri"
require "yaml"
require_relative "lib/ci_status"
require_relative "lib/code_diff"
require_relative "lib/migration_collision"
require_relative "lib/task_board"

DEFAULT_ROOT = File.expand_path("..", __dir__)
# HUB HELPERS RESOLVE FROM THE SCRIPT, NEVER FROM --root (task
# preflight-works-from-satellites). bin/task and config/feature_shapes.yml ship
# in THIS script's repo (the hub); --root names the tree being INSPECTED, which
# may be a satellite/gem worktree that carries neither — resolving them under
# --root ENOENT-died `bin/task show` on every satellite desk (turf-monster,
# twice on 2026-07-28; a --file task-JSON dump was the workaround). Branch
# drift, dirty tree, installed-docs drift, and the stale scan still read from
# --root. Mirrors bin/dor-check (DOR_CHECK_TASK_BIN + hub-anchored
# CONFIG_PATH): the shape taxonomy is studio-owned, so preflight previews the
# SAME config the merge gate enforces. The env overrides are the test seam,
# exactly as in dor-check.
TASK_BIN = ENV.fetch("SESSION_PREFLIGHT_TASK_BIN", File.expand_path("task", __dir__))
SHAPES_PATH = ENV.fetch("SESSION_PREFLIGHT_SHAPES_PATH", File.join(DEFAULT_ROOT, "config", "feature_shapes.yml"))
TASK_API_BASE = ENV.fetch("TASK_API_BASE", "https://mcritchie.studio")
TASK_CONVERSATION_TYPES = %w[comment qa_feedback handoff clarification].freeze
CHECK_STATES = {
  "SUCCESS" => "pass",
  "FAILURE" => "fail",
  "CANCELLED" => "cancelled",
  "TIMED_OUT" => "timed_out",
  "ACTION_REQUIRED" => "action_required",
  "SKIPPED" => "skipped"
}.freeze
BAD_MERGE_STATES = %w[DIRTY BEHIND BLOCKED].freeze
# Kinds that MAY skip the shape/required-metadata gate — and the classifier that
# decides whether this diff has EARNED that skip. Both come from bin/lib/code_diff.rb,
# the single source of truth dor-check gates on. They used to be COPIES of
# dor-check's constants ("keep the two gates in lock-step") and they drifted into
# the same blind spot: an allowlist of code prefixes that never saw
# .github/workflows/*, Gemfile, or test/. A shared require can't drift.
EXEMPT_KINDS = CodeDiff::EXEMPT_KINDS
STALE_PATTERNS = [
  ["legacy queued stage query", /stage=queued/],
  ["legacy task transition endpoint", %r{tasks/:slug/(?:start|complete|fail_task)}],
  ["legacy grouped transition endpoint", /\{queue,start,complete,fail_task\}/],
  ["legacy queued task wording", /queued tasks/i],
  ["legacy completion wording", /mark task complete/i],
  ["stale devops-cycle doc path", %r{docs/agents/system/devops-cycle\.md}],
  ["stale release prepare no-op wording", /silently no-ops/i],
  ["pre-config release policy wording", /Until it is backed by/i],
  ["legacy review stage name", /\b(?:pr_review|qa_review|prod_ready)\b/]
].freeze

def warn!(message)
  $stderr.puts(message)
end

def die!(message)
  warn!("error: #{message}")
  exit 1
end

def capture(*cmd, chdir: nil, env: {})
  kwargs = {}
  kwargs[:chdir] = chdir if chdir
  out, err, status = Open3.capture3(env, *cmd, **kwargs)
  [status.success?, out, err]
rescue SystemCallError => e
  [false, "", e.message]
end

def command_available?(name)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
    path = File.join(dir, name)
    File.file?(path) && File.executable?(path)
  end
end

def compact_lines(value, max: 5)
  value.to_s.lines.map(&:strip).reject(&:empty?).first(max)
end

def truncate(value, length = 420)
  text = value.to_s.gsub(/\s+/, " ").strip
  text.length > length ? "#{text[0, length - 1]}..." : text
end

def present?(value)
  case value
  when nil then false
  when Array then value.any? { |item| item.to_s.strip != "" }
  else value.to_s.strip != ""
  end
end

def normalize_task(raw)
  raw.fetch("data", raw)
end

# Degrades to "" when the secret is missing (the preflight renders a warning
# instead of dying) — hence the .to_s over TaskBoard's nil. The dotenv last
# resort is the HUB's .env (ENV and 1Password are consulted first): the board
# secret lives with the script's repo, not with the inspected --root.
def agent_secret
  TaskBoard.agent_secret(File.join(DEFAULT_ROOT, ".env")).to_s
end

def api_request(base_url, method, path, token: nil, body: nil)
  response = TaskBoard.request(method, path, base_url: base_url, token: token, body: body)
  parsed = response.body.to_s.empty? ? {} : JSON.parse(response.body)
  unless response.code.to_i.between?(200, 299)
    raise "HTTP #{response.code}: #{parsed["error"] || response.body}"
  end
  parsed
end

def api_token(base_url, secret)
  api_request(base_url, :post, "/api/v1/auth", body: { secret: secret }).fetch("token")
end

def fetch_latest_task_activity(slug)
  secret = agent_secret
  return [nil, "AGENT_API_SECRET not found for activities fallback"] if secret.empty?

  token = api_token(TASK_API_BASE, secret)
  query = URI.encode_www_form(task_slug: slug, per_page: 20)
  response = api_request(TASK_API_BASE, :get, "/api/v1/activities?#{query}", token: token)
  activity = Array(response["data"]).find do |item|
    TASK_CONVERSATION_TYPES.include?(item["activity_type"].to_s)
  end
  [activity, nil]
rescue StandardError => e
  [nil, e.message]
end

def load_task(slug, options)
  if options[:file]
    normalize_task(JSON.parse(File.read(options[:file])))
  else
    die!("usage: bin/session-preflight <task-slug>") if slug.to_s.strip.empty?

    # TASK_BIN, not File.join(options[:root], "bin", "task"): the board CLI is a
    # hub tool (cwd-independent — it roots itself at its own __dir__), and a
    # satellite --root has no copy of it.
    ok, out, err = capture(TASK_BIN, "show", slug, "--json", chdir: DEFAULT_ROOT)
    die!("bin/task show failed: #{compact_lines([err, out].join("\n")).join("; ")}") unless ok

    normalize_task(JSON.parse(out))
  end
rescue JSON::ParserError => e
  die!("could not parse task JSON: #{e.message}")
rescue Errno::ENOENT
  die!("task file not found: #{options[:file]}")
end

def task_devops(task)
  task.dig("metadata", "devops") || task["devops"] || {}
end

def load_shapes
  return [{}, "missing #{SHAPES_PATH}"] unless File.exist?(SHAPES_PATH)

  [YAML.load_file(SHAPES_PATH), nil]
rescue Psych::Exception => e
  [{}, "could not parse #{SHAPES_PATH}: #{e.message}"]
end

# The branch ladder is accepted → release → main: feature branches cut from and
# PR into `origin/accepted`, so drift must be measured against the same rung the
# desk was cut from. Mirrors base_ref_for in bin/agent-worktree — keep the two
# resolutions in sync. (Divergence is deliberate in ONE spot: base_ref_for
# assumes origin/main as a last resort; default_base_ref returns nil so the
# report can name the missing refs instead of failing on a git error.)
LADDER_BRANCHES = %w[accepted release main].freeze

# Fetch every ladder rung the remote has. A missing rung (pre-cutover repo, no
# `bin/release init` yet) is expected, not a failure — warn only when NO rung
# could be fetched, which points at a real network/remote problem.
def git_fetch_ladder(root)
  results = LADDER_BRANCHES.map do |branch|
    ok, _out, err = capture("git", "-C", root, "fetch", "origin", branch, "--quiet")
    [branch, ok, err]
  end
  return [true, nil] if results.any? { |_branch, ok, _err| ok }

  [false, results.map { |branch, _ok, err| "#{branch}: #{compact_lines(err).join("; ")}" }.join(" | ")]
end

def git_ref_exists?(root, ref)
  ok, = capture("git", "-C", root, "rev-parse", "--verify", ref)
  ok
end

def default_base_ref(root)
  LADDER_BRANCHES.each do |branch|
    ref = "origin/#{branch}"
    return ref if git_ref_exists?(root, ref)
  end
  nil
end

def current_branch(root)
  ok, out, = capture("git", "-C", root, "rev-parse", "--abbrev-ref", "HEAD")
  ok ? out.strip : nil
end

def branch_drift(root, base)
  return { "base" => nil, "warning" => "no origin/accepted, origin/release, or origin/main ref found" } unless base

  ok, out, err = capture("git", "-C", root, "rev-list", "--left-right", "--count", "#{base}...HEAD")
  return { "base" => base, "warning" => compact_lines(err).join("; ") } unless ok

  behind, ahead = out.split(/\s+/, 2).map { |value| value.to_i }
  {
    "base" => base,
    "branch" => current_branch(root),
    "behind" => behind,
    "ahead" => ahead
  }
end

def working_tree_dirty?(root)
  ok, out, = capture("git", "-C", root, "status", "--porcelain")
  ok && !out.strip.empty?
end

def changed_files(root, base)
  files = []
  [%w[diff --cached --name-only], %w[diff --name-only], %w[ls-files --others --exclude-standard]].each do |args|
    ok, out, = capture("git", "-C", root, *args)
    files.concat(out.split("\n")) if ok
  end
  if base
    ok, out, = capture("git", "-C", root, "diff", "--name-only", "#{base}...HEAD")
    files.concat(out.split("\n")) if ok
  end
  files.map(&:strip).reject(&:empty?).uniq
end

def pr_ref_from(devops, branch)
  url = devops["pr_url"].to_s
  return Regexp.last_match(1) if url.match(%r{/pull/(\d+)\b})

  branch_value = devops["branch"].to_s.strip
  return branch_value unless branch_value.empty?

  branch.to_s.strip.empty? ? nil : branch
end

def summarize_rollup(items)
  Array(items).map do |item|
    name = item["name"].to_s
    conclusion = item["conclusion"].to_s
    status = item["status"].to_s
    state = conclusion.empty? ? status.downcase : CHECK_STATES.fetch(conclusion, conclusion.downcase)
    { "name" => name, "state" => state, "url" => item["detailsUrl"].to_s }
  end
end

# Will this PR NEVER get CI? Zero check-runs AND a REFUTED merge, delegating the
# classification to CiStatus.mergeability so preflight and the gates cannot drift into
# two taxonomies for one PR (review round 2: this predicate used to answer DIRTY
# differently from CiStatus.view_verdict, so the same PR got "rebase onto accepted and
# force-push" here and "merge release in and resolve the conflicts" there — and the
# first is wrong advice for a real conflict, since it never mentions resolving).
#
# DIRTY belongs to the CONFLICT report, not this one: view_verdict calls it
# :conflicted and BAD_MERGE_STATES already surfaces it below, so it returns false here
# and lets the conflict speak for itself with the correct cure.
#
# An :unknown mergeability NEVER lands here either — GitHub answers UNKNOWN while it
# computes, which is exactly the fresh-push window preflight runs in. Only an
# affirmative negative counts. See the three-valued section in bin/lib/ci_status.rb.
def ci_less?(gh_pr, checks)
  return false unless Array(checks).empty?
  return false if gh_pr["mergeStateStatus"].to_s.upcase == "DIRTY"

  CiStatus.mergeability(JSON.generate(gh_pr)) == :refuted
end

# GH AUTH FRESHNESS — probe the credential `gh` will ACTUALLY use, at desk time.
#
# WHY AT PREFLIGHT. App installation tokens live ~1h and NOTHING refreshes gh's
# ambient credential on its own (docs/agents/modules/source-control.md § Three
# stores, and they rank). So a desk cut an hour ago ships fine and a desk cut now
# dies at `bin/ship`, `gh pr view`, or the first CI read — mid-wave, in the session
# least able to absorb it. One probe here moves that discovery to the cheapest
# moment and hands over the exact fix, which is SELF-SERVICE and never an
# escalation to Mr. McRitchie.
#
# IT ALSO STOPS A MISDIAGNOSIS. This runs BEFORE the PR block deliberately: an
# expired token makes `gh pr view` fail, which preflight otherwise reports as
# "PR: not found" — sending a builder to re-open a PR that already exists.
#
# THE PROBE IS `gh api rate_limit`, NOT `gh api user`. An App installation token
# CANNOT call /user at all — Apps are forbidden from it by design — so a perfectly
# healthy token answers 403 there. Reading that as a fault sends the session
# chasing a grant that cannot exist.
def gh_auth_report(root)
  return { "status" => "skipped", "message" => "gh CLI is unavailable" } unless command_available?("gh")

  item = ENV["GH_APP_ITEM"].to_s.strip
  lane = item.empty? ? "agent" : item.sub(/\Agithub\.mcritchie-/, "")
  ok, _out, err = capture("gh", "api", "rate_limit", chdir: root)
  return { "status" => "ok", "lane" => lane } if ok

  { "status" => "stale", "lane" => lane, "message" => compact_lines(err).first.to_s }
end

GH_AUTH_REMEDY = "this is YOURS to fix, NOT an escalation: run " \
                 "eval \"$(bin/gh-auth-refresh --export)\" and READ ITS STDERR " \
                 "(eval hides the exit code), then re-run this preflight. " \
                 "Do NOT use `gh auth login`: gh refuses to store a credential while GH_TOKEN is " \
                 "set, and GH_TOKEN outranks the keyring it would write to. " \
                 "See docs/agents/modules/source-control.md."

def gh_pr_view(ref, root)
  fields = "number,title,url,headRefName,baseRefName,mergeable,mergeStateStatus,statusCheckRollup"
  ok, out, err = capture("gh", "pr", "view", ref.to_s, "--json", fields, chdir: root)
  return [nil, compact_lines(err).join("; ")] unless ok

  [JSON.parse(out), nil]
rescue JSON::ParserError => e
  [nil, e.message]
end

def gh_pr_list(root, state, limit)
  fields = "number,title,url,headRefName,updatedAt"
  ok, out, err = capture("gh", "pr", "list", "--state", state, "--limit", limit.to_s, "--json", fields, chdir: root)
  return [[], compact_lines(err).join("; ")] unless ok

  [JSON.parse(out), nil]
rescue JSON::ParserError => e
  [[], e.message]
end

def gh_pr_files(root, number)
  ok, out, err = capture("gh", "pr", "view", number.to_s, "--json", "files", chdir: root)
  return [[], compact_lines(err).join("; ")] unless ok

  files = JSON.parse(out).fetch("files", []).map { |file| file["path"].to_s }.reject(&:empty?)
  [files, nil]
rescue JSON::ParserError => e
  [[], e.message]
end

def overlap_report(root, current_files, current_pr_number)
  return [{ "items" => [], "warnings" => ["no branch files to compare"] }, [], []] if current_files.empty?

  warnings = []
  candidates = []
  [%w[open 20], %w[merged 10]].each do |state, limit|
    prs, warning = gh_pr_list(root, state, limit)
    warnings << "#{state} PR list: #{warning}" if warning
    prs.each { |pr| candidates << pr.merge("state" => state) }
  end

  items = []
  fetched = []
  candidates.each do |pr|
    next if current_pr_number && pr["number"].to_i == current_pr_number.to_i

    files, warning = gh_pr_files(root, pr["number"])
    warnings << "PR ##{pr["number"]} files: #{warning}" if warning
    fetched << pr.merge("files" => files)
    overlap = current_files & files
    next if overlap.empty?

    items << {
      "number" => pr["number"],
      "title" => pr["title"],
      "url" => pr["url"],
      "state" => pr["state"],
      "files" => overlap.sort
    }
  end
  # The third return is the RAW candidate set with every file, not just the shared
  # ones — the duplicate-migration check needs each PR's whole migration list, and
  # re-fetching it would double this report's network cost for data already in hand.
  [{ "items" => items, "warnings" => warnings }, warnings, fetched]
end

# Ladder branches whose PRs carry every merged file by construction (the release
# train's `accepted → release` batch promote). Excluded from the migration check so a
# release window does not make it collide with everything. Mirrors bin/ship.
RELEASE_BATCH_HEADS = %w[accepted release].freeze

def first_line(path)
  File.open(path, &:gets)
rescue SystemCallError
  nil
end

# DUPLICATE MIGRATION INSTALL — the gap that cost three incidents on 2026-08-13/14.
# The same-file overlap above keys on `current_files & files`, a FILENAME
# intersection, and two installs of one engine migration have different filenames by
# construction. See bin/lib/migration_collision.rb for the mechanism and the keys.
#
# Two legs: the migrations already on the base ref (local, works with no gh), and
# every OTHER OPEN PR's migration paths (from the overlap fetch above, so it costs no
# extra call). Merged PRs are deliberately NOT a third leg — their files are already
# on the base ref, so the local leg reports them once instead of twice; they are used
# only to ATTRIBUTE a base-ref copy to the PR that put it there.
def migration_collision_report(root, base, changed, candidates)
  ours = MigrationCollision.local_installs(changed) { |path| first_line(File.join(root, path)) }
  return { "items" => [], "installs" => 0 } if ours.empty?

  sources = []
  if base
    sources << { "label" => "already on #{base}", "kind" => "branch",
                 "installs" => ref_installs(root, base) }
  end
  Array(candidates).each do |pr|
    next unless pr["state"].to_s == "open"
    next if RELEASE_BATCH_HEADS.include?(pr["headRefName"].to_s)

    sources << { "label" => pr["title"].to_s, "kind" => "pr", "number" => pr["number"],
                 "url" => pr["url"].to_s,
                 "installs" => MigrationCollision.installs(Array(pr["files"])) }
  end
  # A branch can collide with ITSELF — two installs in one diff, which is what a
  # mis-resolved rebase leaves behind.
  sources << { "label" => "this branch", "kind" => "self", "installs" => ours }

  items = MigrationCollision.report(ours, sources)
  { "items" => attribute_merged(items, candidates), "installs" => ours.size }
end

def ref_installs(root, base)
  MigrationCollision.ref_installs(base) do |args|
    _ok, out, = capture("git", "-C", root, *args)
    out
  end
end

# Name the merged PR that put the other copy on the base ref, when one of the merged
# candidates carries that exact path. "It is already on accepted" is true but leaves
# the reader digging; "PR #313 put it there" is the sentence they can act on.
def attribute_merged(items, candidates)
  merged = Array(candidates).select { |pr| pr["state"].to_s == "merged" }
  return items if merged.empty?

  items.map do |item|
    next item unless item["kind"] == "branch"

    owner = merged.find { |pr| Array(pr["files"]).include?(item["theirs"]["path"]) }
    next item unless owner

    item.merge("label" => "#{item["label"]} via PR ##{owner["number"]} #{owner["url"]}")
  end
end

def install_docs_check(root)
  script = File.join(root, "bin", "install-agent-docs")
  return { "status" => "skipped", "message" => "missing #{script}" } unless File.executable?(script)

  ok, out, err = capture(script, "check", chdir: root)
  {
    "status" => ok ? "pass" : "fail",
    "message" => compact_lines(ok ? out : [err, out].join("\n"), max: 8).join("; ")
  }
end

def active_stale_scan_files(root, changed)
  globs = [
    "docs/agents/index.md",
    "docs/agents/claude.md",
    "docs/agents/modules/**/*.md",
    "docs/agents/system/**/*.md",
    "docs/agents/skills/**/*.md",
    "docs/topics/**/*.md",
    "config/feature_shapes.yml"
  ]
  files = globs.flat_map { |glob| Dir.glob(File.join(root, glob)) }
  changed.each do |rel|
    next unless rel.start_with?("docs/", "config/")

    files << File.join(root, rel)
  end
  files.select { |path| File.file?(path) }
       .reject { |path| path.include?("/docs/agents/audits/") || path.include?("/docs/agents/maintenance/") }
       .reject { |path| File.basename(path).match?(/audit-\d{4}-\d{2}-\d{2}/) }
       .uniq
       .sort
end

def stale_scan(root, files)
  hits = []
  files.each do |path|
    rel = path.delete_prefix("#{root}/")
    File.readlines(path).each_with_index do |line, index|
      STALE_PATTERNS.each do |label, pattern|
        next unless line.match?(pattern)

        hits << {
          "file" => rel,
          "line" => index + 1,
          "label" => label,
          "text" => line.strip
        }
      end
    end
  rescue ArgumentError, Encoding::InvalidByteSequenceError, Encoding::UndefinedConversionError
    next
  end
  hits
end

def activity_with_description(activity)
  return nil unless activity.is_a?(Hash)

  activity["description"].to_s.strip.empty? ? nil : activity
end

def latest_feedback(task, fallback_activity: nil)
  activity = activity_with_description(task["latest_activity"]) || activity_with_description(fallback_activity) || {}
  description = activity["description"].to_s.strip
  return nil if description.empty?

  {
    "activity_type" => activity["activity_type"].to_s,
    "created_at" => activity["created_at"].to_s,
    "description" => truncate(description)
  }
end

def shape_report(task, warnings)
  config, warning = load_shapes
  warnings << warning if warning
  devops = task_devops(task)
  shape = devops["shape"].to_s
  shapes = config.fetch("shapes", {})
  defaults = config.fetch("defaults", {})
  shape_def = shapes.fetch(shape, {})
  required = shape_def.fetch("required_metadata", defaults.fetch("required_metadata", []))
  tiers = shape_def.fetch("dor_tiers", [])
  {
    "shape" => shape.empty? ? nil : shape,
    "description" => shape_def["description"],
    "required_metadata" => required,
    "missing_metadata" => required.reject { |field| present?(devops[field]) },
    "dor_tiers" => tiers,
    # A shape's contract is not always a tier list. `test-only` carries none —
    # a diff with no behavior has nothing for a tier to be evidence of — and owes
    # a control instead, plus a claimability rule checked against the diff. Report
    # BOTH, or the preflight tells a test-only builder "Required tiers: none" and
    # they read the strictest shape in the file as the free one.
    "required_evidence" => Array(shape_def["required_evidence"]),
    "claimable_when" => shape_def["claimable_when"],
    "checks_run" => Array(devops["checks_run"])
  }
end

def print_human(report)
  task = report.fetch("task")
  puts "Session preflight for #{task["title"] || task["slug"]} (#{task["slug"]})"
  puts "Task: #{task["url"]}" if task["url"]
  puts

  feedback = report["latest_feedback"]
  if feedback
    puts "Latest feedback: #{feedback["activity_type"]} #{feedback["created_at"]}".strip
    puts "  #{feedback["description"]}"
  else
    puts "Latest feedback: none"
  end

  drift = report.fetch("branch")
  puts "Branch: #{drift["branch"] || "unknown"} vs #{drift["base"] || "unknown"}"
  if drift["warning"]
    puts "  WARN #{drift["warning"]}"
  else
    puts "  ahead #{drift["ahead"]}, behind #{drift["behind"]}"
  end
  puts "  WARN working tree has uncommitted changes" if drift["dirty"]

gh_auth = report["gh_auth"] || { "status" => "skipped", "message" => "not probed" }
case gh_auth["status"]
when "ok"    then puts "gh auth: ok (#{gh_auth["lane"]} lane)"
when "stale" then puts "gh auth: STALE (#{gh_auth["lane"]} lane) -> eval \"$(bin/gh-auth-refresh --export)\""
else              puts "gh auth: skipped (#{gh_auth["message"]})"
end

  pr = report["pr"]
  if pr["status"] == "skipped"
    puts "PR: skipped (#{pr["message"]})"
  elsif pr["status"] == "missing"
    puts "PR: not found (#{pr["message"]})"
  else
    puts "PR: ##{pr["number"]} #{pr["merge_state"]} #{pr["url"]}"
    pr.fetch("checks", []).each { |check| puts "  #{check["state"]}: #{check["name"]}" }
  end

  overlap = report["overlap"]
  if overlap["items"].empty?
    puts "File overlap: none"
  else
    puts "File overlap:"
    overlap["items"].each do |item|
      puts "  PR ##{item["number"]} #{item["state"]}: #{item["title"]}"
      item["files"].each { |file| puts "    - #{file}" }
    end
  end

  migrations = report["migration_collisions"] || { "items" => [], "installs" => 0 }
  if migrations["items"].empty?
    puts "Migration collisions: none (#{migrations["installs"].to_i} migration(s) added by this branch)"
  else
    MigrationCollision.lines(migrations["items"]).each { |line| puts line }
  end

  docs = report["installed_docs"]
  puts "Installed docs: #{docs["status"]}#{docs["message"].to_s.empty? ? "" : " - #{docs["message"]}"}"

  stale = report["stale_terms"]
  if stale.empty?
    puts "Stale terminology: none"
  else
    puts "Stale terminology:"
    stale.each { |hit| puts "  #{hit["file"]}:#{hit["line"]} #{hit["label"]} - #{hit["text"]}" }
  end

  shape = report["shape"]
  if shape["exempt"]
    puts "Shape gate: n/a — no behavioral files in the diff yet (kind: #{shape["kind"]}); skipped, " \
         "matching bin/dor-check. Ship code — including .github/, Gemfile, config, or tests — and the " \
         "shape/tier gate applies like any feature."
  else
    tiers = shape["dor_tiers"]
    evidence = Array(shape["required_evidence"])
    # "none" would be a lie for a shape that owes a control, so say what it owes.
    owed = tiers.empty? && evidence.any? ? "no tiers; evidence: #{evidence.join(', ')}" : tiers.join(", ")
    puts "Required tiers: #{shape["shape"] || "none"} => #{owed}"
    if shape["claimable_when"] == "test_only_diff"
      puts "  claimable ONLY on a diff dor-check OBSERVES to be 100% test code (test/, tests/, e2e/) — " \
           "one non-test file and the claim is refused; it still owes the full-suite cert, and the " \
           "[control] line must name a file from the diff (does the changed test still bite?)"
    end
    unless shape["required_metadata"].empty?
      puts "Required metadata: #{shape["required_metadata"].join(", ")}"
    end
    unless shape["missing_metadata"].empty?
      puts "Missing metadata: #{shape["missing_metadata"].join(", ")}"
    end
  end

  unless report["warnings"].empty?
    puts
    puts "Warnings:"
    report["warnings"].each { |warning| puts "  - #{warning}" }
  end

  puts
  if report["ok"]
    puts "OK session preflight passed"
  else
    puts "FAIL session preflight found blockers"
    report["errors"].each { |error| puts "  - #{error}" }
  end
end

options = {
  root: DEFAULT_ROOT,
  file: nil,
  json: false,
  gh: true,
  install_docs: true,
  fetch: true,
  stale_paths: []
}

OptionParser.new do |opts|
  opts.banner = "Usage: bin/session-preflight <task-slug> [options]"
  opts.on("--file PATH", "Read task JSON from a local file") { |path| options[:file] = path }
  opts.on("--root PATH", "Repo root to inspect (default: this repo)") { |path| options[:root] = File.expand_path(path) }
  opts.on("--stale-path PATH", "Additional stale-scan path, repeatable") { |path| options[:stale_paths] << path }
  opts.on("--no-gh", "Skip GitHub CLI checks") { options[:gh] = false }
  opts.on("--no-install-docs", "Skip bin/install-agent-docs check") { options[:install_docs] = false }
  opts.on("--no-fetch", "Skip git fetch of origin accepted/release/main") { options[:fetch] = false }
  opts.on("--json", "Emit machine-readable JSON") { options[:json] = true }
  opts.on("-h", "--help", "Show this help") do
    puts opts
    exit 0
  end
end.parse!

slug = ARGV.shift
task = load_task(slug, options)
devops = task_devops(task)
errors = []
warnings = []

# A block is a `building` attribute now (blocked_at set while building), not a
# stage — re-derive the "currently blocked" warning from the marker column.
if task["blocked_at"].to_s.strip != "" && task["stage"].to_s == "building"
  errors << "task is blocked; read latest feedback before editing"
end

if options[:fetch]
  ok, message = git_fetch_ladder(options[:root])
  warnings << "git fetch origin accepted/release/main all failed: #{message}" unless ok
end

base = default_base_ref(options[:root])
branch = branch_drift(options[:root], base)
branch["dirty"] = working_tree_dirty?(options[:root])

# SELF-DEFENSE (begin-preflight-wrong-root): a preflight is only meaningful
# against the TASK'S OWN checkout. Assert the positive property — the inspected
# root carries the task's branch — rather than trusting the caller's --root. The
# classic failure is a report that silently describes the PRIMARY (its drift, its
# PRs, its overlap) when the task lives on a worktree; every number below is then
# about the wrong tree. On a mismatch REFUSE and say so, and SUPPRESS the drift
# blocker (its count is meaningless for a tree that isn't this task's). Skipped
# only when the fact is unknowable: no task branch to expect, or the root has no
# resolvable branch (a non-git root → blank). A DETACHED HEAD is NOT skipped —
# `git rev-parse --abbrev-ref HEAD` returns the literal "HEAD", which is never the
# task's branch, so a detached root is refused like any other wrong checkout.
expected_branch = devops["branch"].to_s.strip
expected_branch = "feat/#{task["slug"]}" if expected_branch.empty? && present?(task["slug"])
inspected_branch = current_branch(options[:root]).to_s.strip
branch["wrong_checkout"] = !expected_branch.empty? && !inspected_branch.empty? && inspected_branch != expected_branch
if branch["wrong_checkout"]
  errors << "WRONG checkout: inspecting #{options[:root]} on branch #{inspected_branch.inspect}, but task " \
            "#{task["slug"]} lives on #{expected_branch.inspect} — this is NOT the task's worktree, so the drift/" \
            "PR/overlap here describe the wrong tree. Run bin/session-preflight from the task's worktree, or pass " \
            "--root <worktree>."
end
errors << "branch is #{branch["behind"]} commit(s) behind #{branch["base"]}; rebase before work or handoff" if !branch["wrong_checkout"] && branch["behind"].to_i.positive?
warnings << "working tree has uncommitted changes" if branch["dirty"]
changed = changed_files(options[:root], base)

fallback_activity = nil
if !options[:file] && activity_with_description(task["latest_activity"]).nil?
  activity_slug = task["slug"].to_s.empty? ? slug : task["slug"]
  fallback_activity, warning = fetch_latest_task_activity(activity_slug)
  warnings << "latest task activity fallback failed: #{warning}" if warning
end

gh_auth = if options[:gh]
  gh_auth_report(options[:root])
else
  { "status" => "skipped", "message" => "GitHub checks disabled" }
end
if gh_auth["status"] == "stale"
  errors << "gh auth is STALE on the #{gh_auth["lane"]} lane — #{GH_AUTH_REMEDY}"
end

pr = { "status" => "skipped", "message" => "GitHub checks disabled" }
if options[:gh]
  if command_available?("gh")
    ref = pr_ref_from(devops, branch["branch"])
    if ref
      gh_pr, warning = gh_pr_view(ref, options[:root])
      if gh_pr
        checks = summarize_rollup(gh_pr["statusCheckRollup"])
        failed = checks.select { |check| %w[fail cancelled timed_out action_required].include?(check["state"]) }
        merge_state = gh_pr["mergeStateStatus"].to_s
        pr = {
          "status" => "found",
          "number" => gh_pr["number"],
          "title" => gh_pr["title"],
          "url" => gh_pr["url"],
          "head" => gh_pr["headRefName"],
          "merge_state" => merge_state,
          "checks" => checks
        }
        pr["ci_less"] = ci_less?(gh_pr, checks)
        errors << "PR merge state is #{merge_state}" if BAD_MERGE_STATES.include?(merge_state)
        # THE THIRD STATE (task detect-ci-less-stale-prs): zero checks AND a REFUTED
        # merge means CI is not slow — it is never coming, and the session that waits
        # for it burns the whole cycle. Named here so the builder learns it at
        # preflight, before arming any watcher. The message is CiStatus's shared
        # remedy, not a local paraphrase, so every tool prescribes one cure.
        errors << CiStatus.ci_less_remedy(CiStatus.ci_less_verdict(JSON.generate(gh_pr))) if pr["ci_less"]
        failed.each { |check| errors << "PR check #{check["name"]} is #{check["state"]}" }
      else
        pr = { "status" => "missing", "message" => warning.to_s.empty? ? "no PR for #{ref}" : warning }
      end
    else
      pr = { "status" => "missing", "message" => "task has no pr_url or branch" }
    end
  else
    pr = { "status" => "skipped", "message" => "gh CLI is unavailable" }
  end
end

overlap = { "items" => [], "warnings" => [] }
overlap_candidates = []
if options[:gh] && command_available?("gh")
  current_pr_number = pr["number"]
  overlap, overlap_warnings, overlap_candidates = overlap_report(options[:root], changed, current_pr_number)
  overlap_warnings.each { |warning| warnings << warning }
  warnings << "same-file PR overlap found" unless overlap["items"].empty?
end

# DUPLICATE MIGRATION INSTALL — a BLOCKER, not a warning. Same-file overlap is normal
# in a parallel shop; two migrations sharing one class name are never intended and
# raise on EVERY db:migrate, including the Heroku release phase. The local leg (vs the
# base ref) runs even with --no-gh, so this never degrades to silence.
migrations = migration_collision_report(options[:root], base, changed, overlap_candidates)
unless migrations["items"].empty?
  errors << "duplicate migration install: #{migrations["items"].size} collision(s) — " \
            "see the DUPLICATE MIGRATION INSTALL block above"
end
if migrations["installs"].to_i.positive? && !(options[:gh] && command_available?("gh"))
  warnings << "migration collision checked against #{base || "no base ref"} only " \
              "(gh unavailable) — a sibling OPEN PR installing the same migration would not be seen"
end

installed_docs = if options[:install_docs]
  install_docs_check(options[:root])
else
  { "status" => "skipped", "message" => "disabled by --no-install-docs" }
end
errors << "installed docs/skills drift: #{installed_docs["message"]}" if installed_docs["status"] == "fail"

scan_files = active_stale_scan_files(options[:root], changed)
options[:stale_paths].each do |path|
  scan_files << (Pathname.new(path).absolute? ? path : File.join(options[:root], path))
end
stale_hits = stale_scan(options[:root], scan_files).first(40)
errors << "stale terminology found in #{stale_hits.size} location(s)" unless stale_hits.empty?

shape = shape_report(task, warnings)
# An EXEMPT kind (EXEMPT_KINDS) skips the shape/required-metadata gate only when
# the OBSERVED diff ships no behavior — exactly as bin/dor-check gates it, via the
# same CodeDiff classifier. The label alone never earns the skip. (Preflight runs
# BEFORE the code exists, so an empty diff is expected here and stays exempt; the
# merge gate is the one that fails closed on an unobservable diff.)
kind = devops["kind"].to_s.strip.downcase
code_files = CodeDiff.code_files(changed)
shape["kind"] = kind.empty? ? nil : kind
shape["exempt"] = EXEMPT_KINDS.include?(kind) && code_files.empty?
if shape["exempt"]
  # Nothing to gate: chore/cleanup/docs with a doc-only (or empty) diff.
elsif shape["shape"].nil?
  message = "devops.shape is missing; required tiers cannot be selected"
  if EXEMPT_KINDS.include?(kind)
    message += " (kind #{kind} ships code — #{code_files.first(3).join(", ")} — so there is no size exemption)"
  end
  errors << message
elsif shape["description"].nil?
  errors << "unknown devops.shape #{shape["shape"].inspect}"
end
unless shape["exempt"] || shape["missing_metadata"].empty?
  errors << "required metadata missing: #{shape["missing_metadata"].join(", ")}"
end

task_url = task["task_url"] || task.dig("devops", "task_url")
task_url ||= "https://mcritchie.studio/tasks/#{task["slug"]}" if task["slug"]

report = {
  "ok" => errors.empty?,
  "task" => {
    "slug" => task["slug"] || slug,
    "title" => task["title"],
    "stage" => task["stage"],
    "url" => task_url
  },
  "latest_feedback" => latest_feedback(task, fallback_activity: fallback_activity),
  "branch" => branch,
  "changed_files" => changed,
  "gh_auth" => gh_auth,
  "pr" => pr,
  "overlap" => overlap,
  "migration_collisions" => migrations,
  "installed_docs" => installed_docs,
  "stale_terms" => stale_hits,
  "shape" => shape,
  "warnings" => warnings.uniq,
  "errors" => errors.uniq
}

if options[:json]
  puts JSON.pretty_generate(report)
else
  print_human(report)
end

exit(report["ok"] ? 0 : 1)
