#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/dor-check — deterministic Definition-of-Ready gate for the two workflows.
#
# Reads a task's devops.shape and config/feature_shapes.yml, then confirms the
# task is ready to cross a workflow boundary. Two gates (pick with --gate):
#
#   --gate merge (default) — DoR-to-Merge, at submitted → reviewed.
#       Requires the shape's full required_metadata, its dor_tiers green (tagged
#       in devops.checks_run, e.g. "[unit] ..."), AND a SETTLED GREEN GitHub CI for
#       the PR's current head — the one form of suite evidence (the suite gate below).
#       Two shapes ask for something a tier list cannot express, and both are
#       checked against the OBSERVED DIFF rather than the label:
#         claimable_when: test_only_diff — `test-only` is refused unless every
#           changed path is provably test code, and refused again when no diff
#           can be observed at all. A shape whose lighter contract is unlocked by
#           TYPING its name is `kind: chore`'s bug moved into the taxonomy.
#         required_evidence: [control] — `test-only` must record a "[control]"
#           line in checks_run that NAMES A FILE FROM THE DIFF: the evidence that
#           the changed test still bites, which is the only question a diff with
#           no behavior in it can be asked.
#   --gate build           — DoR-to-Build, at designed → building.
#       Lighter: the spec must be complete (shape + acceptance + repositories +
#       risk_tags + test_plan). No test tiers yet — there's no code to test.
#
# DETERMINISTIC — no model, no judgment. A failed check is an instant, cheap
# send-back that never burns review tokens.
#
#   * Feature agents run --gate build before coding, --gate merge before handoff.
#   * The heartbeat DevOps agent re-runs --gate merge as gate-zero of review.
#
# THE SUITE GATE IS THE CI VERDICT (merge gate, every shape). The dor_tiers tags
# prove the agent WROTE the right tiers, but a tag is free text — an agent can
# satisfy a tier by running only the FILES it touched — so this gate ALSO demands
# evidence that the FULL suite went green against the EXACT code being shipped.
# Since /tasks/dor-reads-settled-ci-verdict that evidence has ONE form: a SETTLED
# GREEN GitHub CI verdict for the PR's current head, read through
# bin/lib/ci_status.rb and decided in bin/lib/ci_gate.rb (the allow-list — "THE
# GATE IS AN ALLOW-LIST, IN BOTH ROLES" there). The fingerprint receipts the
# local certs used to record (the fast-cert, full-suite, rubocop and cert-deferred
# lanes) and the full-suite-bypass hatch are gone with the certs
# (/tasks/retire-local-cert-evidence, DevOps v3 phase 2b); a leftover line in an
# old task's checks_run is author prose to this gate.
# The role table:
#   green                                  → advances, both roles (review still
#                                            refuses a green that predates a base
#                                            move — the stale-green check below).
#   red / conflicted / ci_less / closed /
#   merged                                 → refuses, both roles.
#   pending                                → builder: WAITING (exit 1, its own
#                                            headline — bin/ship waits for CI at
#                                            step 6/8, so this is the rare case);
#                                            review: refuses (the authoritative
#                                            verdict, "defer until CI settles").
#   none / unverified / unreadable / no_pr
#   / unclassified                         → refuses, both roles, with the state's
#                                            own remedy; no local cert stands in.
# The one fingerprint-bound line still graded here is the `test-only` shape's
# EXECUTED CONTROL ("[control@<fp>]", bin/control-check) — it is required
# evidence, not suite evidence, and it stays until phase 2b moves it to review.
# ROOTING — the gate must judge the TASK's tree, not the checkout the caller happens
# to stand in. The code DIFF roots here (2026-08-08, task dor-check-review-rooting;
# hardened again by harden-dor-check-file-read), and it is the half that fails in
# the DANGEROUS direction: the diff decides the `kind: chore/cleanup/docs`
# exemption, i.e. whether the test gate applies at all. Read from a foreign checkout
# it does not refuse — it AGREES, with someone else's files: the review gate-zero,
# run from the hub PRIMARY exactly as pr-review-primary.md instructs, saw that
# primary's ONE unrelated dirty .md and printed "✓ DoR-to-Merge n/a … doc-only diff
# … → ready to advance" over a multi-file code PR. A FALSE PASS in the gate whose
# entire job is refusing under-tested work, and the dirtier the checkout the more
# confidently it lies. So the task-root guard (bin/lib/task_tree.rb) runs in
# BOTH gate roles and re-roots the DIFF; where it cannot, the local working tree is
# refused as a diff source outright (untrusted_root?) and the gate falls back to
# the task BRANCH's committed diff, else to :indeterminate → fail closed.
#
# The PR read that should PRE-EMPT a local tree is classified, not assumed: App
# installation tokens live ~1h, and a lapsed credential used to be indistinguishable
# from a PR with no files, so the gate graded the working tree while printing a
# verdict about "the PR". The read now shares bin/lib/ci_status.rb's authenticated
# seam (gh_read_status — stderr preserved, one mint-and-retry) and a refusal that
# survives it is CLASSIFIED: review REFUSES (:pr_unreadable), submit-side degrades
# LOUDLY. See pr_file_read.
#
# The suite FINGERPRINT used to root here too (the review lane at the task branch's
# committed tree, the builder lane through the same guard), and its false-STALE
# history — 6 of 6 tasks on 2026-07-14 — is why the guard exists in this file at
# all. With the receipts no longer read, the only fingerprint-bound lane left is the
# `test-only` control stamp, which still takes the branch-tree rooting in the review
# lane (control_fingerprint) for the same reason the cert did.
#
# dor-check still does NOT run the suite itself — it stays a fast, deterministic
# verdict; GitHub CI is the runner that produces the evidence.
#
# Non-code kinds (devops.kind chore/cleanup/docs) carry no shape and no test
# tiers, so the shape gate does not apply: they PASS with a "DoR n/a" note.
#
# Post-deploy nudge (merge gate): if the branch diff touches a seed or a
# data-migration (db/seeds, db/migrate/), the task must declare
# devops.post_deploy_cmd — the command bin/release runs on the deployed app so a
# seed/backfill isn't run by hand post-ship. Set it to "none" to acknowledge a
# schema-only migration the release phase auto-runs.
#
# Post-deploy SAFETY gate (both gates): bin/release runs devops.post_deploy_cmd
# VERBATIM against PRODUCTION, so it must be a NARROW, prod-safe, idempotent
# command. A bare full-suite seed (bin/rails db:seed / db:seed:replant / rake
# db:seed) is REJECTED: db/seeds.rb loads EVERY db/seeds/*.rb — it would inject
# demo News/Content/Tasks into prod AND abort the release on a non-idempotent
# seed file. Require a scoped single-file runner (rails runner 'load
# Rails.root.join("db/seeds/NN_x.rb").to_s') or a dedicated rake task instead.
# Near-miss: merge-docs-reviewer-into-alex shipped post_deploy_cmd='bin/rails
# db:seed' because reviewers read the diff, not the deploy metadata.
#
# Auth: AGENT_API_SECRET from ENV, else repo .env, else 1Password LAST (same as
# bin/task). Base URL via TASK_API_BASE (default https://mcritchie.studio).
#
# Usage:
#   bin/dor-check <task-slug>                  # DoR-to-Merge (default), fetch + evaluate
#   bin/dor-check <task-slug> --gate build     # DoR-to-Build (spec complete, no tiers)
#   bin/dor-check <task-slug> --json           # machine-readable verdict (heartbeat agent)
#   bin/dor-check --file task.json             # evaluate a local task JSON (offline/tests)
#
# Exit code: 0 = ready, 1 = not ready (or error).

require "net/http"
require "json"
require "uri"
require "yaml"
require "optparse"
require_relative "lib/tree_fingerprint"
require_relative "lib/fast_lane"
require_relative "lib/repo_root"
require_relative "lib/ci_status"
require_relative "lib/task_pr_set"
require_relative "lib/ci_gate"
require_relative "lib/code_diff"
require_relative "lib/test_only_diff"
require_relative "lib/client_surface_diff"
require_relative "lib/control_replay"
require_relative "lib/task_board"
require_relative "lib/task_tree"
require_relative "lib/review_tree_guard"
require_relative "lib/base_movement_audit"
require_relative "lib/merge_ref_base"
require_relative "lib/dor/checks"
require_relative "lib/dor/check_context"
Dor::Checks.load!

# ROOT = the gate script's OWN repo (the hub). CONFIG (feature_shapes.yml) and the
# token .env resolve from here and STAY here — the shape taxonomy is studio-owned.
# The code DIFF roots at the agent's worktree (diff_root). The one fingerprint left
# — the `test-only` control stamp's — usually does too, but not always: the review
# lane and the reclaimed-worktree remedy hash a committed BRANCH TREE instead
# (control_fingerprint).
ROOT = File.expand_path("..", __dir__)
CONFIG_PATH = File.join(ROOT, "config", "feature_shapes.yml")
# ── remedy forms of the scripts this gate NAMES in a refusal ──────────────────
# Absolute and resolvable. bin/task and bin/gh-auth-refresh live in
# mcritchie-studio/bin ALONE, so a builder grading a turf-monster or rolio desk
# reached THIS gate through its absolute path and could not resolve the bare form
# it printed back at them. Resolved from __dir__ — the very dor-check that is
# speaking, and its siblings beside it. Deliberately NOT TASK_BIN below: that is
# the ENV-redirected EXEC seam, while a remedy names the real script the reader is
# sent to. Policy: FastLane.remedy_command. (No refusal offers a local cert route:
# the receipts the certs recorded stopped being evidence, and then the certs
# retired.)
TASK_CMD = FastLane.remedy_command("task", __dir__)
GH_AUTH_REFRESH_CMD = FastLane.remedy_command("gh-auth-refresh", __dir__)
# The board CLI the task-root guard reads devops.branch/worktree_slug through when
# a caller has no task in hand. dor-check always DOES (it just fetched one), so it
# passes `devops:` and this stays unused on the normal path; tests stub it.
TASK_BIN = ENV.fetch("DOR_CHECK_TASK_BIN", File.expand_path("task", __dir__))
# Where the root guard globs for the task's worktree (…/<app>/.worktrees/<slug>).
# nil → ProjectsRoot's default. The test seam: it redirects the glob at a temp
# projects root, and (see the guard block below) it is what opts a --file run into
# the guard at all.
PROJECTS_DIR = ENV["DOR_CHECK_PROJECTS_DIR"]
# Kinds that MAY skip the shape/test-tier gate — chore/cleanup/docs. The label
# alone NEVER earns the skip: the exemption must be EARNED by an observed
# doc-only diff (CodeDiff.code_files empty). "There is no size exemption"
# (CLAUDE.md/AGENTS.md) — and there is no LABEL exemption either. See
# bin/lib/code_diff.rb for why the classifier is a denylist, and for the PR #512
# escape (a kind:chore that shipped .github/workflows/ci.yml) that motivated it.
EXEMPT_KINDS = CodeDiff::EXEMPT_KINDS
# Path prefixes whose changes ship DATA, not just schema/behavior: a new seed or
# a data-migration (a backfill) needs a one-off rake AFTER the deploy — Heroku's
# release phase auto-runs `db:migrate`, but NOT `db:seed` or a backfill task. The
# mechanism to run it on ship already exists end-to-end (devops.post_deploy_cmd,
# which bin/release executes against the deployed app, aborting on non-zero), but
# features that add a seed/migration routinely forget to DECLARE it, so someone
# runs the rake by hand post-ship (pokemon:seed, pokemon:resync_mascots, …). The
# merge gate nudges: a diff under these prefixes must carry a post_deploy_cmd (or
# declare "none" to acknowledge a schema-only migration the release phase runs).
DATA_CHANGE_PREFIXES = %w[db/migrate/ db/seeds].freeze
# A devops.post_deploy_cmd that runs the FULL seed suite. bin/release executes
# post_deploy_cmd VERBATIM against the deployed app (prod on ship), and Rails'
# db:seed task loads db/seeds.rb — which in this app loads EVERY db/seeds/*.rb
# (demo News/Content/Tasks + any non-idempotent file). So the bare task is
# forbidden as a post-deploy command; a scoped runner or a dedicated rake task is
# required instead. This matches the rake TASK token `db:seed` (and
# `db:seed:replant` / any `db:seed:*` subtask) as a standalone word — the COLON is
# the tell: `db:seed` is the rake task; the safe scoped form `db/seeds/NN.rb`
# (slash) must NOT match, nor a dedicated task like `pokemon:seed`.
BARE_SEED_TASK = %r{(?<![\w:/])db:seed(?::\w+)?(?![\w:/])}i
BASE_URL = ENV.fetch("TASK_API_BASE", "https://mcritchie.studio")
# The gate-run CLI (GateRun markers). A merge-gate verdict opens+closes the
# task's DoR gate — `dor` (builder) or `dor_review` (review gate-zero) — see the
# emit at the bottom; fire-and-forget.
#
# DOR_CHECK_GATE_BIN redirects that CLI — the tests point it at a stub, the same
# seam shape DOR_CHECK_CONTROL_EVIDENCE has for the control lane.
# It exists because "was an attempt RECORDED?" is otherwise unobservable: --json
# and --file both skip the board write by design, so a verdict that records
# NOTHING — which is exactly what an exempt run did until this task — reads
# identically to one that recorded a pass. Overriding it is also what lets a
# --file run emit at all (gate_emission_enabled? below); production never sets it,
# so --file stays offline for every real caller.
GATE_BIN_OVERRIDDEN = !ENV["DOR_CHECK_GATE_BIN"].to_s.strip.empty?
GATE_BIN = GATE_BIN_OVERRIDDEN ? ENV["DOR_CHECK_GATE_BIN"] : File.expand_path("gate", __dir__)

def warn!(msg)
  $stderr.puts(msg)
end

def die!(msg)
  warn!("error: #{msg}")
  exit 1
end

options = { json: false, file: nil, gate: "merge", gate_role: "builder", diff_base: false }
GATES = %w[merge build].freeze
GATE_ROLES = %w[builder review].freeze

# THE PR-READ REFUSAL, NAMED ONCE. Two places on the exempt path have to describe this
# refusal to the operator, and they must not drift apart: the closing `refused_by` line
# (which half refused THIS verdict) and the `also_refused:` list handed to the CI
# refusal's own remedy (what a green CI would still not clear). They were one sentence
# written twice for about a minute, which is the "second copy is a second thing to
# forget" failure bin/lib/ci_status.rb's header names — so it is a constant, and the two
# readings of the same fact are literally the same string.
PR_READ_REFUSAL_PHRASE = "the PR's own file list going unread, so the doc-only exemption was never proven " \
                         "against the artifact this gate judges"

# ...AND THE SAME FACT SAID BY THE PRINTER THAT *IS* IT.
#
# THE DEFECT (/tasks/pr-read-alert-overstates-green). PR_READ_REFUSAL_PHRASE above is
# written for the two places that name the PR read as SOMEONE ELSE'S co-refusal — the
# exempt closing `refused_by` line and the CI refusal's `also_refused:` list. The
# PR-read alert itself had no sentence of its own: on the exempt path it ended with
# CiStatus.unreadable_remedy's task-grain closing, "this gate advances on a GREEN
# CI and nothing else", and BORROWED it.
#
# That sentence is falsest exactly where it printed. Driven through `bin/dor-check
# --gate-role review` with DOR_CHECK_CI_STATUS=green and the PR file read REFUSED:
# ci.state="green", ready=false, exit=1, ONE error — and that one error closed by
# telling the reader a green CI is all this gate wants. The CI was green. The error
# printing the sentence was itself the refusal, and the sentence sent the reader to
# look at CI, which had nothing wrong with it.
#
# So this printer names ITSELF, and `also_refused:` (the merged derivation, PR #1225 →
# /tasks/gate-sentence-outlived-truth) is the lever that swaps the closing out. Nothing
# in CiStatus.unreadable_remedy changes: the co-fire branch already existed and already
# ends "and no CI result clears that", which is the exact refutation this defect needs.
# The phrase is a SECOND constant rather than a reuse of the first because the two say
# the same fact from opposite vantages — "something else also refused you" vs "the
# thing you are reading is what refused you" — and collapsing them would put "the PR's
# OWN file list going unread" inside the alert about the PR's own file list going
# unread.
PR_READ_SELF_REFUSAL_PHRASE = "the refused PR file-list read this alert reports, which left the artifact this " \
                              "gate judges unread"
OptionParser.new do |o|
  o.banner = "Usage: #{$PROGRAM_NAME} <task-slug> [--gate merge|build] [--gate-role builder|review] [--json] | #{$PROGRAM_NAME} --file task.json"
  o.on("--gate GATE", "Boundary to check: merge (default, submitted→reviewed) or build (designed→building)") { |v| options[:gate] = v }
  o.on("--gate-role ROLE", "Who is running the gate: builder (default; the verdict opens+closes the task's DoR " \
                           "gate `dor`) or review (the primary reviewer's gate-zero; opens+closes `dor_review`)") { |v| options[:gate_role] = v }
  o.on("--json", "Emit a machine-readable verdict") { options[:json] = true }
  o.on("--diff-base", "Resolve and print the committed-diff base for this repo, then exit (debug/resolver seam)") { options[:diff_base] = true }
  o.on("--file PATH", "Evaluate a local task JSON instead of fetching") { |v| options[:file] = v }
  o.on("-h", "--help", "Show this help") do
    puts o
    exit 0
  end
end.parse!
die!("--gate must be one of: #{GATES.join(", ")}") unless GATES.include?(options[:gate])
die!("--gate-role must be one of: #{GATE_ROLES.join(", ")}") unless GATE_ROLES.include?(options[:gate_role])

# --- task board auth + fetch (mirrors bin/task) ---------------------------

def agent_secret
  dotenv = File.join(ROOT, ".env")
  TaskBoard.agent_secret(dotenv) ||
    die!("AGENT_API_SECRET not found (checked ENV, #{dotenv}, 1Password)")
end

def token
  @token ||= api(:post, "/api/v1/auth", { secret: agent_secret }, auth: false).fetch("token")
end

def api(method, path, body = nil, auth: true)
  res = TaskBoard.request(method, path, base_url: BASE_URL, token: (auth ? token : nil), body: body)
  parsed = TaskBoard.parse_body(res)
  unless res.code.to_i.between?(200, 299)
    die!("#{method.upcase} #{path} -> #{res.code}: #{parsed["error"] || res.body}")
  end
  parsed
end

def load_task(slug, file)
  if file
    raw = JSON.parse(File.read(file))
    raw["data"] || raw
  else
    die!("usage: #{$PROGRAM_NAME} <task-slug> [--json]") if slug.nil? || slug.empty?
    api(:get, "/api/v1/tasks/#{slug}")["data"] || die!("task #{slug} not found")
  end
rescue JSON::ParserError => e
  die!("could not parse task JSON: #{e.message}")
rescue Errno::ENOENT
  die!("file not found: #{file}")
end

# --- evaluation -----------------------------------------------------------

# A devops field is "present" when it is a non-blank string or a non-empty list.
def present?(value)
  case value
  when nil then false
  when Array then value.any? { |v| v.to_s.strip != "" }
  else value.to_s.strip != ""
  end
end

# A tier is satisfied when a checks_run line is tagged "[tier]" at its start.
def tier_satisfied?(checks, tier)
  checks.any? { |line| line.to_s =~ /\A\s*\[\s*#{Regexp.escape(tier)}\s*[\]:]/i }
end

# Does this [control] line name a file that is actually in the diff? The one
# mechanical claim the control gate makes (see the block at the shape checks): it
# separates a control ABOUT THIS CHANGE from a sentence that could have been
# written before the change existed.
#
# Full path OR basename, because a builder writing the line by hand reasonably
# types `hub_test.rb` rather than `test/integration/hub_test.rb`, and refusing the
# short form would only teach people to paste the long one without running
# anything. The basename still has to belong to a file in THIS diff, which is the
# property being asserted; the spelling is not.
def control_names_a_changed_file?(line, observed)
  text = line.to_s
  observed.any? do |path|
    file = path.to_s.strip
    next false if file.empty?

    text.include?(file) || text.include?(File.basename(file))
  end
end

# Which observed paths bin/control-check CAN replay: a runnable Ruby test file
# that EXISTS at the diff base, so there is a pre-change version to run against
# current production code. A rename shows up here through its OLD path (the
# `--name-only` diff lists both sides), a deletion through the deleted path, and an
# ADDED file not at all — which is correct, since an added file has no pre-change
# version and never will.
#
# FAIL-OPEN — [] when the question cannot be answered (no git, an unresolvable
# base, an unobserved diff). That is the opposite of this file's usual instinct and
# it is deliberate, because the two failure modes are not symmetric here. The
# fail-CLOSED rule elsewhere protects a gate whose job is refusing under-tested
# CODE; this predicate decides whether to demand a MACHINE RUN of a control, and
# guessing "yes" from a blind checkout would refuse a correct change for evidence
# the builder cannot produce from where they stand. The floor never drops: when
# this returns [], the author's `[control]` line is still required, exactly as
# before this runner existed. The strictness is ADDED where the replay is provably
# possible, never subtracted where it isn't.
# Freshness of the EXECUTED control stamp, plus the verdict it recorded, as
# [lane_status, verdict_token].
#
# Graded from a REAL fingerprint or not graded at all. `fingerprint` is the
# caller's control_fingerprint — the task branch's committed tree in the review lane
# (the reviewer's checkout is never the task's tree), the working tree otherwise —
# and a nil fingerprint is :missing, never a synthesised :fresh. Until
# /tasks/dor-reads-settled-ci-verdict this read the suite verdict's fingerprint and
# had to defend against the retired suite verdict's "every lane :fresh" default on a
# recorded bypass hatch; that verdict is no longer computed, so the only
# way to a :fresh here is a stamp whose hash equals the tree's.
#
# DOR_CHECK_CONTROL_EVIDENCE is this lane's OWN injection seam (fresh:<VERDICT> |
# stale | missing).
def control_evidence_status(checks, fingerprint)
  injected = ENV["DOR_CHECK_CONTROL_EVIDENCE"].to_s.strip
  unless injected.empty?
    lane = if injected.start_with?("fresh") then :fresh
           elsif injected.start_with?("stale") then :stale
           else :missing
           end
    return [lane, ControlReplay::VERDICTS.find { |token| injected.include?(token) }]
  end

  return [:missing, nil] if fingerprint.nil?

  lane = CertEvidence.lane_status(checks, ControlReplay::LANE, fingerprint)
  stamp = checks.find { |line| CertEvidence.extract_fingerprint(line, ControlReplay::LANE) == fingerprint }
  [lane, stamp && ControlReplay.verdict_of(stamp)]
end

def control_replayable_files(observed)
  return [] if observed.nil? || observed.empty?

  root = diff_root
  base = diff_base(root).to_s.strip
  return [] if base.empty?
  return [] unless system("git", "-C", root.to_s, "rev-parse", "--verify", base,
                          out: File::NULL, err: File::NULL)

  observed.select do |path|
    next false unless ControlReplay.runnable?(path)

    system("git", "-C", root.to_s, "cat-file", "-e", "#{base}:#{path}",
           out: File::NULL, err: File::NULL)
  end
rescue StandardError
  []
end

# Files changed on this branch — the FULL working-tree diff, so the code-diff
# chore gate fires whether dor-check runs BEFORE the feature commit (the SOP
# order: dor-check → fix → commit) or after it. Tests inject a deterministic list
# via DOR_CHECK_CHANGED_FILES (newline/comma separated; empty string = no diff),
# which stays authoritative when set.
#
# Otherwise we union four git views, de-duped:
#   * uncommitted, base-independent (a positive signal — these gate even pre-commit):
#       staged    git diff --cached --name-only
#       unstaged  git diff --name-only
#       untracked git ls-files --others --exclude-standard
#   * committed against the release-aware base (see diff_base/default_diff_base):
#     git diff <base>...HEAD. Default base is origin/accepted when it exists, else
#     origin/release, else origin/main — post-v2 branches are cut off `accepted`
#     (which runs AHEAD of `release`, which runs AHEAD of `main`), so diffing
#     against a lower ref drags in everyone else's already-integrated work → a
#     false code diff. DOR_CHECK_DIFF_BASE
#     overrides the default. Best-effort; the base can be unfetched on a fresh
#     branch, which is fine — the working-tree views above don't depend on it.
# Diff dir defaults to the agent's worktree (cwd's git toplevel) so a SATELLITE
# task diffs the satellite, not the hub this script lives in; DOR_CHECK_DIFF_ROOT
# overrides (deterministic tests against a temp repo). If git can't read the
# working tree at all (no repo), the diff is INDETERMINATE and the merge gate
# ENFORCES the tiers (resolve_branch_diff) — it never defaults to exempt. A gate
# that cannot see must not wave things through.
# MEMOIZED, because the task-root guard below can RE-ROOT it: when the cwd turns out
# not to be the task's tree, every later reader (the diff, the Gemfile pair, the
# control stamp's fingerprint) must see the SAME corrected root, resolved once.
def diff_root
  @diff_root ||= RepoRoot.code_root(ENV["DOR_CHECK_DIFF_ROOT"], ROOT)
end

# The diff under gate, resolved ONCE as [files, source]. Sources, in priority:
#
#   :injected — DOR_CHECK_CHANGED_FILES (the deterministic test seam).
#   :pr       — the PR's OWN file list, via `gh pr view --json files`. At the merge
#               boundary the artifact under gate is the PULL REQUEST, not whatever
#               tree the caller happens to be standing in — and the caller is often
#               standing somewhere blind: the reviewer's gate-zero
#               (`--gate-role review`) runs from a PRIMARY checkout where the task
#               branch isn't checked out at all, so a local-only detector sees an
#               EMPTY diff and (pre-fix) called that "no code". Reading the PR makes
#               the verdict correct from anywhere.
#   :git      — the local working tree + committed view (union of staged, unstaged,
#               untracked, and base...HEAD). This is the BUILDER's view: it fires
#               pre-commit and pre-PR, before a PR exists to read. Read ONLY from a
#               root that IS the task's tree — see untrusted_root? below.
#   :branch   — the task BRANCH's committed diff (base...origin/<branch>), read when
#               the caller stands in a foreign checkout that still carries the branch.
#               The diff-side twin of the branch-tree FINGERPRINT rooting: same repo,
#               same content-addressed honesty, no dependence on the cwd's dirt.
#   :pr_unreadable — the PR read was REFUSED on credentials, in the REVIEW role. Not a
#               source at all: it is the refusal, carrying no files, so it fails closed
#               like :indeterminate while naming the credential fault instead of
#               claiming nothing was readable anywhere. See resolve_branch_diff.
#   :indeterminate — nothing could be read. NEVER an exemption (see below).
#
# FAIL-CLOSED. "We couldn't see a code diff" is not "there is no code diff." The
# old resolver returned [] on an unreadable repo AND on a blind checkout, and []
# bought a full exemption — the gate defaulted to OFF whenever it couldn't see.
# Now the exemption demands positive proof (a non-empty, observed, all-prose
# diff); anything else enforces the tiers.
#
# AND A NON-EMPTY OBSERVATION OF THE WRONG TREE IS NOT PROOF EITHER. That is the
# hole the fail-closed rule above left open, and the one that actually fired: the
# review gate-zero runs from the hub PRIMARY by SOP (pr-review-primary.md's Entry
# says `cd /Users/alex/projects/mcritchie-studio`), the PR file list was unreadable,
# and the git fallback dutifully reported the primary's ONE dirty unrelated file —
# docs/agents/maintenance/delete-later.md. Non-empty, observed, all prose: the
# `kind: chore` exemption was EARNED by evidence, and a multi-file code PR was waved
# through with "✓ DoR-to-Merge n/a … doc-only diff … → ready to advance". The
# fingerprint half of this same mistake can only ever produce a false REFUSAL
# (STALE, loud, self-correcting); the diff half produces a false PASS in the gate
# whose whole job is refusing under-tested work, and the dirtier the primary the
# more confidently it lies. So the trust question is now asked BEFORE the answer is
# used: the local view is a valid source only from the task's own tree.
def branch_diff
  @branch_diff ||= resolve_branch_diff
end

# True when diff_root is NOT the task's tree AND could not be re-rooted onto it —
# so its working tree describes SOMEBODY ELSE'S code and must never be read as this
# task's diff. Set by the task-root guard block below (which runs before the first
# changed_files call, so the memoized resolution below always sees the final answer);
# false on every path where the root was never in question — an explicit
# DOR_CHECK_DIFF_ROOT, the build gate, an offline --file run, or a root the guard
# confirmed IS the task's tree.
def untrusted_root?
  @untrusted_root ? true : false
end

# True when the checkout we are standing in is at least the PR's own REPO — so its
# REFS (not its working tree) can still answer for this task. False only on a
# positive repo contradiction from the guard. Defaults true for every path where the
# root was never in question, so it can never make a previously-fine run stricter.
def standing_repo_ok?
  @standing_repo_ok.nil? ? true : @standing_repo_ok
end

# WHY this checkout cannot answer for the task's branch, and the fix — as
# [reason, remedy]. Repo-aware, because the two cases are different problems with
# different answers, and only one of them is curable by fetching:
#
#   right repo, branch absent → "not in this repo"; `git fetch origin <branch>` fixes it.
#   WRONG repo               → the branch may well be sitting right here, and fetching
#                              is useless: a same-named branch in another repo is a
#                              different project's work. The fix is to go to the PR's repo.
#
# Shared once between two refusals that had DRIFTED: the (since retired) suite gate's
# remedy-3 flatly asserted "its branch <b> is not in this repo" and offered the fetch
# — both false on the wrong-repo path — while its sibling in the exempt gate had
# already been taught the difference. One source, so a second caller cannot disagree.
def branch_unavailable(branch)
  if standing_repo_ok?
    ["its branch #{branch} is not in this repo",
     "fetch its branch (git fetch origin #{branch})"]
  else
    ["this checkout is not the PR's repo at all, so a #{branch} branch here would be a different " \
     "project's work that merely shares the name — fetching cannot help",
     "re-run it from the PR's own repo"]
  end
end

def changed_files
  branch_diff.first
end

def diff_source
  branch_diff.last
end

def resolve_branch_diff
  if ENV.key?("DOR_CHECK_CHANGED_FILES")
    return [ENV["DOR_CHECK_CHANGED_FILES"].to_s.split(/[\n,]/).map(&:strip).reject(&:empty?), :injected]
  end

  pr = pr_changed_files
  return [pr, :pr] if pr.is_a?(Array) && pr.any?

  # A MULTI-REPO READ THAT DID NOT COMPLETE, in BOTH roles. See pr_read_alert's
  # :incomplete branch for the argument: the builder's local-view fallback is earned by
  # standing in the PR's own worktree, and on a task with a PR in each of two repos no
  # single tree here can stand in for both. Falling through would hand the git tree (or
  # a partial PR union) to the tier gate as "the task's diff", which is the defect
  # /tasks/dor-check-reads-one-pr closes, so this fails closed BEFORE the fallbacks.
  return [[], :pr_incomplete] if pr_file_read[:state] == :incomplete

  # A CREDENTIAL-REFUSED PR read, in the REVIEW role, is not a fallback — it is a
  # blind gate. The review gate-zero IS the authoritative verdict (the CI allow-list
  # already refuses an unreadable CI here for exactly this reason), and it runs from a
  # checkout that is deliberately NOT the task's tree, so "read the PR" is the whole
  # mechanism by which it sees anything true. Standing in for the refused read with a
  # local view is the 2026-08-08 false pass with a fresh coat of paint: an artifact
  # nobody asked about, graded confidently. So the source is the REFUSAL itself, which
  # carries no files and therefore fails closed downstream exactly like
  # :indeterminate — but says WHY, in the payload and in the refusal text.
  #
  # SUBMIT-SIDE THE FALLBACK STAYS. The builder's run stands in the task's OWN
  # worktree, where the local view is the honest near-twin of the PR, and their verdict
  # is provisional by design (review re-runs it). Blocking every builder whose App
  # token aged past an hour would buy no integrity and cost every handoff — so there
  # the substitution is kept and NAMED (pr_read_alert), never silent.
  return [[], :pr_unreadable] if @review_role && pr_file_read[:state] == :unreadable

  if untrusted_root?
    # The local working tree belongs to someone else's code (the guard could not
    # re-root onto the task's own tree). Reading it is the false-PASS bug, so the
    # only remaining honest local source is the task BRANCH's committed diff — and
    # ONLY when this checkout is the PR's own REPO. A branch name is not repo-scoped:
    # `feat/<slug>` in some other repo is a different project's work that merely
    # shares a name (21 such hub↔satellite collisions exist on disk today), and
    # grading it is the same false pass one door further out. Otherwise: nothing
    # observed, and the gate fails closed.
    branch = (branch_committed_files(diff_root, @task_branch) if standing_repo_ok?)
    return [branch, :branch] if branch.is_a?(Array) && branch.any?

    return [[], :indeterminate]
  end

  git = git_changed_files
  return [git, :git] if git.is_a?(Array) && git.any?

  # Nothing observed anywhere. A genuinely clean tree and a blind/unreadable
  # checkout are INDISTINGUISHABLE from here, so both fail closed.
  [[], :indeterminate]
end

# The files the task BRANCH changed, read from its COMMITTED history rather than
# from any working tree — the honest diff when the caller stands in a foreign
# checkout that still carries the branch (the root guard's remedy 2, applied to the
# diff instead of the fingerprint). Prefers origin/<branch> (what CI graded) over a
# local <branch>, exactly like review_fingerprint. Returns nil when neither ref
# resolves here, or when the branch is even with its base — the caller then falls
# through to :indeterminate and the gate fails closed, which is the correct answer
# to "this checkout cannot show me the task's diff".
def branch_committed_files(root, branch)
  return nil if branch.to_s.strip.empty?

  base = diff_base(root)
  ["origin/#{branch}", branch].each do |ref|
    IO.popen(["git", "-C", root, "rev-parse", "--verify", "#{ref}^{commit}"], err: File::NULL, &:read)
    next unless $?.success?

    out = IO.popen(["git", "-C", root, "diff", "--name-status", "-M", "#{base}...#{ref}"], err: File::NULL, &:read)
    next unless $?.success?

    files = CodeDiff.paths_from_name_status(out).map(&:strip).reject(&:empty?).uniq
    return files unless files.empty?
  end
  nil
rescue SystemCallError
  nil
end

# The PR's changed files (merge gate's source of truth) — files, or nil when there
# are none to hand back. WHY it was nil is the other half of the answer, and it lives
# in pr_file_read below: "this PR has no files" and "GitHub refused our credential"
# are different facts with opposite consequences, and collapsing them into one nil is
# the defect this pair exists to close.
def pr_changed_files
  pr_file_read[:files]
end

# The PR file-list read, resolved ONCE as {files:, state:, cause:, reason:}:
#
#   :ok         — the PR's own file list. The only state that produces files.
#   :no_pr      — no pr_url (or one no owner/repo/number can be parsed out of).
#                 NOT a failure: the builder's pre-PR run lives here, and it must stay
#                 as quiet as it has always been.
#   :empty      — gh answered and the PR lists no files. Also not a failure.
#   :unverified — the read failed for a reason that is NOT a credential refusal (gh
#                 missing, a 404, a transport error). The local view still stands in,
#                 but the substitution is NAMED (see pr_read_alert).
#   :unreadable — GitHub REFUSED the credential (401/403/rate limit). This is the one
#                 that used to be invisible: an installation token lives ~1h, and when
#                 it lapsed mid-session this read failed, returned nil, and the gate
#                 silently graded the LOCAL WORKING TREE — a different artifact — while
#                 printing a verdict about "the PR". Shape tiers, the doc-only
#                 exemption and migration detection all judged the wrong input, and
#                 nothing in the output said so.
#
# THE STDERR IS THE EVIDENCE. The old call passed `err: File::NULL`, so gh's
# "Bad credentials (HTTP 401)" line — which it prints on STDERR — was thrown away
# before anything could classify it. There was then no text for
# GhAuthRetry.auth_failure? or CiStatus.unreadable_cause to read, which is why an auth
# failure could not even be NAMED, let alone recovered. The read now goes through
# CiStatus.gh_read_status: it joins stdout+stderr, mints a fresh App token and retries
# ONCE on exactly this refusal (bin/ship and bin/pr-review already did; this gate was
# the last holdout), and hands back the exit status so a failed read is never mistaken
# for an empty one.
#
# DOR_CHECK_PR_FILES is the test seam, mirroring DOR_CHECK_CI_STATUS: a file list, the
# token "unverified" (gh down), or "unreadable[:<raw gh body>]" to drive the credential
# path through the REAL classifier.
def pr_file_read
  @pr_file_read ||= compute_pr_file_read
end

def compute_pr_file_read
  injected = ENV["DOR_CHECK_PR_FILES"]
  if injected
    # The SINGULAR seam still stands in for the whole read, and it still records what
    # it stood in for: a coverage report that goes blank under one seam and populated
    # under another is a report nobody can trust to mean "this is what was read".
    read = injected_pr_file_read(injected)
    @pr_file_reads = Array(@pr_targets).first(1).map { |target| [target, read] }
    return read
  end

  targets = Array(@pr_targets)
  return { files: nil, state: :no_pr } if targets.empty?

  # THE PER-PR READS ARE KEPT, not just folded. The fold answers "what is the task's
  # diff"; the coverage report answers "which PRs did this verdict actually read", and
  # a verdict that cannot answer the second is the one this task is about.
  @pr_file_reads = targets.map { |target| [target, read_pr_files_for(target)] }

  # ONE PR: the fold is the read, byte for byte — a single-repo task cannot reach the
  # union below, so nothing about the ordinary verdict changes.
  return @pr_file_reads.first.last if targets.size == 1

  merge_pr_file_reads(@pr_file_reads)
end

# ONE ROW PER PR THIS RUN READ — the repo, its PR, how many files it contributed, and
# ITS OWN CI state. This is the report that makes a multi-repo verdict checkable: the
# defect being closed was a single confident verdict with no way to ask which repos it
# had seen, so "did this cover turf-monster?" was unanswerable from the output.
#
# Costs a `gh` call per PR through task_ci_reads, which the caller has already made —
# both are memoized. NEVER call it at the build gate, which must not shell to gh.
def pr_coverage
  pr_file_read # force the reads, so @pr_file_reads is populated
  entry_by_url = task_ci_reads.each_with_object({}) { |entry, acc| acc[entry[:target][:url]] = entry }
  Array(@pr_file_reads).map do |target, read|
    entry = entry_by_url[target[:url]]
    ci = entry && entry[:ci]
    # A staged sibling that landed on accepted is EXCLUDED from the governing verdict
    # (TaskPrSet.governing) — so the row says so, rather than printing a bare "merged"
    # beside a pass and leaving the reader to wonder whether it was weighed at all.
    ci_text = ci && ci[:state].to_s
    ci_text = "merged into #{TaskPrSet::LANDING_BASE} — landed, not governing" if entry && TaskPrSet.landed_sibling?(entry)
    { repo: target[:repo], pr_url: target[:url], read: read[:state].to_s,
      files: Array(read[:files]).size, file_sample: Array(read[:files]).first(3),
      ci: ci_text }.compact
  end
end

# THE COVERAGE BLOCK — printed on a multi-PR task, pass or fail, on EVERY human
# verdict this gate can produce. A verdict about a task with a PR in two repos must SAY
# which PRs it read, or the reader cannot tell a run that covered both from the pre-fix
# run that read one and looked identical.
#
# A DEF, NOT A LAMBDA BESIDE THE FINAL VERDICT, and that is the point: the EXEMPT
# verdicts exit early, on their own printer, and they are precisely the shapes the
# 08-08 false pass wore. A block only the gated path could print would be missing from
# every doc-only run — the runs most in need of it.
#
# Suppressed on the ordinary one-PR task, where the verdict already names its subject,
# and at the build gate, which must not shell to gh.
def print_pr_coverage(gate)
  return if gate == "build"

  rows = pr_coverage
  return if rows.size < 2

  puts "  PRs read (#{rows.size}):"
  rows.each { |row| puts "    · #{pr_coverage_line(row)}" }
end

# A printable coverage row: "turf-monster PR 575 · 1 file (docs/SOLANA.md) · CI green".
def pr_coverage_line(row)
  files = row[:files].to_i
  sample = Array(row[:file_sample]).join(", ")
  sample += ", …" if files > Array(row[:file_sample]).size
  detail = if row[:read] == "ok"
    "#{files} file#{"s" unless files == 1}#{sample.empty? ? "" : " (#{sample})"}"
  else
    "files #{row[:read].to_s.upcase}"
  end
  "#{row[:repo]} #{row[:pr_url].to_s[%r{/pull/\d+}].to_s.sub("/pull/", "PR ")} · #{detail} · " \
    "CI #{row[:ci] || "not read"}"
end

# THE UNION OF EVERY RECORDED PR — the diff a multi-repo task actually ships.
#
# WHY A UNION AND NOT A CHOICE. The subject of this gate at the merge boundary is
# "the code this task is asking to merge", and on a two-repo task that is both PRs.
# Grading either one alone answers a question nobody asked; picking by DIFF ROOT
# cannot work either, because PR files OUTRANK the git tree (resolve_branch_diff
# returns the PR list first), so the tree loses and both roots produced the identical
# verdict — measured on /tasks/document-burn-entry-token, 2026-09-07.
#
# The union is also the FAIL-CLOSED direction on every consumer: more code files means
# more tiers demanded, a doc-only exemption that must now hold across BOTH PRs, and
# migration detection that sees the satellite's migration as well as the hub's.
#
# A READ THAT DID NOT COMPLETE IS NOT A SUBSET — IT IS :incomplete. If any recorded PR
# could not be read, the union cannot be formed, and there is nothing honest to hand
# back: returning the repos that DID read would be this task's own defect wearing a
# smaller number. It carries `repos_unread` so the refusal can NAME the repo it could
# not read, which is the whole difference between a gate that is limited and a gate
# that is lying.
def merge_pr_file_reads(reads)
  unread = reads.reject { |_, read| %i[ok empty].include?(read[:state]) }
  if unread.any?
    first = unread.first[1]
    return { files: nil, state: :incomplete,
             cause: first[:cause], reason: first[:reason],
             repos_unread: unread.map do |target, read|
               { repo: target[:repo], url: target[:url], state: read[:state].to_s,
                 reason: read[:reason] }.compact
             end }
  end

  files = reads.flat_map { |_, read| Array(read[:files]) }.map(&:strip).reject(&:empty?).uniq
  files.empty? ? { files: nil, state: :empty } : { files: files, state: :ok }
end

# One target's read. A RECORDED url that is not a PR URL is a failure, not silence:
# :no_pr means "no PR yet" (the builder's quiet pre-PR run), and a repo whose register
# entry the gate cannot parse is a repo whose verdict cannot be obtained — which must
# be said, not swallowed.
def read_pr_files_for(target)
  injected = injected_pr_files_by_repo[target[:repo]]
  return injected_pr_file_read(injected) if injected

  unless target[:readable]
    # NAME THE FIELD THE READER MUST EDIT. The primary and the register are different
    # fields, and sending someone to `devops.pr_urls[]` for a malformed `devops.pr_url`
    # is a remedy that cannot be followed — `recorded_as` is nil for the primary
    # precisely because it did not come from the register.
    field = target[:recorded_as] ? "devops.pr_urls[#{target[:recorded_as]}]" : "devops.pr_url"
    return { files: nil, state: :unverified,
             reason: "#{field} = #{target[:url].inspect} is not a GitHub pull-request URL" }
  end

  read_pr_files(target[:url])
end

# THE PER-REPO TEST SEAM, mirroring DOR_CHECK_PR_FILES for a task with several PRs:
# a JSON object of repo => the SAME token grammar the singular seam takes (a file
# list, "unverified", or "unreadable[:<raw gh body>]"), so the multi-repo properties
# are driven through the REAL classifier rather than a hand-built hash. Unparseable
# JSON is ignored rather than fatal — a broken seam must never be able to make the
# gate pass something.
def injected_pr_files_by_repo
  @injected_pr_files_by_repo ||= parse_repo_seam(ENV["DOR_CHECK_PR_FILES_BY_REPO"])
end

def parse_repo_seam(raw)
  value = raw.to_s.strip
  return {} if value.empty?

  parsed = JSON.parse(value)
  parsed.is_a?(Hash) ? parsed.transform_keys { |key| TaskPrSet.bare_repo(key) } : {}
rescue JSON::ParserError
  {}
end

# ── EVERY RECORDED PR'S CI, AND THE ONE THAT GOVERNS ─────────────────────────
#
# The CI half of the same defect. `CiStatus.evaluate(devops["pr_url"], …)` asks ONE
# PR whether the task is green, so on a two-repo task a RED satellite PR could sit
# behind a GREEN hub PR and the merge gate would advance the review — the verdict
# reading, as ever, like it covered the task.
#
# WORST-OF, not first-non-green: see TaskPrSet.governing. The governing entry carries
# its own PR URL because every remedy this gate prints names a repo, and a refusal
# about turf-monster's red CI that tells you to look at turf-vault is the same
# cross-repo confusion in different clothes.
def task_ci_reads
  @task_ci_reads ||= Array(@pr_targets).map do |target|
    { target: target,
      ci: CiStatus.evaluate(target[:url], injected_ci_by_repo.fetch(target[:repo], ENV["DOR_CHECK_CI_STATUS"])) }
  end
end

# The per-repo CI seam, mirroring DOR_CHECK_CI_STATUS: JSON of repo => the same token
# grammar (green/red/pending/…, "state:<novel>", or a raw `gh pr checks --json` array).
def injected_ci_by_repo
  @injected_ci_by_repo ||= parse_repo_seam(ENV["DOR_CHECK_CI_STATUS_BY_REPO"])
end

# [the governing verdict, the PR URL it came from]. With no recorded PR at all this
# is the untouched single-PR call, so a task with a blank pr_url resolves exactly as
# it always has (:no_pr, and the allow-list refuses it review-side).
def task_ci_verdict(devops)
  @task_ci_verdict ||= begin
    reads = task_ci_reads
    if reads.empty?
      [CiStatus.evaluate(devops["pr_url"], ENV["DOR_CHECK_CI_STATUS"]), devops["pr_url"].to_s]
    else
      governing = TaskPrSet.governing(reads)
      [governing[:ci], governing[:target][:url]]
    end
  end
end

# The repo whose CI verdict this run is speaking about — never "whichever URL was
# recorded first".
def governing_ci_pr_url(devops)
  task_ci_verdict(devops).last
end

def read_pr_files(url)
  pr = url.to_s.strip
  return { files: nil, state: :no_pr } if pr.empty?

  # The REST files endpoint, NOT `gh pr view --json files` — that surface exposes
  # only {additions, changeType, deletions, path}, so a RENAME appears as its
  # destination alone and a code→doc rename would read as prose (the bug Shannon
  # caught). REST carries `status` + `previous_filename`, so we can classify BOTH
  # sides. A renamed entry with no previous_filename shouldn't happen per the API
  # contract — if it ever does, the sentinel below has no prose extension, so it
  # classifies as behavioral and the diff GATES. Fail closed by construction.
  owner, repo, number = pr.match(%r{github\.com/([^/]+)/([^/]+)/pull/(\d+)})&.captures
  return { files: nil, state: :no_pr } unless owner

  raw, ok = CiStatus.gh_read_status(
    "api", "--paginate", "repos/#{owner}/#{repo}/pulls/#{number}/files", "--jq",
    '.[] | .filename, (if .status == "renamed" then (.previous_filename // "unknown-rename-source") else empty end)'
  )
  return failed_pr_file_read(raw) unless ok

  files = raw.to_s.split("\n").map(&:strip).reject(&:empty?)
  files.empty? ? { files: nil, state: :empty } : { files: files, state: :ok }
end

# A read that came back non-zero, classified. CiStatus.unreadable_cause is THE
# classifier for "GitHub refused this token" (:credentials / :permissions /
# :authentication / :rate_limit / :forbidden) and it is deliberately NARROW — a 404 or
# a missing gh keeps the :unverified meaning it has always had, because prescribing a
# credential fix for those would be its own species of lie.
def failed_pr_file_read(raw)
  cause = CiStatus.unreadable_cause(raw)
  reason = pr_read_reason(raw)
  return { files: nil, state: :unverified, reason: reason } unless cause

  { files: nil, state: :unreadable, cause: cause, reason: reason }
end

# The SENTENCE out of a failed gh read — the part a human can act on.
#
# NOT `raw.lines.first`, which is what the first cut of this used and what measuring
# it against the live API exposed as useless: `gh api` prints GitHub's JSON error body
# on stdout, so the first line is a bare "{" and the verdict read "REFUSED on
# credentials ({)". GitHub's own `message` is the sentence ("Bad credentials"), so
# take it when it is there. The regex, not JSON.parse: we capture stdout and stderr
# JOINED (that is the whole point — the status line lives on stderr), and a JSON body
# with gh's plain-text line stapled to it does not parse.
def pr_read_reason(raw)
  text = raw.to_s
  message = text[/"message"\s*:\s*"([^"]+)"/, 1]
  return message[0, 140] if message

  # Otherwise the first line with actual content in it — skipping the punctuation-only
  # lines a pretty-printed JSON body opens with.
  text.lines.map(&:strip).find { |line| line.length > 3 }.to_s[0, 140]
end

# The DOR_CHECK_PR_FILES seam. "unreadable" carries an optional raw body after a
# colon so a test can drive the REAL classifier with gh's real wording rather than
# assert against a hand-picked cause.
def injected_pr_file_read(injected)
  token = injected.strip
  return { files: nil, state: :unverified, reason: "injected: unverified" } if token == "unverified"

  if token == "unreadable" || token.start_with?("unreadable:")
    body = token.split(":", 2)[1].to_s.strip
    body = "gh: Bad credentials (HTTP 401)" if body.empty?
    return failed_pr_file_read(body)
  end

  files = injected.split(/[\n,]/).map(&:strip).reject(&:empty?)
  files.empty? ? { files: nil, state: :empty } : { files: files, state: :ok }
end

# DOES THIS ALERT REFUSE THE VERDICT, or merely warn about it? The merge gate in the
# REVIEW role is the only run where a refused PR file-list read is an ERROR; the build
# gate resolves no diff, and submit-side the local view is the honest near-twin of the
# PR, so both keep the loud-but-non-fatal alert. Both printing sites already branched on
# exactly this, and now they read it from one place — a top-level def cannot see the
# `gate` / `review_role` locals, which is the same reason and the same ordering rule
# that put @review_role beside @pr_url (see resolve_branch_diff).
# ...AND ONE STATE REFUSES IN BOTH ROLES. The role asymmetry above is EARNED by the
# builder standing in the PR's own worktree: there the local view is the PR's honest
# near-twin, so the substitution costs integrity nothing and blocking every builder
# whose App token aged past an hour would cost every handoff. That argument does not
# survive a task with a PR in TWO repos — the builder stands in one of them, and no
# tree on this machine is the near-twin of the other. So :incomplete (some recorded PR
# unread; see merge_pr_file_reads) refuses submit-side too, and the single-repo
# builder path is untouched because a one-PR task can never produce that state.
def pr_read_refuses_verdict?
  return false if @build_gate

  @review_role || pr_file_read[:state] == :incomplete
end

# WHY the PR file list is missing, when the reason is a FAILURE the reader must act
# on — nil on :ok / :no_pr / :empty, which are not failures.
#
# A REFUSED READ IS NEVER SILENTLY REPLACED. The gate's subject at the merge boundary
# is the PULL REQUEST; the local tree is a DIFFERENT artifact that merely tends to
# resemble it. Substituting one for the other without a word is how a gate reasons
# confidently about the wrong input.
#
# TWO LENGTHS, ONE FACT. The headline is what rides ON a verdict line that has its own
# job to do; the full alert (headline + THE ONE remedy string) is what lands where the
# reader has been sent to act. They are split because printing CiStatus's ~500-char
# credential remedy twice in one verdict is how a reader learns to skim the paragraph
# we most need them to read — ci_status.rb's own lesson, applied here.
def pr_read_headline
  read = pr_file_read
  case read[:state]
  when :unreadable
    "the PR's file list was REFUSED on credentials (#{read[:reason]}), so this verdict did NOT read the PR"
  when :unverified
    "the PR's file list could not be read (#{read[:reason].to_s.empty? ? "gh failed" : read[:reason]}), " \
      "so this verdict did NOT read the PR"
  when :incomplete
    "this task has #{Array(@pr_targets).size} PRs and #{unread_repo_phrase} could not be read " \
      "(#{read[:reason].to_s.empty? ? "gh failed" : read[:reason]}), so this verdict did NOT read the " \
      "whole task"
  end
end

# WHICH REPOS THIS RUN COULD NOT READ, named. The point of the whole task: a gate that
# grades a subset in silence is the disease, and a gate that grades a subset and SAYS
# WHICH is merely limited. Every refusal below routes through this so the repo name
# cannot go missing from one of them.
def unread_repos
  Array(pr_file_read[:repos_unread]).map { |entry| entry[:repo].to_s }.reject(&:empty?)
end

def unread_repo_phrase
  repos = unread_repos
  return "one of them" if repos.empty?

  "#{repos.size == 1 ? "its" : "their"} #{repos.join(" and ")} PR#{"s" if repos.size > 1}"
end

# The full alert: the headline, what it costs, and the remedy. The caller decides
# whether it lands as an error (review) or a suggestion (submit-side).
#
# NO `cert_route:` ANY MORE. This alert used to forward its callers' route to
# CiStatus.unreadable_remedy — `true` on the gated branches (a full cert could stand
# in for the CI half), `false` on the exempt one (nothing could) — and the split was
# what stopped the exempt path printing a denial and an OFFER in one verdict
# (/tasks/exempt-refusal-prints-dead-remedy). Since /tasks/dor-reads-settled-ci-verdict
# no route offers anything: the suite evidence is the CI verdict itself, so every
# caller gets the same task-grain denial and there is nothing left to forward.
#
# THE CLOSING LINE IS DERIVED FROM WHETHER THIS ALERT REFUSES, and that is a fact about
# the RUN, not about the branch calling in — which is why it is read here rather than
# stated per caller. Both printing sites spell the same predicate
# (`review_role && gate != "build"`): the alert lands as an ERROR in the review role at
# the merge gate and as a SUGGESTION everywhere else, and a suggestion refuses nothing,
# so the sentence operators already know stays true and prints to the BYTE.
def pr_read_alert
  headline = pr_read_headline
  return nil unless headline

  if pr_file_read[:state] == :incomplete
    # NO LOCAL STAND-IN EXISTS FOR THIS ONE, in EITHER role, and that is why it refuses
    # where a single-repo :unreadable only warns. Submit-side the fallback survives on a
    # one-repo task because the builder stands in that repo's own worktree, where the
    # local view is the PR's honest near-twin. On a multi-repo task the builder stands in
    # ONE of the repos; no tree on this machine is the near-twin of the repo they are not
    # standing in, so substituting anything is guaranteed to describe the wrong artifact.
    "#{headline}. A multi-repo task's diff is the UNION of its PRs, and a union missing " \
      "#{unread_repos.empty? ? "a member" : unread_repos.join(" and ")} is not a smaller diff — it is a " \
      "different one. Grading the PRs that DID read would be exactly the defect this gate was fixed for " \
      "(/tasks/dor-check-reads-one-pr): one repo graded, a verdict that reads as covering the task. So the " \
      "shape/test-tier gate is ENFORCED rather than skipped (fail-closed), in BOTH roles. Fix the read " \
      "(#{pr_file_read[:cause] ? "a credential: " : ""}" \
      "#{pr_file_read[:cause] ? "eval \"$(#{GH_AUTH_REFRESH_CMD} --export)\"" : "check the URL recorded in " \
        "devops.pr_urls and re-run"}), then re-run."
  elsif pr_file_read[:state] == :unreadable
    "#{headline}. The diff this gate judges (shape tiers, the doc-only exemption, migration detection) is the " \
      "PULL REQUEST's file list, and a refused read must never be quietly replaced by whatever tree this run is " \
      "standing in. " + CiStatus.unreadable_remedy(CiStatus.repo_from_pr_url(@pr_url),
                                                   cause: pr_file_read[:cause],
                                                   also_refused: pr_read_refuses_verdict? ? [PR_READ_SELF_REFUSAL_PHRASE] : [],
                                                   task: @task_slug)
  else
    "#{headline} — and this is NOT a credential refusal, so the LOCAL view was graded instead. That is a " \
      "different artifact from the PR: if they differ, this verdict describes the wrong diff. Re-run once " \
      "`gh` answers."
  end
end

# The local view: uncommitted (staged/unstaged/untracked — base-independent, so it
# fires on the pre-commit SOP order) UNION the committed view against the
# release-aware base. Returns nil when git can't read the tree at all (no repo).
def git_changed_files
  return @git_changed_files if defined?(@git_changed_files)

  @git_changed_files = compute_git_changed_files
end

def compute_git_changed_files
  root = diff_root
  base = diff_base(root)
  files = []

  # --name-status -M (NOT --name-only): a rename must surface BOTH paths, or a
  # `bin/deploy.sh → docs/deploy-notes.md` rename reads as one prose file and
  # takes an exemption while deleting an executable. See CodeDiff.paths_from_name_status.
  worktree_ok = true
  [
    %w[diff --cached --name-status -M],
    %w[diff --name-status -M]
  ].each do |args|
    out = IO.popen(["git", "-C", root, *args], err: File::NULL, &:read)
    $?.success? ? files.concat(CodeDiff.paths_from_name_status(out)) : (worktree_ok = false)
  end

  # Untracked files have no status line — they are always plain adds.
  untracked = IO.popen(["git", "-C", root, "ls-files", "--others", "--exclude-standard"], err: File::NULL, &:read)
  $?.success? ? files.concat(untracked.to_s.split("\n")) : (worktree_ok = false)

  # Committed view: catches a post-commit run (change already in HEAD). The base
  # may be unfetched on a release-cut branch — best-effort, never fatal.
  committed = IO.popen(["git", "-C", root, "diff", "--name-status", "-M", "#{base}...HEAD"], err: File::NULL, &:read)
  files.concat(CodeDiff.paths_from_name_status(committed)) if $?.success?

  return nil unless worktree_ok

  files.map(&:strip).reject(&:empty?).uniq
rescue SystemCallError
  nil
end

# The committed-diff base for `root`. DOR_CHECK_DIFF_BASE is authoritative when
# set (tests/edge cases); otherwise the default is release-aware.
def diff_base(root)
  ENV.fetch("DOR_CHECK_DIFF_BASE") { default_diff_base(root) }
end

# Release-aware DEFAULT committed-diff base. Post-cutover every repo keeps a
# persistent `release` branch that feature branches cut from and PR into, and
# `accepted` → `release` → `main` each run AHEAD of the next (merged-but-unshipped
# work). So we diff against the first that exists — post-v2, feature branches cut
# from `accepted` — falling back through to origin/main, mirroring
# bin/agent-worktree's base_ref_for. Resolved against `root`
# (DOR_CHECK_DIFF_ROOT) so tests can drive it at a temp repo. Git missing or no
# repo → origin/main, consistent with changed_files' best-effort committed view.
def default_diff_base(root)
  %w[origin/accepted origin/release].each do |ref|
    IO.popen(["git", "-C", root, "rev-parse", "--verify", ref], err: File::NULL, &:read)
    return ref if $?.success?
  end
  "origin/main"
rescue SystemCallError
  "origin/main"
end

# The task's feature branch — devops.branch when set, else feat/<worktree_slug or
# slug>. Feeds the review-role rooting of the control stamp (control_fingerprint) and
# the reviewer-zap seams below, so the reviewer grades the task BRANCH's tree, not the
# primary checkout's. With an empty `devops` it derives feat/<slug> from the slug — a
# fine approximation, since a task branch is feat/<slug> unless explicitly overridden.
def review_branch(devops, slug)
  branch = devops["branch"].to_s.strip
  return branch unless branch.empty?

  base = devops["worktree_slug"].to_s.strip
  base = slug.to_s.strip if base.empty?
  base.empty? ? nil : "feat/#{base}"
end

# The tree hash the REVIEW gate-zero grades the `[control@<fp>]` stamp against —
# the TASK's tree, not the reviewer's cwd: reviewers run --gate-role review from
# the PRIMARY checkout (on release/main by SOP), so fingerprinting the working tree
# there reads a totally different tree and the stamp false-reads STALE
# (the bug the cert lane hit first, from both sides, before the cert lane retired).
# A git tree hash is content-addressed, so the branch's committed ^{tree} equals the
# working-tree fingerprint the builder stamped before pushing. Prefer
# origin/<branch> (what CI graded), fall back to a local <branch>.
#
# Returns { fingerprint:, ref:, root: } — the hash AND the ref expression that
# produced it, in the repo it was resolved in — or nil when the branch isn't
# resolvable locally (unfetched); the caller then falls back to the working-tree
# fingerprint of diff_root. The PROVENANCE rides along because a hash with no
# origin is a number nobody can check.
def review_fingerprint(root, branch)
  return nil if branch.to_s.strip.empty?

  TreeFingerprint.of_first_ref(root, "origin/#{branch}", branch)
end

# The tree hash the `[control@<fp>]` stamp is graded against — resolved ONCE, from
# the same rooting the cert lane used before it retired:
#   * review gate-zero → the task branch's committed tree (review_fingerprint) — the
#     root guard has already re-rooted diff_root at the task's desk where it could;
#   * a builder standing in a foreign root with no desk on disk → the branch tree the
#     root guard resolved (remedy 2, @task_tree_override);
#   * otherwise → the working tree at diff_root, uncommitted edits included.
# nil when no tree can be hashed; control_evidence_status reads that as :missing.
def control_fingerprint
  return @control_fingerprint if defined?(@control_fingerprint)

  @control_fingerprint = begin
    override = nil
    if @review_role
      branch = review_branch(@devops || {}, @task_slug)
      override = review_fingerprint(diff_root, branch)
    end
    override ||= @task_tree_override
    override ? override[:fingerprint] : TreeFingerprint.working_tree(diff_root)
  end
end

# The REPO the PR under gate lives in, OWNER-QUALIFIED ("McRitchie-Studio/turf-monster")
# — the one fact on the task that says which repo a verdict is about. A multi-repo task
# has a worktree per repo under the same slug, so this is what turns "some worktree
# named <slug>" into "the task's tree for THIS PR". "" when there is no PR yet (the
# builder's pre-PR run) or the URL isn't a GitHub PR; the caller then refuses to pick
# rather than inventing one.
#
# The OWNER rides along deliberately: TaskTree compares it against a checkout's
# `origin`, and a bare repo name would let a FORK — someone else's account, same repo
# name — validate as this PR's tree. Where only a directory name is available the guard
# degrades to the bare name on its own; that choice belongs to the guard, not here.
def pr_repo_name(pr_url)
  CiStatus.repo_from_pr_url(pr_url).to_s
end

# The files a RELEASE owns and a PR must never edit, drawn from the gem registry so
# a newly-onboarded gem is covered the day it is registered rather than whenever
# someone remembers to update a hardcoded list. Matched on the registry's own
# `version_file` path plus the changelog beside it.
#
# Returns [] for a non-gem repo (an app's version file, if it had one, is nobody's
# publish input) and [] when the registry cannot be read — a gate that cannot read
# its own config must not invent a refusal.
# THE VERSION ONLY — the changelog is deliberately NOT here yet.
#
# An earlier pass refused root `CHANGELOG.md` too, on the strength of a message
# promising "the release assembles the changelog from its members". A reviewer
# grepped for that assembler and there ISN'T ONE. The version has a working manual
# path (the conductor commits it onto the gem's `accepted`, which the promote
# carries) — the changelog would have had NO writer and NO documented manual path,
# so the file becomes permanently un-editable through the cycle. Refusing an edit to
# a file nothing else maintains is not ownership, it is a dead end.
#
# The changelog half re-enters WITH its assembler, not before (finding-d0621629719b).
#
# Exact registered paths only. Basename matching looked equivalent and was not: CI
# vendors dependencies into the tree, so `vendor/bundle/**/CHANGELOG.md` matched
# sixty-odd third-party changelogs and refused unrelated PRs — it passed locally
# because a dev tree has no vendor/bundle.
def release_owned_gem_files(files)
  owned = gem_version_files
  return [] if owned.empty?

  Array(files).select { |f| owned.include?(f.to_s) }.uniq
end

# Every registered gem's `version_file`, from config/release_repos.yml.
def gem_version_files
  return @gem_version_files if defined?(@gem_version_files)

  @gem_version_files = begin
    require "yaml"
    path = File.expand_path("../config/release_repos.yml", __dir__)
    doc = File.exist?(path) ? (YAML.safe_load_file(path) || {}) : {}
    repos = doc["repos"] || doc["gems"] || doc
    values = []
    walk = lambda do |node|
      case node
      when Hash
        values << node["version_file"].to_s if node["version_file"]
        node.each_value { |v| walk.call(v) }
      when Array then node.each { |v| walk.call(v) }
      end
    end
    walk.call(repos)
    values.reject(&:empty?).uniq
  rescue StandardError
    []
  end
end

# The subset of changed files that ships BEHAVIOR (CodeDiff's type-only rule:
# everything that isn't provably prose or inert media). Empty == doc-only.
def code_changed_files
  CodeDiff.code_files(changed_files)
end

# The subset of changed files that ship a seed or a data-migration (under
# DATA_CHANGE_PREFIXES) — the diff that should declare a post-deploy command so
# the conductor runs it on ship instead of someone running the rake by hand.
def data_changed_files
  changed_files.select { |f| DATA_CHANGE_PREFIXES.any? { |prefix| f.start_with?(prefix) } }
end

# ==== The browser-evidence gate's inputs ======================================
#
# ClientSurfaceDiff needs more than a path list: the BLOCKING half asks whether a
# hunk INTRODUCED something the browser runs, which is a question about lines. The
# path-only views above cannot answer it, so this reads the diff text.
#
# WHY THE LINE GRANULARITY HERE, HAVING BEEN REFUSED IN CodeDiff. CodeDiff settles
# on the FILE because it is deciding whether a change may SKIP the gate, and a
# hunk-level "this is only comments" inference is one an author can talk it out of.
# This helper feeds the opposite decision — whether to demand MORE — where the
# file granularity is what over-refuses (it would block a copy fix in any partial
# that happens to carry a <script>). The asymmetry is the same one that sets this
# module's polarity: a wrong "yes" here costs an honest builder a false refusal.
#
# UNREADABLE => {} => the added-surface set is EMPTY => the gate REPORTS instead of
# blocking. That is the deliberate direction. A checkout that cannot show us its
# hunks has not shown us new browser code, and refusing on a read failure would
# block correct work for an infrastructure fact. The present-surface REPORT still
# fires off the path list, so the finding never disappears — it only loses its
# teeth, which is the same shape as control_replayable_files' fail-open.
def client_base_contents(paths)
  root = diff_root
  base = diff_base(root)
  templates = Array(paths).select { |p| ClientSurfaceDiff.template?(p) }
  return {} if templates.empty?

  templates.each_with_object({}) do |path, acc|
    out = IO.popen(["git", "-C", root, "show", "#{base}:#{path}"], err: File::NULL, &:read)
    # A file with no version at `base` is NEW; "" is the correct base content for
    # it, and it is also the fail-open answer when git cannot show us the old side
    # — an unreadable base makes every construct look new, which REPORTS a surface
    # rather than inventing a clean one.
    acc[path] = $?.success? ? out.to_s : ""
  end
rescue SystemCallError, IOError
  {}
end

# Current content of the changed paths matching `filter`, read from the task's own
# tree. Feeds the PRESENT-surface report and the quarantine read on changed specs.
def client_file_contents(paths, &filter)
  root = diff_root
  Array(paths).select(&filter).each_with_object({}) do |path, acc|
    full = File.join(root.to_s, path)
    acc[path] = File.read(full) if File.file?(full)
  end
rescue SystemCallError, IOError
  {}
end

# The gem-publish seam (merge gate). When this branch touched the Gemfile, every
# versioned `gem "name", "constraint"` whose constraint the Gemfile.lock CANNOT
# satisfy — i.e. the Gemfile was bumped to a version the lock (and almost
# certainly RubyGems) doesn't have yet. That is exactly the state that turned
# mcritchie#157 CI fully red (a frozen/deployment `bundle install` can't resolve
# an unpublished gem) and got it blocked in review: a shared-gem feature (engine
# model + app consumer) whose consumer constraint was bumped BEFORE the gem
# published. Deterministic + OFFLINE — Gemfile vs Gemfile.lock only, no RubyGems
# call (fits the gate's no-network ethos). git/path sources (the local-dev bridge)
# don't match the `name, "version"` shape, so they're never flagged. Returns
# [{name, constraint, locked}].

# The gem guard READS Gemfile/Gemfile.lock CONTENT from diff_root, so its trigger
# must come from that SAME tree — not from the PR's file list. When the diff was
# resolved from the PR (:pr) the caller may be standing anywhere (a reviewer's
# gate-zero runs from a primary checkout whose Gemfile/lock are release's own
# self-consistent pair): "the PR touched Gemfile" + "the primary's Gemfile" is a
# comparison of two unrelated trees — it can never fire truthfully, and could fire
# on the REVIEWER's dirty Gemfile. The builder's submit run is unaffected: their
# worktree IS the branch's tree, so the local view sees the Gemfile.
#
# An UNTRUSTED root closes the same door from the other side: there the local view
# is a foreign checkout's, so its Gemfile/Gemfile.lock pair is not this task's at
# all — comparing them could only ever report someone else's mid-bump state as this
# task's blocker. No local view, no trigger.
def local_diff_files
  @local_diff_files ||= if diff_source == :injected
    changed_files
  elsif untrusted_root?
    []
  else
    git_changed_files || []
  end
end

def gem_constraint_violations
  return [] unless local_diff_files.include?("Gemfile")

  root = diff_root
  gemfile = File.join(root, "Gemfile")
  lockfile = File.join(root, "Gemfile.lock")
  return [] unless File.exist?(gemfile) && File.exist?(lockfile)

  lock_text = File.read(lockfile)
  File.read(gemfile).each_line.each_with_object([]) do |line, violations|
    m = line.match(/^\s*gem\s+["']([A-Za-z0-9_.\-]+)["']\s*,\s*["']([^"':]+)["']/)
    next unless m

    name = m[1]
    constraint = m[2].strip
    locked = lock_text[/^\s{4}#{Regexp.escape(name)} \(([^)]+)\)/, 1]
    next unless locked # only gems pinned in the lock (skip git/path/new gems)

    req = (Gem::Requirement.new(constraint) rescue nil)
    next if req.nil? || req.satisfied_by?(Gem::Version.new(locked))

    violations << { "name" => name, "constraint" => constraint, "locked" => locked }
  end
end

# True when a post_deploy_cmd is a bare full-suite seed (db:seed / db:seed:replant
# / rake db:seed / bundle exec rails db:seed), which loads ALL of db/seeds.rb. The
# safe forms — a scoped runner (`rails runner 'load …db/seeds/NN.rb…'`) and a
# dedicated rake task (`pokemon:seed`) — do NOT match (no `db:seed` colon-token).
def bare_full_suite_seed?(cmd)
  BARE_SEED_TASK.match?(cmd.to_s)
end

# ── THE ONE TRIGGER FACT, IN ONE PLACE (/tasks/audit-vanishes-when-git-fails) ────
#
# .github/workflows/ci.yml, `push: branches:`. `accepted` joined that list on 2026-08-14
# (ecd0ffe8), and the gate's reviewer-facing text spent a while asserting otherwise.
#
# IT IS A LIST, NOT A SENTENCE, because the sentence has TWO false forms and naming only
# the first is how the second gets written. "ci.yml runs on main/release only" was the
# retracted claim; "ci.yml DOES run on pushes to `feat/parent`" is its MIRROR IMAGE, and
# it is what blind interpolation of the PR's base into that sentence produces on a
# stacked PR. Both are disprovable in one `sed -n 26,27p .github/workflows/ci.yml`, and a
# gate whose text a reviewer can disprove is a gate they learn to route around.
#
# test/lib/dor_check_stale_ci_test.rb pins this list against ci.yml ITSELF, so a trigger
# added or removed there cannot leave this copy stale in silence.
CI_PUSH_BRANCHES = %w[main release accepted].freeze

# Which argument the staleness refusal is entitled to make about the base it just named.
# On a ladder branch a run for that merge EXISTS and the point is that it graded the
# wrong tree; on a stacked feature base no such run exists at all. Same verdict, two
# different true sentences — and the reviewer is sent looking for a run in only one.
def stale_base_run_clause(base_branch)
  if CI_PUSH_BRANCHES.include?(base_branch)
    "ci.yml DOES run on pushes to `#{base_branch}`, so a run for that merge exists — but it graded the " \
      "`#{base_branch}` TIP, which is a tree this PR is not in, and nothing re-ran THIS PR against the " \
      "moved base."
  else
    "`#{base_branch}` is not one of ci.yml's push branches (#{CI_PUSH_BRANCHES.join(', ')}), so no run " \
      "exists for that merge at all — and nothing re-ran THIS PR against the moved base either."
  end
end

# ── THE STALE-GREEN VOCABULARY (/tasks/gate-credits-a-stale-green) ───────────────
#
# Two message builders for one finding, split by SEVERITY rather than by subject,
# because the severity IS the design: naming the movement is what every reviewer gets,
# refusing is what the one unsettleable shape gets.

# How many of each to name before trailing off. A verdict nobody finishes reading is a
# verdict nobody acts on, and the point of these lines is that the reviewer can check
# them by hand.
BASE_MOVE_NAME_CAP = 4

def base_move_list(items, cap: BASE_MOVE_NAME_CAP)
  shown = items.first(cap)
  rest = items.size - shown.size
  "#{shown.join(', ')}#{rest.positive? ? " (+#{rest} more)" : ''}"
end

# PART A — NAME WHAT MOVED, always, on every reported movement.
#
# The original report gave a tip SHA and a count, which a reviewer can do nothing with
# except go look. Naming the commits and the files is what lets the FILE-DISJOINTNESS
# argument be made FROM the verdict instead of by hand — and lets its limits be stated
# in the same breath, which is the only place a reader will meet them.
#
# The clock clause has THREE outcomes and they are not interchangeable. "Covered",
# "not covered", and "could not ask" are three different sentences, and printing the
# third as either of the others is this task's own defect one level down.
def base_movement_detail(movement, base_branch, ambiguous_clock: false)
  return "" unless movement.is_a?(Hash) && movement[:state] == :moved

  named = movement[:commits].map { |c| "#{c[:sha][0, 12]} #{c[:at]} #{c[:subject]}" }
  detail = +" WHAT MOVED: #{base_move_list(named)}. FILES: #{base_move_list(movement[:files])}."

  case movement[:clock]
  when :unreadable
    detail << if ambiguous_clock
                " COULD NOT compare that against this PR's CI clock — this task carries MORE THAN ONE PR, " \
                  "so the governing CI verdict may belong to a different repo than the tree measured here, " \
                  "and a foreign run's clock is not evidence about this base."
              else
                " COULD NOT compare that against this PR's CI clock — the checks read carry no completedAt, " \
                  "so \"did the run finish BEFORE this landed?\" went UNASKED."
              end
    detail << " That is not a freshness certificate; absence of a finding here means the question was not " \
      "answerable, not that the answer was yes."
  else
    if movement[:late].empty?
      detail << if movement[:clock] == :merge_ref
                  # By CONTENT, not ancestry: a back-merge can land commits the tested base is not
                  # an ancestor of while changing no file it lacks (D1) — true in both cases.
                  " Everything it changed is already in the tree this PR's CI tested — its merge ref " \
                    "was built on #{movement[:tested_base][0, 12]} — so the run did cover this tree."
                else
                  " All of it predates this PR's CI completion (#{movement[:cutoff].iso8601}) — which bounds " \
                    "what the run saw from ABOVE and does not show it covered this tree."
                end
    else
      detail << " #{movement[:late].size} of those #{late_clause(movement)}. ci.yml DOES run on pushes to " \
        "`#{base_branch}` — do not expect to " \
        "find no run — but that run graded the `#{base_branch}` TIP, a tree this PR is not in, and nothing " \
        "re-runs THIS PR against the moved base: the green never saw " \
        "#{base_move_list(movement[:late_files])}."
      # zap (carl, review of this PR): the disjointness sentence used to be UNCONDITIONAL, so on the
      # refusing shape this report asserted "None of those is a test that grades a file this PR
      # changes" in the same verdict where the refusal named exactly such a test. Two opposite claims
      # about one file, and the false one handed the reader the very argument the refusal exists to
      # refute. Asserting a negative this branch never checked is the defect the module's own header
      # forbids (bin/lib/base_movement_audit.rb, "DIRECTION OF ERROR"), one level down.
      detail << if movement[:guards].empty?
                  " None of those is a test that grades a file this PR changes, so FILE DISJOINTNESS is " \
                    "available here — but note what it does and does not say: \"the base touched none of my " \
                    "files\" is a DIFFERENT claim from \"the merged tree is green\", and it is the merged " \
                    "tree that ships."
                else
                  " FILE DISJOINTNESS IS NOT AVAILABLE HERE: " \
                    "#{base_move_list(movement[:guards].map { |g| g[:test] })} grades code this PR changes " \
                    "without being a file this PR touches. The refusal above carries the full finding."
                end
    end
    detail << window_unchecked_sentence(movement) if movement[:window] == :unchecked
  end
  detail
end

# The one phrase that differs between the two clocks, so the verdict names the evidence
# that actually answered: ancestry against the tested base, or the completion lower bound.
def late_clause(movement)
  if movement[:clock] == :merge_ref
    "are NOT in the base this PR's CI tested (its merge ref was built on #{movement[:tested_base][0, 12]})"
  else
    "landed AFTER this PR's CI completed (#{movement[:cutoff].iso8601})"
  end
end

# SAY SO, never substitute (/tasks/stale-merge-ref-passes-freshness). When the base the
# tested merge ref was built on could not be resolved, the completion clock above is a
# LOWER bound: what it flags is real, but a base commit that landed after GitHub built
# the merge ref and before the run ended reads as covered. That is the hole, so it is
# declared every time it is open rather than left for a reviewer to know about.
def window_unchecked_sentence(movement)
  cause = if movement[:window_reason] == :not_local && movement[:tested_base]
            # S1: GitHub DID resolve it — only this checkout lacks the commit, and that one has
            # a remedy. "Could not be resolved" would be false here.
            "this PR's merge ref was built on #{movement[:tested_base][0, 12]}, which is not in this " \
              "checkout — run `git fetch origin` and re-check."
          else
            "the base this PR's merge ref was built on could not be resolved " \
              "(#{MergeRefBase.reason_text(movement[:window_reason])}), so a base commit that landed after " \
              "GitHub built that ref but before the run finished would read as covered here."
          end
  " THE MID-RUN WINDOW WENT UNCHECKED: #{cause} Not a freshness certificate."
end

# PART B — THE REFUSAL, for the one shape disjointness cannot settle.
#
# Everything a reviewer needs to re-derive the finding by hand is named: the commit, its
# clock, the run's clock, the guard file, and the file of THIS PR that the guard grades.
# A refusal whose evidence the reader cannot check is a refusal they learn to route
# around, and this gate is gate-zero for every review.
def stale_green_refusal(movement, base_branch)
  guards = movement[:guards]
  pairs = guards.map { |g| "#{g[:test]} (grades #{g[:guarding].join(', ')})" }
  culprits = movement[:late].map { |c| "#{c[:sha][0, 12]} at #{c[:at]} \"#{c[:subject]}\"" }

  "GitHub CI is GREEN but it COULD NOT HAVE COVERED this merge — origin/#{base_branch} gained " \
    "#{base_move_list(culprits)} that #{stale_green_clause(movement, base_branch)}. ci.yml DOES " \
    "run on pushes to `#{base_branch}`, so you WILL find a run for that merge — it graded the " \
    "`#{base_branch}` TIP, which is a tree this PR is not in. Nothing re-ran THIS PR against the moved " \
    "base, and that combination is what ships. What landed is " \
    "not incidental to this PR: #{base_move_list(pairs)} — a TEST THAT GRADES code this PR changes, and one " \
    "this PR does not itself touch. FILE DISJOINTNESS DOES NOT SETTLE THIS, and it is the argument to reach " \
    "for here: \"the base commits touch none of my files\" is TRUE and IRRELEVANT in this exact shape, " \
    "because it is a claim about SOURCE overlap while the thing that moved is the GUARD. The two are " \
    "different sentences and only one of them is \"the merged tree is green\". Settle it by building the " \
    "merge preview and running that family (git merge-tree the PR head against origin/#{base_branch}, check " \
    "the result out, run the named tests), or update the branch (git rebase origin/#{base_branch}) and let " \
    "CI re-run — then re-check. No local test run clears this: it grades the desk tree, which is not " \
    "the merged tree either."
end

def stale_green_clause(movement, base_branch)
  return "landed AFTER this PR's CI completed at #{movement[:cutoff].iso8601}" unless movement[:clock] == :merge_ref

  # D2 (/tasks/freshness-verdict-states-falsehoods): claim a completion clock "would have called
  # them covered" ONLY for the commits that landed at or before completion. A commit after it is
  # one that clock would have CAUGHT, and saying otherwise is disprovable from two printed times.
  blind = movement[:completion_blind].to_i
  ran = if movement[:cutoff] && blind.positive?
          " — #{blind} of #{movement[:late].size} landed before the run completed at " \
            "#{movement[:cutoff].iso8601}, so a completion clock would have called #{blind == 1 ? 'it' : 'them'} covered"
        else
          ""
        end
  "are NOT in the base this PR's CI tested: its merge ref was built on " \
    "origin/#{base_branch}@#{movement[:tested_base][0, 12]}#{ran}"
end

# PART C — THE AUDIT THAT COULD NOT RUN (/tasks/audit-vanishes-when-git-fails).
#
# `assess` answers :unobservable from FOUR paths (:no_ref, :no_merge_base, :no_log,
# :git_unreadable) and, until this, NOTHING outside the module consumed it. A failed git
# read therefore made gate-zero's deepest check report nothing at all, and the review
# proceeded exactly as though the base had not moved. A check that silently does not run
# is the defect class this entire seam exists to close — it had reappeared INSIDE the
# check, which is the one place nothing else was watching.
#
# IT REPORTS AND NEVER REFUSES, and that is the module's stated contract rather than
# timidity. Its header ("DIRECTION OF ERROR") already fixes the caller's half: an
# unreadable input resolves to "the question could not be asked", and the caller reports
# the unmade check rather than refusing on it. Three reasons that is the right call here:
#
#   * :no_ref is reachable on ANY checkout lacking origin/<base>, and THIS GATE NEVER
#     FETCHES — deliberately, because a fetch inside a verdict mutates the tree it is
#     grading. Refusing would wedge gate-zero on a condition the gate itself creates.
#   * The error direction is already safe. An unobservable audit under-reports movement;
#     it cannot invent a green. Silence was the whole defect, and strictness would be a
#     second one pointing the other way — not a stricter fix.
#   * A gate that refuses correct work over a transient git read is a gate reviewers
#     learn to route around, which costs more than the silence it would buy.
#
# THE REASON IS NAMED because the four have genuinely different next actions, and a
# report whose remedy the reader cannot derive is the tip-SHA-and-count report this seam
# was built to replace.
BASE_AUDIT_UNREADABLE = {
  no_ref: "no local ref for origin/%<base>s or origin/%<branch>s in %<root>s — and this gate never " \
          "fetches, by design, so nothing upstream of you will repair it: run " \
          "`git fetch origin %<base>s %<branch>s` in that checkout and re-run",
  no_merge_base: "%<branch>s and origin/%<base>s both resolve in %<root>s and share no common ancestor " \
                 "— a shallow clone (`git fetch --unshallow`) or a base this branch never forked from",
  no_log: "`git log` over the commits origin/%<base>s gained returned nothing readable in %<root>s",
  git_unreadable: "git itself could not be read in %<root>s"
}.freeze

def base_audit_unobservable(movement, base_branch, branch, root)
  reason = movement[:reason]
  template = BASE_AUDIT_UNREADABLE[reason]
  detail = if template
             format(template, base: base_branch, branch: branch.to_s, root: root.to_s)
           else
             "a git read failed in #{root}"
           end

  "the BASE-MOVEMENT AUDIT COULD NOT RUN (#{reason || 'unknown'}) — #{detail}. So the question it exists " \
    "to ask — did origin/#{base_branch} gain anything AFTER this PR's CI finished, and does any of it " \
    "GRADE code this PR changes? — went UNASKED for this verdict. THAT IS NOT A FRESHNESS CERTIFICATE: " \
    "the absence of a finding here means the audit could not look, not that it looked and found nothing. " \
    "Nothing refuses on this — the check fails toward the status quo, and blocking on an unfetched ref " \
    "would wedge every review on a condition this gate creates by never fetching — but the SHARED-GUARD " \
    "shape it catches is UNGUARDED for this verdict: a base commit that changes a TEST grading this PR's " \
    "code, which FILE DISJOINTNESS is true and irrelevant about. Settle it by hand before merging — fix " \
    "the read above and re-run, or build the merge preview (git merge-tree this PR's head against " \
    "origin/#{base_branch}) and run the tests that grade your changed files."
end

# --- DoR gate-run emit (durable GateRun markers) ----------------------------
# A REAL merge-gate verdict is the Definition-of-Ready gate — its OWN gate now,
# distinct from the retired G1 cert. The builder's run
# opens+closes the `dor` gate; the primary reviewer's gate-zero (--gate-role
# review) opens+closes `dor_review` (was: a sop appended to G2a — the review
# supervisor still owns the G2a/G2b review-lane closes). Both carry the verdict
# evidence as sops. Skipped for --json (the heartbeat monitor polls read-only),
# --file (offline/test evaluation), and the build gate (no DoR verdict yet).
# Fire-and-forget: a board blip never changes the verdict or the exit code.
def emit_gate_verdict(slug, ready, role, sops)
  key = role == "review" ? "dor_review" : "dor"
  system(GATE_BIN, "open", "task", slug, key, out: File::NULL, err: File::NULL)
  close = ["close", "task", slug, key, ready ? "--success" : "--failed"]
  sops.each { |entry| close += ["--sop-json", JSON.generate(entry)] }
  system(GATE_BIN, *close, out: File::NULL, err: File::NULL)
rescue StandardError
  nil
end

# May this run write a durable GateRun attempt? Skipped for --json (the heartbeat
# monitor polls read-only), for the build gate (no DoR verdict yet), and for a
# task with no slug. --file is offline evaluation and skips too — UNLESS the gate
# CLI itself has been redirected (DOR_CHECK_GATE_BIN), which is how a test asserts
# the attempt was recorded without a board.
def gate_emission_enabled?(options, gate, slug)
  return false if options[:json]
  return false if gate == "build"
  return false if slug.to_s.empty?

  options[:file].nil? || GATE_BIN_OVERRIDDEN
end


# The FRAGILE post_deploy_cmd shape: a rails runner that LOADs a seed file via
# `Rails.root.join(...)`, e.g. `bin/rails runner "load Rails.root.join(%q(db/
# seeds/54.rb)).to_s"`. It WORKS, but its parens + quotes are exactly what made
# the `heroku run` round-trip brittle (the seed-54 ship-blocker): bin/release's
# conductor interpolates this command and heroku's remote re-quoting choked on
# the `(`. `rails runner` accepts a FILE PATH directly, so the paren-free
# `runner <path>` form is canonical and robust. This is a SUGGESTION matcher
# only — the command stays valid; we never reject it on this basis.
FRAGILE_RUNNER_LOAD = %r{runner\s+['"]?\s*load\s+Rails\.root\.join\(}i

def fragile_runner_load?(cmd)
  FRAGILE_RUNNER_LOAD.match?(cmd.to_s)
end

# Best-effort: the seed path inside `Rails.root.join(...)`, so the suggestion can
# show the exact canonical command. Pulls each quoted / %q() segment AFTER the
# `Rails.root.join` token and joins them with `/` (handles a single "a/b.rb" arg
# AND a multi-segment join("a", "b", "c.rb")). nil when nothing extractable, so
# the caller falls back to a generic `<path>` placeholder.
def canonical_runner_path(cmd)
  after = cmd.to_s.split("Rails.root.join", 2)[1].to_s
  segs = after.scan(/%q[(\[{<]([^)\]}>]+)[)\]}>]|"([^"]+)"|'([^']+)'/).map { |m| m.compact.first }
  segs.empty? ? nil : segs.join("/")
end

# Resolver/debug seam: print the committed-diff base this repo would diff against
# and exit, before any task fetch. Honors DOR_CHECK_DIFF_ROOT/_BASE like changed_files.
if options[:diff_base]
  puts diff_base(diff_root)
  exit 0
end

slug = ARGV.shift
config = YAML.load_file(CONFIG_PATH)
shapes = config.fetch("shapes")
defaults = config.fetch("defaults", {})

gate = options[:gate]
boundary = gate == "build" ? "designed → building" : "submitted → reviewed"
gate_label = gate == "build" ? "DoR-to-Build" : "DoR-to-Merge"

task = load_task(slug, options[:file])
devops = task.dig("metadata", "devops") || {}
shape = devops["shape"].to_s.strip
shape_def = shapes[shape]
kind = devops["kind"].to_s.strip.downcase
review_role = options[:gate_role] == "review"
# Feeds the :pr diff source (resolve_branch_diff). Set BEFORE the first
# changed_files call below, which memoizes the resolution.
@pr_url = devops["pr_url"]
# ...and so do the TASK'S PRs, ALL of them. devops.pr_url is one PR; a task can have
# one per repo, recorded in the devops.pr_urls register, and reading only the singular
# is the defect this list closes: on a two-repo task the gate graded ONE repo's PR and
# printed a verdict that read as though it covered the task. Same reason, same place,
# same ordering rule — compute_pr_file_read and task_ci_reads are top-level defs and
# cannot see the local above. See bin/lib/task_pr_set.rb for the measurement.
@pr_targets = TaskPrSet.targets(devops)
# ...and so does the ROLE: a credential-refused PR read fails closed in the review
# role and degrades (loudly) submit-side, and resolve_branch_diff is a top-level def,
# which cannot see the local above. Same reason, same place, same ordering rule.
@review_role = review_role
# ...and so does the GATE, for pr_read_refuses_verdict?: the PR-read alert only REFUSES
# at the merge gate, and its closing line has to know that before it can name what is
# refusing. Same reason, same place, same ordering rule.
@build_gate = gate == "build"
# ...and so does the SLUG, for the task-naming remedies the PR-read alert prints —
# it used to name the literal `<task>` because pr_read_alert is a top-level def and
# could not see the local (/tasks/builder-reads-remedy-twice). Same reason, same
# place, same ordering rule.
@task_slug = task["slug"] || slug
# ...and the devops hash itself, for the control stamp's branch resolution.
@devops = devops

# --- task-root guard (bin/lib/task_tree.rb) ------------------------------------
#
# EVERY check below describes SOME tree. diff_root decides which one, so diff_root
# MUST BE the task's tree. It wasn't, and nothing checked. THE FIRST HALF (2026-07-14)
# was the cert fingerprint this gate used to grade: run `bin/dor-check <task>` from
# the hub PRIMARY for a task whose code lived in a worktree and it hashed the
# PRIMARY's tree, which is CONTENT-ADDRESSED and could never equal the tree the
# builder certified, so a perfectly fresh cert read "STALE (certified for older
# code)" — 6 of 6 tasks in one day, and an agent that hits an unexplainable STALE
# stops. That lane retired with the receipts (/tasks/dor-reads-settled-ci-verdict);
# the `test-only` control stamp still takes the same rooting (control_fingerprint),
# and the guard already EXISTED for exactly this in both cert runners.
#
# THE SECOND HALF, 2026-08-08 (task dor-check-review-rooting). The 07-14 fix rooted
# the FINGERPRINT and stopped at the builder lane, on the reasoning quoted below
# that review "already roots at the branch tree … it is not the broken lane". That
# was true of the fingerprint and false of the DIFF, which never re-rooted at all —
# and the SOP walks reviewers straight into it: pr-review-primary.md's Entry says
# `cd /Users/alex/projects/mcritchie-studio`, a later step says run this gate, and
# nothing pins either to the task's tree. Observed verbatim, on a multi-file code PR:
#
#   ✓ DoR-to-Merge n/a … doc-only diff (kind: chore): 1 file(s), none behavioral —
#     docs/agents/maintenance/delete-later.md [source: git working tree]
#     → ready to advance submitted → reviewed
#
# One unrelated dirty file on the PRIMARY's `main`, read as the PR's entire diff,
# earning the chore exemption on evidence. Note the direction: a foreign FINGERPRINT
# can only produce a false STALE — loud, and it self-corrects because nobody accepts
# an unexplained refusal. A foreign DIFF produces a false PASS in the gate whose
# entire job is refusing under-tested work, it looks exactly like a real verdict, and
# the dirtier the checkout the more confidently it lies. Every reviewer in that
# night's cycle had to be told by hand to pass DOR_CHECK_DIFF_ROOT — which is the
# tell that the tool, not the reviewer, was wrong. So the guard now runs in BOTH
# roles and roots the DIFF as well as the fingerprint.
#
# REFUSE vs RESOLVE. The cert writers REFUSE, and must: they stamp evidence about
# the tree they stand in, so a chdir could green-cert a stale worktree while the
# operator's real edits sat untested where they ran from. dor-check WRITES NO
# EVIDENCE — it reads a diff and a CI verdict — so re-rooting can forge nothing.
# It can only make the gate judge the RIGHT code. So dor-check RESOLVES. But
# task_tree.rb is explicit that a SILENT chdir is its own hazard, and it is
# right: a gate that quietly judges a different tree than the one you are looking at
# is how you end up arguing with a verdict instead of reading it. Every re-root
# below therefore ANNOUNCES itself on stderr, naming both roots.
#
# Remedies, in order, once the root is found foreign:
#   1. the task's worktree is ON DISK and UNAMBIGUOUS → re-root the whole gate there
#      (the diff, and the control stamp's tree). Its working tree is exactly what the
#      builder pushed, uncommitted edits included.
#   2. else its BRANCH resolves in this repo → root the DIFF at that branch's
#      committed diff (and the control stamp at that branch's committed tree). Both
#      are content-addressed, so neither depends on what the caller's checkout
#      happens to be carrying. This is the mechanism --gate-role review has used
#      since the reviewers hit this from the other side.
#   3. else → no tree here can honestly show this task's code. The diff resolves
#      :indeterminate, which the exempt-kind and claimable_when gates treat as
#      fail-closed. NEVER read the local tree.
#
# AMBIGUITY IS ALSO A REFUSAL. The worktree glob spans every app, so a MULTI-REPO
# task matches once per repo (live today: repair-moms-app-ci under BOTH moms-app and
# studio-engine). Picking the alphabetical first answers "which repo is this?" with a
# coin flip, and re-rooting onto the wrong repo re-creates the exact bug one door
# over. devops.pr_url names the repo actually under gate, so it breaks the tie; when
# it can't — a blank pr_url, or one naming a repo with no worktree here — this
# refuses to guess rather than picking. (A task can carry several repos and several
# rungs: nothing here assumes one repo, and the diff base stays the per-root,
# release-aware default, so a repo with no `accepted` still resolves its own base.)
#
# Scope — the MERGE gate, BOTH roles, with a positional slug and an IMPLICIT root.
# Deliberately NOT:
#   * --gate build — the task is at `designed`. No code, no branch, no worktree yet;
#     there is no tree to root at, and nothing that reads one.
#   * DOR_CHECK_DIFF_ROOT — an EXPLICIT declaration by the caller (the CI/test seam,
#     and the documented manual reviewer workaround). It bypasses the guard exactly
#     as FAST_CHECK_ROOT / FULL_SUITE_ROOT do for the cert writers.
#   * --file without DOR_CHECK_PROJECTS_DIR — the offline seam has no board and no
#     on-disk tree relationship to assert (no production caller passes --file).
foreign_root = nil
task_tree_override = nil
if gate != "build" && !slug.to_s.strip.empty? &&
   ENV["DOR_CHECK_DIFF_ROOT"].to_s.strip.empty? &&
   (options[:file].nil? || !PROJECTS_DIR.to_s.strip.empty?)
  foreign_root = TaskTree.assess(
    task_bin: TASK_BIN, slug: task["slug"] || slug, root: diff_root, devops: devops,
    projects_dir: PROJECTS_DIR, prefer_repo: pr_repo_name(@pr_url)
  )
end

if foreign_root
  standing = diff_root
  standing_branch = foreign_root[:actual_branch] || "unknown"
  # The branch is what remedies 2/3 read, and what the refusals must name, so it is
  # recorded whichever way this goes.
  @task_branch = foreign_root[:expected_branch]
  candidates = Array(foreign_root[:candidate_roots])
  rejected = Array(foreign_root[:rejected_roots])
  eligible = Array(foreign_root[:eligible_roots])
  # VALIDATED on both axes by the guard (repo when known, branch always), and nil
  # unless exactly one candidate qualified. The first cut of this fix trusted a
  # candidate for its DIRECTORY NAME and only asked about the repo when there were
  # two of them — which let a lone worktree from another repo (B1) and a stale desk
  # that never carried the branch (B2) each re-open the false pass one hop
  # downstream. `picked` is now a fact about the destination, not a guess.
  picked = foreign_root[:resolved_root]
  ambiguous = eligible.size > 1

  if picked
    warn!("⚠ dor-check: RE-ROOTING. You are standing in #{standing} (branch #{standing_branch}), which is " \
          "NOT #{slug}'s tree — every check below would have described the wrong code. The DIFF would have " \
          "been THIS checkout's working tree, so one unrelated dirty .md here can hand a multi-file code PR a " \
          "doc-only exemption. Re-rooted at the task's worktree: #{picked}. dor-check READS and never " \
          "writes, so it re-roots rather than refusing — but it will not do it silently: the verdict below " \
          "is about THAT tree, not the one you are in.")
    @diff_root = picked
    foreign_root = nil # the root IS the task's tree now
  else
    # Remedies 2/3. The local working tree stays OFF LIMITS as a diff source from
    # here on — that is the false-PASS vector, and it is closed by construction
    # rather than by every downstream reader remembering to ask.
    @untrusted_root = true
    # Kept for the fail-closed verdict text: `errors` is the machine-readable
    # channel, and a --json consumer never sees the stderr banners below.
    @rejected_roots = rejected
    # Can this checkout's REFS vouch for anything? Only if it is the right repo.
    #
    # Remedy 2 reads `<base>...origin/feat/<slug>` out of the standing root — its
    # branch, not its working tree — and a branch name is NOT repo-scoped. So a repo
    # that merely HAS a same-named feat/ branch was graded as this PR's diff: a
    # satellite code PR, reviewed from the hub primary, took the hub branch's doc-only
    # diff and passed. Worse, with the hub's own desk on disk the gate printed
    # "TASK TREE NOT FOUND … working tree is NOT read as the diff" and then read that
    # same repo's BRANCH and granted the exemption anyway — the refusal fired and the
    # verdict passed regardless. 21 real hub↔satellite branch-name collisions exist on
    # disk today, so this is a live vector, not a hypothetical one (review round 5).
    #
    # A BRANCH-only mismatch is still fine: right repo, wrong branch checked out, refs
    # intact — which is precisely the reclaimed-worktree case remedy 2 exists for.
    @standing_repo_ok = foreign_root[:standing_repo_mismatch].nil?
    task_tree_override = (review_fingerprint(diff_root, foreign_root[:expected_branch]) if @standing_repo_ok)
    @task_tree_override = task_tree_override
    if ambiguous
      warn!("⚠ dor-check: AMBIGUOUS TASK TREE — refusing to guess. #{eligible.size} worktrees named " \
            "#{foreign_root[:worktree_slug]} are genuinely on #{foreign_root[:expected_branch]} " \
            "(#{eligible.join(', ')}), which is what a MULTI-REPO task looks like on disk, and nothing here " \
            "says which one this verdict is about: devops.pr_url " \
            "#{@pr_url.to_s.strip.empty? ? "is blank" : "names #{pr_repo_name(@pr_url)}, matching none of them"}. " \
            "Picking the first would re-create the wrong-tree bug one repo over, so this checkout's working " \
            "tree is NOT read as the diff. Declare the one you mean: " \
            "DOR_CHECK_DIFF_ROOT=<path to the right checkout>.")
    elsif rejected.any?
      # B1/B2: candidates existed and every one FAILED validation. Saying only "no
      # worktree exists here" would be false — they are right there on disk, which is
      # exactly why the first cut trusted them. Name each one and the axis it failed,
      # or the reader's conclusion is "the tool can't find my worktree" and their fix
      # is to point it at the very desk that was just rejected.
      warn!("⚠ dor-check: TASK TREE NOT FOUND — #{rejected.size} directory match(es) named " \
            "#{foreign_root[:worktree_slug]} exist here, but none IS #{slug}'s tree: " \
            "#{rejected.map { |path, why| "#{path} #{why}" }.join('; ')}. A directory NAME is not identity — " \
            "a stale desk or another repo's worktree would have been read as this PR's entire diff. This " \
            "checkout's working tree is NOT read as the diff. Fix it: check out " \
            "#{foreign_root[:expected_branch]} in the right worktree, or declare the tree explicitly with " \
            "DOR_CHECK_DIFF_ROOT=<path>.")
    end
    if task_tree_override
      warn!("⚠ dor-check: RE-ROOTING the diff. You are standing in #{standing} (branch " \
            "#{standing_branch}), which is NOT #{slug}'s tree#{ambiguous || rejected.any? ? "" : ", and no " \
            "worktree .worktrees/#{foreign_root[:worktree_slug]} exists here"} — so the diff comes from branch " \
            "#{foreign_root[:expected_branch]}'s committed history (#{task_tree_override[:ref]}), not from this " \
            "checkout's working tree. Announced, not silent: the verdict below is about the BRANCH's code.")
    end
  end
end

# An EXEMPT kind (chore/cleanup/docs) may skip the shape/test-tier gate — but it
# has to EARN the skip with an observed doc-only diff. Three outcomes:
#
#   code in the diff   → gate it exactly like a feature (no size, and no LABEL,
#                        exemption). gated_code_files names the offenders below.
#   doc-only diff      → skip, LOUDLY: say what was observed and where it came
#                        from, so a wrong skip is visible in the transcript
#                        instead of hiding behind a bare "n/a (kind: chore)".
#   nothing observed   → FAIL CLOSED at the merge gate. An empty view is not
#                        evidence of a doc-only PR; it is the absence of evidence
#                        (a blind checkout, an unreadable repo, a bad diff root).
#                        The BUILD gate stays lenient: at design time no code
#                        exists yet, that empty diff is the expected state, and
#                        the build gate enforces no tiers anyway — so leniency
#                        there cannot disarm the test gate. The merge gate can.
# THE RELEASE OWNS THE GEM VERSION — so a builder must never edit one, and this is
# asked BEFORE the doc-only exemption below. A CHANGELOG-only PR is "doc-only" by
# every content rule, so leaving this check downstream let exactly the file that
# caused this morning's duplicate-section reconcile walk straight through the
# exemption. The gate has to sit above the short-circuit to mean anything.
#
# A version is a property of the RELEASE, not of any PR: N pull requests riding one
# candidate publish exactly ONE version, so no individual PR can know the answer when
# it is written. Measured 2026-08-10 (finding-dabd51ca9675): four open studio-engine
# PRs each chose independently — one re-claiming an ALREADY-PUBLISHED version, the
# stranded-work guard's exact trigger, which hard-aborts the sweep for EVERY repo.
# The obvious remedy for the first collided with the second.
#
# Where the version DOES come from: `Release::GemVersion` derives the bump from the
# candidate's membership (breaking → major, feature → minor, else patch), and
# `bin/release prepare` ALLOCATES it at step 4d — writing the version_file, its
# Gemfile.lock and the rolled CHANGELOG.md onto origin/accepted in one commit,
# before the publish. (It was unwired when this gate shipped, so the conductor set
# the number by hand; finding-d0621629719b recorded that gap and it is now closed.)
# THAT ACCEPTED WRITE is what puts the version on the same rung your PR is based on,
# which is why the remedy below restores the file from `accepted`. The ordinary batch
# promote afterwards only carries the same commit onward to origin/release. The
# conductor no longer touches a version_file on the happy path, and the stranded-work
# guard stays armed behind allocation as the backstop.
# This gate is what makes that safe: it turns "don't guess a version" from a discipline
# every builder must remember into a rule they cannot break — the requirement was,
# verbatim, "I don't want my builder to get caught up in version control hell."
#
# REFUSES rather than warns: a version hunk that reaches `accepted` is the thing that
# wedges a release, and it is trivially removable at this point.
release_owned_edits = gate == "build" ? [] : release_owned_gem_files(changed_files)
unless release_owned_edits.empty?
  puts "✗ #{gate_label} NOT met for #{(task["title"] || slug).inspect}"
  puts "  - diff edits a RELEASE-OWNED gem version file (#{release_owned_edits.join(', ')}) — a version belongs " \
       "to the RELEASE, not to any one PR: N pull requests riding one candidate publish exactly ONE version, so a " \
       "PR that sets one either re-claims a published version (which hard-aborts the sweep for every repo) or " \
       "collides with a sibling PR. The release conductor sets it during the sweep."
  puts "  - drop the hunk: git checkout origin/#{ENV.fetch('DOR_BASE_BRANCH', 'accepted')} -- #{release_owned_edits.first}"
  puts "  - if this change is BREAKING, declare it instead of versioning it: " \
       "#{TASK_CMD} update #{task["slug"] || slug} --gem-bump major"
  puts "  → not ready to advance #{boundary}; resolve the above"
  exit 1
end

gated_code_files = []
if EXEMPT_KINDS.include?(kind)
  gated_code_files = code_changed_files
  observed = changed_files
  # An EMPTY observation is never positive proof of a doc-only PR, whatever its
  # source claims — "we saw nothing" and "there is nothing" are different facts.
  # At the merge gate they fail closed alike; at the build gate an empty diff IS
  # the expected state (no code written yet), so it stays exempt.
  indeterminate = observed.empty? && gate != "build"

  if gated_code_files.any?
    # fall through to the full shape/test-tier gate below.
  elsif indeterminate
    errors_preamble = if diff_source == :pr_incomplete
      # NOT "no diff could be observed". Diffs were observed — just not all of them,
      # and the missing one is named. Sending this reader to their worktree would be
      # the worst possible instruction: the repo they are standing in is precisely
      # the one that DID read.
      "kind: #{kind} could not be proven doc-only — #{pr_read_alert}"
    elsif diff_source == :pr_unreadable
      # The refusal has its own voice: this run did not fail to FIND a diff, it
      # refused to accept a substitute for the one it was denied. Saying "no diff
      # could be observed" here would send the reader to their worktree, which is
      # exactly the wrong place — the fix is a credential.
      #
      # This branch is NOT the exempt path: nothing is waived, the gate refuses on
      # the DIFF (it could not prove doc-only) and exits before CI is ever consulted.
      # The alert's closing names the PR read as what refused (pr_read_alert); no
      # cert is offered anywhere any more, so there is no route sentence to get wrong.
      "kind: #{kind} could not be proven doc-only — #{pr_read_alert}"
    elsif untrusted_root?
      # The false-PASS case, refused instead of granted. This is the state the old
      # code turned into "✓ n/a — doc-only diff": it stood in a checkout that is not
      # the task's, read that checkout's dirt, and called it the PR.
      # Name the rejected candidates INSIDE the error when there were any: "no
      # worktree here" would be false when one is sitting on disk under exactly that
      # name, and a reader who believes it will point the gate straight back at it.
      near_misses = Array(@rejected_roots).map { |path, why| "#{path} #{why}" }.join("; ")
      branch_reason, branch_remedy = branch_unavailable(@task_branch)
      "kind: #{kind} could not be proven doc-only — this run stands in #{diff_root}, which is NOT " \
        "#{task["slug"] || slug}'s tree, so its working tree was REFUSED as a diff source (reading it is how " \
        "one unrelated dirty file grants a multi-file code PR a doc-only exemption), and the PR's " \
        "file list could not be read here either — and #{branch_reason}" \
        "#{near_misses.empty? ? "" : " (and no directory named #{task["slug"] || slug} here IS the task's " \
          "tree: #{near_misses})"}. The shape/test-tier gate is ENFORCED " \
        "rather than skipped (fail-closed). Fix it: run dor-check from the task's worktree; or " \
        "#{branch_remedy}; or declare the checkout with DOR_CHECK_DIFF_ROOT=<path to the task's tree>"
    else
      # WHY the PR files were unreadable, when there is a why. "no PR files readable"
      # was true and useless: it covers "there is no pr_url yet" and "GitHub refused
      # the token" alike, and those have nothing in common except the empty result.
      "kind: #{kind} could not be proven doc-only — no diff could be observed " \
        "(no PR files readable, and the git tree at #{diff_root} is clean or unreadable), " \
        "so the shape/test-tier gate is ENFORCED rather than skipped (fail-closed). Re-run " \
        "this from the task's worktree, or set devops.pr_url, so the gate can see the diff " \
        "it is meant to judge" \
        "#{pr_read_alert ? ". The PR half of that: #{pr_read_alert}" : ""}"
    end
    if options[:json]
      puts JSON.pretty_generate(
        task: task["slug"] || slug,
        shape: shape.empty? ? nil : shape,
        kind: kind,
        gate: gate,
        ready: false,
        exempt: false,
        # "indeterminate" is this branch's standing answer and stays it: whatever
        # source was consulted, the OBSERVATION here is empty. The one addition is the
        # refusal, which is a different fact ("the PR read was refused" vs "nothing
        # was readable anywhere") with a different remedy, and the pairing
        # (code_root, diff_source) is where a monitor can see it.
        # The OBSERVATION is empty on every branch here, but WHY is a different fact
        # with a different remedy, so the refusal states carry their own names rather
        # than being flattened into "indeterminate". :pr_incomplete in particular means
        # some PRs read and one did not — a monitor that saw "indeterminate" would look
        # for a blind checkout and find a healthy one.
        diff_source: %i[pr_unreadable pr_incomplete].include?(diff_source) ? diff_source.to_s : "indeterminate",
        # The pairing (code_root, diff_source) is what dor.md calls the checkable
        # invariant — and the exempt-kind payloads were the ONE verdict shape that
        # omitted the root. That is the shape the 08-08 false pass actually took, so
        # a monitor could check the invariant everywhere except where it mattered.
        code_root: diff_root,
        code_files: [],
        # Same machine-readable read-outcome the main payload carries. The exempt
        # shapes are precisely where the false pass lived, so a monitor must be able
        # to ask "was the PR actually read?" HERE, not only on the other path.
        pr_read: pr_read_alert ? pr_file_read.slice(:state, :cause, :reason).compact : nil,
        # THE REFUSAL WHERE COVERAGE MATTERS MOST. This is the payload a multi-repo
        # :pr_incomplete run exits through, so "which PR could not be read?" must be
        # answerable from the JSON here — not only from the prose in `note`. Without it
        # a monitor can see that the run failed closed but not which repo caused it,
        # which is half of what this refusal exists to say.
        pr_coverage: gate == "build" ? nil : pr_coverage,
        note: errors_preamble,
        errors: [errors_preamble],
        suggestions: [],
        missing_metadata: [],
        missing_tiers: []
      )
    else
      title = task["title"] || task["slug"] || slug || "(task)"
      puts "✗ #{gate_label} NOT met for #{title.inspect}"
      print_pr_coverage(gate)
      puts "  · #{errors_preamble}"
    end
    if gate_emission_enabled?(options, gate, slug)
      emit_gate_verdict(slug, false, options[:gate_role],
                        [{ "sop" => "dor-check", "cmd" => "bin/dor-check #{slug} --gate #{gate}",
                           "result" => "fail" }])
    end
    exit 1
  else
    source_label = { injected: "injected diff", pr: "PR files", git: "git working tree",
                     branch: "task branch tree" }
      .fetch(diff_source, diff_source.to_s)
    sample = observed.first(3).join(", ") + (observed.size > 3 ? ", …" : "")
    # THE EXEMPTION IS A POSITIVE CLAIM, so it must name the artifact it was proven
    # against. Submit-side we still grant it off the local view when the PR read
    # failed — but "doc-only diff … [source: git working tree]" printed beside a
    # SILENTLY refused PR read is the 08-08 false pass's exact presentation: a
    # confident exemption whose evidence came from somewhere nobody asked about. The
    # alert rides on the verdict itself, not only in a suggestion, because this line
    # is the part that gets read.
    #
    # NO CERT IS OFFERED HERE, and none is offered anywhere else either since
    # /tasks/dor-reads-settled-ci-verdict. This alert used to carry `cert_route:
    # false` so the exempt path printed a denial where the gated path printed an
    # offer — the two halves co-fire (one stale token refuses the PR file-list read
    # AND the check read), and an exempt verdict once printed the CI gate's correct
    # DENIAL and this alert's OFFER four lines apart. With every route denying, the
    # split has nothing left to guard.
    #
    # AND THE EXEMPTION MUST BE PROVEN AGAINST THE PR, NOT MERELY ANNOUNCED
    # (/tasks/exempt-path-trusts-local-tree). The alert above used to land in
    # `suggestions` for BOTH roles, and that is the second half of the 08-08 false
    # pass: the gated path role-splits a refused PR read (an ERROR in review, a
    # SUGGESTION submit-side — see the block near the end of this file), because the
    # reviewer's checkout is deliberately NOT the task's tree; this path never got
    # that split. So a doc-only exemption could be EARNED from whatever tree the
    # reviewer happened to be standing in while the PR itself went unread, and the
    # review and builder verdicts came back byte-identical — both "✓ … → ready to
    # advance", off "[source: git working tree]". Sister defect to
    # /tasks/gate-zero-skips-docs-ci, one door out: that one was "the exempt path
    # never asks CI", this is "the exempt path never confirms it IS exempt."
    #
    # WHY THE FIX IS HERE AND NOT IN resolve_branch_diff. That resolver already
    # refuses a REVIEW-role :unreadable (diff_source :pr_unreadable). It does not
    # refuse :unverified — gh missing, a 404, a transport error, an API outage — and
    # widening it to would be wrong twice: the :pr_unreadable refusal speaks in
    # credential language ("REFUSED on credentials", "eval $(bin/gh-auth-refresh)"),
    # which is a lie about a transport fault, and it would drag the GATED path along
    # with it for no gain, since the gated path already refuses both states correctly.
    # The missing guard is the ROLE SPLIT on this branch, so that is what is added.
    # It also covers :unreadable here, which the resolver only catches when no diff
    # was injected — defence in depth on the one branch that grants an exemption.
    #
    # THE BUILDER'S FALLBACK IS DELIBERATE AND STAYS. They stand in the task's OWN
    # worktree, where the local view is the honest near-twin of the PR, and their
    # verdict is provisional by design (review re-runs it). Refusing both roles would
    # stall every docs handoff behind an hour-old App token and buy no integrity —
    # the same reasoning resolve_branch_diff and the gated path both already record.
    #
    # AND THE BUILD GATE IS NOT EXCLUDED HERE, whatever this comment used to say. It
    # read "Not evaluated at the build gate, which resolves no diff and must not shell
    # `gh`" — true of the GATED caller below, which really is behind `gate != "build"`,
    # and false of this one, which is not. Driven 2026-09-07: `bin/dor-check --gate
    # build --gate-role review` on a doc-only task with a refused PR read composes this
    # alert and prints it. The claim mattered because the fix below is conditioned on
    # the build gate; a guard derived from a comment that does not describe the code is
    # how a defect gets re-shipped. What IS true is the consequence the comment was
    # reaching for: the build gate makes no refusal, so the alert lands as a SUGGESTION
    # and its closing keeps the original wording — pinned in
    # test/lib/dor_check_pr_read_closing_test.rb, which is what makes this an observed
    # fact rather than a second guess.
    #
    # ONE FACT, READ ONCE, AND IT IS `pr_read_refuses_verdict?`. Whether this alert
    # REFUSES the verdict decides two things — which list it lands in, and whether its
    # closing line may keep promising that a green CI carries this path — and they must
    # never be two spellings of one role test. `exempt_also_refused` below learned the
    # same lesson from the other direction.
    pr_read_refusal = pr_read_alert
    exempt_alerts = []
    exempt_pr_read_errors = []
    if pr_read_refusal
      (pr_read_refuses_verdict? ? exempt_pr_read_errors : exempt_alerts) << pr_read_refusal
    end

    # ==== THE EXEMPTION IS FROM THE TIER GATE. IT WAS NEVER FROM CI ============
    #
    # THE DEFECT (/tasks/gate-zero-skips-docs-ci). This branch used to end in a bare
    # `exit 0`, and that `exit` sat ABOVE the CI allow-list and above the gate-verdict
    # emit. So for a doc-only diff, `--gate-role review` — the run the pipeline calls
    # THE AUTHORITATIVE CI VERDICT — never evaluated CI at all: --json returned
    # ready=true, exempt=true, errors=[] with no `ci` field in the payload, and no
    # `dor_review` attempt was recorded. The null attempt on docs-shaped PRs was
    # logged twice and dismissed as a missing record. It was not missing. The gate
    # had not run. Three doc-shaped PRs cleared gate-zero this way (turf-vault #9 and
    # #10, mcritchie-studio #1204); all three happened to be green.
    #
    # WHY THE FIX IS A SPLIT AND NOT A MOVE. Two unrelated guards live below that
    # `exit`, and only ONE of them should be skipped here:
    #   * the shape / TEST-TIER gate — correctly skipped. A prose diff owes no unit
    #     tier, and demanding one is how people learn to mislabel a shape.
    #   * the CI allow-list — never had any business being skipped. This repo's CI
    #     GRADES PROSE: the doc-link check, generated-doc drift, the entry-doc guards
    #     and rubocop over bin/ all run on a docs PR, and every one of them can go
    #     red. "Ships no behavior" is not "cannot fail CI".
    # So the tier gate stays waived and the CI verdict is asked HERE, through the
    # same CiGate.verdict the gated path calls, rather than by relocating a block.
    #
    # NO CERT CLEARS ANYTHING, on this path or the gated one. This path never had a
    # suite to substitute (the tier gate is waived); the gated path lost its
    # substitution when the receipts stopped being read
    # (/tasks/dor-reads-settled-ci-verdict). In BOTH roles GREEN advances, a
    # builder-side pending WAITS, and everything else refuses with its own remedy.
    exempt_ci = gate == "build" ? nil : task_ci_verdict(devops).first
    # WHAT ELSE IS ALREADY REFUSING THIS VERDICT, handed down so the CI refusal's own
    # closing line cannot promise that a green CI alone would carry this path. Read
    # from the SAME list the closing `refused_by` line below reads, and resolved ABOVE
    # this point (the PR read is asked before CI is), so the two sentences a reader
    # meets in one refusal are computed from one fact rather than agreeing by habit.
    #
    # EMPTY IN THE BUILDER ROLE BY CONSTRUCTION, and that is the fence, not an
    # accident: there the PR-read refusal lands in `exempt_alerts` as a SUGGESTION, so
    # nothing but CI is refusing and green really is sufficient — the remedy prints the
    # sentence it always printed, to the byte.
    exempt_also_refused = exempt_pr_read_errors.empty? ? [] : [PR_READ_REFUSAL_PHRASE]
exempt_ci_error =
  if exempt_ci
    CiGate.verdict(exempt_ci, review_role: review_role, pr_url: governing_ci_pr_url(devops),
                              slug: task["slug"] || slug, also_refused: exempt_also_refused)
  end
exempt_ci_waiting = CiGate.waiting?(exempt_ci, review_role: review_role)
    # CI FIRST, the PR-read refusal second: one fault hides both reads — a refused
    # token, or a `gh`/network failure — and when they co-fire the CI verdict is the
    # one that has always led this refusal.
    # Reordering it would change the headline of every existing exempt refusal.
    exempt_errors = [exempt_ci_error].compact + exempt_pr_read_errors
    exempt_ready = exempt_errors.empty?
    exempt_ci_result = CiGate.gate_row(exempt_ci, review_role: review_role, review_refused: !exempt_ready)

    note = if !exempt_ready
      exempt_errors.first
    elsif observed.empty?
      "no code written yet (kind: #{kind}); DoR n/a"
    else
      "doc-only diff (kind: #{kind}): #{observed.size} file(s), none behavioral — #{sample} " \
        "[source: #{source_label}]; DoR n/a" \
        "#{exempt_alerts.empty? ? "" : " — ⚠ #{pr_read_headline} (see the suggestion below)"}"
    end
    if options[:json]
      puts JSON.pretty_generate(
        task: task["slug"] || slug,
        shape: shape.empty? ? nil : shape,
        kind: kind,
        gate: gate,
        # `exempt` is now strictly about the TIER GATE — it says which guard was
        # waived, never that the run passed. Reading it as the verdict is what made
        # the missing CI invisible: `ready` is the verdict, and the two can now
        # disagree (exempt: true, ready: false) exactly when CI refuses.
        ready: exempt_ready,
        exempt: true,
        ci_waiting: exempt_ci_waiting,
        diff_source: diff_source.to_s,
        # The doc-only PASS — the exact verdict shape the 08-08 false pass wore. It
        # must say which tree it read, or the exemption cannot be audited after the
        # fact from the JSON alone.
        code_root: diff_root,
        code_files: [],
        changed_files: observed,
        # Same coverage rows as the gated payload. The exempt shapes are exactly where
        # the 08-08 false pass lived, so "which PRs was this exemption proven against?"
        # must be answerable HERE too, not only on the other path.
        pr_coverage: gate == "build" ? nil : pr_coverage,
        # KEYED OFF THE REFUSAL, NOT OFF `suggestions`. This is how a monitor asks
        # "was the PR actually read?" of an exempt verdict after the fact — and the
        # role split above moves the alert OUT of exempt_alerts in the review role,
        # which is exactly the role where the answer matters most. Reading the old
        # list here would have blanked the field on the fixed path.
        pr_read: pr_read_refusal ? pr_file_read.slice(:state, :cause, :reason).compact : nil,
        note: note,
        errors: exempt_errors,
        suggestions: exempt_alerts,
        missing_metadata: [],
        missing_tiers: [],
        # THE FIELD WHOSE ABSENCE WAS THE BUG. An exempt verdict used to carry no
        # `ci` key at all, so "did this gate read CI?" was unanswerable from the
        # JSON — a monitor could not tell a green from a gate that never looked.
        # nil only at the build gate, which must not shell `gh`.
        ci: exempt_ci && { state: exempt_ci[:state], cause: exempt_ci[:cause], reason: exempt_ci[:reason],
                           failing: exempt_ci[:failing], pending: exempt_ci[:pending],
                           count: exempt_ci[:count] }.compact,
        ci_gate_result: exempt_ci_result
      )
    else
      title = task["title"] || task["slug"] || slug || "(task)"
      if exempt_ready
        puts "✓ #{gate_label} n/a for #{title.inspect} — #{note}"
        print_pr_coverage(gate)
        # SAY BOTH HALVES. The old line said only which gate was skipped, which is
        # how "no tier was demanded" and "no CI was read" read the same in a
        # transcript. Name the tier waiver AND the CI verdict that stands behind
        # this pass, so the reader can tell a graded exemption from a blind one.
        puts "  → ready to advance #{boundary} (shape/test-tier gate skipped: the OBSERVED diff ships no " \
             "behavior#{exempt_ci ? "; GitHub CI: #{exempt_ci[:state].to_s.upcase}" : ""})"
      elsif exempt_ci_waiting && exempt_errors == [exempt_ci_error]
        # THE WAIT, on the exempt path: nothing refuses but an unsettled CI, and the
        # headline says so rather than "NOT met" — bin/ship's step 7 reads exit 1 either
        # way, so the wording is for the reader, and the reader's move is to come back.
        puts "⏳ #{gate_label} WAITING on CI for #{title.inspect} — the OBSERVED diff ships no behavior; the CI " \
             "verdict has not settled"
        print_pr_coverage(gate)
        puts "  - #{exempt_ci_error}"
        puts "  → not ready to advance #{boundary} YET; re-run once CI reports"
      else
        puts "✗ #{gate_label} NOT met for #{title.inspect}"
        print_pr_coverage(gate)
        exempt_errors.each { |e| puts "  - #{e}" }
        # NAME WHICH REFUSAL THIS IS. The line used to assert flatly that the refusal
        # was "the CI verdict" — true while CI was the only thing that could refuse
        # on this path, and false the moment the PR-read refusal joined it
        # (/tasks/exempt-path-trusts-local-tree): a GREEN CI plus an unread PR printed
        # a refusal whose closing line blamed CI. A closing line that misnames the
        # error above it sends the reader to the wrong fix — the same defect family as
        # the dead cert remedy this path removed one task ago. Derived from the two
        # error lists themselves, so a future third reason cannot silently inherit
        # CI's sentence. Never empty: !exempt_ready holds exactly when one of them is.
        refused_by = []
        refused_by << "the CI verdict, which an exempt diff does not escape" if exempt_ci_error
        refused_by << PR_READ_REFUSAL_PHRASE unless exempt_pr_read_errors.empty?
        puts "  → the shape/test-tier gate IS waived (the OBSERVED diff ships no behavior) — this refusal is " \
             "#{refused_by.join(' AND ')}"
        puts "  → not ready to advance #{boundary}; resolve the above"
      end
      exempt_alerts.each { |a| puts "  ⓘ suggestion: #{a}" }
    end
    # THE ATTEMPT IS RECORDED IN BOTH DIRECTIONS. The exempt path wrote no GateRun
    # at all before this — which is why `dor_review` read null on every docs-shaped
    # PR, and why the gate's own absence was mistaken for a board bug.
    if gate_emission_enabled?(options, gate, slug)
      exempt_sops = [{ "sop" => "dor-check", "cmd" => "bin/dor-check #{slug} --gate #{gate}",
                       "result" => exempt_ready ? "pass" : "fail" },
                     { "sop" => "tiers", "tier" => "waived", "result" => "pass" }]
      if exempt_ci
        exempt_sops << { "sop" => "ci", "result" => exempt_ci_result }
          .merge(CiStatus.gate_evidence(exempt_ci, repo: CiStatus.repo_from_pr_url(governing_ci_pr_url(devops))))
      end
      emit_gate_verdict(slug, exempt_ready, options[:gate_role], exempt_sops)
    end
    exit(exempt_ready ? 0 : 1)
  end
  # else: this kind ships code — fall through and gate it like a feature.
end

errors = []
if shape.empty?
  errors << if gated_code_files.any?
    sample = gated_code_files.first(3).join(", ") + (gated_code_files.size > 3 ? ", …" : "")
    "kind: #{kind} ships a code diff (#{sample}) so the test gate applies — set " \
      "devops.shape (#{shapes.keys.join(", ")}) and record its tiers, or move the code out of this #{kind}"
  else
    "devops.shape is not set (expected one of: #{shapes.keys.join(", ")})"
  end
elsif shape_def.nil?
  errors << "unknown shape #{shape.inspect} (valid: #{shapes.keys.join(", ")})"
end

# DoR-to-Build checks only spec completeness (the base defaults). local_url and
# the test tiers are build artifacts — not knowable at design time, so the build
# gate never asks for them. DoR-to-Merge asks for the shape's full contract.
if gate == "build"
  required_meta = defaults["required_metadata"] || []
  dor_tiers = []
else
  required_meta = (shape_def && shape_def["required_metadata"]) || defaults["required_metadata"] || []
  dor_tiers = (shape_def && shape_def["dor_tiers"]) || []
end
missing_meta = required_meta.reject { |field| present?(devops[field]) }

checks = Array(devops["checks_run"])
missing_tiers = dor_tiers.reject { |tier| tier_satisfied?(checks, tier) }

# ==== `claimable_when:` — a LIGHT SHAPE IS EARNED FROM THE DIFF, NEVER TYPED ===
#
# Two shapes carry no tiers, for two different reasons, and BOTH are unsafe if the
# shape can be claimed by a diff that does not match it:
#
#   test-only  claimable_when: test_only_diff — a diff made entirely of test code
#              has no behavior for a tier to be evidence OF.
#   docs       claimable_when: docs_with_guards_diff — prose (which certifies by
#              REVIEW, with no suite to certify) plus, optionally since
#              2026-09-03, the registry-guard tests that pin it: *_test.rb under
#              test/docs/, type AND location together, with at least one prose
#              file (guard tests may ride along; prose alone still claims).
#
# Without the guard, the lightest contracts in config/feature_shapes.yml are
# unlocked by TYPING their name, which is `kind: chore`'s bug (PR #512) rebuilt one
# level up, in the taxonomy this time.
#
# WHY `docs` GOT THIS GUARD (2026-09-02, /tasks/docs-shape-admits-test-code), and
# it is the sharpest statement of the hole: THE EXEMPT-KIND GATE ABOVE ALREADY ASKS
# THIS EXACT QUESTION, AND ALREADY REFUSES. A `kind: docs` task shipping
# app/models/task.rb loses its exemption up there (gated_code_files is non-empty)
# and falls through to the shape contract — which was `shape: docs`: zero tiers,
# no suite gate, "✓ DoR-to-Merge met". The kind gate's own FALL-THROUGH was
# the hole: one observation, asked twice, answered two opposite ways.
#
# MEASURED on PR #1172 (shape docs, carrying test/integration/
# open_pr_receipt_visibility_test.rb): no tier demanded, no cert demanded, and the
# output said nothing about either. That PR was well-certified anyway, by a builder
# who volunteered what the gate never asked for — which is the failure mode, not
# the mitigation. A gate that relies on volunteered evidence holds for careful
# builders and fails SILENTLY for everyone else.
#
# THE RULE REUSES CodeDiff — THE CLASSIFIER THE KIND GATE ALREADY USES. Not a
# second "what is prose" list: a second list drifts, and the whole defect here was
# two answers to one question. Precisely: doc-only is decided by FILE TYPE
# (CodeDiff's denylist — .md/.markdown/.mdx/.rdoc, inert media, LICENSE-class
# basenames), never by directory and never by hunk content. THREE EDGES the next
# reader will hit, written down because they will:
#   * A TEST FILE IS NOT DOC-ONLY. test/ is executable, and it is the case that
#     motivated this guard.
#   * A COMMENT-ONLY EDIT to config/*.yml or an .rb IS NOT DOC-ONLY. CodeDiff's
#     header refuses hunk granularity on purpose ("the honest granularity is the
#     FILE"): deciding a hunk is "only comments" means trusting a parse an author
#     can talk the gate out of. The cost of the strict answer is one tier line; the
#     cost of the loose one is the gate.
#   * LOCATION BUYS NOTHING. docs/agents/setup.sh is mode 100755 and gates, exactly
#     as it does for the kind exemption. Where a file was FILED is a declaration.
#
# The fail-closed rules are shared by both claims, and both mirror the exempt-kind
# gate above: a disqualifying file blocks the claim, and an UNOBSERVABLE diff blocks
# it too. "We saw nothing" is not "there is nothing"; reading silence as proof is
# how a blind checkout hands out the discount.
#
# The BUILD gate stays lenient on an empty observation for the reason it always
# has: at design time no code exists yet, so an empty diff is the expected state.
# It cannot disarm anything, because the build gate enforces no tiers either way.
# A build-gate diff that IS observable and DOES carry a disqualifying file still
# errors here — the earlier the shape is corrected, the less work is thrown away.
claim_rule = shape_def && shape_def["claimable_when"]
if claim_rule
  observed = changed_files

  # THE VERDICT IS THE MODULE'S PREDICATE, NOT A SECOND COPY OF ITS RULES. An
  # earlier cut re-derived "empty means refuse" here, next to the module that
  # already documents it at length — two copies of one truth, which is the drift
  # this repo's guards exist to catch. A mutation harness caught it as a DEAD
  # PATH: flipping the module's empty case to `true` changed nothing, because
  # nothing called it. The offender LIST is used only to NAME the files, so a
  # refusal can say which one disqualified the claim.
  case claim_rule
  when "test_only_diff"
    offenders = TestOnlyDiff.non_test_files(observed)
    proven = TestOnlyDiff.test_only?(observed)
    must_be = "ENTIRELY test code"
    proven_label = "test-only"
    offender_help = "Test content means test/, tests/ or e2e/ — a workflow, a Gemfile, a playwright.config.js " \
      "or an app/ file is a behavioral change whose tests are evidence FOR it, which is what the other shapes " \
      "are for."
  when "doc_only_diff"
    offenders = CodeDiff.code_files(observed)
    proven = CodeDiff.doc_only?(observed)
    must_be = "ENTIRELY prose"
    proven_label = "doc-only"
    offender_help = "Prose is decided by the file's TYPE (.md/.markdown/.mdx/.rdoc, inert media, LICENSE-class " \
      "basenames) — not by where it was filed, and not by whether the hunk was only comments. A test file, a " \
      "workflow, a .yml or an app/ file ships behavior. This is the SAME classifier that already denies an " \
      "exempt kind (chore/cleanup/docs) its doc-only exemption on this very diff, so a shape that could still " \
      "claim it here would be one observation answered two ways."
  when "docs_with_guards_diff"
    # docs + the registry-guard test that pins them (/tasks/docs-shape-rejects-
    # guard-test): the pattern this repo's culture rewards finally has a shape
    # that neither deletes the test nor mislabels the diff. The guard-test rule
    # is TYPE AND LOCATION together (a `*_test.rb` under test/docs/); prose must
    # still be present, or the diff is test-only's stricter business.
    offenders = CodeDiff.non_guard_code_files(observed)
    proven = CodeDiff.docs_with_guards?(observed)
    must_be = "prose plus docs-guard tests (test/docs/*_test.rb) ONLY, with at least one prose file"
    proven_label = "docs-with-guards"
    offender_help = "A docs claim may carry documentation-subject tests — files that are BOTH under test/docs/ " \
      "AND tests by type (*_test.rb) — beside its prose. Any other behavioral file (app/, bin/, config, a " \
      "helper.rb even under test/docs/) disqualifies the claim, and a diff of guard tests with NO prose is " \
      "test-only's stricter contract, not this one."
    # Guard tests with NO prose refuse with their OWN sentence: the generic
    # branches below would either name no offender (the guards are allowed
    # files) or claim no diff was observed (one was). must_be is cleared so
    # neither generic branch re-answers a question this one already has.
    observed_present = Array(observed).any? { |f| !f.to_s.strip.empty? }
    if observed_present && !proven && offenders.empty?
      errors << "shape #{shape.inspect} was claimed on a diff of docs-guard tests with NO prose — pure test " \
        "code is the `test-only` shape's STRICTER contract (full-suite cert + a [control] line naming a file " \
        "in the diff), and a tierless docs claim must not be its cheap door. Re-shape to test-only"
      must_be = nil
    end
  else
    # AN UNCLASSIFIED CLAIM RULE REFUSES. A `claimable_when` this gate does not
    # implement used to fall through and GRANT the claim in silence — the shape
    # keeping its light contract BECAUSE its guard was unrecognized, which is this
    # block's own failure arriving through the block itself. Same allow-list
    # discipline the CI-state gate applies: a state nobody classified is evidence
    # the gate is out of date, never evidence of health.
    offenders = []
    proven = false
    must_be = nil
    proven_label = nil
    errors << "shape #{shape.inspect} declares claimable_when: #{claim_rule.inspect}, a claim rule bin/dor-check " \
      "does not implement — so the shape's lighter contract is REFUSED rather than granted by an unrecognized " \
      "guard. Implement the rule in bin/dor-check's claimable_when block (beside test_only_diff / doc_only_diff / docs_with_guards_diff), " \
      "or fix the value in config/feature_shapes.yml"
  end

  if must_be && offenders.any?
    sample = offenders.first(3).join(", ") + (offenders.size > 3 ? ", …" : "")
    errors << "shape #{shape.inspect} may only be claimed on a diff that is #{must_be}, and the " \
      "observed diff ships #{offenders.size} file(s) that are not: #{sample} [source: #{diff_source}]. " \
      "#{offender_help} Re-shape it (#{(shapes.keys - [shape]).join(', ')}) and record that shape's tiers, or " \
      "split the #{shape} work into its own task"
  elsif must_be && !proven && gate != "build" && diff_source == :pr_incomplete
    # Same distinction the exempt path draws: this run did not fail to FIND a diff, it
    # refused to grade an INCOMPLETE one. The alert names the repo it could not read.
    errors << "shape #{shape.inspect} could not be proven #{proven_label} — #{pr_read_alert}"
  elsif must_be && !proven && gate != "build"
    errors << "shape #{shape.inspect} could not be proven #{proven_label} — NO diff could be observed " \
      "(no PR files readable, and the git tree at #{diff_root} is clean or unreadable), so the claim is " \
      "REFUSED rather than granted (fail-closed). An empty observation is the absence of evidence, not " \
      "evidence of a #{proven_label} diff. Re-run this from the task's worktree, or set devops.pr_url, so the " \
      "gate can see the diff it is meant to judge"
  end
end

# Post-deploy nudge (merge gate only). A diff that adds or edits a seed or a
# data-migration should declare devops.post_deploy_cmd so the conductor runs it
# on ship (bin/release) instead of someone running the rake by hand afterward.
# Like local_url and the test tiers, the command is a BUILD artifact — you only
# know it once the migration exists — so the build gate (spec-complete, no code
# yet) never asks for it. Escape hatch, consistent with the chore gate (satisfy
# the contract; don't bypass it): declare the command, OR set post_deploy_cmd to
# "none" to acknowledge a schema-only migration the release phase auto-runs. The
# explicit "none" is the point — it forces a conscious decision instead of a
# silent omission.
if gate != "build"
  data_files = data_changed_files
  if data_files.any? && !present?(devops["post_deploy_cmd"])
    sample = data_files.first(3).join(", ") + (data_files.size > 3 ? ", …" : "")
    errors << "diff touches a seed/migration (#{sample}) but devops.post_deploy_cmd is blank — this " \
      "change should declare a post-deploy command so the conductor runs it on ship and nobody runs the " \
      "rake by hand (e.g. #{TASK_CMD} update #{task["slug"] || slug} --post-deploy-cmd 'bin/rails pokemon:seed'); " \
      "set it to 'none' if no command is needed (a schema-only migration the release phase auto-runs)"
  end

  # Gem-publish seam: a Gemfile bumped past what the lock can satisfy will fail CI
  # (frozen bundle can't resolve an unpublished version). Catch it HERE, before
  # submit, instead of as a red-CI surprise + a review block (the mcritchie#157
  # studio-engine 0.9.0 case — see docs/agents/audits/session-retrospective-2026-06-25.md).
  gem_constraint_violations.each do |v|
    errors << "Gemfile sets #{v["name"]} #{v["constraint"].inspect} but Gemfile.lock pins #{v["locked"]}, " \
      "which doesn't satisfy it — the new version is almost certainly NOT published, so CI will fail " \
      "`bundle install --frozen` (the gem-publish seam). Sequence it: release/publish #{v["name"]} first, " \
      "then `bundle update #{v["name"]}` to relock; OR hold the constraint bump until the gem ships; OR " \
      "bridge the consumer via a git source. A shared-gem feature ships the gem BEFORE the app adopts it."
  end
end

# Post-deploy SAFETY gate (BOTH gates — value-based, so gate-independent). A
# declared post_deploy_cmd is run VERBATIM against PRODUCTION by bin/release, so it
# must be NARROW, prod-safe, and idempotent. Reject a bare full-suite seed: db:seed
# (and db:seed:replant) loads db/seeds.rb → EVERY db/seeds/*.rb, which would inject
# demo News/Content/Tasks into prod AND abort the release on a non-idempotent seed
# file. The near-miss: merge-docs-reviewer-into-alex shipped post_deploy_cmd=
# 'bin/rails db:seed'; reviewers read the diff, not the deploy metadata, so it only
# surfaced when QA aborted. (An exempt no-code task short-circuits above and never
# reaches here; any task that actually ships a seed/migration touches db/ → non-
# exempt → gated.)
post_deploy_cmd = devops["post_deploy_cmd"].to_s
if present?(post_deploy_cmd) && bare_full_suite_seed?(post_deploy_cmd)
  errors << "devops.post_deploy_cmd #{post_deploy_cmd.inspect} is a bare full-suite seed — bin/release " \
    "runs it VERBATIM against PRODUCTION, and db:seed loads db/seeds.rb which loads EVERY db/seeds/*.rb: it " \
    "would inject demo News/Content/Tasks into prod AND abort the release if any seed file is non-idempotent " \
    "(the merge-docs-reviewer-into-alex near-miss). Declare a NARROW command instead — a scoped single-file " \
    "runner, e.g. rails runner 'load Rails.root.join(\"db/seeds/NN_x.rb\").to_s', or a dedicated idempotent " \
    "rake task (e.g. bin/rails pokemon:seed)"
end

# CI-status gate (merge gate only) — and since /tasks/dor-reads-settled-ci-verdict
# THE SUITE GATE: the PR's settled GREEN GitHub CI is the one form of evidence that
# the full suite (test:system included) went green against the exact tree being
# shipped. It blocks on every non-green state in BOTH roles; builder-side a
# still-RUNNING CI is a WAIT rather than a failure (bin/ship holds at step 6/8 for
# exactly this, so the ordinary handoff never sees it). The review gate-zero
# (--gate-role review) is the authoritative verdict and defers a pending one.
# The allow-list lives in bin/lib/ci_gate.rb.
# Non-blocking SUGGESTIONS collect here too (never affect `ready`); more join below.
suggestions = []

if gate != "build"
  # --- THE PLUGGABLE CHECKS ---------------------------------------------------
  #
  # Every file under bin/lib/dor/checks/ is discovered by a GLOB and registers itself
  # by subclassing Dor::Checks::Base, so adding a check is a pure file add: no require
  # line here, no registry entry, no hook. That is deliberate and it is the whole
  # point of the seam — bin/dor-check was touched by 24 of the last 200 merged PRs,
  # and the contention was never the file's size, it was the three shared lines every
  # new check had to edit.
  #
  # Findings fold into the SAME arrays the inline checks below use, so a plugged check
  # and an inline one are indistinguishable in the verdict. The buffered `say` lines
  # print only in text mode — a --json consumer parses this stream.
  check_context = Dor::Checks::Context.new(
    gate: gate, gate_role: options[:gate_role], task: task, devops: devops, slug: slug,
    diff_root: diff_root, diff_base: diff_base(diff_root), pr_url: devops["pr_url"],
    changed_files: changed_files, json: options[:json]
  )
  Dor::Checks.run(:merge, check_context)
  check_context.lines.each { |line| puts line }
  errors.concat(check_context.errors)
  suggestions.concat(check_context.suggestions)
end

# --- THE PR FILE LIST: a refused read is never a silent one -------------------
#
# The diff above may have come from the LOCAL tree because the PR's file list could
# not be read. Role-split for the same reason the CI verdict is (see the block
# below), and in the same direction:
#   REVIEW  — an ERROR. This role's verdict is authoritative and it reads the PR
#             precisely because its own checkout is not the task's tree; grading a
#             substitute here is the false pass this gate exists to refuse. (The
#             substitution was already refused upstream — diff_source :pr_unreadable —
#             so this is the error that NAMES it, not a second policy.)
#   SUBMIT  — a SUGGESTION. The builder stands in the task's own worktree, their
#             verdict is provisional, and review re-reads it. Blocking every handoff
#             on an hour-old App token would buy nothing.
# Not evaluated at the build gate, which resolves no diff and must not shell `gh`.
#
# In the REVIEW role a refused PR read is an ERROR, and nothing clears it but a read
# that works: the alert names its own refusal in its closing line (pr_read_alert), and
# since /tasks/dor-reads-settled-ci-verdict no verdict offers a local cert for any
# half of a run, so the alert carries no route and forwards none.
# ONE FACT, READ ONCE. This site used to spell the role test inline while its twin on
# the exempt path asked pr_read_refuses_verdict?, and two spellings of one predicate is
# how the exempt path's two closings drifted apart in the first place. It is also now
# load-bearing beyond the role: an :incomplete multi-repo read refuses in BOTH roles,
# and an inline `review_role ?` here would file that refusal as a SUGGESTION — a
# non-blocking note attached to a verdict that just failed closed.
if gate != "build" && (alert = pr_read_alert)
  pr_read_refuses_verdict? ? errors << alert : suggestions << alert
end

ci = nil
ci_error = nil      # the CI refusal, if any — the suite gate's whole verdict
ci_waiting = false  # builder-side pending: a WAIT, printed under its own headline
ci_refused = false  # resolved after the review-side checks below; feeds the gates-card row
if gate != "build"
  ci = task_ci_verdict(devops).first

  # The case + the allow-list, both of them, live in CiGate.verdict — the exempt path
  # above asks the very same function, so neither can advance on a state the other
  # refuses. It returns the refusal or nil; there is no cert-clearable second value
  # any more, because nothing clears a CI refusal but CI.
  ci_error = CiGate.verdict(ci, review_role: review_role, pr_url: governing_ci_pr_url(devops),
                                slug: task["slug"] || slug)
  ci_waiting = CiGate.waiting?(ci, review_role: review_role)

  # ==== THE GREEN MUST STILL BE ABOUT THIS MERGE (review role) ====================
  #
  # `gh pr checks` answers for the HEAD COMMIT, and ci.yml triggers on pull_request
  # and on pushes to main, release AND `accepted` — so a merge into `accepted` DOES
  # start a run. That run grades the `accepted` TIP, a tree this PR is not in, and
  # nothing re-runs THIS PR against the moved base.
  # The green stays green while the tree it described stops
  # being the tree the merge would produce. That is not a hypothetical: on 2026-08-13
  # this gate advanced a review on a green dated three days earlier against a base
  # 30+ commits ahead, and twice more the same day a green predated the change on
  # `accepted` that it was implicitly claiming to cover.
  #
  # So :green advances only while the base has NOT drifted. :unknown does not refuse —
  # GitHub computes mergeability asynchronously and lags, and refusing every review
  # that races that computation would wedge the lane for a fact nobody asserted. The
  # release gate reaches the same conclusion by comparing TREES; this is the review
  # side of that notion, using the one signal a PR read already carries.
  #
  # DOR_CHECK_CI_BASE_DRIFT is the test seam, mirroring DOR_CHECK_CI_STATUS.
  # THE PR'S ACTUAL BASE, resolved HERE rather than eighty lines down (it used to be
  # assigned just above SEAM 2b, after every consumer on this path had already run).
  # That ordering had one visible consequence and it was not cosmetic: the staleness
  # refusal below could not reach the value, so it hardcoded the literal `accepted` into
  # both halves of its remedy — the trigger claim AND the `git rebase` instruction. On a
  # STACKED, feat-based PR the gate then refused correctly and sent the reviewer to
  # rebase onto a branch it is not based on. Nothing downstream reads either name before
  # this point, so the hoist moves the assignment and changes no verdict.
  # No ActiveSupport in this script, so no `.presence` — spell the fallback out.
  ci_base = ci ? ci[:base].to_s.strip : ""
  base_branch = ci_base.empty? ? ENV.fetch("DOR_BASE_BRANCH", "accepted") : ci_base

  ci_drift = (ENV["DOR_CHECK_CI_BASE_DRIFT"] || ci[:base_drift]).to_s
  if review_role && ci_error.nil? && ci[:state] == :green && ci_drift == "behind"
    ci_error = "GitHub CI is GREEN but the verdict is STALE — GitHub reports this PR BEHIND its base. " \
      "#{stale_base_run_clause(base_branch)} The green describes a tree that is no longer the tree this " \
      "merge would produce, and the review gate-zero is the authoritative CI verdict. Update the branch " \
      "from its base (`git rebase origin/#{base_branch}` or the PR's Update-branch button) and let CI " \
      "re-run, then re-check."
  end


  # ==== THE REVIEWER-ZAP SEAMS (/tasks/reviewer-zap-has-unmapped-seams) ============
  #
  # A ZAP — a reviewer fixing a small defect forward on the PR branch instead of
  # spending a bounce — is an ENCOURAGED act, bounded by the zap protocol at 25 lines
  # and 2 files. Nothing below discourages one. The problem being fixed is the
  # opposite: the machinery AROUND a zap assumed nobody pushed, which made zapping
  # quietly riskier than bouncing and pushed reviewers toward the expensive action.
  #
  # Both checks are LOCAL-REF reads (this gate never fetches — deliberately: a fetch
  # inside a verdict would mutate the tree it is grading). ReviewTreeGuard's header
  # carries the error-direction argument for each; the two severities below follow
  # from it and are NOT interchangeable.
  zap_branch = review_branch(devops, task["slug"] || slug)

  # SEAM 1 — REFUSES, because the gate would otherwise describe a tree that is not
  # the one merging. `--gate-role review` re-roots to the BUILDER'S DESK, which sits
  # wherever the builder left it; measured on turf #519, that was 262059b while the
  # merged commit was 9137d57. DISTANCE IS NOT THE TEST, REF SHARING IS: a zap pushed
  # from a SIBLING WORKTREE moves origin/<branch> (every worktree of a repo shares one
  # ref store), so the desk's ref follows the push and this check stays quiet; a zap
  # pushed from INDEPENDENT refs — a separate clone, another machine, GitHub's
  # Update-branch button — does not move it, and this check is the only thing that
  # asks. Measured 2026-09-09 in the real house geometry and pinned by
  # test/docs/zap_cert_freshness_docs_test.rb. (The cert fingerprint used to be the
  # other reader of this ref: it caught the sibling-worktree case by going STALE and
  # read FRESH over a separate-clone push, which only this check catches — and it
  # retired with the receipts; the CI verdict is read for the PR head wherever it is,
  # so this check is now what ties the graded DIFF to that head.)
  #
  # A mismatch can only ever be a FALSE REFUSAL (an unfetched desk), never a false
  # pass, and the remedy for the harmless case is the same `git fetch` that fixes the
  # real one. That is why this one is allowed to block.
  head_check = ReviewTreeGuard.head_assessment(
    root: diff_root, branch: zap_branch,
    pr_head: ENV["DOR_CHECK_PR_HEAD"] || (ci && ci[:head_oid])
  )
if review_role && head_check[:state] == :mismatch
  errors << "the tree this review gate graded is NOT the PR head — #{head_check[:ref]} in #{diff_root} is at " \
    "#{head_check[:local_sha][0, 12]} while the PR head is #{head_check[:pr_head][0, 12]}. Somebody pushed " \
    "(a reviewer zap is the usual cause) and this checkout has not seen it, so the DIFF and the file contents " \
    "this gate read describe a tree that is not the one merging — while the CI verdict beside them describes " \
    "the PR head, which is the tree the suite evidence is about. REF SHARING decides which pushes reach " \
    "origin/#{zap_branch} here at all: one from a SIBLING WORKTREE does (worktrees share one ref store), one " \
    "from INDEPENDENT refs — a separate clone, another machine, GitHub's Update-branch button — does not. " \
    "Fetch the branch (git -C #{diff_root} fetch origin #{zap_branch}) and re-run — that alone clears THIS " \
    "refusal. KEEP THE -C: this gate re-roots to the graded checkout, so a reviewer running it from the " \
    "repo's primary is standing somewhere else, and a bare `git merge` pasted there fast-forwards whatever " \
    "the primary has checked out — release or main by SOP — with exit 0 and a success message. If the " \
    "desk is yours and you want it ON the pushed head, git -C #{diff_root} merge --ff-only " \
    "origin/#{zap_branch}; IF THAT MERGE REFUSES (`Not possible to fast-forward`), #{diff_root} carries a " \
    "commit origin/#{zap_branch} does not — read what is at stake (git -C #{diff_root} log --oneline " \
    "origin/#{zap_branch}..HEAD): if that commit belongs on this PR, land it as a zap (rebase onto " \
    "origin/#{zap_branch}, then push) so it BECOMES the head; if it does not and the desk is yours, " \
    "git -C #{diff_root} reset --hard origin/#{zap_branch} DISCARDS it. If the desk is NOT yours, discard " \
    "nothing — grade on the CI green for this exact head and say so in your report."
  elsif review_role && head_check[:state] == :unobservable && head_check[:reason] == :no_pr_head
    # NOT a refusal: with no head from GitHub the question could not be asked, and the
    # CI gate above already owns "we could not read this PR". Say which check went
    # unmade rather than letting its silence read as a pass.
    suggestions << "could not confirm the graded tree IS the PR head — GitHub returned no headRefOid, so the " \
      "zap check (is this verdict about the commit that will merge?) did not run. The CI verdict is read for " \
      "the PR head wherever it is; this check is what ties the DIFF this gate graded to that same head."
  end

  # SEAM 2 — REPORTS, and deliberately does not refuse. `accepted` moves constantly;
  # refusing every review whose base gained a commit would wedge the lane for a fact
  # that is usually harmless, and a gate that refuses correct work is one people learn
  # to route around. Measured case: turf #517 merged 97 SECONDS after #519's e2e
  # declared-set check finished, touching BOTH e2e/auth_modal.spec.js and
  # config/e2e_lane.yml — the spec set and the contract that counts it. That review
  # came out right only because the reviewer re-derived by hand.
  #
  # GitHub's own answer is not enough, which is why this re-derives from refs: the
  # BEHIND check above fires only where branch protection demands an up-to-date
  # branch, and CiStatus.base_drift maps ""/UNKNOWN to :unknown, which that check
  # passes over in silence. So the one signal in hand says nothing precisely when
  # nothing is configured to make it speak.
  #
  # :no_movement_seen is NEVER rendered as "the base is current" — with an unfetched
  # ref this can only UNDERSTATE movement, so the absence of a finding is not a
  # freshness certificate. Reporting it as one would be this task's own defect, one
  # level down.
  # base_branch is resolved ABOVE, before the drift refusal that also names it — see the
  # hoist comment there for why that ordering is load-bearing rather than tidy.
  base_check = ReviewTreeGuard.base_assessment(root: diff_root, branch: zap_branch, base: base_branch)

  # ==== SEAM 2b: WAS THAT MOVEMENT INSIDE THE GREEN? (/tasks/gate-credits-a-stale-green)
  #
  # Seam 2 above says the base MOVED. What it never said is WHAT moved, or WHEN relative
  # to the run — so the report was unarguable-with, and reviewers settled it the one
  # cheap way available: FILE DISJOINTNESS, "the N commits `accepted` gained touch none
  # of my files."
  #
  # THAT ARGUMENT IS USUALLY RIGHT AND IT IS NOT THE SAME CLAIM as "the merged tree is
  # green". It comes apart in exactly one shape — a base commit that changes a TEST
  # GRADING this PR's code rather than a source file this PR shares. Disjointness is then
  # TRUE AND IRRELEVANT.
  #
  # MEASURED (Carl, PR #1258, 2026-09-07): the `accepted` tip landed 07:59:02Z, 3.3
  # minutes AFTER that PR's CI completed 07:55:44Z, carrying +117/-17 to
  # test/lib/dor_check_exempt_ci_test.rb — the guard that PR's whole design leaned on.
  # 12/12 green, and the green said nothing about the combination. Safe only because a
  # reviewer built the merge preview by hand.
  #
  # THE SPLIT OF SEVERITIES IS THE DESIGN, and it is what keeps the two claims apart:
  #   movement, any shape      REPORTS, now NAMED (commits, files, and the clock verdict)
  #                            so the disjointness argument can be made FROM the verdict.
  #   a late SHARED GUARD      REFUSES — the one shape disjointness cannot settle.
  # Refusing on movement alone would wedge the lane on every busy night; staying silent
  # on the guard case is the defect being fixed. Neither half is the other's default.
  #
  # AUTOMATIC, not a flag. This is gate-zero for every review, and the reviewer who most
  # needs the question asked is the one who does not know to ask it — an opt-in switch
  # makes correctness a thing you have to remember, which is the same reasoning that kept
  # the multi-PR CI read (dor-check-reads-one-pr) off a --repo flag.
  # WHOSE CLOCK IS THIS? On a multi-repo task `ci` is the GOVERNING (worst) PR's verdict,
  # which may belong to a DIFFERENT repo than diff_root — and comparing another repo's
  # run clock against this repo's base movement is not a comparison, it is a coincidence.
  # An earlier foreign clock would call this repo's covered commits uncovered and refuse
  # correct work; a later one would hide a real gap.
  #
  # There is no repo→root map on this path (deriving one across worktrees and gems is a
  # different task), so the honest move is to ask only when the answer is unambiguous:
  # ONE PR read means the clock is this PR's. More than one and the clock goes UNREAD —
  # the movement is still named, the unmade check is still declared, and nothing refuses.
  # That is the status quo plus better naming, which is the correct direction for a
  # question this gate cannot currently pose.
  #
  # This deliberately does NOT touch the secondary-repo cert bar: that bar is about which
  # CERT a repo owes, this is about which CLOCK a comparison may use, and nothing here
  # relaxes the former.
  ci_clock_ambiguous = task_ci_reads.size > 1
  ci_completed_at = ci_clock_ambiguous ? nil : (ENV["DOR_CHECK_CI_COMPLETED_AT"] || (ci && ci[:completed_at]))
  # WHICH TREE DID THE GREEN TEST? (/tasks/stale-merge-ref-passes-freshness) The run tested
  # the merge ref GitHub built when it was TRIGGERED, so "covered" is ancestry against the
  # base that ref was built on — never the completion clock above, which calls every base
  # commit landing mid-run covered. Same one-PR rule as the clock: a foreign run's base is
  # not evidence about this tree. A live read only when CI itself was read live.
  ci_injected = !ENV["DOR_CHECK_CI_STATUS"].to_s.strip.empty? || !ENV["DOR_CHECK_CI_STATUS_BY_REPO"].to_s.strip.empty?
  tested_base = if ci_clock_ambiguous
                  { state: :unresolved, reason: :multi_pr }
                else
                  MergeRefBase.resolve(task_ci_verdict(devops)[1],
                                       BaseMovementAudit.rev(diff_root, "origin/#{zap_branch}", zap_branch),
                                       injected: ENV["DOR_CHECK_CI_TESTED_BASE"], live: !ci_injected)
                end
  movement = BaseMovementAudit.assess(
    root: diff_root, branch: zap_branch, base: base_branch,
    changed_files: changed_files, ci_completed_at: ci_completed_at, tested_base: tested_base[:sha]
  )
  if movement[:state] == :moved && movement[:window] == :unchecked
    movement[:window_reason] ||= tested_base[:reason]
  end

  # INDEPENDENT OF base_check ON PURPOSE. ReviewTreeGuard.base_assessment and this audit
  # are two SEPARATE readers over the same refs, and base_movement_detail — the only other
  # place the audit is rendered — hangs off base_check[:state] == :moved. Reporting the
  # unobservable state from inside that branch would keep the audit silent in exactly the
  # case where BOTH reads failed, which is the LIKELIEST one, because they fail for the
  # same reason. So this stands alone, and test/lib/dor_check_base_movement_test.rb pins
  # that it still speaks when the base-moved suggestion does not fire at all.
  if review_role && movement[:state] == :unobservable
    suggestions << base_audit_unobservable(movement, base_branch, zap_branch, diff_root)
  end

  if review_role && base_check[:state] == :moved && ci_error.nil?
    behind = base_check[:behind_by]
    suggestions << "the base has MOVED since this branch last took it — origin/#{base_branch} is at " \
      "#{base_check[:base_sha][0, 12]}#{behind ? " (#{behind} commit(s) ahead of this branch)" : ""}, and it " \
      "is not an ancestor of #{base_check[:branch_ref]}. Every check that ran against the old merge describes " \
      "a tree this merge will not produce — including the e2e DECLARED-vs-EXECUTED set, whose expected count " \
      "lives in config/e2e_lane.yml and can be changed by the very merge that moved the base. Re-derive it " \
      "before trusting the spec counts, or update the branch (git rebase origin/#{base_branch}) and let CI " \
      "re-run. Re-derived from LOCAL refs, which this gate never fetches, so this is a floor on the movement, " \
      "not a measure of it.#{base_movement_detail(movement, base_branch, ambiguous_clock: ci_clock_ambiguous)}"
  end

  # THE REFUSAL. Green CI, and the base gained — after the run finished — a change to a
  # test that grades this PR's own code. No local run clears it: it grades the DESK
  # tree, which is not the merged tree either, so it answers a different question than
  # the one being refused.
  if review_role && ci_error.nil? && ci[:state] == :green && movement[:state] == :moved &&
     movement[:guards].any?
    errors << stale_green_refusal(movement, base_branch)
    ci_refused = true
  end

  # Everything the CI gate refuses lands NOW, in error order, in both roles. The
  # deferral this used to carry — a no-verdict refusal held back until the suite
  # gate could say whether a FULL cert stood in for it — is gone with the cert.
  if ci_error
    errors << ci_error
    ci_refused = true
  end
end

# ==== THE SUITE EVIDENCE, IN ITS ONE FORM ======================================
#
# Recorded for the --json payload and the human ready line, so a monitor can ask
# "what carried the suite half of this verdict?" and get one answer: the CI state,
# the head it was read for, and whether it satisfied the gate. `satisfied` is
# GREEN *and* unrefused — review's stale-green check can refuse a green, and a
# refused green is not evidence.
suite_evidence = nil
if gate != "build" && ci
  suite_evidence = {
    form: CiGate::SUITE_EVIDENCE_FORM,
    satisfied: ci_error.nil? && ci[:state] == :green,
    state: ci[:state],
    head: ci[:head_oid],
    waiting: ci_waiting
  }.compact
end

# The CI row the gates card shows, resolved ONCE here so the durable GateRun sop and
# the --json payload cannot disagree — and so it is observable (and testable) without
# a board write, which --json and --file both skip by design.
ci_gate_result = CiGate.gate_row(ci, review_role: review_role, review_refused: ci_refused)

# ==== `required_evidence: [control]` — the question a tier list cannot ask ======
#
# For a test-only change the reviewer's real question is not "which tiers did you
# run" but "DOES THE CHANGED TEST STILL BITE?" — and both builders who hit this gap
# answered it unprompted, one with a control (the pre-change file against the fixed
# engine: exactly 1 failure, at exactly the deleted line) and one with a mutation
# (force a 404, watch the new diagnostic print the URL).
#
# THE CONTROL IS NOW EXECUTED FOR THE HALF THAT CAN BE — and that half is the one
# the shape's own claimability rule makes sound. Because `claimable_when:
# test_only_diff` refuses the shape unless EVERY changed path is provably test
# content, production code at the base is byte-identical to production code at
# HEAD. So the pre-change version of a changed test file can be replayed against
# current production code, and bin/control-check does exactly that, stamping a
# fingerprint-bound `[control@<fp>]` line this gate re-grades (bin/lib/
# control_replay.rb owns the partition and the verdict tokens).
#
# TWO POPULATIONS, TWO CONTRACTS — the config says which is which, and so does the
# refusal text below, because the builder's next action differs:
#
#   REPLAYABLE (a pre-change version + a runner here — measured at ~79% of this
#   repo's test-only history): an EXECUTED, fresh stamp is required. Prose alone no
#   longer satisfies, which is the whole point of this gate change: a
#   structurally-valid control nobody ran is a declaration, and declarations
#   standing in for evidence is the disease this file's header is about.
#
#   NOT REPLAYABLE (added files, which have no pre-change version at all; e2e/ and
#   tests/, which need a booted server or a funded validator): the author's
#   `[control]` line stays the requirement, unchanged. No stamp is invented for
#   them — the e2e_onchain removal in config/feature_shapes.yml is the standing
#   lesson on what a lane that runs nothing costs.
#
# THE VERDICT NEVER REFUSES. `old GREEN` (NO-SIGNAL) means the replay distinguished
# nothing — and a rename, a move, a consolidation and a quietly deleted assertion
# ALL look like that. Refusing there would land on legitimate work, and a gate that
# refuses correct work teaches people to stop claiming the shape (taking its real
# checks with it). So NO-SIGNAL asks the author for the one thing the machine
# cannot supply: the sentence saying which of those it is. A sentence is a cheap
# ask; a false refusal is not. This is an evidence gate, not a safety gate.
#
# Build gate exempt: the control is a BUILD artifact, unknowable at design time —
# the same reason local_url and the tiers are not asked for there.
if gate != "build" && Array(shape_def && shape_def["required_evidence"]).include?("control")
  control_lines = checks.select { |line| line.to_s =~ /\A\s*\[\s*control\s*[\]:]/i }
  observed = changed_files
  # The machine's stamp, graded by the fingerprint machinery the certs used to share
  # — so in the review lane it grades against the task BRANCH's committed tree, not
  # the reviewer's checkout (control_fingerprint), and a tree nobody can hash is
  # :missing rather than a synthesised :fresh.
  control_lane, verdict = control_evidence_status(checks, control_fingerprint)
  replayable = control_replayable_files(observed)

  if replayable.any? && control_lane != :fresh
    stale = control_lane == :stale
    errors << "shape #{shape.inspect} requires an EXECUTED control, and #{replayable.size} changed file(s) " \
      "CAN be replayed (#{replayable.first(3).join(', ')}#{replayable.size > 3 ? ', …' : ''}) — " \
      "#{stale ? 'the recorded control is STALE (it was run against different code)' : 'none is recorded'}. " \
      "Run `bin/control-check #{task["slug"] || slug}` — it replays those files' PRE-CHANGE content against " \
      "current production code (sound because this diff is 100% test code) and records a fingerprint-bound " \
      "[control@<fp>] line. It does not refuse on the result; it records what it saw"
  elsif control_lines.empty? && control_lane != :fresh
    errors << "shape #{shape.inspect} requires a [control] line in checks_run — the evidence that answers " \
      "\"does the changed test still bite?\", which is the question a tier list cannot ask about a diff " \
      "with no behavior in it. Nothing in this diff is automatically replayable (an added file has no " \
      "pre-change version; e2e/ and tests/ have no runner here), so this half is yours: run the control and " \
      "record what you SAW, e.g. #{TASK_CMD} update #{task["slug"] || slug} --checks '[control] pre-change " \
      "test/integration/hub_test.rb at HEAD → 1 failure at line 42 (the assertion I deleted); post-change " \
      "green' — or, for added coverage, the mutation you forced and the failure it produced"
  elsif control_lines.any? && observed.any? &&
        control_lines.none? { |line| control_names_a_changed_file?(line, observed) }
    sample = observed.first(3).join(", ") + (observed.size > 3 ? ", …" : "")
    errors << "the [control] line names no file from this diff, so it is not evidence ABOUT this change — " \
      "a control that could have been written before the change was made is a sentence, not a result. " \
      "Name the test file you controlled (one of: #{sample}) along with the command you ran and the " \
      "failure you observed"
  end

  # A NO-SIGNAL replay is the dangerous-looking case, and it is ALSO what a rename
  # or a consolidation produces. The machine cannot tell them apart, so it does not
  # try to — it hands the reviewer a machine-observed fact and asks the author for
  # the sentence that disambiguates it. Refusal here is for the MISSING sentence,
  # never for the verdict.
  if control_lane == :fresh && verdict == ControlReplay::NO_SIGNAL && control_lines.empty?
    errors << "the executed control came back NO-SIGNAL: the pre-change test PASSED against current " \
      "production code, so the replay proves nothing about whether this change was needed. That is what a " \
      "rename, a move, a consolidation AND a silently-deleted assertion all look like — the machine cannot " \
      "tell them apart, and it is not refusing your change for it. Add the sentence that can: bin/task " \
      "update #{task["slug"] || slug} --checks '[control] <file> → renamed/consolidated/… , coverage " \
      "preserved because …'"
  end
end

# ==== BROWSER EVIDENCE — did a browser ever SEE the browser code? ==============
#
# Three defects in 24 hours passed every gate in this file and were caught by a
# human or a reviewer opening a browser: a paint-time navbar jump, a timezone flag
# wrong in Chrome and Safari but not Firefox, and a script that never ran in any
# browser. bin/lib/client_surface_diff.rb's header carries all three. The common
# fact: every tier this repo demands renders to a String, and none of them runs a
# browser, so none of them could have seen any of it.
#
# THIS BLOCK IS DRIVEN BY THE DIFF, NOT BY THE SHAPE — deliberately, and unlike its
# two neighbours. `claimable_when` and `required_evidence` hang off shape_def
# because they qualify a shape the author CLAIMED. Browser code is not a shape: it
# arrives under `ui-only`, under `backend` (a job's status partial), under
# `library`. Keying this on a shape key would mean the author selects whether the
# gate applies, which is the `kind: chore` bug this file's header opens with —
# a check you satisfy by DECLARING a label is not a check.
#
# THREE OUTCOMES, AND THE LINE BETWEEN THEM IS WHAT THE MACHINE CAN PROVE:
#
#   BLOCK   the diff ADDS an imperative browser program (an inline <script> body,
#           a served .js) and no browser spec changed with it, IN A REPO THAT HAS
#           A LANE. New arbitrary code, zero browser observation, and a remedy the
#           author can actually reach.
#   REPORT  everything else it can see: an added declarative BINDING (Alpine,
#           Stimulus, an on* handler); a changed file that CARRIES a program the
#           diff did not add (defect 3 proves a mere ERB comment edit can kill a
#           script); or an added program in a repo with NO browser lane, where
#           blocking would be a refusal with no remedy.
#   SILENT  the detector can point at nothing. Not "probably fine" — nothing was
#           OBSERVED, and dor-check already fails closed on an unobservable diff
#           upstream (resolve_branch_diff → :indeterminate), so this block does not
#           re-refuse what that gate already holds.
#
# That three-way split IS the answer to "can it tell no-evidence from no-surface".
# It never demands a spec it cannot name a reason for, and the reason is printed.
#
# THE ESCAPE HATCH IS A RECORD, like the post_deploy "none" hatch: a
# "[browser-bypass] <reason>" line in checks_run is honored and flagged loudly. A
# gate with no hatch gets routed around silently; a gate whose hatch is a visible,
# reviewable line gets routed around ON PURPOSE, in front of a reviewer.
if gate != "build"
  observed_client = changed_files
  head_contents = client_file_contents(observed_client) { |p| ClientSurfaceDiff.template?(p) }
  base_contents = client_base_contents(observed_client)
  added_all = ClientSurfaceDiff.added_surfaces(observed_client, head_contents, base_contents)
  programs = added_all.select(&:program?)
  bindings = added_all.reject(&:program?)

  spec_contents = client_file_contents(observed_client) { |p| ClientSurfaceDiff.browser_spec?(p) }
  browser_evidence = ClientSurfaceDiff.evidence_specs(observed_client, spec_contents)
  bypass = checks.find { |line| line.to_s =~ /\A\s*\[\s*browser-bypass\s*[\]:]/i }
  lane = ClientSurfaceDiff.lane_present?(diff_root)

  if programs.any? && browser_evidence.empty?
    sample = programs.first(3).map { |s| "#{s.reason} in #{s.path}" }.join("; ")
    more = programs.size > 3 ? ", …" : ""

    if bypass
      suggestions << "⚠ BROWSER-EVIDENCE GATE BYPASSED: #{bypass.to_s.strip}. This diff adds " \
        "#{programs.size} browser program(s) (#{sample}#{more}) with no e2e spec. The bypass is honored " \
        "and recorded; a reviewer can see it."
    elsif lane
      errors << "this diff ADDS browser code and no browser ever saw it run: #{sample}#{more} " \
        "[source: #{diff_source}]. Every tier this shape demands renders to a String — which is how a " \
        "paint-time navbar jump, a timezone flag wrong in two engines, and a script swallowed by a " \
        "phantom element all shipped green in one 24-hour window. The sharpest of the three had a guard " \
        "test, `assert_includes html, \"__atTimeFmt\"`, that PASSED on the broken page because the token " \
        "survived inside the text the phantom element ate; a String assertion cannot observe a script " \
        "RUNNING. Add or extend a Playwright spec under e2e/ that drives this surface and asserts " \
        "something only a live browser can produce (a computed style, a post-interaction DOM state, a " \
        "page.evaluate result) — NOT that a token appears in the markup. The lane's runtime executed-set " \
        "gate (config/e2e_lane.yml) then proves it actually ran. If a browser genuinely cannot reach " \
        "this code, record why: #{TASK_CMD} update #{task["slug"] || slug} --checks '[browser-bypass] " \
        "<reason>'"
    else
      suggestions << "BROWSER-EVIDENCE HOLE (reported, not blocking): this diff adds #{programs.size} " \
        "browser program(s) — #{sample}#{more} — and THIS REPO HAS NO BROWSER LANE: it carries neither " \
        "an e2e/ directory nor a config/e2e_lane.yml, which is the pair lane_present? reads off disk on " \
        "every run. So there is no evidence to demand, and refusing would be a refusal with no remedy. " \
        "Two of the three defects that motivated this gate slipped through this same hole. The remedy " \
        "is to STAND A LANE UP, and it has been done before: studio-engine added one on 2026-08-12 — a " \
        "playwright.config.js with testDir e2e/, plus a CI job that runs it — and this gate began " \
        "BLOCKING there the day that directory landed, with no edit to bin/dor-check. Until this repo " \
        "has a lane, a reviewer opening a browser is the only thing between this code and production."
    end
  end

  if bindings.any? && browser_evidence.empty?
    sample = bindings.first(2).map { |s| "#{s.reason} in #{s.path}" }.join("; ")
    suggestions << "browser evidence (suggestion only): this diff adds #{bindings.size} client " \
      "binding(s) — #{sample}#{bindings.size > 2 ? ", …" : ""}. Declarative bindings are NOT blocked " \
      "here: they are the most common thing a UI diff adds, their arguments are visible to the markup " \
      "assertions this repo already writes, and blocking them would make the cheapest shape the most " \
      "expensive. If this binding carries real interaction logic, an e2e spec is still the only tier " \
      "that will ever see it work."
  end

  present = ClientSurfaceDiff.present_surfaces(
    observed_client, head_contents, base_contents
  ).select(&:program?)

  if present.any? && programs.empty? && browser_evidence.empty?
    sample = present.first(2).map(&:path).join(", ")
    suggestions << "browser evidence (suggestion only): this diff changes #{present.size} file(s) that " \
      "CARRY an inline <script> without adding one — #{sample}#{present.size > 2 ? ", …" : ""}. Worth a " \
      "look because an edit that adds no script can still kill one: the propagate-at-format-gem defect " \
      "was an ERB COMMENT that terminated early, leaking prose whose literal script tag opened a phantom " \
      "element that swallowed the real script in every browser."
  end
end

ready = errors.empty? && missing_meta.empty? && missing_tiers.empty?

# More non-blocking SUGGESTIONS (the list starts at the CI gate above). The
# canonical post_deploy_cmd form is the paren-free `bin/rails runner <path>` —
# `rails runner` accepts a file path directly. A valid-but-fragile
# `runner "load Rails.root.join(...)"` command is the shape that made the
# seed-54 ship brittle through `heroku run`, so we nudge toward the canonical
# form WITHOUT rejecting the (working) command.
if present?(post_deploy_cmd) && fragile_runner_load?(post_deploy_cmd)
  path = canonical_runner_path(post_deploy_cmd)
  canonical = path ? "bin/rails runner #{path}" : "bin/rails runner <path>"
  suggestions << "devops.post_deploy_cmd uses the fragile `runner \"load Rails.root.join(...)\"` form — " \
    "rails runner accepts a file path directly, so the canonical paren-free command is `#{canonical}` " \
    "(the parens/quotes are what made the seed-54 ship brittle through `heroku run`). Suggestion only — " \
    "the current command is valid and not blocking."
end

if gate_emission_enabled?(options, gate, slug)
  gate_sops = [{ "sop" => "dor-check", "cmd" => "bin/dor-check #{slug} --gate #{gate}", "result" => ready ? "pass" : "fail" }]
  unless dor_tiers.empty?
    gate_sops << { "sop" => "tiers", "tier" => dor_tiers.join("+"), "result" => missing_tiers.empty? ? "pass" : "fail" }
  end
  if ci
    # The `ci` sop IS the suite evidence now. A builder-side WAIT closes the attempt
    # `--failed` with this row reading "pending" (GateRun's in-flight glyph), so the
    # card shows a wait, not a red; the AUTHORITATIVE verdict lands on `dor_review`
    # via the review gate-zero. One verdict per gate; no DoR row lingers in flight.
    repo = CiStatus.repo_from_pr_url(governing_ci_pr_url(devops))
    gate_sops << { "sop" => "ci", "result" => ci_gate_result }.merge(CiStatus.gate_evidence(ci, repo: repo))
  end
  emit_gate_verdict(slug, ready, options[:gate_role], gate_sops)
end

# --- output ---------------------------------------------------------------

if options[:json]
  puts JSON.pretty_generate(
    task: task["slug"] || slug,
    shape: shape.empty? ? nil : shape,
    gate: gate,
    ready: ready,
    errors: errors,
    suggestions: suggestions,
    missing_metadata: missing_meta,
    missing_tiers: missing_tiers,
    # The checkout the DIFF was read from (after the root guard's re-root) — the ONE
    # fact that made the 2026-07-14 false STALE unreadable when it was absent. The
    # `test-only` control stamp may be graded against a committed BRANCH TREE instead
    # (the review lane, and the reclaimed-worktree remedy — control_fingerprint), so
    # this root is the diff's, not necessarily the stamp's.
    code_root: diff_root,
    # WHICH TREE the diff above was actually read from — the fact that made the
    # 2026-08-08 false pass invisible while it was happening. "git working tree" from
    # a root that is not the task's is precisely the bug, so a monitor can now assert
    # the pairing (code_root + diff_source) instead of trusting the verdict. nil at
    # the build gate, which resolves no diff (and must not shell `gh` to make one).
    diff_source: gate == "build" ? nil : diff_source.to_s,
    changed_files: gate == "build" ? nil : changed_files,
    # WHICH PRs THIS VERDICT READ — one row per recorded PR, with the files it
    # contributed and its OWN CI state. Before this existed a two-repo verdict was
    # indistinguishable from a one-repo verdict in the JSON, which is what let a gate
    # that graded half the work report a full one (/tasks/dor-check-reads-one-pr).
    pr_coverage: gate == "build" ? nil : pr_coverage,
    # HOW THE PR READ WENT — the machine-readable half of the alert above, and the
    # field that makes "did this verdict grade the PR or a stand-in?" answerable from
    # the JSON alone. Present only when the read FAILED (:unreadable / :unverified);
    # :ok / :no_pr / :empty are the ordinary states and stay silent.
    pr_read: gate == "build" || !pr_read_alert ? nil : pr_file_read.slice(:state, :cause, :reason).compact,
    ci: ci && { state: ci[:state], cause: ci[:cause], reason: ci[:reason], failing: ci[:failing],
                pending: ci[:pending], count: ci[:count] }.compact,
    # The gates-card row this run WOULD write (--json skips the board write). Exposed
    # so "what the card will say" is inspectable and testable without a durable
    # attempt row — a probe that leaves a FAILED row on a real task is its own hazard.
    ci_gate_result: ci_gate_result,
  # THE SUITE HALF OF THE VERDICT, in its one form (CiGate::SUITE_EVIDENCE_FORM):
  # the CI state, the head it was read for, and whether it satisfied the gate. The
  # `full_suite` block that stood here — fingerprint, lanes, route, per-repo cert
  # verdicts — described receipts this gate no longer reads.
  suite_evidence: suite_evidence,
  ci_waiting: ci_waiting
)
  exit(ready ? 0 : 1)
end

title = task["title"] || task["slug"] || slug || "(task)"
print_suggestions = -> { suggestions.each { |s| puts "  ⓘ suggestion: #{s}" } unless suggestions.empty? }
if ready
  puts "✓ #{gate_label} met for #{title.inspect} (shape: #{shape})"
  print_pr_coverage(gate)
  puts "  tiers green in checks_run: #{dor_tiers.join(", ")}" unless dor_tiers.empty?
  # SAY THE WAIVER OUT LOUD. A gate that skips a requirement in SILENCE reads,
  # to every human and every log scraper, exactly like a gate that enforced one
  # and passed. That is not a presentation nit — it is why the `docs` hole
  # (/tasks/docs-shape-admits-test-code) survived to be found by accident rather
  # than by any of the readers who had already seen the output. On PR #1172 this
  # verdict printed "✓ DoR-to-Merge met (shape: docs)" and one blank line where
  # the tier line goes, over a diff carrying a test file: nothing said a tier was
  # skipped, nothing said the suite cert was waived, and nothing said whether
  # anything had checked that the shape fit the diff.
  #
  # So a waived requirement now NAMES ITSELF, and names what (if anything)
  # earned it. The claim rule is printed even though it also refuses on its own,
  # because the reader's question is "was this checked?" — and only a printed
  # answer distinguishes "verified against the diff" from "nobody asked".
  #
  # Build gate excluded: it zeroes dor_tiers for EVERY shape by design (tiers are
  # build artifacts, unknowable at design time), so a waiver line there would fire
  # on every task and say nothing true about the shape.
  if gate != "build"
    waived = []
    waived << "no test tier required" if dor_tiers.empty?
    unless waived.empty?
      claim = shape_def && shape_def["claimable_when"]
      puts "  ⓘ shape #{shape}: #{waived.join(" · ")} — " +
           (claim ? "claim verified against the OBSERVED diff (#{claim}, #{changed_files.size} file(s) " \
                    "[source: #{diff_source}])"
                  : "nothing verified this claim against the diff")
    end
  end
# THE SUITE LINE. A ready verdict is only reachable on a GREEN CI now, so this is
# the one form the evidence line takes; the defensive else says out loud that a
# future reordering let something else through.
if suite_evidence && suite_evidence[:satisfied]
  head = ci[:head_oid].to_s
  puts "  GitHub CI green#{ci[:count] ? " (#{ci[:count]} checks)" : ""}#{head.empty? ? "" : " for head #{head[0, 12]}"} — " \
       "the settled verdict is the suite evidence"
elsif ci
  puts "  ⚠ GitHub CI #{ci[:state].to_s.upcase} — a ready verdict reached this line without a settled green; " \
       "read the CI gate before trusting it"
end
  puts "  → ready to advance #{boundary}"
  print_suggestions.call
  exit 0
end

# THE WAIT has its own headline: nothing refuses but an unsettled CI, so "NOT met"
# would send the reader hunting for a defect. bin/ship's step 7 reads exit 1 either
# way; the wording is for the reader, whose move is to come back once CI reports.
waiting_only = ci_waiting && errors == [ci_error] && missing_meta.empty? && missing_tiers.empty?
if waiting_only
  puts "⏳ #{gate_label} WAITING on CI for #{title.inspect}#{shape.empty? ? "" : " (shape: #{shape})"}"
  print_pr_coverage(gate)
  puts "  - #{ci_error}"
  puts "  → not ready to advance #{boundary} YET; re-run once CI reports"
  print_suggestions.call
  exit 1
end

puts "✗ #{gate_label} NOT met for #{title.inspect}#{shape.empty? ? "" : " (shape: #{shape})"}"
print_pr_coverage(gate)
errors.each { |e| puts "  - #{e}" }
unless missing_meta.empty?
  puts "  missing metadata:"
  missing_meta.each { |f| puts "    - devops.#{f}" }
end
unless missing_tiers.empty?
  puts "  missing test tiers (add a tagged checks_run line, e.g. \"[#{missing_tiers.first}] <command>\"):"
  missing_tiers.each { |t| puts "    - #{t}" }
end
puts "  → not ready to advance #{boundary}; resolve the above"
print_suggestions.call
exit 1
