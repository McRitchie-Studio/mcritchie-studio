<%# KIT ORIGINALS (task brand-kit-record; Alex: every kit keeps its original, so
    anyone can see where a derivation came from), on every tab of the brand
    page: the brand's original artwork or marketing kit as uploaded, unedited.
    Each file is listed with its name, type, size and upload date; an SVG, PNG
    or JPEG is shown as a picture, and every file has a download and a delete.
    Files are served from behind the admin wall (BrandKitsController#original),
    never from a storage URL. Plain forms. A refused upload re-renders the page
    with the reason in this card (BrandKitsController#create_original). A delete
    takes two steps with no script (task logo-gallery-polish-pass): Delete opens
    a disclosure (<details>) naming the file, whose own button deletes it, and
    the same control reads Cancel to close it again. The hub's storage keeps a
    purged file in trash for three days (StudioTrashS3).
    Locals: kit_record (the brand's BrandKit, saved or not). %>
<% ring = "focus-visible:outline-[#4338CA]! dark:focus-visible:outline-white!" %>
<% originals = kit_record.persisted? ? kit_record.originals.includes(:blob).order(:created_at, :id).to_a : [] %>
<section class="card p-4 sm:p-5 space-y-3 scroll-mt-28" id="kit-originals" data-test="kit-originals" aria-labelledby="kit-originals-title">
  <h2 id="kit-originals-title" class="text-sm font-bold text-heading">Kit originals</h2>
  <p class="text-sm text-secondary">The originals the logos were derived from.</p>
  <% if @original_refusal %>
    <p class="text-sm text-heading rounded-lg border border-subtle p-3" role="alert" data-test="kit-original-refused">Not uploaded: <%= @original_refusal %></p>
  <% end %>
  <% if originals.empty? %>
    <p class="text-sm text-muted" data-test="kit-originals-empty">No originals uploaded yet.</p>
  <% else %>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3" data-test="kit-original-list">
      <% originals.each do |original| %>
        <% kind = BrandKit::ORIGINAL_TYPES.fetch(original.content_type, original.content_type) %>
        <li class="min-w-0 rounded-lg border border-subtle p-3 space-y-2" data-test="kit-original" data-type="<%= kind %>">
          <% if BrandKit::PREVIEWABLE.include?(original.content_type) %>
            <div class="flex items-center justify-center rounded-md border border-subtle p-2 h-32">
              <%= image_tag brand_kit_original_path(kit_record.brand, original), alt: "Original: #{original.filename}", loading: "lazy",
                            class: "max-h-full max-w-full w-auto h-auto", data: { test: "kit-original-preview" } %>
            </div>
          <% end %>
          <div class="min-w-0">
            <p class="text-xs font-semibold text-heading break-all" data-test="kit-original-name"><%= original.filename %></p>
            <p class="text-2xs text-muted" data-test="kit-original-meta">
              <%= kind %> · <%= number_to_human_size(original.byte_size) %> · uploaded <%= original.created_at.strftime("%b %-d, %Y") %>
            </p>
          </div>
          <div class="flex flex-wrap items-start gap-2">
            <%= link_to "Download", brand_kit_original_path(kit_record.brand, original, download: 1), class: "btn btn-sm btn-neutral #{ring}",
                        data: { test: "kit-original-download", turbo: false }, aria: { label: "Download #{original.filename}" } %>
            <%# Step one opens the disclosure; it takes the row's whole width when open, so the question sits under it. %>
            <details class="group min-w-0 open:basis-full" data-test="kit-original-delete-disclosure">
              <summary class="btn btn-sm btn-neutral list-none cursor-pointer [&::-webkit-details-marker]:hidden <%= ring %>" data-test="kit-original-delete">
                <span class="group-open:hidden">Delete<span class="sr-only"> <%= original.filename %></span></span>
                <span class="hidden group-open:inline">Cancel<span class="sr-only"> deleting <%= original.filename %></span></span>
              </summary>
              <div class="mt-2 space-y-2 rounded-md border border-subtle p-2" data-test="kit-original-delete-ask">
                <p class="text-2xs text-secondary break-all">Delete <span class="font-semibold text-heading"><%= original.filename %></span> from the kit?</p>
                <%= button_to "Delete #{original.filename}", brand_kit_original_path(kit_record.brand, original), method: :delete,
                              params: logo_page_params.slice(:type, :context), class: "btn btn-sm btn-danger max-w-full break-all #{ring}",
                              form: { data: { turbo: false } }, data: { test: "kit-original-delete-confirm" } %>
              </div>
            </details>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
  <%= form_with url: brand_kit_originals_path(kit_record.brand), multipart: true, class: "flex flex-wrap items-center gap-2",
                data: { test: "kit-original-form", turbo: false } do %>
    <% logo_page_params.slice(:type, :context).each do |name, value| %><%= hidden_field_tag name, value, id: nil %><% end %>
    <label class="sr-only" for="kit-original-files">Original files</label>
    <%= file_field_tag "originals[]", multiple: true, id: "kit-original-files", accept: ".svg,.png,.jpg,.jpeg,.pdf,.zip,#{BrandKit::ORIGINAL_TYPES.keys.join(',')}",
                       class: "min-w-0 max-w-full text-xs text-secondary", data: { test: "kit-original-input" } %>
    <%= submit_tag "Upload", name: nil, class: "btn btn-sm btn-primary #{ring}", data: { test: "kit-original-upload", disable_with: false } %>
  <% end %>
  <p class="text-2xs text-muted">SVG, PNG, JPEG, PDF or ZIP, up to <%= BrandKit::MAX_ORIGINAL_BYTES / 1.megabyte %> MB each. A file's type is read from its contents, not its name.</p>
</section>
