<%# One dream as an expanding card: the question is the summary; opening it shows
    the answer, why, story, tags, status and source. Native <details>, so it opens
    without JavaScript; app/javascript/dreams_filter.js hides it by data-status. %>
<%# Alex's pending approval (DreamApproval) and the heat count (DreamHeat) come from
    the controller; the file still reads proposed until the batch task writes it. %>
<% proposed = dream.status == DreamOrgChart::PROPOSED %>
<% approval = proposed ? @approvals.to_h[DreamApproval.key_for(dream)] : nil %>
<% fires = @heat ? @heat.count(dream.slug) : 0 %>
<details class="group rounded-lg border border-subtle bg-surface-alt/60 open:border-primary/40 transition"
         id="dream-<%= dream.slug %>"
         data-test="dream-card" data-dream="<%= dream.slug %>" data-status="<%= dream.status %>"
         <%= "hidden" unless @filter.nil? || @filter == "all" || @filter == dream.status %>>
  <summary class="flex cursor-pointer list-none items-start gap-2 p-3 [&::-webkit-details-marker]:hidden">
    <span aria-hidden="true" class="mt-0.5 inline-block text-muted transition group-open:rotate-90">&#9656;</span>
    <span class="min-w-0 flex-1 text-sm font-semibold leading-snug text-heading"><%= dream.question %></span>
    <% if fires.positive? %>
      <span class="badge shrink-0 text-3xs bg-primary/10 text-primary border-primary/40" data-test="dream-fire-count"
            title="Decisions this dream shaped (bin/dream fired)"><%= fires %> fired</span>
    <% end %>
    <% if approval %>
      <span class="badge max-w-[40%] text-3xs bg-success/10 text-success-ink border-success/40" data-test="dream-approved-pending-badge">Approved, loads after the next release</span>
    <% elsif proposed %>
      <span class="badge shrink-0 text-3xs bg-warning/10 text-warning border-warning/40" data-test="dream-proposed-badge">Proposed</span>
    <% elsif dream.status != DreamOrgChart::APPROVED %>
      <span class="badge shrink-0 text-3xs bg-surface-alt text-muted border-subtle"><%= dream.status.presence || "no status" %></span>
    <% end %>
  </summary>
  <div class="space-y-3 border-t border-subtle px-3 pb-3 pt-3 text-sm" data-test="dream-detail">
    <div>
      <p class="text-2xs font-bold uppercase tracking-wide text-muted">Answer</p>
      <p class="text-body" data-test="dream-answer"><%= dream.answer %></p>
    </div>
    <% if dream.why.present? %>
      <div>
        <p class="text-2xs font-bold uppercase tracking-wide text-muted">Why</p>
        <p class="text-body" data-test="dream-why"><%= dream.why %></p>
      </div>
    <% end %>
    <% if dream.story.present? %>
      <div class="prose-themed text-sm [&_h1]:text-base [&_h2]:mt-3 [&_h2]:text-sm [&_h2]:font-bold [&_h3]:text-sm" data-test="dream-story"><%= dream_story_html(dream.story) %></div>
    <% end %>
    <% decisions = @heat ? @heat.decisions(dream.slug) : [] %>
    <% if decisions.any? %>
      <div data-test="dream-decisions">
        <p class="text-2xs font-bold uppercase tracking-wide text-muted">Fired <%= pluralize(fires, "time") %> · recent decisions</p>
        <ul class="mt-1 space-y-1">
          <% decisions.each do |decision| %>
            <li class="text-body" data-test="dream-decision">
              <%= decision.summary %>
              <span class="text-2xs text-muted">· <%= decision.occurred_at&.to_date&.iso8601 %><%= " · #{decision.task_slug}" if decision.task_slug.present? %></span>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <div class="flex flex-wrap items-center gap-1.5" data-test="dream-tags">
      <span class="badge text-3xs <%= proposed ? "bg-warning/10 text-warning border-warning/40" : "bg-primary/10 text-primary border-primary/40" %>" data-test="dream-status"><%= dream.status.presence || "no status" %></span>
      <% dream.tags.each do |tag, values| %>
        <% values.each do |value| %>
          <span class="badge text-3xs bg-surface-alt text-secondary border-subtle"><%= tag %>: <%= value %></span>
        <% end %>
      <% end %>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-2 text-2xs text-muted">
      <span><%= dream.source.presence || "no source recorded" %></span>
      <%= link_to "Open file", doc_path(DreamOrgChart.doc_path_for(dream)), class: "font-semibold text-primary hover:underline", data: { test: "dream-file-link" } %>
    </div>
    <% if approval %>
      <p class="text-2xs text-muted" data-test="dream-approval-note">
        Approved <%= approval.approved_at.to_date.iso8601 %>. The next batch task writes it into the file
        (<code>bin/dream apply-approvals</code>), and it loads once that release ships.
      </p>
    <% elsif proposed && @approver %>
      <%= button_to "Approve", dream_approvals_path,
            params: { dream_home: dream.home, dream_slug: dream.slug, status: (@filter == "all" ? nil : @filter) }.compact,
            class: "btn btn-primary btn-sm", form: { data: { test: "dream-approve-form" } },
            data: { test: "dream-approve" } %>
    <% end %>
  </div>
</details>
