<%# The inspection gate. Shows when workflow is rapper_replace and the three
    artifacts have not yet been approved.

    The decision per slot is the point of this screen: a player's face does not
    change week to week, only the jersey does, so most weeks this should read
    "reuse, reuse, re-skin" rather than "generate three". %>
<%
  plan  = Content::ArtifactPlan.new(@content)
  slots = plan.slots
  ready = plan.ready?
%>
<div class="card p-6 border-2 border-primary/40 space-y-5">
  <div class="flex items-center justify-between">
    <p class="label-upper text-primary">🖼 Artifact Inspection</p>
    <span class="text-xs text-muted">you approve before any video is made</span>
  </div>

  <%# THE COLORWAY. Guessed from home/away and labelled as a guess — an
      unconfirmed guess that looks confirmed is how a wrong jersey ships. %>
  <div class="rounded-lg bg-surface-alt p-4 space-y-3">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="label-upper text-muted">Jersey</span>
      <span class="text-heading font-bold text-lg"><%= plan.colorway || "unknown" %></span>
      <% if plan.colorway_guessed? %>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-900/50 text-amber-300 border border-amber-700/50">
          GUESSED FROM HOME/AWAY
        </span>
      <% else %>
        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-900/50 text-emerald-300 border border-emerald-700/50">
          CONFIRMED
        </span>
      <% end %>
    </div>

    <%= form_with url: set_colorway_content_path(@content.slug), method: :post,
                  class: "flex items-center gap-2 flex-wrap" do |f| %>
      <%= f.text_field :colorway, value: plan.colorway,
            placeholder: "white · primary · black · throwback",
            class: "input-field text-sm w-64" %>
      <%= f.submit "Confirm jersey", class: "btn-secondary text-sm" %>
      <span class="text-xs text-muted">changing this re-decides every slot below</span>
    <% end %>
  </div>

  <%# THE THREE SLOTS. %>
  <div class="space-y-3">
    <% slots.each_with_index do |slot, slot_index| %>
      <div class="rounded-lg border border-subtle p-4 flex gap-4">
        <div class="w-28 h-28 shrink-0 rounded-md bg-surface-alt border border-subtle overflow-hidden flex items-center justify-center">
          <%# THE PICTURE IS THE CELL OCCUPANT, never the recolor source. On a
              :reskin `slot.artifact` is another colorway's asset, so rendering
              it here showed the operator a jersey from a different game and hid
              the image he had just filed — on a mixed cast permanently, because
              the refusal keeps that slot on :reskin however many images he
              attaches. The look we would recolor FROM is named in words by
              `slot.detail`; this frame is reserved for what is actually on file. %>
          <% if slot.filled? %>
            <%= image_tag slot.occupant.image_url, class: "object-cover w-full h-full" %>
          <% else %>
            <span class="text-3xl opacity-40">🖼</span>
          <% end %>
        </div>

        <div class="flex-1 min-w-0 space-y-2">
          <div class="flex items-center gap-2 flex-wrap">
            <span class="text-heading font-bold"><%= slot.label %></span>
            <% scheme = slot.reuse? ? "bg-emerald-900/50 text-emerald-300 border-emerald-700/50"
                      : slot.reskin? ? "bg-amber-900/50 text-amber-300 border-amber-700/50"
                      : "bg-rose-900/50 text-rose-300 border-rose-700/50" %>
            <span class="px-2 py-0.5 rounded text-[10px] font-bold border <%= scheme %>">
              <%= slot.status_label.upcase %>
            </span>
          </div>

          <p class="text-sm text-muted">
            <%= slot.cast_label %> — <%= slot.detail %>
          </p>
          <%# Each subject's own look. A mixed cast carries different looks in
              one frame, which is why appearance lives here and not on the artifact. %>
          <p class="text-xs text-muted">
            <% slot.subjects.each do |row| %>
              <span class="mr-2"><%= row[:name] %>: <%= row[:appearance]&.descriptor || "no look" %></span>
            <% end %>
          </p>

          <%# A stable hook for the e2e: selecting these forms positionally picked
              the wrong one, and the failure then looked like a disabled button
              rather than a mis-selected form. %>
          <%= form_with url: attach_artifact_content_path(@content.slug), method: :post,
                        data: { test: "attach-#{slot.kind}", slot_decision: slot.decision },
                        class: "flex items-center gap-2 flex-wrap" do |f| %>
            <%= f.hidden_field :slot_index, value: slot_index %>
            <%# text_field, NOT url_field. The app accepts a RELATIVE path (local
                demo assets are served from /public), but HTML5 type=url refuses
                one — the browser blocks the submit and no request is ever made.
                Integration tests bypass the browser, so they cannot see it; the
                e2e is what caught it. An input must not reject what the server
                stores. %>
            <%= f.text_field :image_url, placeholder: "paste the image URL",
                  class: "input-field text-xs w-72" %>
            <%# The label shares the CONTROLLER's own source of truth: the attach
                retires `slot.occupant`, which is now also the row this card
                renders. Testing the RECOLOR SOURCE's presence read "Replace"
                while the attach was about to KEEP that artifact and file a
                second one beside it. Ask the question the button actually
                answers — does this click destroy a row?

                `slot.reuse?` ANSWERED THAT QUESTION ONLY WHILE THE RETIRE WAS
                SPELLED `if slot.reuse?`. Once the retire began naming its own
                target, the label went on asking the old question and inverted
                itself again: a lookless artifact under a named colorway reads
                :reskin, so the button said "Attach" while the click retired the
                very image on the card. Measured 2026-09-23. It is the same
                defect this comment was written about, arriving from the other
                side — which is the argument for asking the slot directly rather
                than for any predicate that merely correlates. %>
            <%= f.submit slot.replaces_filed_artifact? ? "Replace" : "Attach",
                  class: "btn-secondary text-xs" %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if slots.empty? %>
      <p class="text-sm text-muted">
        No players on this content yet — the qualifying duo has not been recorded.
      </p>
    <% end %>
  </div>

  <%# APPROVE. Deliberately refuses until every slot has an image: the gate's
      whole job is that a human looked at all three. %>
  <div class="pt-2 border-t border-subtle flex items-center gap-3 flex-wrap">
    <%= button_to "✅ Approve all three",
          approve_artifacts_content_path(@content.slug), method: :post,
          class: ready ? "btn-primary" : "btn-primary opacity-40 cursor-not-allowed",
          disabled: !ready,
          form: { data: { turbo_confirm: "Approve these three artifacts and unlock video generation?" } } %>
    <% unless ready %>
      <span class="text-xs text-muted">
        every slot needs an image before this unlocks
      </span>
    <% end %>
  </div>
</div>
