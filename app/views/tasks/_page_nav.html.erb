<%# Cross-nav between the board pages (+ back to the dashboard for admins).
    Local: current ("tasks" | "deployments" | "stages"). Sits in the header controls. %>
<% current = local_assigns.fetch(:current, nil) %>
<nav class="flex items-center gap-1 flex-wrap">
  <% if admin? %>
    <%= link_to "← Dashboard", admin_dashboard_path,
          class: "px-3 py-1.5 rounded-lg text-sm font-medium transition bg-surface text-secondary border border-subtle hover:text-heading" %>
  <% end %>
  <% { "tasks" => ["Tasks", tasks_path], "deployments" => ["Deployments", deployments_path], "stages" => ["Stages", stages_path] }.each do |key, (label, path)| %>
    <% active = key == current %>
    <%= link_to label, path,
          "aria-current": (active ? "page" : nil),
          class: "px-3 py-1.5 rounded-lg text-sm font-medium transition #{active ? 'bg-primary text-white' : 'bg-surface text-secondary border border-subtle hover:text-heading'}" %>
  <% end %>
</nav>
