<%# THE EDIT PANEL (task logo-part-editor, Alex McRitchie's item 4b), on the Navbar Logo
    and Stacked Logo tabs: one row per part (Icon, First word, Ending, and on
    the Stacked tab's tagline form, Tagline). On the Icon tab, the Icon row
    alone: the kit's icon colour (task kit-icon-atomic-unit). While the kit has
    an icon, the Navbar and Stacked tabs' Icon row shows it and sends the
    reader to the Icon tab, unless the URL explores another icon. Each row picks the part's colour
    from the brand's palette, a word's weight, and whether the tagline shows.
    The sizes, spacing and shapes stay as the rules set them.

    It is a plain GET form: its hidden fields carry the page's other settings
    (logo_unedited_params), and every other control carries the edits
    (logo_page_params), so each survives the other. app/javascript/logo_editor.js
    submits it on a change, leaves the blank "as styled" fields out of the URL,
    keeps the scroll where it was, and warns when a picked colour is under 3:1
    against the page's background. With JavaScript off it has an Apply button.

    A watermark is one colour, so in Watermark the panel says the edits do not
    apply and shows no controls; the edits stay in the URL for Light and Dark.
    The word rows work in Original as in Alt (task logo-compare-and-original-edits):
    an Original's words take the picked colour and weight and its icon stays the
    brand's art. Only the Icon row needs Alt: on an original icon it says so and
    links there. The Navbar and Stacked tabs draw this one partial, so their rows
    are the same and in the same order (LogosHelper#logo_edit_rows).
    Locals: kit (the brand's Logos::BrandKit). %>
<% field = "rounded-lg border border-subtle bg-surface-alt px-2 py-1.5 text-xs text-heading disabled:opacity-60" %>
<% outline = "has-checked:outline-2 has-checked:outline-offset-2 has-checked:outline-solid has-checked:outline-[#4338CA] dark:has-checked:outline-white has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-dashed has-focus-visible:outline-[#4338CA] dark:has-focus-visible:outline-white" %>
<%# id="edit": the page's controls row links here ("Edit parts"), because Alex McRitchie could not find the panel under the
    Navbar tab's logos (2026-10-11 23:06); it now sits beside the Download card, still below the fold on a phone. scroll-mt-44 clears the EXPANDED nav (161px at 375), which collapses to 69px after the jump. %>
<section id="edit" class="card p-4 sm:p-5 space-y-3 scroll-mt-44" data-test="edit-panel" aria-labelledby="edit-panel-title">
  <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
    <h2 id="edit-panel-title" class="text-sm font-bold text-heading mr-auto">Edit</h2>
    <% if (@type == :icon ? @edits.slice(:icon) : @edits).any? %>
      <%# A 40 px tall hit area, like the page's other controls, without growing the heading row: the negative margin
          gives back what the padding adds. %>
      <%= link_to "Reset", logo_brand_path(@logo.brand, logo_unedited_params),
                  class: "-my-3 -mr-2 inline-flex min-h-10 min-w-10 items-center justify-center rounded-md px-2 text-xs font-semibold text-primary hover:underline focus-visible:outline-2 focus-visible:outline-[#4338CA] dark:focus-visible:outline-white",
                  data: { test: "edit-reset" } %>
    <% end %>
  </div>
  <% if @context == :watermark %>
    <p class="text-sm text-secondary" data-test="edit-watermark">A watermark is the whole logo in one colour, so edits do not apply here. Any you made come back in Light and Dark.</p>
  <% else %>
    <% if @type == :icon %>
    <p class="text-sm text-secondary">Pick the icon's colour from the brand's palette. Save as default to make it the kit's icon: every Navbar and Stacked Logo draws it.</p>
    <% else %>
    <p class="text-sm text-secondary">Pick each part's colour from the brand's palette, and each word's weight. The sizes, spacing and shapes stay as the rules set them, except that a heavier word is wider. The logo, its download and its copy change at once. To keep them, Save as default. Reset goes back to the kit default, or to the brand's style when none is saved.</p>
    <% end %>
    <% if @edit_refusal %>
      <p class="text-sm text-heading rounded-lg border border-subtle p-3" role="alert" data-test="edit-refusal">These edits cannot be drawn here, so the logos are shown as styled: <%= @edit_refusal %></p>
    <% end %>
    <%= form_with url: logo_brand_path(@logo.brand), method: :get, data: { test: "edit-form", logo_edit: true } do %>
      <% logo_unedited_params.each do |name, value| %><%= hidden_field_tag name, value, id: nil %><% end %>
      <div class="divide-y divide-subtle">
      <% logo_edit_rows.each do |row| %>
        <% part = row[:part] %>
        <div class="py-3 first:pt-0 grid gap-2 sm:grid-cols-[9rem_1fr] sm:items-start" data-test="edit-row" data-part="<%= part %>">
          <div class="min-w-0">
            <div class="text-xs font-semibold text-heading"><%= row[:label] %></div>
            <% if row[:word] %>
              <div class="font-mono text-2xs text-muted break-words" data-test="edit-word"><%= row[:word] %></div>
            <% end %>
          </div>
          <div class="min-w-0 space-y-2">
            <% if part == :icon && !@icon_from_kit && logo_icon_original? %>
              <%# An original icon is the brand's own art: its colour edit needs Alt, on the Icon tab, whose Save as default
                  makes the kit icon every logo draws. Not ?icon_colouring=alt here: a kit choice saves no icon colouring,
                  so Save as default would drop the Alt icon on reload (Carl's review zap). The words' rows work here. %>
              <p class="text-2xs text-secondary" data-test="edit-icon-original">The icon is the brand's original art, so its colour changes in Alt only.
                <%= link_to (@type == :icon ? "Recolour it in Alt" : "Recolour it in Alt on the Icon tab"), logo_brand_path(@logo.brand, logo_page_params(type: :icon, colouring: :alt)),
                            class: "font-semibold text-primary hover:underline", data: { test: "edit-icon-in-alt" } %></p>
            <% elsif part == :icon && @icon_from_kit %>
              <%# The kit's icon, as the tab's logos draw it; its colour is changed on the Icon tab. %>
              <div class="flex flex-wrap items-center gap-2" data-test="edit-kit-icon">
                <span class="inline-flex h-8 w-8 items-center justify-center rounded-md border border-subtle p-0.5" data-test="edit-kit-icon-swatch">
                  <%= logo_themed_images(@tones.to_h { |tone| [tone, Logos::Variant.new(@kit_icon.logo, type: :icon, tone:, colouring: @kit_icon.colouring, edits: @kit_icon.edits)] }, height: 26, test: "edit-kit-icon-image") %>
                </span>
                <% if (hex = @kit_icon.edits.dig(:icon, :colour)) %>
                  <span class="inline-block h-8 w-8 rounded-md border border-subtle" style="background-color: <%= hex %>" title="<%= logo_swatch_name(kit, hex) %> <%= hex %>" data-test="edit-kit-icon-colour"></span>
                <% end %>
                <p class="text-2xs text-secondary">Uses the kit icon. Change it on the <%= link_to "Icon tab", logo_brand_path(@logo.brand, logo_page_params(type: :icon)), class: "font-semibold text-primary hover:underline", data: { test: "edit-kit-icon-link" } %>.</p>
              </div>
            <% else %>
            <% colour_param = logo_edit_param(part, :colour) %>
            <% picked = @edits.dig(part, :colour) %>
            <fieldset class="min-w-0" data-test="edit-colours">
              <legend class="sr-only"><%= row[:label] %> colour</legend>
              <div class="flex flex-wrap items-center gap-2">
                <label class="inline-flex h-8 items-center rounded-md border border-subtle px-2 text-2xs font-semibold text-heading cursor-pointer <%= outline %>"
                       data-test="edit-swatch" data-hex="">
                  <%= radio_button_tag colour_param, "", picked.nil?, id: nil, class: "sr-only" %>As styled
                </label>
                <% kit.palette.each do |swatch| %>
                  <label class="relative inline-block h-8 w-8 rounded-md border border-subtle cursor-pointer <%= outline %>" style="background-color: <%= swatch.hex %>"
                         title="<%= swatch.name %> <%= swatch.hex %>" data-test="edit-swatch" data-hex="<%= swatch.hex %>">
                    <%= radio_button_tag colour_param, swatch.hex.delete_prefix("#"), picked == swatch.hex, id: nil, class: "sr-only" %>
                    <span class="sr-only"><%= swatch.name %> <%= swatch.hex %></span>
                  </label>
                <% end %>
              </div>
            </fieldset>
            <% if part == :icon %>
              <%# The note follows the icon each tone draws: where light and dark draw different icons (Commercial
                  Welding's dark helmet is one layer), each tone's note shows with its own logos. %>
              <% notes = logo_icon_edit_notes(@logo, @tones) %>
              <p class="text-2xs text-muted" data-test="edit-icon-note">
                <% if notes.is_a?(Hash) %>
                  <% notes.each do |tone, note| %><%= tag.span(note, class: LogosHelper::LOGO_THEME_CLASSES.fetch(tone), data: { test: "edit-icon-note-tone", tone: }) %><% end %>
                <% else %>
                  <%= notes %>
                <% end %>
              </p>
            <% end %>
            <% if picked %>
              <p class="text-2xs font-semibold text-warning-ink" hidden role="status" data-test="edit-contrast"
                 data-edit-contrast="<%= picked %>" data-name="<%= logo_swatch_name(kit, picked) %>"></p>
            <% end %>
            <% end %>
            <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
              <% if row[:settings].include?(:weight) %>
                <% weight_param = logo_edit_param(part, :weight) %>
                <% traced = part != :tagline && @logo.traced? %>
                <label class="inline-flex items-center gap-2 text-3xs font-semibold uppercase tracking-wide text-muted">
                  Weight
                  <%= select_tag weight_param,
                                 options_for_select([["As styled", ""]] + Logos::NavbarLogo::EDIT_WEIGHTS.map { |weight| ["#{weight} #{Logos::BrandKit::WEIGHT_NAMES.fetch(weight)}", weight] },
                                                    selected: @edits.dig(part, :weight),
                                                    disabled: (traced ? [] : Logos::NavbarLogo::EDIT_WEIGHTS.select { |weight| logo_edit_weight_refusal(part, weight) })),
                                 id: nil, class: field, disabled: traced, autocomplete: "off", data: { test: "edit-weight" } %>
                </label>
                <% if traced %>
                  <span class="text-2xs text-muted" data-test="edit-weight-reason">The name is traced lettering, which has one weight.</span>
                <% end %>
              <% end %>
              <% if row[:settings].include?(:visible) %>
                <% hidden = @edits.dig(part, :visible) == false %>
                <fieldset class="inline-flex items-center gap-2" data-test="edit-visible">
                  <legend class="sr-only">Tagline visibility</legend>
                  <% [["Shown", "", !hidden], ["Hidden", "0", hidden]].each do |label, value, on| %>
                    <label class="inline-flex h-8 items-center rounded-md border border-subtle px-2 text-2xs font-semibold text-heading cursor-pointer <%= outline %>">
                      <%= radio_button_tag logo_edit_param(part, :visible), value, on, id: nil, class: "sr-only" %><%= label %>
                    </label>
                  <% end %>
                </fieldset>
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
      </div>
      <noscript><div class="pt-3"><%= submit_tag "Apply", name: nil, class: "btn btn-sm btn-neutral", data: { test: "edit-submit", disable_with: false } %></div></noscript>
    <% end %>
  <% end %>
</section>
