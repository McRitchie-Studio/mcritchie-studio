<div class="max-w-3xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-2">
    <h1 class="text-2xl font-extrabold text-heading"><%= @signing_request.title %></h1>
    <%= link_to "← Queue", admin_signing_requests_path, class: "text-secondary text-sm" %>
  </div>
  <p class="text-secondary text-sm mb-2">
    <%= @signing_request.coordination %> · <%= @signing_request.cluster %> ·
    <%= @signing_request.signers_signed.length %>/<%= @signing_request.threshold %> signed ·
    status <span class="font-medium"><%= @signing_request.status_label %></span>
  </p>
  <% if @signing_request.durable_nonce_pubkey.present? %>
    <p class="text-emerald-400 text-sm mb-6">⏱ Anchored on a durable nonce (<code class="text-xs"><%= @signing_request.durable_nonce_pubkey[0,8] %>…</code>) — <strong>does not expire</strong>; signers can sign hours apart.</p>
  <% else %>
    <p class="text-muted text-xs mb-6">Recent-blockhash tx — sign + broadcast within ~90s.</p>
  <% end %>

  <div class="card p-6 mb-6">
    <h2 class="font-bold text-heading mb-3">Signers</h2>
    <ul class="space-y-2">
      <% @signers.each do |signer| %>
        <li class="flex items-center justify-between gap-3">
          <code class="text-xs text-body break-all"><%= signer %></code>
          <% if @signing_request.signed_by?(signer) %>
            <span class="text-green-400 text-sm shrink-0">✓ signed</span>
          <% else %>
            <%= link_to "Sign link", sign_admin_signing_request_path(@signing_request, signer: signer),
                  class: "btn btn-secondary btn-sm shrink-0" %>
          <% end %>
        </li>
      <% end %>
    </ul>
  </div>

  <% if @signing_request.broadcast? %>
    <div class="card p-6 bg-green-900/20">
      <p class="text-green-300 font-medium">Broadcast.</p>
      <code class="text-xs break-all text-body"><%= @signing_request.tx_signature %></code>
    </div>
  <% elsif @signing_request.threshold_met? %>
    <%= button_to "Broadcast transaction", broadcast_admin_signing_request_path(@signing_request),
          method: :post, class: "btn btn-primary w-full" %>
  <% else %>
    <div class="card p-4 text-secondary text-sm">
      Waiting on <%= @signing_request.signatures_needed %> more signature(s). Send each remaining signer their sign link.
    </div>
  <% end %>

  <% if @signing_request.last_error.present? %>
    <div class="mt-4 p-3 rounded bg-red-900/30 text-red-300 text-sm"><%= @signing_request.last_error %></div>
  <% end %>
</div>
