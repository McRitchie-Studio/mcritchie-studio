#!/usr/bin/env ruby
# frozen_string_literal: true

# pr-review — the supervisor behind Avi's pr-review / pr-review-slow acts.
# (Formerly bin/avi-heartbeat; that name remains as a thin shim.)
#
# The script composes the existing DevOps tools:
#   * bin/devops-cycle --json --decisions --scout-reports
#   * bin/reviewer-select <task> --json
#   * codex exec for each selected reviewer
#   * bin/task move|block|note for Avi's final handoff
#
# This is the SUPERVISOR: it selects the primary+light pair (bin/reviewer-select)
# and spawns BOTH role reviewers IN PARALLEL as sibling children — the primary
# runs pr-review-primary.md, the light runs pr-review-light.md — then collects
# both verdicts and gates. It NEVER performs a review itself (Avi is a thin gate,
# not a reviewer).
#
# CI gate-zero (ci-gate-review-handoff): the builder submits WITHOUT waiting for
# CI, so the CI check is this supervisor's OPENING ACT. Before selecting or
# spawning a reviewer pair it reads the PR's live GitHub CI (bin/lib/ci_status.rb):
#   red      → block the task back (bin/task block --kind rework) with the failing
#              checks named — no reviewer tokens burned; the bounce records as a
#              failed dor_review (gate-zero) attempt with a ci SOP.
#   conflicted → block the task back too (merge the PR's base in and resolve named as the fix):
#              a merge-conflicted PR (mergeStateStatus DIRTY) gets NO CI at all —
#              GitHub cannot compute the merge commit — so deferring "until CI
#              reports" would strand it in submitted forever (the PR-#509 stall).
#   ci_less  → block the task back as well (merge the base in, resolve, as the fix):
#              a PR whose base drifted past GitHub's merge computation gets ZERO
#              check-runs WITHOUT ever reading DIRTY, so it looks exactly like a
#              slow CI and deferring waits forever on checks that never exist.
#   pending  → defer the task to a later wave (the existing defer machinery);
#   :none    → same defer (an open PR whose checks haven't reported yet);
#   green    → proceed to spawn the pair.
#   unverified / no_pr / closed / merged → proceed; the primary's strict gate-zero
#              (bin/dor-check --gate-role review) holds the authoritative verdict.
# PR_REVIEW_CI_STATUS injects the verdict for tests — a bare CiStatus token, a
# JSON object mapping slug → token, or a raw `gh pr checks --json` array.
#
# Slow mode reviews one submitted PR at a time and always re-queries the board
# after a review before choosing the next PR. Fast mode starts bounded waves of
# primary + light review pairs for stacked queues, then resolves each reviewed
# PR with the same final board re-query and handoff rules. Both modes stop after
# --limit completed reviews and print a deterministic retrospective.
#
# --run vs --dry-run: a dry-run is a PREVIEW that stops at the reviewer pair it
# would summon (preview_review). It spawns no reviewer, writes no task/gate, and —
# critically — never enters the verdict-resolution path, because the scout reports
# sitting on the task are the verdicts of EARLIER review rounds; gating on them
# made a preview print a real-looking "completed_reviews=1 blocked=1" retrospective
# quoting prior reviewers (dry-run-launches-real-reviewers). Previews report as
# `previewed` and never as completed/approved/blocked.

require "fileutils"
require "json"
require "open3"
require "optparse"
require "shellwords"
require "time"
require_relative "lib/ci_status"
require_relative "lib/bin_helpers"
require_relative "lib/projects_root"

ROOT = File.expand_path("..", __dir__)
PROJECTS_ROOT = ProjectsRoot.default_projects_dir(ROOT)
DEFAULT_APPS = %w[mcritchie-studio turf-monster rolio].freeze
SCOUT_OUTCOMES = %w[merge-ready wait-for-ci request-changes conductor-review].freeze

DEVOPS_CYCLE_BIN = BinHelpers.bin_for("DEVOPS_CYCLE_BIN", "devops-cycle")
REVIEWER_SELECT_BIN = BinHelpers.bin_for("REVIEWER_SELECT_BIN", "reviewer-select")
TASK_BIN = BinHelpers.bin_for("TASK_BIN", "task")
GATE_BIN = BinHelpers.bin_for("GATE_BIN", "gate")
# The accepted-ladder's first rung: on a merge-ready verdict the supervisor merges
# the feat PR into `accepted` and stamps merged:"accepted" before moving the task
# `reviewed` (the sweep later promotes accepted→release). GH_BIN is the injectable
# gh seam (mirrors TASK_BIN) so the command tests fake the merge without shelling.
# No bin/gh sibling ships — gh is the external GitHub CLI, so bin_for resolves it
# through PATH (the 2026-07-19 wave stranded 4 merge-ready verdicts when it didn't).
GH_BIN = BinHelpers.bin_for("GH_BIN", "gh")
ACCEPTED_BRANCH = "accepted"
# start_review → gate key per launch role (the G2 review lanes, GateRun::GATES).
G2_LANE_KEYS = { "primary" => "g2a_primary", "light" => "g2b_light" }.freeze
CODEX_BIN = ENV["CODEX_BIN"].to_s.strip.empty? ? "codex" : ENV["CODEX_BIN"].strip

OPTIONS = {
  run: false,
  limit: 10,
  required_approvals: 2,
  idle_sleep: 60,
  max_idle_cycles: 240,
  defer_seconds: 300,
  apps: DEFAULT_APPS.dup,
  base_url: nil,
  offline_fixture: nil,
  qa_intake: true,
  refresh: true,
  # PR_REVIEW_* is the current knob family; the AVI_HEARTBEAT_* names remain as
  # fallbacks from the script's former name.
  model: (ENV["PR_REVIEW_MODEL"] || ENV["AVI_HEARTBEAT_MODEL"]).to_s.strip,
  codex_sandbox: ENV["PR_REVIEW_CODEX_SANDBOX"] || ENV.fetch("AVI_HEARTBEAT_CODEX_SANDBOX", "danger-full-access"),
  approval: ENV["PR_REVIEW_APPROVAL"] || ENV.fetch("AVI_HEARTBEAT_APPROVAL", "never"),
  codex_workdir: PROJECTS_ROOT,
  output_dir: File.join(ROOT, "tmp", "pr-review"),
  once: false,
  mode: "slow",
  max_agents: 5
}

OptionParser.new do |opts|
  opts.banner = <<~TEXT
    Usage: bin/pr-review [options]

    Reviews submitted PRs newest first. Slow mode reviews one PR at a time.
    Fast mode launches review pairs in bounded waves for stacked queues, while
    preserving the same reviewer intent, scout-report, and reviewed/block/defer
    resolution semantics.

    Default is dry-run. Pass --run to launch reviewers and write task updates.
    A dry-run stops at the reviewer pair it WOULD summon: it launches no reviewer,
    writes no task or gate, and resolves no verdict (the scout reports on the board
    belong to earlier review rounds). It reports what it saw as `previewed`.
  TEXT

  opts.on("--run", "Execute reviewer launches and task writes") { OPTIONS[:run] = true }
  opts.on("--dry-run", "Preview the reviewer pair only: no launch, no task write, no verdict") { OPTIONS[:run] = false }
  opts.on("--slow", "Review one submitted PR at a time (default)") { OPTIONS[:mode] = "slow" }
  opts.on("--fast", "Review submitted PRs in bounded parallel waves") { OPTIONS[:mode] = "fast" }
  opts.on("--mode MODE", "Review mode: slow or fast (default: slow)") { |mode| OPTIONS[:mode] = mode }
  opts.on("--max-agents N", Integer, "Fast mode reviewer-agent cap, 2-5 (default: 5)") { |n| OPTIONS[:max_agents] = n }
  opts.on("--limit N", Integer, "Completed PR reviews before retrospective (default: 10)") { |n| OPTIONS[:limit] = n }
  opts.on("--required-approvals N", Integer, "Merge-ready scout reports required (default: 2)") { |n| OPTIONS[:required_approvals] = n }
  opts.on("--idle-sleep SECONDS", Integer, "Seconds to wait when no submitted PR is ready (default: 60)") { |n| OPTIONS[:idle_sleep] = n }
  opts.on("--max-idle-cycles N", Integer, "Stop after N idle polls; -1 means forever (default: 240)") { |n| OPTIONS[:max_idle_cycles] = n }
  opts.on("--defer-seconds N", Integer, "Seconds before retrying wait-for-CI/incomplete reports (default: 300)") { |n| OPTIONS[:defer_seconds] = n }
  opts.on("--once", "Process at most one PR wave or one idle poll") { OPTIONS[:once] = true }
  opts.on("--apps LIST", "Comma-separated apps for qa-intake (default: #{DEFAULT_APPS.join(",")})") do |value|
    OPTIONS[:apps] = value.split(",").map(&:strip).reject(&:empty?)
  end
  opts.on("--base-url URL", "Task board base URL passed through to devops-cycle") { |url| OPTIONS[:base_url] = url }
  opts.on("--offline-fixture PATH", "Pass a fixture to devops-cycle instead of live board reads") { |path| OPTIONS[:offline_fixture] = path }
  opts.on("--no-qa-intake", "Pass --no-qa-intake to devops-cycle") { OPTIONS[:qa_intake] = false }
  opts.on("--no-refresh", "Do not refresh qa-intake") { OPTIONS[:refresh] = false }
  opts.on("--model MODEL", "Model passed to codex exec") { |model| OPTIONS[:model] = model }
  opts.on("--codex-workdir DIR", "Workspace passed to codex exec -C (default: /Users/alex/projects)") { |dir| OPTIONS[:codex_workdir] = dir }
  opts.on("--output-dir DIR", "Directory for prompts/logs/last messages") { |dir| OPTIONS[:output_dir] = dir }
  opts.on("-h", "--help", "Show help") do
    puts opts
    exit 0
  end
end.parse!

abort "--limit must be positive" unless OPTIONS[:limit].positive?
abort "--mode must be slow or fast" unless %w[slow fast].include?(OPTIONS.fetch(:mode))
abort "--max-agents must be between 2 and 5" unless (2..5).cover?(OPTIONS[:max_agents])
abort "--required-approvals must be positive" unless OPTIONS[:required_approvals].positive?
abort "--idle-sleep cannot be negative" if OPTIONS[:idle_sleep].negative?
abort "--defer-seconds cannot be negative" if OPTIONS[:defer_seconds].negative?

def now_iso
  Time.now.utc.iso8601
end

def parse_time(value)
  Time.parse(value.to_s)
rescue StandardError
  Time.at(0)
end

def run_capture(cmd, input: nil, chdir: ROOT)
  out, err, status = Open3.capture3(*cmd, stdin_data: input, chdir: chdir)
  [out, err, status]
rescue StandardError => e
  ["", e.message, nil]
end

def shell_join(cmd)
  cmd.map(&:to_s).shelljoin
end

def executable_on_path(name)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).each do |dir|
    path = File.join(dir, name)
    return path if File.executable?(path) && !File.directory?(path)
  end
  nil
end

def repo_local_bin?(bin)
  path = File.expand_path(bin, ROOT)
  path.start_with?(File.join(ROOT, "bin") + File::SEPARATOR)
end

def mise_prefix_for(bin)
  return [] if (ENV["PR_REVIEW_USE_MISE"] || ENV["AVI_HEARTBEAT_USE_MISE"]).to_s == "0"
  return [] unless repo_local_bin?(bin)

  version_path = File.join(ROOT, ".ruby-version")
  return [] unless File.exist?(version_path)

  version = File.read(version_path).strip
  return [] if version.empty?

  mise = ENV["MISE_BIN"].to_s.strip
  mise = executable_on_path("mise") if mise.empty?
  return [] if mise.to_s.empty?

  [mise, "x", "ruby@#{version}", "--"]
end

def managed_command(bin, *args)
  [*mise_prefix_for(bin), bin, *args]
end

def devops_cycle_args
  args = managed_command(DEVOPS_CYCLE_BIN, "--json", "--decisions", "--scout-reports", "--stages", "submitted")
  args += ["--apps", OPTIONS.fetch(:apps).join(",")] if OPTIONS.fetch(:apps).any?
  args += ["--base-url", OPTIONS.fetch(:base_url)] if OPTIONS.fetch(:base_url).to_s != ""
  args += ["--offline-fixture", OPTIONS.fetch(:offline_fixture)] if OPTIONS.fetch(:offline_fixture).to_s != ""
  args << "--no-qa-intake" unless OPTIONS.fetch(:qa_intake)
  args << "--no-refresh" unless OPTIONS.fetch(:refresh)
  args
end

def fetch_snapshot
  cmd = devops_cycle_args
  out, err, status = run_capture(cmd)
  unless status&.success?
    raise "devops-cycle failed: #{[err, out].join(" ").strip}"
  end

  JSON.parse(out)
rescue JSON::ParserError => e
  raise "devops-cycle returned invalid JSON: #{e.message}"
end

def submitted_tasks(snapshot)
  Array(snapshot["tasks"])
    .select { |task| task["stage"] == "submitted" }
    .sort_by { |task| [submitted_sort_time(task), task["slug"].to_s] }
    .reverse
end

def submitted_sort_time(task)
  submitted_at = task["submitted_at"].to_s.strip
  submitted_at = task["created_at"].to_s.strip if submitted_at.empty?
  parse_time(submitted_at)
end

def task_decision(snapshot, slug)
  Array(snapshot["decisions"]).find { |decision| decision["slug"] == slug }
end

def task_by_slug(snapshot, slug)
  Array(snapshot["tasks"]).find { |task| task["slug"] == slug }
end

# The supervisor's pre-spawn CI read. PR_REVIEW_CI_STATUS is the injection seam
# (mirrors DOR_CHECK_CI_STATUS): a bare CiStatus token applies to every task; a
# JSON object ({"slug": "token"}) drives a mixed wave per slug; a raw
# `gh pr checks --json` array exercises the named-failing-checks path. Empty /
# unmatched → the live gh read.
def injected_ci_state(slug)
  raw = ENV["PR_REVIEW_CI_STATUS"].to_s.strip
  return nil if raw.empty?
  return (JSON.parse(raw)[slug] rescue nil) if raw.start_with?("{")

  raw
end

def supervisor_ci_check(task)
  CiStatus.evaluate(task.dig("devops", "pr_url"), injected_ci_state(task["slug"]))
end

def select_reviewers(slug)
  cmd = managed_command(REVIEWER_SELECT_BIN, slug, "--json")
  cmd << "--no-record" unless OPTIONS.fetch(:run)
  out, err, status = run_capture(cmd)
  unless status&.success?
    raise "reviewer-select failed for #{slug}: #{[err, out].join(" ").strip}"
  end

  decision = JSON.parse(out)
  reviewers = Array(decision["reviewers"]).first(2).map do |reviewer|
    reviewer.transform_keys(&:to_s)
  end
  raise "reviewer-select returned fewer than two reviewers for #{slug}" if reviewers.size < 2

  reviewers
rescue JSON::ParserError => e
  raise "reviewer-select returned invalid JSON for #{slug}: #{e.message}"
end

def compact_list(items)
  Array(items).map(&:to_s).reject(&:empty?).join(", ")
end

def bullet_list(items)
  values = Array(items).map(&:to_s).reject(&:empty?)
  return "- none recorded" if values.empty?

  values.map { |item| "- #{item}" }.join("\n")
end

def reviewer_prompt(task, reviewer, role, reviewers)
  metadata = task.fetch("devops", {})
  reviewer_slug = reviewer.fetch("slug")
  peer_text = reviewers.map { |r| "#{r["slug"]} (#{r["weight"] || "reviewer"})" }.join(" + ")

  role_sop = "mcritchie-studio/docs/agents/agents/avi/sops/pr-review-#{role}.md"
  role_blurb = role == "primary" ? "the deep primary review" : "the focused light second read"
  role_responsibility =
    if role == "primary"
      "As the PRIMARY you are the review OWNER: you run the gates (dor-check / cert / CI / acceptance match) " \
        "and you DRIVE the verdict (merge-ready or request-changes). Your deep review is the driving recommendation. " \
        "Run the DoR gate as `bin/dor-check #{task.fetch("slug")} --gate-role review` so your gate-zero verdict " \
        "lands as a SOP on the task's G2a Primary gate run instead of closing the builder's G1 Cert."
    else
      "As the LIGHT you are a focused second read through your domain lens. You do NOT run the gates and do NOT " \
        "drive the verdict — report your findings up to the primary/supervisor (any reviewer can still block on a defect)."
    end

  <<~PROMPT
    Work from /Users/alex/projects as #{reviewer_slug}, a pr-review #{role} reviewer for #{task.fetch("slug")}.

    Read /Users/alex/projects/AGENTS.md and the relevant repo README/runbook/docs before reviewing.

    Run your role SOP end to end (#{role_blurb}): #{role_sop}

    #{role_responsibility}

    Avi is the review SUPERVISOR — a thin gate who never reviews code himself. He confirmed
    product-acceptance, ran bin/reviewer-select to pick this primary+light pair, and spawned you
    and your peer IN PARALLEL as sibling reviewers (#{OPTIONS.fetch(:mode)} mode). You are the #{role}:
    #{peer_text}

    Task: #{task.fetch("task_url")}
    PR: #{metadata["pr_url"] || "missing"}
    Repo(s): #{compact_list(task.fetch("repositories"))}
    Branch: #{metadata["branch"] || "missing"}
    Role: #{role}
    Risk tags: #{compact_list(metadata.fetch("risk_tags", []))}
    Local URL: #{metadata["local_url"] || "none recorded"}
    QA URL: #{metadata["qa_url"] || "none recorded"}

    Acceptance criteria:
    #{bullet_list(metadata.fetch("acceptance", []))}

    Expected checks:
    #{bullet_list(metadata.fetch("test_plan", []))}

    Checks already reported:
    #{bullet_list(metadata.fetch("checks_run", []))}

    Narrate your review as your own soul so the heartbeat attributes it to you.
    Open your activity BEFORE any review work:
    bin/agent-activity start --category Verify --agent #{reviewer_slug} --supervisor avi --task #{task.fetch("slug")} --reason "review: #{task.fetch("slug")}"

    Close it with your verdict when the review is done:
    bin/agent-activity end --outcome "<verdict>: <one-line reason>"

    Review instructions:
    - Inspect task metadata, PR body, diff, changed files, docs, tests, CI, and merge safety.
    - Check whether the PR could overwrite or conflict with another agent's work.
    - Classify findings as blockers, non-blockers, or questions.
    - Recommend one outcome to Avi: merge-ready, wait-for-CI, request-changes, or conductor-review.
    - Do not merge, deploy, publish gems, change provider config, rotate credentials, or force-push.
    - Do not move the task stage. The pr-review supervisor owns the final move to reviewed or blocked.
    - Do not launch another reviewer; the pr-review supervisor already launched the pair.

    Record your scout report on the task before you finish:
    bin/devops-cycle --record-scout-report #{task.fetch("slug")} --scout-agent #{reviewer_slug} --outcome <merge-ready|wait-for-ci|request-changes|conductor-review> --summary "..." --finding "..." --check "..." --dry-run

    Remove --dry-run only after the payload looks right. Return a concise final message summarizing the recorded outcome.
  PROMPT
end

def safe_filename(value)
  BinHelpers.safe_filename(value)
end

# The intent-labeled delegate action the supervisor emits for each reviewer it
# spawns — the deterministic-path echo of the interactive Agent-tool `description`
# ("summon primary review: <soul>" / "summon light review: <soul>"). Making the
# two labels legible here is the enforcement half of harden-review-lane-roles:
# BOTH reviewers are the supervisor's own parallel children (the primary never
# spawns the light), and each spawn is announced with its role-tagged intent.
def delegate_action_label(role, reviewer_slug)
  "summon #{role} review: #{reviewer_slug}"
end

def run_directory
  @run_directory ||= begin
    dir = File.join(File.expand_path(OPTIONS.fetch(:output_dir), ROOT), Time.now.utc.strftime("%Y%m%dT%H%M%SZ-#{$$}"))
    FileUtils.mkdir_p(dir)
    dir
  end
end

def codex_command(last_message_path)
  cmd = [CODEX_BIN, "-a", OPTIONS.fetch(:approval), "-s", OPTIONS.fetch(:codex_sandbox), "exec", "-C", OPTIONS.fetch(:codex_workdir)]
  cmd += ["-m", OPTIONS.fetch(:model)] unless OPTIONS.fetch(:model).empty?
  cmd += ["-o", last_message_path, "-"]
  cmd
end

def launch_reviewer(task, reviewer, role, reviewers)
  slug = task.fetch("slug")
  reviewer_slug = reviewer.fetch("slug")
  prefix = "#{safe_filename(slug)}--#{safe_filename(role)}--#{safe_filename(reviewer_slug)}"
  prompt_path = File.join(run_directory, "#{prefix}.prompt")
  log_path = File.join(run_directory, "#{prefix}.log")
  last_path = File.join(run_directory, "#{prefix}.last.md")
  prompt = reviewer_prompt(task, reviewer, role, reviewers)
  File.write(prompt_path, prompt)

  cmd = codex_command(last_path)
  action = delegate_action_label(role, reviewer_slug)
  unless OPTIONS.fetch(:run)
    puts "  dry-run: would #{action}"
    puts "           #{shell_join(cmd)} < #{prompt_path}"
    return { reviewer: reviewer_slug, role: role, prompt_path: prompt_path, dry_run: true, success: true }
  end

  pid = Process.spawn(*cmd, in: prompt_path, out: log_path, err: [:child, :out], chdir: ROOT)
  puts "  #{action} (pid=#{pid} log=#{log_path})"
  { reviewer: reviewer_slug, role: role, pid: pid, prompt_path: prompt_path, log_path: log_path, last_path: last_path }
rescue StandardError => e
  { reviewer: reviewer_slug, role: role, success: false, error: e.message }
end

def wait_for_reviewers(launches)
  launches.map do |launch|
    next launch if launch[:dry_run] || !launch[:pid]

    _pid, status = Process.wait2(launch.fetch(:pid))
    launch.merge(success: status.success?, exitstatus: status.exitstatus)
  rescue StandardError => e
    launch.merge(success: false, error: e.message)
  end
end

def latest_reports_by_reviewer(task, reviewers)
  reports = Array(task&.fetch("scout_reports", []))
  reviewer_slugs = reviewers.map { |reviewer| reviewer.fetch("slug") }

  reviewer_slugs.each_with_object([]) do |slug, selected|
    report = reports
      .select { |report| report["agent_slug"].to_s == slug }
      .max_by { |report| parse_time(report["created_at"]) }
    selected << report if report
  end
end

def report_summary(report)
  reporter = report["agent_slug"] || "unknown"
  outcome = report["outcome"] || "unknown"
  summary = report["summary"].to_s.strip
  summary.empty? ? "#{reporter}: #{outcome}" : "#{reporter}: #{outcome} - #{summary}"
end

def outcome_from_reports(reports, required_approvals)
  outcomes = reports.map { |report| report["outcome"].to_s }
  return "request-changes" if outcomes.include?("request-changes")
  return "wait-for-ci" if outcomes.include?("wait-for-ci")
  return "conductor-review" if outcomes.include?("conductor-review")
  return "merge-ready" if outcomes.count("merge-ready") >= required_approvals

  "incomplete"
end

def task_write(args, input: nil)
  cmd = managed_command(TASK_BIN, *args)
  unless OPTIONS.fetch(:run)
    puts "  dry-run: would run #{shell_join(cmd)}"
    return true
  end

  out, err, status = run_capture(cmd, input: input)
  puts out unless out.strip.empty?
  warn err unless err.strip.empty?
  status&.success?
end

# Best-effort gate-run markers (bin/gate → GateRun). The SUPERVISOR owns the
# review-side gates — it is the one place that knows role assignment
# deterministically: start_review OPENs the gate-zero (dor_review, closed by the
# primary's dor-check --gate-role review) plus g2a_primary + g2b_light as the
# pair launches, and close_review_gates CLOSEs each G2 lane from its OWN
# reviewer's scout-report outcome. A CI-red bounce closes dor_review failed with
# no reviewer. Fire-and-forget: a gate write never breaks the review loop.
def gate_write(*args)
  cmd = managed_command(GATE_BIN, *args)
  unless OPTIONS.fetch(:run)
    puts "  dry-run: would run #{shell_join(cmd)}"
    return true
  end

  system(*cmd, out: File::NULL, err: File::NULL)
rescue StandardError
  nil
end

# Per-lane verdicts: merge-ready → passed; request-changes / wait-for-ci /
# conductor-review → failed (the outcome rides in metadata; an uncleared attempt
# is still an attempt — the next wave opens n+1). A reviewer with NO report
# leaves its lane IN FLIGHT so the next wave's open reuses the same attempt.
def close_review_gates(slug, reviewers, reports)
  reviewers.each_with_index do |reviewer, index|
    key = G2_LANE_KEYS[%w[primary light][index]] or next
    reviewer_slug = reviewer.fetch("slug")
    report = reports.find { |r| r["agent_slug"].to_s == reviewer_slug }
    next unless report

    outcome = report["outcome"].to_s
    success = outcome == "merge-ready"
    gate_write("close", "task", slug, key, success ? "--success" : "--failed",
               "--actor", reviewer_slug,
               "--sop-json", JSON.generate({ "sop" => "scout-report", "result" => success ? "pass" : "fail" }),
               "--meta", "outcome=#{outcome}")
  end
end

# The gh READ seam (PR base, merge state) — routed through GH_BIN so the command
# tests inject a fake instead of shelling to a live PR. Returns [stdout, ok].
def gh_capture(*args)
  out, _err, status = run_capture(managed_command(GH_BIN, *args))
  [out.to_s.strip, !!(status&.success?)]
end

# A gh WRITE (pr merge / pr edit). No-ops under dry-run (prints what it WOULD run),
# exactly like task_write. move_reviewed is never reached in a dry-run
# (finish_review stops at the preview), but this keeps a stray call inert too.
def gh_write(*args)
  cmd = managed_command(GH_BIN, *args)
  unless OPTIONS.fetch(:run)
    puts "  dry-run: would run #{shell_join(cmd)}"
    return true
  end

  out, err, status = run_capture(cmd)
  puts out unless out.strip.empty?
  warn err unless err.strip.empty?
  !!(status&.success?)
end

# The PR's live merge state — the crash-recovery read: a gh merge that fails
# because the PR ALREADY merged on a prior interrupted run (whose stamp/move died)
# must not bounce the task back.
def pr_already_merged?(pr_url)
  state, ok = gh_capture("pr", "view", pr_url, "--json", "state", "-q", ".state")
  ok && state.upcase == "MERGED"
end

# Merge the feature PR into `accepted` — the accepted-ladder's first rung. Self-heals
# a mis-based feat PR (base != accepted) by retargeting it before merging, so a PR
# opened against release/main is corrected rather than stranded. Returns true when
# the code is on `accepted` (freshly merged OR already merged on a prior run), false
# on ANY failure — the caller then leaves the task `submitted` and UNSTAMPED,
# preserving the invariant reviewed ⟺ code-on-accepted.
def merge_feature_pr(slug, pr_url)
  if pr_url.to_s.empty?
    puts "  cannot merge #{slug}: no PR url on the task (devops.pr_url) — leaving it submitted"
    return false
  end

  base, base_ok = gh_capture("pr", "view", pr_url, "--json", "baseRefName", "-q", ".baseRefName")
  if base_ok && !base.empty? && base != ACCEPTED_BRANCH
    puts "  retarget #{slug} PR base #{base} → #{ACCEPTED_BRANCH} (mis-based feat PR self-heals)"
    unless gh_write("pr", "edit", pr_url, "--base", ACCEPTED_BRANCH)
      puts "  could not retarget #{pr_url} base → #{ACCEPTED_BRANCH} — leaving #{slug} submitted"
      return false
    end
  end

  puts "  gh pr merge #{pr_url} --merge (feat → #{ACCEPTED_BRANCH})"
  ok = gh_write("pr", "merge", pr_url, "--merge")
  if !ok && OPTIONS.fetch(:run) && pr_already_merged?(pr_url)
    puts "  ↷ #{pr_url} already merged on GitHub (interrupted prior run) — proceeding to stamp + move"
    ok = true
  end
  puts "  gh pr merge FAILED for #{pr_url} (#{slug}) — leaving it submitted (resolve conflicts/checks on GitHub, then re-review)" unless ok
  ok
end

# The merge-ready verdict handoff — the accepted-ladder's first rung. Merge the
# feat PR into `accepted`, stamp merged:"accepted", then move the task `reviewed`
# and leave the Steffon-QA handoff note. ORDER is load-bearing:
#   1. Merge first. A merge FAILURE returns false WITHOUT stamping or moving, so a
#      broken PR keeps the task `submitted` (invariant: reviewed ⟺ code-on-accepted).
#   2. Stamp merged:"accepted" BEFORE the stage move — the two board writes aren't
#      atomic, so stamp-first means a failure between them can only leave
#      (submitted, merged:accepted), which self-heals on the next wave (re-merge is
#      a no-op, the stamp is idempotent), NEVER the forbidden (reviewed, unstamped)
#      the sweep would drop as a HELD anomaly.
def move_reviewed(slug, task, reviewers, reports)
  return false unless merge_feature_pr(slug, task&.dig("devops", "pr_url"))
  return false unless task_write(["merged", slug, "accepted"])

  ok = task_write(["move", slug, "reviewed", "--actor", "avi"])
  note = "pr-review merged #{slug} into `#{ACCEPTED_BRANCH}` and moved it reviewed after " \
         "#{reviewers.map { |r| r["slug"] }.join(" + ")} reported merge-ready. Left for Steffon QA " \
         "(the sweep promotes accepted→release).\n\n" \
         "Reports:\n#{reports.map { |r| "- #{report_summary(r)}" }.join("\n")}"
  ok && task_write(["note", slug, "--handoff", note, "--agent", "avi"])
end

def block_for_rework(slug, reports)
  feedback = "pr-review blocked review: #{reports.map { |r| report_summary(r) }.join("; ")}"
  task_write(["block", slug, "--kind", "rework", "--feedback", feedback, "--agent", "avi"])
end

def note_deferred(slug, outcome, reports)
  description = "pr-review deferred #{slug}: #{outcome}. #{reports.map { |r| report_summary(r) }.join("; ")}"
  task_write(["note", slug, "--comment", description, "--agent", "avi"])
end

def task_wave_size(remaining_reviews)
  return 1 if OPTIONS.fetch(:mode) == "slow"

  # The operating model caps concurrent agents at 5. Each PR consumes a PRIMARY
  # and LIGHT reviewer, so use complete reviewer pairs and leave an odd spare
  # slot idle instead of launching a partial PR lane.
  pair_capacity = [OPTIONS.fetch(:max_agents) / 2, 1].max
  [pair_capacity, remaining_reviews].min
end

def start_review(task, review_number)
  slug = task.fetch("slug")
  puts
  puts "Review #{review_number}/#{OPTIONS.fetch(:limit)}: #{slug} #{task["title"]}"
  puts "  submitted_at=#{task["submitted_at"] || "-"} created_at=#{task["created_at"]} task=#{task["task_url"]}"
  puts "  pr=#{task.dig("devops", "pr_url") || "missing"}"

  # CI gate-zero — the supervisor's opening act (ci-gate-review-handoff): the
  # builder submitted without waiting for CI, so check the PR's LIVE CI before
  # burning any reviewer tokens. Red/conflicted → bounce back (actionable);
  # pending/none → defer the wave (CI genuinely still coming); green → spawn.
  # Unverified/no_pr/closed/merged proceed — the primary's strict gate-zero
  # (dor-check --gate-role review) is the authoritative verdict.
  ci = supervisor_ci_check(task)
  base = { task: task, slug: slug, reviewers: [], reviewer_slugs: [], launches: [] }
  case ci[:state]
  when :red
    puts "  ci=RED (#{Array(ci[:failing]).join(", ")}) — blocking back without spawning reviewers"
    return base.merge(ci_red: ci)
  when :conflicted
    # NOT a defer: a conflicted PR has no CI coming (GitHub can't compute the
    # merge commit), so "wait for CI" waits forever (the PR-#509 stall). Bounce
    # it back with the fix named, exactly like red — the builder must act.
    puts "  ci=CONFLICTED (mergeStateStatus DIRTY) — blocking back without spawning reviewers"
    return base.merge(ci_conflicted: ci)
  when :ci_less
    # Same bounce, for the stale-base case that never reads DIRTY: zero check-runs
    # and a merge GitHub won't confirm. Deferring here is the bug this state fixes —
    # the wave would wait forever on checks that will never exist.
    puts "  ci=CI-LESS (no checks will run; base stale) — blocking back without spawning reviewers"
    return base.merge(ci_less: ci)
  when :pending
    puts "  ci=PENDING (#{Array(ci[:pending]).join(", ")}) — deferring until CI settles"
    return base.merge(ci_wait: ci)
  when :none
    puts "  ci=NONE (no checks reported yet) — deferring until CI reports"
    return base.merge(ci_wait: ci)
  when :unreadable
    # MUST NOT defer. A deferral waits for CI to "report" — but CI already reported
    # and this token cannot hear it, so the wave would defer this task forever while
    # the board looked healthy (the PR-#509 failure mode, with a credential as the
    # cause). Proceed to review, and say plainly that CI went UNCHECKED — the reviewer
    # is now the only thing standing between a red CI and a merge.
    puts "  ci=UNREADABLE (#{ci[:reason]}) — the token was refused; NOT deferring (CI has reported; we cannot read it)"
    puts "  #{CiStatus.unreadable_remedy(CiStatus.repo_from_pr_url(task.dig("devops", "pr_url")),
                                        cause: ci[:cause])}"
    puts "  proceeding to review WITHOUT a CI verdict — review this PR as if CI were unchecked, because it is"
  when :green
    puts "  ci=green#{ci[:count] ? " (#{ci[:count]} checks)" : ""}"
  else
    puts "  ci=#{ci[:state]}#{ci[:reason] ? " (#{ci[:reason]})" : ""} — proceeding; the primary's gate-zero verifies CI"
  end

  # Gate-zero (dor_review) opens as the supervisor proceeds past CI — the primary
  # reviewer's `bin/dor-check <slug> --gate-role review` closes it with the
  # authoritative verdict (open! is idempotent, so its own open reuses this row).
  gate_write("open", "task", slug, "dor_review", "--actor", "avi")

  # Supervisor step: Avi (thin gate) SELECTS the primary+light pair — he never
  # reviews code himself, so this narrates as "select primary+light reviewers"
  # (NOT "summon Avi").
  reviewers = select_reviewers(slug)
  reviewer_slugs = reviewers.map { |reviewer| reviewer.fetch("slug") }
  puts "  select primary+light reviewers: #{reviewer_slugs.join(" + ")}"

  # Spawn BOTH role reviewers IN PARALLEL as sibling children of the supervisor —
  # reviewers[0] = primary (deep review), reviewers[1] = light (second read). They
  # are launched non-blocking here and both waited on later in finish_review, so
  # they run concurrently; the supervisor never performs a review itself.
  roles = %w[primary light]
  # Open the G2 gate lanes as the pair launches (attempt-aware: a re-review of a
  # resubmitted task opens attempt n+1; a still-open lane from a deferred wave is
  # reused). Closed per-lane from the scout reports in finish_review.
  reviewers.each_with_index do |reviewer, index|
    key = G2_LANE_KEYS[roles[index]] or next
    gate_write("open", "task", slug, key, "--actor", reviewer.fetch("slug"))
  end
  launches = reviewers.each_with_index.map do |reviewer, index|
    launch_reviewer(task, reviewer, roles.fetch(index), reviewers)
  end

  { task: task, slug: slug, reviewers: reviewers, reviewer_slugs: reviewer_slugs, launches: launches }
rescue StandardError => e
  { task: task, slug: task["slug"], reviewers: [], reviewer_slugs: [], launches: [], error: e.message }
end

# The dry-run's TERMINAL act: say what the run WOULD do to this task, then stop.
# Everything in finish_review past this point is the RESOLUTION path — it waits on
# reviewer processes, then reads the task's scout reports and gates a verdict from
# them. In a dry-run no reviewer ran, so those reports belong to EARLIER review
# rounds; resolving from them printed a full "completed_reviews=1 approved=0
# blocked=1" retrospective, echoing prior reviewers' verdicts, for a run that
# reviewed nothing. A preview must be legible AS a preview.
def preview_review(review, events, handled)
  slug = review.fetch(:slug)
  reviewer_slugs = review.fetch(:reviewer_slugs)

  reason =
    if (ci = review[:ci_red])
      "would block back — CI is RED (#{Array(ci[:failing]).join(", ")}); no reviewer would be summoned"
    elsif (ci = review[:ci_wait])
      wait = ci[:state] == :none ? "no CI checks reported yet" : "CI still running"
      "would defer — #{wait}; no reviewer would be summoned"
    else
      "would summon #{reviewer_slugs.join(" + ")}; no reviewer launched, no verdict collected"
    end

  puts "  dry-run: preview only — #{reason}"
  events << { slug: slug, status: :previewed, category: "dry-run-preview", reason: reason, reviewers: reviewer_slugs }
  handled[slug] = true
end

def finish_review(review, events, handled, deferred_until)
  slug = review.fetch(:slug)
  reviewer_slugs = review.fetch(:reviewer_slugs)

  if review[:error]
    events << { slug: slug, status: :tool_failure, category: "heartbeat-error", reason: review[:error], reviewers: reviewer_slugs }
    handled[slug] = true
    puts "  error: #{review[:error]}"
    return false
  end

  # DRY-RUN STOPS HERE — at the reviewer pair it WOULD summon (see preview_review).
  # It returns true so the preview consumes one --limit slot and a bounded dry-run
  # terminates; the retrospective counts it as `previewed`, never as a completed,
  # approved, or blocked review. --run behavior below is unchanged.
  unless OPTIONS.fetch(:run)
    preview_review(review, events, handled)
    return true
  end

  # CI gate-zero resolutions (no reviewers were spawned for these).
  if (ci = review[:ci_red])
    failing = Array(ci[:failing]).join(", ")
    # The CI bounce IS review's gate-zero verdict this round — record it as a
    # failed dor_review attempt with a ci SOP (actor avi, the supervisor), so the
    # round-trip shows on the task's gates card even though no reviewer ran. (The
    # gate-zero lives on dor_review now, not G2a — the G2 lanes only close from an
    # actual reviewer's scout report.)
    gate_write("open", "task", slug, "dor_review", "--actor", "avi")
    gate_write("close", "task", slug, "dor_review", "--failed", "--actor", "avi",
               "--sop-json", JSON.generate({ "sop" => "ci", "result" => "fail" }),
               "--meta", "outcome=ci-red")
    feedback = "pr-review CI gate: GitHub CI is RED for the PR (#{failing}) — blocked back before spawning " \
               "reviewers. Fix the failing checks, push, and resubmit; the supervisor re-checks CI at the next wave."
    ok = task_write(["block", slug, "--kind", "rework", "--feedback", feedback, "--agent", "avi"])
    events << { slug: slug, status: ok ? :blocked : :tool_failure, category: "ci-red",
                reason: "GitHub CI red: #{failing}", reviewers: [] }
    handled[slug] = true
    return ok
  end
  if review[:ci_conflicted]
    # The conflict bounce is review's gate-zero verdict this round too — a failed
    # dor_review attempt with a ci SOP, outcome ci-conflicted (distinct from
    # ci-red so the retrospective can tell "broken tests" from "stale branch").
    gate_write("open", "task", slug, "dor_review", "--actor", "avi")
    gate_write("close", "task", slug, "dor_review", "--failed", "--actor", "avi",
               "--sop-json", JSON.generate({ "sop" => "ci", "result" => "fail" }),
               "--meta", "outcome=ci-conflicted")
    feedback = "pr-review CI gate — deferring a conflicted PR would strand this task in submitted. " +
               CiStatus.conflicted_remedy(review[:ci_conflicted])
    ok = task_write(["block", slug, "--kind", "rework", "--feedback", feedback, "--agent", "avi"])
    events << { slug: slug, status: ok ? :blocked : :tool_failure, category: "ci-conflicted",
                reason: "PR merge-conflicted against base (mergeStateStatus DIRTY)", reviewers: [] }
    handled[slug] = true
    return ok
  end
  if (ci = review[:ci_less])
    # The stale-base bounce, recorded with its OWN outcome so the retrospective can
    # separate "no CI will ever run" from a merge conflict and from red tests.
    gate_write("open", "task", slug, "dor_review", "--actor", "avi")
    gate_write("close", "task", slug, "dor_review", "--failed", "--actor", "avi",
               "--sop-json", JSON.generate({ "sop" => "ci", "result" => "fail" }),
               "--meta", "outcome=ci-less")
    # The remedy is self-complete (it ends by naming the push + re-check). Round 3
    # rewrote it to prescribe `merge`, NOT rebase, because a halted merge leaves the
    # branch untouched — so the closer must not re-introduce "rebased" vocabulary, and
    # in the no-base case the remedy DECLINES to give a command, which an appended one
    # would contradict. Add only the workflow step the remedy does not cover.
    feedback = "pr-review CI gate: #{CiStatus.ci_less_remedy(ci)} Then resubmit the task for review."
    ok = task_write(["block", slug, "--kind", "rework", "--feedback", feedback, "--agent", "avi"])
    events << { slug: slug, status: ok ? :blocked : :tool_failure, category: "ci-less",
                reason: "PR will never get CI (stale base; zero check-runs)", reviewers: [] }
    handled[slug] = true
    return ok
  end
  if (ci = review[:ci_wait])
    reason = ci[:state] == :none ? "PR reports no CI checks yet" : "GitHub CI still running: #{Array(ci[:pending]).join(", ")}"
    events << { slug: slug, status: :deferred, category: "wait-for-ci", reason: reason, reviewers: [] }
    deferred_until[slug] = Time.now + OPTIONS.fetch(:defer_seconds)
    puts "  deferred: #{reason}"
    return false
  end

  launches = wait_for_reviewers(review.fetch(:launches))
  failures = launches.reject { |launch| launch[:success] }
  if failures.any?
    reason = failures.map { |f| "#{f[:reviewer]} exit=#{f[:exitstatus] || "?"} #{f[:error]}".strip }.join("; ")
    events << { slug: slug, status: :tool_failure, category: "reviewer-launch", reason: reason, reviewers: reviewer_slugs }
    handled[slug] = true
    puts "  reviewer failure: #{reason}"
    return false
  end

  fresh = fetch_snapshot
  fresh_task = task_by_slug(fresh, slug)
  if fresh_task.nil?
    reason = "task no longer appears in submitted after review"
    events << { slug: slug, status: :deferred, category: "stage-changed", reason: reason, reviewers: reviewer_slugs }
    handled[slug] = true
    puts "  skipped: #{reason}"
    return false
  end

  reviewers = review.fetch(:reviewers)
  reports = latest_reports_by_reviewer(fresh_task, reviewers)
  outcome = outcome_from_reports(reports, OPTIONS.fetch(:required_approvals))
  decision = task_decision(fresh, slug)
  reports_text = reports.map { |r| report_summary(r) }.join(" | ")
  puts "  reports=#{reports_text.empty? ? "none" : reports_text}"
  puts "  decision=#{decision&.fetch("recommendation", nil) || "none"} outcome=#{outcome}"

  # Close each G2 lane from its OWN reviewer's report (a reportless lane stays
  # in flight for the next wave) — before the task-level outcome dispatch.
  close_review_gates(slug, reviewers, reports)

  case outcome
  when "merge-ready"
    ok = move_reviewed(slug, fresh_task, reviewers, reports)
    status = ok ? :reviewed : :tool_failure
    events << { slug: slug, status: status, category: ok ? "approved" : "task-write", reason: "merge-ready", reviewers: reviewer_slugs }
    handled[slug] = true
    ok
  when "request-changes"
    ok = block_for_rework(slug, reports)
    events << { slug: slug, status: ok ? :blocked : :tool_failure, category: "request-changes", reason: reports.map { |r| report_summary(r) }.join("; "), reviewers: reviewer_slugs }
    handled[slug] = true
    ok
  when "wait-for-ci", "conductor-review", "incomplete"
    category = outcome == "incomplete" ? "missing-scout-report" : outcome
    reason = reports.empty? ? "missing required reviewer reports" : reports.map { |r| report_summary(r) }.join("; ")
    note_deferred(slug, outcome, reports) unless outcome == "incomplete" && !OPTIONS.fetch(:run)
    events << { slug: slug, status: :deferred, category: category, reason: reason, reviewers: reviewer_slugs }
    deferred_until[slug] = Time.now + OPTIONS.fetch(:defer_seconds)
    puts "  deferred: #{reason}"
    false
  else
    false
  end
rescue StandardError => e
  events << { slug: slug, status: :tool_failure, category: "heartbeat-error", reason: e.message, reviewers: reviewer_slugs }
  handled[slug] = true
  puts "  error: #{e.message}"
  false
end

def commonality_counts(items)
  items.each_with_object(Hash.new(0)) { |item, counts| counts[item[:category]] += 1 }
end

def print_retrospective(started_at, events, idle_cycles)
  completed = events.count { |event| %i[reviewed blocked].include?(event[:status]) }
  approved = events.select { |event| event[:status] == :reviewed }
  blocked = events.select { |event| event[:status] == :blocked }
  deferred = events.select { |event| event[:status] == :deferred }
  failed = events.select { |event| event[:status] == :tool_failure }
  # A dry-run reviews nothing, so it completes/approves/blocks nothing — its work
  # lands here instead of inflating the review counters.
  previewed = events.select { |event| event[:status] == :previewed }

  puts
  puts "pr-review Retrospective"
  puts "---------------------------"
  puts "started=#{started_at.utc.iso8601}"
  puts "finished=#{now_iso}"
  puts "completed_reviews=#{completed} approved=#{approved.size} blocked=#{blocked.size} " \
       "deferred=#{deferred.size} tool_failures=#{failed.size} previewed=#{previewed.size} idle_cycles=#{idle_cycles}"

  unless previewed.empty?
    puts
    puts "Previewed (dry-run — nothing launched, nothing written)"
    previewed.each { |event| puts "  - #{event[:slug]}: #{event[:reason]}" }
  end

  puts
  puts "Reviewed"
  if approved.empty?
    puts "  none"
  else
    approved.each { |event| puts "  - #{event[:slug]}: moved to reviewed (#{event[:reviewers].join(" + ")})" }
  end

  puts
  puts "Blocked Or Deferred"
  if blocked.empty? && deferred.empty? && failed.empty?
    puts "  none"
  else
    (blocked + deferred + failed).each do |event|
      puts "  - #{event[:slug]}: #{event[:category]} — #{event[:reason]}"
    end
  end

  counts = commonality_counts(blocked + deferred + failed)
  puts
  puts "Commonalities"
  if counts.empty?
    puts "  no repeated blockers"
  else
    counts.sort_by { |_, count| -count }.each { |category, count| puts "  - #{category}: #{count}" }
  end

  puts
  puts "Refactor Candidates"
  suggestions = []
  suggestions << "tighten reviewer prompts or report validation" if counts["missing-scout-report"].to_i.positive?
  suggestions << "improve PR/task/worktree readiness before submission" if counts["request-changes"].to_i.positive?
  suggestions << "separate CI-waiting cards from review-ready intake" if counts["wait-for-ci"].to_i.positive?
  suggestions << "red-CI submits reached review — check builders see dor-check's submit-side CI suggestion" if counts["ci-red"].to_i.positive?
  suggestions << "conflicted PRs reached review — builders should merge their PR's base in and resolve conflicts before submit (dor-check now flags DIRTY)" if counts["ci-conflicted"].to_i.positive?
  suggestions << "CI-less PRs reached review — a stale base means GitHub runs NO CI at all; builders should merge the current base in before submit (dor-check now flags it)" if counts["ci-less"].to_i.positive?
  suggestions << "add clearer high-risk escalation rules" if counts["conductor-review"].to_i.positive?
  suggestions << "no systemic refactor surfaced in this heartbeat" if suggestions.empty?
  suggestions.each { |suggestion| puts "  - #{suggestion}" }
end

def due_for_retry?(slug, deferred_until)
  deadline = deferred_until[slug]
  deadline.nil? || Time.now >= deadline
end

started_at = Time.now
events = []
completed_reviews = 0
idle_cycles = 0
handled = {}
deferred_until = {}

puts "pr-review #{OPTIONS.fetch(:run) ? "RUN" : "DRY-RUN"}"
puts "mode=#{OPTIONS.fetch(:mode)} limit=#{OPTIONS.fetch(:limit)} newest_first=true fresh_query_after_each_review=true max_agents=#{OPTIONS.fetch(:max_agents)}"
puts "output_dir=#{File.expand_path(OPTIONS.fetch(:output_dir), ROOT)}"

loop do
  break if completed_reviews >= OPTIONS.fetch(:limit)

  snapshot = fetch_snapshot
  candidates = submitted_tasks(snapshot).reject { |task| handled[task.fetch("slug")] }
  candidates = candidates.select { |task| due_for_retry?(task.fetch("slug"), deferred_until) }

  if candidates.empty?
    idle_cycles += 1
    puts "idle ##{idle_cycles}: no submitted PR is ready"
    break if OPTIONS.fetch(:once)
    break if OPTIONS.fetch(:max_idle_cycles) >= 0 && idle_cycles >= OPTIONS.fetch(:max_idle_cycles)

    sleep OPTIONS.fetch(:idle_sleep) if OPTIONS.fetch(:idle_sleep).positive?
    next
  end

  idle_cycles = 0
  remaining_reviews = OPTIONS.fetch(:limit) - completed_reviews
  wave = candidates.first(task_wave_size(remaining_reviews))
  puts "fast wave: tasks=#{wave.map { |candidate| candidate.fetch("slug") }.join(", ")}" if OPTIONS.fetch(:mode) == "fast"

  started = wave.each_with_index.map do |task, index|
    start_review(task, completed_reviews + index + 1)
  end

  started.each do |review|
    completed_reviews += 1 if finish_review(review, events, handled, deferred_until)
  end

  break if OPTIONS.fetch(:once)
end

print_retrospective(started_at, events, idle_cycles)
