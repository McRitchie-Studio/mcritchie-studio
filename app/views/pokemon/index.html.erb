<% content_for(:title, "Pokédex") %>

<section class="space-y-6" data-test="pokedex">
  <div class="flex items-end justify-between gap-4 flex-wrap">
    <div>
      <p class="label-upper">Pokédex</p>
      <h1 class="text-2xl md:text-3xl font-bold text-heading">Spawned Pokémon</h1>
    </div>
    <%= link_to "← Dashboard", dashboard_path, class: "text-muted hover:text-heading transition text-sm" %>
  </div>

  <div class="grid gap-4 xl:grid-cols-3">
    <article class="card p-5" data-test="pokemon-stats-card">
      <h2 class="text-lg font-semibold text-heading mb-5">Stats</h2>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
        <div class="rounded-lg border border-subtle bg-surface p-4">
          <p class="text-xs text-muted">Total Pokémon</p>
          <p class="mt-2 text-3xl font-bold text-heading tabular-nums"><%= number_with_delimiter(@pokedex.total_pokemon) %></p>
        </div>
        <div class="rounded-lg border border-subtle bg-surface p-4">
          <p class="text-xs text-muted">Summoned Pokémon</p>
          <p class="mt-2 text-3xl font-bold text-heading tabular-nums"><%= number_with_delimiter(@pokedex.summoned_pokemon) %></p>
        </div>
        <div class="rounded-lg border border-subtle bg-surface p-4">
          <p class="text-xs text-muted">Shiny Pokémon</p>
          <p class="mt-2 text-3xl font-bold text-heading tabular-nums"><%= number_with_delimiter(@pokedex.shiny_pokemon) %></p>
        </div>
      </div>
    </article>

    <%= render "spawn_card",
          title: "Newest Pokémon",
          sighting: @newest_unique,
          data_test: "latest-pokemon-card",
          empty_test: "latest-pokemon-empty",
          empty_text: "No spawned Pokémon yet." %>

    <%= render "spawn_card",
          title: "Newest Shiny",
          sighting: @newest_unique_shiny,
          data_test: "latest-shiny-card",
          empty_test: "latest-shiny-empty",
          empty_text: "No shiny Pokémon yet." %>
  </div>

  <div class="card overflow-x-auto" data-test="recent-pokemon-actions">
    <table class="w-full text-sm">
      <thead class="text-secondary border-b border-subtle">
        <tr>
          <th class="text-left p-3">Pokémon</th>
          <th class="text-left p-3">Action</th>
          <th class="text-left p-3">Task</th>
          <th class="text-left p-3">Outcome</th>
          <th class="text-right p-3">When</th>
        </tr>
      </thead>
      <tbody>
        <% if @recent_actions.any? %>
          <% @recent_actions.each do |row| %>
            <% action = row.action %>
            <% pokemon = row.pokemon %>
            <tr class="border-b border-subtle/50 hover:bg-surface" data-test="recent-pokemon-action">
              <td class="p-3">
                <div class="flex items-center gap-3">
                  <img src="<%= pokemon.display_sprite %>" alt="<%= pokemon.name %>"
                       class="w-10 h-10 object-contain shrink-0"
                       loading="lazy"
                       onerror="this.style.visibility='hidden'">
                  <div>
                    <div class="font-medium text-heading"><%= pokemon.name %></div>
                    <div class="text-xs text-muted font-mono"><%= pokemon.slug %></div>
                  </div>
                </div>
              </td>
              <td class="p-3 min-w-56">
                <div class="text-heading font-medium"><%= action.kind.to_s.humanize %></div>
                <div class="text-secondary text-xs truncate max-w-md">
                  <%= action.summary.presence || action.result_slug.presence || action.event_slug.presence || "Action #{action.seq}" %>
                </div>
              </td>
              <td class="p-3">
                <% if action.task %>
                  <%= link_to action.task.title, task_path(action.task.slug),
                        class: "text-primary hover:underline whitespace-nowrap" %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td class="p-3 text-secondary"><%= action.outcome.to_s.humanize %></td>
              <td class="p-3 text-right text-muted whitespace-nowrap">
                <time datetime="<%= action.occurred_at.iso8601 %>">
                  <%= l(action.occurred_at, format: :short) %>
                </time>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="p-8 text-center text-secondary" data-test="recent-pokemon-empty">
              No Pokémon actions yet.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
