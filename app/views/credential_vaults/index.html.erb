<% content_for :title, "Credentials · McRitchie Studio" %>

<section class="max-w-5xl mx-auto px-4 py-10" data-test="credentials-page">
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Credentials</p>
    <h1 class="text-3xl font-bold text-heading mb-2">Vaults by client workspace</h1>
    <p class="text-muted max-w-2xl">
      Records of what each 1Password vault holds, never the secrets themselves. Each workspace's
      vaults wear the icon <code>bin/onepass-icon</code> renders for it.
    </p>
  </header>

  <div class="space-y-6">
    <% @workspaces.each do |scope, workspace| %>
      <% vaults = @vaults_by_scope.fetch(scope, []) %>
      <% icon = "#{CredentialVault::ICON_DIR}/#{scope}.png" %>
      <% rendered = Rails.root.join("app/assets/images", icon).file? %>
      <article class="rounded-2xl border border-subtle bg-surface p-6" data-test="credential-workspace" data-scope="<%= scope %>">
        <div class="flex flex-col sm:flex-row gap-6">
          <div class="shrink-0 w-32 h-32 flex items-center justify-center" data-test="workspace-icon">
            <% if rendered %>
              <%= image_tag icon, alt: "#{workspace['name']} 1Password vault icon", class: "w-32 h-32", data: { test: "workspace-icon-image" } %>
            <% else %>
              <div class="w-28 h-28 rounded-full border-2 border-dashed border-subtle flex items-center justify-center text-center text-xs text-muted p-3"
                   data-test="workspace-icon-missing">
                <%= workspace["badge"] ? "Not rendered yet" : "No badge on file" %>
              </div>
            <% end %>
          </div>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-1">
              <h2 class="text-xl font-bold text-heading"><%= workspace["name"] %></h2>
              <span class="text-xs font-mono text-muted"><%= scope %></span>
              <% if workspace["accent"] %>
                <span class="inline-flex items-center gap-1 text-xs text-muted">
                  <span class="inline-block w-3 h-3 rounded-full" style="background: <%= workspace['accent'] %>"></span><%= workspace["accent"] %>
                </span>
              <% end %>
            </div>
            <% domain_vault = vaults.find(&:workspace_domain) %>
            <p class="text-sm text-muted mb-4">
              <% if domain_vault %>
                Client workspace <span class="font-mono"><%= domain_vault.workspace_domain %></span>
                · <%= domain_vault.workspace_account ? domain_vault.workspace_account.status : "not registered" %>
              <% else %>
                No Google Workspace linked
              <% end %>
            </p>
            <% unless rendered %>
              <p class="text-xs text-muted mb-4">
                Render it: <code class="font-mono">bin/onepass-icon --workspace <%= scope %><%= " --badge PATH" unless workspace["badge"] %></code>
              </p>
            <% end %>

            <% if vaults.empty? %>
              <p class="text-sm text-muted" data-test="no-vaults">No vaults recorded for this workspace.</p>
            <% end %>
            <% vaults.each do |vault| %>
              <div class="mb-4 last:mb-0" data-test="credential-vault" data-vault="<%= vault.slug %>">
                <div class="flex flex-wrap items-baseline gap-2 mb-1">
                  <h3 class="font-semibold text-heading font-mono text-sm"><%= vault.slug %></h3>
                  <span class="text-xs rounded-full border border-subtle px-2 py-0.5 text-muted"><%= vault.lane %></span>
                  <% unless vault.status == "active" %>
                    <span class="text-xs rounded-full border border-subtle px-2 py-0.5 text-muted"><%= vault.status %></span>
                  <% end %>
                </div>
                <p class="text-xs text-muted mb-2"><%= vault.purpose %></p>
                <% if vault.credential_records.any? %>
                  <ul class="divide-y divide-subtle rounded-lg border border-subtle text-sm">
                    <% vault.credential_records.sort_by { |r| [ r.live? ? 0 : 1, r.title ] }.each do |record| %>
                      <li class="px-3 py-2 flex flex-col sm:flex-row sm:items-baseline gap-x-3 <%= 'opacity-60' unless record.live? %>" data-test="credential-record">
                        <span class="font-mono text-heading break-all"><%= record.title %></span>
                        <span class="text-xs text-muted flex-1"><%= record.scope_summary.presence || record.notes %></span>
                        <span class="text-xs text-muted whitespace-nowrap"><%= record.status %></span>
                      </li>
                    <% end %>
                  </ul>
                <% else %>
                  <p class="text-xs text-muted">No records yet.</p>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </article>
    <% end %>
  </div>
</section>
