<%# Up to three big numbers in a row. Locals: stats ([[value, label], ...], blanks
    already removed), color. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <% stats.each do |value, label| %>
      <td align="center" style="color:<%= color %>;">
        <div style="font-size:44px;font-weight:900;line-height:1;"><%= value %></div>
        <div style="padding-top:6px;font-size:12px;font-weight:800;letter-spacing:1px;"><%= label %></div>
      </td>
    <% end %>
  </tr>
</table>
