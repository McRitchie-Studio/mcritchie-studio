<%# LOGO STUDIO: one row per brand in config/logo_brands.yml, with one logo of
    each type (its icon, its rule-of-4 Navbar Logo with the second word
    leading, its Stacked Logo with the first word leading), each shown once in
    the context the dropdown picks (light, dark or watermark), then its
    typeface hierarchy (each level's name in its own face) and its palette (its one list of named colours; a click copies a hex). Each logo links to its own tab of the brand page.
    Below the xl breakpoint a row is a stack of labelled cells; the wrapper
    scrolls sideways if a table row ever outgrows it, so the page body never
    does. Read-only. Admin only (LogosController). %>
<%= render "components/copy_text_script" %>
<div class="max-w-6xl mx-auto px-4 py-6 space-y-5">
  <div class="space-y-1">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-xl sm:text-2xl font-bold text-heading mr-auto">Logos</h1>
      <%= render "context_form", url: logos_path %>
    </div>
    <p class="text-sm text-secondary">Each brand's icon, Navbar Logo and Stacked Logo, drawn from its icon and its name. Open a brand to see every version and how it was built.</p>
    <p class="text-2xs text-muted" data-test="read-only-note">This page only shows the logos. Choosing one for a brand comes later, with the brand kit record.</p>
    <%= render "context_notes" %>
  </div>

  <div class="card p-4 sm:p-5">
    <div class="overflow-x-auto" data-test="logo-table-scroll">
      <table class="w-full block xl:table text-sm" data-test="logo-brands">
        <thead class="hidden xl:table-header-group text-left text-3xs uppercase tracking-wide text-muted">
          <tr>
            <th scope="col" class="pb-2 pr-3 font-semibold">Brand</th>
            <% Logos::Variant::TYPES.each_value do |type| %>
              <th scope="col" class="pb-2 pr-3 font-semibold"><%= type %></th>
            <% end %>
            <th scope="col" class="pb-2 pr-3 font-semibold">Typeface</th>
            <th scope="col" class="pb-2 font-semibold">Colours</th>
          </tr>
        </thead>
        <tbody class="block xl:table-row-group divide-y divide-subtle">
          <% @rows.each do |logo, samples| %>
            <% name = Logos::Variant.brand_name(logo) %>
            <tr class="block xl:table-row" data-test="logo-brand-row" data-brand="<%= logo.brand %>">
              <th scope="row" class="block xl:table-cell py-3 xl:pr-3 text-left align-top">
                <%= link_to name, logo_brand_path(logo.brand, logo_page_params), class: "font-bold text-primary hover:underline" %>
                <p class="text-3xs text-muted font-mono font-normal"><%= logo.brand %></p>
              </th>
              <% samples.each do |type, variant| %>
                <%# In the table a sample keeps its full size (no max-width), or the auto layout would squeeze it to nothing.
                    The six columns' least widths add up to about 1061 px, inside the 1078 px the card has on a 1280 px page,
                    so the wrapper does not scroll there; a narrower gutter (pr-3) and the Colours minimum keep it so. %>
                <td class="block xl:table-cell pb-3 xl:py-3 xl:pr-3 align-top xl:[&_img]:max-w-none" data-test="logo-sample" data-type="<%= type %>">
                  <p class="xl:hidden pb-1 text-3xs uppercase tracking-wide text-muted"><%= Logos::Variant::TYPES.fetch(type) %></p>
                  <% if variant.is_a?(Logos::NavbarLogo::Error) %>
                    <%# The library refused to draw this type for this brand: the reason, in its own words, not a picture. %>
                    <p class="max-w-[14rem] text-2xs text-muted" data-test="logo-sample-refused">Not drawn. <%= variant.message %></p>
                  <% else %>
                    <%= link_to logo_brand_path(logo.brand, logo_page_params(type: (type unless type == :navbar))),
                                class: "inline-flex max-w-full rounded-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary",
                                aria: { label: "#{name}: #{Logos::Variant::TYPES.fetch(type).downcase}" } do %>
                      <span class="flex items-center rounded-lg border border-subtle px-3 py-2 min-w-0" style="<%= logo_plate_style(@context) %>" data-test="logo-plate" data-tone="<%= @context %>">
                        <%= logo_image(variant, height: LogosHelper::LOGO_SAMPLE_HEIGHTS.fetch(type)) %>
                      </span>
                    <% end %>
                  <% end %>
                </td>
              <% end %>
              <td class="block xl:table-cell pb-3 xl:py-3 xl:pr-3 align-top xl:min-w-[11rem]" data-test="logo-typeface">
                <p class="xl:hidden pb-1 text-3xs uppercase tracking-wide text-muted">Typeface</p>
                <%= render "typefaces", kit: Logos::BrandKit.new(logo.brand), compact: true %>
              </td>
              <td class="block xl:table-cell pb-3 xl:py-3 align-top xl:min-w-[15.5rem]" data-test="logo-colours">
                <p class="xl:hidden pb-1 text-3xs uppercase tracking-wide text-muted">Colours</p>
                <%= render "palette", kit: Logos::BrandKit.new(logo.brand), compact: true %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>
