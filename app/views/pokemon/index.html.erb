<section x-data="{ view: (localStorage.getItem('pokemonView') || 'list') }"
         x-init="$watch('view', v => localStorage.setItem('pokemonView', v))">
  <div class="flex items-baseline justify-between mb-6 gap-4 flex-wrap">
    <h2 class="text-2xl font-bold text-heading">Pokémon <span class="text-muted text-base font-normal">· reference data</span></h2>
    <div class="flex items-center gap-3">
      <span class="text-secondary text-sm"><%= @pokemon.size %> seeded</span>
      <%# List / Grid toggle — client-side view state, persisted to localStorage. %>
      <div class="inline-flex rounded-lg border border-subtle overflow-hidden" role="group" aria-label="View">
        <button type="button" @click="view = 'list'"
                :class="view === 'list' ? 'bg-primary text-white' : 'bg-surface text-secondary hover:text-heading'"
                class="px-3 py-1.5 text-sm font-medium transition" data-test="view-list">List</button>
        <button type="button" @click="view = 'grid'"
                :class="view === 'grid' ? 'bg-primary text-white' : 'bg-surface text-secondary hover:text-heading'"
                class="px-3 py-1.5 text-sm font-medium transition border-l border-subtle" data-test="view-grid">Grid</button>
      </div>
    </div>
  </div>

  <%# List view — the dense data table (small sprite thumbnails). %>
  <div x-show="view === 'list'" x-cloak class="card overflow-x-auto" data-test="pokemon-list">
    <table class="w-full text-sm">
      <thead class="text-secondary border-b border-subtle">
        <tr>
          <th class="text-left p-3"></th>
          <th class="text-left p-3">#</th>
          <th class="text-left p-3">Name</th>
          <th class="text-left p-3">Slug</th>
          <th class="text-left p-3">Types</th>
          <th class="text-right p-3">HP</th>
          <th class="text-right p-3">Atk</th>
          <th class="text-right p-3">Def</th>
          <th class="text-right p-3">SpA</th>
          <th class="text-right p-3">SpD</th>
          <th class="text-right p-3">Spe</th>
          <th class="text-right p-3">Gen</th>
          <th class="text-left p-3">Avatar (S3)</th>
        </tr>
      </thead>
      <tbody>
        <% @pokemon.each do |p| %>
          <tr class="border-b border-subtle/50 hover:bg-surface">
            <td class="p-2">
              <img src="<%= p.sprite_url %>" alt="<%= p.name %>" width="40" height="40"
                   class="w-10 h-10 object-contain" loading="lazy" onerror="this.style.visibility='hidden'">
            </td>
            <td class="p-3 text-muted tabular-nums"><%= format("%03d", p.dex) %></td>
            <td class="p-3 font-medium text-heading whitespace-nowrap"><%= p.name %></td>
            <td class="p-3 text-secondary font-mono text-xs"><%= p.slug %></td>
            <td class="p-3">
              <div class="flex gap-1">
                <% p.types.each do |type| %>
                  <%= render "type_badge", type: type, enumeral: @type_enumerals[type] %>
                <% end %>
              </div>
            </td>
            <td class="p-3 text-right text-secondary tabular-nums"><%= p.hp %></td>
            <td class="p-3 text-right text-secondary tabular-nums"><%= p.attack %></td>
            <td class="p-3 text-right text-secondary tabular-nums"><%= p.defense %></td>
            <td class="p-3 text-right text-secondary tabular-nums"><%= p.special_attack %></td>
            <td class="p-3 text-right text-secondary tabular-nums"><%= p.special_defense %></td>
            <td class="p-3 text-right text-secondary tabular-nums"><%= p.speed %></td>
            <td class="p-3 text-right text-muted tabular-nums"><%= p.generation %></td>
            <td class="p-3">
              <% if p.avatar_url.present? %>
                <a href="<%= p.avatar_url %>" target="_blank" rel="noopener" class="text-primary hover:underline text-xs">S3 ↗</a>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Grid view — larger high-res avatars, lazy-loaded so the page stays light
      until the grid is shown (a hidden lazy img is not fetched). %>
  <div x-show="view === 'grid'" x-cloak
       class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4" data-test="pokemon-grid">
    <% @pokemon.each do |p| %>
      <div class="card p-3 flex flex-col items-center text-center">
        <div class="aspect-square w-full flex items-center justify-center">
          <%# Primary = the tightly-cropped avatar; on load failure fall back to the
              original uncropped artwork (avatar_fallback_url), then the pixel sprite. %>
          <img src="<%= p.display_avatar %>" alt="<%= p.name %>"
               class="max-h-32 w-auto object-contain" loading="lazy"
               onerror="this.onerror=null; this.src='<%= p.avatar_fallback_url.presence || p.sprite_url %>'">
        </div>
        <div class="mt-2 text-muted text-xs tabular-nums">#<%= format("%03d", p.dex) %></div>
        <div class="text-heading font-medium text-sm"><%= p.name %></div>
        <div class="flex flex-wrap justify-center gap-1 mt-1">
          <% p.types.each do |type| %>
            <%= render "type_badge", type: type, enumeral: @type_enumerals[type] %>
          <% end %>
        </div>
      </div>
    <% end %>
  </div>

  <p class="text-muted text-xs mt-3">
    Both the sprite and the high-res avatar are served from S3
    (<code>mcritchie-studio-production/pokemon/</code>), populated once by <code>rake pokemon:upload_images</code>.
  </p>
</section>
