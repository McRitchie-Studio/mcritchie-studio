<%# locals: (app:, app_cto:) %>
<%# The owner's CTO avatar picker in the app's chat (task cto-animal-avatar-bank, Alex 2026-10-20): the /build card's picker (build/_animal_picker) in its own form. The head's portrait and an avatar ask's answer open it ([data-cto-avatar-open], build_chat.js); a tap on an animal saves it (data-build-portrait-save) through CtoChatsController#avatar, which reloads the chat. %>
<%= form_with url: chat_avatar_application_path(app.slug), method: :patch, class: "contents",
      data: { cto_avatar_form: true, build_portrait_save: true, test: "cto-chat-avatar-form" } do %>
  <%= render "build/animal_picker", picked: app_cto.portrait, palette: app_cto.palette,
                                   set_url: chat_avatars_application_path(app.slug), title: "Pick my new look",
                                   footer: "Tap an animal to save it. #{app_cto.name} stays the same CTO; only the look changes." %>
<% end %>
