<%# THE MODEL LIBRARY for one person.
    Answers the question the re-skin decision turns on: what do we already have
    of this person, and in which looks. %>
<div class="max-w-5xl mx-auto px-4 py-8 space-y-6">

  <%# --- who --- %>
  <div class="card p-6 flex gap-5 items-start">
    <div class="w-24 h-24 shrink-0 rounded-full bg-surface-2 border border-border overflow-hidden flex items-center justify-center">
      <% headshot = @person.athlete_profile&.espn_headshot_url.presence || @person.avatar_url.presence %>
      <% if headshot %>
        <%= image_tag headshot, class: "object-cover w-full h-full" %>
      <% else %>
        <span class="text-3xl opacity-40">👤</span>
      <% end %>
    </div>

    <div class="flex-1 min-w-0">
      <h1 class="text-2xl font-bold text-heading"><%= @person.full_name %></h1>
      <p class="text-sm text-muted"><%= @person.slug %></p>

      <div class="flex gap-2 flex-wrap mt-2">
        <% if (a = @person.athlete_profile) %>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-900/50 text-sky-300 border border-sky-700/50">ATHLETE</span>
          <% if a.position.present? %><span class="text-xs text-muted"><%= a.position %></span><% end %>
          <% if a.team.present? %><span class="text-xs text-muted"><%= a.team.name %></span><% end %>
        <% end %>
        <% if @person.coach? %>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-violet-900/50 text-violet-300 border border-violet-700/50">COACH</span>
        <% end %>
        <% unless @person.athlete? || @person.coach? %>
          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-600">PERSON</span>
        <% end %>
      </div>

      <%# What a generator has to work from. An athlete gets this free; anyone
          else needs it typed into a look's notes. %>
      <% if (a = @person.athlete_profile) && [a.build, a.skin_tone, a.hair_description].any?(&:present?) %>
        <p class="text-xs text-muted mt-3">
          <span class="label-upper">Generation data on file:</span>
          <%= [a.build, a.skin_tone, a.hair_description].compact_blank.join(" · ") %>
        </p>
      <% else %>
        <p class="text-xs text-amber-300/80 mt-3">
          No athlete record — a look's <em>generation notes</em> are the only source for this person.
        </p>
      <% end %>
    </div>
  </div>

  <%# --- the looks --- %>
  <div class="card p-6 space-y-4">
    <div class="flex items-center justify-between">
      <p class="label-upper text-primary">🎭 Models</p>
      <span class="text-xs text-muted">the first one created becomes the default</span>
    </div>

    <% if @appearances.any? %>
      <div class="space-y-2">
        <% @appearances.each do |look| %>
          <div class="rounded-lg border border-border p-3 flex items-center gap-3 flex-wrap">
            <span class="text-heading font-bold"><%= look.descriptor %></span>

            <% if look.default? %>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-900/50 text-emerald-300 border border-emerald-700/50">DEFAULT</span>
            <% else %>
              <%= button_to "Make default", make_default_appearance_person_path(@person.slug),
                    method: :post, params: { appearance_slug: look.slug },
                    class: "btn-secondary text-xs" %>
            <% end %>

            <% if look.colorway.present? %>
              <span class="text-xs text-muted"><%= look.colorway %></span>
            <% end %>

            <span class="ml-auto text-xs text-muted">
              <%= look.artifact_subjects.count %> image(s)
            </span>
          </div>

          <%# Attach an image for THIS look. %>
          <%= form_with url: attach_artifact_person_path(@person.slug), method: :post,
                        class: "flex items-center gap-2 flex-wrap pl-3 pb-2" do |f| %>
            <%= f.hidden_field :appearance_slug, value: look.slug %>
            <%= f.url_field :image_url, placeholder: "image URL for #{look.descriptor}",
                  class: "input-field text-xs w-80" %>
            <%= f.submit "Attach image", class: "btn-secondary text-xs" %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-muted">
        No models yet. Create one below — it becomes <%= @person.full_name %>'s default.
      </p>
    <% end %>

    <%# --- create a look --- %>
    <details class="rounded-lg bg-surface-2 p-4">
      <summary class="cursor-pointer text-sm font-bold text-heading">+ New model</summary>
      <%= form_with url: create_appearance_person_path(@person.slug), method: :post,
                    scope: :appearance, class: "mt-3 space-y-2" do |f| %>
        <%= f.text_field :descriptor, placeholder: "Bengals white · navy suit · 1994 Ace Ventura",
              class: "input-field text-sm w-full", required: true %>
        <div class="flex gap-2 flex-wrap">
          <%= f.text_field :team_slug, placeholder: "team slug (athletes only)", class: "input-field text-sm w-52" %>
          <%= f.text_field :colorway, placeholder: "colorway (optional)", class: "input-field text-sm w-40" %>
        </div>
        <%= f.url_field :reference_url, placeholder: "reference photo URL", class: "input-field text-sm w-full" %>
        <%= f.text_area :generation_notes, rows: 2,
              placeholder: "How to generate this person — required when there is no athlete record",
              class: "input-field text-sm w-full" %>
        <%= f.submit "Save model", class: "btn-primary text-sm" %>
      <% end %>
    </details>
  </div>

  <%# --- every image they appear in, including shared ones --- %>
  <div class="card p-6 space-y-4">
    <div class="flex items-center justify-between">
      <p class="label-upper text-primary">🖼 Images</p>
      <span class="text-xs text-muted">includes images shared with other people</span>
    </div>

    <% if @artifacts.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% @artifacts.each do |artifact| %>
          <div class="rounded-lg border border-border overflow-hidden">
            <div class="h-44 bg-surface-2 flex items-center justify-center overflow-hidden">
              <% if artifact.image_url.present? %>
                <%= image_tag artifact.image_url, class: "object-cover w-full h-full" %>
              <% else %>
                <span class="text-3xl opacity-40">🖼</span>
              <% end %>
            </div>
            <div class="p-3 space-y-1">
              <p class="text-sm font-bold text-heading"><%= artifact.cast_label %></p>
              <p class="text-xs text-muted">
                <%= artifact.kind.humanize %>
                <% artifact.subjects.ordered.each do |s| %>
                  · <%= s.display_name %>: <%= s.effective_appearance&.descriptor || "no look" %>
                <% end %>
              </p>
              <% if artifact.approved? %>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-900/50 text-emerald-300 border border-emerald-700/50">APPROVED</span>
              <% else %>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-900/50 text-amber-300 border border-amber-700/50">NOT REVIEWED</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-muted">No images of <%= @person.full_name %> yet.</p>
    <% end %>
  </div>
</div>
