#!/usr/bin/env ruby
# frozen_string_literal: true

# Groups the extraction wave's output into one bundle per idea, ranked by how
# many DIFFERENT videos say it. Each bundle is what a synthesis agent reads to
# write a single card, so the whole corpus never has to fit in one context.
#
# A run with a selection REBUILDS bundles/ from scratch. A --min-sources that
# selects nothing writes the empty index, keeps the existing bundles, and says so:
# most ideas are said once, so a high value is a question with no answer rather
# than an instruction to delete anything. Read the sources column of index.tsv to
# see where the ceiling is today; it climbs as the extraction wave adds files.
#
#   bin/hormozi-bundle                # default corpus root
#   bin/hormozi-bundle --root DIR
#   bin/hormozi-bundle --min-sources 2   # only ideas said in 2+ videos

require "optparse"
require_relative "../lib/hormozi/bundler"
require_relative "../lib/hormozi/bundle_writer"

DEFAULT_ROOT = File.expand_path("~/projects/.corpus/hormozi")

options = { root: DEFAULT_ROOT, min_sources: 1 }
OptionParser.new do |opts|
  opts.banner = "Usage: bin/hormozi-bundle [options]"
  opts.on("--root DIR", "corpus root (default #{DEFAULT_ROOT})") { |v| options[:root] = File.expand_path(v) }
  opts.on("--min-sources N", Integer, "only bundle ideas said in N+ videos") { |v| options[:min_sources] = v }
  opts.on("-h", "--help") do
    puts opts
    exit 0
  end
end.parse!

# This script deletes and rebuilds the bundles directory. A positional argument it
# ignored would mean rebuilding the DEFAULT root while the operator believed they
# had named another one.
abort "unexpected argument(s): #{ARGV.join(' ')} — did you mean --root?" unless ARGV.empty?

root = options[:root]
extract_dir = File.join(root, "extract")
bundles_dir = File.join(root, "bundles")

paths = Dir.glob(File.join(extract_dir, "*.json")).sort
abort "no extraction files in #{extract_dir}" if paths.empty?

bundles = Hormozi::Bundler.build(paths).select { |bundle| bundle.source_count >= options[:min_sources] }

# The clearing of bundles/ lives inside the writer, BELOW this decision, so a
# filter that selects nothing cannot delete the previous run's output. See
# lib/hormozi/bundle_writer.rb for the failure that bought that ordering.
kept = bundles.empty? ? Hormozi::BundleWriter.bundle_file_count(bundles_dir) : 0
index_path = Hormozi::BundleWriter.write(bundles_dir, bundles)

if bundles.empty?
  warn "no idea reached --min-sources #{options[:min_sources]} — wrote an empty index and left " \
       "bundles/ in place (#{kept} bundle file(s) still there); re-run with a lower --min-sources to rebuild"
end

puts "read #{paths.length} extraction file(s) -> #{bundles.length} bundle(s)"
bundles.group_by(&:kind).sort_by { |_kind, list| -list.length }.each do |kind, list|
  puts format("  %-11s %3d bundles, top: %s (%d sources)", kind, list.length, list.first.name, list.first.source_count)
end
puts "index: #{index_path}"
