<%# Kanban board for /deployments (Deploy lane): submitted → reviewed → assembled →
    shipped, led by the release modules. The /tasks (Build lane) board was rebased
    onto the studio/board engine primitive (tasks/_board); this deploy board still
    hand-rolls its drag/reorder for its heavier chrome (LiveBoardFx, the release
    ticker, per-column kickoffs, the six-lane collapse) and is a candidate to adopt
    the primitive in a later pass. SortableJS is loaded globally (vendored) by
    layouts/studio/_head — no CDN tag.
    Locals:
      stages          — array of stage keys to render as columns
      title           — header heading
      current_release — render the current-release module above the board when present
      last_release    — most-recent shipped release, rendered read-only beneath current %>
<% current_release = local_assigns.fetch(:current_release, nil) %>
<% last_release = local_assigns.fetch(:last_release, nil) %>
<% release_duration_dashboard = local_assigns.fetch(:release_duration_dashboard, nil) %>
<% wip_task_count = local_assigns.fetch(:wip_task_count, nil) %>
<% app_ladder_cards = local_assigns.fetch(:app_ladder_cards, []) %>
<% current_page = local_assigns[:current_page] %>
<% show_release_modules = current_page == "deployments" || current_release || last_release || release_duration_dashboard %>
<%# Blocked tasks are `building` tasks now (a block is a building attribute, not a
    stage), so there is never a standalone Blocked column on either page. Nor is
    there an Archived one: archiving removes the card, which is what the broadcaster
    has always said, and archived work lives at /deployments?stage=archived. %>
<%# An explicit ?stage= is a single-column view of that stage, uncapped — the one
    path that still reaches archived work, and where the capped Shipped column's
    "older" link lands. %>
<% columns = @stage_filter.present? ? [@stage_filter] : stages %>
<%# Columns the loader capped ({ stage => true total }); today only `shipped`. A
    capped column shows the TRUE count and links to the uncapped stage view, so the
    trim never reads as work that vanished. %>
<% capped_stage_totals = @capped_stage_totals || {} %>
<%# Mascot lookup — the 151 are tiny, so one query beats an N+1 across cards. %>
<% pokemon_by_slug = Pokemon.all.index_by(&:slug) %>
<%# Type-colour map built once, so each card's data-glow (mascot type colour, used by
    the live animations) is a hash lookup, not a per-card query. %>
<% type_enumerals = Pokemon.type_enumerals %>
<%# Build board (/tasks) splits the build steps; Deploy board (/deployments) shows the pipeline. %>
<% crew_board = stages.include?("reviewed") ? :deploy : :build %>
<% live_updates = local_assigns.fetch(:live_updates, true) %>

<% if live_updates %>
  <%# Board live updates over TURBO STREAMS: subscribe to the shared "deployments"
      stream — Turbo auto-wires the ActionCable consumer and patches the DOM on every
      broadcast (DeploymentsBroadcaster), so no custom cable client is needed.
      kanbanBoard().observeLive() animates patched cards + refreshes the counts. %>
  <%= turbo_stream_from "deployments" %>
  <% if crew_board == :deploy %>
    <%# Live create / move / delete animations, driven by the broadcasts above. %>
    <%= render "deployments_live_fx" %>
    <%# Ticks the active Next Release in-progress timer down to the second. %>
    <%= render "release_ticker" %>
  <% end %>
  <%# TEST-ONLY: lets the Playwright live-update e2e POST an intent/move to trigger a
      real broadcast. Gated to the test env — never rendered in development or production. %>
  <% if Rails.env.test? %>
    <meta name="e2e-api-token" content="<%= Rails.application.message_verifier("api_auth").generate("test", purpose: :api_auth) %>">
  <% end %>
<% end %>

<%= render "components/elapsed_label_script" %>
<%# kanbanBoard must be defined inline (before Alpine CDN defer evaluates x-data) %>
<script>
function kanbanBoard(live) {
  return {
    live: !!live, // animate Turbo-Streamed card updates (turbo_stream_from "deployments")
    _pendingMoves: {},
    agentFilter: '',
    hiddenApps: [],
    showAllCols: false,
    toasts: [],

    // --- Sticky swim-lane headers ---------------------------------------------
    // WHERE A LANE HEADER PINS — the bottom of whatever is already pinned above it:
    // the site header, plus the app-ladder strip when that is showing. Measured, never
    // hard-coded, for the same reason the strip measures: the site header TRANSITIONS
    // its height as it shrinks on scroll, and the strip comes and goes.
    //
    // The headers themselves are `position: sticky` INSIDE their own column, so each one
    // is aligned with the lane it names by construction. A fixed clone would have to
    // re-derive six column x-positions and keep them in step through the collapse, the
    // app filter and a Turbo patch — three chances to drift that this shape does not have.
    // Whether the lane row NEEDS its horizontal scroller right now — see the wrapper's
    // own comment for why that question decides whether the headers can pin at all.
    laneScroll: false,
    _laneRo: null,
    // WHICH strip node _laneRo watches. The app-ladder broadcast replaces `app-ladder-row`
    // and the strip WITH it, and a detached node never resizes — so a node captured once
    // at init stops waking measureLanes(), and the headers pin behind the strip.

    stageLabels: <%= raw Task::STAGE_LABELS.to_json %>,

    matchesFilter(agent) {
      return !this.agentFilter || agent === this.agentFilter;
    },

    // App filter — a toggled-off app hides all its cards (exclusion). Each card
    // carries its repos as a comma string and hides if ANY of them is toggled off.
    // Mirrors the agentFilter pattern: client-side only, resets on reload.
    toggleApp(app) {
      const i = this.hiddenApps.indexOf(app);
      if (i === -1) { this.hiddenApps.push(app); } else { this.hiddenApps.splice(i, 1); }
    },
    appHidden(app) {
      return this.hiddenApps.includes(app);
    },
    appVisible(csv) {
      if (!csv) return true; // a task with no mapped repo always shows
      return !csv.split(',').some(a => this.hiddenApps.includes(a));
    },

    init() {
      // alpineReady is set in $nextTick, NOT synchronously here: x-init runs while Alpine
      // is still walking the component's subtree, so the chip buttons' @click handlers are
      // not bound yet at this point. A test (or any script) that waited for
      // data-alpine-ready and then clicked a chip could land the click on an unwired button
      // — the toggle would no-op and the card never hide (the board_app_filter_test flake).
      // $nextTick runs after Alpine finishes this tick's directive walk, so the flag now
      // means "the board is fully wired and interactive."
      this.$nextTick(() => {
        // First, and independent of initSortables succeeding: the flag means "directives
        // bound / chips clickable," not "drag-drop wired."
        this.$el.dataset.alpineReady = 'true';
        this.measureLanes();
        this.watchLanes();
        this.initSortables();
        if (this.live) {
          this.observeLive();
          if (!window.LiveBoardFx) this.installExitStreamFallback();
        }
      });
    },

    measureLanes() {
      // DOES THE LANE ROW ACTUALLY OVERFLOW? `scrollWidth` reports the content's true
      // width whether or not the box scrolls, so this reads the same either way and
      // cannot oscillate: turning the scroller on does not make the content narrower.
      const lanes = this.$refs.lanes;
      if (lanes) this.laneScroll = lanes.scrollWidth > lanes.clientWidth + 1;
    },

    // ONLY THE LANE ROW IS WATCHED NOW, and only for whether it overflows.
    // The site header and the app strip used to be observed here so their
    // heights could be summed into laneTop; both publish their own edge through
    // the engine's pinned stack and the CSS above reads it, so observing them
    // was duplicating a measurement the engine already coalesces into one
    // frame. The old note here justified this observer by the header's 300ms
    // shrink transition firing no scroll event of its own — that transition is
    // gone; the collapse is scroll-linked.
    watchLanes() {
      if (!window.ResizeObserver) return;
      this._laneRo = new ResizeObserver(() => this.measureLanes());
      if (this.$refs.lanes) this._laneRo.observe(this.$refs.lanes);
    },


    destroy() {
      if (this._laneRo) { this._laneRo.disconnect(); this._laneRo = null; }
    },

    // --- Board live updates (Turbo Streams) -----------------------------------
    // The board subscribes via `turbo_stream_from "deployments"`; Turbo auto-wires
    // the ActionCable consumer and patches the DOM on every broadcast
    // (DeploymentsBroadcaster replaces / removes / prepends the task card). This
    // observer adds the animation Turbo doesn't: a fade/scale-in + highlight on each
    // patched-in card, and a count-badge refresh after any column change. Alpine
    // auto-initialises an inserted node's x-data/x-show/@click via its own observer.
    observeLive() {
      const onChange = (mutations) => {
        for (const m of mutations) {
          m.addedNodes.forEach((node) => {
            if (node.nodeType === 1 && node.classList && node.classList.contains('kanban-card')) {
              // The rich create/move/replace flourishes live in LiveBoardFx (rendered
              // on the deploy board); fall back to the basic fade if it's absent.
              if (window.LiveBoardFx) { window.LiveBoardFx.onAdd(node); } else { this.animateIn(node); }
            }
          });
        }
        this.updateCounts(); // a Turbo replace/remove/prepend changed a column
      };
      document.querySelectorAll('.kanban-dropzone').forEach((zone) => {
        new MutationObserver(onChange).observe(zone, { childList: true });
      });
    },

    // Fade + scale a freshly patched-in card into view with a brief highlight — the
    // tasteful replacement for the old Alpine cross-column FLIP.
    animateIn(el) {
      el.style.opacity = '0';
      el.style.transform = 'scale(0.96)';
      el.classList.add('ring-2', 'ring-primary');
      requestAnimationFrame(() => {
        el.style.transition = 'opacity 300ms ease, transform 300ms ease';
        el.style.opacity = '';
        el.style.transform = '';
      });
      setTimeout(() => { el.classList.remove('ring-2', 'ring-primary'); el.style.transition = ''; }, 900);
    },

    installExitStreamFallback() {
      if (window.__kanbanExitStreamFallbackInstalled) return;
      window.__kanbanExitStreamFallbackInstalled = true;
      document.addEventListener('turbo:before-stream-render', (event) => {
        const stream = event.target;
        const action = stream.getAttribute('action');
        const target = stream.getAttribute('target') || '';
        const exitAction = stream.dataset.exitAction;
        if (action !== 'remove' || !target.startsWith('card-') || !exitAction) return;

        const renderNow = event.detail.render;
        event.detail.render = async (el) => {
          const card = document.getElementById(target);
          if (!card) { renderNow(el); return; }

          // An `archive` exit animates and then removes, like every other exit —
          // there is no Archived column to re-parent into on either board any more.
          await this.animateCardExit(card, exitAction);
          renderNow(el);
          this.updateCounts();
        };
      });
    },

    initSortables() {
      document.querySelectorAll('.kanban-dropzone').forEach(zone => {
        Sortable.create(zone, {
          group: 'kanban',
          animation: 150,
          ghostClass: 'opacity-30',
          draggable: '.kanban-card',
          filter: '.kanban-empty',
          // Flag local drags so LiveBoardFx doesn't read a dragged card landing in a
          // new column as a "create" burst. Cleared a frame after drop, so the move's
          // own broadcast echo (which arrives after the PATCH) still animates.
          onStart: () => { window.__lbfxDragging = true; },
          onEnd: (evt) => { this.handleSortEnd(evt); requestAnimationFrame(() => { window.__lbfxDragging = false; }); }
        });
      });
    },

    async handleSortEnd(evt) {
      const card = evt.item;
      const slug = card.dataset.slug;
      const fromZone = evt.from;
      const toZone = evt.to;
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

      // A same-zone drop is an in-place reorder — it must NEVER change the task's
      // stage. Source the stage from the DROPZONES, not the card, and only PATCH on
      // a real cross-column move (fromZone !== toZone). A blocked card is just a
      // building card wearing a red glow, so it rides the Building dropzone and this
      // guard keeps an in-place reorder from PATCHing its stage.
      if (fromZone !== toZone) {
        const newStage = toZone.dataset.stage;
        try {
          const resp = await fetch('/tasks/' + slug + '.json', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ task: { stage: newStage } })
          });
          if (!resp.ok) {
            const err = await resp.json().catch(() => ({}));
            throw new Error(err.error || 'Failed (' + resp.status + ')');
          }
          card.dataset.stage = newStage;
          this.showToast('Task moved to ' + this.stageLabels[newStage], 'success');
        } catch (err) {
          // Revert: drop the card back into its SOURCE zone, which always exists
          // (the zone is sourced from evt.from, never a card's stage).
          fromZone.insertBefore(card, fromZone.querySelector('.kanban-empty'));
          card.classList.add('ring-2', 'ring-red-500');
          setTimeout(() => card.classList.remove('ring-2', 'ring-red-500'), 1500);
          this.showToast(err.message || 'Move failed', 'error');
          this.updateCounts();
          return;
        }
      }

      // Save order of destination column
      const slugs = Array.from(toZone.querySelectorAll('.kanban-card')).map(c => c.dataset.slug);
      try {
        await fetch('/tasks/reorder.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ slugs: slugs })
        });
      } catch (err) {
        // Reorder save failed silently — positions will be stale but functional
      }

      this.updateCounts();
    },

    // Resolve a stage to its on-board dropzone. Blocked tasks are `building` tasks
    // now (a block is an attribute), so there is no blocked→building special case.
    zoneForStage(stage) {
      return document.getElementById('dropzone-' + stage);
    },

    updateCounts() {
      document.querySelectorAll('[data-stage-count]').forEach(badge => {
        const stage = badge.dataset.stageCount;
        const zone = document.getElementById('dropzone-' + stage);
        if (zone) {
          const count = zone.querySelectorAll('.kanban-card').length;
          badge.textContent = count;
          const empty = zone.querySelector('.kanban-empty');
          if (empty) empty.style.display = count === 0 ? 'flex' : 'none';
        }
      });
    },

    responseError(resp, fallback) {
      return resp.json().then((err) => new Error(err.error || fallback)).catch(() => new Error(fallback));
    },

    exitKeyframes(kind) {
      if (kind === 'archive') {
        return [
          { opacity: 1, transform: 'translateY(0) scale(1)', filter: 'saturate(1)' },
          { opacity: 0.78, transform: 'translateY(-6px) scale(0.98)', filter: 'saturate(0.9)', offset: 0.35 },
          { opacity: 0, transform: 'translateY(20px) scale(0.86)', filter: 'saturate(0.65)' }
        ];
      }
      if (kind === 'delete') {
        return [
          { opacity: 1, transform: 'translateX(0) rotate(0deg) scale(1)', filter: 'blur(0)' },
          { opacity: 0.55, transform: 'translateX(8px) rotate(1deg) scale(0.96)', filter: 'blur(0)', offset: 0.42 },
          { opacity: 0, transform: 'translateX(28px) rotate(-2deg) scale(0.72)', filter: 'blur(1px)' }
        ];
      }
      return [
        { opacity: 1, transform: 'scale(1)' },
        { opacity: 0, transform: 'scale(0.55)' }
      ];
    },

    async animateCardExit(card, kind) {
      if (!card || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      card.dataset.exitAction = kind;
      card.style.pointerEvents = 'none';
      const animation = card.animate(this.exitKeyframes(kind), {
        duration: kind === 'archive' ? 520 : 430,
        easing: kind === 'archive' ? 'cubic-bezier(.2,.8,.2,1)' : 'cubic-bezier(.35,0,.2,1)',
        fill: 'forwards'
      });
      await animation.finished.catch(() => {});
    },

    resetCardExit(card) {
      if (!card) return;
      card.getAnimations({ subtree: false }).forEach((animation) => animation.cancel());
      delete card.dataset.exitAction;
      card.style.pointerEvents = '';
      card.style.opacity = '';
      card.style.transform = '';
      card.style.filter = '';
    },

    async archiveTask(slug) {
      if (this._pendingMoves[slug]) return;
      this._pendingMoves[slug] = true;

      const card = document.getElementById('card-' + slug);
      const useLiveExit = !!window.LiveBoardFx;

      try {
        if (card && !useLiveExit) await this.animateCardExit(card, 'archive');
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/tasks/' + slug + '.json', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ task: { stage: 'archived' } })
        });
        if (!resp.ok) throw await this.responseError(resp, 'Archive failed');
        const updated = await resp.json().catch(() => null);
        if (!updated || updated.stage !== 'archived') throw new Error('Archive failed');
        if (card && !useLiveExit) {
          card.remove();
          this.updateCounts();
        }
        this.showToast('Task archived', 'success');
      } catch (err) {
        this.resetCardExit(card);
        this.showToast(err.message || 'Archive failed', 'error');
      } finally {
        delete this._pendingMoves[slug];
      }
    },

    async deleteTask(slug) {
      if (!confirm('Delete this task?')) return;
      if (this._pendingMoves[slug]) return;
      this._pendingMoves[slug] = true;

      const card = document.getElementById('card-' + slug);

      try {
        if (card) await this.animateCardExit(card, 'delete');
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/tasks/' + slug + '.json', {
          method: 'DELETE',
          headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrfToken }
        });
        if (resp.status !== 204) throw await this.responseError(resp, 'Delete failed');
        if (card) {
          card.remove();
          this.updateCounts();
        }
        this.showToast('Task deleted', 'success');
      } catch (err) {
        this.resetCardExit(card);
        this.showToast(err.message || 'Delete failed', 'error');
      } finally {
        delete this._pendingMoves[slug];
      }
    },

    showToast(message, type) {
      const id = Date.now();
      const toast = { id, message, type, visible: true };
      this.toasts.push(toast);
      setTimeout(() => {
        const t = this.toasts.find(t => t.id === id);
        if (t) t.visible = false;
        setTimeout(() => { this.toasts = this.toasts.filter(t => t.id !== id); }, 300);
      }, 3000);
    }
  }
}

// Strip the runtime ready flag before Turbo snapshots the page. init's $nextTick
// (above) sets it to mean "directives bound / chips clickable" — true only of the
// LIVE page. Left in place it rides into Turbo's cached snapshot, and a
// restoration visit paints a preview claiming readiness before Alpine
// re-initialises: any selector gating on the flag passes against unwired chrome.
// Same idiom as the modal-host / dropping-text before-cache cleanups; the delete
// is idempotent, so re-registration on each Turbo visit is harmless.
document.addEventListener('turbo:before-cache', function() {
  document.querySelectorAll("[data-test='kanban-board'][data-alpine-ready]").forEach(function(el) {
    delete el.dataset.alpineReady;
  });
});
</script>

<%# data-beat-ms publishes the cadence a batch flip plays (Release::BOARD_FLIP_CADENCE),
    so the live animations, the e2e specs and anyone reading the DOM take the beat from
    ONE place instead of restating it. A spec that restated it went stale the day the
    beat changed, and its failure looked like a broken animation rather than a stale test. %>
<section x-data="kanbanBoard(<%= live_updates.to_json %>)" data-test="kanban-board"
         @scroll.window="measureLanes()"
         @resize.window="measureLanes()"
         data-beat-ms="<%= (Release::BOARD_FLIP_CADENCE * 1000).round %>" class="min-h-screen">
  <!-- Header — Dashboard/Stages as small links above the title; the title says
       where you are, and the Tasks/Deployments toggle (right) switches boards. -->
  <div class="mb-6">
    <%= render "board_top_links", current: current_page %>
    <div class="flex items-center gap-4 flex-wrap">
      <h2 class="text-2xl font-bold text-heading"><%= title %></h2>
      <%# Toggle sits directly right of the title (where you are → switch boards);
          New Task / Archived are pushed to the far right with ml-auto. %>
      <%= render "page_nav", current: current_page %>
      <% if columns.size > 4 %>
        <%# Below 1400px the upstream lanes collapse (Building stays — it carries
            blocked, needs-attention tasks); this reveals all six (x-scroll).
            Hidden at wider widths where all six already fit. %>
        <button type="button" @click="showAllCols = !showAllCols"
                class="hidden max-[1399px]:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition bg-surface text-secondary border border-subtle hover:text-heading"
                :class="showAllCols ? 'bg-primary text-white border-primary' : ''">
          <span>All Stages</span>
        </button>
      <% end %>
      <div class="flex w-full items-center gap-2 flex-wrap sm:ml-auto sm:w-auto sm:justify-end" data-test="board-header-actions">
        <% if logged_in? %>
          <%= link_to "New Task", new_task_path, class: "btn btn-primary" %>
        <% end %>
        <% if current_page == "deployments" %>
          <%= render "deployment_link_menu" %>
        <% end %>
        <% if Rails.env.local? %>
          <%# Local-only progression tester, beside the board's own actions (New
              Task / Links) — the operator drives a demo from one row instead of
              hunting between the header and the filter row. Both groups are
              hidden entirely outside Rails.env.local?. %>
          <%= render "dev_board_tools" %>
          <%= render "dev_deploy_tools" %>
        <% end %>
      </div>
    </div>
  </div>

  <% if show_release_modules %>
    <!-- Deployment dashboard: a 2×2 card grid — Next Release + Last Release on the top
         row, Workflows + DevOps (WIP + release durations) on the bottom row.

         Workflows deliberately does NOT span both columns. It stays one half-width
         cell like every other card (measured: 728px at 2xl, giving its five soul
         columns ~132px each, where the longest act `production-deploy` renders 92px
         into 99px of text area — 7px of slack, nothing clipped). The squeeze is
         absorbed by the CARD's own column ladder rather than by this grid:
         tasks/_heartbeats_card goes 5-up at lg, dips to 3-up at xl where this
         dashboard halves it, and returns to 5-up at 2xl.

         That makes the two files a contract with nothing in the code linking them.
         Give this card a col-span here and you MUST drop `xl:grid-cols-3` there in
         the same pass — application_helper_test.rb's "column ladder" test fails and
         names the other file if they drift apart. -->
    <div class="grid min-w-0 grid-cols-1 gap-4 mb-6 items-stretch xl:grid-cols-2" data-test="release-dashboard-grid">
      <%= render "current_release", release: current_release, card_class: "h-full min-w-0" %>
      <%= render "last_release", release: last_release, card_class: "h-full min-w-0" %>
      <%= render "heartbeats_card", card_class: "h-full min-w-0" %>
      <%= render "release_duration_card", dashboard: release_duration_dashboard, wip_count: wip_task_count, card_class: "h-full min-w-0" %>
    </div>

    <%# App ladder — one card per three-rung repo, directly under the dashboard.
        Shows where each application sits on accepted → release → main, the state
        the Next Release card cannot express because the two are decoupled. %>
    <%= render "app_ladder_row", cards: app_ladder_cards %>
  <% end %>

  <%# App filter — toggle a repo to hide all its cards (client-side, like the agent
      filter). Built from the repos actually present on the board, so an app only
      appears once it has a task; unmapped slugs (e.g. rolio, pre-emoji) still show
      as a text chip. Sits right above the stage-header row. %>
  <%# The `|| Rails.env.local?` clause went with the dev tools when they moved up
      to the header actions — without them a board with no apps would render an
      empty filter row locally. %>
  <% board_apps = (@tasks_by_stage&.values&.flatten || []).flat_map(&:devops_repositories).uniq.sort %>
  <% if board_apps.any? %>
    <div class="flex flex-wrap items-center gap-2 mb-4" data-test="board-filter-row">
      <span class="text-xs font-semibold uppercase tracking-wider text-muted mr-1">Apps</span>
      <% board_apps.each do |app| %>
        <button type="button"
                @click="toggleApp('<%= app %>')"
                <%# Pressed state in the accessibility tree, and the only handle a test
                    has on whether the click landed. Same rationale as the /tasks board
                    chip in tasks/_board.html.erb — kept identical on purpose: these two
                    chips are the same control on two boards, and the filter specs for
                    both assert against this attribute. %>
                :aria-pressed="appHidden('<%= app %>') ? 'true' : 'false'"
                :class="appHidden('<%= app %>') ? 'opacity-40 line-through' : 'hover:border-primary/40 hover:text-heading'"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-surface text-secondary border border-subtle transition">
          <% if (emoji = app_emoji(app)) %><span class="leading-none"><%= emoji %></span><% end %>
          <span><%= app %></span>
        </button>
      <% end %>
    </div>
  <% end %>

  <!-- Kanban Board -->
  <%# THE SCROLLER IS MEASURED ON, AND THAT IS WHAT LETS THE LANE HEADERS PIN.

      A `position: sticky` child sticks to its nearest SCROLL CONTAINER, and an
      `overflow-x: auto` wrapper is one — on both axes, because a box with one axis
      scrollable computes the other from `visible` to `auto`. Inside such a wrapper a
      sticky header sticks to a scrollport with no vertical scroll of its own and simply
      rides the page up out of view. It does nothing, and nothing anywhere says why.

      So the scroller is applied only while the lanes ACTUALLY overflow (measureLanes
      reads scrollWidth vs clientWidth, which reports the same either way). On the wide
      board that is never — six lanes at their 13.5rem floor plus gaps measure 1376px,
      and below 1400px the board collapses to three — so the headers pin. It switches
      itself on for the one case that needs it, All Stages forcing six lanes into a
      viewport that cannot hold them, and there the headers stop pinning. That is the
      honest trade, and it is measured rather than guessed at a breakpoint: a fixed
      `min-[1440px]` override was tried first and LOST to `sm:overflow-x-auto`, because
      Tailwind v4 emits arbitrary `min-[…]` media queries BEFORE its named ones, so the
      later `sm` rule won at every width and the headers silently never pinned. %>
  <div class="flex flex-col gap-4 overflow-x-visible pb-4 sm:flex-row"
       data-test="kanban-lanes"
       x-ref="lanes"
       :class="laneScroll ? 'sm:overflow-x-auto' : ''"
       :data-lane-scroll="laneScroll">
    <% columns.each_with_index do |stage, idx| %>
      <%# Blocked tasks ride Building, but active building work stays first so a
          re-claimed blocked task becomes topical again. %>
      <% column_tasks = Task.board_column_tasks(@tasks_by_stage, stage) %>
      <%# On a six-lane board (Deployments) the upstream lanes collapse below 1400px
          unless "All Stages" is on, leaving just the last three (reviewed · assembled
          · shipped). Building collapses with them; blocked/needs-attention tasks ride
          the Building lane, so a stalled task stays reachable via "All Stages" at narrow. %>
      <% collapsible = columns.size > 4 && idx < columns.size - 3 %>
      <div class="w-full flex-none sm:flex-1 <%= columns.size > 4 ? "sm:min-w-[13.5rem]" : "sm:min-w-[190px]" %>"
           <% if collapsible %>:class="showAllCols ? '' : 'max-[1399px]:hidden'"<% end %>>
        <!-- Column Header -->
        <%# PINNED, so the lane you are reading keeps its name while you scroll its cards.
            It sticks to the bottom of the pinned stack — max() over the site
            header's and the app strip's own published edges — so the three
            pinned things stack rather than overlap, and a hidden strip measures
            0 and drops out of the max on its own. z-30 keeps it under the strip (z-40) and the nav (z-50) and over the
            cards, which slide beneath it.

            IT NEEDS ITS OWN BACKGROUND. A sticky header with a transparent one shows the
            cards passing underneath through the text, which is worse than not pinning at
            all — and OPAQUE, not the strip's 95%: a card sliding under a translucent
            header reads as a smear behind the lane name. The div already spans the lane,
            so `px-1` (unchanged) insets the label while the background covers the full
            width — a negative margin to "reach the
            edges" was tried and is exactly wrong: it made every header 8px wider than its
            lane, which overflowed the row by 4px, which turned the measured scroller back
            on, which un-stuck all six headers. %>
        <div class="sticky z-30 mb-3 rounded-t-lg bg-page px-1 py-2"
             data-test="stage-header"
             data-stage="<%= stage %>"
             <%# THE PINNED STACK, COMPOSED IN CSS. This was laneTop — "site
                 header bottom + strip height" measured in Alpine behind its own
                 ResizeObserver and recomputed while the header was still easing,
                 so these headers chased it a frame behind through every
                 intermediate value. max() takes whichever layer is lower, and a
                 hidden strip measures 0 and drops out, so nothing here has to
                 know which layer sits above which. %>
             style="top: max(var(--pin-nav-bottom, 0px), var(--pin-apps-bottom, 0px))">
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-heading uppercase tracking-wider">
              <%= Task::STAGE_LABELS.fetch(stage) %>
            </h3>
            <% if stage == "submitted" && current_page != "deployments" %>
              <%= link_to "docs",
                    review_events_hub_path,
                    class: "rounded border border-primary/30 bg-primary/10 px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-primary hover:bg-primary/15 transition",
                    "data-test": "submitted-review-docs-link" %>
            <% end %>
            <%# A capped column counts what EXISTS, not what it drew — a badge reading
                12 over a stage holding 31 would be a quieter lie than the slow page
                this cap replaced. %>
            <% stage_total = capped_stage_totals[stage] %>
            <span class="stage-count inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full text-xs font-bold
              <%= task_stage_count_classes(stage) %>"
              data-stage-count="<%= stage %>"
              <% if stage_total %>title="showing the newest <%= column_tasks.size %> of <%= stage_total %>"<% end %>>
              <%= stage_total || column_tasks.size %>
            </span>
          </div>
          <%# Kickoff-chip row, reserved at a fixed height on EVERY column (empty for
              designed/building) so all dropzones start at the same y — no height jog. %>
          <% if local_assigns[:show_kickoffs] %>
            <div class="mt-2 min-h-[26px]">
              <% if (kick = devops_kickoffs[stage]) %>
                <%= render "kickoff_chip", command: kick %>
              <% end %>
            </div>
          <% end %>
        </div>

        <!-- Drop Zone -->
        <div id="dropzone-<%= stage %>"
             data-stage="<%= stage %>"
             <%# `isolate` (isolation: isolate) CONTAINS the cards' own z-indexes, and it is
                 what stops a crew avatar painting over the pinned lane header above it.

                 The crew stack in components/_stage_agent_avatars is layered z-10/20/30/40
                 — deliberately, and correctly: those numbers order the faces WITHIN a card
                 (lead face on top, its badge above that). But nothing between them and the
                 root created a stacking context, so they were competing with the PAGE, and
                 a z-40 badge beat the z-30 header it should slide under.
                 Raising the header instead would only move the collision: the ladder strip
                 is z-40 and the site nav z-50, so the board would be bidding against its own
                 chrome for numbers. One stacking context per lane ends the auction — the
                 crew keeps its internal order and the whole zone paints below the header,
                 which is positioned and therefore above it. %>
             class="kanban-dropzone isolate rounded-xl border-2 border-dashed min-h-40 p-2 space-y-2 transition-colors duration-150 border-subtle sm:min-h-[calc(100vh-220px)]">

          <%# Every per-card local here is a BATCH load_board already computed, handed
              in explicitly so a column of cards costs one query instead of one each.
              `local_check` was the one this board was missing: /deployments calls
              load_board (so @local_check_by_slug is populated) but did not pass it,
              and tasks/_task_card falls back to Cert::LocalCheckReader#for_task per
              card — a GateRun query per building card with no PR yet. tasks/_board
              has always passed it; this row now matches.

              review_in_progress? gets the same treatment: it runs per card, and
              without the preload that call costs two task_events queries each.
              Explicit because the model defaults to SQL on purpose — see
              Task#open_intents_for. %>
          <% column_tasks.each do |task| %>
            <%= render "tasks/task_card", task: task, agents: @agents, crew_board: crew_board,
                  mascot: pokemon_by_slug[task.devops_field("mascot")], type_enumerals: type_enumerals,
                  latest_activity: @latest_task_activities[task.slug],
                  activity_count: @task_activity_counts[task.slug].to_i,
                  unresolved_feedback: @unresolved_feedback_activities[task.slug],
                  ever_blocked: @ever_blocked_slugs&.include?(task.slug),
                  ci_progress: @ci_progress_by_slug&.fetch(task.slug, nil),
                  local_check: @local_check_by_slug&.fetch(task.slug, nil),
                  review_in_progress: task.review_in_progress?(events: task.task_events.to_a) %>
          <% end %>

          <%# The rest of a capped column, one click away — the same ?stage= opt-in
              that keeps the archive reachable. %>
          <% if stage_total %>
            <%= link_to "#{stage_total - column_tasks.size} older →",
                  url_for(stage: stage),
                  class: "block rounded-lg border border-subtle px-2 py-1.5 text-center text-xs font-medium text-muted hover:text-heading hover:bg-surface-alt transition",
                  "data-test": "stage-older-link" %>
          <% end %>

          <!-- Empty State -->
          <div class="kanban-empty flex items-center justify-center h-24 text-muted text-sm"
               <% if column_tasks.any? %>style="display: none"<% end %>>
            Drop tasks here
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Toasts -->
  <div class="fixed top-4 right-4 z-50 space-y-2">
    <template x-for="toast in toasts" :key="toast.id">
      <div x-show="toast.visible"
           x-transition:enter="transition ease-out duration-300"
           x-transition:enter-start="opacity-0 translate-x-8"
           x-transition:enter-end="opacity-100 translate-x-0"
           x-transition:leave="transition ease-in duration-200"
           x-transition:leave-start="opacity-100 translate-x-0"
           x-transition:leave-end="opacity-0 translate-x-8"
           :class="toast.type === 'success' ? 'bg-mint-900/90 border-mint-700 text-mint-300' : 'bg-red-900/90 border-red-700 text-red-300'"
           class="px-4 py-2.5 rounded-lg border text-sm font-medium shadow-lg backdrop-blur-sm">
        <span x-text="toast.message"></span>
      </div>
    </template>
  </div>
</section>
