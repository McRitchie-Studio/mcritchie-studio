<%# Google's inline booking page for the studio's appointment schedule. It
    fills its container, so it lines up with the cards around it. Google lays it
    out by width: month beside the slots from about 600px, stacked below that.
    It cannot be themed, so it sits on a white panel in both themes.

    CROPPED AT REST, WHOLE IN USE. From 640px up the wrapper shows only the
    "Select an appointment time" box: Google's header above it and its credit
    lines below are clipped (measured in the frame at 640-862px wide: the box
    spans 211-613px of a 732px page). The crop cannot stay on, because the form
    that opens when a slot is picked is a dialog centred in the frame's FULL
    height (93-640px), so a cropped frame cuts off its title and its Book
    button. A cross-origin frame reports no clicks, but the parent window does
    lose focus to it; on that signal the wrapper opens to the full frame.
    Below 640px Google stacks the month above the slots and nothing is cropped.

    THE SRC IS DEFERRED, and not with loading="lazy". The frame is a third
    party, and a frame that starts loading before the window's `load` event
    holds that event open for as long as Google takes to answer. So the URL
    waits in data-src and the script below assigns it only AFTER `load`, once
    the frame is near the viewport. %>
<div class="booking-frame mx-auto rounded-xl overflow-hidden border border-subtle" data-booking-wrap>
  <iframe data-booking-frame
          data-src="<%= ScheduleController::BOOKING_URL %>?gv=true"
          title="Book a call with Alex McRitchie"
          width="100%" frameborder="0"></iframe>
</div>
<p class="text-muted text-sm text-center mt-4">
  Scheduling by Google Calendar. Trouble seeing it?
  <a href="<%= ScheduleController::BOOKING_URL %>" target="_blank" rel="noopener" class="text-primary hover:underline">Open the booking page</a>.
</p>

<style>
  .booking-frame { background: #fff; }
  .booking-frame iframe { display: block; border: 0; height: 1200px; }
  @media (min-width: 640px) {
    .booking-frame { height: 414px; transition: height .25s ease; }
    .booking-frame iframe { height: 732px; margin-top: -205px; transition: margin-top .25s ease; }
    .booking-frame.is-open { height: 732px; }
    .booking-frame.is-open iframe { margin-top: 0; }
  }
  @media (prefers-reduced-motion: reduce) { .booking-frame, .booking-frame iframe { transition: none; } }
</style>

<script>
  (function () {
    if (window.__bookingFramesArmed) return;
    window.__bookingFramesArmed = true;

    function arm() {
      document.querySelectorAll('iframe[data-booking-frame][data-src]').forEach(function (frame) {
        if (frame.__bookingArmed) return;
        frame.__bookingArmed = true;
        var watcher = new IntersectionObserver(function (entries) {
          if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
          watcher.disconnect();
          frame.src = frame.dataset.src;
        }, { rootMargin: '200px' });
        watcher.observe(frame);
      });
    }

    function armAfterLoad() {
      if (document.readyState === 'complete') arm();
      else window.addEventListener('load', arm, { once: true });
    }

    // Focus moving into the frame is the one signal a cross-origin frame gives
    // its parent. It means the visitor has started using the calendar.
    window.addEventListener('blur', function () {
      var active = document.activeElement;
      if (!active || !active.matches || !active.matches('iframe[data-booking-frame]')) return;
      var wrap = active.closest('[data-booking-wrap]');
      if (wrap) wrap.classList.add('is-open');
    });

    document.addEventListener('turbo:load', armAfterLoad);
    armAfterLoad();
  })();
</script>
