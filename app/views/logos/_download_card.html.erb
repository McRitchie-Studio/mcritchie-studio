<%# THE DOWNLOAD CARD (task logo-download-card), the same on all three tabs: the tab's one logo as a PNG (the
    default) or an SVG, in any tone, from one Download button (task brand-page-split-layout). Some integrations take no
    SVG and want an exact pixel size, so PNG offers the type's six standard sizes (Logos::PngSizes::STANDARD, each
    named by its long side, its use in the title) and Custom, with the size always in Width × Height. Keep aspect
    ratio, enabled only for Custom: on, the side last typed sets the other; off, both are free and the logo is fitted,
    centred, inside that canvas, which a dotted outline on the page's logo shows. The PNG is drawn in the browser
    (app/javascript/logo_download.js): the logo's own SVG, from its own URL, onto a canvas at the chosen size, then
    saved as <the SVG's name>-<w>x<h>.png. The logo's words are outlined paths, so no font is needed.

    Without JavaScript the card is the Tone row and one Download link, for the SVG: the Format and Size rows are served
    hidden, and logo_download.js shows them. A PNG is transparent; a JPEG with a background is the /logos table's.

    Every tone's choice is on its radio: its SVG URL, its download URL and filename, its drawing's own width and
    height and its presets. The tones are listed Dark first. Locals: downloads ({ light:, dark:,
    watermark: } Logos::Variants of the tab's logo, as shown). %>
<% ring = "focus-visible:outline-[#4338CA]! dark:focus-visible:outline-white!" %>
<% field = "rounded-lg border border-subtle bg-surface-alt px-2 py-1.5 text-xs text-heading" %>
<%# A chosen option is outlined, as the edit panel's swatches are (logos/_edit_panel): indigo on light, white on dark,
    solid when chosen and dashed on keyboard focus. %>
<% pill = "inline-flex h-8 items-center rounded-md border border-subtle px-2.5 text-2xs font-semibold text-heading cursor-pointer has-checked:outline-2 has-checked:outline-offset-2 has-checked:outline-solid has-checked:outline-[#4338CA] dark:has-checked:outline-white has-focus-visible:outline-2 has-focus-visible:outline-offset-2 has-focus-visible:outline-dashed has-focus-visible:outline-[#4338CA] dark:has-focus-visible:outline-white" %>
<% legend = "text-3xs font-semibold uppercase tracking-wide text-muted mb-1.5" %>
<% first_tone = @tones.first %>
<% sizes = downloads.transform_values { |variant| Logos::PngSizes.natural(variant.svg) } %>
<% presets = downloads.to_h { |tone, _| [tone, Logos::PngSizes.standard(@type, *sizes.fetch(tone))] } %>
<%# No 1:1 square toggle (Alex McRitchie 2026-10-27): Custom without Keep aspect ratio, N × N, pads the icon to a square. %>
<% default_key = Logos::PngSizes::DEFAULTS.fetch(@type) %>
<% shown = downloads.fetch(first_tone) %>
<% ordered = downloads.sort_by { |tone, _| %i[dark light watermark].index(tone) || 3 } %>
<% default_preset = presets.fetch(first_tone).find { |preset| preset[:key] == default_key } || presets.fetch(first_tone).first %>
<section class="card p-4 sm:p-5 space-y-4 min-w-0 scroll-mt-28" id="download" data-test="download-card" data-type="<%= @type %>"
         data-logo-download data-watermark-page="<%= @context == :watermark %>" aria-labelledby="download-title">
  <h2 id="download-title" class="text-sm font-bold text-heading">Download</h2>
  <form class="space-y-4" data-download-form autocomplete="off">
    <%# Format and Tone side by side, a half each, each centred in its half. %>
    <div class="grid gap-4 sm:grid-cols-2" data-test="download-format-tone">
      <fieldset class="min-w-0 text-center" data-test="download-format" data-download-js hidden>
        <legend class="<%= legend %> mx-auto">Format</legend>
        <div class="flex flex-wrap justify-center gap-2">
          <% { png: "PNG", svg: "SVG" }.each do |format, label| %>
            <label class="<%= pill %>"><%= radio_button_tag :format, format, format == :png, id: nil, class: "sr-only", data: { test: "download-format-option" } %><%= label %></label>
          <% end %>
        </div>
      </fieldset>
      <fieldset class="min-w-0 text-center" data-test="download-tone">
        <legend class="<%= legend %> mx-auto">Tone</legend>
        <div class="flex flex-wrap justify-center gap-2">
          <% ordered.each do |tone, variant| %>
            <% width, height = sizes.fetch(tone) %>
            <label class="<%= pill %>">
              <%= radio_button_tag :tone, tone, tone == first_tone, id: nil, class: "sr-only",
                                   data: { test: "download-tone-option", svg: logo_asset_path(variant), download_url: logo_asset_path(variant, download: 1),
                                           filename: variant.filename, natural_width: width, natural_height: height,
                                           presets: presets.fetch(tone).to_json,
                                           label: variant.label } %><%= Logos::Variant::CONTEXTS.fetch(tone) %>
            </label>
          <% end %>
        </div>
      </fieldset>
    </div>
    <div class="space-y-4" data-png-only hidden>
      <%# Size: the type's six standard sizes (Logos::PngSizes::STANDARD), each named by its long side (most are about
          1:1; Width × Height below gives both), and Custom. A standard size fills Width and Height, and typing in them
          picks Custom. %>
      <fieldset class="min-w-0 text-center" data-test="download-size">
        <legend class="<%= legend %> mx-auto">Size</legend>
        <div class="flex flex-wrap justify-center gap-2" data-download-sizes>
          <% presets.fetch(first_tone).each do |preset| %>
            <label class="<%= pill %>" title="<%= preset[:use] %>" data-download-size-label="<%= preset[:key] %>">
              <%= radio_button_tag :size, preset[:key], preset == default_preset, id: nil, class: "sr-only", data: { test: "download-size-option" } %><span data-size-text><%= [preset[:width], preset[:height]].max %></span><span class="sr-only">, <%= preset[:use] %></span>
            </label>
          <% end %>
          <label class="<%= pill %>"><%= radio_button_tag :size, "custom", false, id: nil, class: "sr-only", data: { test: "download-size-option" } %>Custom</label>
        </div>
      </fieldset>
      <%# The PNG's Width × Height, with Keep aspect ratio on (either side sets the other, from the drawing's own shape) or
          off (both free; the logo fits inside, centred, and the page's logo shows the canvas dotted). %>
      <div data-test="download-custom">
        <div class="flex flex-wrap items-end justify-center gap-x-2 gap-y-3">
          <label class="inline-flex flex-col gap-1 <%= legend %> mb-0">
            Width
            <input type="number" name="custom_width" min="1" max="<%= Logos::PngSizes::MAX_SIDE %>" step="1" inputmode="numeric" value="<%= default_preset[:width] %>"
                   class="<%= field %> w-28 normal-case tracking-normal font-normal" data-test="download-custom-width">
          </label>
          <span class="pb-1.5 text-xs text-muted" aria-hidden="true">×</span>
          <label class="inline-flex flex-col gap-1 <%= legend %> mb-0">
            Height
            <input type="number" name="custom_height" min="1" max="<%= Logos::PngSizes::MAX_SIDE %>" step="1" inputmode="numeric"
                   value="<%= default_preset[:height] %>"
                   class="<%= field %> w-28 normal-case tracking-normal font-normal" data-test="download-custom-height">
          </label>
          <span class="pb-1.5 text-xs text-muted">px</span>
          <%# Live only on Custom: a standard size is always the logo's own shape. %>
          <label class="ml-2 inline-flex items-center gap-2 pb-1.5 text-xs text-heading cursor-pointer has-disabled:cursor-not-allowed has-disabled:opacity-50"
                 data-test="download-keep-aspect-toggle">
            <input type="checkbox" name="keep_aspect" value="1" checked disabled data-test="download-keep-aspect">
            <span class="font-semibold">Keep aspect ratio</span>
          </label>
        </div>
      </div>
    </div>
  </form>
  <%# The size in words, for a screen reader and the tests; the controls above already show it. %>
  <p class="sr-only" role="status" data-test="download-summary" data-download-summary><%= shown.filename %></p>
  <%= link_to "Download", logo_asset_path(shown, download: 1), class: "btn btn-sm btn-primary border border-transparent w-full justify-center #{ring}",
              data: { test: "logo-download", turbo: false, download_link: true }, aria: { label: "Download: #{shown.label}" } %>
  <p class="text-2xs font-semibold text-warning-ink" data-test="download-error" data-download-error hidden></p>
</section>
