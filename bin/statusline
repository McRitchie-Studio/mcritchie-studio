#!/usr/bin/env bash
# bin/statusline — feature/task status line for agent sessions (Claude Code, etc.)
#
# Versioned in the repo (not ~/.claude) so it's shared + recoverable on rebuild.
# Wire it into ~/.claude/settings.json (installed by bin/install-agent-docs):
#   "statusLine": { "type": "command",
#     "command": "/Users/alex/projects/mcritchie-studio/bin/statusline",
#     "padding": 1, "refreshInterval": 5 }
#
# Renders:  🛠  ⊙<mascot> · <app-slug> · <feature-slug> · ↗<task>   (+ [stage] when known)
#           (the ⊙<mascot> segment shows only when the context carries one)
#
# Sources, in priority:
#   1. <cwd>/.agent-context.json              — the active worktree (bin/agent-worktree)
#   2. $PROJECTS/.agents/current-feature.json — manual "current focus" marker
#   3. git branch + model                     — primary checkout fallback
#
# Input: agent session JSON on stdin (Claude Code shape). The task link uses OSC 8
# (clickable in iTerm2/Kitty/WezTerm; degrades to plain text elsewhere).
#
# NOTE: cross-tool indicator (incl. Codex) is the terminal TAB TITLE, set by the
# shell hook (`bin/agent-worktree shell-hook zsh`) from the same context — this
# status line is the Claude-specific in-pane view.

input=$(cat)
JQ=/usr/bin/jq
PROJECTS="${CLAUDE_PROJECTS_DIR:-$HOME/projects}"

s_in() { printf '%s' "$input" | "$JQ" -r "$1 // empty" 2>/dev/null; }

cwd=$(s_in '.workspace.current_dir'); [ -z "$cwd" ] && cwd=$(s_in '.cwd'); [ -z "$cwd" ] && cwd="$PWD"
model=$(s_in '.model.display_name')

# ANSI
A=$'\033[38;5;75m'    # app slug
F=$'\033[38;5;179m'   # feature slug
G=$'\033[38;5;108m'   # git branch
D=$'\033[2m'; X=$'\033[0m'
M=$'\033[38;5;213m'   # mascot (Pokémon)
DOT="${D} · ${X}"

link() { printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$1" "$2"; }   # OSC 8 hyperlink

# --- Build-claim heartbeat (best-effort lease renewal) ---------------------
# A live terminal renews its build claim each render, so a crashed/closed session
# stops renewing and its lease lapses (TTL) — making the task reclaimable by the
# next claimant. Throttled to ~once/HEARTBEAT_THROTTLE seconds and run detached so
# it never delays the status line. STATUSLINE_HEARTBEAT_FG=1 runs it inline (tests).
TASK_BIN="${TASK_BIN:-$(dirname "$0")/task}"
heartbeat_claim() {  # slug stage
  local slug="$1" stage="$2"
  [ -z "$slug" ] && return 0
  [ -z "$CLAUDE_CODE_SESSION_ID" ] && return 0
  [ -x "$TASK_BIN" ] || return 0
  # Only the live BUILD claim matters (stage empty ⇒ unknown context, still renew).
  case "$stage" in ""|building) ;; *) return 0 ;; esac
  local mdir="$PROJECTS/.agents/sessions"
  local marker="$mdir/${CLAUDE_CODE_SESSION_ID}.heartbeat"
  local throttle="${STATUSLINE_HEARTBEAT_THROTTLE:-45}"
  if [ -f "$marker" ]; then
    local mtime age
    mtime=$(stat -f %m "$marker" 2>/dev/null || echo 0)
    age=$(( $(date +%s) - mtime ))
    [ "$age" -lt "$throttle" ] && return 0
  fi
  mkdir -p "$mdir" 2>/dev/null
  : > "$marker"
  if [ "$STATUSLINE_HEARTBEAT_FG" = "1" ]; then
    "$TASK_BIN" heartbeat "$slug" >/dev/null 2>&1
  else
    ( "$TASK_BIN" heartbeat "$slug" >/dev/null 2>&1 & ) >/dev/null 2>&1
  fi
}

# OSC 8 clickable-text support. Terminal.app does NOT support it (it only
# auto-links plain https URLs); iTerm2/WezTerm/Kitty/Ghostty do.
osc8_supported() {
  [ -n "$KITTY_WINDOW_ID" ] && return 0
  [ -n "$WEZTERM_PANE" ] && return 0
  [ "$LC_TERMINAL" = "iTerm2" ] && return 0
  [ "$FORCE_HYPERLINK" = "1" ] && return 0
  case "$TERM_PROGRAM" in iTerm.app|WezTerm|ghostty|rio|Tabby) return 0 ;; esac
  return 1
}

read_ctx() {  # path -> tab-separated: app feature task url stage mascot
  "$JQ" -r '[(.app // ""), (.worktree_slug // .feature // ""), (.task_record_slug // .task_slug // ""), (.task_url // ""), (.stage // ""), (.mascot // "")] | @tsv' "$1" 2>/dev/null
}

render() {  # app feature task url stage mascot
  local app="$1" feat="$2" task="$3" url="$4" stage="$5" mascot="$6" out="🛠 "
  if [ -n "$mascot" ]; then
    # title-case the slug, BSD-sed / bash-3.2 safe: cap first char, hyphens->spaces
    # (snorlax -> "Snorlax"; nidoran-f -> "Nidoran f").
    local first rest
    first=$(printf '%s' "$mascot" | cut -c1 | tr '[:lower:]' '[:upper:]')
    rest=$(printf '%s' "${mascot:1}" | tr '-' ' ')
    out="${out} ${M}⊙ ${first}${rest}${X}"
    [ -n "$app" ] && out="${out}${DOT}${A}${app}${X}"
  elif [ -n "$app" ]; then
    out="${out} ${A}${app}${X}"
  fi
  [ -n "$feat" ] && out="${out}${DOT}${F}${feat}${X}"
  # With a mascot present, the Pokémon name IS the session handle — drop the task link
  # so the line stays "⊙ Snorlax · app · feature". Fall back to the link with no mascot.
  if [ -z "$mascot" ]; then
    if [ -n "$url" ]; then
      if osc8_supported; then
        out="${out}${DOT}↗ $(link "$url" "${task:-task}")"        # clean clickable slug
      else
        out="${out}${DOT}${D}${url}${X}"                          # Terminal.app: plain URL is Cmd-clickable
      fi
    elif [ -n "$task" ]; then
      out="${out}${DOT}${task}"
    fi
  fi
  [ -n "$stage" ] && out="${out}  ${D}[${stage}]${X}"
  # Session last-4 (e.g. …12ab) — which terminal/session this is, for resume.
  # Portable last-4 (bash 3.2-safe): strip everything but the trailing 4 chars.
  if [ -n "$CLAUDE_CODE_SESSION_ID" ]; then
    out="${out} ${D}…${CLAUDE_CODE_SESSION_ID#${CLAUDE_CODE_SESSION_ID%????}}${X}"
  fi
  printf '%s' "$out"
}

ctx="$cwd/.agent-context.json"
src=""
[ -f "$ctx" ] && src="$ctx"                                       # worktree session: per-worktree context
if [ -z "$src" ] && [ -n "$CLAUDE_CODE_SESSION_ID" ]; then
  sm="$PROJECTS/.agents/sessions/$CLAUDE_CODE_SESSION_ID.json"    # per-session marker (no cross-session leak)
  [ -f "$sm" ] && src="$sm"
fi

if [ -n "$src" ]; then
  IFS=$'\t' read -r app feat task url stage mascot < <(read_ctx "$src")
  render "$app" "$feat" "$task" "$url" "$stage" "$mascot"
  heartbeat_claim "$task" "$stage"   # keep this terminal's build-claim lease fresh
else
  branch=$(git -C "$cwd" branch --show-current 2>/dev/null)
  top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)
  repo=$(basename "${top:-$cwd}")
  if [ -n "$branch" ]; then
    printf '%s' "${D}${repo}${X} ${G}${branch}${X}${DOT}${D}${model}${X}"
  else
    printf '%s' "${D}${repo} · ${model}${X}"
  fi
fi
