<% content_for(:title, "Pokédex") %>

<section class="space-y-6" data-test="pokedex">
  <%# The total is a count, not a control: the header's meta, beside the title. %>
  <% total = tag.span(number_with_delimiter(@pokedex.total_pokemon), class: "tabular-nums",
                      aria: { label: "#{number_with_delimiter(@pokedex.total_pokemon)} Pokémon in the Pokédex" },
                      data: { test: "pokedex-total" }) %>
  <%= render "studio/page_header", title: "Pokémon", crumbs: studio_crumbs(:pokedex), crumb_label: "Pokédex",
        meta: total, links: [{ label: "Studio dashboard", href: dashboard_path }], links_label: "Sections" %>

  <div class="grid gap-4 xl:grid-cols-2">
    <%= render "pokemon_card",
          key: "pokemon",
          title: "Pokémon",
          seen: @pokedex.seen_pokemon,
          caught: @pokedex.caught_pokemon,
          newest_seen: @newest_unique,
          newest_caught: @newest_caught %>

    <%= render "pokemon_card",
          key: "shiny",
          title: "Shiny Pokémon",
          seen: @pokedex.seen_pokemon(shiny: true),
          caught: @pokedex.caught_pokemon(shiny: true),
          newest_seen: @newest_unique_shiny,
          newest_caught: @newest_caught_shiny %>
  </div>

  <%= render "dex_grid",
        entries: @dex_entries,
        seen_count: @pokedex.seen_pokemon,
        caught_count: @pokedex.caught_pokemon %>

  <div class="card overflow-x-auto" data-test="recent-pokemon-actions">
    <table class="w-full text-sm">
      <thead class="text-secondary border-b border-subtle">
        <tr>
          <th class="text-left p-3">Pokémon</th>
          <th class="text-left p-3">Action</th>
          <th class="text-left p-3">Task</th>
          <th class="text-left p-3">Outcome</th>
          <th class="text-right p-3">When</th>
        </tr>
      </thead>
      <tbody>
        <% if @recent_actions.any? %>
          <% @recent_actions.each do |row| %>
            <% action = row.action %>
            <% pokemon = row.pokemon %>
            <tr class="border-b border-subtle/50 hover:bg-surface" data-test="recent-pokemon-action">
              <td class="p-3">
                <div class="flex items-center gap-3">
                  <img src="<%= safe_image_src(pokemon.display_sprite) %>" alt="<%= row.name %>"
                       class="w-10 h-10 object-contain shrink-0"
                       loading="lazy"
                       onerror="this.style.visibility='hidden'">
                  <div>
                    <div class="font-medium text-heading"><%= row.name %></div>
                    <div class="text-xs text-muted font-mono"><%= pokemon.slug %></div>
                  </div>
                </div>
              </td>
              <td class="p-3 min-w-56">
                <div class="text-heading font-medium"><%= action.kind.to_s.humanize %></div>
                <div class="text-secondary text-xs truncate max-w-md">
                  <%= action.summary.presence || action.result_slug.presence || action.event_slug.presence || "Action #{action.seq}" %>
                </div>
              </td>
              <td class="p-3">
                <% if action.task %>
                  <%= link_to action.task.title, task_path(action.task.slug),
                        class: "text-primary hover:underline whitespace-nowrap" %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
              <td class="p-3 text-secondary"><%= action.outcome.to_s.humanize %></td>
              <td class="p-3 text-right text-muted whitespace-nowrap">
                <time datetime="<%= action.occurred_at.iso8601 %>">
                  <%= l(action.occurred_at, format: :short) %>
                </time>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr>
            <td colspan="5" class="p-8 text-center text-secondary" data-test="recent-pokemon-empty">
              No Pokémon actions yet.
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
