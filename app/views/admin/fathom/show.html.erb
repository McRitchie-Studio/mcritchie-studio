<%# The standing Fathom connection page (/admin/fathom): its status, the account that granted it, and a live read proving it: the first page of meetings and whether there are more, the newest meeting's title and date, its transcript's lines and speakers, and its summary's length; or Fathom's error said plainly. One button: Connect, or Disconnect once connected. The OAuth app and encryption setup shows only while one of them is missing, by NAME only. It renders no token and no part of one, and no value of any env var. %>
<% can_connect = @configured && @encryption_ready %>
<% stamp = ->(time) { time.in_time_zone("America/Denver").strftime("%a %b %-d, %-l:%M %p %Z") } %>
<% state = if @connection.nil? then "none" elsif @error then "read_failed" else "connected" end %>
<section class="max-w-3xl mx-auto px-4 py-10 space-y-6" data-test="fathom-connection-page">
  <div>
    <h1 class="text-3xl font-bold text-heading">Fathom connection</h1>
    <p class="text-secondary mt-2">
      The Fathom account this server reads, connected by signing in. It can read meeting notes and transcripts and nothing else. No token is shown here.
    </p>
  </div>

  <% if @unreadable.any? %>
    <p class="card p-4 text-sm text-body" data-test="fathom-unreadable">
      <span class="font-semibold text-warning-ink">Stored but unreadable:</span> <%= @unreadable.to_sentence %>. It was encrypted with keys this server no longer has; connecting again replaces it.
    </p>
  <% end %>

  <div class="card p-4 space-y-3 text-sm" data-test="fathom-section" data-state="<%= state %>">
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
      <div class="min-w-0 space-y-1">
        <h2 class="font-semibold text-heading text-base">Meeting notes and transcripts</h2>
        <% if state == "connected" %>
          <span class="badge text-xs bg-success/10 text-success-ink border-success/40" data-test="fathom-badge">Connected</span>
        <% elsif state == "read_failed" %>
          <span class="badge text-xs bg-warning/10 text-warning-ink border-warning/40" data-test="fathom-badge">Connected, but the read failed</span>
        <% else %>
          <span class="badge text-xs bg-warning/10 text-warning-ink border-warning/40" data-test="fathom-badge">Not connected</span>
        <% end %>
        <% if @connection %>
          <p class="text-body" data-test="fathom-account">
            <span class="font-semibold text-heading break-all" data-field="account"><%= @connection.account %></span>
            <span class="block text-muted text-xs" data-field="connected">Connected <%= stamp.(@connection.connected_at) %><% if @connection.connected_by.present? %> by <%= @connection.connected_by %><% end %></span>
            <% if @connection.last_refreshed_at %>
              <span class="block text-muted text-xs" data-field="refreshed">Token last refreshed <%= stamp.(@connection.last_refreshed_at) %></span>
            <% end %>
          </p>
        <% end %>
      </div>
      <% if @connection %>
        <%= button_to "Disconnect", admin_fathom_disconnect_path, method: :delete, class: "btn btn-danger btn-sm w-full sm:w-auto",
                      form: { class: "shrink-0", data: { test: "fathom-disconnect", turbo_confirm: "Disconnect Fathom for #{@connection.account}?" } } %>
      <% elsif can_connect %>
        <%= link_to "Connect Fathom", admin_fathom_connect_path,
                    class: "btn btn-primary btn-sm w-full sm:w-auto shrink-0 text-center", data: { test: "fathom-connect", turbo: false } %>
      <% end %>
    </div>

    <% if @error %>
      <p class="text-body" data-test="fathom-read-error"><%= @error %></p>
    <% elsif @connection.nil? %>
      <p class="text-muted" data-test="fathom-detail"><%= can_connect ? "Not connected. Connect signs in with Fathom and asks to read meetings only." : "Connect is off until the setup below is done." %></p>
    <% else %>
      <% page = @read.page %>
      <% newest = @read.newest %>
      <div class="space-y-2" data-test="fathom-read" data-count="<%= page.meetings.size %>" data-more="<%= page.more? %>">
        <p class="font-medium text-heading" data-field="meetings">
          <%= pluralize(page.meetings.size, "meeting") %> on the first page<%= page.more? ? ", and more after it" : "" %>
        </p>
        <% if newest.nil? %>
          <p class="text-muted">No meetings yet.</p>
        <% else %>
          <dl class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-4 gap-y-1">
            <dt class="text-muted text-xs">Newest meeting</dt>
            <dd class="text-heading break-words min-w-0" data-field="newest-title"><%= newest.title %></dd>
            <dt class="text-muted text-xs">Recorded</dt>
            <dd class="text-body" data-field="newest-date"><%= newest.created_at ? stamp.(newest.created_at) : "unknown" %></dd>
            <dt class="text-muted text-xs">Transcript</dt>
            <dd class="text-body" data-field="transcript" data-lines="<%= @read.transcript.lines.size %>" data-speakers="<%= @read.transcript.speakers.size %>">
              <%= pluralize(@read.transcript.lines.size, "line") %> from <%= pluralize(@read.transcript.speakers.size, "speaker") %>
            </dd>
            <dt class="text-muted text-xs">Summary</dt>
            <dd class="text-body" data-field="summary" data-length="<%= @read.summary.length %>">
              <%= @read.summary.empty? ? "None yet" : pluralize(@read.summary.length, "character") %>
            </dd>
          </dl>
        <% end %>
      </div>
    <% end %>
  </div>

  <% unless can_connect %>
    <dl class="card p-4 space-y-3 text-sm border-warning/40" data-test="fathom-server">
      <% unless @configured %>
        <div>
          <dt class="text-muted text-xs mb-1">OAuth app</dt>
          <dd class="text-body break-words" data-field="client" data-set="false">
            <span class="font-semibold text-warning-ink">Not set.</span>
            Set <span class="font-mono text-xs">FATHOM_CLIENT_ID</span> and <span class="font-mono text-xs">FATHOM_CLIENT_SECRET</span>.
            <span class="text-muted">Its redirect URI must be <span class="font-mono text-xs break-all"><%= @callback_url %></span></span>
          </dd>
        </div>
      <% end %>
      <% unless @encryption_ready %>
        <div>
          <dt class="text-muted text-xs mb-1">Encryption</dt>
          <dd class="text-body break-words" data-field="encryption" data-ready="false">
            <span class="font-semibold text-warning-ink">Not ready.</span> Set <span class="font-mono text-xs"><%= FathomConnection::ENCRYPTION_ENV.join(", ") %></span>: without them no connection can be stored.
          </dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</section>
