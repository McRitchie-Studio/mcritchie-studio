#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/static-downgrade — move one app off its Heroku dyno to a static site on
# Cloudflare R2 (StaticCloudflare::Downgrade; runbook
# docs/agents/modules/static-cloudflare.md). The hosting-trial daily job calls the
# same unit for an app past its 30-day trial.
#
#   bin/static-downgrade <repo>                 PLAN: read Cloudflare, print every write; writes nothing
#   bin/static-downgrade <repo> --execute       build origin/main, upload, flip the host, smoke, scale web to 0
#   bin/static-downgrade <repo> --execute --keep-dyno   the same, but leave the Heroku dyno running
#   bin/static-downgrade <repo> --sha <sha>     build that commit instead of origin/main
#
# The app keeps its Heroku app (scaled to 0, never deleted) until Alex rules on
# removing it. After an --execute, the app's config/release_repos.yml entry must
# move to `profile: standalone-static` in the same pass, or the next ship would
# git-push a dyno nobody serves.
#
# Credentials, read from 1Password and never printed: cloudflare.studio.provision
# (admin lane: zone, DNS, R2 bucket and custom domain, URL rewrite), the upload
# keys in the adapter's `credential` (default r2.static-sites), and the Heroku
# agent key (heroku.studio.agents) for the scale.

require "fileutils"
require "tmpdir"
require "yaml"
require_relative "lib/cli_arg_guard"

USAGE = <<~TEXT
  Usage: bin/static-downgrade <repo> [--execute] [--keep-dyno] [--sha <sha>]
TEXT

ARGS = CliArgGuard.guard!(ARGV, program: "static-downgrade", usage: USAGE,
                                consequence: "nothing was read or written.",
                                bool: %w[--execute --keep-dyno], value: %w[--sha], allow_positional: true)

require_relative "lib/static_cloudflare"
require_relative "lib/projects_root"

repo = ARGS.positionals.first.to_s
abort USAGE if repo.empty? || ARGS.positionals.size > 1

registry = YAML.safe_load_file(File.expand_path("../config/release_repos.yml", __dir__)) || {}
adapter = registry.dig("apps", repo, "prod_deploy")
abort "static-downgrade: #{repo} is not an app in config/release_repos.yml" unless adapter

execute = ARGS.bool?("--execute")
checkout = File.join(ProjectsRoot.default_projects_dir, repo)

begin
  target = StaticCloudflare.downgrade_target(repo, adapter)
  transport = DomainCutover::Transport.new
  token, account = DomainCutover::Credentials.cloudflare
  cloudflare = StaticCloudflare::CloudflareApi.new(transport, token: token, account_id: account)
  heroku = execute ? DomainCutover::Heroku.new(transport, key: DomainCutover::Credentials.heroku) : nil

  run = lambda do |deploy|
    StaticCloudflare::Downgrade.new(target: target, cloudflare: cloudflare, heroku: heroku, deploy: deploy,
                                    say: ->(line) { puts line }, execute: execute,
                                    scale_heroku: !ARGS.bool?("--keep-dyno")).call
  end

  unless execute
    run.call(nil)
    puts "\nPLAN ONLY. Re-run with --execute to write it."
    exit 0
  end

  # A private detached worktree at the SHA: the build writes tmp/ and public/assets,
  # and a primary checkout is never written.
  system("git", "-C", checkout, "fetch", "-q", "origin") || abort("static-downgrade: git fetch failed in #{checkout}")
  sha = ARGS.first("--sha") || IO.popen(["git", "-C", checkout, "rev-parse", "origin/main"], &:read).strip
  workspace = Dir.mktmpdir("static-downgrade-#{repo}-")
  FileUtils.rm_rf(workspace)
  system("git", "-C", checkout, "worktree", "add", "-q", "--detach", workspace, sha) ||
    abort("static-downgrade: could not cut a worktree at #{sha}")
  begin
    runner = lambda do |argv, env, chdir|
      out, status = Open3.capture2e(env, *argv, chdir: chdir)
      [out, status.success?]
    end
    deploy = StaticCloudflare::Deploy.new(
      target: target, workspace: workspace, sha: sha, runner: runner, http: transport,
      uploader: StaticCloudflare::S3Uploader.new(StaticCloudflare::Credentials.r2(target.credential)),
      say: ->(line) { puts "→ #{line}" }
    )
    run.call(deploy)
    puts "\n✓ #{repo} serves from r2://#{target.bucket} at #{target.smoke_url} (sha #{sha[0, 8]})."
    puts "  Now move its config/release_repos.yml entry to `profile: standalone-static`."
  ensure
    system("git", "-C", checkout, "worktree", "remove", "--force", workspace, out: File::NULL, err: File::NULL)
  end
rescue StaticCloudflare::Abort, DomainCutover::Abort => e
  abort "static-downgrade: #{e.message}"
end
