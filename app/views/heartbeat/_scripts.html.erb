<script>
  // Inline factory for the section's x-data. Defined inline (plain script, not a
  // module) because Alpine loads via `defer` and evaluates BEFORE importmap modules
  // — an x-data referencing a module-exported factory would be undefined at init.
  window.heartbeatDrawer = function () {
    return {
      drawer: false,
      // Open the per-action grading drawer by pointing the shared turbo-frame at the
      // action's feedback URL. Re-opening the same row forces a fresh server fetch.
      openDrawer(url) {
        this.drawer = true;
        var frame = document.getElementById("hb-drawer");
        if (!frame) return;
        if (frame.getAttribute("src") === url) { frame.reload(); } else { frame.src = url; }
      },
      closeDrawer() { this.drawer = false; },
      // Whitespace word count for the drawer's live "aim 4–7 words" counter.
      wordCount(text) { return (text || "").trim().split(/\s+/).filter(Boolean).length; }
    };
  };

  // Per-activity row component: owns the expand/collapse `open` AND the activity's live grade
  // markers. It hydrates its Alex/McRitchie marker state from the server-rendered
  // data-* attributes on the <tbody> (so a page load already reflects existing grades),
  // then listens for the hb:activity-graded CustomEvent the activity drawer dispatches after a
  // fetch save — updating the matching grader's marker in place without a reload.
  window.heartbeatActivityRow = function () {
    return {
      open: false,
      activityId: null,
      grades: { alex: null, mcr: null },
      hydrate(el) {
        this.activityId = el.dataset.activityId;
        this.grades.alex = this.readGrade(el.dataset, "alex");
        this.grades.mcr = this.readGrade(el.dataset, "mcr");
      },
      readGrade(data, who) {
        if (data[who + "Graded"] !== "true") return null;
        return {
          disposition: data[who + "Disp"] || "",
          slug: data[who + "Slug"] || "",
          banked: data[who + "Banked"] === "true"
        };
      },
      onGraded(detail) {
        if (!detail || String(detail.agent_activity_id) !== String(this.activityId)) return;
        if (detail.cleared) {
          this.grades[detail.grader] = null;
          return;
        }
        this.grades[detail.grader] = {
          disposition: detail.disposition,
          slug: detail.slug,
          banked: !!detail.banked
        };
      },
      // The inline quick-grade: a good/not radio changed on the activity row. It POSTs the
      // little form (CSRF token + grader + the checked disposition) to the JSON
      // activity grade endpoint by fetch,
      // and dispatches hb:activity-graded so this row's own onGraded flips the marker +
      // radio state live (no reload). A failed save leaves the radio; the next load
      // reflects server truth.
      async quickGrade(ev) {
        var form = ev.target.closest("form");
        if (!form) return;
        var body = new FormData(form);
        try {
          var resp = await fetch(form.action, {
            method: "POST",
            headers: { "Accept": "application/json" },
            body: body
          });
          var data = await resp.json();
          if (!resp.ok) return;
          window.dispatchEvent(new CustomEvent("hb:activity-graded", { detail: data }));
        } catch (err) {
          /* network error — leave the radio; a reload reflects server truth */
        }
      },
      async clearGrade(ev) {
        var form = ev.target.closest("form");
        if (!form) return;
        var body = new FormData(form);
        body.set("intent", "clear");
        body.delete("disposition");
        try {
          var resp = await fetch(form.action, {
            method: "POST",
            headers: { "Accept": "application/json" },
            body: body
          });
          var data = await resp.json();
          if (!resp.ok) return;
          window.dispatchEvent(new CustomEvent("hb:activity-graded", { detail: data }));
        } catch (err) {
          /* network error — leave the visible grade; a reload reflects server truth */
        }
      }
    };
  };

  // The OPEN activity's live elapsed timer. `startedAtEpoch` is the activity's
  // created/opened_at as UNIX seconds (server-rendered); the component ticks once a
  // second, formatting now-minus-start as "H:MM:SS" (or "M:SS" under an hour) so the
  // top of an open activity card counts UP in real time until it closes. Defined
  // inline (plain script, not a module) for the same reason as the factories above —
  // Alpine's `defer` evaluates x-data BEFORE importmap modules load. self-clears its
  // interval on teardown so a re-rendered / removed card never leaks a timer.
  window.hbElapsed = function (startedAtEpoch) {
    return {
      label: "",
      timer: null,
      pad(n) { return (n < 10 ? "0" : "") + n; },
      tick() {
        var secs = Math.max(0, Math.floor(Date.now() / 1000) - startedAtEpoch);
        var h = Math.floor(secs / 3600);
        var m = Math.floor((secs % 3600) / 60);
        var s = secs % 60;
        this.label = h > 0
          ? h + ":" + this.pad(m) + ":" + this.pad(s)
          : m + ":" + this.pad(s);
      },
      start() {
        this.tick();
        this.timer = setInterval(this.tick.bind(this), 1000);
      },
      stop() { if (this.timer) { clearInterval(this.timer); this.timer = null; } }
    };
  };

  // The activity grade editor inside the activity drawer. Because the grade endpoint
  // returns JSON (view-free by design), this submits via fetch rather than a turbo
  // form: it posts the form (CSRF token + fields + the clicked intent), reflects the
  // saved disposition/banked/discarded back into its own controls, surfaces any error,
  // and dispatches hb:activity-graded so the originating activity row updates its markers live.
  window.heartbeatActivityEditor = function (config) {
    return {
      n: config.n,
      disp: config.disp,
      banked: config.banked,
      discarded: config.discarded,
      saving: false,
      saved: false,
      error: "",
      wordCount(text) { return (text || "").trim().split(/\s+/).filter(Boolean).length; },
      async submit(event) {
        this.error = "";
        this.saved = false;
        this.saving = true;
        var form = event.target;
        var body = new FormData(form);
        var submitter = event.submitter;
        if (submitter && submitter.name) { body.set(submitter.name, submitter.value); }
        try {
          var resp = await fetch(form.action, {
            method: "POST",
            headers: { "Accept": "application/json" },
            body: body
          });
          var data = await resp.json();
          if (!resp.ok) { this.error = (data && data.error) || "Could not save the grade."; return; }
          this.disp = data.disposition;
          this.banked = !!data.banked;
          this.discarded = !!data.discarded;
          this.saved = true;
          window.dispatchEvent(new CustomEvent("hb:activity-graded", { detail: data }));
        } catch (err) {
          this.error = "Could not save the grade.";
        } finally {
          this.saving = false;
        }
      }
    };
  };
</script>
