<% content_for(:title, "McRitchie Studio — Your Workflow Built Right") %>
<% content_for(:full_width, true) %>

<style>
  @keyframes hero-pan {
    0%   { transform: scale(1.3) translateX(-10%); }
    100% { transform: scale(1.3) translateX(10%); }
  }
  /* Scrim strength by theme: dark keeps its navy weight; light runs a lighter
     tint so the photo still shows through behind the dark headline. */
  .hero-scrim { --hero-scrim-edge: 75%; --hero-scrim-mid: 58%; }
  .dark .hero-scrim { --hero-scrim-edge: 85%; --hero-scrim-mid: 70%; }
  /* On the pale tint the secondary grey washes into the skyline; light mode
     takes the darker body ink at semibold. Dark mode keeps its secondary ink. */
  .hero-subtitle-ink { color: var(--color-text-body); font-weight: 600; }
  .dark .hero-subtitle-ink { color: var(--color-text-secondary); font-weight: 400; }
</style>

<!-- Hero -->
<section class="relative overflow-hidden">
  <%# The skyline, sized to its box (lane-ui-infrastructure P2: the one 4700px
      master was 1.6MB on every phone). The box is about 390x554 on a phone and
      about 525 tall from 540px up, and object-fit: cover crops the panorama to
      it, so a phone only ever saw the middle quarter. Below 540px it gets that
      middle as its own portrait crop. Wider screens get the panorama, drawn
      about 1,230 to 1,370px wide below 1440px; from 1440px the box is wider
      than the panorama's shape, so it is drawn at the viewport's width.
      The variants are generated once from the 4700px master with the ImageMagick
      commands in docs/topics/deployment.md (Public Assets), and are fingerprinted
      assets, so they cache for a year. %>
  <% portrait_srcset = [ 390, 768, 1260 ].map { |w| "#{image_path("hero/denver-hero-portrait-#{w}.avif")} #{w}w" }.join(", ") %>
  <% panorama_srcset = [ 1280, 1920, 2560 ].map { |w| "#{image_path("hero/denver-hero-#{w}.avif")} #{w}w" }.join(", ") %>
  <div class="absolute inset-0">
    <picture class="block w-full h-full">
      <source media="(max-width: 539px)" type="image/avif" srcset="<%= portrait_srcset %>" sizes="100vw">
      <source type="image/avif" srcset="<%= panorama_srcset %>" sizes="(max-width: 1439px) 1380px, 100vw">
      <img src="<%= image_path("hero/denver-hero-1280.avif") %>" alt="" width="1280" height="490" fetchpriority="high"
           class="w-full h-full object-cover" data-hero-image style="animation: hero-pan 15s linear infinite alternate;">
    </picture>
  </div>
  <%# The scrim takes the page colour, so it shades the photo in dark mode
      (--color-page is the dark base, #1A1535) and tints it pale in light mode,
      where the headline is dark text. %>
  <div class="hero-scrim absolute inset-0" data-hero-scrim style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-page) var(--hero-scrim-edge), transparent) 0%, color-mix(in srgb, var(--color-page) var(--hero-scrim-mid), transparent) 50%, color-mix(in srgb, var(--color-page) var(--hero-scrim-edge), transparent) 100%);"></div>
  <div class="relative z-10 max-w-4xl mx-auto px-4 text-center section-padding-lg">
    <%# Your ___ Built Right (Alex McRitchie, 2026-10-30). Three lines at every
        width, and the spacing never moves (his call: no expanding title). The
        cycling word has its own line, in a box as wide as the longest word
        (data-spacer), each word centred in it. %>
    <h1 class="font-extrabold text-heading tracking-tight mb-6 flex items-baseline justify-center flex-wrap hero-title" style="line-height: 1.1; column-gap: 0.3em;">
      <span class="basis-full">Your</span>
      <span class="dropping-texts dropping-texts-center text-primary" data-spacer="Workflow">
        <span>Workflow</span>
        <span>Idea</span>
        <span>Plan</span>
      </span>
      <span class="basis-full">Built Right</span>
    </h1>
    <p class="hero-subtitle-ink max-w-2xl mx-auto mb-10 leading-relaxed hero-subtitle">
      An acquisition entrepreneur partnering with owners to carry proven
      businesses into their next decade.
    </p>
    <%# The hero's call to action is the /build funnel (Alex McRitchie, 2026-10-19): Build
        Your App, in the CTA glow primitive's rainbow preset (cta-glow-rainbow,
        app/assets/tailwind/cta_glow.css) to draw the eye. It stands alone: the
        Meet Alex link was dropped (Alex, 2026-10-20; /tasks/drop-hero-meet-alex). %>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      <%= tag.span class: "cta-glow cta-glow-rainbow", data: { test: "hero-build-glow" } do %>
        <%= link_to "Build Your App", build_path, class: "btn btn-primary btn-lg", data: { test: "hero-build-cta" } %>
      <% end %>
    </div>
  </div>
</section>

<!-- About -->
<section id="about" class="max-w-4xl mx-auto px-4 section-padding">
  <div class="text-center mb-12">
    <h2 class="text-4xl font-extrabold text-heading mb-2">Alex McRitchie</h2>
    <p class="text-primary text-lg font-semibold uppercase tracking-wider">Acquisition Entrepreneur</p>
    <p class="text-secondary mt-4 max-w-2xl mx-auto text-lg leading-relaxed">
      Over a decade of operational &amp; engineering leadership.
    </p>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div class="card p-6 text-center">
      <div class="text-5xl mb-3">&#x1F91D;</div>
      <h3 class="text-heading font-bold text-lg mb-2">Business Development</h3>
      <p class="text-secondary">Originating and scaling new business through strategic partnerships and market positioning.</p>
    </div>
    <div class="card p-6 text-center">
      <div class="text-5xl mb-3">&#x1F39B;&#xFE0F;</div>
      <h3 class="text-heading font-bold text-lg mb-2">Operating Excellence</h3>
      <p class="text-secondary">Streamlining operations to maximize efficiency and minimize waste.</p>
    </div>
    <div class="card p-6 text-center">
      <div class="text-5xl mb-3">&#x1F916;</div>
      <h3 class="text-heading font-bold text-lg mb-2">Technical Architecture</h3>
      <p class="text-secondary">Product and engineering design, development &amp; delivery.</p>
    </div>
    <div class="card p-6 text-center">
      <div class="text-5xl mb-3">&#x1F52E;</div>
      <h3 class="text-heading font-bold text-lg mb-2">Leadership &amp; Vision</h3>
      <p class="text-secondary">Guiding teams toward ambitious goals with clarity and purpose.</p>
    </div>
  </div>
</section>

<!-- Get in Touch -->
<%# Its own band: a wash of the primary colour, so the booking section reads as
    separate from the plain page above and the surface-alt band below. %>
<section class="border-t border-subtle" data-get-in-touch
         style="background: linear-gradient(180deg, rgb(var(--color-primary-500-rgb, 139 92 246) / .16), rgb(var(--color-primary-500-rgb, 139 92 246) / .05));">
  <div class="max-w-4xl mx-auto px-4 section-padding">
    <div class="text-center" style="margin-bottom: 1.75rem;">
      <h2 class="text-4xl font-extrabold text-heading mb-2">Get in Touch</h2>
      <p class="text-secondary text-lg">Book a video call to start a conversation.</p>
    </div>

    <%= studio_booking_frame %>
  </div>
</section>

<!-- Acquisition Criteria -->
<section class="bg-surface-alt border-t border-b border-subtle">
  <div class="max-w-4xl mx-auto px-4 section-padding">
    <div class="text-center mb-12">
      <h2 class="text-4xl font-extrabold text-heading mb-2">Is This Your Business?</h2>
      <p class="text-secondary text-lg">I'm looking for established companies ready for their next chapter.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="card p-8 text-center">
        <div class="text-primary font-extrabold mb-3 criterion-value">Service Business</div>
        <p class="text-secondary">with loyal customers</p>
      </div>
      <div class="card p-8 text-center">
        <div class="text-primary font-extrabold mb-3 criterion-value">$1M &ndash; $5M</div>
        <p class="text-secondary">annual revenue</p>
      </div>
      <div class="card p-8 text-center">
        <div class="text-primary font-extrabold mb-3 criterion-value">10+ Years</div>
        <p class="text-secondary">in business</p>
      </div>
    </div>
  </div>
</section>
