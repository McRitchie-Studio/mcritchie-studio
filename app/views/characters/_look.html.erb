<%# One look of a character: its art, sheet status and newest sheet, and the
    actions (make default, add art, build a sheet). Locals: character, look,
    art (chosen AppearanceReferencePhoto rows), sheet (newest live Artifact or nil). %>
<div class="rounded-lg border border-subtle bg-surface p-3 space-y-3 min-w-0" data-test="character-look" data-look="<%= look.slug %>">
  <div class="flex flex-wrap items-center gap-1.5">
    <h3 class="text-sm font-bold text-heading break-words" data-test="look-name"><%= look.descriptor %></h3>
    <% if look.default? %>
      <span class="badge text-3xs bg-success/10 text-success-ink border-success/40" data-test="look-default">default</span>
    <% end %>
    <% if look.colorway.present? %>
      <span class="badge text-3xs bg-surface-alt text-muted border-subtle"><%= look.colorway %></span>
    <% end %>
    <span class="badge text-3xs bg-surface-alt text-muted border-subtle" data-test="look-sheet-state">
      sheet: <%= sheet ? "on file" : (look.sheet_building? ? "building" : "none yet") %>
    </span>
  </div>
  <% if look.generation_notes.present? %>
    <p class="text-2xs text-body break-words"><%= look.generation_notes %></p>
  <% end %>

  <div class="grid gap-2 grid-cols-2 sm:grid-cols-3">
    <% if sheet %>
      <a href="<%= sheet.image_url %>" target="_blank" rel="noopener" class="col-span-2 sm:col-span-3 block rounded border border-subtle bg-surface-alt overflow-hidden" data-test="look-sheet">
        <img src="<%= sheet.image_url %>" alt="<%= character.name %> · <%= look.descriptor %> sheet" class="w-full max-h-80 object-contain" loading="lazy">
      </a>
    <% end %>
    <% art.each do |photo| %>
      <figure class="space-y-1 min-w-0" data-test="look-art">
        <div class="aspect-square rounded border border-subtle bg-surface-alt flex items-center justify-center overflow-hidden">
          <img src="<%= photo.display_url %>" alt="<%= photo.title.presence || look.descriptor %>" class="max-h-full max-w-full object-contain" loading="lazy">
        </div>
        <% if photo.title.present? %>
          <figcaption class="text-3xs text-muted break-words"><%= photo.title %></figcaption>
        <% end %>
      </figure>
    <% end %>
  </div>
  <% if art.empty? && sheet.nil? %>
    <p class="text-2xs text-muted" data-test="look-no-art">No art yet: a sheet build needs at least one reference image.</p>
  <% end %>

  <%= render "appearances/sheet_build_status", look: look %>

  <div class="flex flex-wrap items-center gap-2">
    <% unless look.default? %>
      <%= button_to "Make default", default_character_look_path(character, look.slug), class: "btn btn-sm btn-neutral",
                    form: { data: { test: "make-default-form" } } %>
    <% end %>
    <% if art.any? && !look.sheet_building? %>
      <%= button_to "Build sheet (paid)", character_look_sheet_path(character, look.slug), class: "btn btn-sm btn-neutral",
                    form: { data: { test: "build-sheet-form", turbo_confirm: "Build a character sheet for #{look.descriptor}? This is one paid image generation." } } %>
    <% end %>
  </div>

  <%= form_with url: character_look_art_path(character, look.slug), multipart: true,
                class: "flex flex-wrap items-end gap-2", data: { test: "look-art-form" } do |f| %>
    <div class="min-w-0">
      <%= f.label :art, "Add art", class: "block text-3xs font-semibold text-heading mb-1" %>
      <%= f.file_field :art, accept: "image/png,image/jpeg,image/webp", class: "input-field text-xs max-w-full" %>
    </div>
    <div class="min-w-0">
      <%= f.label :art_label, "Label", class: "block text-3xs font-semibold text-heading mb-1" %>
      <%= f.text_field :art_label, maxlength: 120, class: "input-field text-xs" %>
    </div>
    <%= f.submit "Upload", class: "btn btn-sm btn-neutral" %>
  <% end %>
</div>
