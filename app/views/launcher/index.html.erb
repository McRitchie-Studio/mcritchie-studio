<% content_for(:title, "Session Entry Launcher") %>
<% content_for(:full_width, true) %>

<%# Terminal-launcher local styles: blinking cursor + the traffic-light dots.
    Scoped to the launcher; the terminal chrome is intentionally a fixed dark
    palette (a terminal stays dark on a light desktop) while the page backdrop
    behind it stays theme-aware via the layout body bg-page. %>
<style>
  @keyframes launcher-blink { 50% { opacity: 0; } }
  .launcher-cursor { animation: launcher-blink 1s steps(1) infinite; }
</style>

<section class="min-h-[calc(100vh-var(--nav-h,7rem))] flex items-center justify-center px-4 py-10">
  <div
    x-data="{
      stub: null,
      enter(id, href) {
        this.stub = id;
        if (href) { window.location.assign(href); }
      },
      key(e) {
        if (e.target && /^(input|textarea|select)$/i.test(e.target.tagName)) return;
        if (e.key === '1') this.enter('session', null);
        else if (e.key === '2') this.enter('avi', null);
        else if (e.key === '3') this.enter('alex', '<%= j alex_heartbeat_path %>');
      }
    }"
    @keydown.window="key($event)"
    class="w-full max-w-2xl overflow-hidden rounded-xl border border-[#2a3240] bg-[#0b0f14] shadow-2xl shadow-black/60"
  >
    <%# Terminal title bar with traffic-light dots %>
    <div class="flex items-center gap-2 border-b border-[#2a3240] bg-[#11161d] px-3 py-2.5">
      <span class="h-3 w-3 rounded-full bg-[#ff5f56]"></span>
      <span class="h-3 w-3 rounded-full bg-[#ffbd2e]"></span>
      <span class="h-3 w-3 rounded-full bg-[#27c93f]"></span>
      <span class="ml-2 font-mono text-[11.5px] text-[#5c6573]">claude — /Users/alex/projects</span>
    </div>

    <%# Terminal body %>
    <div class="px-5 py-5 font-mono text-[13px] text-[#e6edf3] sm:px-6 sm:py-6">
      <p class="text-[#5c6573]">Claude Code · McRitchie Studio</p>
      <p class="mt-1">How do you want to enter this session?</p>

      <div class="my-4 flex flex-col gap-2">
        <%# 1 · Session agent — coming-soon stub %>
        <button
          type="button"
          data-avenue="session"
          @click="enter('session', null)"
          aria-label="Enter as Session agent (coming soon)"
          class="group flex items-center gap-3 rounded-lg border bg-[#11161d] px-3 py-2.5 text-left transition hover:bg-[#141b24] hover:border-[#58a6ff] focus:outline-none focus-visible:border-[#58a6ff] sm:gap-4"
          :class="stub === 'session' ? 'border-[#58a6ff]' : 'border-[#2a3240]'"
        >
          <span class="grid h-6 w-6 shrink-0 place-items-center rounded-md bg-[#0b0f14] font-bold text-[#58a6ff]">1</span>
          <span class="min-w-0 flex-1">
            <span class="block font-bold">Session agent</span>
            <span class="block text-[12px] leading-snug text-[#8b949e]">Build a feature, bug, or chore — the default work avenue.</span>
          </span>
          <span class="shrink-0 rounded-sm border border-[#3a4150] px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-[#8b949e]">soon</span>
        </button>

        <%# 2 · Avi — coming-soon stub %>
        <button
          type="button"
          data-avenue="avi"
          @click="enter('avi', null)"
          aria-label="Enter as Avi (coming soon)"
          class="group flex items-center gap-3 rounded-lg border bg-[#11161d] px-3 py-2.5 text-left transition hover:bg-[#141b24] hover:border-[#58a6ff] focus:outline-none focus-visible:border-[#58a6ff] sm:gap-4"
          :class="stub === 'avi' ? 'border-[#58a6ff]' : 'border-[#2a3240]'"
        >
          <span class="grid h-6 w-6 shrink-0 place-items-center rounded-md bg-[#0b0f14] font-bold text-[#58a6ff]">2</span>
          <span class="min-w-0 flex-1">
            <span class="block font-bold">Avi</span>
            <span class="block text-[12px] leading-snug text-[#8b949e]">QA · review heartbeat — review intake and verdicts.</span>
          </span>
          <span class="shrink-0 rounded-sm border border-[#3a4150] px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-[#8b949e]">soon</span>
        </button>

        <%# 3 · Alex — the active avenue. Real link to the learning heartbeat:
            alex_heartbeat_path now renders the atomic trajectory table
            (HeartbeatController#show). data-avenue-target marks the wiring seam. %>
        <%= link_to alex_heartbeat_path,
              data: { avenue: "alex", avenue_target: "learning-heartbeat" },
              "aria-label": "Enter as Alex — learning heartbeat",
              "@click": "enter('alex', null)",
              class: "group flex items-center gap-3 rounded-lg border border-[#2a3240] bg-[#11161d] px-3 py-2.5 text-left transition hover:bg-[#141b24] hover:border-[#58a6ff] focus:outline-none focus-visible:border-[#58a6ff] sm:gap-4" do %>
          <span class="grid h-6 w-6 shrink-0 place-items-center rounded-md bg-[#0b0f14] font-bold text-[#58a6ff]">3</span>
          <span class="min-w-0 flex-1">
            <span class="block font-bold">Alex</span>
            <span class="block text-[12px] leading-snug text-[#8b949e]">Learning · distillation heartbeat — mine the trajectory for insights.</span>
          </span>
          <span class="shrink-0 rounded-sm border border-[#27c93f] px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-[#27c93f]">enter ↵</span>
        <% end %>
      </div>

      <%# Coming-soon confirmation for the two stub avenues %>
      <p
        x-show="stub === 'session' || stub === 'avi'"
        x-cloak
        class="mb-3 text-[12px] text-[#8b949e]"
      >
        <span x-text="stub === 'avi' ? 'Avi' : 'Session agent'"></span>
        is coming soon — for now, enter as <span class="text-[#58a6ff]">Alex (3)</span>.
      </p>

      <p class="text-[#58a6ff]">› select 1–3 <span class="launcher-cursor">▋</span></p>
    </div>
  </div>
</section>
