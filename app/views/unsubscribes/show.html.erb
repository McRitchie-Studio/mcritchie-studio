<div class="max-w-md mx-auto px-4 py-16 text-center">
  <% if @contact %>
    <h1 class="text-2xl font-extrabold text-heading mb-2">Unsubscribe?</h1>
    <p class="text-secondary mb-6">Stop receiving McRitchie Studio emails at <strong class="text-heading"><%= @contact.email %></strong>?</p>
    <%= button_to "Unsubscribe", unsubscribe_path(token: @contact.unsubscribe_token), method: :post, class: "btn btn-primary" %>
  <% else %>
    <h1 class="text-2xl font-extrabold text-heading mb-2">Link not found</h1>
    <p class="text-secondary">This unsubscribe link is invalid or expired.</p>
  <% end %>
</div>
