<%# A BRAND'S TYPE SCALE (task brand-kit-type-scale): each text role as a multiple of one base, built by
    Logos::TypeScale. Title 6x, heading 3x, subhead 1.5x, body 1x, fine print 3/4x; the base is 24 px on a
    1080-wide social post and 16 px on the web. Each row names its role and multiple, both sizes, and a sample of
    the role set in the brand's face at the web size. "Copy CSS tokens" copies the lot as custom properties,
    --<brand>-text-<role> and --<brand>-social-text-<role>, the way the Spectrum card does (data-copy-hex, wired by
    app/javascript/logo_gallery.js). Montserrat is the only face the hub serves. Locals: kit. %>
<% scale = Logos::TypeScale.new(kit) %>
<div class="space-y-4" data-test="logo-type-scale" data-brand="<%= kit.brand %>">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[20rem] text-left text-xs">
      <thead class="text-3xs font-semibold uppercase tracking-wide text-muted">
        <tr>
          <th scope="col" class="py-1 pr-3">Role</th>
          <% scale.surfaces.each do |surface| %>
            <th scope="col" class="py-1 pr-3 whitespace-nowrap" data-test="logo-type-scale-surface" data-surface="<%= surface.key %>"><%= surface.label %> <span class="normal-case">(<%= surface.base %> px base)</span></th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-subtle">
        <% scale.roles.each_with_index do |role, index| %>
          <tr data-test="logo-type-scale-role" data-role="<%= role.key %>">
            <th scope="row" class="py-2 pr-3 align-baseline font-normal">
              <span class="font-semibold text-heading"><%= role.label %></span>
              <span class="font-mono text-muted" data-test="logo-type-scale-multiple"><%= role.multiple_label %></span>
              <span class="block text-3xs text-muted" data-test="logo-type-scale-face"><%= role.typeface.name %></span>
            </th>
            <% scale.surfaces.each do |surface| %>
              <td class="py-2 pr-3 align-baseline font-mono text-body" data-test="logo-type-scale-px" data-surface="<%= surface.key %>"><%= surface.sizes[index].px %> px</td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <% web = scale.surfaces.find { |surface| surface.key == "web" } %>
  <ol class="min-w-0 space-y-2 overflow-hidden rounded-lg border border-subtle p-3" data-test="logo-type-scale-samples" aria-label="Type scale samples at the web size">
    <% web.sizes.each do |size| %>
      <li class="min-w-0 leading-tight text-heading break-words" data-test="logo-type-scale-sample" data-role="<%= size.role.key %>"
          style="font-family: 'Montserrat', sans-serif; font-weight: <%= size.role.typeface.weight %>; font-size: <%= size.px %>px"><%= size.role.label %></li>
    <% end %>
  </ol>

  <details class="rounded-lg border border-subtle" data-test="logo-type-scale-tokens">
    <summary class="cursor-pointer px-3 py-2 text-xs font-semibold text-heading">CSS tokens</summary>
    <div class="space-y-2 border-t border-subtle p-3">
      <div class="flex flex-wrap items-center gap-3">
        <button type="button" class="btn btn-primary btn-sm" data-copy-hex="<%= scale.css %>" data-copy-name="CSS tokens" data-test="logo-type-scale-copy-css"><span data-copy-hex-label>Copy CSS tokens</span></button>
        <span class="text-2xs text-muted" role="status" data-copy-hex-status></span>
      </div>
      <pre class="max-h-64 overflow-auto text-2xs font-mono text-body"><%= scale.css %></pre>
    </div>
  </details>
</div>
