<%# Four-prong style "poster" (task cyvasse-four-prong-emails): colour-blocked
    bands with the board as the star. No merge field is required
    (Broadcasts::CyvasseFour). One tracked play link. %>
<% play_url = broadcast_link(:play, Broadcast::TEMPLATE_LINKS["cyvasse_poster"]["play"]) %>
<% named = @merge_fields.nil? || Broadcasts::CyvasseReturn.username?(@merge_fields) %>
<% history = @merge_fields.nil? || Broadcasts::CyvasseReturn.history?(@merge_fields) %>
<% stats = cyvasse_record_stats %>
<% content_for :email_title, "Your move" %>
<% content_for :preheader, @broadcast&.preview_text.presence || "The board is set. 30 seconds a move." %>
<%= render "broadcasts/blocks/strip", text: "CYVASSE IS BACK", bg: "#ffa800", color: "#16123c" %>
<tr>
  <td style="background-color:#16123c;padding:40px 24px 18px;text-align:center;">
    <div style="font-size:64px;line-height:1;font-weight:900;letter-spacing:-2px;color:#ffffff;">YOUR<br>MOVE.</div>
    <div style="padding-top:14px;font-size:18px;line-height:1.4;color:#c9c4f5;word-break:break-word;">The board is set<%= ", #{merge_field(:username)}" if named %>. 30 seconds a move.</div>
  </td>
</tr>
<tr><td style="background-color:#16123c;font-size:0;line-height:0;"><img src="<%= @email_asset_host %>/email/cyvasse_board.jpg" width="600" alt="A Cyvasse board mid-game" style="display:block;width:100%;height:auto;border:0;"></td></tr>
<tr>
  <td style="background-color:#16123c;padding:26px 24px 34px;text-align:center;">
    <%= render "broadcasts/blocks/cta", url: play_url, label: "PLAY NOW", bg: "#ffa800", color: "#16123c" %>
  </td>
</tr>
<% if history && stats.any? %>
<tr>
  <td style="background-color:#8e82fe;padding:30px 20px 32px;text-align:center;" data-block="record">
    <div style="font-size:13px;font-weight:800;letter-spacing:2px;color:#16123c;padding-bottom:16px;">YOU LEFT THIS ON THE BOARD</div>
    <%= render "broadcasts/blocks/stat_row", stats: stats, color: "#ffffff" %>
  </td>
</tr>
<% end %>
<tr>
  <td style="background-color:#fff8ea;padding:32px 22px 36px;text-align:center;">
    <div style="font-size:28px;line-height:1.1;font-weight:900;color:#16123c;padding-bottom:20px;">What&rsquo;s new since you left</div>
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr><td style="padding:12px 0;border-top:2px solid #16123c;font-size:16px;line-height:1.4;color:#16123c;text-align:left;"><b>Live matches.</b> Hit Play and you&rsquo;re in a game in seconds.</td></tr>
      <tr><td style="padding:12px 0;border-top:2px solid #16123c;font-size:16px;line-height:1.4;color:#16123c;text-align:left;"><b>A leaderboard.</b> <%= history ? "Your old record still counts." : "Climb it from your first game." %></td></tr>
      <tr><td style="padding:12px 0;border-top:2px solid #16123c;border-bottom:2px solid #16123c;font-size:16px;line-height:1.4;color:#16123c;text-align:left;"><b>Made for your phone.</b> No download. It runs in your browser.</td></tr>
    </table>
    <div style="padding-top:24px;"><%= render "broadcasts/blocks/cta", url: play_url, label: history ? "ADD TO YOUR RECORD" : "PLAY NOW", bg: "#16123c", color: "#ffffff" %></div>
  </td>
</tr>
