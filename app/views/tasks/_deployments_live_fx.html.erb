<%# Live /deployments board animations, driven by the real DeploymentsBroadcaster
    Turbo Streams (turbo_stream_from "deployments") for EVERY connected viewer:
      • create (prepend a new card)      → pop + type-coloured glow flash + confetti
      • reviewed arrival                 → smooth-sailing gust burst from behind
      • move   (remove old + prepend new)→ old card shrinks out & its column reclaims
                                           the gap (FLIP), then the new card grows in
      • archive (remove)                 → card dissolves into mist
      • delete (remove)                  → distinct fadeout, column reclaims the gap
      • replace (intent / in-place)      → a subtle glow pulse, no bubbles
    Event type is read from the Turbo Stream action itself (no buttons). Glow colour
    comes from the card's data-glow (its mascot's primary type colour). Only rendered
    on the deploy board (where the live socket is). %>
<style>
  .lbfx-pop { animation: lbfxPop .5s cubic-bezier(.2, 1.4, .3, 1); }
  @keyframes lbfxPop { 0% { transform: scale(.85); } 55% { transform: scale(1.05); } 100% { transform: scale(1); } }

  .lbfx-reviewed-arrive { animation: lbfxReviewedArrive .7s cubic-bezier(.16, 1.2, .25, 1); }
  @keyframes lbfxReviewedArrive {
    0% { transform: translateY(8px) scale(.9); }
    58% { transform: translateY(-2px) scale(1.045); }
    100% { transform: translateY(0) scale(1); }
  }

  /* A flash, not a bloom — brightest on frame one, then fades. Colour from
     --lbfx-glow (the card's mascot type colour); falls back to a warm orange. */
  .lbfx-glow { animation: lbfxGlow .8s ease-out; }
  .lbfx-glow.lbfx-glow-stage { animation-name: lbfxGlowToStage; }
  @keyframes lbfxGlow {
    0%   { box-shadow: 0 0 18px 4px rgb(var(--lbfx-glow, 249 115 22) / .95), 0 0 44px 12px rgb(var(--lbfx-glow, 249 115 22) / .5);
           border-color: rgb(var(--lbfx-glow, 249 115 22) / 1); }
    100% { box-shadow: 0 0 0 0 rgb(var(--lbfx-glow, 249 115 22) / 0); border-color: rgb(var(--lbfx-glow, 249 115 22) / 0); }
  }
  @keyframes lbfxGlowToStage {
    0%   { box-shadow: 0 0 18px 4px rgb(var(--lbfx-glow, 249 115 22) / .95), 0 0 44px 12px rgb(var(--lbfx-glow, 249 115 22) / .5);
           border-color: rgb(var(--lbfx-glow, 249 115 22) / 1); }
    100% { box-shadow: var(--task-card-glow-shadow);
           border-color: var(--task-card-glow-border-color); }
  }

  /* Last Release deploy freshness: 4s of steady rainbow glow, then 4s fade.
     JS sets a negative animation delay from data-shipped-at-ms so replacement
     streams keep the same phase instead of restarting the glow. */
  .lbfx-fresh-deploy {
    animation: lbfxFreshDeployGlow 8s linear both;
    animation-delay: var(--lbfx-fresh-delay, 0ms);
  }
  .release-fresh-glow.lbfx-fresh-deploy::before {
    animation-name: studioBorderGlowSteam, lbfxFreshDeployRingFade;
    animation-duration: var(--studio-border-glow-duration, 20s), 8s;
    animation-timing-function: linear, linear;
    animation-iteration-count: infinite, 1;
    animation-fill-mode: none, both;
    animation-delay: 0s, var(--lbfx-fresh-delay, 0ms);
  }
  .release-fresh-glow.lbfx-fresh-deploy::after {
    animation-name: studioBorderGlowSteam, lbfxFreshDeployHaloFade;
    animation-duration: var(--studio-border-glow-duration, 20s), 8s;
    animation-timing-function: linear, linear;
    animation-iteration-count: infinite, 1;
    animation-fill-mode: none, both;
    animation-delay: 0s, var(--lbfx-fresh-delay, 0ms);
  }
  @keyframes lbfxFreshDeployGlow {
    0%, 50% {
      box-shadow: var(
        --task-card-glow-shadow,
        0 0 0 1px rgba(255,255,255,.72) inset,
        0 0 18px 4px rgba(248,113,113,.9),
        0 0 32px 10px rgba(250,204,21,.68),
        0 0 48px 16px rgba(52,211,153,.58),
        0 0 64px 22px rgba(96,165,250,.52),
        0 0 82px 28px rgba(192,132,252,.48)
      );
      border-color: var(--task-card-glow-border-color, rgba(255,255,255,.82));
    }
    100% {
      box-shadow:
        0 0 0 0 rgba(248,113,113,0),
        0 0 0 0 rgba(250,204,21,0),
        0 0 0 0 rgba(52,211,153,0),
        0 0 0 0 rgba(96,165,250,0),
        0 0 0 0 rgba(192,132,252,0);
      border-color: rgb(var(--lbfx-glow, 249 115 22) / 0);
    }
  }
  @keyframes lbfxFreshDeployRingFade {
    0%, 50% { opacity: var(--studio-border-glow-opacity, .9); }
    100% { opacity: 0; }
  }
  @keyframes lbfxFreshDeployHaloFade {
    0%, 50% { opacity: var(--studio-border-glow-halo-opacity, .34); }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .release-fresh-glow.lbfx-fresh-deploy::before {
      animation: lbfxFreshDeployRingFade 8s linear both;
      animation-delay: var(--lbfx-fresh-delay, 0ms);
    }
    .release-fresh-glow.lbfx-fresh-deploy::after {
      animation: lbfxFreshDeployHaloFade 8s linear both;
      animation-delay: var(--lbfx-fresh-delay, 0ms);
    }
  }

  .lbfx-reviewed-swell { animation: lbfxReviewedSwell .95s ease-out; }
  @keyframes lbfxReviewedSwell {
    0%   { box-shadow: 0 0 20px 5px rgb(45 212 191 / .95), 0 0 54px 16px rgb(125 211 252 / .45);
           border-color: rgb(45 212 191 / 1); }
    45%  { box-shadow: 0 0 26px 8px rgb(250 204 21 / .72), 0 0 68px 22px rgb(103 232 249 / .44);
           border-color: rgb(250 204 21 / .9); }
    100% { box-shadow: 0 0 0 0 rgb(45 212 191 / 0); border-color: rgb(45 212 191 / 0); }
  }

  /* Keep cards above active confetti. Particles render below this z-layer, so
     they peek out around the sides instead of covering card text. */
  .lbfx-confetti-active .kanban-card { position: relative; z-index: 30; }
  .lbfx-confetti-active .kanban-card.lbfx-card-front,
  .lbfx-card-front { position: relative; z-index: 40; }
</style>
<script>
  // Installed once; survives Turbo navigations.
  window.LiveBoardFx = window.LiveBoardFx || (function () {
    const CONFETTI_COLORS = ["#00C4FF", "#34d399", "#f472b6", "#fbbf24", "#a78bfa", "#22d3ee", "#fb7185"];
    const REVIEWED_GUST_COLORS = ["#67e8f9", "#5eead4", "#fef3c7", "#ffffff", "#22d3ee"];
    const MIST_COLORS = ["rgba(226,232,240,.64)", "rgba(191,219,254,.5)", "rgba(203,213,225,.56)", "rgba(255,255,255,.52)"];
    const FRESH_DEPLOY_MS = 8000;

    // The release modules above the board (replaced on a release state change) —
    // the dropzone observer never sees them, so they're flashed straight from the
    // stream handler: an 8s fresh-deploy glow on the just-shipped Last Release, a
    // subtle glow on the Next Release reset.
    const RELEASE_FX = { "last-release": "fresh-deploy", "current-release": "glow" };

    // Per-card coordination between the `remove` stream (intercepted) and the
    // `prepend` that follows it on a MOVE.
    const collapsing = new Map();     // cardId → Promise (resolves when its collapse-out finishes)
    const pendingAction = new Map();  // cardId → 'prepend' | 'append' | 'replace' (the just-seen stream)

    function followingStreamCardIds(stream) {
      const ids = [];
      let next = stream.nextElementSibling;
      while (next && next.tagName && next.tagName.toLowerCase() === "turbo-stream") {
        const template = next.querySelector("template");
        if (template) {
          template.content.querySelectorAll(".kanban-card").forEach((card) => ids.push(card.id));
        }
        next = next.nextElementSibling;
      }
      return ids;
    }

    // "#78C850" → "120 200 80" (for `rgb(var() / a)`); null if unparseable.
    function hexToRgb(hex) {
      const m = /^#?([0-9a-f]{6})$/i.exec(hex || "");
      if (!m) return null;
      const n = parseInt(m[1], 16);
      return ((n >> 16) & 255) + " " + ((n >> 8) & 255) + " " + (n & 255);
    }

    function stageGlowHex(card) {
      return getComputedStyle(card).getPropertyValue("--task-card-glow-color").trim();
    }

    // Tint + flash the glow from the card's data-glow (mascot type colour).
    function glow(card) {
      const steadyStageGlow = !!card.dataset.stageGlow;
      const rgb = hexToRgb(card.dataset.glow || stageGlowHex(card));
      if (rgb) card.style.setProperty("--lbfx-glow", rgb);
      if (steadyStageGlow) card.classList.add("lbfx-glow-stage");
      card.classList.add("lbfx-glow");
      setTimeout(() => {
        card.classList.remove("lbfx-glow", "lbfx-glow-stage");
        card.style.removeProperty("--lbfx-glow");
      }, 850);
    }

    function freshDeployGlow(card) {
      if (!card || card.dataset.freshDeploy !== "true") return false;
      const shippedAt = Number(card.dataset.shippedAtMs || 0);
      const elapsed = shippedAt > 0 ? Math.max(0, Date.now() - shippedAt) : 0;
      if (elapsed >= FRESH_DEPLOY_MS) {
        clearFreshDeployGlow(card);
        return false;
      }

      card.style.setProperty("--lbfx-fresh-delay", "-" + elapsed + "ms");
      card.classList.remove("opacity-75");
      card.classList.add("studio-border-glow", "release-fresh-glow");
      card.classList.remove("lbfx-fresh-deploy");
      void card.offsetWidth;
      card.classList.add("lbfx-fresh-deploy");
      setTimeout(() => clearFreshDeployGlow(card), FRESH_DEPLOY_MS - elapsed + 150);
      return true;
    }

    function clearFreshDeployGlow(card) {
      if (!card) return;
      card.classList.remove("lbfx-fresh-deploy", "studio-border-glow", "release-fresh-glow");
      card.classList.add("opacity-75");
      card.dataset.freshDeploy = "false";
      card.style.removeProperty("--lbfx-fresh-delay");
      card.style.removeProperty("--studio-border-glow-offset");
      card.style.removeProperty("--studio-border-glow-duration");
      card.style.removeProperty("--studio-border-glow-angle");
      card.style.removeProperty("--task-card-glow-color");
      card.style.removeProperty("--task-card-glow-color-a");
      card.style.removeProperty("--task-card-glow-color-b");
      card.style.removeProperty("--task-card-glow-border-color");
      card.style.removeProperty("--task-card-glow-shadow");
      card.style.removeProperty("border-color");
      card.style.removeProperty("box-shadow");
      if (!card.getAttribute("style")) card.removeAttribute("style");
    }

    function reviewedGlow(card) {
      card.classList.add("lbfx-reviewed-swell");
      setTimeout(() => card.classList.remove("lbfx-reviewed-swell"), 1000);
    }

    function liftCard(card) {
      document.body.classList.add("lbfx-confetti-active");
      card.classList.add("lbfx-card-front");
      setTimeout(() => card.classList.remove("lbfx-card-front"), 950);
      setTimeout(() => document.body.classList.remove("lbfx-confetti-active"), 1450);
    }

    // Larger confetti pieces sit behind the lifted card and shoot from the side
    // edges. The center stays hidden by the card, so text remains readable.
    function spawnConfettiBehind(card) {
      const r = card.getBoundingClientRect();
      if (!r.width) return;
      const N = 34;
      for (let i = 0; i < N; i++) {
        const piece = document.createElement("div");
        const side = i % 2 === 0 ? -1 : 1;
        const width = 8 + Math.random() * 11;
        const height = 7 + Math.random() * 15;
        const startX = side < 0 ? r.left + 3 + Math.random() * 10 : r.right - 3 - Math.random() * 10;
        const startY = r.top + r.height * (0.18 + Math.random() * 0.64);
        const dx = side * (42 + Math.random() * 118);
        const dy = (Math.random() - 0.5) * 136 - 18;
        const spin = side * (160 + Math.random() * 360);
        piece.style.cssText =
          "position:fixed;left:" + startX + "px;top:" + startY + "px;width:" + width + "px;height:" + height +
          "px;border-radius:3px;pointer-events:none;z-index:20;background:" +
          CONFETTI_COLORS[i % CONFETTI_COLORS.length] + ";box-shadow:0 0 10px rgba(255,255,255,.32);";
        document.body.appendChild(piece);
        piece.animate(
          [
            { transform: "translate(-50%,-50%) rotate(0deg) scale(.65)", opacity: 0.95 },
            { transform: "translate(calc(-50% + " + dx + "px), calc(-50% + " + dy + "px)) rotate(" + spin + "deg) scale(1)", opacity: 0.85, offset: 0.58 },
            { transform: "translate(calc(-50% + " + (dx * 1.15) + "px), calc(-50% + " + (dy + 36) + "px)) rotate(" + (spin * 1.35) + "deg) scale(.25)", opacity: 0 }
          ],
          { duration: 850 + Math.random() * 500, easing: "cubic-bezier(.18,.78,.2,1)" }
        ).onfinish = () => piece.remove();
      }
    }

    // Reviewed is the "smooth sailing" moment: longer mint/cyan ribbons blow out
    // from behind the card edges while the card stays in front.
    function spawnReviewedGustBehind(card) {
      const r = card.getBoundingClientRect();
      if (!r.width) return;
      const N = 32;
      for (let i = 0; i < N; i++) {
        const ribbon = document.createElement("div");
        const side = i % 2 === 0 ? -1 : 1;
        const width = 18 + Math.random() * 30;
        const height = 7 + Math.random() * 9;
        const startX = side < 0 ? r.left - 5 + Math.random() * 8 : r.right + 5 - Math.random() * 8;
        const startY = r.top + r.height * (0.16 + Math.random() * 0.68);
        const dx = side * (92 + Math.random() * 176);
        const dy = -50 + Math.random() * 112;
        const spin = side * (90 + Math.random() * 220);
        ribbon.style.cssText =
          "position:fixed;left:" + startX + "px;top:" + startY + "px;width:" + width + "px;height:" + height +
          "px;border-radius:9999px;pointer-events:none;z-index:35;background:" +
          REVIEWED_GUST_COLORS[i % REVIEWED_GUST_COLORS.length] + ";box-shadow:0 0 16px rgba(103,232,249,.58),0 0 28px rgba(250,204,21,.22);";
        document.body.appendChild(ribbon);
        ribbon.animate(
          [
            { transform: "translate(-50%,-50%) rotate(" + (-side * 8) + "deg) scaleX(.72)", opacity: 1 },
            { transform: "translate(calc(-50% + " + dx + "px), calc(-50% + " + dy + "px)) rotate(" + spin + "deg) scaleX(1.16)", opacity: 0.9, offset: 0.48 },
            { transform: "translate(calc(-50% + " + (dx * 1.18) + "px), calc(-50% + " + (dy + 24) + "px)) rotate(" + (spin * 1.25) + "deg) scaleX(.22)", opacity: 0 }
          ],
          { duration: 920 + Math.random() * 460, easing: "cubic-bezier(.16,.84,.24,1)" }
        ).onfinish = () => ribbon.remove();
      }
    }

    function spawnReviewedWake(card) {
      const r = card.getBoundingClientRect();
      if (!r.width) return;
      for (let i = 0; i < 2; i++) {
        const wake = document.createElement("div");
        const padX = 20 + i * 18;
        const padY = 14 + i * 12;
        wake.style.cssText =
          "position:fixed;left:" + (r.left + r.width / 2) + "px;top:" + (r.top + r.height / 2) + "px;width:" + (r.width + padX) +
          "px;height:" + (r.height + padY) + "px;border-radius:14px;pointer-events:none;z-index:35;border:2px solid rgba(103,232,249,.72);" +
          "background:radial-gradient(circle at center, rgba(94,234,212,.2), rgba(103,232,249,.08) 45%, rgba(250,204,21,.12) 68%, transparent 72%);" +
          "box-shadow:0 0 24px rgba(103,232,249,.42),0 0 42px rgba(250,204,21,.2);";
        document.body.appendChild(wake);
        wake.animate(
          [
            { transform: "translate(-50%,-50%) scale(.72)", opacity: 0.78 },
            { transform: "translate(-50%,-50%) scale(1.08)", opacity: 0.54, offset: 0.48 },
            { transform: "translate(-50%,-50%) scale(1.34)", opacity: 0 }
          ],
          { duration: 760 + i * 180, easing: "cubic-bezier(.16,.84,.24,1)" }
        ).onfinish = () => wake.remove();
      }
    }

    function spawnMist(card) {
      const r = card.getBoundingClientRect();
      if (!r.width) return;
      const N = 32;
      for (let i = 0; i < N; i++) {
        const puff = document.createElement("div");
        const size = 14 + Math.random() * 30;
        const startX = r.left + r.width * (0.1 + Math.random() * 0.8);
        const startY = r.top + r.height * (0.12 + Math.random() * 0.76);
        const dx = (Math.random() - 0.5) * 120;
        const dy = (Math.random() - 0.68) * 100;
        puff.style.cssText =
          "position:fixed;left:" + startX + "px;top:" + startY + "px;width:" + size + "px;height:" + size +
          "px;border-radius:9999px;pointer-events:none;z-index:45;background:" +
          MIST_COLORS[i % MIST_COLORS.length] + ";filter:blur(" + (2 + Math.random() * 4) + "px);";
        document.body.appendChild(puff);
        puff.animate(
          [
            { transform: "translate(-50%,-50%) scale(.35)", opacity: 0 },
            { transform: "translate(calc(-50% + " + (dx * 0.5) + "px), calc(-50% + " + (dy * 0.5) + "px)) scale(1)", opacity: 0.72, offset: 0.32 },
            { transform: "translate(calc(-50% + " + dx + "px), calc(-50% + " + dy + "px)) scale(1.8)", opacity: 0 }
          ],
          { duration: 780 + Math.random() * 360, easing: "ease-out" }
        ).onfinish = () => puff.remove();
      }
    }

    // The full arrival flourish: glow + side confetti, and (unless the caller drives its
    // own scale, e.g. the move grow-in) a pop.
    function burst(card, pop) {
      const r = card.getBoundingClientRect();
      if (!r.width) return;
      if (pop !== false) card.classList.add("lbfx-pop");
      liftCard(card);
      glow(card);
      if (pop !== false) setTimeout(() => card.classList.remove("lbfx-pop"), 520);
      spawnConfettiBehind(card);
    }

    function reviewedBurst(card, pop) {
      const r = card.getBoundingClientRect();
      if (!r.width) return;
      if (pop !== false) card.classList.add("lbfx-reviewed-arrive");
      liftCard(card);
      reviewedGlow(card);
      if (pop !== false) setTimeout(() => card.classList.remove("lbfx-reviewed-arrive"), 740);
      spawnReviewedWake(card);
      spawnReviewedGustBehind(card);
    }

    function arrivalBurst(card, pop) {
      if (card.dataset.stage === "reviewed") {
        reviewedBurst(card, pop);
      } else {
        burst(card, pop);
      }
    }

    function animateExit(card, exitAction, done) {
      if (exitAction === "archive") {
        spawnMist(card);
        card.animate(
          [
            { opacity: 1, filter: "blur(0px)", transform: "scale(1)" },
            { opacity: 0.62, filter: "blur(2px)", transform: "scale(.98)", offset: 0.34 },
            { opacity: 0, filter: "blur(9px)", transform: "scale(.86)" }
          ],
          { duration: 760, easing: "ease-in", fill: "forwards" }
        ).onfinish = done;
      } else if (exitAction === "delete") {
        card.animate(
          [
            { opacity: 1, transform: "translateX(0) rotate(0deg) scale(1)", filter: "blur(0)" },
            { opacity: .55, transform: "translateX(8px) rotate(1deg) scale(.96)", filter: "blur(0)", offset: .42 },
            { opacity: 0, transform: "translateX(28px) rotate(-2deg) scale(.72)", filter: "blur(1px)" }
          ],
          { duration: 430, easing: "cubic-bezier(.35,0,.2,1)", fill: "forwards" }
        ).onfinish = done;
      } else {
        card.animate(
          [{ opacity: 1, transform: "scale(1)" }, { opacity: 0, transform: "scale(.55)" }],
          { duration: 450, easing: "linear", fill: "forwards" }
        ).onfinish = done;
      }
    }

    // Remove a card while its column reclaims the gap smoothly — FLIP the siblings
    // (transform between measured before/after positions) so the dropzone's space-y
    // margins can't cause a pause/snap. Resolves so a move's incoming card can wait.
    function collapseOut(card, done, exitAction) {
      let signalDone;
      const promise = new Promise((res) => { signalDone = res; });
      const finish = () => { if (done) done(); signalDone(); };
      if (!card) { finish(); return promise; }

      const zone = card.parentElement;
      const siblings = zone ? Array.from(zone.querySelectorAll(":scope > .kanban-card")).filter((c) => c !== card) : [];
      const beforeTop = siblings.map((c) => c.getBoundingClientRect().top);

      const rect = card.getBoundingClientRect();
      const zr = zone.getBoundingClientRect();
      const zs = getComputedStyle(zone);
      const restorePos = zone.style.position;
      if (zs.position === "static") zone.style.position = "relative";
      Object.assign(card.style, {
        position: "absolute",
        width: rect.width + "px",
        height: rect.height + "px",
        top: (rect.top - zr.top - (parseFloat(zs.borderTopWidth) || 0) + zone.scrollTop) + "px",
        left: (rect.left - zr.left - (parseFloat(zs.borderLeftWidth) || 0) + zone.scrollLeft) + "px",
        margin: "0", zIndex: exitAction === "archive" ? "35" : "5", pointerEvents: "none", transformOrigin: "center top"
      });
      if (exitAction) card.dataset.exitAction = exitAction;

      siblings.forEach((c, i) => {
        const delta = beforeTop[i] - c.getBoundingClientRect().top;
        if (!delta) return;
        c.style.transition = "none";
        c.style.transform = "translateY(" + delta + "px)";
        requestAnimationFrame(() => {
          c.style.transition = "transform .45s linear";
          c.style.transform = "";
          const clear = () => { c.style.transition = ""; c.style.transform = ""; c.removeEventListener("transitionend", clear); };
          c.addEventListener("transitionend", clear);
        });
      });

      animateExit(card, exitAction, () => { delete card.dataset.exitAction; zone.style.position = restorePos; finish(); });
      return promise;
    }

    // A move's incoming card: hold it invisible + out of flow (Alpine x-show owns
    // `display`, so use visibility + position) until the outgoing card has gone,
    // then grow it in with the burst.
    function holdThenGrowIn(card, ready) {
      card.style.visibility = "hidden";
      card.style.position = "absolute";
      card.style.pointerEvents = "none";
      Promise.race([ready, new Promise((res) => setTimeout(res, 1000))]).then(() => {
        if (!document.body.contains(card)) return;
        card.style.transition = ""; card.style.transform = "";
        card.style.transformOrigin = "center";
        card.style.opacity = "0";
        card.style.visibility = ""; card.style.position = ""; card.style.pointerEvents = "";
        const grow = card.animate(
          [
            { opacity: 0, transform: "scale(.5)" },
            { opacity: 1, transform: "scale(1.05)", offset: 0.65 },
            { opacity: 1, transform: "scale(1)" }
          ],
          { duration: 380, easing: "ease-out", fill: "both" }
        );
        grow.onfinish = () => { card.style.opacity = ""; card.style.transformOrigin = ""; grow.cancel(); };
        arrivalBurst(card, false);
      });
    }

    // Called by the board's observeLive for each freshly patched-in card.
    function onAdd(node) {
      if (!node.id || !node.id.startsWith("card-")) return;
      // A local drag moves a card's node into a new column — that's not a live
      // event, so don't burst it. (The drag's own broadcast move echo arrives after
      // the PATCH, once the flag has cleared, and animates normally.)
      if (window.__lbfxDragging) return;
      const wasMoving = collapsing.get(node.id);
      const action = pendingAction.get(node.id);
      pendingAction.delete(node.id);
      if (wasMoving) {                       // MOVE arrival
        collapsing.delete(node.id);
        holdThenGrowIn(node, wasMoving);
      } else if (action === "replace") {     // in-place update
        requestAnimationFrame(() => glow(node));
      } else {                                // CREATE
        requestAnimationFrame(() => arrivalBurst(node, true));
      }
    }

    // Classify every incoming deployments stream from its action; intercept removes
    // to collapse-out first (a move's old card and a delete/archive share this path).
    document.addEventListener("turbo:before-stream-render", (event) => {
      const stream = event.target;
      const action = stream.getAttribute("action");
      const target = stream.getAttribute("target") || "";
      // Release-module swap (#current-release / #last-release): let Turbo replace
      // the slot, then flash the FRESH element. burst = a deploy just landed in Last;
      // glow = the Next slot reset. data-glow on the card tints the flash colour.
      if (RELEASE_FX[target] && (action === "replace" || action === "update")) {
        const renderNow = event.detail.render;
        event.detail.render = (el) => {
          renderNow(el);
          const fresh = document.getElementById(target);
          if (fresh) {
            requestAnimationFrame(() => {
              if (RELEASE_FX[target] === "fresh-deploy") {
                if (!freshDeployGlow(fresh)) burst(fresh, true);
              } else {
                glow(fresh);
              }
            });
          }
        };
        return;
      }
      if (!target.startsWith("card-")) return;
      if (action === "remove") {
        const removeNow = event.detail.render;
        event.detail.render = (el) => {
          // A move arrives as one payload: remove old card, then prepend the
          // freshly rendered replacement with the same id. Delaying the remove
          // would let it delete that replacement, so move removes run immediately.
          if (followingStreamCardIds(stream).includes(target)) {
            collapsing.set(target, Promise.resolve());
            removeNow(el);
            setTimeout(() => collapsing.delete(target), 1200);
            return;
          }

          const p = collapseOut(document.getElementById(target), () => removeNow(el), stream.dataset.exitAction);
          collapsing.set(target, p);
          setTimeout(() => collapsing.delete(target), 1200); // not a move if no prepend follows
        };
      } else {
        pendingAction.set(target, action);
        setTimeout(() => pendingAction.delete(target), 1200);
      }
    });

    return { onAdd };
  })();
</script>
