#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/reap-cert-databases — drop the per-run cert test databases a hard-killed run
# stranded, for a periodic or manual sweep (the suite also sweeps on every boot; see
# test/test_helper.rb). It acts ONLY on databases named in a lease WE wrote and whose
# leasing run is provably gone, and it re-proves each name is a per-run TEST database
# before dropping — never mcritchie_studio_development. Full doctrine:
# test/support/cert_database_reaper.rb.
#
# Usage:  bin/reap-cert-databases

require_relative "lib/cli_arg_guard"

USAGE = <<~TXT
  usage: bin/reap-cert-databases

    Drop the per-run cert TEST databases a hard-killed run stranded. Acts only on
    databases named in a lease we wrote whose leasing run is provably gone.

    --help, -h    this text — DROPS NOTHING

  This command takes no arguments.
TXT

# EVERY ARGUMENT IS ACCOUNTED FOR BEFORE ANY DATABASE IS DROPPED.
#
# This script read NO ARGV WHATSOEVER, so every invocation was the same
# invocation: `bin/reap-cert-databases --help` reached line 17 and DROPPED
# DATABASES, exactly as a bare run does. It is the purest form of the defect that
# cost bin/archive-docs a docs ledger on 2026-08-31 — there was not even a wrong
# parse to blame, just an action with no gate in front of it.
#
# The guard runs BEFORE the Rails boot on purpose: a probe should not load an
# environment or open a connection, and `--help` must answer on a machine where
# the test database is not reachable at all.
CliArgGuard.guard!(
  ARGV,
  program: "reap-cert-databases",
  usage: USAGE,
  # No flags and no positionals: anything at all on this line is unaccounted for.
  consequence: "NOTHING was dropped — no database was touched."
)

ENV["RAILS_ENV"] ||= "test"
require_relative "../config/environment"
require_relative "../test/support/cert_database_reaper"

result = CertDatabaseReaper.reap!

puts "reaped:  #{result[:reaped].size}#{" — #{result[:reaped].join(", ")}" unless result[:reaped].empty?}"
puts "skipped: #{result[:skipped].size} (a live run owns them)"
puts "failed:  #{result[:failed].size}#{" — #{result[:failed].join(", ")}" unless result[:failed].empty?} (drop failed; lease kept for retry)" unless result[:failed].empty?
puts "refused: #{result[:refused].size}#{" — #{result[:refused].join(", ")}" unless result[:refused].empty?}" unless result[:refused].empty?
