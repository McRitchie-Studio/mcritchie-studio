<%# CTA button. Pass full_width: true for an edge-to-edge block button. %>
<% full = local_assigns.fetch(:full_width, false) %>
<table role="presentation" <%= "width=\"100%\"".html_safe if full %> cellpadding="0" cellspacing="0" border="0" style="<%= "width:100%;" if full %>">
  <tr>
    <td align="center" bgcolor="<%= color %>" style="border-radius:8px;">
      <a href="<%= url %>" target="_blank" style="display:<%= full ? "block" : "inline-block" %>;padding:14px 26px;font-size:15px;font-weight:700;color:#ffffff;text-decoration:none;border-radius:8px;text-align:center;"><%= label %></a>
    </td>
  </tr>
</table>
