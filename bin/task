#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/task — deterministic CLI for the McRitchie Studio agent task board.
#
# Wraps /api/v1 so agents never hand-roll auth, JSON, or stage transitions.
# Three footguns it removes for you:
#   * `update` does read-merge-write on metadata.devops, so a partial update
#     NEVER wipes existing devops fields. The server merges too now
#     (api-devops-patch-replaces, 2026-08-30 — it used to REPLACE them wholesale,
#     and did destroy a reviewed task's acceptance criteria). This client-side
#     merge stays: it is what makes the PATCH body say what the caller meant, and
#     it keeps this CLI correct against a board that has not taken the fix yet.
#   * list flags are repeatable and sent as arrays, so commas inside individual
#     values are preserved by the task-board API.
#   * unknown flags are REJECTED (exit 1) with a nearest-flag suggestion —
#     a typo'd flag can never silently drop data (`--pr` means `--pr-url`).
#
# Auth: AGENT_API_SECRET from ENV, else the repo .env, else — LAST — 1Password
# (the agent vault's "Agent API Secret/AGENT_API_SECRET). The vault is last
# because its reads are METERED against a 1,000/day account-wide cap and the
# .env holds the same secret for free; see bin/lib/task_board.rb#agent_secret. Base URL via TASK_API_BASE
# (default https://mcritchie.studio).
#
# Usage:
#   bin/task list [--stage S] [--agent A] [--epic E] [--reviewable] [--all] [--json]
#     ( --json prints the full fetched records as an array — the same payload
#       `show --json` prints, for the whole page in ONE board read. )
#   bin/task show <slug> [--json | --verbose|-v]
#     ( default is terse; --json prints the full fetched record as pretty JSON
#       (no token dance); --verbose/-v expands the acceptance BULLETS, agent_context,
#       test_plan, checks_run, claim state, pr_url/local_url, and the top-level
#       `merged` + `release_slug` columns for a human read. )
#     ( `merged` and `release_slug` are TOP-LEVEL Task columns, NOT devops keys:
#       `.metadata.devops.<either>` is null on every task, stamped or not — the
#       server refuses a devops write to both names (Task::DEVOPS_COLUMN_KEYS).
#       --verbose always prints both, and distinguishes empty ("not merged") from a
#       payload that carries no such key at all ("UNREPORTED"). )
#     ( `assignee:` is the agent_slug COLUMN; `builders:` is the AUTHOR SET
#       (metadata.devops.builders + built_by) that bin/reviewer-select excludes.
#       They are DIFFERENT FACTS and disagree routinely — `move <slug> building
#       --actor <soul>` stamps the author and sets no assignee — so an unassigned
#       task reads "unassigned" and an unstamped one reads "NOT STAMPED", never
#       the same "-". --verbose adds the raw fields behind the set. )
#   bin/task orphan-prs [--json]
#     ( READ-ONLY inverse alarm: PRs still OPEN whose task is already ARCHIVED —
#       work that is neither merged nor closed with no board state describing it.
#       One `gh pr list` per repo the archived tasks name, so it stays cheap. A PR
#       carrying an abandonment receipt (devops.abandoned_prs) reports as
#       "abandoned on purpose" rather than orphaned. Never blocks; always exits 0. )
#   bin/task stale [<slug>]
#     ( flags a task whose work is already on origin/main (fixed out-of-band) while
#       the task isn't shipped/archived. Resolves the branch (devops.branch or
#       feat/<slug>), git-fetches, and reports if origin/<branch> is an ancestor of
#       origin/main. With NO slug it scans every open task and lists the stale ones. )
#   bin/task field <slug> <key>              # machine-readable single value (e.g. mascot)
#     ( `merged` and `release_slug` resolve from the COLUMN only — same store as
#       --verbose. Every other key is devops-first with a column fallback. )
#   bin/task create --title T [--slug readable-handle] [--kind K] [--shape S] [--worktree-slug W] [--priority N] [--agent A] \
#   ( --slug sets a readable, immutable Task.slug → /tasks/<slug>; it also seeds
#     worktree_slug + branch (feat/<slug>). Omit it for an opaque task-<hex>. )
#                   [--repo R ...] [--risk R ...] [--accept "..." ...] [--test "..." ...] \
#                   [--checks "..." ...] [--branch B] [--pr-url U] [--pr-url-for repo=U ...] [--local-url U] \
#                   [--approval waiting|approved|changes_requested|none] \
#                   [--po-size S] [--dev-size S] [--pm-size S] [--post-deploy-cmd "rake foo:bar"] [--no-claim] \
#                   [--depends-on task-slug ...] [--epic epic-slug]
#   ( --pr-url-for <repo>=<url> records the PR for ONE repo, repeatable, merging
#     per repo — so a task naming SEVERAL repos can record one PR per repo instead
#     of the single --pr-url slot that used to leave the second repo's PR nowhere
#     to live. --pr-url stays the primary and is folded in automatically, winning
#     for the repo it names. `--pr-url-for <repo>=none` removes one entry.
#     RECORDING ONLY: nothing refuses an incomplete record yet — the sweep's
#     refusal ships with /tasks/merge-promotes-every-repo. )
#   ( --repo and --risk are REPEATABLE and take ONE value each — `--repo a --repo b`.
#     A comma in either is REFUSED: `--repo a,b` used to store the single joined
#     entry "a,b", which reads like the correct pair everywhere and resolves for
#     nobody (it aborted a live QA sweep). The prose flags --accept / --test /
#     --checks are repeatable too but are NOT guarded — a comma is legal there. )
#   ( --shape feeds bin/dor-check: one of the keys in config/feature_shapes.yml )
#   ( --no-claim files the task WITHOUT repointing this session's active-feature
#     marker at it — filing a task is not building it. Use it when a conductor /
#     batch opens follow-up tasks it is not about to build (only an explicit
#     `move building` claims). )
#   ( --po-size/--dev-size/--pm-size set the size trio: small|medium|large|xl.
#     Avi seeds --po-size at creation (the default sizer, not a hard gate);
#     actual_size is auto-derived from measured usage at ship. )
#   ( --checks records devops.checks_run; tag each line by tier, e.g. "[unit] ...".
#     It REPLACES your tier tags (pass every one you want kept) but can NOT drop the
#     control stamp bin/control-check records — a "[control@<fp>]" line is
#     machine-owned and carried forward. Record checks before or after the control;
#     both orders are safe. See lib/cert_evidence.rb. )
#   ( --post-deploy-cmd: the release pipeline runs it on the deployed app after
#     boot — QA on `bin/release prepare`, prod on `ship`. Must be idempotent. )
#   ( --requires-migration / --no-requires-migration: a plain top-level Task
#     flag. SELF-FLAG it the moment you discover the task needs a schema change;
#     the duplicate-migration collision check in dor-check and ship
#     (bin/lib/migration_collision.rb) is the protection. )
#   ( --depends-on <task-slug>: the explicit task-to-task RELEASE ORDER edge, a
#     top-level Task column (tasks.dependencies). Repeatable; this task sorts
#     AFTER every task named here that rides the same release.
#     Release::Ordering.producer_first already puts gems before apps on its own —
#     reach for this only for a sequence the heuristic cannot infer, such as one
#     app that must deploy before another. It REPLACES the list, so pass the whole
#     set in one call; `--depends-on none` clears it. A dependency on a task
#     OUTSIDE the release is fine and simply does not hold this one back, but a
#     slug naming NO task is refused — the ordering pass cannot tell that case
#     from "no dependency", so it would go silently unenforced. )
#   ( --epic <epic-slug>: the epic this task belongs to, a top-level Task column
#     (tasks.epic_slug). The board card wears it as an epic chip beside the task
#     slug, and clicking the chip filters the board to that epic
#     (/tasks?epic=<slug>). Same charset as a task slug, lowercased on the way
#     in; `--epic none` clears it. There is no Epic record to create first — the
#     plan lives with the focus session (devops-v3-design.md §3), and the slug is
#     simply the handle its tasks share. Read it back with
#     `bin/task field <slug> epic_slug`; `show` prints `epic: <slug>` when set. )
#   bin/task begin --title T [--repo APP] [--agent SOUL] [--steal] [same flags as create]
#   bin/task begin <slug> [--agent SOUL] [--dev-size S] [--steal]   # resume a partial begin
#     ( the fast-lane SESSION-START wrapper: create + agent-worktree new +
#       bind-task + move building + session-preflight in ONE command, printing
#       the worktree path, port, and task URL. The slug is derived from the
#       title CLIENT-side and passed explicitly, so rerunning the same begin —
#       or `begin <slug>` — RESUMES after a partial failure instead of minting
#       a duplicate task. Orchestration only: the claim gate, preflight, and
#       every later gate keep their own semantics — a resume of an already-
#       `building` task runs the SAME desk rule the move applies (a foreign live
#       desk with uncommitted changes refuses before any worktree step); --steal
#       overrides it exactly as it does on `move`, and is forwarded to the child
#       `move building` on the fresh path.
#       --agent SOUL works on BOTH forms and must be a soul SLUG (lowercase with
#       single hyphens); on the RESUME form it rides to the claim as --actor, so
#       devops.built_by is stamped even though a resume sets no agent_slug.
#       The desk's git identity follows the same soul: --agent reaches
#       `agent-worktree new --soul`, and after the claim begin reads built_by
#       back and stamps the desk with it when that differs (or says UNSTAMPED
#       when no builder is on record). Never fatal. The
#       resume form takes no OTHER create flag: one is REFUSED, naming
#       `bin/task update <slug>`, never dropped in silence. bin/ship is the
#       handoff twin. )
#   bin/task update <slug> [same flags as create]   # merges into existing devops
#   bin/task move <slug> <stage>                     # designed|building|submitted|reviewed|assembled|shipped|archived
#     ( `blocked` is NOT in that list — it is an ATTRIBUTE of a `building` task,
#       set with `bin/task block <slug>` and cleared by moving on. To LIST blocked
#       work use `bin/task list --stage blocked`, which resolves through the
#       Task.blocked scope rather than the stage column. )
#     [--model M] [--tokens-in N] [--tokens-out N] [--cost D] [--actor A] [--dev-size S] [--steal] [--force]
#     ( --dev-size (small|medium|large|xl) records the builder's own estimate as it
#       claims the task at `building` — optional; absent is fine. )
#     ( best-effort per-transition usage the agent burned in the stage it's
#       leaving — recorded on this move's TaskEvent. With NO usage flags, a
#       Claude/Codex session auto-captures model + token delta + cost from its
#       transcript, so a bare move still leaves a full paper trail; flags
#       override. The from/to/duration spine is recorded server-side regardless. )
#     ( the move to `building` CLAIMS the task. The desk bound to it is the claim —
#       no lease, no renewal. It REFUSES (exit 1, no write) only when a DIFFERENT
#       live session's desk is bound to the task AND has uncommitted changes, and
#       names that desk; --steal overrides that one case. See bin/lib/desk_claim.rb. )
#     ( the move to `archived` is TERMINAL and destroys UNCOMMITTED work no gate,
#       review, or CI would ever surface — so it REFUSES (exit 1, no board write)
#       any task it cannot prove holds NO WORK AT RISK, and NAMES what it could not
#       verify. Work at risk is uncommitted state, which lives in a DESK: a desk
#       being written into, a cert running against one, or an operator parked in
#       front of one. Board activity is already durable and never holds the gate. A
#       record carrying only an app and a mascot names no session to ask, and that
#       is a REFUSAL, not a free task: on 2026-09-01 exactly such a record was
#       resolved only by messaging the peer session. `shipped`/`archived` tasks and
#       tasks nobody ever picked up archive freely. --force is the human decision
#       seam and names the grade it waived. See lib/archive_holder_guard.rb. )
#     ( the move to `archived` ALSO refuses when the task still has an OPEN PR, and
#       names each PR and its state. That is a DIFFERENT question from the holder
#       gate above: the PR is durable and survives the archive, but it survives OPEN
#       and UNWATCHED — neither merged nor closed, with no board state describing it.
#       It reads devops.pr_url AND every devops.pr_urls entry, because a multi-repo
#       task records its second repo's PR only in the map. A PR state that cannot be
#       read WARNS rather than refusing (the GitHub token expires hourly by design),
#       and `bin/task orphan-prs` is where anything that slips through stays
#       findable. --force archives anyway and RECORDS the abandonment in
#       devops.abandoned_prs — every PR it drops, the open ones AND any whose state
#       could not be read — so a later reader can tell a PR that was dropped on
#       purpose from one that was forgotten. `show <slug> --verbose` prints the
#       receipt back. See lib/open_pr_guard.rb. )
#   bin/task merged <slug> <accepted|release|main>
#     ( set the git-location crash-recovery signal (Task::MERGED_STATES) — where the
#       task's code physically is. Review stamps `accepted` when it lands a feat PR
#       on the accepted branch (the ladder's first rung); the sweep/ship stamp
#       release/main. NOT a stage move, NOT event-recorded; read back to confirm it
#       persisted so a dropped stamp never strands the task off every RC. )
#   bin/task fix-forward <slug> --agent <soul>[,<soul>]
#     ( record a REVIEWER FIX-FORWARD (a zap): a soul who pushed a commit onto this
#       task's PR branch WITHOUT holding the build. He is an author of the merged
#       diff, so he joins the author set `bin/reviewer-select` excludes — but he
#       makes no build claim, and the claim is the only thing that stamped it. Named
#       souls join devops.builders (never built_by). )
#   bin/task session-mascot [--persona SLUG|none] [--print]
#     ( draw this Claude/Codex session's Pokémon marker before a task exists.
#       --persona jasper temporarily shows a soul instead; --persona none reverts. )
#   bin/task intent <slug> --to <stage> [--actor SLUG] [--reviewer slug:weight ...]
#     ( records an agentic INTENT — an agent STARTING a stage's work — so the board +
#       timeline show who's on it with a live ticker before the transition lands.
#       --actor for a single owner (Avi QA → assembled, Steffon ship → shipped);
#       repeat --reviewer for the senior pair (the review pair is normally recorded
#       automatically by bin/reviewer-select, which records by default). )
#   bin/task wait-window <slug> [--interval SECONDS] [--grace SECONDS] [--json]
#     ( blocks until the task's OPEN operator window is answered — the `Escalated:`
#       dependency block cleared, or the approval request out of `waiting` — or it
#       lapses. Exit 0 answered · 2 lapsed (the window end + --grace passed with it
#       still open: proceed on the default the design names) · 1 the board could
#       not be read · 3 usage. Reads the task API's DERIVED `windows` list, so the
#       board's clock and config/release_builder.yml decide; nothing here does. )
#   bin/task bounces <slug>
#     ( THE TWO-BOUNCE CIRCUIT BREAKER's read — run it BEFORE a rework block.
#       Counts the task's prior send-backs from its durable qa_feedback activity
#       trail (never the live block columns: a compliant resubmission wipes those,
#       so they read CLEAR exactly when the breaker must fire).
#       Exit: 0 CLEAR — the ONLY exit that authorizes a re-block · 10 TRIPPED
#       (escalate) · any other non-zero = a FAILED read (1) or an unknown slug (4),
#       never a zero. It never prints a count it could not read; the recipe this
#       replaced answered "0" for every task on earth, because it counted rows on
#       an unparsed Net::HTTPResponse, whose #[] reads HTTP HEADERS. )
#   bin/task block <slug> [--kind environment|rework|dependency] [--feedback "..."] [--agent A] [--breaker-ack "reason"]
#     ( marks a `building` ATTRIBUTE: stamps blocked_at/blocked_from/blocked_by/
#       block_kind (no →blocked stage) + posts a qa_feedback activity stamped with
#       the kind, so the bounce ledger stays classifiable after the columns clear.
#       A --kind rework block with NO --feedback still posts one (with a placeholder
#       body + a warning): the columns are wiped on resubmit, so a prose-less bounce
#       would otherwise vanish from every durable store and never be counted. )
#     ( --kind rework is gated by the two-bounce breaker: `bounces` runs and
#       REFUSES (exit 10) when it is tripped, naming the
#       escalation. --breaker-ack "reason" proceeds anyway for a MECHANICAL bounce
#       (red CI, merge conflict — nothing to arbitrate); the reason is recorded on
#       the activity, so an override is evidence, not a bypass. )
#   bin/task note <slug> --handoff "..." | --qa-feedback "..." | --clarification "..." | --comment "..." [--agent A] [--resolves-feedback]
#     ( posts a task activity via POST /api/v1/activities; flags map to
#       activity_type handoff/qa_feedback/clarification/comment. Repeatable +
#       combinable — one activity is posted per flag given. --resolves-feedback
#       marks handoff notes as explicitly addressing open QA feedback; it
#       requires a --handoff note (on other note types it would silently
#       no-op, so the CLI dies instead of dropping the flag). )
#   bin/task usage-audit [--dir PATH]
#     ( READ-ONLY sweep of the usage/cost baseline store (<projects>/.agents/task-usage)
#       for rows a TEST run left behind — a stub slug, or a cache-read total no single
#       task could burn. Those rows price into measured $cost, which derives
#       actual_size and the reviewer-select baselines. Reports only — purging is the
#       operator's call. Exit 2 when suspects are found. )
#   bin/task review-claim acquire <slug> [--label L] [--agent A]
#   bin/task review-claim <release|status|renew> <slug>
#   bin/task claim-next-review [--label L] [--agent A]
#     ( The per-TASK REVIEW lease — how many pr-review sessions run in parallel
#       without two of them reviewing one task (bin/lib/review_claim_cli.rb).
#       `acquire` takes the task you picked; `claim-next-review` asks the BOARD for
#       the next reviewable green-CI task, CLAIMS it, and prints its slug on stdout
#       (`slug=$(bin/task claim-next-review --agent carl)`). Both are WRITES that
#       take a real lease — release what you claim.
#       Exit: 0 claimed · 10 skipped (already under live review) · 4 nothing
#       eligible (claim-next-review) · 1 could not run. )
#   bin/task <cmd> --help | -h                        # print this usage from any position
#
# Unknown flags are rejected (exit 1) with a nearest-flag suggestion; a dashed
# token is never parsed as a slug. That holds for the claim CLIs too: --help/-h
# there prints usage and CLAIMS NOTHING, and an argument they cannot account for
# refuses instead of running the pop (a `claim-next-review --help` probe once took
# a live review lease on a real task).
#
# Exit codes are a CONTRACT (bin/agent-worktree's reclaim guard classifies on
# them — a destroy path):
#   0  success
#   4  EXIT_TASK_NOT_FOUND — the board POSITIVELY answered "there is no such
#      task" (HTTP 404 + the API's own "task not found" body). Never fired on a
#      failed read: a Heroku router 404, a route-level 404, a 5xx, or a rejected
#      flag all stay on 1, because the guard FREES a worktree on this code.
#  10  REFUSED — the two-bounce circuit breaker refused `bounces` / `block --kind rework` (escalate, do not
#      retry). Distinct from 1 so "the breaker says escalate" is never confused
#      with "the read failed".
#   1  everything else — transport/API failures, usage errors, rejected flags.

require "net/http"
require "json"
require "uri"
require "time"
require "fileutils"
require "shellwords"
require "rbconfig"
require_relative "../lib/agent_session_usage"
require_relative "../lib/task_usage_baseline"
require_relative "../lib/task_usage_sandbox"
require_relative "../lib/task_usage_audit"
