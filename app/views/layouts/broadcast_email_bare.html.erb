<!DOCTYPE html>
<%# The full-bleed email shell (task cyvasse-four-prong-emails): no McRitchie
    Studio band, title band or padding, so a designed template owns the whole
    600px column. A template composes it from broadcasts/blocks/*; another app
    reuses the same blocks with its own colours and images. :email_page_bg
    sets the colour around the column. %>
<% page_bg = content_for?(:email_page_bg) ? yield(:email_page_bg) : "#0d0a26" %>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <meta name="x-apple-disable-message-reformatting">
  <title><%= content_for?(:email_title) ? strip_tags(yield(:email_title)) : "Cyvasse" %></title>
  <!--[if mso]>
  <style>table,td,div,h1,h2,p,a{font-family:Arial,Helvetica,sans-serif !important;}</style>
  <![endif]-->
</head>
<body style="margin:0;padding:0;background-color:<%= page_bg %>;-webkit-font-smoothing:antialiased;">
  <div style="display:none;max-height:0;overflow:hidden;mso-hide:all;font-size:1px;line-height:1px;color:<%= page_bg %>;opacity:0;">
    <%= yield :preheader %>
  </div>
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:<%= page_bg %>;">
    <tr>
      <td align="center" style="padding:0;">
        <!--[if mso]><table role="presentation" width="600" cellpadding="0" cellspacing="0" border="0"><tr><td><![endif]-->
        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px;font-family:Arial,Helvetica,sans-serif;">
          <%= yield %>
          <%= render "broadcasts/blocks/footer" %>
          <% if @open_pixel_url %>
          <tr><td style="font-size:0;line-height:0;height:0;"><img src="<%= @open_pixel_url %>" width="1" height="1" alt="" style="display:block;width:1px;height:1px;border:0;"></td></tr>
          <% end %>
        </table>
        <!--[if mso]></td></tr></table><![endif]-->
      </td>
    </tr>
  </table>
</body>
</html>
