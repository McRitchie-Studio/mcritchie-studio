# McRitchie Studio — environment variables
# Copy to .env and fill in. See docs/agents/modules/credentials.md and
# docs/agents/modules/credential-inventory.md for current 1Password item names.

# ───── Required to boot ─────
RAILS_MASTER_KEY=                 # heroku config:get RAILS_MASTER_KEY --app mcritchie-studio
SECRET_KEY_BASE=                  # prod session + magic-link MessageVerifier signing (app-scoped token name)

# ───── Google OAuth (login + admin gear) ─────
GOOGLE_CLIENT_ID=                 # Google Cloud Console — OAuth client
GOOGLE_CLIENT_SECRET=

# ───── Google Workspace service account (Drive + Gmail drafts, never sends) ─────
# The JSON key; wins over the 1Password read. docs/agents/modules/credential-inventory.md
GOOGLE_SERVICE_ACCOUNT_JSON=

# ───── Passwordless email (magic-link) ─────
# Target: AWS SES. Resend remains the active fallback while SES production
# access is pending; do not force MAIL_TRANSPORT=ses on production while the
# SES account is sandboxed.
# SES credentials: 1Password item `agent.aws.mcritchie-ses` (agents vault).
MAIL_TRANSPORT=ses                # ses | resend. Leave unset/use resend until SES production access is approved.
SES_REGION=us-east-2
SES_SMTP_USERNAME=
SES_SMTP_PASSWORD=
SES_SMTP_HOST=                    # optional; defaults to email-smtp.${SES_REGION}.amazonaws.com
SES_SMTP_PORT=587
RESEND_API_KEY=                   # outbound rollback + desk inbound ingest (fetches received mail)
MAILER_FROM="McRitchie Studio <team@mcritchie.studio>"
MARKETING_MAILER_FROM="Alex McRitchie <alex@mcritchie.studio>"
RESEND_MAILER_FROM="McRitchie Studio <team@mcritchie.studio>"

# ───── Claude API (AI chat, News refine/conclude agents, Content metadata) ─────
ANTHROPIC_API_KEY=                # 1Password: "anthropic" — NOT FILED in any readable vault
                                  # (credential-inventory.md); get it from console.anthropic.com

# ───── X / Twitter API ─────
# Read-only (News intake from @AdamSchefter tweets)
X_BEARER_TOKEN=                   # 1Password: "agent.turf.x" in studio-agents vault (Bearer Token field)

# Read+Write (Starter Post X workflow — posting from @turfmonstershow)
# IMPORTANT: must be from an X app with "Read and Write" permissions
X_API_KEY=                        # 1Password: "agent.turf.x" — the Consumer Key field
X_API_SECRET=                     # the same item — Consumer Key Secret
X_ACCESS_TOKEN=                   # the same item — Access Token
X_ACCESS_TOKEN_SECRET=            # the same item — Access Token Secret

# ───── Higgsfield (image/video generation: Nano Banana + Kling 3) ─────
# ONE 1Password field, `api-key`, holds BOTH halves joined by a colon:
# <KEY_ID>:<KEY_SECRET>. Split on the FIRST colon — before it goes in the key,
# after it in the secret. The console showing no separate secret field is
# correct, not a missing value: Higgsfield hands the pair over pre-joined.
HIGGSFIELD_API_KEY=               # 1Password: "higgsfield.studio.agents" in studio-agents vault
HIGGSFIELD_API_SECRET=            # the same item — the half after the first colon

# ───── OpenAI (character-sheet generation: the Responses image tool) ─────
# THE SHEET GENERATOR. One cached headshot in, a whole multi-panel character sheet
# out, with the likeness holding across every panel.
#
# ⚠ THE ENDPOINT IS THE FINDING, AND THE OBVIOUS ONE IS WRONG. This uses
# POST /v1/responses with `tools: [{type: image_generation}]`. Do NOT use
# /v1/images/edits: measured on the same reference and the same prompt it lost
# identity even on a SINGLE portrait, and five reference photos were no better.
# That endpoint EDITS a picture; the Responses tool LOOKS, reasons, then generates.
#
# OPTIONAL, AND ITS ABSENCE IS A SUPPORTED STATE. Unset, the character-model page
# renders normally and names this variable as the thing that turns generation on.
#
# WHICH MODEL IT REACHES IS NOT SPELLED HERE — config/image_generators.yml pins the
# dated snapshot, because an alias that rolls forward is not deterministic.
#
# A ChatGPT subscription does NOT include API access.
OPENAI_API_KEY=                   # 1Password: "openai.studio.applications" in studio-applications vault
                                  # (also on Heroku config for mcritchie-studio since v499)

# ───── fal.ai (zero-shot identity generation: one headshot, no training) ─────
# ONE variable, and it already carries both halves: <KEY_ID>:<KEY_SECRET>, 69
# characters, sent whole as `Authorization: Key <FAL_KEY>`. Do NOT split it the
# way HIGGSFIELD_API_KEY above is split — fal takes the joined pair as one value.
#
# OPTIONAL, AND ITS ABSENCE IS A SUPPORTED STATE. With this unset the character
# model page renders normally and says which generator is switched off and which
# variable turns it on; no error, no blank page, no Generate button.
#
# WHICH MODEL IT REACHES IS NOT SPELLED HERE. config/image_generators.yml holds
# the registry — endpoint, pinned version, capabilities and this variable's name
# — so swapping generators is an edit to that file, not to any code or to this one.
#
# ⚠ `POST https://queue.fal.run/<model>` SUBMITS BILLABLE WORK on any body at
# all, including an empty one. Probe this credential with the GET status endpoint:
# a real key answers 404 for an unknown request id, a bogus key answers 401.
FAL_KEY=                          # 1Password: "fal.studio.applications" in studio-applications vault
                                  # (also on Heroku config for mcritchie-studio)

# ───── Image search (reference photos for a character model) ─────
# OPTIONAL, AND ITS ABSENCE IS A SUPPORTED STATE. With this unset the character
# model page (/people/:person/models/:slug) renders from the cached ESPN headshot
# plus whatever reference URL the operator typed — no error, no blank page, no
# Search button. Set it and the button appears. See docs/topics/content-pipeline.md
# (Character identity) for what the search then does with the results.
SERPER_API_KEY=                   # 1Password: "serper.studio.agents" — NOT FILED in any readable vault
                                  # (credential-inventory.md); get it from serper.dev

# ───── TikTok Content Posting API (Starter Post TikTok workflows) ─────
# App is in review (submitted 2026-05-04). Sandbox mode works for app owner only.
TIKTOK_CLIENT_KEY=                # 1Password: "🐊 TikTok" — NOT FILED in any readable vault
                                  # (credential-inventory.md); get it from the TikTok developer console
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=             # From /admin/tiktok/connect handshake — see docs/topics/content-pipeline.md
TIKTOK_OPEN_ID=

# ───── AWS S3 (ImageCache via studio engine) ─────
# Bucket: mcritchie-studio-{dev,production}
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Desk capture (team@mcritchie.studio → Resend inbound → private bucket → /admin/desk).
# Senders outside the allowlist are quarantined: raw kept, attachments sealed.
DESK_ALLOWED_SENDERS=amcritchie@gmail.com,alex@mcritchie.studio
DESK_CAPTURE_BUCKET=mcritchie-studio-desk
DESK_CAPTURE_REGION=us-east-1
# Svix signing secret for the Resend email.received webhook (whsec_...).
RESEND_WEBHOOK_SECRET=
