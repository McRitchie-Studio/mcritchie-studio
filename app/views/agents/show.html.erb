<section>
  <div class="mb-6 flex items-center gap-4">
    <%= link_to "&larr; All Agents".html_safe, agents_path, class: "text-secondary hover:text-heading text-sm transition" %>
    <%= link_to "Deployments", deployments_path, class: "text-secondary hover:text-heading text-sm transition", data: { test: "agent-nav-deployments" } %>
  </div>

  <!-- Agent Header -->
  <div class="card p-6 mb-6">
    <div class="flex items-center gap-4 mb-4">
      <%= render "components/agent_avatar", agent: @agent, size: "lg" %>
      <div>
        <h2 class="text-2xl font-bold text-heading"><%= @agent.name %></h2>
        <p class="text-secondary"><%= @agent.title %></p>
        <div class="flex items-center gap-2 mt-1">
          <%= render "components/agent_status", agent: @agent %>
          <span class="text-xs text-muted">|</span>
          <span class="text-xs text-muted"><%= @agent.agent_type %></span>
        </div>
      </div>
    </div>
    <% if @agent.description.present? %>
      <p class="text-body text-sm"><%= @agent.description %></p>
    <% end %>
  </div>

  <%# HEARTBEAT — only renders for souls that own one (Avi / Steffon / Alex). %>
  <%= render "agents/heartbeat_section", agent: @agent %>

  <% if @agent_doc_tree.any? %>
    <section class="card p-6 mb-6" data-test="agent-file-tree" data-agent="<%= @agent.slug %>">
      <div class="mb-4">
        <h3 class="text-lg font-bold text-heading">Files</h3>
      </div>
      <div class="rounded-md border border-subtle bg-inset py-2 font-mono text-sm">
        <% @agent_doc_tree.each do |node| %>
          <div class="flex min-h-8 items-center gap-2 px-3 text-secondary" style="padding-left: <%= 0.75 + (node[:depth] * 1.25) %>rem" data-test="agent-file-tree-node" data-path="<%= node[:path] %>" data-kind="<%= node[:directory] ? "directory" : "file" %>">
            <span class="w-4 text-center text-muted" aria-hidden="true"><%= node[:directory] ? "▸" : "•" %></span>
            <% if node[:markdown] %>
              <%= link_to node[:name],
                          doc_path(node[:doc_path]),
                          class: "text-primary hover:text-heading transition",
                          data: { test: "agent-file-tree-link", path: node[:doc_path] } %>
            <% else %>
              <span><%= node[:name] %></span>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Skills -->
    <div>
      <h3 class="text-lg font-bold text-heading mb-3">Skills</h3>
      <% if @skills.any? %>
        <div class="space-y-2">
          <% @skills.each do |skill| %>
            <div class="card p-3">
              <p class="text-heading text-sm font-medium"><%= skill.name %></p>
              <p class="text-muted text-xs"><%= skill.category %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted text-sm">No skills assigned.</p>
      <% end %>
    </div>

    <!-- Tasks -->
    <div>
      <h3 class="text-lg font-bold text-heading mb-3">Recent Tasks</h3>
      <% if @tasks.any? %>
        <div class="space-y-2">
          <% @tasks.each do |task| %>
            <%= link_to task_path(task.slug), class: "block card p-3 hover:border-primary/30 transition" do %>
              <p class="text-heading text-sm font-medium truncate"><%= task.title %></p>
              <div class="flex items-center gap-2 mt-1">
                <%= render "components/badge", text: task.stage.humanize, scheme: stage_scheme(task.stage) %>
              </div>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted text-sm">No tasks yet.</p>
      <% end %>
    </div>

    <!-- Activity -->
    <div>
      <h3 class="text-lg font-bold text-heading mb-3">Recent Activity</h3>
      <% if @activities.any? %>
        <div class="space-y-2">
          <% @activities.each do |activity| %>
            <div class="card p-3">
              <div class="flex items-center gap-2">
                <%= render "components/badge", text: activity.activity_type, scheme: "violet" %>
                <span class="text-xs text-muted"><%= time_ago_in_words(activity.created_at) %> ago</span>
              </div>
              <p class="text-body text-sm mt-1"><%= activity.description %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted text-sm">No activity yet.</p>
      <% end %>
    </div>
  </div>
</section>
