<%# Shared meta row + member pills for the Current and Last release modules.
    Locals:
      release  the Release to render (required)
      variant  :current (full-color, active) or :last (dimmed/muted history)
    The two modules were ~90 percent identical; only the colors, the section
    label, and the timestamp branch differ, all driven off the variant below. %>
<% rel = local_assigns.fetch(:release) %>
<% variant = local_assigns.fetch(:variant) %>
<% current = variant == :current %>
<% members = rel.tasks.order(:position).to_a %>
<% label_text = current ? "Next Release" : "Last Release" %>
<% slug_class = current ? "text-sm text-heading" : "text-sm text-muted" %>
<% meta_color = current ? "text-secondary" : "text-muted" %>
<% link_class = current ? "text-primary hover:underline" : "text-secondary hover:underline" %>
<% pill_class = current ? "px-2 py-1 rounded bg-inset text-xs text-body hover:text-heading flex items-center gap-1.5 border border-subtle" : "px-2 py-1 rounded bg-inset text-xs text-muted hover:text-body flex items-center gap-1.5 border border-subtle" %>
<% stacked_pill_class = "relative shrink-0 min-w-28 max-w-[15rem] overflow-hidden whitespace-nowrap hover:z-50 focus:z-50 focus:outline-none focus:ring-2 focus:ring-primary/60" %>
<%# Optional trailing content rendered to the right of the member-pills row
    (e.g. the QA-release kickoff chip on the Current card). %>
<% trailing = local_assigns.fetch(:trailing, nil) %>
<%# Top row: section label + slug/branch on the left; the consolidated status badge
    pinned to the card's top-right corner on the right (items-start keeps it aligned
    to the first line even when the slug group wraps). %>
<div class="flex items-start justify-between gap-3">
      <div class="flex items-center gap-3 flex-wrap min-w-0">
        <span class="text-[11px] uppercase tracking-wide text-muted font-semibold"><%= label_text %></span>
        <code class="<%= slug_class %>"><%= rel.slug %></code>
      </div>
      <%# Top-right badges: the post-ship production smoke SEAL (🟢/🔴, only once a
          seal exists — i.e. on a shipped release) sits left of the consolidated
          status badge. Plain server-rendered pills in a gap-2 flex (no Alpine
          x-show, no own margins) so they never fight LiveBoardFx or the grid. %>
      <div class="flex shrink-0 items-center gap-2">
        <% if (seal = rel.smoke_seal) %>
          <span class="shrink-0 px-2 py-0.5 rounded text-xs font-bold <%= release_smoke_seal_classes(seal) %>" data-test="release-smoke-seal-badge" data-seal-status="<%= seal.status %>" title="<%= release_smoke_seal_title(seal) %>"><%= seal.badge %> Seal</span>
        <% end %>
        <%# Consolidated status badge: one state-colored pill folding the bare state + its
            relative time into "Shipped 7 minutes ago" — replaces the former left-side
            state pill AND the separate muted "shipped X ago" line. %>
        <span class="px-2 py-0.5 rounded text-xs font-bold <%= release_state_classes(rel.state) %>" data-test="release-state-badge"><%= release_state_label(rel, current: current) %></span>
      </div>
    </div>
    <%# Conductor mascot row — the Pokémon of the SESSION running bin/release (the
        agent working this deployment), plus how long it has taken: "in progress ·
        23m" while active, "took 18m" once shipped. Mirrors the per-task mascot
        chip. Omitted entirely when there is no mascot and no timing. %>
    <% mascot = rel.mascot %>
    <%# Active release ticks LIVE down to the second ("in progress · 7m 23s") so the
        operator watches the clock climb — data-since drives the _release_ticker JS,
        and the server-rendered value avoids a flash before the first tick. A shipped
        release shows the frozen "took Xm" (no tick). %>
    <% ticking = rel.active? && rel.created_at.present? %>
    <% static_timing = ticking ? nil : release_timing_label(rel) %>
    <% if mascot || ticking || static_timing %>
      <div class="mt-2 flex items-center gap-2 text-xs <%= meta_color %>" data-test="release-mascot-row">
        <% if mascot %>
          <span class="flex items-center gap-1.5 min-w-0" data-test="release-mascot" title="Conductor: <%= mascot.name %>">
            <% if mascot.sprite_url.present? %>
              <img src="<%= mascot.sprite_url %>" alt="<%= mascot.name %>" width="24" height="24" loading="lazy" class="w-6 h-6 shrink-0" style="image-rendering: pixelated;">
            <% end %>
            <span class="font-medium truncate" style="<%= "color: #{mascot.signature_color};" if mascot.signature_color.present? %>"><%= mascot.name %></span>
          </span>
        <% end %>
        <% if ticking %>
          <span class="shrink-0 tabular-nums" data-test="release-timing" data-release-ticker data-since="<%= rel.created_at.to_i %>" data-prefix="in progress · ">in progress · <%= release_elapsed_clock(rel) %></span>
        <% elsif static_timing %>
          <span class="shrink-0" data-test="release-timing"><%= static_timing %></span>
        <% end %>
      </div>
    <% end %>
    <%# Second row: release meta — task count, QA/Prod links, deployed SHA. %>
    <div class="mt-1 flex items-center gap-4 text-xs <%= meta_color %> flex-wrap">
        <span><%= members.size %> task<%= "s" unless members.size == 1 %></span>
        <% if rel.qa_url.present? %><%= link_to "QA ↗", rel.qa_url, target: "_blank", rel: "noopener", class: link_class %><% end %>
        <% if rel.production_url.present? %><%= link_to "Prod ↗", rel.production_url, target: "_blank", rel: "noopener", class: link_class %><% end %>
        <% if rel.deployed_sha.present? %><code class="text-muted" title="deployed SHA"><%= rel.deployed_sha.first(7) %></code><% end %>
      </div>
    <% if members.any? || trailing %>
      <%# Member pills on the left; optional trailing chip (e.g. the kickoff chip)
          inline on the right of the same row. Last Release pills stay on one
          overlapping row so compact release cards expose each task's left edge;
          Current Release shows two primary tasks and summarizes the rest by repo. %>
      <div class="mt-3 flex items-start justify-between gap-3 flex-wrap" data-test="release-members-row">
        <% if current %>
          <% summary = release_member_condensed_summary(members) %>
          <div class="flex flex-wrap items-center gap-2 gap-x-2 gap-y-2 min-w-0" data-test="release-member-list">
            <% summary[:highlights].each do |t| %>
              <% cost_label = release_member_cost_label(t) %>
              <%= link_to task_path(t.slug),
                          class: [pill_class, "w-56 shrink-0 overflow-hidden"].join(" "),
                          style: "",
                          data: { test: "release-member-pill", release_member: "highlight" },
                          title: t.title do %>
                <%= app_emoji_badge(t.devops_repositories) %>
                <span class="min-w-0 flex-1 overflow-hidden whitespace-nowrap" style="<%= right_fade_style(stop: 76) %>"><%= t.title %></span>
                <% if cost_label.present? %>
                  <span class="ml-auto shrink-0 rounded-sm border border-subtle bg-surface/70 px-1.5 py-0.5 text-[10px] font-semibold leading-none text-muted tabular-nums" data-test="release-member-cost" title="<%= release_member_cost_title(t) %>"><%= cost_label %></span>
                <% end %>
              <% end %>
            <% end %>
            <% summary[:repo_counts].each do |entry| %>
              <span class="shrink-0 text-xs text-muted tabular-nums" data-test="release-member-repo-count" title="<%= entry[:repositories].join(", ") %>">· <span class="leading-none"><%= entry[:emoji] %></span> <%= entry[:count] %></span>
            <% end %>
          </div>
        <% else %>
          <div class="isolate flex min-w-0 max-w-full flex-nowrap overflow-hidden pr-2" data-test="release-member-stack">
            <% members.each_with_index do |t, index| %>
              <% overlap_class = index.positive? ? "-ml-20 border-l" : "" %>
              <% overlap_style = if index.positive?
                   [
                     "box-shadow: -10px 0 14px -12px color-mix(in srgb, var(--color-text) 70%, transparent);",
                     "border-left-color: color-mix(in srgb, var(--color-text) 28%, var(--color-border));"
                   ].join(" ")
                 end %>
              <%= link_to task_path(t.slug),
                          class: [pill_class, stacked_pill_class, overlap_class].reject(&:blank?).join(" "),
                          style: ["z-index: #{index + 1};", overlap_style].compact.join(" "),
                          data: { test: "release-member-pill" } do %>
                <%= app_emoji_badge(t.devops_repositories) %>
                <span class="min-w-0 truncate"><%= truncate(t.title, length: 42) %></span>
              <% end %>
            <% end %>
          </div>
        <% end %>
        <% if trailing %><div class="shrink-0"><%= trailing %></div><% end %>
      </div>
    <% end %>
    <% if current %>
      <div class="mt-4 pt-3 border-t border-subtle/70" data-test="release-tracker" aria-label="Release progress">
        <%= render "tasks/release_tracker", release: rel %>
      </div>
    <% end %>
    <%# G3 candidate suite CI meters (Next Release card only): ONE track PER MEMBER
        REPO — a release spanning turf-monster + mcritchie-studio shows two, plus a
        gem member a third. Each reads that repo's own release-candidate CI (app repos
        on the `release` tip, gem repos on their `main` suite). Each track is wrapped in
        the stable-id components/_ci_progress_slot on a PER-REPO #dom_id
        (release-ci-progress-<repo>) so a live workflow_job for that repo morphs JUST
        its bar; a repo with no CI run yet renders an empty, zero-height slot the
        broadcaster can fill in place. Sits directly below the pizza tracker so the
        release-progress column reads top-down: member chips, then the stage tracker,
        then its per-app candidate-suite CI. %>
    <% if current %>
      <% release_ci_progress(rel).each do |repo, progress| %>
        <%= render "components/ci_progress_slot",
              dom_id: "release-ci-progress-#{repo}",
              progress: progress,
              label: release_ci_track_label(repo), test_id: "release-ci-progress-#{repo}",
              wrapper_class: "mt-2", inner_test_id: "release-card-ci-progress-#{repo}" %>
      <% end %>
    <% end %>
