<%# 2 · Map Stage — the map IS the footer; the facts float over it on glass. %>
<footer class="ftr relative bg-page border-t border-subtle text-body" data-footer="map-stage">
  <div class="relative md:h-[30rem]">
    <%= render "footers/map", facts: facts, zoom: 16, classes: "h-64 md:h-auto md:absolute md:inset-0" %>
    <div class="ftr-stage-veil hidden md:block absolute inset-0 pointer-events-none z-10"></div>

    <div class="relative z-20 max-w-7xl mx-auto px-4 md:h-full flex items-center pointer-events-none">
      <div class="ftr-glass pointer-events-auto rounded-2xl p-6 sm:p-8 w-full md:max-w-md -mt-10 md:mt-0 mb-8 md:mb-0">
        <p class="ftr-eyebrow text-primary mb-2"><%= facts[:neighborhood] %></p>
        <h2 class="text-3xl font-extrabold text-heading tracking-tight">Come find us.</h2>
        <address class="not-italic mt-4 text-lg text-heading font-semibold leading-snug">
          <%= facts[:street] %><br><%= facts[:city_line] %>
        </address>
        <p class="text-muted text-sm mt-1"><%= facts[:hours] %></p>

        <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3">
          <a href="<%= facts[:phone_href] %>" class="btn btn-neutral justify-center">📞 <%= facts[:phone] %></a>
          <a href="<%= facts[:directions_url] %>" target="_blank" rel="noopener" class="btn btn-primary justify-center">Directions →</a>
        </div>
        <p class="mt-4 text-sm"><a href="mailto:<%= facts[:email] %>" class="ftr-link"><%= facts[:email] %></a></p>
      </div>
    </div>
  </div>

  <div class="relative z-20 bg-surface-alt border-t border-subtle">
    <div class="max-w-7xl mx-auto px-4 py-5 flex flex-col lg:flex-row items-center justify-between gap-4 text-sm">
      <%= link_to root_path, class: "inline-flex items-center gap-2" do %>
        <%= image_tag "logo-icon.svg", class: "w-5 h-5 invert dark:invert-0", alt: "" %>
        <span class="font-extrabold text-heading">McRitchie <span class="text-primary">Studio</span></span>
      <% end %>
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <% (facts[:explore] + facts[:legal]).each do |label, path| %>
          <li><%= link_to label, path, class: "ftr-link" %></li>
        <% end %>
      </ul>
      <p class="text-muted">© <%= Time.current.year %> <%= facts[:name] %></p>
    </div>
  </div>
</footer>
