<%# One character on the cast list: avatar, name, kind, brand, number of looks.
    Locals: character, avatar_url (or nil), look_count. %>
<%= link_to character_path(character), class: "card p-4 flex items-center gap-4 hover:border-primary min-w-0",
            data: { test: "cast-card", character: character.slug } do %>
  <div class="w-20 h-20 shrink-0 rounded-lg bg-surface-alt border border-subtle flex items-center justify-center overflow-hidden">
    <% if avatar_url.present? %>
      <img src="<%= avatar_url %>" alt="<%= character.name %>" class="max-h-full max-w-full object-contain" loading="lazy" data-test="cast-avatar">
    <% else %>
      <span class="text-2xl font-bold text-muted" aria-hidden="true"><%= character.name.first %></span>
    <% end %>
  </div>
  <div class="min-w-0 space-y-1">
    <h2 class="text-base font-bold text-heading truncate" data-test="cast-name"><%= character.name %></h2>
    <div class="flex flex-wrap gap-1.5">
      <span class="badge text-3xs bg-primary/10 text-primary border-primary/40" data-test="cast-kind"><%= character.kind %></span>
      <% if character.brand.present? %>
        <span class="badge text-3xs bg-surface-alt text-muted border-subtle" data-test="cast-brand"><%= character.brand %></span>
      <% end %>
    </div>
    <p class="text-2xs text-muted" data-test="cast-looks"><%= pluralize(look_count, "look") %></p>
  </div>
<% end %>
