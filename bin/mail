#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/mail — THE way an agent reads a desk item or a Gmail thread, with its
# attachments, and checks the team@ inbound path. One `heroku run` per call;
# the organize verbs change a mailbox whose owner turned on
# Gmail organize (/integrations), dry unless --apply; every other verb is a read. The logic is in bin/lib/mail_cli.rb (local half) and
# app/services/mail_export.rb (the dyno half).
#
#   bin/mail desk [--since 7d]
#   bin/mail desk <id> [--save [DIR]]
#   bin/mail thread '<gmail query>' [--mailbox alex@mcritchie.studio] [--save [DIR]]
#   bin/mail doctor
#   bin/mail organize ACTION '<gmail query>' --mailbox ADDR [--label NAME] [--apply]
#   bin/mail filter '<gmail query>' --mailbox ADDR [--label NAME] [--archive] [--mark-read] [--apply]
#   bin/mail unsubscribe '<gmail query>' --mailbox ADDR [--limit N] [--apply]
#   bin/mail labels|filters --mailbox ADDR
#
# Exit: 0 ok · 1 the run failed, or doctor found a problem · 2 usage.
# An unknown flag raises OptionParser::InvalidOption before anything runs.

require "optparse"
require_relative "lib/mail_cli"

verb = ARGV.shift
if verb.nil? || %w[-h --help help].include?(verb)
  puts MailCli::USAGE
  exit(verb.nil? ? 2 : 0)
end

opts = MailCli.default_options
OptionParser.new do |o|
  o.banner = MailCli::USAGE
  o.on("--since SPAN", "desk list window: <n>m|h|d|w (default 7d)") { |v| opts[:since] = v }
  o.on("--save [DIR]", "write files to DIR (default $TMPDIR/mail/<item>)") { |v| opts[:save] = v || :default }
  o.on("--mailbox ADDR", "thread: the mailbox to read (default #{MailCli::DEFAULT_MAILBOX}); organize verbs: required") do |v|
    opts[:mailbox] = v
    opts[:mailbox_given] = true
  end
  o.on("--label NAME", "organize/filter: the label to add, remove or move to") { |v| opts[:label] = v }
  o.on("--limit N", Integer, "organize: the most messages one run changes (default 50000); unsubscribe: messages read (default 500)") { |v| opts[:limit] = v }
  o.on("--apply", "organize/filter/unsubscribe: make the change (without it, a dry run)") { opts[:apply] = true }
  o.on("--archive", "filter: skip the inbox") { opts[:archive] = true }
  o.on("--mark-read", "filter: mark read") { opts[:mark_read] = true }
  o.on("--by NAME", "organize/filter/unsubscribe: who asked, for the change log") { |v| opts[:by] = v }
  o.on("--app NAME", "Heroku app (default #{MailCli::DEFAULT_APP})") { |v| opts[:app] = v }
  o.on("--local", "run bin/rails runner in this checkout instead of heroku") { opts[:local] = true }
  o.on("-h", "--help") do
    puts o
    exit 0
  end
end.parse!(ARGV)

exit MailCli.run(verb, ARGV, opts)
