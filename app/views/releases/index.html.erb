<div class="max-w-7xl mx-auto px-4 py-6">
  <%# Both controls are pages elsewhere: the Links menu (docs/PAGE_HEADER.md, "The four
      kinds of control"). Model is the model-page protocol (studio-engine): an admin-only
      jump to the newest release's model page. %>
  <% header_menu = [{ label: "Deployments dashboard", href: deployments_path, data: { test: "releases-link-dashboard" } }] %>
  <% if admin? && @latest_release %>
    <% header_menu << { label: "Model", href: studio_model_path("release", @latest_release.slug), data: { test: "releases-link-model" } } %>
  <% end %>
  <%= render "studio/page_header", title: "All Deployments", crumbs: studio_crumbs(:all_deployments),
        menu: header_menu %>
  <div class="mb-6"></div>

  <% stage_averages = @deployment_dashboard["stages"] || {} %>
  <div class="grid grid-cols-2 md:grid-cols-5 gap-3 mb-6">
    <% stage_averages.each do |_key, row| %>
      <div class="rounded-lg border border-subtle bg-surface px-3 py-3">
        <p class="text-3xs uppercase tracking-wide text-muted font-semibold"><%= row["label"] %></p>
        <p class="mt-1 font-mono text-xl font-bold text-heading tabular-nums"><%= release_duration_label(row["average_seconds"]) %></p>
        <p class="mt-1 text-2xs text-muted"><%= row["sample_count"].to_i %> release<%= "s" unless row["sample_count"].to_i == 1 %></p>
      </div>
    <% end %>
  </div>

  <% chart_max = @deployment_average_rows.flat_map { |avg| Release::DEPLOYMENT_STAGES.map { |stage| avg[:averages].dig("stages", stage[:key], "average_seconds").to_i } }.max.to_i %>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
    <% @deployment_average_rows.each do |avg| %>
      <%= render "releases/deployment_average_chart", averages: avg[:averages], label: avg[:label], max_seconds: chart_max %>
    <% end %>
  </div>

  <div class="overflow-x-auto rounded-lg border border-subtle bg-surface">
    <table class="min-w-full text-sm">
      <thead class="bg-surface-alt text-left text-xs uppercase tracking-wide text-muted">
        <tr>
          <th class="px-4 py-3 font-semibold">Release</th>
          <th class="px-4 py-3 font-semibold">State</th>
          <% Release::DEPLOYMENT_STAGES.each do |stage| %>
            <th class="px-4 py-3 font-semibold text-left"><%= stage[:label] %></th>
          <% end %>
          <th class="px-4 py-3 font-semibold text-right">Total</th>
          <th class="px-4 py-3 font-semibold text-right">Tasks</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-subtle">
        <% @releases.each_with_index do |release, index| %>
          <tr class="hover:bg-surface-alt/70">
            <td class="px-4 py-3 align-top">
              <%= link_to release.slug, deployment_path(release), class: "font-mono text-primary hover:underline" %>
            </td>
            <td class="px-4 py-3 align-top">
              <span class="rounded px-2 py-0.5 text-xs font-bold <%= release_state_classes(release.state) %>"><%= release.state %></span>
            </td>
            <% release.deployment_stage_spans.each do |span| %>
              <td class="px-4 py-3 text-left align-top"><%= render "releases/deployment_stage_cell", span: span %></td>
            <% end %>
            <td class="px-4 py-3 text-right align-top"><%= render "releases/deployment_stage_cell", span: release.deployment_total_span, range: false %></td>
            <td class="px-4 py-3 text-right align-top text-secondary"><%= release.tasks.size %></td>
          </tr>
          <% if @release_page == 1 %>
            <% @deployment_average_rows.select { |avg| avg[:after_index] == index }.each do |avg| %>
              <%= render "releases/deployment_average_row", averages: avg[:averages], label: avg[:label] %>
            <% end %>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>

  <%= render "tasks/release_ticker" %>
  <%= render "releases/deployment_range_script" %>

  <div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm text-muted">
    <p>
      <% if @release_count.positive? %>
        Showing <%= number_with_delimiter(@release_offset + 1) %>-<%= number_with_delimiter([@release_offset + @releases.size, @release_count].min) %>
        of <%= number_with_delimiter(@release_count) %>
      <% else %>
        No deployments
      <% end %>
    </p>
    <% if @release_total_pages > 1 %>
      <nav class="flex items-center gap-2" aria-label="Deployment pages">
        <% if @release_page > 1 %>
          <%= link_to "Previous", all_deployments_path(page: @release_page - 1), class: "btn btn-neutral btn-sm" %>
        <% else %>
          <span class="btn btn-neutral btn-sm opacity-40 pointer-events-none">Previous</span>
        <% end %>
        <span class="font-mono text-secondary px-2">Page <%= @release_page %> / <%= @release_total_pages %></span>
        <% if @release_page < @release_total_pages %>
          <%= link_to "Next", all_deployments_path(page: @release_page + 1), class: "btn btn-neutral btn-sm" %>
        <% else %>
          <span class="btn btn-neutral btn-sm opacity-40 pointer-events-none">Next</span>
        <% end %>
      </nav>
    <% end %>
  </div>
</div>
