#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/dev-secret-key: keep production SECRET_KEY_BASE values out of local env files.
#
#   bin/dev-secret-key scan                     # every primary and desk env file vs production digests
#   bin/dev-secret-key scan --digest <sha256>   # compare against given digests (repeatable), skip Heroku
#   bin/dev-secret-key scan FILE...             # only these files
#   bin/dev-secret-key fix                      # scan, then give each flagged file a fresh dev key
#   bin/dev-secret-key rewrite FILE...          # give these files a fresh dev key, unconditionally
#
# Prints paths, states and 8-char SHA-256 prefixes. NEVER a value.
#
# Production digests come from `heroku config --json` of each app in
# DevSecretKey::HEROKU_APPS (read-only; the value is hashed in-process and
# dropped). Pass --digest to compare offline; --app to narrow the app list.
#
# Exit: 0 clean (or every flagged file fixed) · 1 a file holds a production key ·
#       2 usage (an unrecognized argument; NOTHING was read or written) ·
#       3 help (never 0: a scan's 0 is the assertion "no production key on disk") ·
#       4 no production digest could be read, so a clean scan proves nothing.
#
# Why: docs/agents/modules/credentials.md "Local env files hold development keys".

require_relative "lib/cli_arg_guard"
require_relative "lib/dev_secret_key"
require_relative "lib/projects_root"

USAGE = <<~TXT
  usage: bin/dev-secret-key scan [--digest SHA256]... [--app HEROKU_APP]... [--projects DIR] [FILE...]
         bin/dev-secret-key fix  [--digest SHA256]... [--app HEROKU_APP]... [--projects DIR] [FILE...]
         bin/dev-secret-key rewrite FILE...

    scan     every primary and desk env file (or FILE...) vs production digests; prints
             path, state and an 8-char SHA-256 prefix, never a value
    fix      scan, then give each file on a production key a fresh development key
    rewrite  give FILE... a fresh development key, unconditionally

    --digest  compare against this full SHA-256 instead of reading Heroku (repeatable)
    --app     read only this Heroku app's config (repeatable; default: every prod/QA app)
    --projects  the projects root to sweep (default: PROJECTS_DIR, else this checkout's)
TXT

# Account for the WHOLE line before anything reads Heroku or writes a file:
# `bin/dev-secret-key rewrite --help` must print this, not write a file named --help.
ARGS = CliArgGuard.guard!(
  ARGV,
  program: "dev-secret-key",
  usage: USAGE,
  value: %w[--digest --app --projects],
  allow_positional: true,
  help_exit: 3,
  consequence: "NOTHING ran: no Heroku read, no file written."
)

def usage!(msg)
  warn "dev-secret-key: #{msg} (NOTHING ran)"
  warn USAGE
  exit 2
end

def production_digests(digests, apps)
  unless digests.empty?
    bad = digests.reject { |d| d.match?(/\A\h{64}\z/) }
    usage!("--digest takes a full 64-hex SHA-256: #{bad.join(", ")}") unless bad.empty?
    return [digests.to_h { |d| [d, "given"] }, []]
  end

  DevSecretKey.heroku_digests(apps.empty? ? DevSecretKey::HEROKU_APPS : apps)
end

def report(rows)
  width = rows.map { |r| r[:path].length }.max.to_i
  rows.each do |row|
    detail = case row[:state]
             when :production then "#{row[:prefix]}  PRODUCTION (#{row[:app]})"
             when :dev then "#{row[:prefix]}  dev"
             else row[:state].to_s
             end
    puts "#{row[:path].ljust(width)}  #{detail}"
  end
end

command, *files = ARGS.positionals
files = files.map { |f| File.expand_path(f) }
case command
when "rewrite"
  usage!("rewrite needs at least one FILE") if files.empty?
  usage!("rewrite takes no flags") unless ARGS.values.empty?
  files.each do |path|
    puts "#{path}  rewritten  #{DevSecretKey.prefix(DevSecretKey.rewrite(path))}"
  end
when "scan", "fix"
  digests, unread = production_digests(ARGS.all("--digest").map(&:downcase), ARGS.all("--app"))
  unread.each { |app| warn "dev-secret-key: could not read #{app}'s config (no digest for it)" }
  if digests.empty?
    warn "dev-secret-key: no production digest was read; a clean scan would prove nothing"
    exit 4
  end

  if files.empty?
    root = ARGS.first("--projects") || ENV["PROJECTS_DIR"] || ProjectsRoot.default_projects_dir
    files = DevSecretKey.default_files(root)
  end
  rows = DevSecretKey.scan(files, digests).reject { |r| r[:state] == :absent }
  report(rows)
  flagged = rows.select { |r| r[:state] == :production }

  if command == "fix"
    flagged.each do |row|
      puts "#{row[:path]}  rewritten  #{DevSecretKey.prefix(DevSecretKey.rewrite(row[:path]))}"
    end
    remaining = DevSecretKey.scan(flagged.map { |r| r[:path] }, digests).select { |r| r[:state] == :production }
    puts "summary: #{rows.size} file(s) set the key, #{flagged.size} held a production key, " \
         "#{flagged.size - remaining.size} rewritten, #{remaining.size} still production"
    exit(remaining.empty? ? 0 : 1)
  end

  puts "summary: #{rows.size} file(s) set the key, #{flagged.size} hold a production key " \
       "(compared against #{digests.size} production digest(s))"
  exit(flagged.empty? ? 0 : 1)
else
  usage!(command ? "unknown command #{command}" : "a command is required")
end
