#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/session-insights — the learning loop's FEED-FORWARD hook. Wired as a Claude
# Code / Codex SessionStart hook, it fetches the curated Insight Bank
# (GET /api/v1/insights) and prints the SessionStart context-injection JSON, so a
# FRESH agent hatches already knowing the lessons past sessions distilled:
#
#   {"hookSpecificOutput":{"hookEventName":"SessionStart",
#     "additionalContext":"## Insights from past sessions …"}}
#
# This closes the OPSD loop's output stage: banked grades (ActionGrade.banked)
# stop being write-only and become context the next agent starts with.
#
# Targets the SAME board as the narration stack (ATOMIC_CAPTURE_URL, default
# https://mcritchie.studio) via the shared AgentApi client (bin/lib/agent_api.rb), which
# mints/caches the SAME agent token as bin/atomic-event / bin/atomic-capture-hook
# (AGENT_API_SECRET → repo .env → 1Password LAST).
#
# NON-FATAL by construction: any failure (no token, unreachable board, empty bank)
# prints NOTHING and exits 0, so a session with no insights just starts normally —
# the hook can never block or slow a session start.
#
# It also loads the DREAM BANK (bin/lib/dream_bank.rb): the approved worked
# decisions in docs/agents/dreams/. Dreams are tracked files, read locally, so they
# load even when the board gives no insights. Dreams print first; insights follow.

require "json"
require_relative "lib/agent_api"
require_relative "lib/dream_bank"

class SessionInsights
  include AgentApi::Presence

  # Claude Code caps a hook's additionalContext at 10,000 characters; over it the
  # model gets a file path and a 2,000-character preview, so dreams AND insights
  # would both be lost. Stay under it with a margin. The insights are fetched
  # first and always kept whole; the dreams take what is left and degrade on
  # purpose (DreamBank.context) when that is not enough.
  CONTEXT_BUDGET = 9_800
  SEPARATOR = "\n\n"

  OPEN_TIMEOUT = 2
  READ_TIMEOUT = 4
  DEFAULT_LIMIT = 12

  # Each field prints as ONE line of bounded length, whatever the board sent: the
  # text lands in a fresh agent's context, so it may not add a lesson line, a header
  # or an escape sequence of its own. The server caps the same way (ActionGrade);
  # this is the consumer's half. Control, format and line-separator characters each
  # become a space, runs of spaces collapse, and a cut line ends in an ellipsis.
  SLUG_LIMIT      = 200
  LONG_FORM_LIMIT = 400
  TASK_SLUG_LIMIT = 100
  UNPRINTABLE = /[\p{Cc}\p{Cf}\p{Zl}\p{Zp}]/

  def initialize(env: ENV, out: $stdout, dreams_dir: nil)
    @env = env
    @out = out
    @dreams_dir = dreams_dir || env["DREAM_BANK_DIR"] || DreamBank::DEFAULT_DIR
    @api = AgentApi.new(env: env, open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT)
  end

  # Read the dreams, fetch the feed and, if either has anything to say, print the
  # SessionStart injection JSON. Silent no-op otherwise. ALWAYS returns without raising.
  def run
    insights = additional_context(fetch_insights).to_s.strip
    context = session_context(dreams: dream_context(budget: dream_budget(insights)), insights: insights)
    return if context.empty?

    @out.puts(JSON.generate(
                "hookSpecificOutput" => {
                  "hookEventName"     => "SessionStart",
                  "additionalContext" => context
                }
              ))
  rescue StandardError
    # swallow — a feed-forward hook must never break or delay a session start
  end

  # The approved dreams as a context block; "" when the bank is empty or unreadable.
  def dream_context(budget: CONTEXT_BUDGET)
    DreamBank.context(DreamBank.approved(dir: @dreams_dir), budget: budget)
  rescue StandardError
    ""
  end

  # What the dreams may take once the insights have their room. The insights are
  # never trimmed to make space for a dream.
  def dream_budget(insights)
    used = insights.to_s.strip.size
    used.zero? ? CONTEXT_BUDGET : CONTEXT_BUDGET - used - SEPARATOR.size
  end

  # Join the blocks that have content. Either one alone is a full context.
  def session_context(dreams:, insights:)
    [ dreams, insights ].map { |block| block.to_s.strip }.reject(&:empty?).join(SEPARATOR)
  end

  # ── Pure formatter (unit-tested directly) ─────────────────────────────────

  # Render the insight list as a compact, readable context block. A GOOD insight
  # is a "do this" (✓); a NOT insight is a "watch out" (✗). The slug is the lesson
  # headline; long_form (when present) is the anchor; task_slug is provenance.
  def additional_context(insights)
    rows = Array(insights).map { |i| insight_line(i) }.reject(&:empty?)
    return "" if rows.empty?

    header = "## Insights from past sessions — the McRitchie learning loop\n" \
             "Lessons distilled from graded agent trajectories (✓ do · ✗ avoid). " \
             "Apply the relevant ones as you work.\n\n"
    header + rows.join("\n")
  end

  # One "- ✓/✗ <slug> — <long_form> (task: <slug>)" line, or "" when there's no
  # slug to show. Tolerates string OR symbol keys (JSON round-trips to strings).
  def insight_line(insight)
    h = insight.transform_keys(&:to_s)
    slug = one_line(h["slug"], SLUG_LIMIT)
    return "" if slug.empty?

    mark = h["disposition"].to_s == "not" ? "✗" : "✓"
    long_form = one_line(h["long_form"], LONG_FORM_LIMIT)
    task_slug = one_line(h["task_slug"], TASK_SLUG_LIMIT)
    line = "- #{mark} #{slug}"
    line += " — #{long_form}" unless long_form.empty?
    line += " (task: #{task_slug})" unless task_slug.empty?
    line
  end

  # The printable, single-line, capped form of one field ("" when nothing is left).
  def one_line(value, limit)
    text = value.to_s.gsub(UNPRINTABLE, " ").squeeze(" ").strip
    text.length > limit ? "#{text[0, limit - 1]}…" : text
  end

  private

  # GET the feed via the shared AgentApi client (token + bearer GET), returning
  # the array of insight hashes, or nil on any failure. Deliberately NO 401
  # invalidation here — a stale token just means a silent no-insights start; the
  # narration stack (which runs all session) handles the cache refresh.
  def fetch_insights
    tok = @api.token
    return nil unless tok

    res = @api.http_get("/api/v1/insights?limit=#{limit}", bearer: tok)
    return nil unless res && res.code.to_i.between?(200, 299)

    body = JSON.parse(res.body)
    body.is_a?(Hash) ? Array(body["data"]) : nil
  rescue StandardError
    nil
  end

  def limit
    raw = @env["SESSION_INSIGHTS_LIMIT"].to_s.strip
    raw.empty? ? DEFAULT_LIMIT : raw.to_i
  end
end

# Only run when invoked directly (not when `load`ed by the unit test).
if $PROGRAM_NAME == __FILE__
  SessionInsights.new.run
  exit 0 # ALWAYS succeed — the hook must never block a session start
end
