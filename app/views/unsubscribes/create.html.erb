<div class="max-w-md mx-auto px-4 py-16 text-center">
  <% if @contact %>
    <h1 class="text-2xl font-extrabold text-heading mb-2">You're unsubscribed</h1>
    <p class="text-secondary"><strong class="text-heading"><%= @contact.email %></strong> won't receive any more McRitchie Studio emails. Changed your mind? Just reply to any past email.</p>
  <% else %>
    <h1 class="text-2xl font-extrabold text-heading mb-2">Link not found</h1>
    <p class="text-secondary">This unsubscribe link is invalid or expired.</p>
  <% end %>
</div>
