#!/usr/bin/env bash
# bin/secret-key-base-swap: the hub's SECRET_KEY_BASE swap and its rollback, each
# as one guarded Heroku Platform API PATCH.
#
#   bin/secret-key-base-swap swap       # mint a key; the live key becomes OLD_SECRET_KEY_BASE
#   bin/secret-key-base-swap rollback   # exchange SECRET_KEY_BASE and OLD_SECRET_KEY_BASE
#
# Reads HEROKU_API_KEY from the environment and the expected old-key prefix from
# config/secret_rotation.yml. Prints 16-character SHA-256 prefixes, never a key.
# Keys travel by stdin, never argv.
#
# Exit: 0 the PATCH landed and the stored prefixes match · 1 refused or failed ·
#       2 usage (an unrecognized argument) · 3 help.
#
# Runbook: docs/agents/system/secrets-rotation.md, "Hub SECRET_KEY_BASE".
set -euo pipefail

APP=mcritchie-studio
API="https://api.heroku.com/apps/$APP/config-vars"
CONFIG="$(cd "$(dirname "$0")/.." && pwd)/config/secret_rotation.yml"

usage() {
  cat <<'TXT'
usage: bin/secret-key-base-swap swap | rollback

  swap      mint a new SECRET_KEY_BASE and move the live key to OLD_SECRET_KEY_BASE
  rollback  exchange SECRET_KEY_BASE and OLD_SECRET_KEY_BASE

  Both write the production hub's config in one PATCH and restart it.
  Needs HEROKU_API_KEY. The expected old-key prefix is read from
  config/secret_rotation.yml.
TXT
}

for arg in "$@"; do
  case "$arg" in
    --help|-h)
      usage
      echo "secret-key-base-swap: help only. TOUCHES NOTHING: no Heroku read, no write."
      exit 3
      ;;
  esac
done

if [ "$#" -ne 1 ] || { [ "$1" != swap ] && [ "$1" != rollback ]; }; then
  echo "secret-key-base-swap: unrecognized argument(s): ${*:-(none)}. TOUCHES NOTHING." >&2
  usage >&2
  exit 2
fi
COMMAND=$1

refuse() {
  echo "secret-key-base-swap: REFUSED: $1. Nothing was changed." >&2
  exit 1
}

fail() {
  echo "secret-key-base-swap: FAILED: $1." >&2
  exit 1
}

hk() {
  curl -sS --fail-with-body -H "Accept: application/vnd.heroku+json; version=3" \
    -H @<(printf 'Authorization: Bearer %s\n' "$HEROKU_API_KEY") "$@"
}

# stdin -> the first 16 hex characters of its SHA-256, or EMPTY for no input.
prefix() {
  local value
  value=$(cat)
  if [ -z "$value" ]; then
    echo EMPTY
  else
    printf '%s' "$value" | shasum -a 256 | cut -c1-16
  fi
}

is_key() {
  [[ "$1" =~ ^[0-9a-fA-F]{128}$ ]]
}

# Prints one config var's value, or nothing when it is absent.
var() {
  printf '%s' "$1" | jq -r --arg name "$2" '.[$name] // empty'
}

read_config() {
  local body
  body=$(hk "$API") || refuse "the Heroku config read failed"
  printf '%s' "$body" | jq -e 'type == "object" and length > 0' >/dev/null 2>&1 ||
    refuse "the Heroku config read returned no vars"
  printf '%s' "$body"
}

# $1 becomes SECRET_KEY_BASE and $2 becomes OLD_SECRET_KEY_BASE, in one PATCH.
patch_keys() {
  local status
  status=$(printf '%s\n%s\n' "$1" "$2" |
    jq -cRn '[inputs] | {SECRET_KEY_BASE: .[0], OLD_SECRET_KEY_BASE: .[1]}' |
    hk -X PATCH "$API" -H "Content-Type: application/json" --data-binary @- -o /dev/null -w '%{http_code}\n') ||
    fail "the PATCH answered HTTP ${status:-none}; a re-run refuses if it landed"
  [ "$status" = 200 ] || fail "the PATCH answered HTTP $status; a re-run refuses if it landed"
  echo "PATCH 200"
}

# Reads the config back and compares the stored prefixes with $1 (live) and $2 (old).
confirm_stored() {
  local stored live old
  stored=$(hk "$API") || fail "the PATCH landed but the read-back failed"
  live=$(var "$stored" SECRET_KEY_BASE | prefix)
  old=$(var "$stored" OLD_SECRET_KEY_BASE | prefix)
  echo "stored SECRET_KEY_BASE=$live OLD_SECRET_KEY_BASE=$old"
  [ "$live" = "$1" ] && [ "$old" = "$2" ] ||
    fail "the stored prefixes are not SECRET_KEY_BASE=$1 OLD_SECRET_KEY_BASE=$2"
}

[ -n "${HEROKU_API_KEY:-}" ] || refuse "HEROKU_API_KEY is unset"
[ -r "$CONFIG" ] || refuse "config/secret_rotation.yml is missing"
EXPECTED=$(sed -n 's/^expected_old_prefix:[[:space:]]*//p' "$CONFIG" | sed 's/[[:space:]]*#.*$//' | tr -d "\"' ")
[[ "$EXPECTED" =~ ^[0-9a-f]{16}$ ]] ||
  refuse "expected_old_prefix in config/secret_rotation.yml is not 16 lowercase hex characters"

VARS=$(read_config)
LIVE=$(var "$VARS" SECRET_KEY_BASE)
PREVIOUS=$(var "$VARS" OLD_SECRET_KEY_BASE)
[ -n "$LIVE" ] || refuse "SECRET_KEY_BASE is unset on $APP"
is_key "$LIVE" || refuse "SECRET_KEY_BASE is not 128 hex characters"

case "$COMMAND" in
  swap)
    [ -z "$PREVIOUS" ] || refuse "OLD_SECRET_KEY_BASE is already set, so a rotation window is open"
    LIVE_PREFIX=$(printf '%s' "$LIVE" | prefix)
    [ "$LIVE_PREFIX" = "$EXPECTED" ] ||
      refuse "the live key's prefix is $LIVE_PREFIX and config/secret_rotation.yml expects $EXPECTED"
    heroku run --exit-code --app "$APP" -- bin/rails runner \
      'abort "ROTATION CODE MISSING" unless defined?(SecretKeyBaseRotation::HASH_DIGEST_CLASS)' >/dev/null ||
      refuse "the SHA256 rotation code is not running on $APP"

    NEW=$(openssl rand -hex 64) || refuse "the new key could not be generated"
    is_key "$NEW" || refuse "the generated key is not 128 hex characters"
    [ "$NEW" != "$LIVE" ] || refuse "the generated key equals the live key"
    NEW_PREFIX=$(printf '%s' "$NEW" | prefix)
    echo "old=$LIVE_PREFIX new=$NEW_PREFIX"

    patch_keys "$NEW" "$LIVE"
    confirm_stored "$NEW_PREFIX" "$LIVE_PREFIX"
    echo "swapped. When the window closes, set expected_old_prefix: $NEW_PREFIX in config/secret_rotation.yml."
    ;;
  rollback)
    [ -n "$PREVIOUS" ] || refuse "OLD_SECRET_KEY_BASE is unset on $APP, so there is no key to roll back to"
    is_key "$PREVIOUS" || refuse "OLD_SECRET_KEY_BASE is not 128 hex characters"
    [ "$PREVIOUS" != "$LIVE" ] || refuse "OLD_SECRET_KEY_BASE equals SECRET_KEY_BASE"
    PREVIOUS_PREFIX=$(printf '%s' "$PREVIOUS" | prefix)
    [ "$PREVIOUS_PREFIX" = "$EXPECTED" ] ||
      refuse "OLD_SECRET_KEY_BASE's prefix is $PREVIOUS_PREFIX and config/secret_rotation.yml expects $EXPECTED"
    LIVE_PREFIX=$(printf '%s' "$LIVE" | prefix)
    echo "restoring=$PREVIOUS_PREFIX retiring=$LIVE_PREFIX"

    patch_keys "$PREVIOUS" "$LIVE"
    confirm_stored "$PREVIOUS_PREFIX" "$LIVE_PREFIX"
    echo "rolled back."
    ;;
esac
