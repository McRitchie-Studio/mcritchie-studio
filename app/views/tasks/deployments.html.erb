<%# Workflow 2 · Deploy (DevOps) — submitted → reviewed → assembled → shipped. Led by the
    current-release module. %>
<% content_for :full_width, true %>

<div class="mx-auto w-full max-w-screen-2xl px-3 py-6 sm:px-4 lg:px-6 xl:px-8">
  <% if current_user&.admin? %>
    <div class="mb-3 flex justify-end">
      <%= link_to admin_model_pricing_path,
            class: "inline-flex items-center gap-2 text-sm px-3 py-1.5 rounded border border-subtle text-secondary hover:bg-surface-alt" do %>
        <span>💵</span><span>Model Pricing</span>
      <% end %>
    </div>
  <% end %>
  <%= render "deploy_board",
        stages: Task::DEPLOYMENTS_BOARD_STAGES,
        title: "Deployments",
        current_release: @current_release,
        last_release: @last_release,
        release_duration_dashboard: @release_duration_dashboard,
        wip_task_count: @wip_task_count,
        app_ladder_cards: @app_ladder_cards,
        current_page: "deployments",
        show_kickoffs: false %>

  <%# The desk panel sits BELOW the board on purpose. The board is the work; the desks are
      the machine the work runs on, and an operator scanning /deployments should reach the
      pipeline first. Rendered here rather than inside _deploy_board so the board partial —
      which /tasks also renders — keeps exactly the locals it has today. %>
  <div class="mt-6">
    <%= render "desk_panel", panel: @desk_panel %>
  </div>
</div>
