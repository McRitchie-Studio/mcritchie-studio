<% content_for(:title, "Unsubscribed") %>
<div class="max-w-md mx-auto px-4 py-16">
  <div class="card p-6 text-center">
    <% if @contact %>
      <h1 class="text-2xl font-extrabold text-heading mb-4">You're unsubscribed</h1>
      <%= render "context", contact: @contact, delivery: @delivery %>
      <p class="text-secondary mt-4 mb-6">You won't get any more McRitchie Studio emails. Changed your mind?</p>
      <%= button_to "Resubscribe", resubscribe_path(token: @contact.unsubscribe_token, d: params[:d].presence), method: :post, form: { data: { turbo: false } }, class: "btn btn-primary w-full" %>
    <% else %>
      <%= render "not_found" %>
    <% end %>
  </div>
</div>
