<%# A single Pokémon type badge, colored (and emoji-prefixed) from the shared
    Studio::Enumeral "pokemon_type" catalog. The caller passes the resolved
    `enumeral` record (built once per page via Pokemon.type_enumerals) so this
    partial does no lookup. Falls back to the neutral surface chip when a type has
    no enumeral, so the page renders fine before the enumerals are seeded. Used by
    BOTH the list and grid views — keep them in sync by routing both through here. %>
<% enumeral = local_assigns[:enumeral] %>
<% color = enumeral&.color %>
<% emoji = enumeral&.emoji %>
<% if color.present? %>
  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] uppercase tracking-wide font-semibold text-white border"
        style="background-color: <%= color %>; border-color: <%= color %>;"
        data-test="type-badge" data-type="<%= type %>"><% if emoji.present? %><span class="not-italic normal-case" aria-hidden="true" data-test="type-emoji"><%= emoji %></span><% end %><%= type %></span>
<% else %>
  <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] uppercase tracking-wide bg-surface border border-subtle text-secondary"
        data-test="type-badge" data-type="<%= type %>"><% if emoji.present? %><span class="not-italic normal-case" aria-hidden="true" data-test="type-emoji"><%= emoji %></span><% end %><%= type %></span>
<% end %>
