<%# The agent-narrated activity table — the PRIMARY heartbeat rows. Each row is an
    AgentActivity: its category badge, the narrated reason -> result (stacked two
    lines to save horizontal width; an OPEN activity shows the in-progress placeholder plus a distinct "open" status badge), the
    stacked-avatar Agent cell, and a MERGED Model / Tokens column (model on top, the
    rolled-up in/out tokens beneath) plus Cost — all rolled up from the raw tool-calls
    attributed to the activity (summed in the controller-loaded @activity_rows array — no
    per-row query). Each activity is a collapsible tbody (Alpine, default collapsed);
    expanding it drills into those raw agent_actions read-only. Each activity carries
    inline good/not quick-grade radios (Alex + McRitchie, POSTing to the activity grade
    endpoint); drilled-down raw action rows open the grading drawer. Raw
    actions the agent never narrated (a null agent_activity_id) fall into the single
    trailing "Unlabeled" group. Locals: activity_rows (Array of [AgentActivity,
    [AgentAction, ...]]), unlabeled (Array of AgentAction), pokemon_by_slug,
    agents_by_slug (soul slug => Agent, for the stacked acting-soul-over-base-mascot
    Agent cell), activity_grades (activity_id => { grader => ActionGrade }). %>
<% pokemon_by_slug ||= {} %>
<% agents_by_slug ||= {} %>
<% unlabeled ||= [] %>
<% activity_grades ||= {} %>
<%# task_slug => [chronological transition TaskEvents], bulk-loaded by the controller
    so an activity whose task changed stage in-window badges as that new stage. Defaults
    to empty so isolated/legacy renders fall back to the plain open/done badge. %>
<% stage_transitions ||= {} %>
<%# Session-level dup flags: ids of the 2nd+ tool-call of each shared source_turn_uuid,
    whose tokens/cost merely inherit the turn's spend — the controller walks the whole
    session so a turn split across activities still fades every row after its first. %>
<% shared_turn_ids ||= Set.new %>
<div class="hb-scroll">
  <%# data-sticky-table-header=false: this table pins its own thead th inside
      .hb-scroll; the app-wide sticky_table_header.js clone would double it. %>
  <table class="hb-tbl hb-evt-tbl" data-test="heartbeat-event-table" data-sticky-table-header="false">
    <thead>
      <tr>
        <th>#</th>
        <th>Activity</th>
        <th>Narration</th>
        <th>Agent</th>
        <th>Model / Tokens</th>
        <th>Cost</th>
        <th>Command / Task</th>
        <th>Alex</th>
        <th>McRitchie</th>
      </tr>
    </thead>

    <% activity_rows.each do |activity, actions| %>
      <% cat = heartbeat_category_meta(activity.category) %>
      <% totals = heartbeat_activity_totals(actions) %>
      <% status = heartbeat_activity_status_meta(activity, stage_transitions) %>
      <% mascot_slug = activity.mascot.presence || totals[:mascot] %>
      <% pokemon = pokemon_by_slug[mascot_slug] %>
      <% grades_for = activity_grades[activity.id] || {} %>
      <% alex_g = grades_for[ActionGrade::ALEX] %>
      <% mcr_g = grades_for[ActionGrade::MCR] %>
      <tbody class="hb-evtgroup" data-test="heartbeat-event"
             data-category="<%= activity.category %>" data-activity-id="<%= activity.id %>"
             data-alex-disp="<%= alex_g&.disposition %>" data-alex-slug="<%= alex_g&.slug %>"
             data-alex-graded="<%= alex_g.present? %>" data-alex-banked="<%= !!alex_g&.banked %>"
             data-mcr-disp="<%= mcr_g&.disposition %>" data-mcr-slug="<%= mcr_g&.slug %>"
             data-mcr-graded="<%= mcr_g.present? %>" data-mcr-banked="<%= !!mcr_g&.banked %>"
             x-data="heartbeatActivityRow()" x-init="hydrate($el)"
             @hb:activity-graded.window="onGraded($event.detail)">
        <tr class="hb-evtrow hb-clickrow" data-test="heartbeat-event-row" @click="open = !open"
            style="--hb-edge: <%= cat[:accent] %>">
          <td class="hb-seq" @click.stop="open = !open" title="expand raw actions"><span class="hb-chev" :class="open ? 'hb-chev-open' : ''">&#9656;</span></td>
          <td>
            <span class="hb-chip hb-catchip" style="color: <%= cat[:accent] %>" title="<%= cat[:description] %>"><%= activity.category %></span>
            <div class="hb-meta hb-mono hb-evttime" title="<%= activity.opened_at&.iso8601 %>"><%= heartbeat_time(activity.opened_at) %></div>
          </td>
          <td class="hb-span hb-narr">
            <span class="hb-narrline hb-span-title">
              <span class="hb-slug" data-test="event-reason"><%= activity.reason_slug %></span>
              <span class="hb-bullet" aria-hidden="true">&middot;</span>
              <span class="hb-inline-actions" data-test="event-inline-action-count"><%= pluralize(actions.size, "action") %></span>
              <span class="hb-bullet" aria-hidden="true">&middot;</span>
              <span class="hb-inline-status" data-test="event-inline-status">
                <%= heartbeat_activity_status_badge(status) %>
              </span>
            </span>
            <span class="hb-narrline hb-narr-result">
              <span class="hb-arrow">&rarr;</span>
              <% if activity.open? || activity.outcome_slug.blank? %>
                <span class="hb-inprogress" data-test="event-in-progress"><%= heartbeat_activity_result(activity) %></span>
              <% else %>
                <span class="hb-result"><%= activity.outcome_slug %></span>
              <% end %>
            </span>
          </td>
          <td><%= heartbeat_agent_cell(mascot_slug: mascot_slug, pokemon: pokemon,
                                       agent_slug: activity.agent, agent: agents_by_slug[activity.agent],
                                       mascot_test: "event-mascot") %></td>
          <td class="hb-meta hb-mono hb-modeltok">
            <span class="hb-mt-model" data-test="event-model" title="<%= totals[:model].presence || "no model (board / harness steps only)" %>"><%= heartbeat_model_short(totals[:model]) %></span>
            <span class="hb-mt-tokens" data-test="event-tokens"><%= heartbeat_tokens_pair(totals[:tokens_in], totals[:tokens_out]) %></span>
          </td>
          <td class="hb-meta hb-mono" data-test="event-cost"><%= heartbeat_cost(totals[:cost]) %></td>
          <td class="hb-meta"><div class="hb-sat">
            <div class="hb-satcmd" data-test="event-key-method">
              <% if activity.key_method.present? %>
                <%= render "heartbeat/key_method_chip", code: activity.key_method, lang: activity.key_method_lang %>
              <% end %>
            </div>
            <span class="hb-mono hb-taskcell"><%= activity.task_slug.presence || "—" %></span>
          </div></td>
          <%= render "heartbeat/activity_feedback_cell", activity: activity, alex: alex_g, mcr: mcr_g %>
        </tr>

        <% if actions.any? %>
          <% actions.each do |action| %>
            <% outcome = heartbeat_outcome_meta(action.outcome) %>
            <% action_pokemon = pokemon_by_slug[action.mascot] %>
            <% turn_shared = shared_turn_ids.include?(action.id) %>
            <tr class="hb-subrow" data-test="heartbeat-event-action" data-seq="<%= action.seq %>" x-show="open"
                style="--hb-edge: <%= outcome[:color] %>"
                @click="openDrawer('<%= heartbeat_feedback_path(action) %>')">
              <td class="hb-seq hb-subseq-gutter" aria-hidden="true"></td>
              <td class="hb-mono hb-kind">
                <span class="hb-kindline">
                  <span class="hb-subseq">#<%= action.seq %></span>
                  <span><%= action.kind %></span>
                </span>
              </td>
              <td class="hb-subnarr">
                <span class="hb-subtitle">
                  <span class="hb-subslug"><%= action.event_slug.presence || "—" %></span>
                  <span class="hb-bullet" aria-hidden="true">&middot;</span>
                  <span class="hb-outcome" data-test="action-outcome" style="color: <%= outcome[:color] %>"><%= outcome[:label] %></span>
                </span>
                <% if action.input.present? %>
                  <span class="hb-subinput hb-mono" title="<%= action.input %>"><%= heartbeat_input_preview(action.input) %></span>
                <% end %>
              </td>
              <td><%= heartbeat_agent_cell(mascot_slug: action.mascot, pokemon: action_pokemon,
                                           agent_slug: activity.agent, agent: agents_by_slug[activity.agent],
                                           submascot: true) %></td>
              <%= tag.td class: class_names("hb-meta", "hb-mono", "hb-modeltok", "hb-turn-shared" => turn_shared), title: (heartbeat_shared_turn_title if turn_shared) do %>
                <span class="hb-mt-model" title="<%= action.model.presence || "no model (board / harness step)" %>"><%= heartbeat_model_short(action.model) %></span>
                <span class="hb-mt-tokens"><%= heartbeat_tokens(action) %></span>
              <% end %>
              <%= tag.td heartbeat_cost(action.cost), class: class_names("hb-meta", "hb-mono", "hb-turn-shared" => turn_shared), title: (heartbeat_shared_turn_title if turn_shared) %>
              <td class="hb-meta"><div class="hb-sat">
                <% if action.key_method.present? %>
                  <span data-test="action-key-method"><%= render "heartbeat/key_method_chip", code: action.key_method, lang: action.key_method_lang %></span>
                <% end %>
                <span class="hb-action-summary" data-test="action-summary"><%= action.summary.presence || "—" %></span>
              </div></td>
              <td class="hb-meta hb-gradehint" colspan="2">
                <span class="hb-mono hb-taskcell" data-test="action-task-slug"><%= action.task_slug.presence || "—" %></span>
              </td>
            </tr>
          <% end %>
        <% else %>
          <tr class="hb-subrow hb-subempty" x-show="open">
            <td class="hb-seq">&mdash;</td>
            <td colspan="8" class="hb-meta">No raw actions attributed to this activity.</td>
          </tr>
        <% end %>
      </tbody>
    <% end %>

    <% if unlabeled.any? %>
      <% unl = HeartbeatHelper::HEARTBEAT_UNLABELED %>
      <tbody class="hb-evtgroup hb-unlabeled" data-test="heartbeat-unlabeled" x-data="{ open: false }">
        <tr class="hb-evtrow" data-test="heartbeat-event-row" @click="open = !open"
            style="--hb-edge: <%= unl[:accent] %>">
          <td class="hb-seq"><span class="hb-chev" :class="open ? 'hb-chev-open' : ''">&#9656;</span></td>
          <td><span class="hb-chip hb-catchip" style="color: <%= unl[:accent] %>" title="<%= unl[:description] %>">Unlabeled</span></td>
          <td class="hb-span"><span class="hb-result">context the agent did not narrate into an activity</span></td>
          <td class="hb-meta">&mdash;</td>
          <td class="hb-meta">&mdash;</td>
          <td class="hb-meta">&mdash;</td>
          <td class="hb-meta"><div class="hb-sat">
            <span class="hb-count" data-test="event-action-count"><%= pluralize(unlabeled.size, "action") %></span>
          </div></td>
          <td class="hb-meta" colspan="2">&mdash;</td>
        </tr>
        <% unlabeled.each do |action| %>
          <% outcome = heartbeat_outcome_meta(action.outcome) %>
          <% action_pokemon = pokemon_by_slug[action.mascot] %>
          <% turn_shared = shared_turn_ids.include?(action.id) %>
          <tr class="hb-subrow" data-test="heartbeat-event-action" data-seq="<%= action.seq %>" x-show="open"
              style="--hb-edge: <%= outcome[:color] %>"
              @click="openDrawer('<%= heartbeat_feedback_path(action) %>')">
            <td class="hb-seq hb-subseq-gutter" aria-hidden="true"></td>
            <td class="hb-mono hb-kind">
              <span class="hb-kindline">
                <span class="hb-subseq">#<%= action.seq %></span>
                <span><%= action.kind %></span>
              </span>
            </td>
            <td class="hb-subnarr">
              <span class="hb-subtitle">
                <span class="hb-subslug"><%= action.event_slug.presence || "—" %></span>
                <span class="hb-bullet" aria-hidden="true">&middot;</span>
                <span class="hb-outcome" data-test="action-outcome" style="color: <%= outcome[:color] %>"><%= outcome[:label] %></span>
              </span>
              <% if action.input.present? %>
                <span class="hb-subinput hb-mono" title="<%= action.input %>"><%= heartbeat_input_preview(action.input) %></span>
              <% end %>
            </td>
            <td><%= heartbeat_agent_cell(mascot_slug: action.mascot, pokemon: action_pokemon, submascot: true) %></td>
            <%= tag.td class: class_names("hb-meta", "hb-mono", "hb-modeltok", "hb-turn-shared" => turn_shared), title: (heartbeat_shared_turn_title if turn_shared) do %>
              <span class="hb-mt-model" title="<%= action.model.presence || "no model (board / harness step)" %>"><%= heartbeat_model_short(action.model) %></span>
              <span class="hb-mt-tokens"><%= heartbeat_tokens(action) %></span>
            <% end %>
            <%= tag.td heartbeat_cost(action.cost), class: class_names("hb-meta", "hb-mono", "hb-turn-shared" => turn_shared), title: (heartbeat_shared_turn_title if turn_shared) %>
            <td class="hb-meta"><div class="hb-sat">
              <% if action.key_method.present? %>
                <span data-test="action-key-method"><%= render "heartbeat/key_method_chip", code: action.key_method, lang: action.key_method_lang %></span>
              <% end %>
              <span class="hb-action-summary" data-test="action-summary"><%= action.summary.presence || "—" %></span>
            </div></td>
            <td class="hb-meta hb-gradehint" colspan="2">
              <span class="hb-mono hb-taskcell" data-test="action-task-slug"><%= action.task_slug.presence || "—" %></span>
            </td>
          </tr>
        <% end %>
      </tbody>
    <% end %>
  </table>
</div>
