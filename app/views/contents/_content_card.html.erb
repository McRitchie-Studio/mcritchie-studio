<%# One content card, rendered per record by the studio/board primitive (card_partial).
    The board identity contract (id="card-<slug>", .kanban-card, data-slug, data-stage)
    is emitted by studio/board/card_shell; this partial owns only the card body. The
    delete @click resolves `deleteContent` from the contentBoardChrome parent scope
    (Alpine nests scopes). Bound as :content via card_as. %>
<%= render layout: "studio/board/card_shell",
      locals: {
        id: content.slug,
        zone: content.stage,
        class: "bg-surface rounded-lg border border-subtle p-3 cursor-grab active:cursor-grabbing hover:border-primary/30 transition group relative"
      } do %>
  <span class="absolute top-1 right-1.5 text-[9px] text-muted font-mono"><%= content.position %></span>

  <div class="flex items-center justify-between mb-1.5">
    <a href="<%= content_path(content.slug) %>"
       class="text-heading font-semibold text-sm truncate flex-1 hover:text-primary transition"
       @click.stop>
      <%= content.title %>
    </a>
    <div class="flex items-center gap-1 ml-2 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">
      <button @click.stop="deleteContent('<%= content.slug %>')"
              class="text-muted hover:text-red-400 transition p-0.5" title="Delete">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
      </button>
    </div>
  </div>

  <%# Metadata %>
  <div class="flex flex-wrap items-center gap-1.5 mb-1">
    <% if content.source_type.present? %>
      <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-blue-900/50 text-blue-300 border border-blue-700/50"><%= content.source_type %></span>
    <% end %>
    <% if content.content_type.present? %>
      <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-violet-900/50 text-violet-300 border border-violet-700/50"><%= content.content_type.humanize %></span>
    <% end %>
  </div>

  <% if content.description.present? %>
    <p class="text-[10px] text-secondary truncate"><%= content.description.truncate(60) %></p>
  <% end %>

  <p class="text-[10px] text-muted mt-1"><%= time_ago_in_words(content.created_at) %> ago</p>
<% end %>
