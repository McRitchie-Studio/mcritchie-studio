<%# One "Built with McRitchie Studio" card (build/_gallery's sideways row): the
    app's dark-mode still on top (BuildGallery::Example#image; its emoji when it
    has none), then its name, its host, and one line of what it is, each held to
    one line (truncate; the blurb's full text is its title).

    An app with a motion loop plays it over the still while a mouse rests on the
    card or the keyboard focuses it (app/javascript/gallery_motion.js). Never on
    touch, never under prefers-reduced-motion, and the video loads nothing until
    it is asked to play (preload none, and no poster: a poster would fetch the
    still eagerly and defeat the img's loading="lazy"). It fades in on
    data-playing, which the script sets only once it really plays, so a slow
    load shows the still, not a blank box. The focus ring is drawn INSIDE the
    card (-outline-offset-2): the row scrolls sideways, and its overflow would
    clip a ring drawn outside.

    An app with a palette (BuildGallery.palette_for; config/build_examples.yml
    `palettes`) wears its own theme: the lower panel its dark-mode page
    background in both hub themes, the name its primary, the host and blurb
    its muted tone, the border and hover glow its primary (build_cards.css,
    .build-gallery-card).
    The colours ride in as custom properties; palette_for passes #rrggbb only.
    Without one the card keeps the Studio theme. %>
<% host = (URI.parse(example.url).host rescue nil) || example.url %>
<% palette = example.palette %>
<% palette_style = palette && BuildGallery::PALETTE_KEYS.map { |key| "--gc-#{key}: #{palette[key]}" }.join("; ") %>
<%= link_to example.url, target: "_blank", rel: "noopener",
      class: "build-gallery-card group flex h-full flex-col overflow-hidden rounded-2xl border border-subtle bg-surface hover:border-primary transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary",
      style: palette_style,
      data: { test: "build-example", gallery_motion: (true if example.motion), palette: (true if palette) } do %>
  <span class="relative block aspect-[16/10] overflow-hidden bg-surface-alt border-b border-subtle">
    <% if example.image %>
      <%= image_tag example.image, alt: "#{example.name}, as it looks live", loading: "lazy",
            class: "h-full w-full object-cover object-top",
            data: { test: "build-example-image" } %>
      <% if example.motion %>
        <video src="<%= asset_path(example.motion) %>"
               muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"
               class="pointer-events-none absolute inset-0 h-full w-full object-cover object-top opacity-0 data-[playing]:opacity-100 transition-opacity duration-300 motion-reduce:hidden"
               data-gallery-motion-video data-test="build-example-motion"></video>
      <% end %>
    <% else %>
      <span class="flex h-full items-center justify-center text-5xl" aria-hidden="true"><%= example.emoji %></span>
    <% end %>
  </span>
  <span class="build-gallery-card-body block flex-1 min-w-0 px-4 py-3 text-center" data-test="build-example-body">
    <span class="build-gallery-card-name block font-semibold text-heading group-hover:text-primary truncate"
          data-test="build-example-name"><%= example.name %></span>
    <span class="build-gallery-card-text mt-0.5 block font-mono text-2xs leading-4 text-muted truncate" data-test="build-example-host"><%= host %></span>
    <span class="build-gallery-card-text mt-0.5 block text-2xs leading-4 text-muted truncate" title="<%= example.blurb %>"
          data-test="build-example-blurb"><%= example.blurb %></span>
  </span>
<% end %>
