<%# /applications/:slug/chat: the viewer's own live chat with the app's CTO. Owner or admin only. The chat itself is the shared agent_chats component. docs/agents/system/agent-message-loop.md ("Web chat") %>
<section class="max-w-3xl mx-auto px-4 py-6 sm:py-10 space-y-4" data-test="cto-chat-page" data-app="<%= @app.slug %>" data-soul="<%= @cto.soul %>">
  <% subtitle = capture do %>
    <p class="text-secondary text-sm">
      CTO of <%= link_to @app.name, application_path(@app.slug), class: "underline hover:text-heading", data: { test: "cto-chat-app-link" } %>.
      An AI agent: it answers here, proposes, and runs nothing without your <span class="font-semibold">go</span>.
    </p>
  <% end %>
  <%= render "agent_chats/header", name: @cto.display_name, agent: @cto.agent, subtitle: subtitle %>

  <% if @available %>
    <details class="card p-3 text-sm group" data-test="cto-chat-usage" open>
      <summary class="cursor-pointer select-none font-semibold text-heading flex items-center justify-between gap-2">
        <span>Agent usage this month</span>
        <span class="text-muted text-xs font-normal group-open:hidden">show</span>
      </summary>
      <div id="<%= AgentMessages::WebChat::METER_TARGET %>" class="pt-2">
        <%= render "applications/usage_meter", meter: @meter %>
      </div>
    </details>

    <% unless @answered %>
      <p class="card p-3 text-sm text-warning-ink border-warning/40" data-test="cto-chat-unanswered">
        <%= @cto.display_name %> does not answer your account yet, so your messages wait for an admin to release them.
      </p>
    <% end %>

    <%= render "agent_chats/chat", agent_name: @cto.display_name, stream: @stream, channel: CtoChatChannel, messages: @messages,
                                   composer: composer_locals, empty: "Ask #{@cto.display_name} anything about #{@app.name}." %>
  <% else %>
    <p class="card p-4 text-sm text-secondary" data-test="cto-chat-unavailable">
      <%= @cto.display_name %> has no web chat yet.
    </p>
  <% end %>
</section>
