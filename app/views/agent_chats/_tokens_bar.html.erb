<%# locals: (meter:) %>
<%# The status card's "Tokens used" bar (AgentUsage::Meter, tokens never dollars): the app chat's compact meter, re-rendered into #cto-chat-meter by every answer (AgentMessages::WebChat.broadcast_meter). Owner-or-admin pages only. The full meter, with its tier and reset date, stays on the app page (applications/_usage_meter). %>
<% fmt = ->(n) { n.to_i.to_fs(:delimited) } %>
<% bar = { ok: "bg-success", warn: "bg-warning", capped: "bg-danger" }[meter.state] %>
<div class="space-y-1.5 text-sm" data-test="usage-meter" data-state="<%= meter.state %>">
  <div class="flex items-baseline justify-between gap-2 text-body" data-test="usage-meter-line">
    <span class="font-semibold text-heading">Tokens used</span>
    <% if meter.unlimited? %>
      <span class="text-secondary text-xs"><%= fmt.(meter.used) %> · unlimited</span>
    <% else %>
      <span class="text-secondary text-xs"><%= fmt.(meter.used) %> of <%= fmt.(meter.allowance) %> <span data-test="usage-meter-percent">(<%= meter.percent %>&#37;)</span></span>
    <% end %>
  </div>
  <% unless meter.unlimited? %>
    <div class="h-2 w-full overflow-hidden rounded-full bg-inset" role="progressbar" aria-label="Tokens used this month"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= [ meter.percent, 100 ].min %>">
      <div class="h-full rounded-full <%= bar %>" style="width: <%= [ meter.percent, 100 ].min %>%"></div>
    </div>
  <% end %>
  <% if (suggestion = meter.suggestion) %>
    <p class="text-warning-ink text-xs" data-test="usage-suggestion" data-kind="<%= suggestion.kind %>"><%= suggestion.line %></p>
  <% end %>
</div>
