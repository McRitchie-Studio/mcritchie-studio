<% content_for(:title, @survey.title) %>
<%# One survey's answers (admin; task first-game-feedback-survey): the count,
    how the faces question came out, and every answer with who gave it. The
    table shows the newest SurveysController::TABLE_LIMIT. %>
<% feeling = @survey.feeling_question %>
<% max = [ @distribution.values.max.to_i, 1 ].max %>
<div class="max-w-6xl mx-auto px-4 py-8 space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div class="min-w-0">
      <h1 class="text-2xl font-extrabold text-heading"><%= @survey.title %></h1>
      <p class="text-secondary text-sm mt-1 break-all">Public form: <%= link_to survey_form_url(@survey), survey_form_path(@survey), class: "text-primary hover:underline" %></p>
    </div>
    <%= link_to "All surveys", surveys_path, class: "btn btn-secondary" %>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" data-test="survey-stats">
    <div class="card p-4">
      <div class="text-xs uppercase tracking-wider text-muted">Responses</div>
      <div class="text-3xl font-extrabold text-heading" data-test="survey-count"><%= number_with_delimiter(@count) %></div>
    </div>
    <div class="card p-4">
      <div class="text-xs uppercase tracking-wider text-muted">From an email</div>
      <div class="text-3xl font-extrabold text-heading"><%= number_with_delimiter(@attributed) %></div>
    </div>
    <div class="card p-4 col-span-2 sm:col-span-1">
      <div class="text-xs uppercase tracking-wider text-muted">Anonymous</div>
      <div class="text-3xl font-extrabold text-heading"><%= number_with_delimiter(@count - @attributed) %></div>
    </div>
  </div>

  <% if feeling %>
    <div class="card p-5" data-test="survey-distribution">
      <h2 class="text-sm font-semibold text-heading mb-4"><%= feeling.prompt %></h2>
      <div class="space-y-2">
        <% feeling.options.reverse_each do |value, emoji, label| %>
          <% n = @distribution[value.to_s].to_i %>
          <div class="flex items-center gap-3" data-test="survey-feeling-<%= value %>">
            <span class="w-24 shrink-0 text-sm text-secondary"><span class="text-xl align-middle" aria-hidden="true"><%= emoji %></span> <%= label %></span>
            <div class="flex-1 h-4 rounded-full bg-surface-alt overflow-hidden">
              <div class="h-full rounded-full bg-primary" style="width: <%= (n * 100.0 / max).round %>%"></div>
            </div>
            <span class="w-10 text-right text-sm font-semibold text-heading tabular-nums"><%= n %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>

  <div class="card overflow-x-auto" data-test="survey-answers">
    <% if @responses.empty? %>
      <p class="p-6 text-secondary text-sm">No answers yet.</p>
    <% else %>
      <table class="w-full text-sm">
        <thead>
          <tr class="text-left text-xs uppercase tracking-wider text-muted border-b border-subtle">
            <th class="p-3 whitespace-nowrap">When</th>
            <th class="p-3">Who</th>
            <% @survey.questions.each do |question| %>
              <th class="p-3 min-w-32"><%= question.prompt %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-subtle">
          <% @responses.each do |response| %>
            <tr class="align-top" data-test="survey-answer-row">
              <td class="p-3 whitespace-nowrap text-muted"><%= l(response.created_at.in_time_zone("America/Denver"), format: :short) %></td>
              <td class="p-3">
                <% if response.contact %>
                  <div class="font-semibold text-heading break-all"><%= response.contact.email %></div>
                  <% if (username = response.contact.cyvasse["username"]).present? %>
                    <div class="text-xs text-muted"><%= username %></div>
                  <% end %>
                <% else %>
                  <span class="text-muted">Anonymous</span>
                <% end %>
              </td>
              <% @survey.questions.each do |question| %>
                <% value = response.answer(question.key) %>
                <td class="p-3 text-secondary whitespace-pre-line">
                  <% if value.blank? %>
                    <span class="text-muted">&ndash;</span>
                  <% elsif (option = question.option_for(value)) %>
                    <%= question.kind == "faces" ? "#{option[1]} #{option[2]}" : option[1] %>
                  <% else %>
                    <%= value %>
                  <% end %>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
