<% if @last_release %>
  <% rel = @last_release %>
  <% members = rel.tasks.order(:position).to_a %>
  <%# Read-only history: the most-recently shipped release. Dimmed (opacity-75 +
      muted text) so it reads as the past, distinct from the active Current block. %>
  <div id="last-release" class="rounded-xl border border-subtle bg-surface p-4 opacity-75">
    <div class="flex items-center justify-between flex-wrap gap-3">
      <div class="flex items-center gap-3 flex-wrap">
        <span class="text-[11px] uppercase tracking-wide text-muted font-semibold">Last Release</span>
        <code class="text-sm text-muted"><%= rel.slug %></code>
        <span class="px-2 py-0.5 rounded text-xs font-bold <%= release_state_classes(rel.state) %>"><%= rel.state %></span>
        <% if rel.branch.present? %><code class="text-xs text-muted" title="persistent integration branch"><%= rel.branch %></code><% end %>
      </div>
      <div class="flex items-center gap-4 text-xs text-muted flex-wrap">
        <span><%= members.size %> task<%= "s" unless members.size == 1 %></span>
        <% if rel.qa_url.present? %><%= link_to "QA ↗", rel.qa_url, target: "_blank", rel: "noopener", class: "text-secondary hover:underline" %><% end %>
        <% if rel.production_url.present? %><%= link_to "Prod ↗", rel.production_url, target: "_blank", rel: "noopener", class: "text-secondary hover:underline" %><% end %>
        <% if rel.deployed_sha.present? %><code class="text-muted" title="deployed SHA"><%= rel.deployed_sha.first(7) %></code><% end %>
        <% if rel.shipped_at %><span class="text-muted">shipped <%= time_ago_in_words(rel.shipped_at) %> ago</span><% end %>
      </div>
    </div>
    <% if members.any? %>
      <div class="mt-3 flex flex-wrap gap-2">
        <% members.each do |t| %>
          <%= link_to task_path(t.slug), class: "px-2 py-1 rounded bg-inset text-xs text-muted hover:text-body flex items-center gap-1.5 border border-subtle" do %>
            <%= app_emoji_badge(t.devops_repositories) %>
            <%= truncate(t.title, length: 42) %>
            <% if (deploy_target = deploy_target_label(t)) %>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-surface-alt text-secondary border border-subtle" title="Deploy target"><%= deploy_target %></span>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
