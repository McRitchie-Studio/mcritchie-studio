<%# /teams/:slug/depth-chart — the NFL depth chart, rebased onto the studio/board
    ENGINE PRIMITIVE (studio-engine 0.29.0). Was a bespoke <ul.dc-zone>/<li.dc-entry>
    board with a CDN SortableJS + an x-data="depthChart" wrapper; now it renders
    studio/board/_board (the vendored Sortable + window.studioBoard factory, loaded
    once in the layout). The depth-chart shape drove the 0.29.0 gaps: DG3 two-level
    side→position GRID (groups:), DG1 rank by `depth`/ASC with `position` a lane string,
    DG2 sequential 1..N depths on reorder, DG4 pinned starters (locked_selector). The
    two depth-chart-specific client bits the factory doesn't own — renumbering the
    visible depth column after a reorder and the per-card lock toggle — live in
    depth_chart.js (window.depthChartRenumber / window.depthChartLock). %>
<style>
  .dc-entry { transition: background-color 0.15s ease; }
  .dc-entry.kanban-locked { background: rgba(255, 215, 0, 0.06); }
  .dc-entry.kanban-locked .dc-handle { cursor: not-allowed; opacity: 0.4; }
  .dc-entry.dc-starter { border-left: 3px solid var(--color-success, #4BAF50); background: rgba(75, 175, 80, 0.06); }
  .dc-entry.dc-starter.kanban-locked { background: rgba(255, 215, 0, 0.08); }
  .dc-starter-badge {
    display: inline-block;
    min-width: 1.4rem;
    padding: 0 0.3rem;
    height: 1rem;
    line-height: 1rem;
    border-radius: 0.5rem;
    background: var(--color-success, #4BAF50);
    color: white;
    font-size: 9px;
    font-weight: 700;
    text-align: center;
    letter-spacing: 0.02em;
  }
  .dc-handle { cursor: grab; }
  .dc-handle:active { cursor: grabbing; }
</style>

<section class="max-w-6xl mx-auto px-4 py-8">
  <div class="mb-6 flex items-center justify-between">
    <div class="flex items-center gap-3">
      <% if @team.color_primary.present? %>
        <span class="inline-block w-4 h-4 rounded-full" style="background-color: <%= @team.color_primary %>"></span>
      <% end %>
      <h1 class="text-3xl font-bold text-heading"><%= @team.emoji %> <%= @team.name %> — Depth Chart</h1>
    </div>
    <%= link_to "← All Rosters", nfl_rosters_path, class: "text-secondary hover:text-primary text-sm" %>
  </div>

  <p class="text-secondary text-sm mb-6">
    Drag rows within a position to reorder depth. Click the lock icon to pin an entry — locked rows hold their depth across re-seeds.
  </p>

  <%
    # DG3 — the two-level side→position grid. Each side is a board GROUP; each of its
    # position lanes is a column whose cards are the entries (already depth-sorted by
    # the controller). The card body is depth_charts/_entry_card; grade + starter slot
    # + the id/zone attr names arrive per-card via card_locals.
    board_groups = %w[offense defense special_teams].filter_map do |side|
      lanes = @entries_by_side[side]
      next if lanes.blank?
      {
        key: side,
        label: side.tr("_", " "),
        cols_class: "grid-cols-1 md:grid-cols-2",
        columns: lanes.map do |position, entries|
          { key: position, label: position, cards: entries, count: entries.size }
        end
      }
    end

    card_locals = lambda do |entry|
      {
        grade:        @grades_by_person[entry.person_slug],
        starter_slot: @starter_labels[entry.person_slug],
        id_attr:      "id",
        zone_attr:    "position"
      }
    end
  %>

  <%# The board — rendered by the engine primitive. group: false keeps a drag WITHIN
      its lane (a player never changes position), so there is no move_url; the reorder
      POSTs the lane's DOM-ordered entry_ids to Studio::Board::Reorderable, which
      restamps depths 1..N skipping locked. locked_selector pins starters; the drag
      handle is .dc-handle; toasts off (the reorder is silent, alert on failure);
      on_drop_hook renumbers the visible depth column. %>
  <%= render "studio/board/board",
        groups: board_groups,
        card_partial: "depth_charts/entry_card",
        card_as: :entry,
        card_locals: card_locals,
        reorder_url: reorder_depth_chart_path(@team.slug),
        reorder_payload: :entry_ids,
        group: false,
        id_attr: "id",
        zone_attr: "position",
        handle: ".dc-handle",
        locked_selector: ".kanban-locked",
        on_drop_hook: "depthChartRenumber",
        toasts: false,
        empty_label: "—" %>
</section>
