#!/usr/bin/env ruby
# frozen_string_literal: true

# archive-docs — retire frozen doc snapshots out of the live tree, and roll over
# the delete-later ledger.
#
#   bin/archive-docs                        # perform it
#   bin/archive-docs --dry-run              # report only, change nothing
#   bin/archive-docs --ledger-cutoff=2026-08-09
#   bin/archive-docs --json                 # machine summary only
#
# `bin/release archive` drives this beside the log sweep, same contract:
# --dry-run previews, the confirm authorizes it. Nothing is ever deleted; every
# retirement is a `git mv` into docs/agents/archive/. Files are left in place and
# NAMED in the report whenever something still-live cites them — a referenced
# snapshot is someone's live citation, and the referrer gets fixed first,
# deliberately, rather than being silently orphaned.
#
# Moves are STAGED, not committed: bin/release archive already commits the
# ledger artifact, and a standalone run leaves a reviewable `git status`.

require "fileutils"
require "json"
require_relative "lib/docs_archive"
require_relative "lib/ledger_guard"
require_relative "lib/repo_root"

DRY       = ARGV.include?("--dry-run")
JSON_ONLY = ARGV.include?("--json")
# The repo whose docs are swept: an explicit --repo, else the checkout this
# script ships in (a worktree ships its own bin/, so it sweeps its own tree).
REPO      = (ARGV.grep(/\A--repo=/).first&.split("=", 2)&.last) ||
            RepoRoot.git_toplevel(__dir__) ||
            File.expand_path("..", __dir__)
CUTOFF    = ARGV.grep(/\A--ledger-cutoff=/).first&.split("=", 2)&.last

def say(message = "")
  puts(message) unless JSON_ONLY
end

# THE MOVE-NEVER-DELETE INVARIANT, checked against HEAD at both ends of the roll.
#
# BEFORE, because this beat is where the damage was FIRST observable and where it
# became permanent: a teardown driven from a desk carrying a stale bin/agent-worktree
# overwrites a dated row in the hub's working tree, and the next `bin/release archive`
# commits the loss. Refusing here means the sweep never stages on top of a ledger that
# has already lost history — and the row is still one `git show HEAD:` away.
#
# THE EXIT CODE ONLY PROTECTS ANYTHING BECAUSE THE CALLER READS IT. This refusal shipped
# INERT: bin/release.rb's sweep_docs returns [out, ok] and BOTH call sites took `.first`,
# so `bin/release archive` printed the warning and went on to commit the ledger and its
# archive to `release` — committing the very loss refused here. Exiting non-zero is half a
# guard; the other half is bin/release.rb's abort, pinned by
# test/lib/release_archive_docs_refusal_test.rb. Do not describe this as a guarantee
# without checking that both halves are still in place.
#
# AFTER, because the roll itself writes both files, and a post-condition on a
# move is cheap: the union it produced must still hold every row it was handed.
#
# A dry run REPORTS and exits 0 — it changes nothing, and a preview that returns
# failure wedges the callers that preview before confirming. An APPLY refuses.
def refuse_if_ledger_lost!(repo, when_label, dry:)
  losses = LedgerGuard.lost_against_ref(repo, "HEAD")
  return if losses.empty?

  warn "==> DELETE-LATER LEDGER: rows destroyed (#{when_label})"
  warn LedgerGuard.report(losses, base_label: "HEAD")
  exit 1 unless dry
rescue LedgerGuard::UnreadableBase => e
  # "I could not read HEAD's ledger" is not "HEAD's ledger was empty". The comparison
  # certified nothing, so an APPLY refuses exactly as it does for a real loss rather than
  # rolling on top of a baseline it never saw. A dry run still reports and exits 0.
  warn "==> DELETE-LATER LEDGER: baseline unreadable (#{when_label})"
  warn "    #{e.message}"
  exit 1 unless dry
end

# --- the doc sweep -----------------------------------------------------------
# Ledger FIRST, on purpose. Rows in delete-later.md cite dated docs, so a row
# that rolls over stops pinning the doc it named — and that doc becomes
# archivable in the SAME run instead of waiting for the next one.
refuse_if_ledger_lost!(REPO, "already lost before this sweep ran", dry: DRY)
ledger = DocsArchive.roll_ledger!(REPO, cutoff: CUTOFF, apply: !DRY)
refuse_if_ledger_lost!(REPO, "lost by the rollover itself", dry: DRY) unless DRY

plan = DocsArchive.plan(REPO)

say("==> Archiving frozen doc snapshots#{DRY ? ' (dry-run — nothing will change)' : ''}")
say("    repo: #{REPO}")
say("    → #{DocsArchive::ARCHIVE_DIR}/ (git mv; nothing is ever deleted)")
say

if plan[:moves].empty?
  say("-- nothing to retire; the live tree carries no unreferenced snapshots.")
else
  say("-- retiring #{plan[:moves].size} frozen snapshot(s):")
  plan[:moves].each { |move| say(format("     %-58s → %s", move[:from], move[:to])) }
end

if plan[:skipped].any?
  say
  say("==> SKIPPED — still referenced by the live tree (fix the referrer first):")
  plan[:skipped].each do |entry|
    say(format("     %-58s cited by: %s", entry[:path], entry[:referrers].join(", ")))
  end
end

moved = DRY ? plan[:moves].size : DocsArchive.apply_moves!(REPO, plan[:moves])

# --- the ledger --------------------------------------------------------------

say
if ledger[:rolled].positive?
  say("==> Ledger rollover: #{DRY ? 'would roll' : 'rolled'} #{ledger[:rolled]} resolved row(s) " \
      "older than #{ledger[:cutoff]} → #{DocsArchive::LEDGER_ARCHIVE}")
  say("    Undated rows (\"pending approval\", \"reference only\") are UNRESOLVED and always stay.")
else
  say("==> Ledger rollover: nothing older than #{ledger[:cutoff] || 'n/a'} to roll.")
end

say
say("==> #{DRY ? 'Would retire' : 'Retired'} #{moved} doc(s); " \
    "#{plan[:skipped].size} left in place as still-referenced")

puts DocsArchive.summary_line(
  dry_run: DRY,
  moved: moved,
  moved_paths: plan[:moves].map { |m| m[:from] },
  skipped: plan[:skipped].map { |s| { path: s[:path], referrers: s[:referrers] } },
  ledger_rolled: ledger[:rolled],
  ledger_cutoff: ledger[:cutoff]
)
