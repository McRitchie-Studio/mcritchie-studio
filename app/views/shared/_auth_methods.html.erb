<%# Shared passwordless auth surface — magic-link email + Google + Solana wallet.
    Each method renders only when enabled via Studio.auth_methods. Used by both
    the login (sessions/new) and signup (registrations/new) pages; the create-or-
    login magic link makes the two paths identical. %>
<div class="card p-8 shadow">
  <% if Studio.auth_method?(:magic_link) %>
    <%= form_tag magic_link_request_path, method: :post do %>
      <div class="mb-4">
        <label for="email" class="block text-sm text-secondary mb-2 font-medium">Email</label>
        <input type="email" name="email" id="email" value="<%= params[:email] %>" autofocus required
               class="input-field" placeholder="you@example.com">
      </div>
      <button type="submit" class="btn btn-primary btn-lg w-full">
        Email me a sign-in link
      </button>
    <% end %>
    <p class="text-center text-muted text-xs mt-3">
      No password needed — we'll email you a one-time link.
    </p>
  <% end %>

  <% if Studio.auth_method?(:magic_link) && (Studio.auth_method?(:google) || Studio.auth_method?(:wallet)) %>
    <div class="relative my-6">
      <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-subtle"></div></div>
      <div class="relative flex justify-center text-sm"><span class="bg-surface px-3 text-secondary">or</span></div>
    </div>
  <% end %>

  <% if Studio.auth_method?(:google) %>
    <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false },
        class: "btn btn-google btn-lg w-full flex items-center justify-center gap-3" do %>
      <svg class="w-5 h-5" viewBox="0 0 24 24" aria-hidden="true"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
      Continue with Google
    <% end %>
  <% end %>

  <% if Studio.auth_method?(:wallet) %>
    <button type="button"
            onclick="window.studioWalletLogin().catch(function(e){ alert(e.message || 'Wallet sign-in failed'); })"
            class="btn btn-secondary btn-lg w-full flex items-center justify-center gap-3 mt-3">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 12h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
      Connect Wallet
    </button>
    <p class="text-center text-muted text-xs mt-2">Phantom wallet (Solana)</p>
  <% end %>
</div>
