<% deployment = @duration_metrics.dig("release") || {} %>
<% stages = @duration_metrics.dig("stages") || {} %>
<% tasks = @duration_metrics["tasks"] || [] %>
<% release_steps = @duration_metrics["release_steps"] || {} %>
<% integrity = @duration_metrics["integrity"] || {} %>

<div class="max-w-7xl mx-auto px-4 py-6">
  <div class="flex items-start justify-between gap-4 flex-wrap mb-6">
    <div>
      <div class="flex items-center gap-3 text-sm text-muted mb-2">
        <%= link_to "Deployments", deployments_path, class: "hover:text-heading" %>
        <span>/</span>
        <%= link_to "All Deployments", all_deployments_path, class: "hover:text-heading" %>
        <span>/</span>
        <span class="font-mono"><%= @release.slug %></span>
      </div>
      <h2 class="text-3xl font-extrabold text-heading tracking-tight"><%= @release.slug %></h2>
    </div>
    <div class="flex items-center gap-2">
      <span class="rounded px-2 py-0.5 text-xs font-bold <%= release_state_classes(@release.state) %>"><%= @release.state %></span>
      <%= link_to "All Deployments", all_deployments_path, class: "btn btn-neutral btn-sm" %>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-5 gap-3 mb-6">
    <div class="rounded-lg border border-subtle bg-surface px-3 py-3">
      <p class="text-[10px] uppercase tracking-wide text-muted font-semibold">Created</p>
      <p class="mt-1 font-mono text-sm text-heading"><%= release_duration_time(deployment["started_at"] || @release.created_at) %></p>
    </div>
    <div class="rounded-lg border border-subtle bg-surface px-3 py-3">
      <p class="text-[10px] uppercase tracking-wide text-muted font-semibold">Assembled</p>
      <p class="mt-1 font-mono text-sm text-heading"><%= release_duration_time(deployment["assembled_at"] || @release.assembled_at) %></p>
    </div>
    <div class="rounded-lg border border-subtle bg-surface px-3 py-3">
      <p class="text-[10px] uppercase tracking-wide text-muted font-semibold">Confirmed</p>
      <p class="mt-1 font-mono text-sm text-heading"><%= release_duration_time(deployment["confirmed_at"] || @release.confirmed_at) %></p>
    </div>
    <div class="rounded-lg border border-subtle bg-surface px-3 py-3">
      <p class="text-[10px] uppercase tracking-wide text-muted font-semibold">Shipped</p>
      <p class="mt-1 font-mono text-sm text-heading"><%= release_duration_time(deployment["shipped_at"] || @release.shipped_at) %></p>
    </div>
    <div class="rounded-lg border border-subtle bg-surface px-3 py-3">
      <p class="text-[10px] uppercase tracking-wide text-muted font-semibold">Deployment</p>
      <p class="mt-1 font-mono text-xl font-bold text-heading"><%= release_duration_label(deployment["deployment_seconds"]) %></p>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-6">
    <section class="rounded-lg border border-subtle bg-surface p-4">
      <div class="flex items-center justify-between gap-3 mb-3">
        <h3 class="text-lg font-bold text-heading">Stage Averages</h3>
        <span class="text-xs text-muted">Cached <%= release_duration_time(@duration_metrics["cached_at"]) %></span>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <% Release::DurationCache::STAGE_DEFINITIONS.each_key do |key| %>
          <% row = stages[key] || {} %>
          <div class="rounded border border-subtle bg-surface-alt px-3 py-3">
            <p class="text-[10px] uppercase tracking-wide text-muted font-semibold"><%= release_duration_stage_name(key) %></p>
            <p class="mt-1 font-mono text-xl font-bold text-heading"><%= release_duration_label(row["average_seconds"]) %></p>
            <p class="mt-1 text-xs text-muted"><%= row["sample_count"].to_i %> completed · <%= row["missing_count"].to_i %> missing</p>
          </div>
        <% end %>
      </div>
    </section>

    <section class="rounded-lg border border-subtle bg-surface p-4">
      <h3 class="text-lg font-bold text-heading mb-3">Integrity</h3>
      <dl class="grid grid-cols-2 gap-3 text-sm">
        <div>
          <dt class="text-[10px] uppercase tracking-wide text-muted font-semibold">Task Transitions</dt>
          <dd class="font-mono text-heading"><%= number_with_delimiter(integrity["task_event_count"].to_i) %></dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-wide text-muted font-semibold">Release Steps</dt>
          <dd class="font-mono text-heading"><%= number_with_delimiter(integrity["release_event_count"].to_i) %></dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-wide text-muted font-semibold">Missing Task Durations</dt>
          <dd class="font-mono text-heading"><%= number_with_delimiter(integrity["missing_task_stage_spans"].to_i) %></dd>
        </div>
        <div>
          <dt class="text-[10px] uppercase tracking-wide text-muted font-semibold">Missing Release Steps</dt>
          <dd class="font-mono text-heading"><%= number_with_delimiter(integrity["missing_release_steps"].to_i) %></dd>
        </div>
      </dl>
    </section>
  </div>

  <section class="rounded-lg border border-subtle bg-surface mb-6 overflow-hidden">
    <div class="px-4 py-3 border-b border-subtle">
      <h3 class="text-lg font-bold text-heading">Member Tasks</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-surface-alt text-left text-xs uppercase tracking-wide text-muted">
          <tr>
            <th class="px-4 py-3 font-semibold">Task</th>
            <th class="px-4 py-3 font-semibold">Stage</th>
            <% Release::DurationCache::STAGE_DEFINITIONS.each_key do |key| %>
              <th class="px-4 py-3 font-semibold text-right"><%= release_duration_stage_name(key) %></th>
            <% end %>
          </tr>
        </thead>
        <tbody class="divide-y divide-subtle">
          <% tasks.each do |row| %>
            <tr class="hover:bg-surface-alt/70">
              <td class="px-4 py-3">
                <%= link_to row["title"], task_path(row["slug"]), class: "text-primary hover:underline" %>
                <p class="font-mono text-xs text-muted"><%= row["slug"] %></p>
              </td>
              <td class="px-4 py-3 text-secondary"><%= row["stage"] %></td>
              <% Release::DurationCache::STAGE_DEFINITIONS.each_key do |key| %>
                <% span = row.dig("stages", key) || {} %>
                <td class="px-4 py-3 text-right">
                  <span class="font-mono text-heading"><%= release_duration_label(span["seconds"]) %></span>
                  <span class="block text-[10px] uppercase tracking-wide text-muted"><%= span["status"] %></span>
                </td>
              <% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>

  <section class="rounded-lg border border-subtle bg-surface overflow-hidden">
    <div class="px-4 py-3 border-b border-subtle">
      <h3 class="text-lg font-bold text-heading">Release Steps</h3>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-surface-alt text-left text-xs uppercase tracking-wide text-muted">
          <tr>
            <th class="px-4 py-3 font-semibold">Step</th>
            <th class="px-4 py-3 font-semibold">Status</th>
            <th class="px-4 py-3 font-semibold">Started</th>
            <th class="px-4 py-3 font-semibold">Completed</th>
            <th class="px-4 py-3 font-semibold text-right">Duration</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-subtle">
          <% release_steps.each do |_step, row| %>
            <tr class="hover:bg-surface-alt/70">
              <td class="px-4 py-3 text-heading"><%= row["label"] %></td>
              <td class="px-4 py-3 text-secondary"><%= row["status"] %></td>
              <td class="px-4 py-3 text-secondary whitespace-nowrap"><%= release_duration_time(row["started_at"]) %></td>
              <td class="px-4 py-3 text-secondary whitespace-nowrap"><%= release_duration_time(row["completed_at"]) %></td>
              <td class="px-4 py-3 text-right font-mono text-heading"><%= release_duration_label(row["seconds"]) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
</div>
