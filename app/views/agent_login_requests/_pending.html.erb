<%# Open admin login requests (AgentLoginRequest), for an admin only. Each row
    says, in plain words, which session asks, why (the session's latest narrated
    work), what Approve grants, and when the request lapses; then it carries the
    server-issued slug the requesting CLI prints, the one-time launch code and the
    Approve and Decline taps. The slug is the handle to match: the soul and the
    harness session id are whatever the poster sent. Rendered by the page, never
    by a broadcast, so the code reaches no other viewer.

    THE TAPS ARE PLAIN FORMS (button_to), task devops-admin-login-requests. They
    were buttons with an inline onclick that called a global defined by an inline
    <script> in this partial and posted with fetch. On 2026-11-10 the operator's
    Approve ran in the browser (a CSP report recorded the inline handler on
    /devops/tasks) and the server recorded no decision, so the requesting session
    polled 409 pending until the launch code granted it. A form carries its own
    authenticity token, needs no page script to have run, posts even before
    Turbo loads, and lands back on this page with the outcome as a flash. It also
    stays working when the CSP flips to enforcing, which blocks inline handlers. %>
<% logins = admin? ? AgentLoginRequest.awaiting.to_a : [] %>
<% if logins.any? %>
  <% admin_hours = (AgentSession::TTL.fetch("admin") / 1.hour).to_i %>
  <div class="mb-4 space-y-2" data-test="admin-login-requests" id="admin-login-requests">
    <% logins.each do |login| %>
      <% soul_name = Agent.where(slug: login.soul).pick(:name).presence || login.soul.to_s.titleize %>
      <% activity = AgentActivity.for_session(login.harness_session_id).order(:opened_at, :id).last %>
      <div id="admin-login-<%= login.slug %>" data-test="admin-login-request" data-soul="<%= login.soul %>"
           class="rounded-lg px-3 py-2 <%= status_tone(:warning, :panel) %>">
        <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
          <% if login.harness_key? %>
            <span class="text-sm font-semibold text-heading" data-test="harness-key-request"
                  title="A harness key lets this machine log a builder or a reviewer in to a task. It has no expiry; revoke it with bin/rails agent_sessions:revoke.">Harness key · <%= login.label %></span>
          <% else %>
            <span class="text-sm font-semibold text-heading">Admin login · <%= soul_name %></span>
          <% end %>
          <code class="select-all font-mono text-xs font-semibold text-heading" data-test="admin-login-slug"
                title="Match this to the slug the agent's heartbeat printed before you approve or use the code"><%= login.slug %></code>
          <span class="text-3xs text-muted" data-test="admin-login-requested">asked <%= at_time_tag(login.requested_at) %></span>
          <%= render "tasks/window_chip", window: login.window %>
          <span class="flex items-center gap-2" data-test="admin-login-open">
            <span class="text-xs text-muted">Launch code</span>
            <code class="select-all font-mono text-sm font-bold tracking-widest text-heading" data-test="admin-login-code"><%= login.display_code %></code>
          </span>
          <span class="flex w-full items-center gap-2 sm:ml-auto sm:w-auto" data-test="admin-login-actions">
            <%= button_to "Approve", approve_agent_login_path(login.slug),
                  form: { class: "inline", data: { test: "admin-login-approve-form" } },
                  data: { test: "admin-login-approve", turbo_submits_with: "Granting…" },
                  title: login.harness_key? ? "Grant #{login.label} a harness key: it mints studio logins and has no expiry" : "Grant #{login.slug} an #{admin_hours}-hour admin session as #{soul_name}",
                  class: "shrink-0 rounded border border-primary bg-primary px-2 py-1 text-3xs font-bold uppercase tracking-wide text-white transition hover:brightness-110 disabled:cursor-wait disabled:opacity-60" %>
            <%= button_to "Decline", refuse_agent_login_path(login.slug),
                  form: { class: "inline", data: { test: "admin-login-refuse-form" } },
                  data: { test: "admin-login-refuse", turbo_submits_with: "Declining…" },
                  title: "Decline this request; nothing is granted",
                  class: "shrink-0 rounded border border-subtle bg-surface px-2 py-1 text-3xs font-bold uppercase tracking-wide text-body transition hover:bg-surface-alt disabled:cursor-wait disabled:opacity-60" %>
          </span>
        </div>
        <dl class="mt-2 grid gap-x-3 gap-y-1 text-xs text-body sm:grid-cols-[auto_1fr]" data-test="admin-login-explain">
          <dt class="font-semibold text-heading">Who asks</dt>
          <dd data-test="admin-login-who">
            <% if login.harness_key? %>
              The machine named <strong><%= login.label %></strong>, from harness session
            <% else %>
              <strong><%= soul_name %></strong>, from harness session
            <% end %>
            <code class="font-mono" title="Harness session <%= login.harness_session_id %>, as the poster sent it">…<%= login.harness_session_id.last(8) %></code><% if activity&.mascot.present? %> (<%= activity.mascot.to_s.titleize %>)<% end %>.
          </dd>
          <dt class="font-semibold text-heading">Why</dt>
          <dd data-test="admin-login-why">
            <% if activity %>
              Its latest work: “<%= truncate(activity.reason_slug, length: 160) %>”<% if activity.task_slug.present? %>, on task <%= link_to activity.task_slug, task_path(activity.task_slug), class: "font-mono underline" %><% end %>.
            <% else %>
              The session has narrated no work yet, so the hub cannot say. Ask the session before you approve.
            <% end %>
          </dd>
          <dt class="font-semibold text-heading">Approve grants</dt>
          <dd data-test="admin-login-grants">
            <% if login.harness_key? %>
              A harness key for <%= login.label %>. It logs builders and reviewers on that machine in to their tasks, and it has no expiry until you revoke it.
            <% else %>
              An <%= admin_hours %>-hour admin session as <%= soul_name %>: admin-tier calls to the hub API. It ends on its own after <%= admin_hours %> hours.
            <% end %>
            Decline grants nothing.
          </dd>
          <dt class="font-semibold text-heading">Expires</dt>
          <dd data-test="admin-login-expires">
            The request lapses <%= at_time_tag(login.window.ends_at) %> if nobody answers, and then nothing is granted.
            The launch code works until then too.
          </dd>
        </dl>
      </div>
    <% end %>
  </div>
<% end %>
