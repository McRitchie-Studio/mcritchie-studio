<% content_for(:title, "Alex · Learning Heartbeat") %>
<% content_for(:full_width, true) %>

<%# PLACEHOLDER — Alex learning / distillation heartbeat.
    The real view is a separate task (T2). This page exists only so the Alex
    avenue on the launcher has a stable destination (alex_heartbeat_path).
    TODO(T2 learning-heartbeat): replace this placeholder with the real
    heartbeat view (the atomic-trajectory grader from the prototype). %>
<section
  data-placeholder="alex-heartbeat"
  class="min-h-[calc(100vh-var(--nav-h,7rem))] flex items-center justify-center px-4 py-10"
>
  <div class="w-full max-w-2xl overflow-hidden rounded-xl border border-[#2a3240] bg-[#0b0f14] shadow-2xl shadow-black/60">
    <div class="flex items-center gap-2 border-b border-[#2a3240] bg-[#11161d] px-3 py-2.5">
      <span class="h-3 w-3 rounded-full bg-[#ff5f56]"></span>
      <span class="h-3 w-3 rounded-full bg-[#ffbd2e]"></span>
      <span class="h-3 w-3 rounded-full bg-[#27c93f]"></span>
      <span class="ml-2 font-mono text-[11.5px] text-[#5c6573]">alex — learning heartbeat</span>
    </div>

    <div class="px-5 py-6 font-mono text-[13px] text-[#e6edf3] sm:px-6">
      <p class="text-[#5c6573]">Entering as <span class="text-[#a78bfa]">Alex</span> …</p>
      <p class="mt-2 text-lg font-bold">Learning · distillation heartbeat</p>
      <p class="mt-2 leading-relaxed text-[#8b949e]">
        This avenue mines the session trajectory for insights — Alex grades each
        event, Mr. McRitchie grades Alex, and banked insights make the next agent
        smarter.
      </p>
      <p class="mt-4 inline-flex items-center gap-2 rounded-md border border-[#3a4150] bg-[#11161d] px-3 py-1.5 text-[12px] text-[#d29922]">
        ⟳ Coming soon — built in a follow-up task (T2).
      </p>
      <p class="mt-5">
        <%= link_to "‹ back to entry", launcher_path, class: "text-[#58a6ff] underline-offset-2 hover:underline" %>
      </p>
    </div>
  </div>
</section>
