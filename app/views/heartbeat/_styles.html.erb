<style>
  #alex-heartbeat {
    --hb-bg:#0d1117; --hb-panel:#161b22; --hb-panel2:#1c2330; --hb-line:#2a3240;
    --hb-txt:#e6edf3; --hb-muted:#8b949e; --hb-faint:#5c6573; --hb-accent:#58a6ff;
    --hb-mascot:#a78bfa; --hb-good:#3fb950; --hb-not:#f85149; --hb-bank:#fbbf24;
    display:flex; flex-direction:column;
    height:calc(100vh - var(--nav-h, 7rem));
    background:var(--hb-bg); color:var(--hb-txt);
    padding:18px 22px 22px; font-size:13px; line-height:1.5;
  }
  #alex-heartbeat .hb-head { flex:0 0 auto; }
  #alex-heartbeat .hb-topbar { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; flex-wrap:wrap; border-bottom:1px solid var(--hb-line); padding-bottom:14px; }
  #alex-heartbeat .hb-title h1 { margin:0; font-size:19px; font-weight:700; }
  #alex-heartbeat .hb-title p { margin:4px 0 0; color:var(--hb-muted); font-size:12.5px; max-width:64ch; }
  #alex-heartbeat .hb-stats { display:flex; gap:8px; flex-wrap:wrap; }
  #alex-heartbeat .hb-stat { background:var(--hb-panel); border:1px solid var(--hb-line); border-radius:9px; padding:7px 11px; text-align:center; min-width:62px; }
  #alex-heartbeat .hb-stat b { display:block; font-size:16px; }
  #alex-heartbeat .hb-stat span { font-size:10px; color:var(--hb-muted); text-transform:uppercase; letter-spacing:.4px; }
  #alex-heartbeat .hb-toolbar { display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin:14px 0; }
  #alex-heartbeat .hb-lab { font-size:11px; color:var(--hb-muted); text-transform:uppercase; letter-spacing:.5px; }
  #alex-heartbeat .hb-sel { background:var(--hb-panel); color:var(--hb-txt); border:1px solid var(--hb-line); border-radius:8px; padding:6px 9px; font-size:12px; max-width:60vw; }
  #alex-heartbeat .hb-legend { color:var(--hb-faint); font-size:11.5px; margin-left:auto; display:flex; gap:12px; flex-wrap:wrap; align-items:center; }
  #alex-heartbeat .hb-legend b { color:var(--hb-muted); font-weight:600; }

  #alex-heartbeat .hb-scroll { flex:1 1 auto; overflow:auto; border:1px solid var(--hb-line); border-radius:12px; }
  #alex-heartbeat table.hb-tbl { border-collapse:collapse; width:100%; min-width:1320px; font-size:12.5px; }
  #alex-heartbeat thead th { position:sticky; top:0; background:var(--hb-panel2); text-align:left; font-size:10px; text-transform:uppercase; letter-spacing:.5px; color:var(--hb-muted); padding:9px 10px; border-bottom:1px solid var(--hb-line); white-space:nowrap; z-index:3; }
  #alex-heartbeat tbody td { padding:9px 10px; border-bottom:1px solid var(--hb-line); vertical-align:top; }
  #alex-heartbeat tr.hb-row { cursor:pointer; }
  #alex-heartbeat tr.hb-row td:first-child { box-shadow:inset 3px 0 0 var(--hb-edge, transparent); }
  #alex-heartbeat tr.hb-row:hover { background:var(--hb-panel2); }
  #alex-heartbeat .hb-seq { color:var(--hb-faint); font-family:ui-monospace,monospace; white-space:nowrap; }
  #alex-heartbeat .hb-slug { font-weight:600; }
  #alex-heartbeat .hb-result { color:var(--hb-muted); }
  #alex-heartbeat .hb-meta { color:var(--hb-muted); white-space:nowrap; }
  #alex-heartbeat .hb-mono { font-family:ui-monospace,"SF Mono",Menlo,monospace; font-size:11.5px; }
  #alex-heartbeat .hb-mascot { color:var(--hb-mascot); white-space:nowrap; }
  #alex-heartbeat .hb-actor { font-size:10px; color:var(--hb-faint); text-transform:uppercase; letter-spacing:.4px; cursor:help; }
  #alex-heartbeat .hb-stage-cell { cursor:help; }
  #alex-heartbeat .hb-chip { font-size:10px; font-weight:700; border-radius:5px; padding:1px 7px; border:1px solid currentColor; text-transform:uppercase; letter-spacing:.4px; cursor:help; }
  #alex-heartbeat .hb-outcome { font-size:8.5px; font-weight:700; letter-spacing:.4px; line-height:1; padding:2px 5px; border-radius:4px; border:1px solid currentColor; text-transform:uppercase; }

  #alex-heartbeat tr.hb-grouphead td { background:var(--hb-panel); border-bottom:1px solid var(--hb-line); padding:8px 10px; cursor:pointer; position:sticky; top:31px; z-index:2; }
  #alex-heartbeat tr.hb-grouphead:hover td { background:var(--hb-panel2); }
  #alex-heartbeat .hb-groupinner { display:flex; align-items:center; gap:10px; flex-wrap:wrap; }
  #alex-heartbeat .hb-groupcount { color:var(--hb-faint); font-size:11px; }
  #alex-heartbeat .hb-groupsub { color:var(--hb-muted); font-size:11px; margin-left:auto; font-family:ui-monospace,monospace; }
  #alex-heartbeat .hb-chev { display:inline-block; transition:transform .15s; color:var(--hb-faint); font-size:11px; }
  #alex-heartbeat .hb-chev-open { transform:rotate(90deg); }

  /* Activity table — activities are the primary rows; expanding one drills into its
     attributed raw actions (read-only). Wider now: the activity rows carry the
     rolled-up Pokemon / Model / Tokens / Cost columns plus an activity-grade affordance. */
  /* Narrower now: merging Model+Tokens into one column and stacking the narration /
     avatars trims the table's minimum width the operator asked to reclaim. */
  #alex-heartbeat table.hb-evt-tbl { min-width:980px; }
  #alex-heartbeat .hb-evttime { font-size:10px; margin-top:2px; color:var(--hb-faint); }
  #alex-heartbeat .hb-submascot { color:var(--hb-mascot); opacity:.85; }
  /* Compact Agent cell — a tight vertical stack of "small avatar + NAME" rows (the
     original 📋 Avi / ✦ Magikarp text layout, with the real avatar image in place of
     the emoji). The acting SOUL rides ON TOP (bold, in its own tint via inline color)
     over the base session mascot BENEATH it (the mascot's purple identity tint, dimmed
     when a soul is present). A nil agent collapses to a SINGLE mascot row on one line.
     Faces reuse components/agent_avatar at the compact "xxs" (24px) size; the name
     rides inline beside each face so a glance reads WHO. */
  /* Agent cell: an overlapping vertical AVATAR cluster (soul ON TOP of mascot) on the
     left, a NAME column on the right — primary name over sub name, decoupled from the
     avatars. */
  #alex-heartbeat .hb-agentstack { display:flex; align-items:center; gap:8px; }
  #alex-heartbeat .hb-avatars { display:flex; flex-direction:column; align-items:center; }
  #alex-heartbeat .hb-ava { position:relative; display:inline-flex; }
  #alex-heartbeat .hb-avatars .hb-soulava { z-index:2; }
  #alex-heartbeat .hb-avatars .hb-mascotava { z-index:1; }
  /* Overlap ONLY when a soul sits on top — a solo mascot keeps normal alignment. */
  #alex-heartbeat .hb-avatars .hb-soulava + .hb-mascotava { margin-top:-14px; }
  #alex-heartbeat .hb-soulava > .rounded-full { box-shadow:0 0 0 1.5px currentColor; border-radius:9999px; }
  #alex-heartbeat .hb-mascotava > .rounded-full { box-shadow:0 0 0 1px var(--hb-line); border-radius:9999px; }
  #alex-heartbeat .hb-names { display:flex; flex-direction:column; line-height:1.15; }
  #alex-heartbeat .hb-nameprimary { font-weight:700; color:var(--hb-txt); font-size:12px; white-space:nowrap; }
  #alex-heartbeat .hb-namesub { font-weight:400; color:var(--hb-muted); font-size:11px; white-space:nowrap; }
  /* Center-justify the whole table — cells centered, flex cells centered too. */
  #alex-heartbeat .hb-tbl th, #alex-heartbeat .hb-tbl td { text-align:left; vertical-align:middle; }
  #alex-heartbeat .hb-avatars { align-items:center; }
  #alex-heartbeat .hb-modeltok, #alex-heartbeat .hb-narr, #alex-heartbeat .hb-subnarr { align-items:flex-start; }
  /* Agent cell stays LEFT-justified: cluster flush-left, name snug beside the avatar. */
  #alex-heartbeat .hb-agentstack { justify-content:flex-start; }
  #alex-heartbeat .hb-names { align-items:flex-start; }
  /* Command / fallback status / task merged into one stacked cell to save horizontal space. */
  #alex-heartbeat .hb-sat { display:flex; flex-direction:column; align-items:flex-start; gap:2px; }
  #alex-heartbeat .hb-satline { display:flex; align-items:center; gap:6px; }
  #alex-heartbeat .hb-satcmd { min-height:22px; max-width:340px; display:flex; align-items:center; }
  #alex-heartbeat .hb-satcmd .hb-keycode { max-width:240px; }
  #alex-heartbeat .hb-bullet { color:var(--hb-muted); font-size:10.5px; line-height:1; }
  #alex-heartbeat .hb-outcome-badge { display:inline-flex; align-items:center; }
  #alex-heartbeat .hb-outcome-badge .badge { font-size:8.5px; line-height:1; padding:2px 5px; border-radius:4px; }
  #alex-heartbeat .hb-clickrow { cursor:pointer; }
  #alex-heartbeat .hb-taskcell { color:var(--hb-muted); font-size:10.5px; }
  #alex-heartbeat .hb-gradehint { color:var(--hb-faint); font-style:italic; font-size:10.5px; }
  /* Two-line narration — the reason on line 1, the "-> outcome" beneath it, so the
     activity cell stays narrow instead of running reason and outcome across one wide row. */
  #alex-heartbeat .hb-narr { min-width:220px; }
  #alex-heartbeat .hb-narrline { display:block; }
  #alex-heartbeat .hb-span-title { display:flex; align-items:center; flex-wrap:wrap; gap:6px; width:fit-content; max-width:100%; cursor:pointer; }
  #alex-heartbeat .hb-inline-actions { color:var(--hb-muted); font-family:ui-monospace,monospace; font-size:11px; white-space:nowrap; }
  #alex-heartbeat .hb-inline-status { display:inline-flex; align-items:center; }
  #alex-heartbeat .hb-narr-result { margin-top:2px; }
  /* Merged Model / Tokens column — model on top, the compact in/out tokens beneath. */
  #alex-heartbeat .hb-modeltok .hb-mt-model { display:block; }
  #alex-heartbeat .hb-modeltok .hb-mt-tokens { display:block; margin-top:2px; color:var(--hb-faint); font-size:11px; }
  /* Inline activity quick-grade — the good/not radios for both graders on the activity row,
     laid out HORIZONTALLY side by side (A ● Good ● Not   M ● Good ● Not) on ONE row so
     the Grade cell reads short-and-wide instead of tall, sitting above the "grade ▸"
     button + markers. Reuses the .hb-rb radio chips; each grader group carries its
     A / M lane letter. */
  #alex-heartbeat .hb-evtquick { display:flex; flex-direction:row; flex-wrap:nowrap; align-items:center; gap:14px; margin-bottom:5px; }
  #alex-heartbeat .hb-evtquick-form { display:inline-flex; align-items:center; gap:5px; margin:0; }
  #alex-heartbeat .hb-evtquick-role { font-size:9px; font-weight:700; color:var(--hb-faint); letter-spacing:.4px; width:9px; }
  /* A tokens/cost cell that INHERITS its turn's spend — a non-primary tool-call of
     a shared source_turn_uuid. Faded (never recolored to an outcome hue) so it reads
     as "same turn, already counted", not new spend; the value itself is unchanged. */
  #alex-heartbeat td.hb-turn-shared { color:var(--hb-faint); opacity:.6; cursor:help; }
  #alex-heartbeat tr.hb-evtrow { cursor:pointer; }
  #alex-heartbeat tr.hb-evtrow td { background:var(--hb-panel); }
  #alex-heartbeat tr.hb-evtrow:hover td { background:var(--hb-panel2); }
  #alex-heartbeat tr.hb-evtrow td:first-child { box-shadow:inset 3px 0 0 var(--hb-edge, transparent); }
  #alex-heartbeat .hb-catchip { cursor:help; }
  #alex-heartbeat .hb-span .hb-slug { color:var(--hb-txt); }
  #alex-heartbeat .hb-arrow { color:var(--hb-faint); margin:0 6px; }
  #alex-heartbeat .hb-inprogress { color:var(--hb-muted); font-style:italic; }
  #alex-heartbeat .hb-count { color:var(--hb-muted); font-family:ui-monospace,monospace; }

  #alex-heartbeat tr.hb-subrow { cursor:pointer; }
  #alex-heartbeat tr.hb-subrow td { background:var(--hb-bg); }
  #alex-heartbeat tr.hb-subrow:hover td { background:var(--hb-panel2); }
  #alex-heartbeat tr.hb-subrow td:first-child { box-shadow:inset 3px 0 0 var(--hb-edge, transparent); padding-left:24px; }
  #alex-heartbeat tr.hb-subrow.hb-subempty { cursor:default; }
  #alex-heartbeat tr.hb-subrow.hb-subempty td { color:var(--hb-faint); font-style:italic; }
  #alex-heartbeat .hb-kind { color:var(--hb-txt); }
  #alex-heartbeat .hb-kindline { display:flex; align-items:center; gap:8px; }
  #alex-heartbeat .hb-subseq { color:var(--hb-faint); }
  #alex-heartbeat tr.hb-subrow td.hb-subseq-gutter { padding-left:10px; }
  #alex-heartbeat .hb-subnarr { display:flex; flex-direction:column; gap:3px; }
  #alex-heartbeat .hb-subtitle { display:flex; align-items:center; flex-wrap:wrap; gap:6px; }
  #alex-heartbeat .hb-subslug { color:var(--hb-txt); }
  #alex-heartbeat .hb-subinput { color:var(--hb-faint); margin-left:0; }
  #alex-heartbeat tbody.hb-unlabeled tr.hb-evtrow td { border-top:1px solid var(--hb-line); }

  /* Key-method chip — [lang badge | code | copy]. The one load-bearing call of a
     span/action, copyable. Lang badge tints by language; the chip never wraps —
     long code ellipsizes with the full call on the title hover + the copy button. */
  #alex-heartbeat .hb-keychip { display:inline-flex; align-items:stretch; max-width:100%; border:1px solid var(--hb-line); border-radius:6px; overflow:hidden; background:var(--hb-panel); vertical-align:middle; }
  #alex-heartbeat .hb-keylang { display:inline-flex; align-items:center; padding:0 6px; font-size:9px; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:var(--hb-muted); background:var(--hb-panel2); border-right:1px solid var(--hb-line); }
  #alex-heartbeat .hb-keychip[data-lang="bash"] .hb-keylang { color:var(--hb-good); }
  #alex-heartbeat .hb-keychip[data-lang="ruby"] .hb-keylang { color:var(--hb-not); }
  #alex-heartbeat .hb-keychip[data-lang="sql"]  .hb-keylang { color:var(--hb-accent); }
  #alex-heartbeat .hb-keychip[data-lang="js"]   .hb-keylang { color:var(--hb-bank); }
  #alex-heartbeat .hb-keycode { padding:1px 7px; font-size:10.5px; color:var(--hb-txt); max-width:300px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  #alex-heartbeat .hb-keycopy { border:0; border-left:1px solid var(--hb-line); background:transparent; color:var(--hb-muted); cursor:pointer; padding:0 7px; font-size:10.5px; line-height:1; }
  #alex-heartbeat .hb-keycopy:hover { color:var(--hb-accent); background:var(--hb-panel2); }
  /* An action's goal summary — shown under its command chip in the command/task cell. */
  #alex-heartbeat .hb-action-summary { color:var(--hb-muted); font-size:11px; font-style:normal; }
  #alex-heartbeat .hb-gradehint .hb-taskcell { color:var(--hb-muted); font-style:normal; }

  #alex-heartbeat .hb-empty { flex:1 1 auto; display:flex; flex-direction:column; align-items:center; justify-content:center; text-align:center; gap:8px; border:1px dashed var(--hb-line); border-radius:12px; color:var(--hb-muted); padding:40px 24px; }
  #alex-heartbeat .hb-empty b { color:var(--hb-txt); font-size:15px; }
  #alex-heartbeat .hb-empty a { color:var(--hb-accent); }

  /* T5 feedback layer — buttons, inline radios, the per-action drawer, markers */
  #alex-heartbeat .hb-btn { background:var(--hb-panel); color:var(--hb-txt); border:1px solid var(--hb-line); border-radius:8px; padding:7px 12px; cursor:pointer; font-size:12.5px; text-decoration:none; display:inline-flex; align-items:center; gap:6px; line-height:1; }
  #alex-heartbeat .hb-btn:hover { border-color:var(--hb-accent); }
  #alex-heartbeat .hb-btn.primary { background:var(--hb-accent); color:#06131f; border-color:var(--hb-accent); font-weight:600; }
  #alex-heartbeat .hb-insightbtn { color:var(--hb-txt); }

  /* All Spans pager — the newer/older page controls beneath the cross-session table. */
  #alex-heartbeat .hb-pager { flex:0 0 auto; display:flex; align-items:center; justify-content:center; gap:12px; padding:12px 0 2px; }
  #alex-heartbeat .hb-pager-at { color:var(--hb-muted); font-size:12px; font-family:ui-monospace,monospace; }
  #alex-heartbeat .hb-pager-off { opacity:.4; cursor:default; }

  #alex-heartbeat .hb-fbcell { min-width:196px; }
  #alex-heartbeat .hb-fbinner { display:flex; flex-wrap:wrap; align-items:center; gap:6px; }
  #alex-heartbeat .hb-radioform { display:inline; margin:0; }
  #alex-heartbeat .hb-radiogrp { display:inline-flex; gap:4px; }
  #alex-heartbeat .hb-rb { display:inline-flex; align-items:center; gap:3px; font-size:9.5px; font-weight:700; letter-spacing:.3px; padding:2px 6px; border:1px solid var(--hb-line); border-radius:6px; color:var(--hb-muted); cursor:pointer; white-space:nowrap; }
  #alex-heartbeat .hb-rb input { margin:0; width:11px; height:11px; cursor:pointer; accent-color:var(--hb-accent); }
  #alex-heartbeat .hb-rb.on-good { color:var(--hb-good); border-color:var(--hb-good); }
  #alex-heartbeat .hb-rb.on-good input { accent-color:var(--hb-good); }
  #alex-heartbeat .hb-rb.on-not { color:var(--hb-not); border-color:var(--hb-not); }
  #alex-heartbeat .hb-rb.on-not input { accent-color:var(--hb-not); }
  #alex-heartbeat .hb-gradeclear { display:inline-flex; align-items:center; justify-content:center; width:14px; height:14px; flex:0 0 14px; padding:0; border:1px solid var(--hb-line); border-radius:50%; background:transparent; color:var(--hb-faint); font-size:10px; line-height:1; opacity:0; pointer-events:none; cursor:pointer; }
  #alex-heartbeat .hb-gradeclear.is-visible { opacity:1; pointer-events:auto; }
  #alex-heartbeat .hb-gradeclear.is-visible:hover { border-color:var(--hb-accent); color:var(--hb-txt); background:var(--hb-panel2); }
  #alex-heartbeat .hb-fbslugwrap { display:inline-flex; align-items:center; gap:4px; flex-wrap:wrap; }
  #alex-heartbeat .hb-fbslug { font-weight:600; font-size:12px; }
  #alex-heartbeat .hb-addfb { color:var(--hb-faint); font-size:11.5px; font-style:italic; }
  #alex-heartbeat .hb-longmark { font-size:11px; }
  #alex-heartbeat .hb-bankmark { color:var(--hb-bank); }
  #alex-heartbeat .hb-discardmark { color:var(--hb-faint); }

  /* Span quick-grade affordance on the event row — each grader's live marker
     (a disposition dot + slug) beside the row-level raw-action expand target. */
  #alex-heartbeat .hb-evtfbcell { white-space:normal; min-width:150px; }
  #alex-heartbeat .hb-evtfbstack { display:flex; flex-direction:column; align-items:flex-start; gap:4px; }
  #alex-heartbeat .hb-gradebtn { padding:4px 9px; font-size:11px; }
  #alex-heartbeat .hb-evtmarks { display:inline-flex; flex-direction:column; gap:3px; margin-top:5px; }
  #alex-heartbeat .hb-evtmarkslot { display:flex; align-items:center; min-height:17px; max-width:100%; }
  #alex-heartbeat .hb-evtmark { display:inline-flex; align-items:center; gap:5px; font-size:11px; }
  #alex-heartbeat .hb-evtmark-role { font-size:9px; font-weight:700; color:var(--hb-faint); letter-spacing:.4px; width:9px; }
  #alex-heartbeat .hb-evtdot { width:7px; height:7px; border-radius:50%; background:var(--hb-faint); flex:0 0 auto; }
  #alex-heartbeat .hb-evtdot.is-good { background:var(--hb-good); }
  #alex-heartbeat .hb-evtdot.is-not { background:var(--hb-not); }
  #alex-heartbeat .hb-evtmark-slug { color:var(--hb-txt); font-weight:600; max-width:220px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  #alex-heartbeat .hb-evtsaved { color:var(--hb-good); font-size:11.5px; margin-top:8px; font-weight:600; }

  /* Full-command view in the per-action drawer — the tool-call input + output in full
     (pretty-printed JSON when parseable, raw otherwise), each pane scrollable so a long
     bash body or file never blows out the drawer. */
  #alex-heartbeat .hb-cmd { margin-bottom:16px; }
  #alex-heartbeat .hb-cmdtoggle { padding:5px 10px; font-size:11.5px; margin-bottom:8px; }
  #alex-heartbeat .hb-cmdlabel { font-size:10px; text-transform:uppercase; letter-spacing:.5px; color:var(--hb-faint); margin:8px 0 4px; }
  #alex-heartbeat .hb-pre { background:var(--hb-bg); border:1px solid var(--hb-line); border-radius:8px; padding:9px 11px; margin:0; font-family:ui-monospace,"SF Mono",Menlo,monospace; font-size:11.5px; line-height:1.45; color:var(--hb-txt); white-space:pre-wrap; word-break:break-word; max-height:420px; overflow:auto; }

  #alex-heartbeat .hb-scrim { position:fixed; inset:0; background:rgba(0,0,0,.55); opacity:0; pointer-events:none; transition:opacity .15s; z-index:40; }
  #alex-heartbeat .hb-scrim.hb-scrim-open { opacity:1; pointer-events:auto; }
  #alex-heartbeat .hb-drawer { position:fixed; top:0; right:0; height:100%; width:min(1080px,92vw); background:var(--hb-panel); border-left:1px solid var(--hb-line); transform:translateX(100%); transition:transform .18s ease; z-index:50; overflow-y:auto; color:var(--hb-txt); }
  #alex-heartbeat .hb-drawer.hb-drawer-open { transform:none; }
  #alex-heartbeat .hb-dh { padding:16px 20px 14px; border-bottom:1px solid var(--hb-line); position:sticky; top:0; background:var(--hb-panel); z-index:1; }
  #alex-heartbeat .hb-dclose { position:absolute; top:12px; right:14px; background:none; border:none; color:var(--hb-muted); font-size:22px; cursor:pointer; line-height:1; }
  #alex-heartbeat .hb-dh h2 { margin:0; font-size:15px; padding-right:26px; }
  #alex-heartbeat .hb-dsub { color:var(--hb-muted); font-size:12px; margin-top:4px; }
  #alex-heartbeat .hb-db { padding:14px 20px 40px; }
  #alex-heartbeat .hb-kv { display:grid; grid-template-columns:auto 1fr; gap:5px 12px; font-size:12px; margin-bottom:16px; }
  #alex-heartbeat .hb-kv .hb-k { color:var(--hb-faint); }
  #alex-heartbeat .hb-fbblock { border:1px solid var(--hb-line); border-radius:11px; padding:13px 14px; margin-bottom:14px; }
  #alex-heartbeat .hb-fbblock h3 { margin:0 0 10px; font-size:13px; display:flex; align-items:center; gap:8px; }
  #alex-heartbeat .hb-fbblock h3 .hb-who { font-size:10px; color:var(--hb-faint); text-transform:uppercase; letter-spacing:.6px; font-weight:600; }
  #alex-heartbeat .hb-field { margin-bottom:11px; }
  #alex-heartbeat .hb-field > label { display:block; font-size:10.5px; color:var(--hb-faint); text-transform:uppercase; letter-spacing:.5px; margin-bottom:4px; }
