<div class="max-w-7xl mx-auto px-4 py-6">
  <div class="flex items-start justify-between gap-4 flex-wrap mb-6">
    <div>
      <div class="flex items-center gap-3 text-sm text-muted mb-2">
        <%= link_to "Deployments", deployments_path, class: "hover:text-heading" %>
        <span>/</span>
        <span>All Deployments</span>
      </div>
      <h2 class="text-3xl font-extrabold text-heading tracking-tight">All Deployments</h2>
    </div>
    <%= link_to "Back to Dashboard", deployments_path, class: "btn btn-neutral btn-sm" %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-5 gap-3 mb-6">
    <% (@duration_dashboard.dig("averages", "stages") || {}).each do |key, row| %>
      <div class="rounded-lg border border-subtle bg-surface px-3 py-3">
        <p class="text-[10px] uppercase tracking-wide text-muted font-semibold"><%= release_duration_stage_name(key) %></p>
        <p class="mt-1 font-mono text-xl font-bold text-heading"><%= release_duration_label(row["average_seconds"]) %></p>
      </div>
    <% end %>
    <% deployment = @duration_dashboard.dig("averages", "deployment") || {} %>
    <div class="rounded-lg border border-subtle bg-surface px-3 py-3">
      <p class="text-[10px] uppercase tracking-wide text-muted font-semibold">Deployment</p>
      <p class="mt-1 font-mono text-xl font-bold text-heading"><%= release_duration_label(deployment["average_seconds"]) %></p>
    </div>
  </div>

  <div class="overflow-x-auto rounded-lg border border-subtle bg-surface">
    <table class="min-w-full text-sm">
      <thead class="bg-surface-alt text-left text-xs uppercase tracking-wide text-muted">
        <tr>
          <th class="px-4 py-3 font-semibold">Release</th>
          <th class="px-4 py-3 font-semibold">State</th>
          <th class="px-4 py-3 font-semibold text-right">Assemble</th>
          <th class="px-4 py-3 font-semibold text-right">Confirm</th>
          <th class="px-4 py-3 font-semibold text-right">Ship</th>
          <th class="px-4 py-3 font-semibold text-right">Deploy</th>
          <th class="px-4 py-3 font-semibold text-right">Tasks</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-subtle">
        <% @releases.each do |release| %>
          <% metrics = release.duration_metrics.presence || Release::DurationCache.build(release) %>
          <% deployment = metrics["release"] || {} %>
          <tr class="hover:bg-surface-alt/70">
            <td class="px-4 py-3">
              <%= link_to release.slug, deployment_path(release), class: "font-mono text-primary hover:underline" %>
            </td>
            <td class="px-4 py-3">
              <span class="rounded px-2 py-0.5 text-xs font-bold <%= release_state_classes(release.state) %>"><%= release.state %></span>
            </td>
            <td class="px-4 py-3 text-right font-mono text-heading tabular-nums"><%= release_duration_label(deployment["assembly_seconds"]) %></td>
            <td class="px-4 py-3 text-right font-mono text-heading tabular-nums"><%= release_duration_label(deployment["confirmation_seconds"]) %></td>
            <td class="px-4 py-3 text-right font-mono text-heading tabular-nums"><%= release_duration_label(deployment["shipping_seconds"]) %></td>
            <td class="px-4 py-3 text-right font-mono text-heading tabular-nums"><%= release_duration_label(deployment["deployment_seconds"] || deployment["live_seconds"]) %></td>
            <td class="px-4 py-3 text-right text-secondary"><%= release.tasks.size %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 text-sm text-muted">
    <p>
      <% if @release_count.positive? %>
        Showing <%= number_with_delimiter(@release_offset + 1) %>-<%= number_with_delimiter([@release_offset + @releases.size, @release_count].min) %>
        of <%= number_with_delimiter(@release_count) %>
      <% else %>
        No deployments
      <% end %>
    </p>
    <% if @release_total_pages > 1 %>
      <nav class="flex items-center gap-2" aria-label="Deployment pages">
        <% if @release_page > 1 %>
          <%= link_to "Previous", all_deployments_path(page: @release_page - 1), class: "btn btn-neutral btn-sm" %>
        <% else %>
          <span class="btn btn-neutral btn-sm opacity-40 pointer-events-none">Previous</span>
        <% end %>
        <span class="font-mono text-secondary px-2">Page <%= @release_page %> / <%= @release_total_pages %></span>
        <% if @release_page < @release_total_pages %>
          <%= link_to "Next", all_deployments_path(page: @release_page + 1), class: "btn btn-neutral btn-sm" %>
        <% else %>
          <span class="btn btn-neutral btn-sm opacity-40 pointer-events-none">Next</span>
        <% end %>
      </nav>
    <% end %>
  </div>
</div>
