<%# THE MODEL LIBRARY for one person.
    Answers the question the re-skin decision turns on: what do we already have
    of this person, and in which looks. %>
<div class="max-w-5xl mx-auto px-4 py-8 space-y-6">

  <%# --- who --- %>
  <div class="card p-6 flex gap-5 items-start">
    <div class="w-24 h-24 shrink-0 rounded-full bg-surface-alt border border-subtle overflow-hidden flex items-center justify-center">
      <% headshot = @person.athlete_profile&.espn_headshot_url.presence || @person.avatar_url.presence %>
      <% if headshot %>
        <%= image_tag headshot, class: "object-cover w-full h-full" %>
      <% else %>
        <span class="text-3xl opacity-40">👤</span>
      <% end %>
    </div>

    <div class="flex-1 min-w-0">
      <h1 class="text-2xl font-bold text-heading"><%= @person.full_name %></h1>
      <p class="text-sm text-muted">
        <%= @person.slug %>
        <% if admin? %>
          <%= link_to "Rename", edit_slug_person_path(@person.slug), class: "ml-2 text-xs text-primary hover:underline",
                data: { test: "person-rename-slug" } %>
        <% end %>
      </p>

      <div class="flex gap-2 flex-wrap mt-2">
        <% if (a = @person.athlete_profile) %>
          <% unless @person.vocation?("athlete") %>
            <span class="badge text-3xs uppercase bg-surface-alt text-secondary border-subtle">Athlete</span>
          <% end %>
          <% if a.position.present? %><span class="text-xs text-muted"><%= a.position %></span><% end %>
          <% if a.team.present? %><span class="text-xs text-muted"><%= a.team.name %></span><% end %>
        <% end %>
        <%# Every vocation the person holds, the primary one first and marked. %>
        <% ([@person.primary_vocation] + @person.vocations).compact.uniq.each do |vocation| %>
          <% primary = vocation == @person.primary_vocation %>
          <span class="badge text-3xs uppercase <%= primary ? 'bg-primary/10 text-primary border-primary/20' : 'bg-surface-alt text-secondary border-subtle' %>"
                data-test="person-vocation" data-primary="<%= primary %>"><%= vocation %><%= " · primary" if primary && @person.vocations.many? %></span>
        <% end %>
        <% if @person.vocations.empty? && !@person.athlete_profile %>
          <span class="badge text-3xs uppercase bg-surface-alt text-secondary border-subtle" data-test="person-no-vocation">Person</span>
        <% end %>
      </div>

      <%# What a generator has to work from. An athlete gets this free; anyone
          else needs it typed into a look's notes. %>
      <% if (a = @person.athlete_profile) && [a.build, a.skin_tone, a.hair_description].any?(&:present?) %>
        <p class="text-xs text-muted mt-3">
          <span class="label-upper">Generation data on file:</span>
          <%= [a.build, a.skin_tone, a.hair_description].compact_blank.join(" · ") %>
        </p>
      <% else %>
        <%# TWO DIFFERENT STATES, and the old copy named only one of them — it read
            "No athlete record" whenever the physical fields were blank, which on an
            athlete whose build and hair were never filled in printed a flat
            contradiction directly under their own athlete chip. The condition above
            is about generation DATA, not about the record, so the sentence now says
            which of the two is missing.

            text-warning-ink rather than a raw amber shade: the old spelling is a
            dark-mode-only colour that renders as unreadable pale-on-white the moment
            the theme flips. %>
        <p class="text-xs text-warning-ink mt-3">
          <% if @person.athlete_profile %>
            No build, skin tone or hair on their athlete record &mdash; a model's
            <em>generation notes</em> are the only source for this person.
          <% else %>
            No athlete record &mdash; a model's <em>generation notes</em> are the only
            source for this person.
          <% end %>
        </p>
      <% end %>
    </div>
  </div>

  <%# --- vocations: what this person does, admin only --- %>
  <% if admin? %>
    <%= form_with url: vocations_person_path(@person.slug), method: :patch, scope: :person, local: true,
                  class: "card p-6 space-y-4", data: { test: "vocations-form" } do |f| %>
      <div class="flex items-center justify-between gap-3">
        <p class="label-upper text-primary">Vocations</p>
        <span class="text-xs text-muted">many allowed; the primary is the one shown in search</span>
      </div>
      <%# Sent even when every box is clear, so unticking all of them saves an empty list. %>
      <input type="hidden" name="person[vocations][]" value="">
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
        <% Person::VOCATIONS.each do |vocation| %>
          <label class="flex items-center gap-2 rounded-lg border border-subtle bg-surface-alt px-3 py-2 text-sm text-body min-w-0">
            <input type="checkbox" name="person[vocations][]" value="<%= vocation %>" class="shrink-0"
                   <%= "checked" if @person.held_vocations.include?(vocation) %> data-test="vocation-box">
            <span class="capitalize truncate"><%= vocation %></span>
          </label>
        <% end %>
      </div>
      <div class="flex flex-col sm:flex-row sm:items-end gap-3">
        <div class="min-w-0 sm:w-64">
          <label class="label-upper block mb-1.5" for="person-primary-vocation">Primary</label>
          <select id="person-primary-vocation" name="person[primary_vocation]" class="input-field py-2 text-sm" data-test="vocation-primary">
            <option value="">First one ticked</option>
            <% Person::VOCATIONS.each do |vocation| %>
              <option value="<%= vocation %>" <%= "selected" if @person.primary_vocation == vocation %>><%= vocation.capitalize %></option>
            <% end %>
          </select>
        </div>
        <button type="submit" class="btn btn-primary btn-sm" data-test="vocations-save">Save vocations</button>
      </div>
    <% end %>
  <% end %>

  <%# --- the looks --- %>
  <div class="card p-6 space-y-4">
    <div class="flex items-center justify-between">
      <p class="label-upper text-primary">🎭 Models</p>
      <span class="text-xs text-muted">the first one created becomes the default</span>
    </div>

    <%# THE ROUTE INTO PHOTO SCOUTING, and the only one — a page an operator can reach
        only by typing a URL is a page that does not exist for the person it was built
        for. It sits ABOVE the per-look rows rather than inside one because the question
        it answers ("are we any good at finding photographs of this man?") is about the
        person; the page itself resolves the default look to file against.

        Rendered whenever the person has a look, for everybody: the page is a free read,
        and the controls on it that spend are admin-gated there. %>
    <% if @appearances.any? %>
      <div class="rounded-lg border border-primary/30 bg-primary/5 p-3 flex items-center gap-3 flex-wrap">
        <div class="min-w-0 flex-1">
          <p class="text-xs font-bold text-heading">Photo scouting</p>
          <p class="text-2xs text-muted">
            What the search found, what the ranking picked, and what you would have
            picked instead.
          </p>
        </div>
        <%= link_to "Scout photos →", person_scouting_path(@person.slug),
              data: { test: "photo-scouting-link" },
              class: "btn btn-sm btn-primary shrink-0" %>
      </div>
    <% end %>

    <% if @appearances.any? %>
      <div class="space-y-2">
        <% @appearances.each do |look| %>
          <div id="look-<%= look.slug %>" data-test="person-look" data-iced="<%= look.iced? %>"
               class="rounded-lg border p-3 flex items-center gap-3 flex-wrap scroll-mt-24 <%= look.iced? ? 'border-primary/30 bg-primary/5 ml-4 sm:ml-8' : 'border-subtle' %>">
            <span class="text-heading font-bold min-w-0 break-words"><%= look.descriptor %></span>
            <% if look.iced? %>
              <span class="badge text-3xs bg-primary/10 text-primary border-primary/30" data-test="iced-badge">iced twin</span>
            <% elsif admin? && !look.music_video_look? && !@twinned_slugs.include?(look.slug) %>
              <%# Looks made before twins existed: one free press, no sheet built. %>
              <%= button_to "Create iced twin", create_iced_twin_person_path(@person.slug),
                    method: :post, params: { appearance_slug: look.slug },
                    class: "btn btn-sm btn-outline", data: { test: "create-iced-twin" } %>
            <% end %>

            <% if look.default? %>
              <span data-test="default-look-badge"
                    class="badge text-3xs bg-success/10 text-success-ink border-success/40">default</span>
            <% elsif admin? %>
              <%= button_to "Make default", make_default_appearance_person_path(@person.slug),
                    method: :post, params: { appearance_slug: look.slug },
                    class: "btn btn-sm btn-secondary" %>
            <% end %>

            <% if look.colorway.present? %>
              <span class="text-xs text-muted"><%= look.colorway %></span>
            <% end %>

            <% if look.jersey_label %>
              <span class="badge text-3xs bg-surface-alt text-body border-subtle" data-test="look-jersey"><%= look.jersey_label %></span>
            <% end %>

            <%# THE ROUTE TO THE CHARACTER MODEL PAGE, and the only one: an operator
                must be able to reach that page by clicking rather than by knowing a
                URL. The chip beside it answers "which of my models have an identity"
                without opening any of them, which is the question a person with six
                looks actually has. %>
            <% chip = identity_chip(look) %>
            <span class="badge text-3xs <%= chip[:classes] %>">model: <%= chip[:label] %></span>

            <span class="ml-auto flex items-center gap-3">
              <span class="text-xs text-muted"><%= look.artifact_subjects.count %> image(s)</span>
              <%= link_to (look.iced? ? "Model and iced sheet →" : "Model and sheet →"),
                    person_appearance_path(@person.slug, look.slug),
                    data: { test: "character-model-link" },
                    class: "btn btn-sm btn-outline" %>
            </span>
          </div>

          <%# Attach an image for THIS look. Admin only, like the action; the
              address must be an https URL on a public host, and the action says
              so when it refuses one. Beside it, the look's jersey number: the
              number clip prompts name the player by (blank clears it). %>
          <% if admin? %>
            <%= form_with url: update_appearance_person_path(@person.slug), method: :patch, scope: :appearance,
                          class: "flex items-center gap-2 flex-wrap pl-3", data: { test: "look-jersey-form" } do |f| %>
              <%= hidden_field_tag :appearance_slug, look.slug %>
              <%= f.label :jersey_number, "Jersey number", for: "jersey-#{look.slug}", class: "text-xs text-muted" %>
              <%= f.number_field :jersey_number, id: "jersey-#{look.slug}", value: look.jersey_number, min: 0, max: 99,
                    placeholder: "none", class: "input-field text-xs w-20" %>
              <%= f.submit "Save number", class: "btn btn-sm btn-outline" %>
            <% end %>
            <%= form_with url: attach_artifact_person_path(@person.slug), method: :post,
                          class: "flex items-center gap-2 flex-wrap pl-3 pb-2 #{'ml-4 sm:ml-8' if look.iced?}" do |f| %>
              <%= f.hidden_field :appearance_slug, value: look.slug %>
              <%= f.text_field :image_url, placeholder: "https:// image URL for #{look.descriptor}",
                    class: "input-field text-xs w-80" %>
              <%= f.submit "Attach image", class: "btn btn-sm btn-secondary" %>
            <% end %>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-muted">
        No models yet.<% if admin? %> Create one below — it becomes <%= @person.full_name %>'s default.<% end %>
      </p>
    <% end %>

    <%# --- create a look: admin only, like the action it posts to --- %>
    <% if admin? %>
      <%# Opened by the cast card's "new look" link, which also says where to return. %>
      <details id="new-model" class="rounded-lg bg-surface-alt p-4 scroll-mt-24" <%= "open" if recast_return_path %> data-test="new-model">
        <summary class="cursor-pointer text-sm font-bold text-heading">+ New model</summary>
        <% if recast_return_path %>
          <p class="mt-3 text-xs text-muted" data-test="new-model-return">Saving takes you back to the cast card.</p>
        <% end %>
        <%= form_with url: create_appearance_person_path(@person.slug, return_to: recast_return_path), method: :post,
                      scope: :appearance, class: "mt-3 space-y-2" do |f| %>
          <%= f.text_field :descriptor, placeholder: "Bengals white · navy suit · 1994 Ace Ventura",
                class: "input-field text-sm w-full", required: true %>
          <div class="flex gap-2 flex-wrap">
            <%= f.text_field :team_slug, placeholder: "team slug (athletes only)", class: "input-field text-sm w-52" %>
            <%= f.text_field :colorway, placeholder: "colorway (optional)", class: "input-field text-sm w-40" %>
            <%= f.number_field :jersey_number, placeholder: "jersey number", min: 0, max: 99, class: "input-field text-sm w-36" %>
          </div>
          <%= f.url_field :reference_url, placeholder: "reference photo URL", class: "input-field text-sm w-full" %>
          <%= f.text_area :generation_notes, rows: 2,
                placeholder: "How to generate this person — required when there is no athlete record",
                class: "input-field text-sm w-full" %>
          <%= f.submit "Save model", class: "btn btn-sm btn-primary" %>
        <% end %>
      </details>
    <% end %>
  </div>

  <%= render "people/jewelry", person: @person, jewelries: @jewelries %>

  <%# --- every image they appear in, including shared ones --- %>
  <div class="card p-6 space-y-4">
    <div class="flex items-center justify-between">
      <p class="label-upper text-primary">🖼 Images</p>
      <span class="text-xs text-muted">includes images shared with other people</span>
    </div>

    <% if @artifacts.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
        <% @artifacts.each do |artifact| %>
          <div class="rounded-lg border border-subtle overflow-hidden">
            <div class="h-44 bg-surface-alt flex items-center justify-center overflow-hidden">
              <% if artifact.image_url.present? %>
                <%= image_tag artifact.image_url, class: "object-cover w-full h-full" %>
              <% else %>
                <span class="text-3xl opacity-40">🖼</span>
              <% end %>
            </div>
            <div class="p-3 space-y-1">
              <p class="text-sm font-bold text-heading"><%= artifact.cast_label %></p>
              <p class="text-xs text-muted">
                <%= artifact.kind.humanize %>
                <% artifact.subjects.ordered.each do |s| %>
                  · <%= s.display_name %>: <%= s.effective_appearance&.descriptor || "no look" %>
                <% end %>
              </p>
              <%# ON THE THEME ROLES, because "approved" is a STATUS and this page now
                  renders that same status twice — here and on the character-model
                  page it links to — and one concept spelled two ways is how the two
                  drift. The vocation chips above are identity, not status, so
                  none of them borrows a status role: the primary vocation
                  takes the primary role and every other chip stays neutral. %>
              <% if artifact.approved? %>
                <span class="badge text-3xs bg-success/10 text-success-ink border-success/40">approved</span>
              <% else %>
                <span class="badge text-3xs bg-warning/10 text-warning-ink border-warning/40">not reviewed</span>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-sm text-muted">No images of <%= @person.full_name %> yet.</p>
    <% end %>
  </div>
</div>
