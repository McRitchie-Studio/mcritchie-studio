<% content_for :title, @signing_request.title %>

<%
  build_path = admin_signing_build_path(instruction: @signing_request.instruction_name, cluster: @signing_request.cluster)
  rpc_path   = admin_signing_rpc_path(instruction: @signing_request.instruction_name, cluster: @signing_request.cluster)
  config_ok  = @cosigner_configured && @rpc_configured
%>

<style>
  .sgn { font: 14px/1.5 ui-monospace, SFMono-Regular, Menlo, monospace;
    background: #0d1117; color: #c9d1d9; padding: 24px; max-width: 880px; margin: 0 auto; border-radius: 8px; }
  .sgn h1 { font-size: 18px; color: #f0f6fc; }
  .sgn .cluster-dev  { color: #d29922; font-weight: bold; letter-spacing: 1px; }
  .sgn .cluster-main { color: #f85149; font-weight: bold; letter-spacing: 1px; }
  .sgn .card { background: #161b22; border: 1px solid #30363d; border-radius: 8px; padding: 16px; margin: 14px 0; }
  .sgn .row { display: flex; justify-content: space-between; gap: 12px; padding: 2px 0; }
  .sgn .k { color: #8b949e; } .sgn .v { color: #c9d1d9; word-break: break-all; }
  .sgn .new { color: #3fb950; }
  .sgn button { font: inherit; background: #238636; color: #fff; border: 1px solid #2ea043;
    border-radius: 6px; padding: 8px 16px; cursor: pointer; margin: 4px 4px 4px 0; }
  .sgn button:disabled { background: #21262d; color: #6e7681; border-color: #30363d; cursor: not-allowed; }
  .sgn #sgn-log { background: #010409; border: 1px solid #30363d; border-radius: 6px; padding: 12px;
    white-space: pre-wrap; word-break: break-all; min-height: 80px; max-height: 360px; overflow-y: auto; font-size: 12px; }
  .sgn .ok { color: #3fb950; } .sgn .err { color: #f85149; } .sgn .warn { color: #d29922; } .sgn .info { color: #58a6ff; }
  .sgn a { color: #58a6ff; }
</style>

<div class="sgn">
  <h1>
    <%= @signing_request.title %> ·
    <span class="<%= @signing_request.cluster == 'mainnet' ? 'cluster-main' : 'cluster-dev' %>">
      <%= @signing_request.cluster.upcase %>
    </span>
  </h1>

  <div class="card">
    <div class="row"><span class="k">program</span><span class="v"><%= @signing_request.program_id %></span></div>
    <div class="row"><span class="k">instruction</span><span class="v"><%= @signing_request.instruction_name %></span></div>
    <% @signing_request.account_metas.each_with_index do |m, i| %>
      <div class="row"><span class="k">acct[<%= i %>]<%= " signer" if m[:is_signer] %><%= " w" if m[:is_writable] %></span><span class="v"><%= m[:pubkey] %></span></div>
    <% end %>
    <% if @signing_request.instruction_name == "update_signers" %>
      <div class="row"><span class="k">new signers</span><span class="v new">[<%= @signing_request.args["new_signers"].map { |s| s[0, 4] + "…" + s[-4, 4] }.join(", ") %>]</span></div>
    <% end %>
    <div class="row"><span class="k">cosigner (server)</span><span class="v"><%= @signing_request.cosigner %></span></div>
    <div class="row"><span class="k">expected signer (you)</span><span class="v"><%= @signing_request.expected_signer %> · Phantom</span></div>
    <div class="row"><span class="k">fee payer</span><span class="v"><%= @signing_request.fee_payer %></span></div>
  </div>

  <% unless config_ok %>
    <div class="card">
      <% unless @cosigner_configured %>
        <div class="err">⚠ co-signer key not configured — set SOLANA_COSIGNER_KEY (or SOLANA_COSIGNER_OP_REF) in the env that launched this server.</div>
      <% end %>
      <% unless @rpc_configured %>
        <div class="err">⚠ <%= @signing_request.cluster %> RPC not configured — set <%= @signing_request.cluster == 'mainnet' ? 'SOLANA_MAINNET_RPC_URL' : 'SOLANA_DEVNET_RPC_URL' %> (Helius) in the env.</div>
      <% end %>
    </div>
  <% end %>

  <div>
    <button id="sgn-connect">1 · Connect Phantom</button>
    <button id="sgn-sim" disabled>2 · Simulate</button>
    <button id="sgn-send" disabled>3 · Sign &amp; Send</button>
  </div>

  <div id="sgn-log" class="card"></div>
</div>

<script type="module">
import {
  Connection, VersionedTransaction,
} from "https://esm.sh/@solana/web3.js@1.98.4";

const EXPECTED   = "<%= @signing_request.expected_signer %>";
const CLUSTER    = "<%= @signing_request.cluster %>";
const BUILD_PATH = "<%= build_path %>";
const RPC_PATH   = "<%= rpc_path %>";
const CSRF       = document.querySelector('meta[name="csrf-token"]')?.content;

// All RPC goes through our same-origin proxy (Helius URL stays server-side).
const conn = new Connection(location.origin + RPC_PATH, "confirmed");

const logEl = document.getElementById("sgn-log");
function log(msg, cls = "") {
  const ts = new Date().toLocaleTimeString();
  logEl.innerHTML += `<span class="${cls}">[${ts}] ${msg}</span>\n`;
  logEl.scrollTop = logEl.scrollHeight;
}
const btnConnect = document.getElementById("sgn-connect");
const btnSim     = document.getElementById("sgn-sim");
const btnSend    = document.getElementById("sgn-send");

let provider = null;

function getProvider() {
  const p = window.phantom?.solana || (window.solana?.isPhantom ? window.solana : null);
  if (!p) throw new Error("Phantom not found. Install the Phantom extension and reload.");
  return p;
}

btnConnect.onclick = async () => {
  try {
    provider = getProvider();
    const resp = await provider.connect();
    const pk = resp.publicKey.toBase58();
    log("Phantom connected: " + pk, "info");
    if (pk !== EXPECTED) {
      log(`REFUSED — connected wallet ${pk} is NOT the expected signer ${EXPECTED}. Switch Phantom and reconnect.`, "err");
      btnSim.disabled = true; btnSend.disabled = true;
      return;
    }
    const slot = await conn.getSlot();
    log(`RPC ok (${CLUSTER} slot ${slot})`, "ok");
    log("Wallet asserted == expected signer ✓", "ok");
    btnSim.disabled = false;
  } catch (e) {
    log("connect failed: " + e.message, "err");
  }
};

// HTTP-only RPC call through the same-origin proxy. We deliberately bypass
// web3.js's Connection helpers for confirmation: confirmTransaction opens a
// WebSocket signature subscription (web3.js auto-derives ws:// at port+1, which
// on localhost:3000 hits :3001 and floods the console). Polling getSignatureStatuses
// over plain fetch keeps everything on the HTTP proxy with zero WS traffic.
async function proxyRpc(method, params) {
  const r = await fetch(RPC_PATH, {
    method: "POST",
    headers: { "Content-Type": "application/json", "X-CSRF-Token": CSRF || "" },
    body: JSON.stringify({ jsonrpc: "2.0", id: 1, method, params }),
  });
  if (!r.ok) throw new Error(`${method} proxy failed: ${r.status} ${await r.text()}`);
  const out = await r.json();
  if (out.error) throw new Error(`${method} RPC error: ${JSON.stringify(out.error)}`);
  return out.result;
}

// Poll getSignatureStatuses over HTTP until confirmed/finalized or error.
// ~1.5s interval, ~60s ceiling. No web3.js subscription/WebSocket is ever opened.
async function pollConfirmation(sig, { intervalMs = 1500, timeoutMs = 60000 } = {}) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    const res = await proxyRpc("getSignatureStatuses", [[sig], { searchTransactionHistory: true }]);
    const st = res?.value?.[0];
    if (st) {
      if (st.err) throw new Error("tx failed on-chain: " + JSON.stringify(st.err));
      const status = st.confirmationStatus;
      if (status === "confirmed" || status === "finalized") {
        log(`status: ${status}`, "ok");
        return st;
      }
      log(`status: ${status || "processed"} (waiting…)`, "info");
    } else {
      log("status: not yet visible (waiting…)", "info");
    }
    await new Promise((r) => setTimeout(r, intervalMs));
  }
  throw new Error(`confirmation timed out after ${timeoutMs / 1000}s (tx may still land — check explorer)`);
}

// Fetch a FRESH cosigner-partial-signed tx from the server (current blockhash).
async function fetchFreshTx() {
  const r = await fetch(BUILD_PATH, {
    method: "POST",
    headers: { "Content-Type": "application/json", "X-CSRF-Token": CSRF || "" },
  });
  if (!r.ok) throw new Error("/build failed: " + r.status + " " + (await r.text()));
  const out = await r.json();
  if (out.error) throw new Error(out.error);
  const tx = VersionedTransaction.deserialize(
    Uint8Array.from(atob(out.txBase64), (c) => c.charCodeAt(0))
  );
  return { tx, ...out };
}

btnSim.onclick = async () => {
  btnSim.disabled = true;
  try {
    log("building fresh tx for simulation…", "info");
    const { tx } = await fetchFreshTx();
    const keys = tx.message.staticAccountKeys.map((k) => k.toBase58());
    log("fee payer (acct[0]): " + keys[0], "info");
    tx.signatures.forEach((s, i) => {
      const empty = s.every((b) => b === 0);
      log(`  sig[${i}] ${keys[i].slice(0, 8)}…  ${empty ? "EMPTY" : "PRESENT"}`, empty ? "warn" : "ok");
    });
    log("simulating (sigVerify:false)…", "info");
    const sim = await conn.simulateTransaction(tx, {
      sigVerify: false, replaceRecentBlockhash: true, commitment: "confirmed",
    });
    (sim.value.logs || []).forEach((l) => log("  " + l));
    if (sim.value.err) {
      log("SIM err: " + JSON.stringify(sim.value.err) + " — DO NOT SEND.", "err");
      btnSend.disabled = true;
    } else {
      log("SIM err: null ✓  — simulates clean. Ready to Sign & Send.", "ok");
      btnSend.disabled = false;
    }
  } catch (e) {
    log("simulate failed: " + e.message, "err");
  } finally {
    btnSim.disabled = false;
  }
};

btnSend.onclick = async () => {
  btnSend.disabled = true;
  try {
    log("building fresh tx (current blockhash) for signing…", "info");
    const { tx } = await fetchFreshTx();

    // signTransaction: Phantom adds the expected signer's sig and PRESERVES the
    // server's partial sig. (signAndSendTransaction can re-serialize and drop a
    // pre-existing partial sig — signTransaction + proxy-broadcast is deterministic.)
    log("requesting Phantom signature…", "info");
    const signed = await provider.signTransaction(tx);

    const keys = signed.message.staticAccountKeys.map((k) => k.toBase58());
    let allPresent = true;
    signed.signatures.forEach((s, i) => {
      const empty = s.every((b) => b === 0);
      if (empty) allPresent = false;
      log(`  sig[${i}] ${keys[i].slice(0, 8)}…  ${empty ? "EMPTY ✗" : "PRESENT ✓"}`, empty ? "err" : "ok");
    });
    if (!allPresent) {
      log("Phantom dropped a signature (likely the server partial sig). ABORTING broadcast.", "err");
      btnSend.disabled = false;
      return;
    }

    log("broadcasting via proxy…", "info");
    const sig = await conn.sendRawTransaction(signed.serialize(), { skipPreflight: false, preflightCommitment: "confirmed" });
    log("sent: " + sig, "info");
    log("confirming (HTTP poll — no WebSocket)…", "info");
    await pollConfirmation(sig);
    log("CONFIRMED ✓", "ok");
    const cl = CLUSTER === "mainnet" ? "" : "?cluster=devnet";
    const url = `https://explorer.solana.com/tx/${sig}${cl}`;
    logEl.innerHTML += `<span class="ok">[explorer] </span><a href="${url}" target="_blank">${url}</a>\n`;
  } catch (e) {
    log("send failed: " + (e.message || JSON.stringify(e)), "err");
    btnSend.disabled = false;
  }
};
</script>
