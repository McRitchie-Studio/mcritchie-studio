<%# "Cyvasse Night": the invite to Tuesday, October 6, 2026, 7-10 PM Mountain,
    when everyone plays live at once (task cyvasse-night-invite-email). Short
    and plain, in the voice of the other Cyvasse letters. It needs no merge
    fields, so it renders for every contact: a reader with Cyvasse stats gets
    their name and an experience line (Broadcasts::CyvasseNight, which also
    picks the subject); one without gets neither. Every link is tracked
    (Broadcast::TEMPLATE_LINKS): night, play, calendar (the .ics) and build. %>
<% links      = Broadcast::TEMPLATE_LINKS["cyvasse_night"] %>
<% night_url  = broadcast_link(:night,    links["night"]) %>
<% play_url   = broadcast_link(:play,     links["play"]) %>
<% cal_url    = broadcast_link(:calendar, links["calendar"]) %>
<% build_url  = broadcast_link(:build,    links["build"]) %>
<% named      = @merge_fields.nil? || @merge_fields["username"].present? %>
<% experience = @merge_fields ? Broadcasts::CyvasseNight.experience_line(@merge_fields) : "Bring your {wins} wins' worth of experience." %>
<% p_style    = "margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;" %>
<% content_for :email_reason, "You&rsquo;re receiving this because you have an account on Cyvasse.".html_safe %>
<%= render "broadcasts/email_head",
      hero_file: "cyvasse_header_live.jpg",
      hero_alt:  "A Cyvasse board mid-game",
      preheader: "Tuesday, October 6, 7 PM Mountain. Hit Play Now and you're matched with a real player.",
      title:     "Cyvasse Night is Tuesday",
      subtitle:  "One night, 7 to 10 PM Mountain, when everyone plays live at once." %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:28px 32px 8px 32px;">
      <p style="<%= p_style %>"><%= named ? "Hi #{merge_field(:username)}," : "Hi there," %></p>
      <p style="<%= p_style %>" data-block="hook">On Tuesday, October 6, at 7 PM Mountain (that&rsquo;s 9 PM Eastern / 6 PM Pacific), we&rsquo;re holding <strong>Cyvasse Night</strong>: one night when everyone plays live at once.</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;" data-block="how"><a href="<%= play_url %>" style="color:#6d5ff5;font-weight:700;text-decoration:underline;">Open Cyvasse</a>, hit <strong>Play Now</strong>, and you&rsquo;re matched with a real player, not the computer. Wins count toward the night&rsquo;s leaderboard.<% if experience %> <span data-block="experience"><%= experience %></span><% end %></p>
    </td>
  </tr>

  <tr>
    <td style="padding:22px 32px 8px 32px;text-align:center;">
      <%= render "broadcasts/button", url: night_url, label: "See Cyvasse Night &rarr;".html_safe, color: "#8E82FE", full_width: true %>
    </td>
  </tr>

  <tr>
    <td style="padding:6px 32px 8px 32px;text-align:center;">
      <a href="<%= cal_url %>" data-link="calendar" style="font-size:15px;color:#6d5ff5;font-weight:700;text-decoration:underline;">Add it to your calendar</a>
    </td>
  </tr>

  <tr>
    <td style="padding:20px 32px 8px 32px;">
      <p style="margin:0 0 4px 0;font-size:16px;line-height:1.65;color:#2b3440;">See you on the board.</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">&mdash; Alex</p>
    </td>
  </tr>

  <tr>
    <td style="padding:14px 32px 28px 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #eef1f4;">
        <tr><td style="padding-top:16px;font-size:13px;line-height:1.6;color:#94a3b8;"><strong style="color:#64748b;">P.S.</strong> Cyvasse is built at McRitchie Studio, where we turn an idea into a working app. Got one of your own? <a href="<%= build_url %>" style="color:#8E82FE;font-weight:700;text-decoration:none;">Describe it and we&rsquo;ll build it &rarr;</a></td></tr>
      </table>
    </td>
  </tr>
</table>
