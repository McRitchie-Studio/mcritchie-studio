#!/usr/bin/env bash
# bin/statusline — feature/task status line for agent sessions (Claude Code, etc.)
#
# Versioned in the repo (not ~/.claude) so it's shared + recoverable on rebuild.
# Wire it into ~/.claude/settings.json (installed by bin/install-agent-docs):
#   "statusLine": { "type": "command",
#     "command": "/Users/alex/projects/mcritchie-studio/bin/statusline",
#     "padding": 1, "refreshInterval": 5 }
#
# Renders:  <type-emoji> <mascot> · <app-slug> · <feature-slug> · ↗<task>   (+ [stage] when known)
#           (the mascot leads with its type emoji(s); a mascot the board served
#            color/emoji-less renders as the bare name — never a pink 🛠 ⊙ fallback.
#            With no mascot at all the line is 🛠 <app-slug> · …)
#
# Sources, in priority:
#   1. <cwd>/.agent-context.json              — the active worktree (bin/agent-worktree)
#   2. $PROJECTS/.agents/current-feature.json — manual "current focus" marker
#   3. git branch + model                     — primary checkout fallback
#
# Input: agent session JSON on stdin (Claude Code shape). The task link uses OSC 8
# (clickable in iTerm2/Kitty/WezTerm; degrades to plain text elsewhere).
#
# NOTE: cross-tool indicator (incl. Codex) is the terminal TAB TITLE, set by the
# shell hook (`bin/agent-worktree shell-hook zsh`) from the same context — this
# status line is the Claude-specific in-pane view.

input=$(cat)
JQ=/usr/bin/jq
PROJECTS="${CLAUDE_PROJECTS_DIR:-$HOME/projects}"

s_in() { printf '%s' "$input" | "$JQ" -r "$1 // empty" 2>/dev/null; }

cwd=$(s_in '.workspace.current_dir'); [ -z "$cwd" ] && cwd=$(s_in '.cwd'); [ -z "$cwd" ] && cwd="$PWD"
model=$(s_in '.model.display_name')

agent_session_id() {
  if [ -n "$CLAUDE_CODE_SESSION_ID" ]; then
    printf '%s' "$CLAUDE_CODE_SESSION_ID"
  elif [ -n "$CODEX_THREAD_ID" ]; then
    printf '%s' "$CODEX_THREAD_ID"
  fi
}

# ANSI
A=$'\033[38;5;75m'    # app slug
F=$'\033[38;5;179m'   # feature slug
G=$'\033[38;5;108m'   # git branch
D=$'\033[2m'; X=$'\033[0m'
M=$'\033[38;5;250m'   # mascot (Pokémon) — neutral default; a real type color overrides it
DOT="${D} · ${X}"

link() { printf '\033]8;;%s\033\\%s\033]8;;\033\\' "$1" "$2"; }   # OSC 8 hyperlink

# --- Build-claim heartbeat (best-effort lease renewal) ---------------------
# A live terminal renews its build claim each render, so a crashed/closed session
# stops renewing and its lease lapses (TTL) — making the task reclaimable by the
# next claimant. Throttled to ~once/HEARTBEAT_THROTTLE seconds and run detached so
# it never delays the status line. STATUSLINE_HEARTBEAT_FG=1 runs it inline (tests).
TASK_BIN="${TASK_BIN:-$(dirname "$0")/task}"
heartbeat_claim() {  # slug stage is_desk
  local slug="$1" stage="$2" is_desk="$3"
  local sid
  sid=$(agent_session_id)
  [ -z "$slug" ] && return 0
  [ -z "$sid" ] && return 0
  [ -x "$TASK_BIN" ] || return 0
  # Only a live BUILD claim is renewed. A claim is forged ONLY by an explicit
  # `move building`, so:
  #   building → renew (the explicit claim), whatever the source.
  #   "" (no stage) → renew ONLY for a worktree desk (.agent-context.json): a
  #      build desk legitimately carries no stage. The per-session marker must
  #      NOT renew on an empty/missing stage — `bin/task create` repoints that
  #      marker to a fresh `designed`/unowned task (and a create response that
  #      omits stage leaves it blank), so renewing here forged a live claim on a
  #      task nobody was building: the creator's mascot ticking green on an
  #      unclaimed `designed` task (the conductor-files-a-follow-up bug).
  #   anything else (designed/submitted/…) → never renew.
  case "$stage" in
    building) ;;
    "")       [ "$is_desk" = "1" ] || return 0 ;;
    *)        return 0 ;;
  esac
  local mdir="$PROJECTS/.agents/sessions"
  local marker="$mdir/${sid}.heartbeat"
  local throttle="${STATUSLINE_HEARTBEAT_THROTTLE:-45}"
  if [ -f "$marker" ]; then
    local mtime age
    mtime=$(stat -f %m "$marker" 2>/dev/null || echo 0)
    age=$(( $(date +%s) - mtime ))
    [ "$age" -lt "$throttle" ] && return 0
  fi
  mkdir -p "$mdir" 2>/dev/null
  : > "$marker"
  if [ "$STATUSLINE_HEARTBEAT_FG" = "1" ]; then
    "$TASK_BIN" heartbeat "$slug" >/dev/null 2>&1
  else
    ( "$TASK_BIN" heartbeat "$slug" >/dev/null 2>&1 & ) >/dev/null 2>&1
  fi
}

# OSC 8 clickable-text support. Terminal.app does NOT support it (it only
# auto-links plain https URLs); iTerm2/WezTerm/Kitty/Ghostty do.
osc8_supported() {
  [ -n "$KITTY_WINDOW_ID" ] && return 0
  [ -n "$WEZTERM_PANE" ] && return 0
  [ "$LC_TERMINAL" = "iTerm2" ] && return 0
  [ "$FORCE_HYPERLINK" = "1" ] && return 0
  case "$TERM_PROGRAM" in iTerm.app|WezTerm|ghostty|rio|Tabby) return 0 ;; esac
  return 1
}

read_ctx() {  # path -> US-separated: app feature task url stage mascot mascot_color mascot_emoji app_color
  # Joined with the unit separator (U+001F), NOT a tab: a tab is IFS-whitespace,
  # so an empty middle field (e.g. a missing task_url) would collapse and shift
  # every later field left. US is non-whitespace, so empty fields are preserved.
  "$JQ" -r '[(.app // ""), (.worktree_slug // .feature // ""), (.task_record_slug // .task_slug // ""), (.task_url // ""), (.stage // ""), (.mascot // ""), (.mascot_color // ""), (.mascot_emoji // ""), (.app_color // "")] | join("")' "$1" 2>/dev/null
}

# Nearest xterm-256 cube index (16..231) for an r,g,b triple. We use 256-color,
# NOT 24-bit truecolor: the default macOS Terminal.app supports 256 colors but
# not truecolor, and 256 renders correctly everywhere.
rgb_to_256() {  # r g b -> index
  local out=16 mult=36 c
  for c in "$1" "$2" "$3"; do
    local best=0 bestd=1000 i=0 lvl d
    # The 6 cube levels xterm-256 uses per channel.
    for lvl in 0 95 135 175 215 255; do
      d=$(( c - lvl )); [ $d -lt 0 ] && d=$(( -d ))
      [ $d -lt $bestd ] && { bestd=$d; best=$i; }
      i=$(( i + 1 ))
    done
    out=$(( out + mult * best )); mult=$(( mult / 6 ))
  done
  printf '%d' "$out"
}

# Quantize a #RRGGBB to the nearest xterm-256 escape, falling back to $2 (a default
# ANSI escape) when the color is absent or not 6 hex digits. Used for BOTH the
# ⊙<mascot> handle (its least-common type color) AND the app slug (App#color — MS
# lavender, TM green, …); the context carries each as #RRGGBB.
tint() {  # hex fallback_escape -> ANSI escape (echoed)
  local hex="${1#\#}"
  if [ ${#hex} -eq 6 ]; then
    printf '%s[38;5;%dm' $'\033' "$(rgb_to_256 "$((16#${hex:0:2}))" "$((16#${hex:2:2}))" "$((16#${hex:4:2}))")"
  else
    printf '%s' "$2"
  fi
}

render() {  # app feature task url stage mascot mascot_color mascot_emoji app_color
  local app="$1" feat="$2" task="$3" url="$4" stage="$5" mascot="$6" mascot_color="$7" mascot_emoji="$8" app_color="$9" out="🛠 "
  # Per-mascot tint overrides the default M when the context carries a color.
  local M="$M"
  [ -n "$mascot_color" ] && M=$(tint "$mascot_color" "$M")
  # Per-app tint overrides the default app color (A): MS lavender, TM green, …
  # (App#color, quantized to xterm-256). Absent/malformed → the default $A.
  local AC="$A"
  [ -n "$app_color" ] && AC=$(tint "$app_color" "$A")
  local title=""   # OSC 0 terminal-tab title (emoji + name), emitted with the line
  if [ -n "$mascot" ]; then
    # title-case the slug, BSD-sed / bash-3.2 safe: cap first char, hyphens->spaces
    # (snorlax -> "Snorlax"; nidoran-f -> "Nidoran f"; an agent name like "Jasper"
    # is already cased). This name is ALSO the terminal tab title.
    local first rest name
    first=$(printf '%s' "$mascot" | cut -c1 | tr '[:lower:]' '[:upper:]')
    rest=$(printf '%s' "${mascot:1}" | tr '-' ' ')
    name="${first}${rest}"
    # The mascot's type emoji(s) LEAD the handle. A mascot WITHOUT a type emoji (an
    # agent face, or a Pokémon the board served color/emoji-less) renders as the
    # bare name in its tint — NOT the old pink "🛠 ⊙ <name>" fallback, which the
    # missing color+emoji produced and which read as a jarring revert. No emoji →
    # just the name; the "· app" separator already sets it apart from the app slug.
    if [ -n "$mascot_emoji" ]; then
      out="${mascot_emoji} ${M}${name}${X}"
      title=$'\033]0;'"${mascot_emoji} ${name}"$'\007'   # tab: "🗿🏔 Golem" / "🧪 Jasper"
    else
      out="${M}${name}${X}"
      title=$'\033]0;'"${name}"$'\007'
    fi
    [ -n "$app" ] && out="${out}${DOT}${AC}${app}${X}"
  elif [ -n "$app" ]; then
    out="${out} ${AC}${app}${X}"
  fi
  [ -n "$feat" ] && out="${out}${DOT}${F}${feat}${X}"
  # With a mascot present, the Pokémon name IS the session handle — drop the task link
  # so the line stays "⊙ Snorlax · app · feature". Fall back to the link with no mascot.
  if [ -z "$mascot" ]; then
    if [ -n "$url" ]; then
      if osc8_supported; then
        out="${out}${DOT}↗ $(link "$url" "${task:-task}")"        # clean clickable slug
      else
        out="${out}${DOT}${D}${url}${X}"                          # Terminal.app: plain URL is Cmd-clickable
      fi
    elif [ -n "$task" ]; then
      out="${out}${DOT}${task}"
    fi
  fi
  [ -n "$stage" ] && out="${out}  ${D}[${stage}]${X}"
  # Session last-4 (e.g. …12ab) — which terminal/session this is, for resume.
  # Portable last-4 (bash 3.2-safe): strip everything but the trailing 4 chars.
  local sid
  sid=$(agent_session_id)
  if [ -n "$sid" ]; then
    out="${out} ${D}…${sid#${sid%????}}${X}"
  fi
  # Lead with the OSC 0 tab title (zero-width: the terminal sets the tab, Claude
  # renders the visible rest). OSC 8 hyperlinks already pass through Claude's status
  # line, so OSC 0 does too. Emitted every render but idempotent, so the tab only
  # visibly changes when the mascot/persona does — session start, task create, swap.
  printf '%s%s' "$title" "$out"
}

ctx="$cwd/.agent-context.json"
src=""; src_is_desk=""
[ -f "$ctx" ] && { src="$ctx"; src_is_desk="1"; }                 # worktree session: per-worktree build desk
sid=$(agent_session_id)
if [ -z "$src" ] && [ -n "$sid" ]; then
  sm="$PROJECTS/.agents/sessions/$sid.json"                       # per-session marker (no cross-session leak)
  [ -f "$sm" ] && src="$sm"                                       # NOT a build desk — display context only
fi

if [ -n "$src" ]; then
  IFS=$'\x1f' read -r app feat task url stage mascot mascot_color mascot_emoji app_color < <(read_ctx "$src")
  render "$app" "$feat" "$task" "$url" "$stage" "$mascot" "$mascot_color" "$mascot_emoji" "$app_color"
  heartbeat_claim "$task" "$stage" "$src_is_desk"   # renew this terminal's build-claim lease (desk-aware)
else
  branch=$(git -C "$cwd" branch --show-current 2>/dev/null)
  top=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)
  repo=$(basename "${top:-$cwd}")
  if [ -n "$branch" ]; then
    printf '%s' "${D}${repo}${X} ${G}${branch}${X}${DOT}${D}${model}${X}"
  else
    printf '%s' "${D}${repo} · ${model}${X}"
  fi
fi
