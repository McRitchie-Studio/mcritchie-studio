<%# The five-stage release pizza-tracker (Testing → Assembling → Deploying QA →
    Confirming → Deploying) for the CURRENT release. Extracted from _release_summary
    into its own partial so the Current Release card's tracker markup stays a
    self-contained, testable unit (single render site — the Next Release card).
    Locals:
      release  the active Release to chart (required)
    Steps + per-stage durations come from release_tracker_steps; the active stage
    counts down from the last-three-release average via _release_ticker
    (data-release-ticker). %>
<% rel = local_assigns.fetch(:release) %>
<% tracker_steps = release_tracker_steps(rel) %>
<div class="grid grid-cols-5 gap-0.5 sm:gap-1" data-test="release-tracker-steps">
  <% tracker_steps.each_with_index do |step, index| %>
    <div class="relative flex min-w-0 flex-col items-center gap-1" data-test="release-tracker-step" data-stage="<%= step[:key] %>" data-state="<%= step[:state] %>">
      <% unless index == tracker_steps.length - 1 %>
        <span aria-hidden="true" data-test="release-tracker-connector" data-state="<%= step[:connector_state] %>" class="absolute top-2.5 z-0 h-1 rounded-full sm:top-3 <%= release_tracker_connector_classes(step[:connector_state]) %>" style="left: 50%; width: 100%;"></span>
      <% end %>
      <span class="relative z-10 flex h-5 w-5 items-center justify-center rounded-full border-2 text-[10px] font-black leading-none sm:h-6 sm:w-6 sm:text-[11px] <%= release_tracker_dot_classes(step[:state]) %>" <%= raw('aria-current="step"') if step[:state] == :active %>>
        <% if step[:state] == :complete %>
          <span aria-hidden="true">&check;</span>
        <% else %>
          <%= step[:index] %>
        <% end %>
      </span>
      <span class="max-w-16 text-center text-[9px] font-semibold leading-tight sm:max-w-20 sm:text-[10px] <%= release_tracker_label_classes(step[:state]) %>" data-test="release-tracker-label"><%= step[:label] %></span>
      <% if step[:countdown_label] %>
        <%# The ACTIVE node alone gets the prediction clock: count down from the
            last-three shipped release average, then flip to a negative overrun.
            Completed nodes keep their started-ago timing; pending nodes stay blank. %>
        <span class="font-mono text-[9px] leading-none tabular-nums text-secondary data-[overrun=true]:text-red-600 dark:data-[overrun=true]:text-red-300 sm:text-[10px]"
              data-test="release-tracker-duration"
              data-release-ticker
              data-mode="countdown"
              data-since="<%= step[:started_at].to_i %>"
              data-average-seconds="<%= step[:average_seconds] %>"
              data-sample-count="<%= step[:average_sample_count] %>"
              data-average-title="<%= release_tracker_average_source_label(step[:average_sample_count]) %>"
              data-overrun="<%= step[:countdown_seconds].negative? %>"
              title="<%= release_tracker_countdown_title(step) %>"><%= step[:countdown_label] %></span>
      <% elsif step[:started_at] %>
        <%# Every reached node shows how long ago the stage STARTED — the active
            node too when no average exists. title is the app-TZ fallback; the ago ticker re-stamps it browser-local
            off data-since (+ data-took once finished) so the operator reads their
            own clock. Active stays a touch brighter as the liveness cue. %>
        <span class="font-mono text-[9px] leading-none tabular-nums sm:text-[10px] <%= step[:duration_live] ? 'text-secondary' : 'text-muted' %>"
              data-test="release-tracker-duration"
              data-release-ticker
              data-mode="ago"
              data-since="<%= step[:started_at].to_i %>"
              <% if step[:duration_seconds] %>data-took="<%= release_static_duration_label(step[:duration_seconds]) %>"<% end %>
              title="<%= release_tracker_started_title(step) %>"><%= release_ago_label(step[:ago_seconds]) %></span>
      <% else %>
        <span class="h-3" aria-hidden="true"></span>
      <% end %>
    </div>
  <% end %>
</div>
