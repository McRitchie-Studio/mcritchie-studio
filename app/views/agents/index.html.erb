<%# /agents: two compact tables side by side (Alex McRitchie 2026-10-28: "an agents page with the main table of
    agents on one half and pending agents on the other", then "two tables so we can see more"; task
    pending-agents-page). The split follows the brand page's (task brand-page-split-layout): two columns from lg, one
    column below. On a phone the Pending agents table comes FIRST, because the agents table is long (a row per soul)
    and a setup waiting on Alex McRitchie's hands would otherwise sit below it. Each agent's docs and SOP files are on
    its own page (the Docs cell links there). The pending table renders only for an admin. %>
<% show_pending = !@pending_setups.nil? %>
<section>
  <div class="flex items-center justify-between gap-3 mb-6">
    <h2 class="text-2xl font-bold text-heading">Agents</h2>
    <div class="flex flex-wrap items-center gap-2">
      <%= link_to dreams_path, class: "inline-flex items-center gap-1.5 rounded-lg border border-strong bg-surface-alt px-3 py-2 text-sm font-semibold text-body hover:border-primary/40 hover:text-heading transition", data: { test: "agents-dreams-link" } do %>
        Dreams <span aria-hidden="true">&rarr;</span>
      <% end %>
      <%= link_to activities_agents_path, class: "inline-flex items-center gap-1.5 rounded-lg border border-strong bg-surface-alt px-3 py-2 text-sm font-semibold text-body hover:border-primary/40 hover:text-heading transition", data: { test: "agents-activities-link" } do %>
        Activities feed <span aria-hidden="true">&rarr;</span>
      <% end %>
    </div>
  </div>
  <div class="<%= show_pending ? 'grid gap-6 min-w-0 lg:grid-cols-2 lg:items-start' : '' %>" data-test="agents-split" data-layout="<%= show_pending ? 'split' : 'single' %>">
  <% if show_pending %>
    <%= render "agent_setups/column", setups: @pending_setups, finished: @finished_setups %>
  <% end %>
  <section class="min-w-0 space-y-3 <%= 'lg:order-first' if show_pending %>" aria-labelledby="agents-table-heading">
    <h3 id="agents-table-heading" class="<%= show_pending ? 'text-lg font-bold text-heading' : 'sr-only' %>">All agents</h3>
    <div class="overflow-x-auto rounded-lg border border-subtle bg-surface">
      <table class="w-full text-sm" data-test="agents-grid">
        <thead class="bg-surface-alt text-left text-xs uppercase tracking-wide text-muted">
          <tr>
            <th scope="col" class="px-3 py-2 font-semibold">Agent</th>
            <th scope="col" class="hidden sm:table-cell px-3 py-2 font-semibold">Status</th>
            <th scope="col" class="px-3 py-2 font-semibold text-right">Tasks</th>
            <th scope="col" class="px-3 py-2 font-semibold text-right">Docs</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-subtle">
          <% @agents.each do |agent| %>
            <% docs = @agent_docs_by_slug.fetch(agent.slug, []) %>
            <tr class="hover:bg-surface-alt/60" data-test="agent-row" data-agent="<%= agent.slug %>">
              <td class="px-3 py-2">
                <div class="flex items-center gap-2 min-w-0">
                  <%= render "components/agent_avatar", agent: agent, size: "xs", shiny: false %>
                  <div class="min-w-0">
                    <%= link_to agent.name, agent_path(agent.slug), class: "font-semibold text-heading hover:text-primary leading-tight", data: { test: "agent-row-link" } %>
                    <p class="text-xs text-secondary truncate" data-test="agent-row-title"><%= agent.title %></p>
                  </div>
                </div>
              </td>
              <td class="hidden sm:table-cell px-3 py-2 whitespace-nowrap"><%= render "components/agent_status", agent: agent %></td>
              <td class="px-3 py-2 text-right text-secondary tabular-nums" data-test="agent-row-tasks"><%= agent.tasks.size %></td>
              <td class="px-3 py-2 text-right whitespace-nowrap">
                <% if docs.any? %>
                  <%= link_to pluralize(docs.size, "file"), agent_path(agent.slug, anchor: "agent-files"),
                              class: "text-primary-ink hover:underline", data: { test: "agent-docs-link", count: docs.size } %>
                <% else %>
                  <span class="text-muted">—</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
  </div>
</section>
