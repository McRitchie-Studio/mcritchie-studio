<%# /news — the News pipeline kanban, rebased onto the studio/board ENGINE PRIMITIVE
    (studio/board/board). The primitive's `studioBoard` factory (studio/_board_assets,
    homed in the layout) owns drag / cross-column move (PATCH) / reorder (POST) / counts
    / toasts, driving the VENDORED SortableJS (no CDN). This wrapper owns only what the
    neutral primitive deliberately doesn't: the per-card archive / delete writes, in the
    OUTER `newsBoardChrome` Alpine component. The board's own chrome — the single-column
    FOCUS/expand and the ARCHIVED toggle — lives on the primitive's chrome-state home
    (board_state → studioBoard.state), so the column labels + header slot bind straight
    to it and no bespoke wrapper carries that state. Cards render INSIDE the studioBoard
    scope but resolve archiveNews / deleteNews from THIS parent scope (Alpine nests). %>
<% stages = %w[new reviewed processed refined concluded archived] %>
<% stage_agents = { "new" => "Intake", "reviewed" => "Mason", "processed" => "Mack", "refined" => "Alex", "concluded" => "Turf Monster", "archived" => "Alex" } %>
<%# gap 2 — per-column count-chip colours (was an inline `case stage`). %>
<% count_colors = {
     "new" => "bg-blue-900/50 text-blue-300",
     "reviewed" => "bg-yellow-900/50 text-yellow-300",
     "processed" => "bg-mint-900/50 text-mint-300",
     "refined" => "bg-green-900/50 text-green-300",
     "concluded" => "bg-violet-900/50 text-violet-300",
     "archived" => "bg-surface-alt text-muted"
   } %>

<%# newsBoardChrome — the app-specific superset. Owns the per-card archive / delete
    writes the primitive stays neutral on, delegating the shared bits (toast host, count
    refresh) back to the inner studioBoard via Alpine.$data so there is ONE toast host
    and one count path. The FOCUS + ARCHIVED toggles are NOT here — they live on the
    studioBoard scope (board_state), reached by the column labels + header slot. %>
<script>
function newsBoardChrome() {
  return {
    _pending: {},

    // --- reach into the inner studio/board primitive (single source of truth) --
    boardData() {
      const section = this.$el.querySelector('[data-test="studio-board"]');
      return (section && window.Alpine && window.Alpine.$data) ? window.Alpine.$data(section) : null;
    },
    boardToast(msg, type) {
      const d = this.boardData();
      if (d && d.toast) { d.toast(msg, type); return; }
      if (type === 'error' && typeof window.alert === 'function') window.alert(msg);
    },
    boardRefreshCounts() { const d = this.boardData(); if (d && d.updateCounts) d.updateCounts(); },
    responseError(resp, fallback) {
      return resp.json().then((err) => new Error(err.error || fallback)).catch(() => new Error(fallback));
    },

    // --- per-card archive / delete (app writes the primitive stays neutral on) -
    // Archive re-parents the card into the archived COLUMN (this board has one),
    // optimistically first, reverting to the source column on failure.
    async archiveNews(slug) {
      if (this._pending[slug]) return;
      this._pending[slug] = true;
      const card = document.getElementById('card-' + slug);
      const oldStage = card ? card.dataset.stage : null;
      const archivedZone = document.getElementById('dropzone-archived');
      if (card && archivedZone) {
        archivedZone.insertBefore(card, archivedZone.querySelector('.kanban-empty'));
        card.dataset.stage = 'archived';
        this.boardRefreshCounts();
      }
      try {
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/news/' + slug + '/archive.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf }
        });
        if (!resp.ok) throw await this.responseError(resp, 'Archive failed');
        this.boardToast('News archived', 'success');
      } catch (err) {
        if (card && oldStage) {
          const oldZone = document.getElementById('dropzone-' + oldStage);
          if (oldZone) {
            oldZone.insertBefore(card, oldZone.querySelector('.kanban-empty'));
            card.dataset.stage = oldStage;
            this.boardRefreshCounts();
          }
        }
        this.boardToast(err.message || 'Archive failed', 'error');
      } finally {
        delete this._pending[slug];
      }
    },

    async deleteNews(slug) {
      if (!confirm('Delete this news item?')) return;
      if (this._pending[slug]) return;
      this._pending[slug] = true;
      const card = document.getElementById('card-' + slug);
      try {
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/news/' + slug + '.json', {
          method: 'DELETE',
          headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrf }
        });
        if (!resp.ok) throw await this.responseError(resp, 'Delete failed');
        if (card) { card.remove(); this.boardRefreshCounts(); }
        this.boardToast('News deleted', 'success');
      } catch (err) {
        this.boardToast(err.message || 'Delete failed', 'error');
      } finally {
        delete this._pending[slug];
      }
    }
  }
}
</script>

<section x-data="newsBoardChrome()" class="min-h-screen">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-heading">News Pipeline</h2>
    <% if logged_in? %>
      <%= link_to "New Article", new_news_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <!-- Stage Progression -->
  <%= render "shared/pipeline_progression", highlight: "news" %>

  <%
    # gap 5 — a clickable column label toggles the single-column FOCUS on the
    # studioBoard chrome-state home (state.focusedStage); focusing the archived
    # column also flips showArchived on so it is visible. Rendered raw inside the
    # column <h3>, so `state` resolves against the studioBoard scope.
    focus_label = lambda do |stage, label|
      extra = stage == "archived" ? "; if (state.focusedStage === 'archived') state.showArchived = true" : ""
      %(<span class="cursor-pointer hover:text-primary transition" @click="state.focusedStage = state.focusedStage === '#{stage}' ? null : '#{stage}'#{extra}">#{label}</span>).html_safe
    end
    # A non-archived column shows unless another column is focused; the archived
    # column is additionally gated on the Archived toggle. Exactly the prior x-show.
    show_expr = lambda do |stage|
      base = "(!state.focusedStage || state.focusedStage === '#{stage}')"
      stage == "archived" ? "#{base} && (state.showArchived || state.focusedStage === 'archived')" : base
    end
    # gap 5 — the per-column agent chip, pushed to the right of the column header.
    agent_chip = lambda do |stage|
      agent = stage_agents[stage]
      agent ? %(<span class="text-[10px] text-muted ml-auto">#{agent}</span>).html_safe : nil
    end
    # gap 1 — the Archived toggle binds straight to the chrome-state home.
    archived_toggle = %(<button @click="toggleState('showArchived')" :class="state.showArchived ? 'bg-primary text-white' : 'bg-surface text-secondary border border-subtle hover:text-heading'" class="px-3 py-2 rounded-lg text-sm font-medium transition" data-test="news-archived-toggle">Archived</button>).html_safe
  %>

  <%# The board — rendered by the engine primitive. Columns are the stage keys; each
      card is news/_news_card, bound to :news. A cross-column drop PATCHes
      { news: { stage } } (the update action); a reorder POSTs the DOM-ordered slugs
      to the shared reorder action (Studio::Board::Reorderable). Static board — no
      live channel (news has no broadcasts). %>
  <%= render "studio/board/board",
        board_state: { focusedStage: nil, showArchived: false },
        header_slot: content_tag(:div, archived_toggle, class: "flex justify-end"),
        columns: stages.map { |stage|
          {
            key: stage,
            label: focus_label.call(stage, stage.humanize),
            cards: (@news_by_stage[stage] || []),
            count_class: count_colors[stage],
            min_width: "sm:min-w-[220px]",
            show_expr: show_expr.call(stage),
            header_extra: agent_chip.call(stage)
          }
        },
        card_partial: "news/news_card",
        card_as: :news,
        reorder_url: reorder_news_index_path(format: :json),
        reorder_payload: :slugs,
        move_url: "/news/:id.json",
        move_param: { resource: :news, attr: :stage },
        group: "kanban",
        id_attr: "slug",
        zone_attr: "stage",
        live_channel: nil,
        toasts: true,
        empty_label: "Drop news here" %>
</section>
