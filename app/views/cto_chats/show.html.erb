<%# /applications/:slug/chat: the viewer's own live chat with the app's CTO. Owner or admin only. The page is the agent shell (agent_chats/_shell): the CTO's portrait, the app's status card (Building · Releasing · Deploying, Tokens used), then the thread and the chat box. docs/agents/system/agent-message-loop.md ("Web chat") %>
<%# Build my app lands here from /build: both pages opt in to a view transition, so Ray's portrait morphs into the CTO's (Turbo 8). %>
<% content_for :head, tag.meta(name: "view-transition", content: "same-origin") %>
<% client = @cto.client? %>
<div data-test="cto-chat-page" data-app="<%= @app.slug %>" data-soul="<%= @cto.soul %>">
  <% head = capture do %>
    <% role = capture do %>CTO of <%= @app.name %><% end %>
    <%# A client app's CTO wears its own colours and portrait (AppCto, docs/agents/system/client-cto.md). %>
    <%= render "agent_chats/header", name: @cto.display_name, agent: @cto.agent, role: role,
                                     portrait: (render("applications/cto_avatar", cto: @cto, size: "xl") if client) %>
  <% end %>
  <% status = render "agent_chats/devops_card", app: @app, stages: @stages, meter: (@meter if @available), client: client,
                                                palette_style: (client_cto_palette_style(@cto.app_cto) if client) %>
  <% chat = capture do %>
    <% if @available %>
      <% unless @answered %>
        <p class="card p-3 text-sm text-warning-ink border-warning/40" data-test="cto-chat-unanswered">
          <%= @cto.display_name %> does not answer your account yet, so your messages wait for an admin to release them.
        </p>
      <% end %>
      <%= render "agent_chats/chat", agent_name: @cto.display_name, stream: @stream, channel: CtoChatChannel, messages: @messages,
                                     composer: composer_locals, empty: "Ask #{@cto.display_name} anything about #{@app.name}." %>
    <% else %>
      <p class="card p-4 text-sm text-secondary" data-test="cto-chat-unavailable">
        <%= @cto.display_name %> has no web chat yet.
      </p>
    <% end %>
  <% end %>
  <%= render "agent_chats/shell", page: "app", head: head, status: status, chat: chat %>
</div>
