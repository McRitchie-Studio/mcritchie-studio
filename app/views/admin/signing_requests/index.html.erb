<div class="max-w-5xl mx-auto px-4 py-8">
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-extrabold text-heading">Signing Console</h1>
      <p class="text-secondary text-sm mt-1">Keyless multi-party signing queue — the server holds no keys.</p>
    </div>
    <%= link_to "New request", new_admin_signing_request_path, class: "btn btn-primary" %>
  </div>

  <% if @requests.empty? %>
    <div class="card p-8 text-center text-secondary">No signing requests yet.</div>
  <% else %>
    <div class="card overflow-hidden">
      <table class="w-full text-sm">
        <thead class="text-secondary border-b border-subtle">
          <tr>
            <th class="text-left p-3">Instruction</th>
            <th class="text-left p-3">Cluster</th>
            <th class="text-left p-3">Mode</th>
            <th class="text-left p-3">Signed</th>
            <th class="text-left p-3">Status</th>
            <th class="p-3"></th>
          </tr>
        </thead>
        <tbody>
          <% @requests.each do |sr| %>
            <tr class="border-b border-subtle/50">
              <td class="p-3 font-medium text-heading"><%= sr.instruction_name %><div class="text-xs text-muted"><%= sr.program %></div></td>
              <td class="p-3"><%= sr.cluster %></td>
              <td class="p-3"><%= sr.coordination %></td>
              <td class="p-3"><%= sr.signers_signed.length %> / <%= sr.threshold %></td>
              <td class="p-3">
                <span class="px-2 py-0.5 rounded text-xs <%= sr.broadcast? ? 'bg-green-900/40 text-green-300' : (sr.status == 'failed' ? 'bg-red-900/40 text-red-300' : 'bg-surface-alt text-secondary') %>"><%= sr.status_label %></span>
              </td>
              <td class="p-3 text-right"><%= link_to "Open", admin_signing_request_path(sr), class: "text-primary underline" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
