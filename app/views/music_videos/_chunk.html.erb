<%# One chunk of the tiled video: its preview, window, overlap with the chunk before, cast shape, target and prompt; the hand-off for the hand swap (source file, prompt, look); the generated takes uploaded back; and the regenerate flag. No decision: chunks are not approved or rejected. %>
<% url = clip_urls[chunk.object_key] %>
<% takes = chunk.takes %>
<% current = chunk.current_take %>
<% recast = chunk.swap_target %>
<% look = recast&.swap_look %>
<% sheet = look && sheets[look.slug] %>
<article id="chunk-<%= chunk.ordinal %>" class="card overflow-hidden scroll-mt-24 min-w-0"
         x-data="clipRow()" data-src="<%= url %>"
         data-test="chunk-row" data-ordinal="<%= chunk.ordinal %>"
         data-take="<%= current&.number %>" data-flagged="<%= chunk.regenerate_requested? %>">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    <div class="relative bg-inset aspect-video" data-test="chunk-preview" data-key="<%= chunk.object_key %>">
      <% if url %>
        <video x-ref="player" x-show="open" x-cloak controls playsinline preload="none"
               class="absolute inset-0 w-full h-full bg-black" data-test="chunk-player"
               @error="failed = true"></video>
        <button type="button" x-show="!open" @click="preview()"
                class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-heading hover:text-primary"
                data-test="chunk-preview-button">
          <svg class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          <span class="text-sm font-semibold">Preview <%= chunk.name.downcase %> source</span>
        </button>
        <p x-show="failed" x-cloak class="absolute bottom-0 inset-x-0 p-2 text-xs text-center bg-surface/90 text-warning-ink"
           data-test="chunk-load-failed">The chunk did not load: <%= chunk.object_key.split("/").last %></p>
      <% else %>
        <p class="absolute inset-0 flex items-center justify-center p-3 text-xs text-muted text-center break-all"
           data-test="chunk-unreachable">Chunk not reachable: <%= chunk.object_key.split("/").last %></p>
      <% end %>
    </div>

    <div class="p-4 flex flex-col gap-3 min-w-0">
      <header class="min-w-0">
        <h3 class="text-lg font-bold text-heading"><%= chunk.name %></h3>
        <p class="text-sm text-body font-mono tabular-nums" data-test="chunk-window">
          <%= video_timecode(chunk.start_ms) %>–<%= video_timecode(chunk.end_ms) %>
          <span class="text-muted">· <%= format("%.1f", chunk.duration_ms / 1000.0) %> s</span>
        </p>
      </header>

      <div class="flex flex-wrap gap-1.5">
        <span class="badge text-xs bg-surface-alt text-body border-subtle" data-test="chunk-shape"><%= clip_shape_label(chunk.cast_shape) %></span>
        <% if chunk.ordinal > 1 && overlap_ms.positive? %>
          <span class="badge text-xs bg-primary/10 text-primary border-primary/20" data-test="chunk-overlap">First <%= clip_seconds(overlap_ms) %> s repeat chunk <%= chunk.ordinal - 1 %></span>
        <% end %>
        <% if current %>
          <span class="badge text-xs bg-success/10 text-success-ink border-success/40" data-test="chunk-take-state"><%= current.name %> current</span>
        <% else %>
          <span class="badge text-xs bg-surface-alt text-muted border-subtle" data-test="chunk-take-state">No take yet</span>
        <% end %>
        <% if chunk.regenerate_requested? %>
          <span class="badge text-xs bg-warning/10 text-warning-ink border-warning/40" data-test="chunk-flag">Regenerate requested</span>
        <% end %>
      </div>

      <%= render "music_videos/swap_target", clip: chunk, prefix: "chunk" %>

      <div class="min-w-0">
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <p class="label-upper">Swap prompt</p>
          <button type="button" @click="copy()" class="btn btn-outline btn-sm" data-test="chunk-copy">
            <span x-text="copied ? 'Copied' : 'Copy'">Copy</span>
          </button>
        </div>
        <p x-ref="prompt" class="text-sm text-body bg-surface-alt border border-subtle rounded-lg p-3 whitespace-pre-wrap break-words select-all"
           data-test="chunk-prompt"><%= chunk.prompt %></p>
        <p x-show="manual" x-cloak class="text-xs text-warning-ink mt-1" data-test="chunk-copy-manual">Copy is blocked here: the prompt is selected, press ⌘C.</p>
      </div>

      <div class="min-w-0" data-test="chunk-handoff">
        <p class="label-upper mb-1.5">Hand-off <span class="normal-case tracking-normal">· the prompt above, the source chunk and the look</span></p>
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2 min-w-0">
          <% if (download = downloads[chunk.object_key]) %>
            <%= link_to "Download source chunk", download, download: chunk.object_key.split("/").last,
                        class: "btn btn-outline btn-sm", data: { test: "chunk-source-download" } %>
          <% else %>
            <span class="text-sm text-muted" data-test="chunk-source-unreachable">Source chunk not reachable.</span>
          <% end %>
          <% if sheet %>
            <%= link_to sheet.image_url, target: "_blank", rel: "noopener", download: "#{look.slug}_character_sheet",
                        class: "btn btn-outline btn-sm min-w-0", data: { test: "chunk-look-sheet", look: look.slug } do %>
              <span class="truncate">Character sheet · <%= recast.recast_label %></span>
            <% end %>
          <% elsif look %>
            <span class="text-sm text-warning-ink min-w-0 break-words" data-test="chunk-look-sheet-missing">
              No character sheet for <%= recast.recast_label %> yet.
              <%= link_to "Open the athlete", person_path(recast.recast_person_slug), class: "text-primary hover:underline" %> to build one.
            </span>
          <% else %>
            <span class="text-sm text-muted" data-test="chunk-look-none">No look: nobody in this chunk is recast yet.</span>
          <% end %>
        </div>
      </div>

      <div class="min-w-0 pt-3 border-t border-subtle" data-test="chunk-takes" data-count="<%= takes.size %>">
        <p class="label-upper mb-1.5">Generated takes</p>
        <% if takes.empty? %>
          <p class="text-sm text-muted mb-2" data-test="chunk-takes-empty">None yet: the stitch preview plays this chunk's source.</p>
        <% else %>
          <ul class="flex flex-col gap-1.5 mb-2">
            <% takes.reverse_each do |take| %>
              <li class="flex flex-wrap items-center justify-between gap-2 min-w-0 text-sm" data-test="chunk-take"
                  data-number="<%= take.number %>" data-current="<%= take == current %>" data-key="<%= take.object_key %>">
                <span class="min-w-0 break-words">
                  <span class="font-semibold text-heading"><%= take.name %></span>
                  <span class="text-muted">· <%= take_size(take.byte_size) %> · <%= l(take.created_at, format: :short) %></span>
                </span>
                <span class="flex items-center gap-2 shrink-0">
                  <% if (take_url = clip_urls[take.object_key]) %>
                    <%= link_to "Open", take_url, target: "_blank", rel: "noopener", class: "text-primary hover:underline", data: { test: "chunk-take-open" } %>
                  <% end %>
                  <% if take == current %>
                    <span class="badge text-3xs bg-success/10 text-success-ink border-success/40">Current</span>
                  <% else %>
                    <%= button_to "Make current", current_music_video_chunk_take_path(video, chunk.ordinal, take.number), method: :post,
                                  class: "btn btn-outline btn-sm", form: { class: "contents", data: { test: "chunk-take-current" } } %>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
        <%= form_with url: music_video_chunk_takes_path(video, chunk.ordinal), method: :post, multipart: true, local: true,
                      class: "flex flex-col sm:flex-row gap-2 min-w-0",
                      html: { "x-data": "{ busy: false }", "@submit": "busy = true", data: { test: "chunk-take-form" } } do %>
          <label class="sr-only" for="chunk-take-file-<%= chunk.ordinal %>">Generated MP4 for <%= chunk.name.downcase %></label>
          <input id="chunk-take-file-<%= chunk.ordinal %>" type="file" name="file" accept="video/mp4,.mp4" required
                 class="input-field py-2 text-sm min-w-0 flex-1" data-test="chunk-take-file">
          <button type="submit" class="btn btn-primary btn-sm shrink-0" :disabled="busy" data-test="chunk-take-submit">
            <span x-show="!busy">Upload take</span>
            <span x-show="busy" x-cloak>Uploading, keep this tab open…</span>
          </button>
        <% end %>
        <p class="text-3xs text-muted mt-1">MP4, up to <%= MusicVideos::StoreTake::MAX_BYTES / 1024 / 1024 %> MB. Every upload is kept as its own take.</p>
      </div>

      <div class="min-w-0 pt-3 border-t border-subtle" data-test="chunk-regenerate">
        <% if chunk.regenerate_requested? %>
          <div class="flex items-start justify-between gap-2 min-w-0">
            <p class="text-sm text-warning-ink min-w-0 break-words" data-test="chunk-regenerate-note">
              <span class="font-semibold">Regenerate requested</span><% if chunk.regenerate_note.present? %>: <%= chunk.regenerate_note %><% end %>
              <span class="block text-muted">The next uploaded take clears it.</span>
            </p>
            <%= button_to "Clear", music_video_chunk_regenerate_path(video, chunk.ordinal), method: :delete,
                          class: "btn btn-outline btn-sm shrink-0", form: { data: { test: "chunk-regenerate-clear" } } %>
          </div>
        <% else %>
          <%= form_with url: music_video_chunk_regenerate_path(video, chunk.ordinal), method: :post, local: true,
                        class: "flex flex-col sm:flex-row gap-2 min-w-0", data: { test: "chunk-regenerate-form" } do %>
            <label class="sr-only" for="chunk-regenerate-note-<%= chunk.ordinal %>">What is wrong with <%= chunk.name.downcase %> (optional)</label>
            <input id="chunk-regenerate-note-<%= chunk.ordinal %>" type="text" name="note" maxlength="<%= VideoClip::REGENERATE_NOTE_MAX %>"
                   placeholder="What is wrong (optional)" class="input-field py-2 text-sm min-w-0 flex-1" data-test="chunk-regenerate-input">
            <button type="submit" class="btn btn-outline btn-sm shrink-0">Request regenerate</button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</article>
