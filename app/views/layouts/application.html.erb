<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "McRitchie Studio" %></title>
    <%= csrf_meta_tags %>
    <%= render "layouts/studio/head" %>
  </head>

  <body x-data class="bg-page text-body min-h-screen" :class="{ 'dev-mode': $store.devMode }">
    <%= render "layouts/studio/flash" %>
    <%# Link-sidebar store bridge: engine-owned since studio-engine 0.30 —
        components/_link_sidebar carries it. %>
    <%# The bar stack is the header's SIBLING, not its child (studio-engine 0.33):
        bars compose independently of the navbar. Since 0.39 the stack sits in
        NORMAL FLOW and reserves its own height, so the header pins at a static
        top-0 and a taller bar — or a second one, like impersonation — pushes the
        header down with no change here. Nothing measures, so there is no
        published height to offset by. %>
    <%= render "studio/banners/stack" %>
    <header x-data="{ scrolled: false }" @scroll.window="scrolled = scrolled ? (window.scrollY > 5) : (window.scrollY > 60)"
            class="vt-pinned-header sticky top-0 z-50 border-b bg-page/95 transition-shadow duration-300 supports-[backdrop-filter]:backdrop-blur"
            :class="scrolled ? 'shadow-lg border-subtle' : 'border-transparent'">
      <div class="max-w-7xl mx-auto px-4 transition-all duration-300"
           :class="scrolled ? 'py-2' : 'py-6'">
        <div class="flex items-center justify-between gap-4 min-w-0">
          <div class="flex items-center gap-6 min-w-0">
            <%= link_to root_path, class: "inline-flex items-center gap-3 group" do %>
              <%= image_tag "logo-icon.svg", class: "invert transition-all duration-300 dark:invert-0", "x-bind:class": "scrolled ? 'w-5 h-5' : 'w-8 h-8'" %>
              <h1 class="font-extrabold text-heading tracking-tight transition-all duration-300"
                  x-bind:class="scrolled ? 'text-base' : 'text-2xl'">McRitchie <span class="text-primary">Studio</span></h1>
            <% end %>
          </div>

          <% if logged_in? %>
            <%= render "components/user_nav", show_logout_link: true %>
          <% else %>
            <div class="flex items-center gap-3">
              <span class="hidden md:flex items-center gap-3">
                <%= render "components/link_sidebar_trigger" %>
                <%= render "components/theme_toggle" %>
              </span>
              <%= link_to "Say Hi 👋", login_path, class: "btn btn-primary whitespace-nowrap" %>
            </div>
          <% end %>
        </div>
      </div>
      <%# Mobile sub-navbar — logged-out theme + links-menu access %>
      <% unless logged_in? %>
        <div class="flex md:hidden items-center justify-end gap-3 px-4 py-1.5 border-t border-subtle bg-surface-alt">
          <%= render "components/link_sidebar_trigger" %>
          <%= render "components/theme_toggle" %>
        </div>
      <% end %>
    </header>
    <%= render "components/link_sidebar" %>

    <% if content_for?(:full_width) %>
      <%= yield %>
    <% else %>
      <div class="max-w-7xl mx-auto px-4 py-6">
        <%= yield %>
      </div>
    <% end %>

    <%# Modal host (engine) + the app's modal partials. Powers the Connect-Wallet
        picker and the "check your inbox" magic-link confirmation. %>
    <%= render "studio/modals/host" do %>
      <template x-if="$store.modals.current().id === 'wallet-connect'">
        <%= render "modals/wallet_connect" %>
      </template>
      <template x-if="$store.modals.current().id === 'check-inbox'">
        <%= render "modals/check_inbox" %>
      </template>
      <%# The shared first-name step (engine primitive). Rendered from the gem so
          this app and turf-monster ask the same question the same way; the
          endpoints behind it come from config.draw_onboarding_routes. %>
      <template x-if="$store.modals.current().id === 'onboarding-first-name'">
        <%= render "studio/modals/onboarding/first_name",
                   subtext: "Just your first name — we use it to address you in emails." %>
      </template>
    <% end %>

    <%# Ask a freshly signed-in account for a first name, once. The SERVER decides
        whether it is still outstanding (blank field, not skipped this session);
        the client only opens what it was told to.
        Armed on two events because either can be the one that happens: a full page
        load fires alpine:initialized, while a Turbo visit does not — Alpine is
        already up, so turbo:load is the only signal there. Both are guarded
        against double-pushing the same modal onto the stack. %>
    <% if logged_in? && Studio.first_name_outstanding?(current_user, session) %>
      <script>
        (function () {
          function askFirstName() {
            if (!window.Alpine || !Alpine.store) return;
            var store = Alpine.store('modals');
            if (!store || typeof store.open !== 'function') return;
            var already = (store.stack || []).some(function (entry) {
              return entry && entry.id === 'onboarding-first-name';
            });
            if (already) return;
            store.open('onboarding-first-name');
          }

          document.addEventListener('alpine:initialized', askFirstName);
          document.addEventListener('turbo:load', askFirstName);
        })();
      </script>
    <% end %>

    <%# Shared Solana sign-in + magic-link request. Inline so they're always
        defined; window.walletProvider comes from the wallet_provider importmap
        module (loaded before the modal can be opened). %>
    <script>
      window.solanaConnectAndVerify = async function (walletName, opts) {
        opts = opts || {};
        var provider = walletName ? window.walletProvider.get(walletName) : window.walletProvider.detect();
        if (!provider) throw new Error('Wallet not available');
        var resp = await provider.connect();
        var pubkeyB58 = resp.publicKey.toBase58();
        var data = await (await fetch('/auth/solana/nonce')).json();
        var domain = window.location.host;
        var message = domain + ' wants you to sign in with your Solana account:\n' + pubkeyB58 +
          '\n\nSign in to McRitchie Studio\n\nNonce: ' + data.nonce;
        var signed = await provider.signMessage(new TextEncoder().encode(message), 'utf8');
        var signatureB58 = window.encodeBase58(signed.signature);
        return await (await fetch('/auth/solana/verify', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
          body: JSON.stringify({ message: message, signature: signatureB58, pubkey: pubkeyB58 })
        })).json();
      };

      window.postMagicLink = async function (email) {
        var body = new URLSearchParams();
        body.set('email', email || '');
        var resp = await fetch('/magic_link', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'Accept': 'application/json',
                     'X-CSRF-Token': document.querySelector('meta[name="csrf-token"]')?.content || '' },
          body: body.toString()
        });
        var payload = {};
        try { payload = await resp.json(); } catch (e) { payload = {}; }
        if (!resp.ok || payload.success === false) throw new Error(payload.error || 'Magic link request failed');
        return Object.assign({ success: true }, payload);
      };

      // Hook for post-verify UX (e.g. flag a brand-new account). No-op for now.
      window.handleSolanaVerifySuccess = function (result) {};
    </script>

    <%# window.studioBoard — the Alpine factory behind the studio/board primitive
        (the tasks, news, and content kanban boards; the depth chart is still
        bespoke, pending primitive support for its within-lane depth/lane shape).
        It MUST live at page level: a <script> inside the board component template
        would be cloned by Alpine and never run. Vendored SortableJS is already
        loaded globally by layouts/studio/_head. %>
    <%= render "studio/board_assets" %>

    <%# The "at" format's re-stamper, owned by studio-engine (Studio::AtTimeHelper).
        The hub's local fork is retired: the two copies were kept byte-identical BY
        HAND, and the Indiana/Louisville zone-alias bug had to be fixed twice. One
        copy, in the gem, is the whole point of this render.

        Installed page-level for the whole app, not per-view: any page may render an
        at_time_tag, and every one of them needs the viewer's clock and flag.
        Self-guarded, so a second render is a no-op.

        LAST in the body, deliberately. Its first pass runs synchronously as the
        script parses, so moving it into head finds zero stamps on that pass and
        leaves every one of them showing the app-timezone fallback until the next
        sweep. Guarded by test/integration/at_time_gem_adoption_test.rb. %>
    <%= render "studio/at_time_script" %>
  </body>
</html>
