<% stages = Task::BOARD_STAGES + ["archived"] %>
<% agent_avatars = @agents.index_by(&:slug).transform_values(&:avatar) %>

<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

<%# kanbanBoard must be defined inline (before Alpine CDN defer evaluates x-data) %>
<script>
function kanbanBoard() {
  return {
    _pendingMoves: {},
    agentFilter: '',
    showArchived: false,
    toasts: [],

    stageLabels: <%= raw Task::STAGE_LABELS.to_json %>,

    matchesFilter(agent) {
      return !this.agentFilter || agent === this.agentFilter;
    },

    init() {
      this.$nextTick(() => this.initSortables());
    },

    initSortables() {
      document.querySelectorAll('.kanban-dropzone').forEach(zone => {
        Sortable.create(zone, {
          group: 'kanban',
          animation: 150,
          ghostClass: 'opacity-30',
          draggable: '.kanban-card',
          filter: '.kanban-empty',
          onEnd: (evt) => this.handleSortEnd(evt)
        });
      });
    },

    async handleSortEnd(evt) {
      const card = evt.item;
      const slug = card.dataset.slug;
      const oldStage = card.dataset.stage;
      const newZone = evt.to;
      const newStage = newZone.dataset.stage;
      const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;

      // Stage changed — update via PATCH
      if (oldStage !== newStage) {
        card.dataset.stage = newStage;
        try {
          const resp = await fetch('/tasks/' + slug + '.json', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
            body: JSON.stringify({ task: { stage: newStage } })
          });
          if (!resp.ok) {
            const err = await resp.json().catch(() => ({}));
            throw new Error(err.error || 'Failed (' + resp.status + ')');
          }
          this.showToast('Task moved to ' + this.stageLabels[newStage], 'success');
        } catch (err) {
          // Revert: move card back to old column
          const oldZone = document.getElementById('dropzone-' + oldStage);
          if (oldZone) {
            oldZone.insertBefore(card, oldZone.querySelector('.kanban-empty'));
            card.dataset.stage = oldStage;
          }
          card.classList.add('ring-2', 'ring-red-500');
          setTimeout(() => card.classList.remove('ring-2', 'ring-red-500'), 1500);
          this.showToast(err.message || 'Move failed', 'error');
          this.updateCounts();
          return;
        }
      }

      // Save order of destination column
      const slugs = Array.from(newZone.querySelectorAll('.kanban-card')).map(c => c.dataset.slug);
      try {
        await fetch('/tasks/reorder.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken },
          body: JSON.stringify({ slugs: slugs })
        });
      } catch (err) {
        // Reorder save failed silently — positions will be stale but functional
      }

      this.updateCounts();
    },

    updateCounts() {
      document.querySelectorAll('[data-stage-count]').forEach(badge => {
        const stage = badge.dataset.stageCount;
        const zone = document.getElementById('dropzone-' + stage);
        if (zone) {
          const count = zone.querySelectorAll('.kanban-card').length;
          badge.textContent = count;
          const empty = zone.querySelector('.kanban-empty');
          if (empty) empty.style.display = count === 0 ? 'flex' : 'none';
        }
      });
    },

    async archiveTask(slug) {
      if (this._pendingMoves[slug]) return;
      this._pendingMoves[slug] = true;

      const card = document.getElementById('card-' + slug);
      const oldStage = card?.dataset.stage;
      const archivedZone = document.getElementById('dropzone-archived');

      if (card && archivedZone) {
        archivedZone.insertBefore(card, archivedZone.querySelector('.kanban-empty'));
        card.dataset.stage = 'archived';
        this.updateCounts();
      }

      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/tasks/' + slug + '/archive.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': csrfToken }
        });
        if (!resp.ok) throw new Error('Archive failed');
        this.showToast('Task archived', 'success');
      } catch (err) {
        if (card && oldStage) {
          const oldZone = document.getElementById('dropzone-' + oldStage);
          if (oldZone) {
            oldZone.insertBefore(card, oldZone.querySelector('.kanban-empty'));
            card.dataset.stage = oldStage;
            this.updateCounts();
          }
        }
        this.showToast(err.message, 'error');
      } finally {
        delete this._pendingMoves[slug];
      }
    },

    async deleteTask(slug) {
      if (!confirm('Delete this task?')) return;
      if (this._pendingMoves[slug]) return;
      this._pendingMoves[slug] = true;

      const card = document.getElementById('card-' + slug);

      try {
        const csrfToken = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/tasks/' + slug + '.json', {
          method: 'DELETE',
          headers: { 'X-CSRF-Token': csrfToken }
        });
        if (!resp.ok) throw new Error('Delete failed');
        if (card) card.remove();
        this.updateCounts();
        this.showToast('Task deleted', 'success');
      } catch (err) {
        this.showToast(err.message, 'error');
      } finally {
        delete this._pendingMoves[slug];
      }
    },

    showToast(message, type) {
      const id = Date.now();
      const toast = { id, message, type, visible: true };
      this.toasts.push(toast);
      setTimeout(() => {
        const t = this.toasts.find(t => t.id === id);
        if (t) t.visible = false;
        setTimeout(() => { this.toasts = this.toasts.filter(t => t.id !== id); }, 300);
      }, 3000);
    }
  }
}
</script>

<section x-data="kanbanBoard()" class="min-h-screen">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-heading">Tasks</h2>
    <div class="flex items-center gap-3">
      <select x-model="agentFilter"
              class="bg-surface border border-subtle text-body text-sm rounded-lg px-3 py-2 focus:border-primary focus:outline-none">
        <option value="">All Agents</option>
        <% @agents.each do |agent| %>
          <option value="<%= agent.slug %>"><%= agent.name %></option>
        <% end %>
      </select>

      <button @click="showArchived = !showArchived"
              :class="showArchived ? 'bg-primary text-white' : 'bg-surface text-secondary border border-subtle hover:text-heading'"
              class="px-3 py-2 rounded-lg text-sm font-medium transition">
        Archived
      </button>

      <% if logged_in? %>
        <%= link_to "New Task", new_task_path, class: "btn btn-primary" %>
      <% end %>
    </div>
  </div>

  <!-- Kanban Board -->
  <div class="flex gap-4 overflow-x-auto pb-4">
    <% stages.each do |stage| %>
      <div class="flex-1 min-w-[220px]"
           <% if stage == 'archived' %>x-show="showArchived" x-cloak<% end %>>
        <!-- Column Header -->
        <div class="flex items-center justify-between mb-3 px-1">
          <div class="flex items-center gap-2">
            <h3 class="text-sm font-bold text-heading uppercase tracking-wider">
              <%= Task::STAGE_LABELS.fetch(stage) %>
            </h3>
            <span class="stage-count inline-flex items-center justify-center min-w-[20px] h-5 px-1.5 rounded-full text-xs font-bold
              <%= task_stage_count_classes(stage) %>"
              data-stage-count="<%= stage %>">
              <%= (@tasks_by_stage[stage] || []).size %>
            </span>
          </div>
        </div>

        <!-- Drop Zone -->
        <div id="dropzone-<%= stage %>"
             data-stage="<%= stage %>"
             class="kanban-dropzone rounded-xl border-2 border-dashed min-h-[calc(100vh-220px)] p-2 space-y-2 transition-colors duration-150 border-subtle">

          <% (@tasks_by_stage[stage] || []).each do |task| %>
            <div id="card-<%= task.slug %>"
                 data-slug="<%= task.slug %>"
                 data-stage="<%= stage %>"
                 data-agent="<%= task.agent_slug %>"
                 x-show="matchesFilter('<%= task.agent_slug %>')"
                 class="kanban-card bg-surface rounded-lg border border-subtle p-3 cursor-grab active:cursor-grabbing hover:border-primary/30 transition group">

              <div class="flex items-center justify-between mb-1.5">
                <a href="<%= task_path(task.slug) %>"
                   class="text-heading font-semibold text-sm truncate flex-1 hover:text-primary transition"
                   @click.stop>
                  <%= task.title %>
                </a>
                <div class="flex items-center gap-1 ml-2 opacity-0 group-hover:opacity-100 transition-opacity shrink-0">
                  <% if task.stage != 'archived' %>
                    <button @click.stop="archiveTask('<%= task.slug %>')"
                            class="text-muted hover:text-yellow-400 transition p-0.5" title="Archive">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
                      </svg>
                    </button>
                  <% end %>
                  <button @click.stop="deleteTask('<%= task.slug %>')"
                          class="text-muted hover:text-red-400 transition p-0.5" title="Delete">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                    </svg>
                  </button>
                </div>
              </div>

              <div class="flex items-center gap-2 mb-1">
                <% if task.priority == 2 %>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-900/50 text-red-300 border border-red-700/50">URG</span>
                <% elsif task.priority == 1 %>
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-yellow-900/50 text-yellow-300 border border-yellow-700/50">HIGH</span>
                <% end %>
                <% if task.agent_slug.present? %>
                  <div class="flex items-center gap-1">
                    <% if agent_avatars[task.agent_slug].present? %>
                      <img src="<%= agent_avatars[task.agent_slug] %>" alt="<%= task.agent_slug %>" class="w-5 h-5 rounded-full object-cover">
                    <% else %>
                      <div class="w-4 h-4 rounded-full bg-primary/20 flex items-center justify-center">
                        <span class="text-primary text-[9px] font-bold"><%= task.agent_slug.first.upcase %></span>
                      </div>
                    <% end %>
                    <span class="text-xs text-muted"><%= task.agent_slug %></span>
                  </div>
                <% end %>
                <div class="ml-auto flex items-center gap-1">
                  <% if task.po_size.present? %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-surface-alt text-secondary border border-subtle" title="po_size (official planning size)"><%= task.po_size == "xl" ? "XL" : task.po_size[0].upcase %></span>
                  <% end %>
                  <% if task.requires_migration %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-orange-900/50 text-orange-300 border border-orange-700/50" title="Requires backend_migration lane">MIG</span>
                  <% end %>
                  <% if task.requires_release_conductor? %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-orange-900/50 text-orange-300 border border-orange-700/50" title="Requires release_train lane">REL</span>
                  <% end %>
                </div>
              </div>

              <% if task.devops? %>
                <div class="flex flex-wrap gap-1 mb-1.5">
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-primary/15 text-primary border border-primary/30"><%= task.devops_kind %></span>
                  <% task.devops_repositories.first(2).each do |repo| %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-surface-alt text-secondary border border-subtle"><%= repo %></span>
                  <% end %>
                  <% if task.devops_release_train.present? %>
                    <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-surface-alt text-secondary border border-subtle"><%= task.devops_release_train %></span>
                  <% end %>
                </div>
                <div class="flex flex-wrap gap-2 text-[10px] mb-1.5">
                  <% if (local_url = task.devops_url("local")) %>
                    <%= link_to "Local", local_url, class: "text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
                  <% end %>
                  <% if (qa_url = task.devops_url("qa")) %>
                    <%= link_to "QA", qa_url, class: "text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
                  <% end %>
                  <% if (production_url = task.devops_url("production")) %>
                    <%= link_to "Prod", production_url, class: "text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
                  <% end %>
                  <% if (pr_url = task.devops_url("pr")) %>
                    <%= link_to "PR", pr_url, class: "text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
                  <% end %>
                </div>
              <% end %>

              <% if task.stage == 'failed' && task.error_message.present? %>
                <p class="text-xs text-red-400/80 truncate mt-1"><%= task.error_message %></p>
              <% end %>

              <% if (latest_activity = @latest_task_activities[task.slug]) %>
                <div class="mt-2 rounded-md border border-subtle bg-inset/60 p-2">
                  <div class="flex items-center gap-1.5 mb-1">
                    <span class="px-1.5 py-0.5 rounded text-[9px] font-bold bg-primary/15 text-primary border border-primary/30">
                      <%= latest_activity.activity_type_label %>
                    </span>
                    <% if (activity_count = @task_activity_counts[task.slug].to_i) > 1 %>
                      <span class="text-[10px] text-muted"><%= activity_count %> notes</span>
                    <% end %>
                  </div>
                  <p class="text-[11px] leading-snug text-secondary line-clamp-2">
                    <%= latest_activity.description %>
                  </p>
                </div>
              <% end %>

              <p class="text-[10px] text-muted mt-1"><%= time_ago_in_words(task.created_at) %> ago</p>
            </div>
          <% end %>

          <!-- Empty State -->
          <div class="kanban-empty flex items-center justify-center h-24 text-muted text-sm"
               <% if (@tasks_by_stage[stage] || []).any? %>style="display: none"<% end %>>
            Drop tasks here
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <!-- Toasts -->
  <div class="fixed top-4 right-4 z-50 space-y-2">
    <template x-for="toast in toasts" :key="toast.id">
      <div x-show="toast.visible"
           x-transition:enter="transition ease-out duration-300"
           x-transition:enter-start="opacity-0 translate-x-8"
           x-transition:enter-end="opacity-100 translate-x-0"
           x-transition:leave="transition ease-in duration-200"
           x-transition:leave-start="opacity-100 translate-x-0"
           x-transition:leave-end="opacity-0 translate-x-8"
           :class="toast.type === 'success' ? 'bg-mint-900/90 border-mint-700 text-mint-300' : 'bg-red-900/90 border-red-700 text-red-300'"
           class="px-4 py-2.5 rounded-lg border text-sm font-medium shadow-lg backdrop-blur-sm">
        <span x-text="toast.message"></span>
      </div>
    </template>
  </div>
</section>
