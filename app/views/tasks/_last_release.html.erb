<%# Last Release module for /deployments: the most-recently shipped release,
    read-only history. Dimmed (opacity-75 + the :last summary variant's muted
    text) so it reads as the past, distinct from the active Current block. When
    nothing has shipped yet, a muted empty state fills the card so the 2×2
    dashboard grid keeps this cell (mirroring the Next Release "none active" card).
    Local: release (the shipped Release, or nil for the empty state). %>
<% rel = local_assigns.fetch(:release, nil) %>
<% base_card_class = ["rounded-xl border border-subtle bg-surface p-4", local_assigns[:card_class]].compact.join(" ") %>
<% if rel %>
  <% fresh_window_ms = fresh_deploy_window_ms %>
  <% fresh_deploy = rel.shipped_at.present? && rel.shipped_at >= (fresh_window_ms / 1000.0).seconds.ago %>
  <% fresh_deploy_elapsed_ms = fresh_deploy ? ((Time.current - rel.shipped_at) * 1000).clamp(0, fresh_window_ms).round : nil %>
  <% fresh_glow_style = release_fresh_glow_style(rel, elapsed_ms: fresh_deploy_elapsed_ms) if fresh_deploy %>
  <% release_card_class = [
       base_card_class,
       ("opacity-75" unless fresh_deploy),
       ("studio-border-glow release-fresh-glow lbfx-fresh-deploy" if fresh_deploy)
     ].compact.join(" ") %>
  <%# The ReleaseFx router (tasks/_release_fx_router) reads all of these:
      data-fresh-deploy + data-shipped-at-ms drive the deploy glow, a WINDOW
      (fresh_deploy_window_ms — 8s in production, injectable for e2e) that resumes
      at the right phase on a reload rather than restarting. data-fresh-window-ms
      publishes that window so the release-ship e2e spec can budget its waits from
      the page itself. data-glow tints the swap glow.
      data-card-signature is what EARNS an animation on a plain replace: the router
      plays the swap glow only when this string moved. Without it the card had no way
      to tell a real change from a redraw, so it animated at every one — and
      .ci_progress redraws this slot byte-identically on every CI upsert. Same
      primitive #current-release uses; see ApplicationHelper#release_card_signature. %>
  <div id="last-release"
       data-glow="<%= rel.mascot&.signature_color %>"
       data-card-signature="<%= release_card_signature(rel) %>"
       data-fresh-deploy="<%= fresh_deploy ? "true" : "false" %>"
       data-fresh-window-ms="<%= fresh_window_ms %>"
       data-shipped-at-ms="<%= (rel.shipped_at.to_f * 1000).round if rel.shipped_at.present? %>"
       <% if fresh_glow_style %>style="<%= fresh_glow_style %>"<% end %>
       class="<%= release_card_class %>">
    <%# The shipped-stage kickoff chip ("Archive completed tasks") rides inline with the
        task pills, mirroring the Next Release card's release workflow chips. %>
    <% archive_chip = render "tasks/kickoff_chip", command: devops_kickoffs["shipped"] %>
    <%= render "tasks/release_summary", release: rel, variant: :last, trailing: archive_chip -%>
  </div>
<% else %>
  <%# No shipped release yet: muted empty state (shared with the Next Release card). %>
  <%= render "tasks/release_card_empty_state", dom_id: "last-release", card_class: base_card_class,
             label: "Last Release", status: "none yet",
             card_signature: release_card_signature(nil),
             hint: "The most recently shipped release will appear here." %>
<% end %>
