<%# 5 · Postcard — greetings from Denver: the map is the picture side, the address is the address. %>
<footer class="ftr bg-surface-alt border-t border-subtle text-body" data-footer="postcard">
  <div class="max-w-5xl mx-auto px-4 pt-14 pb-10">
    <div class="ftr-card grid grid-cols-1 md:grid-cols-2">
      <div class="p-3">
        <%= render "footers/map", facts: facts, classes: "h-64 md:h-full min-h-64 rounded" %>
      </div>

      <div class="relative p-6 md:pl-8 md:border-l border-subtle">
        <div class="flex items-start justify-between gap-4">
          <div class="ftr-postmark text-primary" aria-hidden="true">
            <span>DENVER</span><span>CO</span><span>80205</span>
          </div>
          <div class="ftr-stamp flex items-center justify-center" aria-hidden="true">
            <%= image_tag "logo-icon.svg", class: "w-9 h-9", alt: "" %>
          </div>
        </div>

        <p class="ftr-hand text-xl text-secondary mt-4">Greetings from Denver — stop by, or just say hi.</p>

        <address class="ftr-card-rule not-italic mt-4 text-heading text-lg font-semibold leading-[2.4rem]">
          <span class="block"><%= facts[:name] %></span>
          <span class="block"><%= facts[:street] %></span>
          <span class="block"><%= facts[:city_line] %></span>
          <a href="<%= facts[:phone_href] %>" class="ftr-link block"><%= facts[:phone] %></a>
        </address>

        <div class="mt-5 flex flex-wrap gap-3">
          <a href="mailto:<%= facts[:email] %>" class="btn btn-primary">Write back</a>
          <a href="<%= facts[:directions_url] %>" target="_blank" rel="noopener" class="btn btn-neutral">Directions →</a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
      <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
        <% facts[:explore].each do |label, path| %>
          <li><%= link_to label, path, class: "ftr-link" %></li>
        <% end %>
      </ul>
      <ul class="flex items-center gap-5">
        <% facts[:legal].each do |label, path| %>
          <li><%= link_to label, path, class: "ftr-link font-semibold" %></li>
        <% end %>
      </ul>
    </div>
    <p class="mt-4 text-center md:text-left text-muted text-sm">© <%= Time.current.year %> <%= facts[:name] %> · <%= facts[:hours] %></p>
  </div>
</footer>
