<%# The reader's address. Which email they came from is not shown; it rides
    in the `d` parameter so the unsubscribe or resubscribe is still credited
    to that email in the analytics (UnsubscribesController). %>
<p class="text-secondary">
  <span class="block text-xs uppercase tracking-widest text-muted mb-1">Your address</span>
  <strong class="text-heading break-all" data-unsubscribe-email><%= contact.email %></strong>
</p>
