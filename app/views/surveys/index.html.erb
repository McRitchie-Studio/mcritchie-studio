<% content_for(:title, "Surveys") %>
<div class="max-w-4xl mx-auto px-4 py-8 space-y-6">
  <div>
    <h1 class="text-2xl font-extrabold text-heading">Surveys</h1>
    <p class="text-secondary text-sm mt-1">Feedback forms and what people said. Surveys are defined in code (Survey::REGISTRY).</p>
  </div>
  <div class="card divide-y divide-subtle" data-test="surveys-list">
    <% @surveys.each do |survey| %>
      <div class="p-4 flex flex-wrap items-center justify-between gap-3">
        <div class="min-w-0">
          <%= link_to survey.title, survey_path(survey), class: "font-semibold text-heading hover:text-primary" %>
          <p class="text-xs text-muted mt-1 break-all">Public form: <%= survey_form_url(survey) %>?t=&lt;delivery token&gt;</p>
        </div>
        <span class="text-sm text-secondary"><%= pluralize(@counts[survey.slug].to_i, "response") %></span>
      </div>
    <% end %>
  </div>
</div>
