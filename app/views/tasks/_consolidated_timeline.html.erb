<%# locals: (task:, agents:, events: nil, mascot: nil) %>
<%#
  The CONSOLIDATED stage timeline for /tasks/:id — one panel that replaces the
  separate "Stage Crew" and "Stage Timeline" boxes. Every block is the SAME
  standard container: the stage transition (from → to), the agent(s) that handled
  it (the build-lane mascot · the two senior reviewers · Steffon at QA · Avi at
  ship — Steffon/Avi now backfilled by role when the conductor left no actor), the
  measured time-in-stage, and the model/tokens/cost the agent reported. When the
  task is still live, a trailing IN-PROGRESS block shows who is on the current
  stage right now with a green live ticker (agentic intent: the agent the moment a
  stage's work STARTS, not only when it completes).

  Source: StageAgentsHelper#stage_timeline reads the task's TaskEvents (transitions
  + open intents) and resolves each block's crew. The live ticker reuses the board's
  window.elapsedLabel formatter.
%>
<% blocks = stage_timeline(task, agents, events: events, mascot: mascot) %>
<div class="bg-surface-alt rounded-lg p-3 mb-4" data-test="stage-timeline">
  <div class="mb-3">
    <p class="label-upper">Stage Timeline</p>
    <p class="text-xs text-muted mt-1">Who handled each stage, the time it took (measured), and the model cost reported (best-effort) — plus who's on it right now.</p>
  </div>

  <% if blocks.present? %>
    <%= render "components/elapsed_label_script" %>
    <ol class="space-y-2">
      <% blocks.each do |block| %>
        <li class="bg-surface rounded-lg p-3 border <%= block.in_progress? ? "border-green-400/40" : "border-subtle" %>"
            data-test="timeline-block" data-stage="<%= block.to_stage %>" data-in-progress="<%= block.in_progress? %>">
          <div class="flex items-start gap-3">
            <%# The agent(s) that handled this stage — the standard avatar primitive,
                stacked (heavy/lead on top) when a stage has more than one (review). %>
            <% if block.agents.present? %>
              <div class="flex items-center -space-x-2 shrink-0" data-test="timeline-crew">
                <% block.agents.reverse.each_with_index do |entry, i| %>
                  <div class="rounded-full ring-2 ring-surface relative <%= i.zero? ? "z-20" : "z-10" %>"
                       title="<%= [entry.name, (entry.weight.presence && "(#{entry.weight})")].compact.join(" ") %>">
                    <%= render "components/agent_avatar", agent: entry, size: "sm" %>
                  </div>
                <% end %>
              </div>
            <% end %>

            <div class="min-w-0 flex-1">
              <%# from → to + when (or an in-progress pill) %>
              <div class="flex flex-wrap items-center gap-2 mb-1">
                <%= render "components/badge", text: block.from_label, scheme: block.from_stage.present? ? stage_scheme(block.from_stage) : "neutral" %>
                <span class="text-muted text-xs">&rarr;</span>
                <%= render "components/badge", text: block.to_label, scheme: stage_scheme(block.to_stage) %>
                <% if block.in_progress? %>
                  <span class="px-1.5 py-0.5 rounded-full text-[10px] font-semibold inline-flex items-center gap-1
                               bg-green-500/20 text-green-200 border border-green-400/50" data-test="timeline-inprogress">
                    <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span> in progress
                  </span>
                <% elsif block.occurred_at %>
                  <span class="text-xs text-muted" title="<%= block.occurred_at.strftime("%b %d, %Y %H:%M") %>">
                    <%= block.occurred_at.strftime("%b %d, %H:%M") %> &middot; <%= time_ago_in_words(block.occurred_at) %> ago
                  </span>
                <% end %>
                <% if block.backfilled %>
                  <span class="text-[10px] text-muted uppercase tracking-wide" title="Reconstructed from legacy stage timestamps">reconstructed</span>
                <% end %>
              </div>

              <%# agent name(s) + review weight %>
              <% if block.agents.present? %>
                <div class="flex flex-wrap items-center gap-x-3 gap-y-1 mb-1" data-test="timeline-names">
                  <% block.agents.each do |entry| %>
                    <span class="text-sm text-heading inline-flex items-center gap-1.5">
                      <%= entry.name %>
                      <% if entry.weight.present? %>
                        <span class="px-1 py-px rounded text-[9px] font-bold uppercase tracking-wide
                                     <%= entry.heavy? ? "bg-primary/15 text-primary border border-primary/30" : "bg-surface-alt text-muted border border-subtle" %>"
                              title="<%= entry.heavy? ? "Heavy (deep) review" : "Light review" %>">
                          <%= entry.weight %>
                        </span>
                      <% end %>
                    </span>
                  <% end %>
                </div>
              <% end %>

              <%# duration (live ticker while in progress, measured once done) · usage · source %>
              <div class="flex flex-wrap items-center gap-2 text-xs">
                <% if block.in_progress? && block.live_since %>
                  <span class="px-1.5 py-0.5 rounded tabular-nums inline-flex items-center gap-1
                               bg-green-500/20 text-green-100 border border-green-400/50" data-test="timeline-live"
                        x-data="{ start: <%= block.live_since.to_i %>, now: Math.floor(Date.now() / 1000) }"
                        x-init="setInterval(() => now = Math.floor(Date.now() / 1000), 1000)">
                    &#9201; <span x-text="window.elapsedLabel(now - start)">…</span> in <%= block.from_label %>
                  </span>
                <% elsif (spent = humanize_stage_duration(block.seconds)) %>
                  <span class="text-secondary" title="Measured server-side">&#9201; <%= spent %> in <%= block.from_label %></span>
                <% end %>
                <% if block.usage? %>
                  <span class="px-1.5 py-0.5 rounded bg-surface-alt text-muted border border-subtle font-mono"
                        title="Reported by the agent for the work in this stage (best-effort, per transition)">
                    <%= block.model.presence || "model ?" %><% if block.tokens %> &middot; <%= number_with_delimiter(block.tokens) %> tok<% end %><% if block.cost.present? %> &middot; ~$<%= format("%.2f", block.cost) %><% end %>
                  </span>
                <% end %>
                <% if block.source.present? %>
                  <span class="text-[10px] text-muted uppercase tracking-wide"><%= block.source %></span>
                <% end %>
              </div>
            </div>
          </div>
        </li>
      <% end %>
    </ol>
  <% else %>
    <p class="text-sm text-muted">No stage changes recorded yet.</p>
  <% end %>
</div>
