<%# Return style "record" (task cyvasse-three-return-emails): the reader's own
    Cyvasse history leads. A player with 5 or more games sees their games,
    wins and all-time rank; one with fewer, or no stats, sees their account
    waiting. No merge field is required (Broadcasts::CyvasseReturn), so it
    stages the same readers as the other two styles. One tracked play link.
    The editor's preview, with no reader, shows the history copy with field
    names in braces. %>
<% play_url = broadcast_link(:play, Broadcast::TEMPLATE_LINKS["cyvasse_record"]["play"]) %>
<% history = @merge_fields.nil? || Broadcasts::CyvasseReturn.history?(@merge_fields) %>
<% named = @merge_fields.nil? || Broadcasts::CyvasseReturn.username?(@merge_fields) %>
<% wins = merge_field(:wins, fallback: "") %>
<% losses = merge_field(:losses, fallback: "") %>
<% rank = merge_field(:all_time_rank, fallback: "") %>
<% joined_year = @merge_fields ? Broadcasts::CyvasseYourGames.joined_year(@merge_fields) : "{joined_on}" %>
<% p_style = "margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;" %>
<% content_for :email_reason, "You&rsquo;re receiving this because you have an account on Cyvasse.".html_safe %>
<%= render "broadcasts/email_head",
      hero_file: "cyvasse_header_live.jpg",
      hero_alt:  "A Cyvasse board mid-game",
      preheader: history ? "Every game you played came across to the rebuilt Cyvasse." : "Your Cyvasse account came across to the rebuilt game.",
      title:     history ? "Your record is still here" : "Your account is still here",
      subtitle:  "Cyvasse is back, rebuilt, and your history came with it." %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:28px 32px 8px 32px;">
      <p style="<%= p_style %>"><%= named ? "Hi #{merge_field(:username)}," : "Hi \u{1F44B}\u{1F3FB}" %></p>
      <% if history %>
        <p style="<%= p_style %>" data-tier="history">You played <strong><%= merge_count(:games, "game") %></strong> of Cyvasse<%= " since joining in #{joined_year}" if joined_year.present? %>, and every one is still on the board<%= wins.present? && wins.to_i.positive? ? ", along with your #{merge_count(:wins, 'win')}" : "" %>.<%= " You still hold ##{rank} on the all-time board." if rank.present? %></p>
      <% else %>
        <p style="<%= p_style %>" data-tier="account">Your Cyvasse account came across to the rebuilt game, username and all.</p>
      <% end %>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;" data-block="now">Now there are <strong>live matches</strong>, 30 seconds a move, and a <strong>leaderboard</strong>. Time to add to it.</p>
    </td>
  </tr>

  <% if history && (wins.present? || losses.present? || rank.present?) %>
  <tr>
    <td style="padding:18px 32px 8px 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f6f5ff;border-radius:10px;">
        <tr>
          <% [ [ "Wins", wins ], [ "Losses", losses ], [ "All-time rank", rank.present? ? "##{rank}" : "" ] ].each do |label, value| %>
            <% next if value.blank? %>
            <td style="padding:14px 8px;text-align:center;">
              <div style="font-size:22px;font-weight:800;color:#2b3440;"><%= value %></div>
              <div style="font-size:12px;color:#64748b;text-transform:uppercase;letter-spacing:1px;"><%= label %></div>
            </td>
          <% end %>
        </tr>
      </table>
    </td>
  </tr>
  <% end %>

  <tr>
    <td style="padding:22px 32px 8px 32px;text-align:center;">
      <%= render "broadcasts/button", url: play_url, label: (history ? "Add to your record &rarr;" : "Play Now &rarr;").html_safe, color: "#8E82FE", full_width: true %>
    </td>
  </tr>

  <tr>
    <td style="padding:20px 32px 28px 32px;">
      <p style="margin:0 0 4px 0;font-size:16px;line-height:1.65;color:#2b3440;">See you on the board.</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">&mdash; Alex</p>
    </td>
  </tr>
</table>
