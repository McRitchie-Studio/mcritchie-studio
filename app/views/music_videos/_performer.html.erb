<%# One person on the cast panel, top to bottom: the still and heading; Replace with (the inputs to swap in a new player); the description and sightings; then, pinned to the bottom so cards in a row line up, the Keep Original / Swap back button and who is on screen (the optional artist name, the rolodex). Nothing here has to be pressed before the cast is confirmed. %>
<% sightings = performer.sightings_by_time %>
<article id="person-<%= performer.ordinal %>" class="card flex flex-col min-w-0 scroll-mt-24"
         data-test="performer-card" data-ordinal="<%= performer.ordinal %>" data-resolved="<%= performer.resolved? %>" data-named="<%= performer.named? %>">
  <div class="grid <%= performer.still_object_keys.size > 1 ? 'grid-cols-2' : 'grid-cols-1' %> gap-px bg-inset rounded-t-xl overflow-hidden">
    <% performer.still_object_keys.each do |key| %>
      <% url = still_urls[key] %>
      <figure class="relative bg-inset aspect-video" data-test="performer-still" data-key="<%= key %>">
        <% if url %>
          <img src="<%= url %>" alt="<%= performer.name %>, still <%= key.split('/').last %>" loading="lazy"
               class="block w-full h-full object-cover" onerror="this.hidden = true; this.nextElementSibling.hidden = false">
        <% end %>
        <figcaption class="absolute inset-0 flex items-center justify-center p-3 text-xs text-muted text-center break-all"
                    <%= "hidden" if url %> data-test="still-unreachable">
          Still not reachable: <%= key.split("/").last %>
        </figcaption>
      </figure>
    <% end %>
    <% if performer.still_object_keys.empty? %>
      <div class="aspect-video flex items-center justify-center text-xs text-muted" data-test="performer-no-still">No still</div>
    <% end %>
  </div>

  <% recast_looks = local_assigns.fetch(:recast_looks, {}) %>
  <%= render layout: "music_videos/swap_card", locals: { performer:, video:, looks: recast_looks, rows: local_assigns.fetch(:recast_rows, {}),
                                                        fresh_look: local_assigns[:fresh_look], css: "p-4 flex flex-col gap-3 flex-1 min-w-0" } do %>
    <header class="flex items-start justify-between gap-2 min-w-0">
      <div class="min-w-0">
        <h2 class="text-lg font-bold text-heading"><%= performer.name %></h2>
        <p class="text-sm text-body break-words" data-test="performer-label"><%= performer.label %></p>
      </div>
      <%# Follows the naming search's saves (window.namingCard dispatches naming-saved). %>
      <% badge = performer.artist ? "named" : (performer.extra? ? "extra" : "none") %>
      <span x-data="{ b: '<%= badge %>' }" @naming-saved.window="if ($event.detail.ordinal === <%= performer.ordinal %>) b = $event.detail.named ? ($event.detail.named.kind === 'extra' ? 'extra' : 'named') : 'none'"
            class="badge text-3xs shrink-0" data-state="<%= badge %>" :data-state="b"
            :class="{ named: 'bg-success/10 text-success-ink border-success/40', extra: 'bg-surface-alt text-secondary border-subtle', none: 'bg-surface-alt text-muted border-subtle' }[b]"
            x-text="{ named: 'Named', extra: 'Extra', none: 'Not named' }[b]" data-test="performer-badge"><%= { "named" => "Named", "extra" => "Extra", "none" => "Not named" }[badge] %></span>
    </header>

    <%# Replace with sits at the top, under the still and the heading: it is the card's main job. %>
    <%= render "music_videos/recast", performer: performer, video: video, looks: recast_looks,
               sheet_row: local_assigns[:sheet_row], sheet_ready: local_assigns[:sheet_ready] %>

    <% if performer.confidence_note.present? %>
      <p class="text-sm text-muted" data-test="performer-note"><%= performer.confidence_note %></p>
    <% end %>

    <% { "clear" => "Clearly visible", "partial" => "Partly in frame or background" }.each do |visibility, heading| %>
      <% group = sightings.select { |s| s["visibility"] == visibility } %>
      <% next if group.empty? %>
      <div data-test="sightings-<%= visibility %>">
        <p class="label-upper mb-1.5"><%= heading %> <span class="normal-case tracking-normal">· <%= group.size %></span></p>
        <div class="flex flex-wrap gap-1.5">
          <% group.each do |s| %>
            <% href = video.timecode_url(s["t_ms"]) %>
            <% chip = visibility == "clear" ? "bg-primary/10 text-heading border-primary/20" : "bg-surface-alt text-muted border-subtle" %>
            <% if href %>
              <%= link_to video_timecode(s["t_ms"]), href, target: "_blank", rel: "noopener",
                          class: "font-mono tabular-nums text-xs px-2 py-1 rounded-md border hover:border-primary #{chip}",
                          data: { test: "sighting", t_ms: s["t_ms"] } %>
            <% else %>
              <span class="font-mono tabular-nums text-xs px-2 py-1 rounded-md border <%= chip %>" data-test="sighting" data-t-ms="<%= s["t_ms"] %>"><%= video_timecode(s["t_ms"]) %></span>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <%# Pinned to the bottom (mt-auto): the swap's on/off, then who is on screen. %>
    <div class="mt-auto pt-3 border-t border-subtle space-y-3 min-w-0" data-test="card-bottom">
    <%= render "music_videos/swap_toggle", performer: %>
    <%= render "music_videos/naming", performer:, video:, rows: local_assigns.fetch(:recast_rows, {}) %>
    </div>
  <% end %>
</article>
