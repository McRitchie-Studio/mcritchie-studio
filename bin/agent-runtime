#!/usr/bin/env bash
set -euo pipefail

# McRitchie agent-runtime bootstrap wrapper.
#
# This command is the stable fresh-machine surface. The older
# bin/install-agent-docs command remains as the implementation for now.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALLER="${AGENT_RUNTIME_INSTALLER:-$ROOT/bin/install-agent-docs}"
MARKER_BIN="${AGENT_RUNTIME_MARKER:-$ROOT/bin/agent-marker}"
CODEX_ADAPTER="${AGENT_RUNTIME_CODEX_ADAPTER:-$ROOT/bin/codex-session-title}"
CODEX_UPDATE="${AGENT_RUNTIME_CODEX_UPDATE:-$ROOT/bin/codex-update}"

usage() {
  cat <<'USAGE'
Usage:
  bin/agent-runtime install   # install AGENTS/CLAUDE docs, skills, and agent runtime hooks
  bin/agent-runtime check     # verify installed docs/skills match tracked sources
  bin/agent-runtime doctor    # inspect local marker/runtime configuration
  bin/agent-runtime codex-update [args...]  # controlled Codex update + mascot patch gate
  bin/agent-runtime repair    # alias for install

Fresh machine:
  cd /Users/alex/projects/mcritchie-studio
  bin/agent-runtime install
  bin/agent-runtime doctor
USAGE
}

ok() {
  printf 'ok: %s\n' "$1"
}

warn_line() {
  printf 'warn: %s\n' "$1"
}

fail_line() {
  printf 'fail: %s\n' "$1" >&2
  AGENT_RUNTIME_DOCTOR_STATUS=1
}

RUBY_PATH_PREFIX="${AGENT_RUNTIME_RUBY_PATH_PREFIX:-/opt/homebrew/opt/ruby@3.3/bin:/opt/homebrew/lib/ruby/gems/3.3.0/bin}"
REQUIRED_RUBY_VERSION="${AGENT_RUNTIME_REQUIRED_RUBY_VERSION:-3.3}"
BUNDLER_CHECK_CMD="${AGENT_RUNTIME_BUNDLER_CHECK_CMD:-ruby -S bundle -v}"
RAILS_BOOT_CMD="${AGENT_RUNTIME_RAILS_BOOT_CMD:-bin/rails runner 'print Rails.version'}"
ZPROFILE_PATH="${AGENT_RUNTIME_ZPROFILE:-$HOME/.zprofile}"
ZSH_BIN="${AGENT_RUNTIME_ZSH:-zsh}"

contains_thread_title() {
  local file="$1"
  [ -f "$file" ] && grep -q 'thread-title' "$file"
}

contains_codex_adapter() {
  local file="$1"
  [ -f "$file" ] && grep -q '/bin/codex-session-title' "$file"
}

contains_atomic_capture_hook() {
  local file="$1"
  [ -f "$file" ] && grep -q '/bin/atomic-capture-hook' "$file"
}

contains_close_open_hook() {
  local file="$1"
  [ -f "$file" ] && grep -Eq '/bin/(agent-activity|atomic-event) close-open' "$file"
}

contains_ruby_path_prefix() {
  local file="$1"
  [ -f "$file" ] && grep -Fq "$RUBY_PATH_PREFIX" "$file"
}

ruby_version_meets_requirement() {
  local version="$1"
  local required="$2"
  local major minor req_major req_minor
  IFS=. read -r major minor _ <<EOF
$version
EOF
  IFS=. read -r req_major req_minor _ <<EOF
$required
EOF
  major="${major:-0}"; minor="${minor:-0}"
  req_major="${req_major:-0}"; req_minor="${req_minor:-0}"

  case "$major$minor$req_major$req_minor" in
    *[!0-9]*) return 1 ;;
  esac

  [ "$major" -gt "$req_major" ] || { [ "$major" -eq "$req_major" ] && [ "$minor" -ge "$req_minor" ]; }
}

run_doctor_command() {
  local label="$1" cmd="$2" out_file err_file
  out_file="/tmp/mcritchie-agent-runtime-${label//[^A-Za-z0-9]/-}-out.$$"
  err_file="/tmp/mcritchie-agent-runtime-${label//[^A-Za-z0-9]/-}-err.$$"

  if (cd "$ROOT" && eval "$cmd") >"$out_file" 2>"$err_file"; then
    ok "$label"
  else
    fail_line "$label failed: $cmd"
    sed 's/^/  /' "$err_file" >&2 || true
  fi

  rm -f "$out_file" "$err_file"
}

run_doctor_login_command() {
  local label="$1" cmd="$2" out_file err_file
  out_file="/tmp/mcritchie-agent-runtime-${label//[^A-Za-z0-9]/-}-out.$$"
  err_file="/tmp/mcritchie-agent-runtime-${label//[^A-Za-z0-9]/-}-err.$$"

  if (cd "$ROOT" && "$ZSH_BIN" -lc "$cmd") >"$out_file" 2>"$err_file"; then
    ok "$label"
  else
    fail_line "$label failed in login shell: $cmd"
    sed 's/^/  /' "$err_file" >&2 || true
  fi

  rm -f "$out_file" "$err_file"
}

login_shell_ruby_bin() {
  "$ZSH_BIN" -lc 'command -v ruby' 2>/dev/null || true
}

login_shell_ruby_version() {
  "$ZSH_BIN" -lc 'ruby -e "print RUBY_VERSION"' 2>/dev/null || true
}

# Ask the REAL detector whether the installed Codex runtime can still repaint the
# footer live.
#
# Why this is not optional: the sentinel checked above is a zero-byte opt-in
# touch-file. It records that the operator WANTS live repaint; it can never record
# whether the installed runtime still DELIVERS it. The version line cannot tell them
# apart either — stock and patched Codex both self-report the same `codex-cli`
# version. So an unmanaged `curl ... install.sh` silently swaps the patched runtime
# for a stock one, the footer reverts to a thread UUID, and both the sentinel and the
# version still look fine.
#
# bin/codex-update inspect reads the binary's SessionStart wire-struct arity, which is
# the only signal that distinguishes the two. It exits 2 when live-repaint support is
# missing, and doctor surfaces that as a failure.
check_codex_live_repaint_support() {
  local out status

  if [ ! -x "$CODEX_UPDATE" ]; then
    warn_line "cannot inspect Codex runtime for live repaint support: missing $CODEX_UPDATE"
    return 0
  fi

  status=0
  out="$("$CODEX_UPDATE" inspect 2>&1)" || status=$?

  case "$status" in
    0)
      ok "Codex runtime supports live thread-title repaint ($CODEX_UPDATE inspect)"
      ;;
    2)
      fail_line "Codex runtime lacks live thread-title repaint support; an unmanaged Codex install replaced the patched runtime — restore it with bin/agent-runtime codex-update run"
      printf '%s\n' "$out" | sed 's/^/  /' >&2
      ;;
    *)
      warn_line "Codex runtime inspection did not complete (exit $status): $CODEX_UPDATE inspect"
      printf '%s\n' "$out" | sed 's/^/  /' >&2
      ;;
  esac
}

doctor() {
  AGENT_RUNTIME_DOCTOR_STATUS=0

  [ -x "$MARKER_BIN" ] && ok "marker provider executable: $MARKER_BIN" || fail_line "missing marker provider: $MARKER_BIN"
  [ -x "$CODEX_ADAPTER" ] && ok "Codex adapter executable: $CODEX_ADAPTER" || fail_line "missing Codex adapter: $CODEX_ADAPTER"
  [ -x "$CODEX_UPDATE" ] && ok "Codex update guard executable: $CODEX_UPDATE" || fail_line "missing Codex update guard: $CODEX_UPDATE"
  [ -x "$INSTALLER" ] && ok "runtime installer executable: $INSTALLER" || fail_line "missing runtime installer: $INSTALLER"

  if "$INSTALLER" check >/tmp/mcritchie-agent-runtime-check.$$ 2>/tmp/mcritchie-agent-runtime-check-err.$$; then
    ok "installed agent docs and skills match tracked sources"
  else
    fail_line "installed agent docs or skills are out of date; run bin/agent-runtime install"
    sed 's/^/  /' /tmp/mcritchie-agent-runtime-check-err.$$ >&2 || true
  fi
  rm -f /tmp/mcritchie-agent-runtime-check.$$ /tmp/mcritchie-agent-runtime-check-err.$$

  codex_config="$HOME/.codex/config.toml"
  if contains_thread_title "$codex_config"; then
    ok "Codex config includes thread-title status item"
  else
    fail_line "Codex config missing thread-title status item: $codex_config"
  fi

  if contains_ruby_path_prefix "$ZPROFILE_PATH"; then
    ok "agent zsh login startup prepends required Ruby path"
  else
    fail_line "agent shell login startup missing required Ruby path in $ZPROFILE_PATH ($RUBY_PATH_PREFIX); run bin/agent-runtime install and restart Codex"
  fi

  codex_hooks="$HOME/.codex/hooks.json"
  requirements="${CODEX_REQUIREMENTS_PATH:-/etc/codex/requirements.toml}"
  staged="$HOME/.codex/mcritchie-requirements.toml"
  if contains_codex_adapter "$requirements"; then
    ok "Codex managed requirements include McRitchie hook"
  elif contains_codex_adapter "$codex_hooks"; then
    ok "Codex user hooks include McRitchie fallback hook"
  elif contains_codex_adapter "$staged"; then
    warn_line "managed Codex requirements are staged but not installed: $staged"
  else
    fail_line "Codex hooks do not reference $CODEX_ADAPTER"
  fi

  if contains_atomic_capture_hook "$requirements"; then
    ok "Codex managed requirements include action capture hook"
  elif contains_atomic_capture_hook "$codex_hooks"; then
    ok "Codex user hooks include action capture fallback hook"
  elif contains_atomic_capture_hook "$staged"; then
    warn_line "managed Codex action capture requirements are staged but not installed: $staged"
  else
    fail_line "Codex hooks do not reference $ROOT/bin/atomic-capture-hook"
  fi

  if contains_close_open_hook "$requirements"; then
    ok "Codex managed requirements include activity close-open hook"
  elif contains_close_open_hook "$codex_hooks"; then
    ok "Codex user hooks include activity close-open fallback hook"
  elif contains_close_open_hook "$staged"; then
    warn_line "managed Codex close-open requirements are staged but not installed: $staged"
  else
    fail_line "Codex hooks do not reference bin/agent-activity close-open"
  fi

  sentinel="$HOME/.codex/mcritchie-live-thread-title.enabled"
  if [ -f "$sentinel" ]; then
    ok "live Codex thread-title repaint sentinel enabled"
  else
    warn_line "live Codex thread-title repaint sentinel disabled; stock-compatible persistence still works"
  fi

  if command -v codex >/dev/null 2>&1; then
    ok "codex binary: $(command -v codex) ($(codex --version 2>/dev/null || printf 'version unavailable'))"
    check_codex_live_repaint_support
  else
    warn_line "codex binary not found on PATH"
  fi

  required_ruby_bin="${RUBY_PATH_PREFIX%%:*}/ruby"
  login_ruby_bin="$(login_shell_ruby_bin)"
  login_ruby_version="$(login_shell_ruby_version)"
  if [ "$login_ruby_bin" = "$required_ruby_bin" ] && ruby_version_meets_requirement "$login_ruby_version" "$REQUIRED_RUBY_VERSION"; then
    ok "login shell Ruby path: $login_ruby_bin ($login_ruby_version)"
  else
    fail_line "login shell Ruby path drift: expected $required_ruby_bin with Ruby >= $REQUIRED_RUBY_VERSION, got ${login_ruby_bin:-missing} ${login_ruby_version:-version unavailable}; run bin/agent-runtime install, restart Codex, then rerun doctor"
  fi

  ruby_bin="$(command -v ruby 2>/dev/null || true)"
  ruby_version="$(ruby -e 'print RUBY_VERSION' 2>/dev/null || true)"
  if [ "$ruby_bin" = "$required_ruby_bin" ] && ruby_version_meets_requirement "$ruby_version" "$REQUIRED_RUBY_VERSION"; then
    ok "current shell Ruby path: $ruby_bin ($ruby_version)"
  else
    warn_line "current shell Ruby path is ${ruby_bin:-missing} ${ruby_version:-version unavailable}; already-open shells may need restart after install"
  fi

  run_doctor_login_command "Bundler available under login-shell Ruby" "$BUNDLER_CHECK_CMD"
  run_doctor_login_command "Rails boots under login-shell Ruby" "$RAILS_BOOT_CMD"

  exit "$AGENT_RUNTIME_DOCTOR_STATUS"
}

command="${1:-install}"
case "$command" in
  install)
    shift
    exec "$INSTALLER" install "$@"
    ;;
  repair)
    shift
    exec "$INSTALLER" install "$@"
    ;;
  check)
    shift
    exec "$INSTALLER" check "$@"
    ;;
  doctor)
    shift
    [ "$#" -eq 0 ] || { usage >&2; exit 64; }
    doctor
    ;;
  codex-update)
    shift
    exec "$CODEX_UPDATE" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    printf 'agent-runtime: unknown command: %s\n' "$command" >&2
    usage >&2
    exit 64
    ;;
esac
