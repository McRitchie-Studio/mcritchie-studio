#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/dream — prints a dream sequence from the bank (docs/agents/dreams/).
#
#   bin/dream <soul>                   the soul's whole sequence
#   bin/dream <soul> --task <slug>     the dreams a claim of that task loads for the soul
#   bin/dream list [--task <slug>]     every approved dream with its file, ranked for the task
#   bin/dream platform                 the sequence every session start loads
#   bin/dream index [--write|--check]  print, write or verify docs/agents/dreams/INDEX.md;
#                                      --check also refuses a layer over its budget
#                                      (platform 15, a soul 20, an SOP step 5 approved dreams)
#   bin/dream propose --materialize <finding>
#                                      write the proposed dream a dream-proposal-<task> triage finding
#                                      holds into this desk, as docs/agents/dreams/<soul>/<task>.md
#   bin/dream approvals                list the approvals Alex gave on /dreams that no file carries yet
#   bin/dream apply-approvals          set each pending approval's file to `status: approved` in this
#                                      desk and rewrite INDEX.md, for one batch task
#   bin/dream fired <slug> --decision "<what it changed>"
#                                      record that a dream shaped a decision (the /dreams heat map)
#
# Reads tracked files; --task also reads the task from the board, and prints
# unranked, with the reason on stderr, when it cannot. propose reads the finding
# from the board, runs only in a task desk, and never overwrites a file.
# approvals and apply-approvals read GET /api/v1/dream_approvals; apply-approvals
# runs only in a task desk and flips only a file that reads `status: proposed`.
# fired posts a `dream_fired` action to the session's open activity
# (bin/agent-activity action) and refuses an unknown dream.
# Exit 0 printed · 1 refused, with the reason on stderr · 2 usage.

require "fileutils"
require "open3"
require "pathname"
require_relative "lib/dream_bank"

class DreamCli
  OK = 0
  REFUSED = 1
  USAGE = 2
  HELP_FLAGS = %w[-h --help help].freeze
  INDEX_MODES = %w[--write --check].freeze
  TASK_SLUG = /\A[a-z0-9][a-z0-9-]*\z/
  PROPOSAL = /\Adream-proposal-([a-z0-9][a-z0-9-]*)\z/
  BANK = "docs/agents/dreams"
  FIRED_KIND = "dream_fired"
  # AgentAction::MAX_SUMMARY_LENGTH: the board keeps this much of a decision.
  DECISION_LIMIT = 160

  # `task_reader` answers a slug with the board's task JSON, or nil;
  # `finding_reader` answers a finding slug with its board row, or nil;
  # `approvals_reader` answers the pending approval rows, or nil;
  # `fire_reporter` takes the action's arguments and answers [recorded?, message].
  def initialize(env: ENV, out: $stdout, err: $stderr, task_reader: nil, finding_reader: nil,
                 approvals_reader: nil, fire_reporter: nil, cwd: Dir.pwd)
    @env = env
    @dir = DreamBank.bank_dir(env)
    @out = out
    @err = err
    @task_reader = task_reader || method(:board_task)
    @finding_reader = finding_reader || method(:board_finding)
    @approvals_reader = approvals_reader || method(:board_approvals)
    @fire_reporter = fire_reporter || method(:report_fire)
    @cwd = cwd
  end

  def run(argv)
    return usage(@out, OK) if argv.any? { |arg| HELP_FLAGS.include?(arg) }

    command, *rest = argv
    case command
    when nil then usage(@err, USAGE)
    when "index" then index(rest)
    when "platform" then rest.empty? ? platform : usage(@err, USAGE)
    when "list" then list(rest)
    when "propose" then propose(rest)
    when "approvals" then rest.empty? ? approvals : usage(@err, USAGE)
    when "apply-approvals" then rest.empty? ? apply_approvals : usage(@err, USAGE)
    when "fired" then fired(rest)
    else soul(command, rest)
    end
  end

  private

  def usage(io, code)
    io.puts(File.read(__FILE__)[/^# bin\/dream.*?(?=^\n)/m].gsub(/^# ?/, ""))
    code
  end

  def refuse(reason)
    @err.puts("dream: #{reason}")
    REFUSED
  end

  def platform
    @out.puts(DreamBank.platform_context(DreamBank.platform(dir: @dir)))
    OK
  end

  # [] for no arguments, [slug] for `--task <slug>`, nil for anything else.
  def task_argument(rest)
    return [] if rest.empty?

    rest.size == 2 && rest.first == "--task" && TASK_SLUG.match?(rest[1]) ? [ rest[1] ] : nil
  end

  def soul(name, rest)
    task = task_argument(rest)
    return usage(@err, USAGE) if task.nil?

    slug = DreamBank.canonical_soul(name)
    record = DreamBank.roster[slug]
    return refuse("`#{name}` is not a soul. Souls: #{DreamBank.roster.keys.join(", ")}.") if record.nil?

    facts = task.empty? ? nil : facts_for(task.first)
    text = if facts
      DreamBank.task_context(slug, DreamBank.approved(dir: @dir), facts: facts, task: task.first)
    else
      DreamBank.soul_context(slug, DreamBank.soul(slug, dir: @dir), task: task.first)
    end
    text = "#{record["name"]} has no approved dreams. Role page: `docs/agents/agents/#{slug.tr("-", "_")}/role.md`." if text.empty?
    @out.puts(text)
    OK
  end

  def list(rest)
    task = task_argument(rest)
    return usage(@err, USAGE) if task.nil?

    dreams = DreamBank.approved(dir: @dir)
    facts = task.empty? ? nil : facts_for(task.first)
    scored = facts ? DreamSelector.task(facts) : nil
    dreams = DreamSelector.rank(scored, dreams) if scored
    @out.puts(facts ? "## Approved dreams, ranked for task #{task.first}" : "## Approved dreams")
    dreams.each do |dream|
      label = scored ? "score #{DreamSelector.score(scored, dream)} · " : ""
      @out.puts("#{label}`#{dream.slug}` · #{dream.sequence} · #{File.join(@dir, dream.home, "#{dream.slug}.md")}",
                "  Q: #{dream.question}")
    end
    OK
  end

  # The task's board JSON, or nil with the reason on stderr.
  def facts_for(slug)
    facts = begin
      @task_reader.call(slug)
    rescue StandardError
      nil
    end
    return facts if facts.is_a?(Hash) && !facts.empty?

    @err.puts("dream: could not read task `#{slug}` from the board; printing unranked.")
    nil
  end

  def board_task(slug)
    board_get("/api/v1/tasks/#{slug}")
  end

  def board_finding(slug)
    Array(board_get("/api/v1/triage_findings?slug=#{slug}")).find { |row| row["slug"] == slug }
  end

  def board_approvals
    board_get("/api/v1/dream_approvals")
  end

  # The pending approval rows, or nil with the reason given by the caller.
  def pending_approvals
    rows = begin
      @approvals_reader.call
    rescue StandardError
      nil
    end
    rows.is_a?(Array) ? rows.select { |row| row.is_a?(Hash) } : nil
  end

  def approvals
    rows = pending_approvals
    return refuse("could not read the pending approvals from the board.") if rows.nil?

    @out.puts("## Pending dream approvals (#{rows.size})")
    rows.each do |row|
      @out.puts("`#{row["dream_slug"]}` · #{row["dream_home"]} · approved #{row["approved_at"].to_s[0, 10]} " \
                "by #{row["approved_by"] || "unknown"} · file reads #{row["file_status"]}")
    end
    @out.puts("Write them into the files: bin/dream apply-approvals, in one batch task desk.") unless rows.empty?
    OK
  end

  # Flips each pending approval's file in this desk and rewrites the index. A row
  # whose home or slug is not one token, whose file is absent, or whose file does
  # not read proposed is reported and left alone.
  def apply_approvals
    root = desk
    return refuse("apply-approvals writes into a task desk; #{@cwd} is not inside one.") if root.nil?

    bank = File.join(root, BANK)
    return refuse("#{root} has no #{BANK}/.") unless File.directory?(bank)

    rows = pending_approvals
    return refuse("could not read the pending approvals from the board.") if rows.nil?

    flipped = rows.count { |row| apply_one(bank, row) }
    File.write(File.join(bank, "INDEX.md"), DreamBank.index(dir: bank)) if flipped.positive?
    @out.puts("dream: #{flipped} of #{rows.size} pending approval(s) written#{flipped.positive? ? "; INDEX.md rewritten" : ""}.")
    DreamBank.budget_errors(DreamBank.all(dir: bank)).each { |line| @err.puts("dream: over budget: #{line}") }
    if flipped.positive?
      @out.puts("Commit the files and INDEX.md and submit them as one task. /dreams marks each applied once " \
                "the release ships the file reading approved.")
    end
    OK
  end

  # A dream's home inside the bank: `platform`, a soul, or `sops/<sop>` for a step
  # dream. Nothing else, so an approval row can never name a path outside the bank.
  def bank_home?(home)
    parts = home.split("/", -1)
    return TASK_SLUG.match?(home) if parts.size == 1

    parts.size == 2 && parts.first == DreamBank::STEP_HOME && TASK_SLUG.match?(parts.last)
  end

  def apply_one(bank, row)
    home = row["dream_home"].to_s
    slug = row["dream_slug"].to_s
    unless bank_home?(home) && TASK_SLUG.match?(slug)
      @err.puts("dream: skipped approval `#{home}/#{slug}`: not a bank path.")
      return false
    end

    path = File.join(bank, home, "#{slug}.md")
    text = File.exist?(path) ? File.read(path) : nil
    flipped = text && DreamBank.approve_text(text)
    unless flipped
      @err.puts("dream: skipped `#{home}/#{slug}`: #{text ? "the file does not read status: proposed" : "no file at #{path}"}.")
      return false
    end

    File.write(path, flipped)
    @out.puts("dream: approved #{path}")
    true
  end

  def fired(rest)
    slug = rest.first.to_s
    decision = rest.size == 3 && rest[1] == "--decision" ? rest[2].to_s.strip.gsub(/\s+/, " ") : ""
    return usage(@err, USAGE) unless TASK_SLUG.match?(slug) && !decision.empty?
    return refuse("`#{slug}` is not a dream in #{@dir}.") unless DreamBank.all(dir: @dir).any? { |dream| dream.slug == slug }

    @err.puts("dream: the decision is cut to #{DECISION_LIMIT} characters.") if decision.size > DECISION_LIMIT
    recorded, message = begin
      @fire_reporter.call([ "action", "--kind", FIRED_KIND, "--event-slug", slug, "--summary", decision[0, DECISION_LIMIT] ])
    rescue StandardError => e
      [ false, e.class.name ]
    end
    return refuse("`#{slug}` fired, but nothing was recorded: #{message}") unless recorded

    @out.puts("dream: `#{slug}` fired · #{decision[0, DECISION_LIMIT]}")
    OK
  end

  # Runs `bin/agent-activity action`, which always exits 0, and reads its stdout:
  # only an accepted post prints `atomic-event: action · ...`.
  def report_fire(args)
    out, err, = Open3.capture3(File.expand_path("agent-activity", __dir__), *args)
    recorded = out.include?("atomic-event: action ·")
    [ recorded, (err.strip.empty? ? out : err).strip.lines.last.to_s.strip ]
  end

  def board_get(path)
    require "json"
    require_relative "lib/agent_api"
    api = AgentApi.new(open_timeout: 2, read_timeout: 5, env: @env)
    token = api.token
    response = token && api.http_get(path, bearer: token)
    response && response.code.to_i == 200 ? JSON.parse(response.body)["data"] : nil
  end

  # The desk the command stands in (<repo>/.worktrees/<slug>), or nil.
  def desk
    Pathname.new(File.expand_path(@cwd)).ascend.find do |path|
      path.parent.basename.to_s == ".worktrees" && !path.basename.to_s.start_with?("_")
    end&.to_s
  end

  def propose(rest)
    match = rest.size == 2 && rest.first == "--materialize" ? PROPOSAL.match(rest[1]) : nil
    return usage(@err, USAGE) if match.nil?

    root = desk
    return refuse("propose writes into a task desk; #{@cwd} is not inside one.") if root.nil?
    return refuse("#{root} has no #{BANK}/.") unless File.directory?(File.join(root, BANK))

    row = begin
      @finding_reader.call(rest[1])
    rescue StandardError
      nil
    end
    return refuse("could not read finding `#{rest[1]}` from the board.") unless row.is_a?(Hash)

    body = row["body"].to_s
    dream = DreamBank.parse(body, slug: match[1])
    soul = dream&.souls&.first
    unless dream && dream.status == "proposed" && dream.souls.size == 1 && DreamBank.roster.key?(soul)
      return refuse("finding `#{rest[1]}` does not hold a proposed dream for one known soul.")
    end

    path = File.join(root, BANK, soul, "#{match[1]}.md")
    return refuse("#{path} exists; it is not overwritten.") if File.exist?(path)

    FileUtils.mkdir_p(File.dirname(path))
    File.open(path, File::WRONLY | File::CREAT | File::EXCL) { |file| file.write(body) }
    @out.puts("dream: wrote #{path} (status proposed)",
              "Rewrite its question, answer and why from the source activities, run `bin/dream index --write`, " \
              "and ask Alex to sign off (docs/agents/modules/dream.md Act 3).")
    OK
  end

  def index(rest)
    return usage(@err, USAGE) unless rest.empty? || (rest.size == 1 && INDEX_MODES.include?(rest.first))

    path = File.join(@dir, "INDEX.md")
    text = DreamBank.index(dir: @dir)
    case rest.first
    when "--write"
      File.write(path, text)
      @out.puts("dream: wrote #{path}")
    when "--check"
      current = File.exist?(path) ? File.read(path) : nil
      return refuse("#{path} is stale. Run `bin/dream index --write`.") unless current == text

      over = DreamBank.budget_errors(DreamBank.all(dir: @dir))
      return refuse("over budget:\n  #{over.join("\n  ")}") unless over.empty?

      @out.puts("dream: #{path} is current; every layer is within its budget")
    else
      @out.puts(text)
    end
    OK
  end
end

exit(DreamCli.new.run(ARGV)) if $PROGRAM_NAME == __FILE__
