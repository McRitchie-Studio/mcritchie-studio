<%# The client's live DNS host (DnsHost, read from its nameservers) against what its tier promises: Growth and up promise Cloudflare DNS, so a Growth client on another host reads Migration pending until its nameservers move. %>
<% standing = client.dns_standing(host) %>
<% pill = {
     on_cloudflare: [ "On Cloudflare", "border-success/40 bg-success/10 text-success-ink" ],
     migration_pending: [ "Migration pending", "border-warning/40 bg-warning/10 text-warning-ink" ]
   }[standing] %>
<% if host.nil? %>
  <span class="text-muted" title="No production domain recorded" data-test="stack-dns" data-dns-host="" data-dns-standing="unknown">—</span>
<% else %>
  <span class="inline-flex flex-col items-start gap-1" data-test="stack-dns" data-dns-host="<%= host.key %>" data-dns-standing="<%= standing %>"
        title="<%= host.unknown? ? "#{host.domain}: nameservers did not answer" : "#{host.domain}: #{host.nameservers.join(', ')}" %>">
    <span class="inline-flex items-center gap-1.5 whitespace-nowrap">
      <% if host.cloudflare? %>
        <%= render "packages/brand", key: "cloudflare", size: :chip %>
      <% end %>
      <span class="text-xs font-semibold <%= host.unknown? ? 'text-muted' : 'text-heading' %>"><%= host.unknown? ? "Unknown" : host.label %></span>
    </span>
    <span class="font-mono text-2xs text-muted"><%= host.domain %></span>
    <% if pill %>
      <span class="inline-block whitespace-nowrap rounded-full border px-2 py-0.5 text-2xs font-semibold <%= pill.last %>" data-test="stack-dns-standing"><%= pill.first %></span>
    <% end %>
  </span>
<% end %>
