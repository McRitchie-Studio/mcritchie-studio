#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/onepass-icon — render a client workspace's 1Password vault icon: the
# 1Password lock with the workspace's logo badged in the lower-right corner, on
# a transparent background.
#
#   bin/onepass-icon --workspace treasure
#   bin/onepass-icon --workspace industries --badge ~/Downloads/industries.png
#   bin/onepass-icon --badge logo.png --accent "#8E83FC" --out ~/Desktop/icon.png
#   bin/onepass-icon --list
#
# It writes one PNG and reads it back (size, transparent corner). It never talks
# to 1Password: a custom vault image is uploaded in the 1Password app.
#
# SOP: docs/agents/agents/steffon/sops/onepass-icon.md

require "optparse"
require "fileutils"
require_relative "lib/onepass_icon"

options = { size: OnepassIcon::DEFAULT_SIZE }
parser = OptionParser.new do |o|
  o.banner = "usage: bin/onepass-icon (--workspace SCOPE | --badge PATH) [--logo PATH] [--accent #rrggbb] [--size N] [--out PATH]\n" \
             "       bin/onepass-icon --list"
  o.on("--workspace SCOPE", "workspace scope from config/onepass_icons.yml") { |v| options[:workspace] = v }
  o.on("--badge PATH", "the workspace logo for the corner disc (overrides the scope's)") { |v| options[:badge] = v }
  o.on("--logo PATH", "the main icon (default: the 1Password icon)") { |v| options[:logo] = v }
  o.on("--accent HEX", "ring colour, #rrggbb (default: the scope's, else the badge's average)") { |v| options[:accent] = v }
  o.on("--size N", Integer, "square edge in px (default #{OnepassIcon::DEFAULT_SIZE})") { |v| options[:size] = v }
  o.on("--out PATH", "where to write the PNG (default tmp/onepass-icons/<scope>.png)") { |v| options[:out] = v }
  o.on("--list", "print the workspace scopes and exit") { options[:list] = true }
  o.on("-h", "--help", "show this help") do
    puts o
    exit 0
  end
end

begin
  parser.parse!(ARGV)
rescue OptionParser::ParseError => e
  warn "bin/onepass-icon: #{e.message}"
  warn parser.banner
  exit 2
end

# OptionParser rejects an unknown FLAG but leaves a stray positional in ARGV;
# `bin/onepass-icon logo.png` must not render the default badge while the
# operator watches the path they typed be ignored.
unless ARGV.empty?
  warn "bin/onepass-icon: unexpected argument(s): #{ARGV.join(' ')} — pass files with --badge / --logo"
  exit 2
end

if options[:list]
  OnepassIcon.workspaces.each do |scope, ws|
    badge = ws["badge"] ? ws["badge"] : "(no badge on file — pass --badge)"
    puts format("%-20s %-28s %s  vaults: %s", scope, ws["name"], badge, Array(ws["vaults"]).join(", ").then { |v| v.empty? ? "-" : v })
  end
  exit 0
end

begin
  ws = options[:workspace] ? OnepassIcon.workspace(options[:workspace]) : {}
  badge = options[:badge] || (ws["badge"] && File.join(OnepassIcon::ROOT, ws["badge"]))
  if badge.nil?
    raise OnepassIcon::Error, options[:workspace] ? "workspace #{options[:workspace]} has no badge on file — pass --badge PATH" : "pass --workspace SCOPE or --badge PATH"
  end

  scope = options[:workspace] || File.basename(badge, ".*")
  out = options[:out] || File.join(OnepassIcon::ROOT, "tmp/onepass-icons/#{scope}.png")
  FileUtils.mkdir_p(File.dirname(out)) unless options[:out]

  result = OnepassIcon.render!(logo: options[:logo] || OnepassIcon.default_logo,
                               badge: File.expand_path(badge),
                               out: File.expand_path(out),
                               accent: options[:accent] || ws["accent"],
                               size: options[:size])
  puts "wrote #{result[:out]}  (#{result[:size]}x#{result[:size]}, accent #{result[:accent]}, transparent corner verified)"
rescue OnepassIcon::Error, ArgumentError => e
  warn "bin/onepass-icon: #{e.message}"
  exit 1
end
