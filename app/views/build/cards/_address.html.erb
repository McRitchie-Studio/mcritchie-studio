<%# locals: (card:, message:, request_row:) %>
<%# The domain card (stored as kind "address"), one stack (Alex, 2026-10-18): Ray's suggestions as bare-name chips, then ONE name field with the fixed .mcritchie.app suffix inside it (the visitor types only the name), then Use Domain. The first available suggestion (or the domain already chosen) is preselected and fills the field. THE FIELD IS THE SOURCE OF TRUTH (build_domain.js): the chip whose name is exactly the field's value glows; an edit that matches no chip fades the glow; typing a name back, or another chip's name, lights that chip. A chip tap fills the field without focusing it (no keyboard pops up on a phone). Use Domain glows in the CHOSEN theme's colours (the cta-glow primitive, cta_glow_style) whenever the name is valid and not known to be taken. The field is cleaned as it is typed (the server's AppRequest.normalize_subdomain) and checked live (/build/check); a chip we know is taken is drawn disabled. Use Domain sets the domain through BuildIntake::Choice and relays the visitor's turn, and Ray answers with the summary and Build My App. The server checks again on every tap and again at Build, so the live answer is advice, not a lock. %>
<% names = card["names"] %>
<%# Availability is checked ONCE per render, here, for every suggestion in one pass (AppRequest.unavailable_reasons), and the field's starting answer is drawn from it, so the card makes no request of its own when it arrives; build_chat.js asks /build/check only when the visitor changes the name. Use Domain is disabled while the name is the domain already chosen (a re-tap would spend a turn of Ray's for nothing) or one we know is taken. %>
<% taken = AppRequest.unavailable_reasons(names, except: request_row) %>
<% chosen = request_row.subdomain %>
<% value = chosen.presence || names.find { |name| taken[name].nil? } || names.first %>
<% value_reason = taken[value] unless value == chosen %>
<% status_state, status_text = value == chosen ? [ "idle", "" ] : (value_reason ? [ "taken", value_reason ] : [ "available", "Available" ]) %>
<%= form_with url: build_request_intake_path(request_row.token), method: :patch,
      class: "rounded-2xl border #{chosen ? 'border-primary' : 'border-subtle'} bg-surface p-3 sm:p-4",
      data: { test: "build-card-address", build_address: build_check_path, chosen: chosen.present?, chosen_name: chosen } do %>
  <%= hidden_field_tag :field, "address" %>
  <%= hidden_field_tag :message_id, message.id %>
  <%= hidden_field_tag :client_id, SecureRandom.uuid %>
  <p class="text-center text-base font-semibold text-heading mb-3" id="build-domain-heading-<%= message.id %>">Pick a domain</p>
  <div class="mx-auto flex max-w-sm flex-col items-stretch gap-3" data-test="build-address-stack">
    <div class="flex flex-wrap items-center justify-center gap-2" role="group" aria-labelledby="build-domain-heading-<%= message.id %>" data-test="build-address-suggestions">
      <% names.each do |name| %>
        <button type="button" class="build-domain-chip max-w-full break-all rounded-full border border-subtle px-3 py-1.5 font-mono text-xs text-body hover:border-primary aria-pressed:bg-primary/10 aria-pressed:text-heading disabled:opacity-50 disabled:line-through disabled:cursor-not-allowed"
                aria-pressed="<%= name == value %>" data-build-domain-name="<%= name %>" data-test="build-address-suggestion"
                <%= "disabled" if taken[name] && name != chosen %> title="<%= taken[name] if name != chosen %>"><%= name %></button>
      <% end %>
    </div>
    <%# The name and the suffix, centred as one group: the input is sized to its value (size, kept by build_domain.js; field-sizing where the browser has it), so the name grows outward from the middle. A tap anywhere in the field focuses the input (it is a label). A name too long for a phone scrolls inside the input. %>
    <label class="flex cursor-text items-center justify-center rounded-xl border border-subtle bg-surface px-3 py-2 font-mono text-sm focus-within:border-primary" data-test="build-address-field">
      <span class="sr-only">Your domain name</span>
      <input type="text" name="subdomain" value="<%= value %>" size="<%= [ value.to_s.length, 1 ].max %>" required autocomplete="off" spellcheck="false" autocapitalize="none" maxlength="30"
             aria-describedby="build-domain-suffix-<%= message.id %> build-domain-status-<%= message.id %>" class="min-w-[1ch] max-w-full shrink bg-transparent p-0 text-right text-heading [field-sizing:content] focus:outline-none"
             data-build-address-input data-test="build-address-input">
      <span class="shrink-0 text-muted whitespace-nowrap select-none" aria-hidden="true" data-test="build-address-suffix">.<%= AppRequest::CLIENT_APP_DOMAIN %></span>
    </label>
    <%# The suffix is drawn beside the field and hidden from a screen reader, so the field's description says it ("Ends in .mcritchie.app."), then the live availability line. Outside the label, so the field's NAME is only "Your domain name" and the suffix is read once. %>
    <span class="sr-only" id="build-domain-suffix-<%= message.id %>">Ends in .<%= AppRequest::CLIENT_APP_DOMAIN %>.</span>
    <p class="text-xs text-center min-h-4 data-[state=available]:text-success-ink data-[state=taken]:text-danger-ink text-muted" aria-live="polite"
       id="build-domain-status-<%= message.id %>" data-state="<%= status_state %>" data-build-address-status data-test="build-address-availability"><%= status_text %></p>
    <%= tag.span class: "cta-glow", style: cta_glow_style(request_row.palette), data: { test: "build-address-glow" } do %>
      <button type="submit" class="btn btn-primary w-full" data-build-address-submit data-build-glow="<%= value.present? && value_reason.nil? && value != chosen %>"
              <%= "disabled" if value == chosen || value_reason %> data-test="build-choose-address">Use Domain</button>
    <% end %>
  </div>
<% end %>
