<%# locals: (app_cto:, cto:, href:) %>
<%#
  The launch panel (task build-launch-handoff, Alex 2026-10-18): what a
  successful Build My App swaps the /build agent shell for, in place
  (BuildController#update streams it over [data-agent-shell]). The launch has
  ALREADY happened on the server (AppLaunch); this is presentation only. The new
  CTO's portrait and name, the app's name, and three steps that resolve in turn
  over about eight seconds, each a spinner under the shared CTA glow (cta-glow), then a check, in the app's own colours
  (ClientCtoHelper: --cto-primary / --cto-accent for this mode). Then
  app/javascript/build_launch.js visits the CTO's chat (href), and the portrait
  and caption, which carry the shell's view-transition names, morph into that
  page's head. Under prefers-reduced-motion the steps show done at once and the
  visit follows a short pause. Styles: app/assets/tailwind/build_launch.css.
%>
<% steps = [ "Building Brand Sheet", "Hatching CTO", "Setting Up Domain" ] %>
<build-launch id="<%= BuildController::LAUNCH_ID %>"
              class="build-launch max-w-3xl mx-auto px-4 pt-8 sm:pt-12 pb-10 flex flex-col items-center gap-6 text-center <%= ClientCtoHelper::PALETTE_SWITCH %>"
              style="<%= client_cto_palette_style(app_cto) %>"
              data-href="<%= href %>" data-test="build-launch" data-app="<%= app_cto.app_slug %>">
  <div class="build-launch-portrait cta-glow rounded-full" style="view-transition-name: agent-portrait;" data-test="build-launch-portrait">
    <%= render "applications/cto_avatar", cto: cto, size: "xl" %>
  </div>
  <div class="space-y-1 min-w-0 max-w-full">
    <p class="text-sm text-secondary break-words" style="view-transition-name: agent-caption;" data-test="build-launch-caption">
      <span class="font-semibold text-heading"><%= app_cto.name %></span> · CTO of <%= app_cto.app.name %>
    </p>
    <h1 class="text-2xl sm:text-3xl font-bold text-heading break-words" data-test="build-launch-app"><%= app_cto.app.name %></h1>
  </div>
  <ol class="w-full max-w-sm flex flex-col gap-3 text-left" aria-label="Setting up <%= app_cto.app.name %>" data-test="build-launch-steps">
    <% steps.each_with_index do |label, index| %>
      <%# Each step is a cta-glow wrapper (the shared CTA glow), lit only while it is the active one (data-glow); the card inside is opaque. %>
      <li class="build-launch-step cta-glow" data-glow="<%= index.zero? ? 'on' : 'off' %>"
          data-state="<%= index.zero? ? 'active' : 'pending' %>" data-test="build-launch-step" data-step="<%= index %>">
        <span class="build-launch-card flex items-center gap-3 rounded-2xl border border-subtle bg-surface px-4 py-3">
          <span class="build-launch-icon relative flex h-7 w-7 shrink-0 items-center justify-center rounded-full" aria-hidden="true">
            <span class="build-launch-ring absolute inset-0 rounded-full"></span>
            <svg class="build-launch-check relative h-4 w-4" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 10.5l3.5 3.5 7.5-8"/></svg>
          </span>
          <span class="build-launch-label font-semibold"><%= label %></span>
        </span>
      </li>
    <% end %>
  </ol>
  <p class="sr-only" role="status" aria-live="polite" data-build-launch-status>Setting up <%= app_cto.app.name %>.</p>
  <%= link_to "Go to #{app_cto.name} now", href, class: "text-sm text-muted underline underline-offset-2 hover:text-heading",
              data: { test: "build-launch-skip" } %>
</build-launch>
