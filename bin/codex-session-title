#!/usr/bin/env bash
set -euo pipefail

# Codex thread-title bridge.
#
# PR #233 gives Codex sessions a persisted McRitchie marker:
#   <Pokemon> · <app> · <feature>
#
# Stock Codex CLI 0.142.3 keeps the live footer's thread name in memory, so
# updating SQLite only affects history/resume. A locally patched Codex runtime
# can also consume hookSpecificOutput.threadName from SessionStart and
# PostToolUse hooks and repaint the live footer silently. This hook emits that
# field only when explicitly enabled; otherwise it deliberately prints nothing
# on success to stay compatible with stock Codex.
# A missing session id, unreachable task API, absent sqlite DB, or transient lock
# must never slow or break a new Codex session.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SESSION_KICKOFF="${SESSION_KICKOFF:-$ROOT/bin/session-kickoff}"
AGENT_MARKER="${AGENT_MARKER:-$ROOT/bin/agent-marker}"
SQLITE3="${SQLITE3:-sqlite3}"
CODEX_HOME="${CODEX_HOME:-$HOME/.codex}"
CODEX_STATE_DB="${CODEX_STATE_DB:-$CODEX_HOME/state_5.sqlite}"
LIVE_THREAD_NAME_SENTINEL="${CODEX_SESSION_TITLE_LIVE_SENTINEL:-$CODEX_HOME/mcritchie-live-thread-title.enabled}"
default_projects_dir() {
  local candidate
  candidate="$(cd "$ROOT/.." && pwd)"
  if [ "$(basename "$candidate")" = ".worktrees" ]; then
    cd "$candidate/../.." && pwd
  else
    printf '%s\n' "$candidate"
  fi
}
PROJECTS_DIR="${CLAUDE_PROJECTS_DIR:-$(default_projects_dir)}"

hook_input="$(cat 2>/dev/null || true)"
payload_info="$(
  CODEX_HOOK_INPUT="$hook_input" ruby -rjson -e '
    raw = ENV.fetch("CODEX_HOOK_INPUT", "").strip
    if raw.empty?
      puts ["", "SessionStart", ""].join("\n")
      exit 0
    end

    data = JSON.parse(raw)
    candidates = [
      data["session_id"],
      data["thread_id"],
      data["id"],
      data.dig("session", "id"),
      data.dig("thread", "id")
    ]
    parent_candidates = [
      data["parent_session_id"],
      data["parentSessionId"],
      data["parent_thread_id"],
      data["parentThreadId"],
      data.dig("parent", "session_id"),
      data.dig("parent", "sessionId"),
      data.dig("parent", "thread_id"),
      data.dig("parent", "threadId"),
      data.dig("subagent", "parent_session_id"),
      data.dig("subagent", "parentSessionId")
    ]
    event_name = data["hook_event_name"] || data["hookEventName"] || "SessionStart"
    puts [
      candidates.find { |value| !value.to_s.strip.empty? },
      event_name,
      parent_candidates.find { |value| !value.to_s.strip.empty? }
    ].map(&:to_s).join("\n")
  ' 2>/dev/null || true
)"

payload_sid="$(printf '%s\n' "$payload_info" | sed -n '1p')"
payload_event="$(printf '%s\n' "$payload_info" | sed -n '2p')"
payload_parent="$(printf '%s\n' "$payload_info" | sed -n '3p')"
payload_event="${payload_event:-SessionStart}"

sid="${payload_sid:-${CODEX_THREAD_ID:-}}"
[ -n "$sid" ] || exit 0
export CODEX_THREAD_ID="$sid"
export CODEX_HOOK_EVENT_NAME="$payload_event"
export SESSION_KICKOFF
[ -z "${payload_parent:-}" ] || export MCRITCHIE_PARENT_SESSION_ID="$payload_parent"

[ -x "$AGENT_MARKER" ] || exit 0
marker_args=(current --format title --session-id "$sid" --projects-dir "$PROJECTS_DIR")
[ -z "${payload_parent:-}" ] || marker_args+=(--cwd "$PROJECTS_DIR")
marker="$("$AGENT_MARKER" "${marker_args[@]}" 2>/dev/null || true)"

# Collapse accidental newlines while preserving emoji and normal spacing.
marker="$(printf '%s' "$marker" | awk 'NF { gsub(/[[:space:]]+/, " "); print; exit }')"
[ -n "$marker" ] || exit 0

sql_quote() {
  # SQLite string literal quoting: ' becomes ''.
  printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

live_thread_name_enabled() {
  case "${CODEX_SESSION_TITLE_LIVE_THREAD_NAME:-}" in
    1|true|TRUE|yes|YES|on|ON)
      return 0
      ;;
    0|false|FALSE|no|NO|off|OFF)
      return 1
      ;;
  esac

  [ -f "$LIVE_THREAD_NAME_SENTINEL" ]
}

emit_live_thread_name() {
  CODEX_SESSION_MARKER="$marker" ruby -rjson -e '
    marker = ENV.fetch("CODEX_SESSION_MARKER", "").strip
    exit 0 if marker.empty?
    event_name = ENV.fetch("CODEX_HOOK_EVENT_NAME", "SessionStart")

    puts JSON.generate(
      "hookSpecificOutput" => {
        "hookEventName" => event_name,
        "threadName" => marker
      }
    )
  ' 2>/dev/null || true
}

if command -v "$SQLITE3" >/dev/null 2>&1 && [ -f "$CODEX_STATE_DB" ]; then
  q_sid="$(sql_quote "$sid")"
  q_marker="$(sql_quote "$marker")"
  "$SQLITE3" -cmd ".timeout 1000" "$CODEX_STATE_DB" \
    "UPDATE threads SET title = $q_marker WHERE id = $q_sid;" >/dev/null 2>&1 || true
  retry_delays="${CODEX_SESSION_TITLE_RETRY_DELAYS:-0.3 1 2}"
  if [ -n "$retry_delays" ] && [ "$retry_delays" != "none" ]; then
    (
      for delay in $retry_delays; do
        sleep "$delay" 2>/dev/null || sleep 1
        "$SQLITE3" -cmd ".timeout 1000" "$CODEX_STATE_DB" \
          "UPDATE threads SET title = $q_marker WHERE id = $q_sid;" >/dev/null 2>&1 || true
      done
    ) >/dev/null 2>&1 &
  fi
fi

if live_thread_name_enabled; then
  emit_live_thread_name
fi

exit 0
