<%# Live in-progress timer for the Next Release card. The ACTIVE release's timing
    span carries data-release-ticker + data-since (created_at epoch) + data-prefix;
    data-mode="short" is the CI meter's single-unit clock ("47s", "7m") on a task
    card, ticking while its checks are still running;
    this advances it every second so the operator watches the clock climb. A span
    with data-mode="ago" ticks the OTHER direction of the same math — time since a
    tracker stage STARTED ("4m ago"). data-mode="countdown" uses the same elapsed
    seconds against a stage-average target and flips to negative after overrun.
    It re-queries the DOM each tick, so a Turbo-Streamed card swap
    (DeploymentsBroadcaster → LiveBoardFx) is picked up automatically with no
    re-wiring. Installed once and survives Turbo navigations. fmt() MUST match
    ApplicationHelper#format_elapsed_clock, and agoFmt() renders the same
    server-side "X ago" shape, so the server-rendered initial value and
    the first tick agree. %>
<script>
  (function () {
    if (window.__releaseTicker) return;
    window.__releaseTicker = true;

    function fmt(secs) {
      if (secs < 60) return secs + "s";
      var m = Math.floor(secs / 60), s = secs % 60;
      if (m < 60) return m + "m " + String(s).padStart(2, "0") + "s";
      var h = Math.floor(m / 60), mm = m % 60;
      return h + "h " + String(mm).padStart(2, "0") + "m";
    }

    // The CI meter's SINGLE-UNIT ladder: "1s".."59s", "1m".."59m", then "1h 04m".
    // MUST match ApplicationHelper#compact_elapsed_short, or the server-rendered
    // first paint and the first tick disagree.
    function shortFmt(secs) {
      if (secs < 60) return secs + "s";
      var m = Math.floor(secs / 60);
      if (m < 60) return m + "m";
      var h = Math.floor(m / 60), mm = m % 60;
      return h + "h " + String(mm).padStart(2, "0") + "m";
    }

    function agoFmt(secs) {
      if (secs < 60) return secs + "s ago";
      var m = Math.floor(secs / 60);
      if (m < 60) return m + "m ago";
      var h = Math.floor(m / 60), mm = m % 60;
      return h + "h " + String(mm).padStart(2, "0") + "m ago";
    }

    function tick() {
      var now = Math.floor(Date.now() / 1000);
      document.querySelectorAll("[data-release-ticker]").forEach(function (el) {
        var since = parseInt(el.dataset.since || "0", 10);
        if (!since) return;
        var secs = Math.max(0, now - since);
        if (el.dataset.mode === "countdown") {
          var average = parseInt(el.dataset.averageSeconds || "0", 10);
          if (!average) return;
          var remaining = average - secs;
          var overrun = remaining < 0;
          el.dataset.overrun = overrun ? "true" : "false";
          // "~" marks the positive prediction as a forecast (time remaining), "-" the
          // overrun.
          el.textContent = (overrun ? "-" : "~") + fmt(Math.abs(remaining));

          var averageTitle = el.dataset.averageTitle || "Historical average";
          el.title = averageTitle + ": " + fmt(average) +
            " · elapsed " + fmt(secs) + " · " +
            (overrun ? "over by " + fmt(Math.abs(remaining)) : fmt(remaining) + " left");
        } else if (el.dataset.mode === "short") {
          el.textContent = shortFmt(secs);
        } else if (el.dataset.mode === "ago") {
          el.textContent = agoFmt(secs);
          if (!el.dataset.titled) {
            el.dataset.titled = "1";
            var startedAt = new Date(since * 1000).toLocaleString([], {
              month: "short", day: "numeric", hour: "numeric", minute: "2-digit"
            });
            el.title = "Started " + startedAt +
              (el.dataset.took ? " · took " + el.dataset.took : "");
          }
        } else {
          el.textContent = (el.dataset.prefix || "") + fmt(secs);
        }
      });
    }

    setInterval(tick, 1000);
    tick();
  })();
</script>
