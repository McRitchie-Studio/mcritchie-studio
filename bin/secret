#!/usr/bin/env bash
# bin/secret — the ONE read path for credentials on this Mac.
#
#   bin/secret status | get <name> | refresh <name> | forget <name> | contingency <name> | migrate | prewarm
#       the secret cache (<projects>/.secret-cache; bin/lib/secret_cache_cli.rb;
#       docs/agents/modules/secret-cache.md): cache first, 1Password on a miss,
#       an expiry or a read inside the refresh window, bounded, then written back.
#   bin/secret <vault> <item> [field]
#       the classic read: print a 1Password secret VALUE to stdout. When the
#       manifest names this item (kind "op-item"; none do by default) it is served
#       from the cache too.
#
# The value goes to stdout (so `SECRET="$(bin/secret agents agent.heroku 'api key')"`
# works); all diagnostics go to stderr; the value is never logged or echoed.
# Verifies the op CLI is present and authenticated first. This is the sanctioned
# replacement for hand-rolling `op read` chains in agent scripts.
set -euo pipefail

# SECRET_OP_BIN is a TEST SEAM, mirroring GH_APP_OP_BIN (bin/gh-app-git-credential)
# and GH_TOKEN_OP_BIN (bin/gh-token). Every other `op` consumer in this stack had
# one; this script did not, and the absence had a cost — its fallback behaviour
# could not be tested without SPENDING REAL READS against the operator's live
# vault, because the hardcoded path ignores PATH and so ignores any stand-in a
# test puts there. Measured while writing test/commands/op_meter_fallback_test.rb:
# a booby-trapped `op` first on PATH was silently bypassed and the suite talked to
# 1Password for real.
OP="${SECRET_OP_BIN:-/opt/homebrew/bin/op}"

# ── 1Password read attribution ────────────────────────────────────────────────
# Route every `op` call through op_metered so the read is recorded against THIS
# script (bin/lib/op-meter.sh; query with bin/op-reads). Sourcing is OPTIONAL by
# construction: if the shim is missing or unreadable, op_metered falls back to
# running the binary directly. A metering problem must never cost this script its
# credential read — every consumer here has a working fallback for a rate-limited
# or absent `op`, and that survived a full-day 1Password outage.
SECRET_BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The cache's subcommands are Ruby. They are reserved words, never vault names.
case "${1:-}" in
  status|get|refresh|forget|contingency|migrate|prewarm|help|-h|--help)
    exec ruby "$SECRET_BIN_DIR/lib/secret_cache_cli.rb" "$@" ;;
esac

# PER-ITEM ATTRIBUTION (2026-10-27). The read log said `secret | secret` and never
# which item, so nobody could choose what to cache from data. The `via` column now
# names the vault and item (never the field's value, never the value itself).
OP_METER_VIA="secret:${1:-?}/${2:-?}"
OP_METER_SH="$SECRET_BIN_DIR/lib/op-meter.sh"
# shellcheck source=lib/op-meter.sh
[ -r "$OP_METER_SH" ] && . "$OP_METER_SH" || true
command -v op_metered >/dev/null 2>&1 || op_metered() { local __b="$1"; shift; "$__b" "$@"; }
vault="${1:-}"
item="${2:-}"
field="${3:-password}"

if [ -z "$vault" ] || [ -z "$item" ]; then
  echo "usage: bin/secret <vault> <item> [field]   (field defaults to 'password')" >&2
  exit 2
fi

# A manifest that names any op-item entry: let the cache answer first. Exit 3
# from the Ruby half means "not one of mine", and the classic read runs. The grep
# keeps the default path (no op-item entries) free of a Ruby start.
SECRET_CACHE_MANIFEST="${MCR_SECRET_CACHE_DIR:-${CLAUDE_PROJECTS_DIR:-$HOME/projects}/.secret-cache}/manifest.json"
if [ -f "$SECRET_CACHE_MANIFEST" ] && grep -q '"op-item"' "$SECRET_CACHE_MANIFEST" 2>/dev/null; then
  rc=0
  value="$(ruby "$SECRET_BIN_DIR/lib/secret_cache_cli.rb" read-item "$vault" "$item" "$field")" || rc=$?
  if [ "$rc" = 0 ]; then printf '%s' "$value"; exit 0; fi
  [ "$rc" = 3 ] || exit "$rc"
fi

[ -x "$OP" ] || { echo "secret: 1Password CLI not found at $OP" >&2; exit 1; }
# rc 124 is op_metered's double timeout: 1Password is HUNG, not signed out or
# missing an item, and the advice for those would send the reader the wrong way.
# Both calls send op_metered's stderr to /dev/null (op's own noise), so the one
# line that names the hang is printed here, and the exit is 75 (EX_TEMPFAIL,
# OpMeter::HUNG_EXIT). A hung whoami stops before the read: never thirty more
# seconds on the same daemon (release-survives-1password-hang).
op_hung() {
  if command -v op_meter_hung_line >/dev/null 2>&1; then
    op_meter_hung_line
  else
    echo "secret: 1Password is not answering. Quit and reopen the 1Password app; reboot if that fails." >&2
  fi
  exit 75
}

rc=0
op_metered "$OP" whoami >/dev/null 2>&1 || rc=$?
[ "$rc" = 124 ] && op_hung
[ "$rc" = 0 ] || {
  echo "secret: op is not authenticated. Run 'op signin' or set OP_SERVICE_ACCOUNT_TOKEN (see bin/setup-1pass-token)." >&2
  exit 1
}

ref="op://${vault}/${item}/${field}"
value="$(op_metered "$OP" read "$ref" 2>/dev/null)" || rc=$?
[ "$rc" = 124 ] && op_hung
[ "$rc" = 0 ] || {
  echo "secret: could not read ${ref} (check vault/item/field against credential-inventory.md)" >&2
  exit 1
}
[ -n "$value" ] || { echo "secret: empty value at ${ref}" >&2; exit 1; }

printf '%s' "$value"
