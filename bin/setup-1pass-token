#!/bin/zsh
# bin/setup-1pass-token — install a 1Password service account token
#
#   bin/setup-1pass-token           # AGENT token  -> ~/.zprofile (every shell)
#   bin/setup-1pass-token --admin   # ADMIN token  -> ~/.zprofile.admin (opt-in)
#
# TWO TOKENS, AND THE SECOND ONE IS DELIBERATELY NOT AUTO-LOADED. The admin
# token reads the vault holding github.mcritchie-deployer and other admin
# credentials. Putting it in ~/.zprofile would hand it to every background agent
# shell, which is exactly the isolation this design exists to create: a build
# lane must be STRUCTURALLY unable to MINT an admin credential — the 1Password
# read is the step that is blocked — not merely discouraged from it. Admin lanes
# source ~/.zprofile.admin explicitly.
#
# That is the whole claim, deliberately: this file blocks the MINT. Not holding
# one is a separate mechanism in bin/gh-token, which refuses to cache a deployer
# token at all (CACHEABLE_IDENTITIES) — it used to serve one from cache before
# minting, and `never-cache-deployer-token` closed that. Naming both, and which
# file owns which, is what keeps the boundary from being trusted too widely.
# See docs/agents/modules/credentials.md.
#
# Usage:
#   1. Copy your service account token to the clipboard (Cmd+C from 1Password)
#      It should start with "ops_".
#   2. Run:  bin/setup-1pass-token
#
# Why this exists:
#   Pasting a multi-hundred-character token directly into a shell command
#   reliably breaks on macOS Terminal:
#     - "Smart quotes" setting converts " to “ ” which zsh doesn't honor
#     - Long lines wrap mid-paste, inserting literal newlines that split args
#       like `chmod 600` into `chmod 60` + newline + `0`
#     - Tokens carry whitespace from word-wrapped copies
#   pbpaste sidesteps every one of those: the token never touches shell parsing.
#
# Prereqs:
#   brew install 1password-cli
#
# After running, either `source ~/.zprofile` in your current shell or open a
# new terminal — the export takes effect on next shell init.

set -e

# ── 1Password read attribution ────────────────────────────────────────────────
# Route every `op` call through op_metered so the read is recorded against THIS
# script (bin/lib/op-meter.sh; query with bin/op-reads). Sourcing is OPTIONAL by
# construction: if the shim is missing or unreadable, op_metered falls back to
# running the binary directly. A metering problem must never cost this script its
# credential read — every consumer here has a working fallback for a rate-limited
# or absent `op`, and that survived a full-day 1Password outage.
OP_METER_VIA="setup-1pass-token"
OP_METER_SH="$(cd "$(dirname "$0")" && pwd)/lib/op-meter.sh"
# shellcheck source=lib/op-meter.sh
[ -r "$OP_METER_SH" ] && . "$OP_METER_SH" || true
command -v op_metered >/dev/null 2>&1 || op_metered() { local __b="$1"; shift; "$__b" "$@"; }

LANE="agent"
VAR="OP_SERVICE_ACCOUNT_TOKEN"
PROFILE="$HOME/.zprofile"
if [[ "${1:-}" == "--admin" ]]; then
  LANE="admin"
  VAR="OP_ADMIN_SERVICE_ACCOUNT_TOKEN"
  PROFILE="$HOME/.zprofile.admin"
fi

if ! command -v op >/dev/null 2>&1; then
  echo "ERROR: 1Password CLI (op) is not installed."
  echo "       Run: brew install 1password-cli"
  exit 1
fi

if ! command -v pbpaste >/dev/null 2>&1; then
  echo "ERROR: pbpaste not found. This script is macOS-only."
  exit 1
fi

TOKEN=$(pbpaste | tr -d '[:space:]')

if [[ -z "$TOKEN" ]]; then
  echo "ERROR: clipboard is empty."
  echo "       Copy your ops_... service account token first, then re-run."
  exit 1
fi

if [[ "$TOKEN" != ops_* ]]; then
  echo "ERROR: clipboard does not look like an op service token."
  echo "       Expected something starting with 'ops_', got: '${TOKEN:0:8}...'"
  echo "       Did you copy the right value? Tokens look like: ops_eyJzaWdu..."
  exit 1
fi

touch "$PROFILE"
# Remove any prior line for THIS variable so re-runs replace cleanly.
#
# ANCHORED ON PURPOSE. `^export ${VAR}=` takes this variable's own export line and
# nothing else — not a comment that mentions the name, not a longer variable that
# contains it, not a line where the name appears as a value. Re-running is a clean
# replace rather than an append.
#
# IT IS NOT PROTECTING THE ADMIN LINE FROM THIS ONE, and an earlier version of this
# comment said it was: that the old unanchored /OP_SERVICE_ACCOUNT_TOKEN/ matched
# OP_ADMIN_SERVICE_ACCOUNT_TOKEN as a SUBSTRING and had once silently deleted the
# admin token. That never happened and could not. OP_ADMIN_ sits between OP_ and
# SERVICE_, so OP_SERVICE_ACCOUNT_TOKEN is not a substring of
# OP_ADMIN_SERVICE_ACCOUNT_TOKEN, and the two variables live in different files
# anyway. Verified 2026-08-29 by replaying the old sed against a profile holding
# both lines in both orders; the admin line survived every time. The anchor stays
# on its own merits, above. Guarded by test/lib/credential_isolation_claims_test.rb.
[[ -f "$PROFILE" ]] || : > "$PROFILE"
/usr/bin/sed -i '' "/^export ${VAR}=/d" "$PROFILE"
echo "export ${VAR}=$TOKEN" >> "$PROFILE"
/bin/chmod 600 "$PROFILE"
chmod 600 "$PROFILE"

echo "${LANE} token installed in $PROFILE (length: ${#TOKEN} chars)"
if [[ "$LANE" == "admin" ]]; then
  echo ""
  echo "NOT auto-loaded, by design. Admin lanes opt in with:"
  echo "  source ~/.zprofile.admin"
fi
echo ""
echo "Verifying with 'op vault list'..."
export OP_SERVICE_ACCOUNT_TOKEN="$TOKEN"
op_metered op vault list

echo ""
echo "Done. Either run 'source ~/.zprofile' in your current shell or open a"
echo "new terminal for the env var to take effect outside this script."
