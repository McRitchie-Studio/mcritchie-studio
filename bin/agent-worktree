#!/usr/bin/env ruby
# frozen_string_literal: true

# Central worktree + local stack launcher for the McRitchie ecosystem.
#
# The primary checkout stays clean on main. Task branches live under:
#   /Users/alex/projects/<repo>/.worktrees/<task-slug>
#
# Usage:
#   bin/agent-worktree apps
#   bin/agent-worktree plan turf-monster docs-stack
#   bin/agent-worktree new turf-monster docs-stack
#   bin/agent-worktree whereami
#   bin/agent-worktree shell-hook zsh
#   bin/agent-worktree up turf-monster docs-stack
#   bin/agent-worktree status turf-monster docs-stack
#   bin/agent-worktree finish turf-monster docs-stack
#   bin/agent-worktree doctor
#   bin/agent-worktree snapshot
#   bin/agent-worktree cleanup
#   bin/agent-worktree remove turf-monster docs-stack --yes
#   bin/agent-worktree down turf-monster docs-stack

require "fileutils"
require "json"
require "open3"
require "shellwords"
require "socket"
require "time"
require "yaml"

def default_projects_dir
  candidate = File.expand_path("../..", __dir__)
  return File.expand_path("../..", candidate) if File.basename(candidate) == ".worktrees"

  candidate
end

PROJECTS_DIR = File.expand_path(ENV.fetch("PROJECTS_DIR") { default_projects_dir })
HUB_DIR = File.join(PROJECTS_DIR, "mcritchie-studio")
STACK_ENV = ".env.agent-stack"
CONTEXT_FILE = ".agent-context.json"

# Worktree Redis bands separate physical capacity (Redis `databases`, fixed at
# startup) from a soft, restart-free band the launcher allocates from.
#   physical capacity  -> Redis `databases` (changing it needs a restart)
#   soft band          -> DBs redis_db_min .. redis_db_min + current_capacity - 1
# The band idles at FLOOR slots, grows by STEP when exhausted (while physical
# room remains), and shrinks by STEP (never below FLOOR) as worktrees close.
DEFAULT_REDIS_MIN_DB = 9
# Legacy stock Redis ships 16 databases (0-15). Used as the conservative
# physical fallback when redis-cli cannot be reached.
DEFAULT_REDIS_MAX_DB = 15
REDIS_BAND_FLOOR = Integer(ENV.fetch("AGENT_REDIS_FLOOR", "20"))
REDIS_BAND_STEP = Integer(ENV.fetch("AGENT_REDIS_STEP", "10"))
# Physical `databases` target for `scale --provision`. 64 leaves ~55 band slots
# above the DB-9 band start with plenty of headroom for primary apps on 0-8.
DEFAULT_REDIS_PHYSICAL_TARGET = 64

ALIASES = {
  "studio" => "mcritchie-studio",
  "mcritchie" => "mcritchie-studio",
  "hub" => "mcritchie-studio",
  "turf" => "turf-monster",
  "monster" => "turf-monster"
}.freeze

APP_OVERRIDES = {
  "mcritchie-studio" => {
    "display_name" => "McRitchie Studio",
    "port" => 3000,
    "stack" => "rails",
    "ruby_path" => "/opt/homebrew/opt/ruby@3.3/bin:/opt/homebrew/lib/ruby/gems/3.3.0/bin",
    "session_env" => "MCRITCHIE_SESSION_KEY",
    "session_key" => "_studio_session",
    "sidekiq" => false
  },
  "turf-monster" => {
    "stack" => "tm",
    "ruby_path" => "/opt/homebrew/opt/ruby@3.3/bin:/opt/homebrew/lib/ruby/gems/3.3.0/bin",
    "session_env" => "TM_SESSION_KEY",
    "session_key" => "_turf_session",
    "sidekiq" => true
  }
}.freeze

def usage
  warn <<~TEXT
    bin/agent-worktree - hidden worktrees + isolated local stacks

      apps
      list [app]
      plan <app> <task-slug> [type]
      new <app> <task-slug> [type] [--start]
      whereami [app task-slug] [--json|--shell]
      shell-hook zsh
      env <app> <task-slug>
      up <app> <task-slug>
      status <app> <task-slug>
      finish <app> <task-slug> [--push] [--pr]
      doctor [app]
      snapshot [app] [--write]
      cleanup [app] [--write]
      cleanup [app] --reclaim [--yes]
      remove <app> <task-slug> [--yes]
      down <app> <task-slug>
      scale [status|out|in]
      scale --provision [--yes]

    Environment:
      AGENT_REDIS_MIN_DB         first Redis DB in the worktree band (default 9)
      AGENT_REDIS_MAX_DB         override the band's top DB (default: derived from band size)
      AGENT_REDIS_FLOOR          steady-state band size in slots (default 20)
      AGENT_REDIS_STEP           grow/shrink increment in slots (default 10)
      AGENT_REDIS_PHYSICAL_TARGET  Redis `databases` target for --provision (default 64)
      AGENT_REDIS_CONF           brew redis.conf path for --provision (default <brew>/etc/redis.conf)

    Examples:
      bin/agent-worktree plan turf-monster button-color
      bin/agent-worktree new turf-monster button-color
      bin/agent-worktree up turf-monster button-color
  TEXT
  exit 1
end

def sh(*cmd, chdir: nil, env: {}, allow_fail: false)
  shown = cmd.shelljoin
  options = {}
  options[:chdir] = chdir if chdir
  ok = system(env, *cmd, **options)
  return true if ok
  return false if allow_fail

  where = chdir ? " in #{chdir}" : ""
  abort "command failed#{where}: #{shown}"
end

def capture(*cmd, chdir: nil, env: {})
  options = {}
  options[:chdir] = chdir if chdir
  out, err, status = Open3.capture3(env, *cmd, **options)
  abort "command failed: #{cmd.shelljoin}\n#{err}" unless status.success?
  out
end

def capture_status(*cmd, chdir: nil, env: {})
  options = {}
  options[:chdir] = chdir if chdir
  out, err, status = Open3.capture3(env, *cmd, **options)
  [status.success?, out, err]
end

# Side-channel log helpers for automatic capacity/flush events. They write to
# stderr so plan/snapshot stdout (consumed by other tooling) stays clean.
def log_ok(message)
  warn "ok: #{message}"
end

def log_act(message)
  warn "scale: #{message}"
end

def log_fail(message)
  warn "warn: #{message}"
end

def apps
  data = {
    "mcritchie-studio" => {
      "slug" => "mcritchie-studio",
      "display_name" => "McRitchie Studio",
      "port" => 3000,
      "status" => "active"
    }
  }

  satellites_path = File.join(HUB_DIR, "config", "satellites.yml")
  if File.exist?(satellites_path)
    YAML.load_file(satellites_path).fetch("satellites", []).each do |satellite|
      slug = satellite.fetch("slug")
      data[slug] = satellite.transform_keys(&:to_s)
    end
  end

  data.each do |slug, config|
    override = APP_OVERRIDES.fetch(slug, {})
    port = Integer(config.fetch("port"))
    range_start = (port / 100) * 100
    data[slug] = config.merge(
      "slug" => slug,
      "repo" => File.join(PROJECTS_DIR, slug),
      "primary_port" => port,
      "range_start" => range_start,
      "range_end" => range_start + 99,
      "stack" => override.fetch("stack", "rails"),
      "ruby_path" => override.fetch("ruby_path", nil),
      "session_env" => override.fetch("session_env", "#{slug.tr("-", "_").upcase}_SESSION_KEY"),
      "session_key" => override.fetch("session_key", "_#{slug.tr("-", "_")}_session"),
      "sidekiq" => override.fetch("sidekiq", false)
    )
  end
end

def app_for(name)
  slug = ALIASES.fetch(name, name)
  config = apps[slug]
  abort "unknown app: #{name}\nRun: bin/agent-worktree apps" unless config
  abort "repo missing: #{config.fetch("repo")}" unless Dir.exist?(config.fetch("repo"))
  config
end

def clean_slug(raw)
  slug = raw.to_s.downcase.gsub(/[^a-z0-9]+/, "-").gsub(/\A-|-+\z/, "")
  abort "invalid task slug: #{raw.inspect}" if slug.empty?
  slug
end

def worktree_dir(app, task)
  File.join(app.fetch("repo"), ".worktrees", task)
end

def stack_env_path(app, task)
  File.join(worktree_dir(app, task), STACK_ENV)
end

def context_path(dir)
  File.join(dir, CONTEXT_FILE)
end

def existing_stack_envs(app)
  Dir.glob(File.join(app.fetch("repo"), ".worktrees", "*", STACK_ENV))
end

def parse_env(path)
  return {} unless File.exist?(path)

  File.readlines(path, chomp: true).each_with_object({}) do |line, env|
    next if line.strip.empty? || line.start_with?("#")
    key, value = line.split("=", 2)
    env[key] = value.to_s
  end
end

def local_url(port)
  port.to_s.empty? ? nil : "http://localhost:#{port}"
end

def local_inbox_url(port)
  port.to_s.empty? ? nil : "http://localhost:#{port}/_studio/local_emails"
end

def env_truthy?(value)
  %w[1 true yes on].include?(value.to_s.strip.downcase)
end

def port_listening?(port)
  system("lsof", "-nP", "-iTCP:#{port}", "-sTCP:LISTEN", out: File::NULL, err: File::NULL)
end

def port_pid(port)
  ok, out, = capture_status("lsof", "-tiTCP:#{port}", "-sTCP:LISTEN")
  ok ? out.lines.first.to_s.strip : ""
end

def pid_alive?(pid)
  return false if pid.to_s.empty?

  Process.kill(0, Integer(pid))
  true
rescue Errno::EPERM
  true
rescue ArgumentError, Errno::ESRCH
  false
end

def pidfile_state(path)
  return "missing" unless File.exist?(path)

  pid = File.read(path).strip
  return "empty" if pid.empty?

  pid_alive?(pid) ? "alive #{pid}" : "stale #{pid}"
end

def http_code(port)
  return "?" if port.to_s.empty? || port.to_s == "?"

  out, = Open3.capture3("curl", "-sS", "-o", "/dev/null", "-m", "2", "-w", "%{http_code}", "http://localhost:#{port}/up")
  out.to_s.strip.empty? ? "down" : out.to_s.strip
rescue StandardError
  "down"
end

def allocated_ports(app)
  existing_stack_envs(app).map { |path| parse_env(path)["APP_PORT"]&.to_i }.compact
end

def allocated_redis_dbs
  apps.values.flat_map do |app|
    existing_stack_envs(app).map do |path|
      parse_env(path)["REDIS_URL"].to_s.split("/").last&.to_i
    end
  end.compact
end

def integer_env(name, default)
  Integer(ENV.fetch(name, default.to_s))
rescue ArgumentError
  abort "#{name} must be an integer"
end

def redis_db_min
  integer_env("AGENT_REDIS_MIN_DB", DEFAULT_REDIS_MIN_DB)
end

def redis_db_max
  # The band top DB is derived from the elastic soft band. An explicit
  # AGENT_REDIS_MAX_DB still wins for manual overrides / drift detection.
  return integer_env("AGENT_REDIS_MAX_DB", redis_db_min + load_current_capacity - 1) if ENV.key?("AGENT_REDIS_MAX_DB")

  redis_db_min + load_current_capacity - 1
end

def redis_db_range
  min = redis_db_min
  max = redis_db_max
  abort "AGENT_REDIS_MIN_DB must be <= AGENT_REDIS_MAX_DB" if min > max

  min..max
end

# --- Elastic Redis band: persisted soft capacity + physical ceiling ---------

def redis_capacity_path
  File.expand_path(ENV.fetch("AGENT_REDIS_CAPACITY_FILE") { File.join(agent_registry_dir, "redis-capacity.json") })
end

def worktree_lock_path
  File.expand_path(ENV.fetch("AGENT_WORKTREE_LOCK") { File.join(agent_registry_dir, "agent-worktree.lock") })
end

# Reentrant exclusive file lock around DB allocation + capacity mutation so two
# concurrent `new`/`up`/`scale` runs cannot grab the same DB or corrupt
# redis-capacity.json. Reentrant within a process (single-threaded CLI) so
# nested calls (allocate inside a locked `new`) do not self-deadlock.
def with_worktree_lock
  $worktree_lock_depth ||= 0
  if $worktree_lock_depth.positive?
    $worktree_lock_depth += 1
    begin
      return yield
    ensure
      $worktree_lock_depth -= 1
    end
  end

  FileUtils.mkdir_p(File.dirname(worktree_lock_path))
  File.open(worktree_lock_path, File::RDWR | File::CREAT, 0o644) do |lock|
    lock.flock(File::LOCK_EX)
    $worktree_lock_depth += 1
    begin
      yield
    ensure
      $worktree_lock_depth -= 1
    end
  end
end

def load_current_capacity
  path = redis_capacity_path
  return REDIS_BAND_FLOOR unless File.exist?(path)

  value = JSON.parse(File.read(path))["current_capacity"].to_i
  value >= REDIS_BAND_FLOOR ? value : REDIS_BAND_FLOOR
rescue JSON::ParserError, Errno::ENOENT
  REDIS_BAND_FLOOR
end

def write_current_capacity(value)
  value = REDIS_BAND_FLOOR if value < REDIS_BAND_FLOOR
  path = redis_capacity_path
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, "#{JSON.pretty_generate(
    "current_capacity" => value,
    "floor" => REDIS_BAND_FLOOR,
    "step" => REDIS_BAND_STEP,
    "updated_at" => Time.now.utc.iso8601
  )}\n")
  value
end

# Physical `databases` exposed by the running Redis, or nil if redis-cli is
# unavailable. This is the hard ceiling; the band may never hand out a DB index
# at or beyond it.
def redis_physical_databases
  ok, out, = capture_status("redis-cli", "-p", "6379", "CONFIG", "GET", "databases")
  return nil unless ok

  out.lines.map(&:strip).reject(&:empty?).last&.to_i
rescue StandardError
  nil
end

# Physical count with a conservative stock fallback (16 databases, DBs 0-15)
# when redis-cli cannot be reached, so allocation never optimistically hands out
# a database that does not exist.
def redis_physical_count
  redis_physical_databases || (DEFAULT_REDIS_MAX_DB + 1)
end

def redis_physical_target
  integer_env("AGENT_REDIS_PHYSICAL_TARGET", DEFAULT_REDIS_PHYSICAL_TARGET)
end

# Largest band size (slots) that physically fits above the band start.
def physical_band_capacity(physical = redis_physical_count)
  physical - redis_db_min
end

def allocated_band_dbs
  allocated_redis_dbs.select { |db| db >= redis_db_min }
end

def allocate_redis_db
  with_worktree_lock do
    physical = redis_physical_count
    physical_top = physical - 1

    loop do
      capacity = load_current_capacity
      band_top = redis_db_min + capacity - 1
      ceiling = [band_top, physical_top].min
      used = allocated_redis_dbs

      (redis_db_min..ceiling).each do |db|
        return db unless used.include?(db)
      end

      # Band exhausted within physical reach. Grow the soft band (restart-free)
      # if physical room remains, then retry.
      room = physical_band_capacity(physical)
      if capacity < room
        grown = [capacity + REDIS_BAND_STEP, room].min
        write_current_capacity(grown)
        log_act("scaled out: #{capacity} -> #{grown} slots (band redis DBs #{redis_db_min}-#{redis_db_min + grown - 1})")
        next
      end

      abort <<~MSG.strip
        no free Redis DB in band #{redis_db_min}-#{ceiling}; physical Redis ceiling reached (databases=#{physical}).
        Free a slot:   bin/agent-worktree cleanup   (then remove merged worktrees)
        Raise ceiling: bin/agent-worktree scale --provision   (raises Redis databases to #{redis_physical_target}, restarts Redis once)
      MSG
    end
  end
end

# Restart-free shrink hook: invoked after slots free up (remove/cleanup). Drops
# the band by STEP increments toward FLOOR without ever stranding a still-used
# DB above the new band top.
def maybe_scale_in
  with_worktree_lock do
    current = load_current_capacity
    return if current <= REDIS_BAND_FLOOR

    highest_used = allocated_band_dbs.max
    min_capacity_for_used = highest_used ? (highest_used - redis_db_min + 1) : 0

    target = current
    while (target - REDIS_BAND_STEP) >= REDIS_BAND_FLOOR && (target - REDIS_BAND_STEP) >= min_capacity_for_used
      target -= REDIS_BAND_STEP
    end
    return if target >= current

    write_current_capacity(target)
    log_act("scaled in: #{current} -> #{target} slots (band redis DBs #{redis_db_min}-#{redis_db_min + target - 1})")
  end
end

def allocate_port(app)
  used = allocated_ports(app)
  ((app.fetch("primary_port") + 1)..app.fetch("range_end")).each do |port|
    next if used.include?(port)
    next if port_listening?(port)

    return port
  end
  abort "no free worktree port in #{app.fetch("range_start")}-#{app.fetch("range_end")}"
end

def stack_values(app, task, requested_port = nil)
  port = requested_port || allocate_port(app)
  redis_db = allocate_redis_db
  db_name = "#{app.fetch("slug").tr("-", "_")}_development_#{task.tr("-", "_")}"
  session_key = "#{app.fetch("session_key")}_#{task.tr("-", "_")}"

  {
    "AGENT_WORKTREE" => "1",
    "APP_SLUG" => app.fetch("slug"),
    "TASK_SLUG" => task,
    "APP_PORT" => port.to_s,
    "PORT" => port.to_s,
    "REDIS_URL" => "redis://localhost:6379/#{redis_db}",
    "DATABASE_URL" => "postgresql://localhost/#{db_name}",
    app.fetch("session_env") => session_key,
    "TM_PORT" => port.to_s,
    "TM_REDIS_DB" => redis_db.to_s
  }.merge(local_email_values)
end

def local_email_values
  {
    "LOCAL_EMAIL_CAPTURE" => "1",
    "MAIL_TRANSPORT" => "",
    "RESEND_API_KEY" => "",
    "SES_SMTP_USERNAME" => "",
    "SES_SMTP_PASSWORD" => ""
  }
end

def write_stack_env(app, task, values)
  path = stack_env_path(app, task)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, <<~ENVFILE)
    # Generated by mcritchie-studio/bin/agent-worktree.
    # Safe to regenerate; do not commit this file.
    #{values.map { |key, value| "#{key}=#{value}" }.join("\n")}
  ENVFILE
  path
end

def load_stack_env(app, task)
  path = stack_env_path(app, task)
  abort "missing #{path}\nRun: bin/agent-worktree new #{app.fetch("slug")} #{task}" unless File.exist?(path)
  local_email_values.merge(parse_env(path))
end

def command_env(app, values)
  path_parts = [app["ruby_path"], ENV["PATH"]].compact
  values.merge("PATH" => path_parts.join(":"))
end

def print_plan(app, task, values, dir = worktree_dir(app, task))
  redis_db = values.fetch("REDIS_URL").split("/").last
  puts "app:      #{app.fetch("display_name", app.fetch("slug"))}"
  puts "repo:     #{app.fetch("repo")}"
  puts "worktree: #{dir}"
  puts "url:      http://localhost:#{values.fetch("APP_PORT")}"
  puts "email:    http://localhost:#{values.fetch("APP_PORT")}/_studio/local_emails"
  puts "branch:   feat/#{task} (or the type you pass to new)"
  puts "db:       #{values.fetch("DATABASE_URL").sub("postgresql://localhost/", "")}"
  puts "redis:    db #{redis_db}"
  puts "session:  #{app.fetch("session_env")}=#{values.fetch(app.fetch("session_env"))}"
  puts
  puts "start:    bin/agent-worktree up #{app.fetch("slug")} #{task}"
  puts "stop:     bin/agent-worktree down #{app.fetch("slug")} #{task}"
  puts
  physical = redis_physical_count
  if redis_db.to_i >= physical
    puts "warning: Redis db #{redis_db} is at/beyond the physical Redis ceiling (databases=#{physical})."
    puts "         The soft band grows restart-free, but only DBs 0-#{physical - 1} physically exist."
    puts "         Run: bin/agent-worktree scale --provision  to raise capacity, or cleanup/remove a stack."
    puts
  end
  puts "callback-heavy flows stay on primary http://localhost:#{app.fetch("primary_port")} unless providers are configured for this port."
end

def ensure_git_worktree(app, task, type)
  primary = app.fetch("repo")
  dir = worktree_dir(app, task)
  return dir if Dir.exist?(dir)

  FileUtils.mkdir_p(File.dirname(dir))
  sh("git", "-C", primary, "fetch", "origin", "--quiet")

  base_ref = "origin/main"
  unless sh("git", "-C", primary, "rev-parse", "--verify", base_ref, allow_fail: true)
    base_ref = "HEAD"
  end

  branch = "#{type}/#{task}"
  sh("git", "-C", primary, "worktree", "add", dir, "-b", branch, base_ref)

  env_source = File.join(primary, ".env")
  env_target = File.join(dir, ".env")
  if File.exist?(env_source) && !File.exist?(env_target)
    FileUtils.cp(env_source, env_target)
    puts "copied .env"
  end

  dir
end

def prepare_rails(dir, app, values)
  env = command_env(app, values)
  sh("bin/rails", "db:prepare", chdir: dir, env: env)
  sh("bin/rails", "tailwindcss:build", chdir: dir, env: env, allow_fail: true)
end

def start_generic_rails(dir, app, values)
  prepare_rails(dir, app, values)

  pidfile = File.join(dir, "tmp", "pids", "agent-web.pid")
  logfile = File.join(dir, "log", "agent-web.log")
  FileUtils.mkdir_p(File.dirname(pidfile))
  FileUtils.mkdir_p(File.dirname(logfile))

  if File.exist?(pidfile)
    pid = File.read(pidfile).strip
    if pid_alive?(pid)
      puts "web already running pid #{pid}"
      return
    end
    live_pid = port_pid(values.fetch("APP_PORT"))
    unless live_pid.empty?
      File.write(pidfile, "#{live_pid}\n")
      puts "repaired web pidfile with live pid #{live_pid} on port #{values.fetch("APP_PORT")}"
      return
    end
    FileUtils.rm_f(pidfile)
  end

  live_pid = port_pid(values.fetch("APP_PORT"))
  unless live_pid.empty?
    File.write(pidfile, "#{live_pid}\n")
    puts "web already running pid #{live_pid} on port #{values.fetch("APP_PORT")}"
    return
  end

  env = command_env(app, values)
  pid = Process.spawn(env, "bin/rails", "server", "-p", values.fetch("APP_PORT"),
                      chdir: dir, in: File::NULL, out: [logfile, "a"], err: [:child, :out], pgroup: true)
  Process.detach(pid)
  File.write(pidfile, "#{pid}\n")
  puts "started web pid #{pid}"
end

def start_tm(dir, app, values)
  prepare_rails(dir, app, values)
  sh("bin/tm", "up", "--no-stripe", chdir: dir, env: command_env(app, values))
end

def wait_for_url(port)
  url = "http://localhost:#{port}/up"
  last_code = nil
  30.times do
    out, = Open3.capture3("curl", "-sS", "-o", "/dev/null", "-m", "2", "-w", "%{http_code}", url)
    code = out.strip
    last_code = code unless code.empty?
    return code if code == "200"

    sleep 1
  end
  last_code || "down"
end

def tail_file(path, lines = 80)
  return "(missing #{path})" unless File.exist?(path)

  File.readlines(path, chomp: true).last(lines).join("\n")
rescue Errno::ENOENT
  "(missing #{path})"
end

def verify_started_stack!(app, dir, port)
  pidfile = app.fetch("stack") == "tm" ? File.join(dir, "tmp", "pids", "tm-web.pid") : File.join(dir, "tmp", "pids", "agent-web.pid")
  logfile = app.fetch("stack") == "tm" ? File.join(dir, "log", "tm-web.log") : File.join(dir, "log", "agent-web.log")

  sleep 1
  record = stack_record(app, dir)
  return record if record[:code] == "200" && !record[:port_pid].empty? && !record[:pidfile_state].start_with?("stale")

  warn "worktree server did not stay healthy after startup"
  warn "  url: http://localhost:#{port}"
  warn "  /up: #{record[:code]}"
  warn "  port pid: #{record[:port_pid].empty? ? "none" : record[:port_pid]}"
  warn "  pidfile: #{pidfile} (#{record[:pidfile_state]})"
  warn "  log: #{logfile}"
  warn
  warn tail_file(logfile)
  exit 1
end

def git_value(dir, *args)
  ok, out, = capture_status("git", *args, chdir: dir)
  ok ? out.strip : "?"
end

def git_success?(dir, *args)
  ok, = capture_status("git", *args, chdir: dir)
  ok
end

def git_dirty?(dir)
  !git_value(dir, "status", "--porcelain").empty?
end

def git_branch(dir)
  git_value(dir, "branch", "--show-current")
end

def git_head(dir)
  git_value(dir, "rev-parse", "--short", "HEAD")
end

def git_commit_subject(dir)
  git_value(dir, "log", "-1", "--pretty=%s")
end

def git_ahead_behind(dir)
  return ["?", "?"] unless git_success?(dir, "rev-parse", "--verify", "origin/main")

  value = git_value(dir, "rev-list", "--left-right", "--count", "origin/main...HEAD")
  behind, ahead = value.split(/\s+/, 2)
  [ahead || "?", behind || "?"]
end

def git_merged_to_main?(dir)
  return false unless git_success?(dir, "rev-parse", "--verify", "origin/main")

  git_success?(dir, "merge-base", "--is-ancestor", "HEAD", "origin/main")
end

def git_equivalent_to_main?(dir)
  return false unless git_success?(dir, "rev-parse", "--verify", "origin/main")

  git_success?(dir, "diff", "--quiet", "origin/main..HEAD")
end

def cleanup_ready?(record)
  !record.fetch(:dirty) && (record.fetch(:merged) || record.fetch(:equivalent_to_main))
end

def github_repo_slug(dir)
  remote = git_value(dir, "remote", "get-url", "origin")
  case remote
  when %r{\Agit@github\.com:(.+?)(?:\.git)?\z}
    Regexp.last_match(1).delete_suffix(".git")
  when %r{\Ahttps://github\.com/(.+?)(?:\.git)?\z}
    Regexp.last_match(1).delete_suffix(".git")
  end
end

def github_compare_url(record)
  repo = github_repo_slug(record[:dir])
  return nil unless repo

  branch = record[:branch]
  "https://github.com/#{repo}/compare/main...#{branch}?expand=1"
end

def command_available?(name)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
    path = File.join(dir, name)
    File.file?(path) && File.executable?(path)
  end
end

def human_title(slug)
  slug.split("-").map(&:capitalize).join(" ")
end

def ensure_context_file_excluded(dir)
  ok, out, = capture_status("git", "rev-parse", "--git-path", "info/exclude", chdir: dir)
  return unless ok

  exclude_path = out.strip
  return if exclude_path.empty?

  FileUtils.mkdir_p(File.dirname(exclude_path))
  existing = File.exist?(exclude_path) ? File.read(exclude_path) : ""
  return if existing.lines.map(&:strip).include?(CONTEXT_FILE)

  File.open(exclude_path, "a") do |file|
    file.puts
    file.puts "# Local agent session context; generated by bin/agent-worktree."
    file.puts CONTEXT_FILE
  end
end

def prompt_badge(app, task, port, stage = nil)
  stage_part = stage.to_s.empty? ? nil : stage
  parts = [app.fetch("slug"), task, port.to_s.empty? ? nil : ":#{port}", stage_part].compact
  "[#{parts.join(" ")}]"
end

def terminal_title(app, task, port)
  port_part = port.to_s.empty? ? nil : ":#{port}"
  [app.fetch("display_name", app.fetch("slug")), task, port_part].compact.join(" | ")
end

def shell_export(name, value)
  "export #{name}=#{value.to_s.shellescape}"
end

def context_payload(app, task, values, dir, record: nil, stage: nil)
  port = values["APP_PORT"].to_s
  redis_db = redis_db_from_url(values["REDIS_URL"])
  database = db_name_from_url(values["DATABASE_URL"])
  branch = record ? record[:branch] : git_branch(dir)
  head = record ? record[:head] : git_head(dir)
  title = terminal_title(app, task, port)
  badge = prompt_badge(app, task, port, stage)

  {
    "schema_version" => 1,
    "generated_at" => Time.now.utc.iso8601,
    "app" => app.fetch("slug"),
    "app_name" => app.fetch("display_name", app.fetch("slug")),
    "task_slug" => task,
    "worktree_slug" => task,
    "branch" => branch,
    "head" => head,
    "repo" => app.fetch("repo"),
    "worktree" => dir,
    "context_file" => context_path(dir),
    "local_url" => local_url(port),
    "local_inbox_url" => local_inbox_url(port),
    "app_port" => port.empty? ? nil : port.to_i,
    "redis_db" => redis_db.empty? ? nil : redis_db.to_i,
    "database" => database.empty? ? nil : database,
    "health" => record ? stack_health(record) : nil,
    "up_code" => record ? record[:code] : nil,
    "dirty" => record ? record[:dirty] : nil,
    "stage" => stage,
    "terminal_title" => title,
    "prompt_badge" => badge,
    "shell" => {
      "title_command" => "printf '\\033]0;%s\\007' #{title.shellescape}",
      "exports" => [
        shell_export("AGENT_CONTEXT_APP", app.fetch("slug")),
        shell_export("AGENT_CONTEXT_TASK", task),
        shell_export("AGENT_CONTEXT_PORT", port),
        shell_export("AGENT_CONTEXT_URL", local_url(port)),
        shell_export("AGENT_CONTEXT_TITLE", title),
        shell_export("AGENT_CONTEXT_BADGE", badge)
      ]
    }
  }
end

def write_context_marker(app, task, values, dir, record: nil, stage: nil)
  ensure_context_file_excluded(dir)
  payload = context_payload(app, task, values, dir, record: record, stage: stage)
  File.write(context_path(dir), "#{JSON.pretty_generate(payload)}\n")
  payload
end

def find_context_path(start_dir = Dir.pwd)
  dir = File.expand_path(start_dir)
  loop do
    path = context_path(dir)
    return path if File.exist?(path)

    parent = File.dirname(dir)
    return nil if parent == dir

    dir = parent
  end
end

def read_context(path)
  JSON.parse(File.read(path))
rescue JSON::ParserError => e
  abort "invalid #{path}: #{e.message}"
end

def print_context(context)
  puts "session context"
  puts "app:      #{context["app_name"] || context["app"]} (#{context["app"]})"
  puts "task:     #{context["task_slug"]}"
  puts "branch:   #{context["branch"]}"
  puts "head:     #{context["head"]}" if context["head"]
  puts "worktree: #{context["worktree"]}"
  puts "url:      #{context["local_url"] || "not started"}"
  puts "email:    #{context["local_inbox_url"] || "not started"}"
  puts "port:     #{context["app_port"] || "?"}"
  puts "redis:    #{context["redis_db"] ? "db #{context["redis_db"]}" : "?"}"
  puts "db:       #{context["database"] || "?"}"
  puts "health:   #{context["health"] || "unknown"}#{context["up_code"] ? " (/up #{context["up_code"]})" : ""}"
  puts
  puts "terminal title:"
  puts "  #{context["terminal_title"]}"
  puts "prompt badge:"
  puts "  #{context["prompt_badge"]}"
  puts
  puts "shell:"
  context.fetch("shell", {}).fetch("exports", []).each { |line| puts "  #{line}" }
  puts "  #{context.fetch("shell", {}).fetch("title_command", "")}"
end

def run_whereami(app = nil, task = nil, json: false, shell: false)
  context =
    if app && task
      values = load_stack_env(app, task)
      dir = worktree_dir(app, task)
      record = Dir.exist?(dir) ? stack_record(app, dir) : nil
      write_context_marker(app, task, values, dir, record: record)
    else
      path = find_context_path
      abort "no #{CONTEXT_FILE} found from #{Dir.pwd}; run bin/agent-worktree whereami <app> <task-slug> or recreate the stack with bin/agent-worktree new." unless path
      read_context(path)
    end

  if json
    puts JSON.pretty_generate(context)
  elsif shell
    context.fetch("shell", {}).fetch("exports", []).each { |line| puts line }
    puts context.fetch("shell", {}).fetch("title_command", "")
  else
    print_context(context)
  end
end

def run_shell_hook(shell)
  usage unless shell == "zsh"

  launcher = File.expand_path($PROGRAM_NAME)
  puts <<~ZSH
    # Source with:
    #   eval "$(#{launcher.shellescape} shell-hook zsh)"
    #
    # Exposes AGENT_CONTEXT_* variables and keeps the terminal title current
    # whenever the shell prompt is redrawn or the working directory changes.
    _agent_worktree_context_refresh() {
      local agent_context_script
      agent_context_script="$(#{launcher.shellescape} whereami --shell 2>/dev/null)"
      if [ $? -eq 0 ]; then
        eval "$agent_context_script"
      else
        unset AGENT_CONTEXT_APP AGENT_CONTEXT_TASK AGENT_CONTEXT_PORT AGENT_CONTEXT_URL AGENT_CONTEXT_TITLE AGENT_CONTEXT_BADGE
      fi
    }

    if autoload -Uz add-zsh-hook 2>/dev/null; then
      add-zsh-hook chpwd _agent_worktree_context_refresh
      add-zsh-hook precmd _agent_worktree_context_refresh
    fi

    _agent_worktree_context_refresh
  ZSH
end

def db_name_from_url(url)
  url.to_s.split("/").last.to_s.split("?").first.to_s
end

def redis_db_from_url(url)
  url.to_s.split("/").last.to_s.split("?").first.to_s
end

def database_exists?(db_name)
  return nil if db_name.empty?
  return nil unless system("pg_isready", "-q", out: File::NULL, err: File::NULL)

  ok, out, = capture_status("psql", "-Atqc", "SELECT 1 FROM pg_database WHERE datname='#{db_name.gsub("'", "''")}'", "postgres")
  ok ? out.strip == "1" : nil
end

def stack_dirs(app)
  root = File.join(app.fetch("repo"), ".worktrees")
  Dir.glob(File.join(root, "*")).select { |dir| File.directory?(dir) }.sort
end

def stack_record(app, dir)
  env_path = File.join(dir, STACK_ENV)
  raw_env = parse_env(env_path)
  values = local_email_values.merge(raw_env)
  task = File.basename(dir)
  port = values["APP_PORT"].to_s
  redis_db = redis_db_from_url(values["REDIS_URL"])
  db_name = db_name_from_url(values["DATABASE_URL"])
  pidfile = app.fetch("stack") == "tm" ? File.join(dir, "tmp", "pids", "tm-web.pid") : File.join(dir, "tmp", "pids", "agent-web.pid")
  sidekiq_pidfile = File.join(dir, "tmp", "pids", "tm-sidekiq.pid")
  ahead, behind = git_ahead_behind(dir)
  {
    app: app,
    task: task,
    dir: dir,
    env_path: env_path,
    env_exists: File.exist?(env_path),
    env: values,
    raw_env: raw_env,
    port: port,
    port_pid: port_pid(port),
    code: http_code(port),
    redis_db: redis_db,
    db_name: db_name,
    db_exists: database_exists?(db_name),
    branch: git_branch(dir),
    head: git_head(dir),
    commit_subject: git_commit_subject(dir),
    dirty: git_dirty?(dir),
    ahead: ahead,
    behind: behind,
    merged: git_merged_to_main?(dir),
    equivalent_to_main: git_equivalent_to_main?(dir),
    pidfile: pidfile,
    pidfile_state: pidfile_state(pidfile),
    sidekiq_pidfile_state: File.exist?(sidekiq_pidfile) ? pidfile_state(sidekiq_pidfile) : "missing"
  }
end

def stack_records(app = nil)
  selected = app ? [app] : apps.values
  selected.flat_map { |config| stack_dirs(config).map { |dir| stack_record(config, dir) } }
end

def stack_health(record)
  return "missing-env" unless record[:env_exists]
  return "up" if record[:code] == "200"
  return "port-busy" if !record[:port_pid].empty?

  "down"
end

def duplicate_values(records, key)
  records.group_by { |record| record[key].to_s }.select { |value, grouped| !value.empty? && value != "?" && grouped.size > 1 }
end

def stop_generic_rails(dir, port = nil)
  pidfile = File.join(dir, "tmp", "pids", "agent-web.pid")
  unless File.exist?(pidfile)
    live_pid = port ? port_pid(port) : ""
    if live_pid.empty?
      puts "no agent-web pidfile"
      return
    end

    Process.kill("TERM", live_pid.to_i)
    puts "stopped web pid #{live_pid} on port #{port}"
    return
  end

  pid = File.read(pidfile).strip
  if pid_alive?(pid)
    Process.kill("TERM", pid.to_i)
    puts "stopped web pid #{pid}"
  elsif port && !(live_pid = port_pid(port)).empty?
    Process.kill("TERM", live_pid.to_i)
    puts "stopped web pid #{live_pid} on port #{port}"
  else
    puts "web not running"
  end
  FileUtils.rm_f(pidfile)
end

def list_worktrees(app = nil)
  selected = app ? [app] : apps.values
  selected.each do |config|
    records = stack_records(config)
    puts "#{config.fetch("slug")}  primary http://localhost:#{config.fetch("primary_port")}  range #{config.fetch("range_start")}-#{config.fetch("range_end")}"
    if records.empty?
      puts "  no worktrees"
      next
    end

    records.each do |record|
      url = record[:port].empty? ? "missing-port" : "http://localhost:#{record[:port]}"
      email_url = record[:port].empty? ? "missing-port" : "http://localhost:#{record[:port]}/_studio/local_emails"
      dirty = record[:dirty] ? "dirty" : "clean"
      merge = if record[:merged]
                "merged"
              elsif record[:equivalent_to_main]
                "main-eq"
              else
                "unmerged"
              end
      db = record[:db_exists].nil? ? record[:db_name] : "#{record[:db_name]}:#{record[:db_exists] ? "ok" : "missing"}"
      puts "  #{record[:task].ljust(24)} #{stack_health(record).ljust(11)} #{url.ljust(23)} #{record[:branch].ljust(28)} #{dirty} #{merge} +#{record[:ahead]}/-#{record[:behind]}"
      puts "    redis=#{record[:redis_db]} db=#{db} pid=#{record[:pidfile_state]} email=#{email_url}"
    end
  end
end

def doctor_issues(app = nil)
  records = stack_records(app)
  issues = []
  port_dupes = duplicate_values(records, :port)
  redis_dupes = duplicate_values(records, :redis_db)

  records.each do |record|
    app_config = record[:app]
    label = "#{app_config.fetch("slug")}/#{record[:task]}"
    issues << [label, "missing #{STACK_ENV}"] unless record[:env_exists]

    port = record[:port].to_i
    if port.zero?
      issues << [label, "missing APP_PORT"]
    elsif port < app_config.fetch("range_start") || port > app_config.fetch("range_end")
      issues << [label, "APP_PORT #{port} outside #{app_config.fetch("range_start")}-#{app_config.fetch("range_end")}"]
    end

    if port_dupes.key?(record[:port].to_s)
      issues << [label, "APP_PORT #{record[:port]} reused by #{port_dupes.fetch(record[:port].to_s).map { |r| r[:task] }.join(", ")}"]
    end

    if record[:redis_db].empty?
      issues << [label, "missing REDIS_URL Redis DB"]
    elsif redis_dupes.key?(record[:redis_db].to_s)
      issues << [label, "Redis DB #{record[:redis_db]} reused by #{redis_dupes.fetch(record[:redis_db].to_s).map { |r| r[:task] }.join(", ")}"]
    elsif record[:redis_db].to_i < redis_db_min || record[:redis_db].to_i > redis_db_max
      issues << [label, "Redis DB #{record[:redis_db]} outside AGENT_REDIS_MIN_DB=#{redis_db_min} and AGENT_REDIS_MAX_DB=#{redis_db_max}"]
    end

    issues << [label, "LOCAL_EMAIL_CAPTURE is not enabled"] unless env_truthy?(record[:env]["LOCAL_EMAIL_CAPTURE"])
    %w[RESEND_API_KEY SES_SMTP_USERNAME SES_SMTP_PASSWORD].each do |key|
      issues << [label, "#{key} is present in stack env"] unless record[:env][key].to_s.empty?
    end

    issues << [label, "dirty worktree"] if record[:dirty]
    if !record[:equivalent_to_main] && !%w[0 ?].include?(record[:behind].to_s)
      issues << [label, "branch is #{record[:behind]} commit(s) behind origin/main; rebase before QA handoff"]
    end
    if cleanup_ready?(record)
      message = record[:merged] ? "branch is merged to origin/main and clean; cleanup candidate" : "branch final diff matches origin/main; likely squash-merged cleanup candidate"
      issues << [label, message]
    end
    issues << [label, "port #{record[:port]} listens but /up is #{record[:code]}"] if !record[:port_pid].empty? && record[:code] != "200"
    issues << [label, "stale web pidfile #{record[:pidfile_state]}"] if record[:pidfile_state].start_with?("stale")
    issues << [label, "stale sidekiq pidfile #{record[:sidekiq_pidfile_state]}"] if record[:sidekiq_pidfile_state].start_with?("stale")
    issues << [label, "database #{record[:db_name]} missing"] if record[:db_exists] == false
  end

  issues
end

def run_doctor(app = nil)
  issues = doctor_issues(app)
  if issues.empty?
    puts "doctor: no worktree lifecycle issues found"
    return
  end

  puts "doctor: #{issues.size} issue(s)"
  issues.each do |label, message|
    puts "  - #{label}: #{message}"
  end
end

def doctor_issues_by_label(app = nil)
  doctor_issues(app).each_with_object(Hash.new { |hash, key| hash[key] = [] }) do |(label, message), grouped|
    grouped[label] << message
  end
end

def agent_registry_dir
  File.join(PROJECTS_DIR, ".agents")
end

def snapshot_path
  File.expand_path(ENV.fetch("AGENT_WORKTREE_REGISTRY") { File.join(agent_registry_dir, "worktree-registry.json") })
end

def app_snapshot(app)
  {
    "slug" => app.fetch("slug"),
    "display_name" => app.fetch("display_name", app.fetch("slug")),
    "repo" => app.fetch("repo"),
    "primary_port" => app.fetch("primary_port"),
    "range_start" => app.fetch("range_start"),
    "range_end" => app.fetch("range_end"),
    "status" => app.fetch("status", "unknown"),
    "stack" => app.fetch("stack"),
    "sidekiq" => app.fetch("sidekiq")
  }
end

def stack_record_snapshot(record, issues_by_label)
  app = record.fetch(:app)
  label = "#{app.fetch("slug")}/#{record.fetch(:task)}"
  port = record.fetch(:port)
  has_port = !port.to_s.empty? && port != "?"

  {
    "label" => label,
    "app" => app.fetch("slug"),
    "task" => record.fetch(:task),
    "worktree" => record.fetch(:dir),
    "context_file" => context_path(record.fetch(:dir)),
    "context_exists" => File.exist?(context_path(record.fetch(:dir))),
    "env_exists" => record.fetch(:env_exists),
    "health" => stack_health(record),
    "local_url" => has_port ? "http://localhost:#{port}" : nil,
    "local_inbox_url" => has_port ? "http://localhost:#{port}/_studio/local_emails" : nil,
    "app_port" => has_port ? port.to_i : nil,
    "port_pid" => record.fetch(:port_pid).empty? ? nil : record.fetch(:port_pid).to_i,
    "up_code" => record.fetch(:code),
    "redis_db" => record.fetch(:redis_db).empty? ? nil : record.fetch(:redis_db).to_i,
    "database" => record.fetch(:db_name).empty? ? nil : record.fetch(:db_name),
    "database_exists" => record.fetch(:db_exists),
    "branch" => record.fetch(:branch),
    "head" => record.fetch(:head),
    "commit_subject" => record.fetch(:commit_subject),
    "dirty" => record.fetch(:dirty),
    "merged_to_origin_main" => record.fetch(:merged),
    "equivalent_to_origin_main" => record.fetch(:equivalent_to_main),
    "ahead_origin_main" => record.fetch(:ahead),
    "behind_origin_main" => record.fetch(:behind),
    "pidfile_state" => record.fetch(:pidfile_state),
    "sidekiq_pidfile_state" => record.fetch(:sidekiq_pidfile_state),
    "cleanup_candidate" => cleanup_ready?(record),
    "compare_url" => github_compare_url(record),
    "issues" => issues_by_label[label]
  }
end

# Slots that can actually be handed out right now: the soft band intersected with
# the physically-existing Redis DBs, minus what's already allocated. Band-free
# alone (current - used) overstates availability whenever the band exceeds
# physical room (e.g. floor 20 on a stock databases=16 Redis).
def allocatable_free(current_capacity, physical_count, used_count)
  band_top = redis_db_min + current_capacity - 1
  usable_ceiling = [band_top, physical_count - 1].min
  usable = [usable_ceiling - redis_db_min + 1, 0].max
  [usable - used_count, 0].max
end

def capacity_snapshot
  current = load_current_capacity
  used = allocated_band_dbs.size
  physical_count = redis_physical_count
  {
    "floor" => REDIS_BAND_FLOOR,
    "step" => REDIS_BAND_STEP,
    "current" => current,
    "used" => used,
    "free" => allocatable_free(current, physical_count, used),
    "physical_max" => redis_physical_databases
  }
end

def snapshot_payload(app = nil)
  selected_apps = app ? [app] : apps.values
  records = stack_records(app)
  issues_by_label = doctor_issues_by_label(app)

  {
    "generated_at" => Time.now.utc.iso8601,
    "projects_dir" => PROJECTS_DIR,
    "hub_dir" => HUB_DIR,
    "redis_db_range" => {
      "min" => redis_db_min,
      "max" => redis_db_max
    },
    "capacity" => capacity_snapshot,
    "apps" => selected_apps.sort_by { |config| config.fetch("primary_port") }.map { |config| app_snapshot(config) },
    "summary" => {
      "worktrees" => records.size,
      "issues" => issues_by_label.values.sum(&:size),
      "cleanup_candidates" => records.count { |record| cleanup_ready?(record) },
      "dirty_worktrees" => records.count { |record| record.fetch(:dirty) },
      "running_or_port_busy" => records.count { |record| !record.fetch(:port_pid).empty? },
      "behind_origin_main" => records.count { |record| !cleanup_ready?(record) && !%w[0 ?].include?(record.fetch(:behind).to_s) }
    },
    "worktrees" => records.map { |record| stack_record_snapshot(record, issues_by_label) }
  }
end

def run_snapshot(app = nil, write: false)
  payload = snapshot_payload(app)
  json = JSON.pretty_generate(payload)

  unless write
    puts json
    return
  end

  FileUtils.mkdir_p(File.dirname(snapshot_path))
  File.write(snapshot_path, "#{json}\n")
  puts "wrote #{payload.fetch("worktrees").size} worktree record(s) to #{snapshot_path}"
rescue Errno::EACCES, Errno::EPERM => e
  abort "could not write worktree registry to #{snapshot_path}: #{e.message}\nSet AGENT_WORKTREE_REGISTRY=/tmp/worktree-registry.json for a scratch write, or rerun with filesystem approval for the projects registry."
end

def cleanup_candidates(app = nil)
  stack_records(app).select { |record| cleanup_ready?(record) }
end

def ledger_path
  File.join(HUB_DIR, "docs", "agents", "maintenance", "delete-later.md")
end

def cleanup_reason(record)
  if record[:merged]
    "Hidden worktree; branch `#{record[:branch]}` is clean and HEAD #{record[:head]} is contained in origin/main."
  else
    "Hidden worktree; branch `#{record[:branch]}` is clean and its final diff against origin/main is empty, usually after a squash merge."
  end
end

def cleanup_row(record, status: "pending approval")
  path = record[:dir]
  command = "bin/agent-worktree remove #{record[:app].fetch("slug")} #{record[:task]} --yes"
  condition = status.start_with?("removed") ? "Removed with `#{command}` during approved lifecycle cleanup." : "Remove with `#{command}` after operator approval."
  "| `#{path}` | worktree | #{cleanup_reason(record)} | #{condition} | #{status} |"
end

def write_cleanup_ledger_record(record, status:)
  row = cleanup_row(record, status: status)
  path_cell = "| `#{record[:dir]}` |"
  existing = File.exist?(ledger_path) ? File.read(ledger_path) : ""

  if existing.include?(path_cell)
    updated = existing.lines.map { |line| line.include?(path_cell) ? "#{row}\n" : line }.join
    File.write(ledger_path, updated)
    puts "updated cleanup ledger: #{ledger_path}"
    return
  end

  File.open(ledger_path, "a") do |file|
    file.puts
    file.puts "<!-- agent-worktree remove #{Time.now.strftime("%Y-%m-%d")} -->"
    file.puts row
  end
  puts "wrote cleanup ledger: #{ledger_path}"
end

def run_cleanup(app = nil, write: false)
  candidates = cleanup_candidates(app)
  if candidates.empty?
    puts "cleanup: no clean merged or main-equivalent worktree candidates"
    return
  end

  puts "cleanup candidates:"
  candidates.each { |record| puts "  - #{record[:app].fetch("slug")}/#{record[:task]} #{record[:dir]}" }

  unless write
    puts
    puts "dry run only. Re-run with --write to append candidates to #{ledger_path}."
    return
  end

  existing = File.exist?(ledger_path) ? File.read(ledger_path) : ""
  rows = candidates.map { |record| cleanup_row(record) }.reject { |row| existing.include?(row.split("`")[1].to_s) }
  if rows.empty?
    puts "cleanup: candidates already present in #{ledger_path}"
    return
  end

  File.open(ledger_path, "a") do |file|
    file.puts
    file.puts "<!-- agent-worktree cleanup #{Time.now.strftime("%Y-%m-%d")} -->"
    rows.each { |row| file.puts row }
  end
  puts "wrote #{rows.size} candidate(s) to #{ledger_path}"
  maybe_scale_in
end

def registered_worktree?(app, dir)
  ok, out, = capture_status("git", "-C", app.fetch("repo"), "worktree", "list", "--porcelain")
  ok && out.lines.any? { |line| line.chomp == "worktree #{dir}" }
end

def stop_pidfile(path, label)
  return unless File.exist?(path)

  pid = File.read(path).strip
  if pid_alive?(pid)
    Process.kill("TERM", pid.to_i)
    puts "stopped #{label} pid #{pid}"
  else
    puts "#{label} not running"
  end
  FileUtils.rm_f(path)
end

def stop_stack_for_removal(app, dir, record)
  if record[:env_exists]
    values = local_email_values.merge(parse_env(record[:env_path]))
    if app.fetch("stack") == "tm"
      ok = sh("bin/tm", "down", chdir: dir, env: command_env(app, values), allow_fail: true)
      warn "warning: bin/tm down failed; falling back to pidfile cleanup" unless ok
    else
      stop_generic_rails(dir, values["APP_PORT"])
    end
  else
    stop_generic_rails(dir, record[:port])
  end

  stop_pidfile(File.join(dir, "tmp", "pids", "tm-web.pid"), "tm web") if app.fetch("stack") == "tm"
  stop_pidfile(File.join(dir, "tmp", "pids", "tm-sidekiq.pid"), "tm sidekiq") if app.fetch("sidekiq")
end

def delete_local_branch_if_safe(app, branch)
  return if branch.to_s.empty? || branch == "?"
  return if %w[main master].include?(branch)

  ok, out, = capture_status("git", "-C", app.fetch("repo"), "branch", "--list", branch)
  return unless ok && !out.strip.empty?

  sh("git", "-C", app.fetch("repo"), "branch", "-D", branch)
end

# The per-worktree teardown shared by `remove` and `cleanup --reclaim`:
# stop the stack, flush its Redis DB, record the ledger row, drop the git
# worktree, and delete the local branch. Callers handle band scale-in and the
# registry refresh once, after the (possibly batched) teardown.
def teardown_worktree(app, dir, record)
  stop_stack_for_removal(app, dir, record)
  flush_redis_db(record)
  write_cleanup_ledger_record(record, status: "removed #{Time.now.strftime("%Y-%m-%d")}")
  sh("git", "-C", app.fetch("repo"), "worktree", "remove", dir)
  delete_local_branch_if_safe(app, record[:branch])
end

# Scale-down-on-close normal flow: release every worktree whose branch is
# already represented on origin/main (merged or squash-equivalent) and clean.
# Dry-run by default; --yes performs the teardown. Never touches dirty/unmerged
# worktrees or the primary checkout (cleanup_ready? + .worktrees-only source),
# and re-verifies each candidate under the lock before removing it.
def run_reclaim(app = nil, yes: false)
  (app ? [app] : apps.values).each do |config|
    next unless Dir.exist?(File.join(config.fetch("repo"), ".git"))
    sh("git", "-C", config.fetch("repo"), "fetch", "origin", "--quiet", allow_fail: true)
  end

  candidates = cleanup_candidates(app)
  if candidates.empty?
    puts "reclaim: no clean merged or main-equivalent worktrees to release"
    return
  end

  unless yes
    puts "reclaim candidates:"
    candidates.each do |record|
      puts "  - #{record[:app].fetch("slug")}/#{record[:task]} redis=#{record[:redis_db]} #{record[:dir]}"
    end
    puts
    puts "dry run only. Re-run with --reclaim --yes to stop each stack, flush its Redis DB, remove the worktree, delete the local branch, scale the band in, and refresh the registry."
    return
  end

  freed = []
  with_worktree_lock do
    candidates.each do |record|
      dir = record[:dir]
      next unless registered_worktree?(record[:app], dir)

      # Re-read under the lock so a worktree that turned dirty/unmerged between
      # listing and teardown is skipped, not destroyed.
      fresh = stack_record(record[:app], dir)
      unless cleanup_ready?(fresh) && !fresh[:dirty]
        puts "skipping #{fresh[:app].fetch("slug")}/#{fresh[:task]}: no longer a safe candidate"
        next
      end

      teardown_worktree(fresh[:app], dir, fresh)
      freed << { slug: "#{fresh[:app].fetch("slug")}/#{fresh[:task]}", redis_db: fresh[:redis_db] }
      puts "reclaimed #{fresh[:app].fetch("slug")}/#{fresh[:task]} (freed redis db #{fresh[:redis_db]})"
    end
    maybe_scale_in
  end
  run_snapshot(app, write: true)

  if freed.empty?
    puts "reclaim: nothing reclaimed (candidates changed under lock)"
  else
    dbs = freed.map { |entry| entry[:redis_db] }.compact.sort
    puts
    puts "reclaimed #{freed.size} worktree(s); freed redis DBs: #{dbs.join(", ")}"
    band = load_current_capacity
    puts "current band: #{band} slots (redis DBs #{redis_db_min}-#{redis_db_min + band - 1})"
  end
end

def run_remove(app, task, yes: false)
  dir = worktree_dir(app, task)
  abort "missing worktree: #{dir}" unless Dir.exist?(dir)

  sh("git", "-C", app.fetch("repo"), "fetch", "origin", "--quiet", allow_fail: true)
  record = stack_record(app, dir)
  blockers = []
  blockers << "dirty worktree" if record[:dirty]
  blockers << "branch content is not represented on origin/main" unless cleanup_ready?(record)
  blockers << "worktree is not registered with git" unless registered_worktree?(app, dir)

  if blockers.any?
    puts "refusing to remove #{app.fetch("slug")}/#{task}:"
    blockers.each { |blocker| puts "  - #{blocker}" }
    puts "inspect with: git -C #{dir.shellescape} diff --stat origin/main..HEAD"
    exit 1
  end

  unless yes
    puts "remove candidate: #{app.fetch("slug")}/#{task}"
    puts "worktree: #{dir}"
    puts "branch:   #{record[:branch]}"
    puts "reason:   #{cleanup_reason(record)}"
    puts
    puts "dry run only. Re-run with --yes after approval to stop the stack, update the ledger, remove the worktree, delete the local branch, and refresh the registry."
    return
  end

  teardown_worktree(app, dir, record)
  maybe_scale_in
  run_snapshot(app, write: true)
end

def graduation_blockers(record)
  blockers = []
  branch = record[:branch]

  blockers << "missing #{STACK_ENV}" unless record[:env_exists]
  blockers << "worktree has uncommitted changes; commit or intentionally revert them before QA handoff" if record[:dirty]
  blockers << "branch is #{branch.inspect}; feature work must not graduate from main/master" if %w[main master].include?(branch)
  blockers << "branch has no commits ahead of origin/main" if record[:ahead].to_s == "0"
  blockers << "branch is #{record[:behind]} commit(s) behind origin/main; rebase before PR" if !record[:equivalent_to_main] && !%w[0 ?].include?(record[:behind].to_s)
  blockers << "branch content is already represented on origin/main; use cleanup/remove instead of finish" if cleanup_ready?(record)

  blockers
end

def pr_body(record)
  url = record[:port].empty? ? "not started" : "http://localhost:#{record[:port]}"
  email_url = record[:port].empty? ? "not started" : "http://localhost:#{record[:port]}/_studio/local_emails"
  <<~BODY
    ## Summary
    - 

    ## Local Proof
    - App: #{record[:app].fetch("display_name", record[:app].fetch("slug"))}
    - Task: #{record[:task]}
    - Worktree: `#{record[:dir]}`
    - Review URL: #{url}
    - Local inbox: #{email_url}
    - Stack health: #{stack_health(record)} (/up #{record[:code]})

    ## Verification
    - 

    ## QA Notes
    - Avi: verify scope/spec match and merge safety.
    - Steffon: run QA/deploy checks when risk warrants.
    - Do not delete this branch/worktree until the PR is merged or intentionally abandoned.
  BODY
end

def run_finish(app, task, push: false, pr: false)
  dir = worktree_dir(app, task)
  abort "missing worktree: #{dir}\nRun: bin/agent-worktree new #{app.fetch("slug")} #{task}" unless Dir.exist?(dir)
  load_stack_env(app, task)

  fetch_ok, _fetch_out, fetch_err = capture_status("git", "fetch", "origin", "--quiet", chdir: dir)
  warn "warning: git fetch failed; using local origin/main state: #{fetch_err.lines.first.to_s.strip}" unless fetch_ok
  record = stack_record(app, dir)
  compare_url = github_compare_url(record)
  blockers = graduation_blockers(record)

  puts "feature graduation packet"
  puts "app:      #{app.fetch("display_name", app.fetch("slug"))}"
  puts "task:     #{task}"
  puts "branch:   #{record[:branch]}"
  puts "head:     #{record[:head]} #{record[:commit_subject]}"
  puts "worktree: #{dir}"
  puts "url:      #{record[:port].empty? ? "not started" : "http://localhost:#{record[:port]}"}"
  puts "email:    #{record[:port].empty? ? "not started" : "http://localhost:#{record[:port]}/_studio/local_emails"}"
  puts "health:   #{stack_health(record)} (/up #{record[:code]})"
  puts "git:      #{record[:dirty] ? "dirty" : "clean"} #{record[:merged] ? "merged" : "unmerged"} +#{record[:ahead]}/-#{record[:behind]}"
  puts "compare:  #{compare_url || "unknown remote"}"
  puts

  if blockers.any?
    puts "not ready for QA:"
    blockers.each { |blocker| puts "  - #{blocker}" }
    exit 1
  end

  if push || pr
    sh("git", "push", "-u", "origin", record[:branch], chdir: dir)
    puts "pushed:   #{record[:branch]}"
  end

  if pr
    abort "gh CLI is not available; pushed branch, then open #{compare_url}" unless command_available?("gh")

    title = human_title(task)
    body = pr_body(record)
    sh("gh", "pr", "create", "--draft", "--base", "main", "--head", record[:branch],
       "--title", title, "--body", body, chdir: dir)
  else
    puts "ready for QA. Open a draft PR with this body:"
    puts
    puts pr_body(record)
  end
end

# Flush a worktree's Redis DB on removal so a reused DB number cannot inherit
# stale keys from the previous stack.
def flush_redis_db(record)
  url = record[:env]["REDIS_URL"].to_s
  db = redis_db_from_url(url)
  return if db.empty?

  host = "localhost"
  port = "6379"
  if url =~ %r{redis://([^:/]+):(\d+)/}
    host = Regexp.last_match(1)
    port = Regexp.last_match(2)
  end

  if sh("redis-cli", "-h", host, "-p", port, "-n", db, "flushdb", allow_fail: true)
    log_ok("flushed redis DB #{db}")
  else
    log_fail("could not flush redis DB #{db} (redis-cli unavailable or redis down)")
  end
end

def run_scale_status
  current = load_current_capacity
  physical = redis_physical_databases
  physical_count = physical || redis_physical_count
  physical_top = physical_count - 1
  used = allocated_band_dbs.size
  free = allocatable_free(current, physical_count, used)
  band_top = redis_db_min + current - 1

  puts "redis worktree band"
  puts "  floor:        #{REDIS_BAND_FLOOR} slots"
  puts "  step:         #{REDIS_BAND_STEP} slots"
  puts "  current band: #{current} slots (redis DBs #{redis_db_min}-#{band_top})"
  puts "  used:         #{used}"
  puts "  free:         #{free}"
  if physical
    puts "  physical:     databases=#{physical} (max redis DB #{physical_top})"
  else
    puts "  physical:     unknown (redis-cli unavailable); assuming databases=#{physical_count}"
  end

  room = physical_band_capacity(physical_count)
  return unless current > room

  puts
  puts "  warning: band (#{current} slots) exceeds physical room (#{room} slots);"
  puts "           only redis DBs #{redis_db_min}-#{[band_top, physical_top].min} are usable."
  puts "           run: bin/agent-worktree scale --provision  to raise Redis databases to #{redis_physical_target}."
end

def run_scale_out
  with_worktree_lock do
    current = load_current_capacity
    room = physical_band_capacity
    if current >= room
      puts "at physical ceiling: #{current} slots (redis databases ceiling). Run scale --provision to raise it."
      return
    end

    target = [current + REDIS_BAND_STEP, room].min
    write_current_capacity(target)
    puts "scaled out: #{current} -> #{target} slots (band redis DBs #{redis_db_min}-#{redis_db_min + target - 1})"
  end
end

def run_scale_in
  with_worktree_lock do
    current = load_current_capacity
    if current <= REDIS_BAND_FLOOR
      puts "already at floor: #{current} slots"
      return
    end

    highest_used = allocated_band_dbs.max
    min_capacity_for_used = highest_used ? (highest_used - redis_db_min + 1) : 0
    target = [current - REDIS_BAND_STEP, REDIS_BAND_FLOOR].max
    if target < min_capacity_for_used
      puts "cannot shrink to #{target} slots; redis DB #{highest_used} is still allocated. Free higher worktrees first."
      return
    end

    write_current_capacity(target)
    puts "scaled in: #{current} -> #{target} slots (band redis DBs #{redis_db_min}-#{redis_db_min + target - 1})"
  end
end

def brew_prefix
  return ENV["HOMEBREW_PREFIX"] if ENV["HOMEBREW_PREFIX"].to_s != ""

  ok, out, = capture_status("brew", "--prefix")
  ok ? out.strip : "/opt/homebrew"
rescue StandardError
  "/opt/homebrew"
end

def redis_conf_path
  File.expand_path(ENV.fetch("AGENT_REDIS_CONF") { File.join(brew_prefix, "etc", "redis.conf") })
end

# Raise local Redis `databases` to the target and restart Redis exactly once.
# Idempotent; warns that it bounces every running stack; requires --yes to skip
# the interactive confirm. This is the ONE place that restarts Redis.
def run_scale_provision(yes: false)
  target = redis_physical_target
  current_physical = redis_physical_databases
  if current_physical && current_physical >= target
    puts "redis already exposes #{current_physical} databases (>= target #{target}); no restart needed."
    return
  end

  conf = redis_conf_path
  abort "redis config not found at #{conf}. Set AGENT_REDIS_CONF to the brew redis.conf path." unless File.exist?(conf)

  warn "WARNING: provisioning restarts local Redis once."
  warn "Every running worktree stack (and anything else on localhost:6379) will be bounced."
  warn "  config:  #{conf}"
  warn "  current: databases=#{current_physical || "unknown"}"
  warn "  target:  databases=#{target}"

  unless yes
    $stderr.print "Type yes to proceed: "
    answer = $stdin.gets.to_s.strip
    abort "aborted; Redis not changed" unless answer == "yes"
  end

  content = File.read(conf)
  updated =
    if content =~ /^\s*databases\s+\d+.*$/
      content.gsub(/^\s*databases\s+\d+.*$/, "databases #{target}")
    else
      "#{content.chomp}\ndatabases #{target}\n"
    end
  File.write(conf, updated)
  log_act("set databases #{target} in #{conf}")

  sh("brew", "services", "restart", "redis")
  puts "redis restarted with databases #{target}."
end

cmd = ARGV.shift || "help"

case cmd
when "apps"
  apps.values.sort_by { |app| app.fetch("primary_port") }.each do |app|
    puts "#{app.fetch("slug").ljust(18)} #{app.fetch("display_name", app.fetch("slug")).ljust(22)} primary #{app.fetch("primary_port")}  range #{app.fetch("range_start")}-#{app.fetch("range_end")}  #{app.fetch("status", "unknown")}"
  end
when "list"
  app = ARGV[0] ? app_for(ARGV[0]) : nil
  list_worktrees(app)
when "plan"
  app_name, raw_task, type = ARGV
  usage unless app_name && raw_task
  app = app_for(app_name)
  task = clean_slug(raw_task)
  values = with_worktree_lock { stack_values(app, task) }
  print_plan(app, task, values)
when "new"
  app_name, raw_task, maybe_type, *rest = ARGV
  usage unless app_name && raw_task
  app = app_for(app_name)
  task = clean_slug(raw_task)
  type = maybe_type&.start_with?("--") ? "feat" : (maybe_type || "feat")
  start = ARGV.include?("--start")
  dir = ensure_git_worktree(app, task, type)
  values, path = with_worktree_lock do
    existing = parse_env(stack_env_path(app, task))
    resolved = existing.empty? ? stack_values(app, task) : local_email_values.merge(existing)
    [resolved, write_stack_env(app, task, resolved)]
  end
  write_context_marker(app, task, values, dir)
  puts "worktree ready: #{dir}"
  puts "stack env:      #{path}"
  puts "context:        #{context_path(dir)}"
  puts
  print_plan(app, task, values, dir)
  if start
    puts
    ARGV.replace(["up", app.fetch("slug"), task])
    exec($PROGRAM_NAME, *ARGV)
  end
when "env"
  app_name, raw_task = ARGV
  usage unless app_name && raw_task
  app = app_for(app_name)
  task = clean_slug(raw_task)
  puts File.read(stack_env_path(app, task))
when "up"
  app_name, raw_task = ARGV
  usage unless app_name && raw_task
  app = app_for(app_name)
  task = clean_slug(raw_task)
  dir = worktree_dir(app, task)
  abort "missing worktree: #{dir}\nRun: bin/agent-worktree new #{app.fetch("slug")} #{task}" unless Dir.exist?(dir)
  values = load_stack_env(app, task)
  app.fetch("stack") == "tm" ? start_tm(dir, app, values) : start_generic_rails(dir, app, values)
  code = wait_for_url(values.fetch("APP_PORT"))
  record = verify_started_stack!(app, dir, values.fetch("APP_PORT"))
  write_context_marker(app, task, values, dir, record: record)
  code = record[:code]
  puts
  puts "url: http://localhost:#{values.fetch("APP_PORT")} (/up #{code})"
  puts "email: http://localhost:#{values.fetch("APP_PORT")}/_studio/local_emails"
  puts "context: #{context_path(dir)}"
when "status"
  app_name, raw_task = ARGV
  usage unless app_name && raw_task
  app = app_for(app_name)
  task = clean_slug(raw_task)
  values = load_stack_env(app, task)
  code = wait_for_url(values.fetch("APP_PORT"))
  record = stack_record(app, worktree_dir(app, task))
  write_context_marker(app, task, values, worktree_dir(app, task), record: record)
  print_plan(app, task, values)
  puts "status: /up #{code}"
  puts "health: #{stack_health(record)}"
  merge = if record[:merged]
            "merged"
          elsif record[:equivalent_to_main]
            "main-eq"
          else
            "unmerged"
          end
  puts "git:    #{record[:branch]} #{record[:head]} #{record[:dirty] ? "dirty" : "clean"} #{merge} +#{record[:ahead]}/-#{record[:behind]}"
  puts "web:    port_pid=#{record[:port_pid].empty? ? "none" : record[:port_pid]} pidfile=#{record[:pidfile_state]}"
  puts "sidekiq: pidfile=#{record[:sidekiq_pidfile_state]}" if app.fetch("sidekiq")
  puts "db:     #{record[:db_name]}#{record[:db_exists].nil? ? "" : " #{record[:db_exists] ? "ok" : "missing"}"}"
  puts "redis:  db #{record[:redis_db]}"
  puts "context: #{context_path(worktree_dir(app, task))}"
when "whereami"
  json = ARGV.delete("--json")
  shell = ARGV.delete("--shell")
  usage if json && shell
  case ARGV.length
  when 0
    run_whereami(json: !!json, shell: !!shell)
  when 2
    app = app_for(ARGV[0])
    task = clean_slug(ARGV[1])
    run_whereami(app, task, json: !!json, shell: !!shell)
  else
    usage
  end
when "shell-hook"
  shell = ARGV.shift
  usage unless shell && ARGV.empty?
  run_shell_hook(shell)
when "finish"
  push = ARGV.delete("--push")
  pr = ARGV.delete("--pr")
  app_name, raw_task = ARGV
  usage unless app_name && raw_task
  app = app_for(app_name)
  task = clean_slug(raw_task)
  run_finish(app, task, push: !!push, pr: !!pr)
when "doctor"
  app = ARGV[0] ? app_for(ARGV[0]) : nil
  run_doctor(app)
when "snapshot"
  write = ARGV.delete("--write")
  app = ARGV[0] ? app_for(ARGV[0]) : nil
  run_snapshot(app, write: !!write)
when "cleanup"
  reclaim = ARGV.delete("--reclaim")
  yes = ARGV.delete("--yes")
  write = ARGV.delete("--write")
  app = ARGV[0] ? app_for(ARGV[0]) : nil
  if reclaim
    run_reclaim(app, yes: !!yes)
  else
    run_cleanup(app, write: !!write)
  end
when "remove"
  yes = ARGV.delete("--yes")
  app_name, raw_task = ARGV
  usage unless app_name && raw_task
  app = app_for(app_name)
  task = clean_slug(raw_task)
  run_remove(app, task, yes: !!yes)
when "down"
  app_name, raw_task = ARGV
  usage unless app_name && raw_task
  app = app_for(app_name)
  task = clean_slug(raw_task)
  dir = worktree_dir(app, task)
  values = load_stack_env(app, task)
  if app.fetch("stack") == "tm"
    sh("bin/tm", "down", chdir: dir, env: command_env(app, values))
  else
    stop_generic_rails(dir, values["APP_PORT"])
  end
when "scale"
  if ARGV.include?("--provision")
    ARGV.delete("--provision")
    yes = ARGV.delete("--yes")
    run_scale_provision(yes: !!yes)
  else
    case ARGV[0] || "status"
    when "status" then run_scale_status
    when "out" then run_scale_out
    when "in" then run_scale_in
    else usage
    end
  end
else
  usage
end
