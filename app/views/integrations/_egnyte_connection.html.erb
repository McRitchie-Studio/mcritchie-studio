<%# Admin only (IntegrationsController#index sets the Egnyte connections for an admin and nobody else): the hub's own Egnyte connections, on the Egnyte card's action row. Each connected domain and its Disconnect; then Connect with a domain field when the server can take one, else a disabled Connect that says why. Both come back to this page. No token renders. %>
<div class="mt-1.5 space-y-1.5" data-test="egnyte-connection" data-state="<%= connections.any? ? 'connected' : 'none' %>" data-connectable="<%= connectable %>">
  <% connections.each do |connection| %>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1" data-test="egnyte-domain" data-domain="<%= connection.domain %>">
      <span class="min-w-0 text-body [overflow-wrap:anywhere]">Connected <span class="font-medium text-heading"><%= connection.host %></span></span>
      <%= button_to "Disconnect", admin_egnyte_disconnect_path(egnyte_domain: connection.domain, return_to: integrations_path), method: :delete,
                    class: "btn btn-neutral btn-sm",
                    form: { class: "inline-flex", data: { test: "egnyte-disconnect", turbo_confirm: "Disconnect Egnyte for #{connection.host}?" } } %>
    </div>
  <% end %>
  <% if connectable %>
    <%= form_with url: admin_egnyte_connect_path, method: :post, local: true, class: "flex flex-wrap items-center gap-2",
                  data: { test: "egnyte-connect", turbo: false } do |form| %>
      <%= hidden_field_tag :return_to, integrations_path %>
      <label class="sr-only" for="egnyte-card-domain">Egnyte domain</label>
      <%= form.text_field :egnyte_domain, id: "egnyte-card-domain", required: true, placeholder: "domain.egnyte.com", autocomplete: "off", spellcheck: false,
                          class: "input-field min-w-0 flex-1 text-xs", data: { test: "egnyte-domain-field" } %>
      <%= form.submit "Connect Egnyte", class: "btn btn-primary btn-sm" %>
    <% end %>
  <% else %>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="btn btn-primary btn-sm opacity-50 cursor-not-allowed" disabled aria-describedby="egnyte-card-off" data-test="egnyte-connect-disabled">Connect Egnyte</button>
      <span id="egnyte-card-off" class="text-muted">Not set up on this server yet.</span>
    </div>
  <% end %>
</div>
