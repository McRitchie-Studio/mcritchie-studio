<%# THE GENERATOR PAGE'S KIT LIST: one row per brand kit, with the character
    that fronts it. Admin only (EmailImageGeneratorsController#index). %>
<div class="max-w-4xl mx-auto px-4 py-6 space-y-5">
  <%= render "studio/page_header", title: "Email image generator", crumbs: studio_crumbs(:email_image_generators), crumb_label: "Generator" %>
  <p class="text-sm text-secondary">Pick a brand: its model, a few examples, and the prompt to paste into a Claude Code session.</p>

  <ul class="card divide-y divide-subtle" data-test="generator-kits">
    <% @kits.each do |kit| %>
      <% character = @characters[kit.key] %>
      <li data-test="generator-kit" data-kit="<%= kit.key %>">
        <%= link_to email_image_generator_path(kit.key), class: "flex flex-wrap items-center gap-2 px-4 py-3 hover:bg-surface-alt min-w-0" do %>
          <span class="text-sm font-semibold text-heading"><%= kit.label %></span>
          <span class="font-mono text-2xs text-muted break-all"><%= kit.key %></span>
          <span class="badge text-3xs bg-surface-alt text-muted border-subtle sm:ml-auto">
            <%= character ? "model: #{character.name}" : "no character: uses the kit's mark" %>
          </span>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
