<%# One span grade editor inside the span drawer — Alex's grade, or the McRitchie audit
    of it (same shape as the per-action _grade_editor). It POSTs to E2's grade_event
    endpoint via fetch (heartbeatEventEditor.submit), which returns JSON — so this is a
    hand-written form (not form_with/turbo_stream): the fetch carries the Rails CSRF
    token from the hidden field, and on success dispatches the hb:span-graded event the
    span row listens for. The nested x-data holds the live word count `n`, the toggled
    disposition `disp`, the banked/discarded flags, and the save/error state. Locals:
    event, grader, who, role_label, grade (ActionGrade | nil), save_label, allow_bank
    (Alex only — banking curates Alex's grade into the Insight Bank). %>
<% n0 = heartbeat_word_count(grade&.slug) %>
<form action="<%= heartbeat_event_grade_path(event) %>" method="post" class="hb-fbblock hb-evtfbblock"
      data-test="span-grade-form" data-grader="<%= grader %>"
      x-data="heartbeatEventEditor({ n: <%= n0 %>, disp: '<%= grade&.disposition %>', banked: <%= !!grade&.banked %>, discarded: <%= !!grade&.discarded %> })"
      @submit.prevent="submit($event)">
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <input type="hidden" name="grader" value="<%= grader %>">
  <h3><%= who %> <span class="hb-who"><%= role_label %></span></h3>

  <div class="hb-field">
    <label>4&ndash;7 word slug</label>
    <input type="text" name="slug" class="hb-input" value="<%= grade&.slug %>"
           placeholder="4–7 words — what the span did, critically"
           @input="n = wordCount($event.target.value)">
    <div class="hb-wc" :class="(n >= 4 && n <= 7) ? 'ok' : 'off'"
         x-text="n + ' words (aim 4–7)'"><%= n0 %> words (aim 4&ndash;7)</div>
  </div>

  <div class="hb-field">
    <label>Disposition</label>
    <input type="hidden" name="disposition" :value="disp">
    <div class="hb-disptoggle">
      <button type="button" @click="disp = 'good'" :class="disp === 'good' ? 'sel-good' : ''">Good</button>
      <button type="button" @click="disp = 'not'" :class="disp === 'not' ? 'sel-not' : ''">Not</button>
      <button type="submit" name="intent" value="clear" class="clear-disp"
              title="Clear grade" aria-label="Clear <%= grader %> grade"
              @click="disp = ''">&times;</button>
    </div>
  </div>

  <div class="hb-field">
    <label>Long-form (as needed)</label>
    <textarea name="long_form" class="hb-textarea"
              placeholder="optional — anchor the lesson, name the span-level pattern"><%= grade&.long_form %></textarea>
  </div>

  <div class="hb-saverow">
    <button type="submit" name="intent" value="save" class="hb-btn primary" :disabled="saving"><%= save_label %></button>
    <% if allow_bank %>
      <button type="submit" name="intent" value="bank" class="hb-btn hb-bank" :class="banked ? 'is-on' : ''" :disabled="saving">&#128161; Bank</button>
      <button type="submit" name="intent" value="discard" class="hb-btn hb-discard" :class="discarded ? 'is-on' : ''" :disabled="saving">&#128465; Discard</button>
    <% end %>
  </div>

  <div class="hb-evtsaved" data-test="span-grade-saved" x-show="saved" x-transition style="display:none">Saved &#10003;</div>
  <div class="hb-derror" x-show="error" x-text="error" style="display:none"></div>
</form>
