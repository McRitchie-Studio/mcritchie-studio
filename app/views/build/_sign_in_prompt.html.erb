<%# locals: (request_row:, return_to:) %>
<%# The sign-in prompt a signed-out Build My App opens under the summary card (BuildController#sign_in_to_launch, placed by a Turbo Stream; the card itself is untouched, so the draft stays). The press is already remembered in this browser's session (BuildIntake::PendingLaunch), so both doors come back to the launch: the emailed link's return_to is the launch landing, and Google lands on the home page, which forwards there (LandingController). The email form posts through window.postMagicLink (layouts/application) and then shows the standard check-inbox modal. %>
<div id="<%= BuildController::SIGN_IN_PROMPT_ID %>" class="self-start w-full max-w-xl rounded-2xl border border-primary bg-surface p-3 sm:p-4 space-y-3"
     data-test="build-sign-in-prompt" role="region" aria-labelledby="build-sign-in-heading"
     x-data="{
       email: '', sending: false, sent: false, error: '',
       async submit() {
         if (!this.email || this.sending) return;
         this.error = ''; this.sending = true;
         try {
           await window.postMagicLink(this.email, <%= return_to.to_json %>);
           this.sent = true;
           if (window.Alpine && Alpine.store('modals')) Alpine.store('modals').open('check-inbox', { sentEmail: this.email });
         } catch (e) {
           this.error = 'Could not send the link. Check your connection and try again.';
         } finally { this.sending = false; }
       }
     }">
  <div>
    <h3 id="build-sign-in-heading" class="text-heading font-bold text-base">Sign in to build your app</h3>
    <p class="text-secondary text-sm mt-0.5">Free. Then we start building <span class="font-mono break-all"><%= request_row.host %></span>.</p>
  </div>

  <%= button_to "/auth/google_oauth2", method: :post, form: { data: { turbo: false } }, data: { turbo: false, test: "build-sign-in-google" },
        class: "btn btn-neutral w-full gap-3" do %>
    <%= render "components/google_logo" %>
    Continue with Google
  <% end %>

  <div class="relative">
    <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-strong"></div></div>
    <div class="relative flex justify-center text-xs"><span class="bg-surface px-3 text-secondary">or</span></div>
  </div>

  <form @submit.prevent="submit()" novalidate data-test="build-sign-in-email-form">
    <label for="build-sign-in-email" class="block text-sm text-secondary mb-1 font-medium">Email</label>
    <input type="email" id="build-sign-in-email" x-model="email" required autocomplete="email"
           class="input-field mb-3" placeholder="you@example.com">
    <button type="submit" :disabled="sending || !email" class="btn btn-primary w-full disabled:cursor-wait disabled:opacity-60" data-test="build-sign-in-send">
      <span x-text="sending ? 'Sending…' : 'Email me a sign-in link'">Email me a sign-in link</span>
    </button>
    <p x-show="error" x-cloak class="text-xs text-danger-ink text-center mt-2" role="alert" x-text="error"></p>
    <p x-show="sent" x-cloak class="text-xs text-success-ink text-center mt-2" data-test="build-sign-in-sent">Check your inbox. The link brings you straight to your app.</p>
  </form>
</div>
