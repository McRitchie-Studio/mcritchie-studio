<%# locals: (url:, scope:, id:, agent_name:, error:, text:, attachments: nil) %>
<%# The chat's composer: the one big chat box every agent page ends on (/build, /build/:token, /applications/:slug/chat), the text over a round send button at its bottom right. A fresh client id per render makes a double submit store one message (AgentMessages::WebIngest). Enter sends; Shift+Enter is a new line (app/javascript/agent_chat.js). Files ride in through the attachments slot, never by editing this form. The box keeps one view-transition name across the three pages, so a move between them leaves it in place. %>
<%= form_with scope: scope, url: url, id: id, html: { style: "view-transition-name: agent-composer;" },
              class: "rounded-3xl border border-subtle bg-surface shadow-lg focus-within:border-primary transition-colors p-2 flex flex-col gap-2",
              data: { test: "cto-chat-form", cto_chat_form: true } do |f| %>
  <%= f.hidden_field :client_id, value: SecureRandom.uuid %>
  <% if error %>
    <p class="px-3 pt-1 text-xs text-danger-ink" role="alert" data-test="cto-chat-error"><%= error %></p>
  <% end %>
  <%= render "agent_chats/attachments_slot", form: f, **(attachments ? { attachments: attachments } : {}) %>
  <div class="relative">
    <%= f.label :text, "Message #{agent_name}", class: "sr-only" %>
    <%= f.text_area :text, value: text, rows: 2, maxlength: AgentMessages::WebIngest::MAX_LENGTH, required: true,
                    placeholder: "Message #{agent_name}…", autocomplete: "off",
                    class: "block w-full min-w-0 resize-none bg-transparent px-3 pt-2 pb-12 text-base text-heading placeholder:text-muted focus:outline-none",
                    data: { test: "cto-chat-input" } %>
    <%= f.button type: "submit", class: "absolute bottom-1 right-1 inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary text-white disabled:opacity-40",
                 "aria-label": "Send to #{agent_name}", data: { test: "cto-chat-send" } do %>
      <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 19V5M5 12l7-7 7 7"/>
      </svg>
    <% end %>
  </div>
<% end %>
