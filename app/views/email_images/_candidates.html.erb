<%# THE CANDIDATE GRID: every header this brief has generated, newest first,
    each with its provenance, its cost in the vendor's own unit (a nil cost is
    unpriced, never free), and Approve / Retire. The approved one is badged;
    retired ones stay visible, dimmed, so a round's misses remain on record.

    locals: (brief:, candidates:, preview_artifact:) %>
<% if candidates.any? %>
  <div class="grid gap-3 sm:grid-cols-2" data-test="candidate-grid">
    <% candidates.each do |artifact| %>
      <% approved = brief.approved_artifact_slug == artifact.slug %>
      <figure data-test="candidate" data-slug="<%= artifact.slug %>"
              data-state="<%= approved ? 'approved' : (artifact.retired? ? 'retired' : 'live') %>"
              class="rounded-lg border overflow-hidden bg-surface <%= approved ? 'border-success/60 ring-2 ring-success/30' : 'border-subtle' %> <%= 'opacity-50' if artifact.retired? %>">
        <%= link_to email_image_path(brief, candidate: artifact.slug), class: "block bg-surface-alt aspect-[2/1]",
                    title: "Preview in the email" do %>
          <%= image_tag artifact.image_url, alt: brief.effective_alt_text, width: 600, height: 300,
                        class: "w-full h-full object-cover", loading: "lazy" %>
        <% end %>
        <figcaption class="p-2 space-y-1.5">
          <div class="flex items-center gap-1 flex-wrap">
            <% if approved %>
              <span data-test="approved-badge" class="badge text-3xs bg-success/10 text-success-ink border-success/40">approved</span>
            <% elsif artifact.retired? %>
              <span class="badge text-3xs bg-surface-alt text-muted border-subtle">retired</span>
            <% end %>
            <% if preview_artifact&.slug == artifact.slug %>
              <span class="badge text-3xs bg-primary/10 text-primary border-primary/40">in preview</span>
            <% end %>
            <span class="text-3xs text-muted font-mono ml-auto"><%= artifact.created_at.strftime("%b %-d %H:%M") %></span>
          </div>
          <dl data-test="candidate-provenance" class="text-3xs space-y-0.5">
            <div class="flex gap-1 min-w-0">
              <dt class="text-muted shrink-0">by</dt>
              <dd class="text-body font-medium break-all"><%= artifact.provenance_label.presence || "unrecorded" %></dd>
            </div>
            <div class="flex gap-1 min-w-0">
              <dt class="text-muted shrink-0">cost</dt>
              <dd class="text-muted font-mono break-all"><%= artifact.billing_summary.presence || "not reported" %><%= " · unpriced" if artifact.cost_usd.nil? && artifact.billable_units.present? %></dd>
            </div>
          </dl>
          <div class="flex gap-1.5 flex-wrap">
            <% unless approved %>
              <%= button_to "Approve", approve_candidate_email_image_path(brief, artifact_slug: artifact.slug),
                            class: "btn btn-sm btn-primary", form: { data: { test: "approve-form" } } %>
            <% end %>
            <% unless artifact.retired? %>
              <%= button_to "Retire", retire_candidate_email_image_path(brief, artifact_slug: artifact.slug),
                            class: "btn btn-sm btn-neutral", form: { data: { test: "retire-form" } } %>
            <% end %>
          </div>
        </figcaption>
      </figure>
    <% end %>
  </div>
<% else %>
  <div data-test="no-candidates" class="rounded-lg border border-dashed border-subtle bg-surface-alt p-4 text-center">
    <p class="text-2xs text-muted">No candidates yet. Generate a round.</p>
  </div>
<% end %>
