<%# A clip with a primary version: the source chunk and the primary side by side (stacked on a phone), each on its first frame, and Play both under them. Play both runs the two from the start together with the original muted, so the only sound is the version's; clipPair() keeps them together (pause, seek and drift) and drives the one scrub. Making another version primary re-renders the card, so the right-hand player follows. A player whose signed link has lapsed asks the page for a fresh one (signedLinks, music_videos/_player_scripts) and says so while it waits; only a player that fails on a fresh link says its file did not load. %>
<div class="p-4 pb-0 min-w-0" x-data="clipPair()" data-test="clip-compare" data-primary="<%= primary.number %>"
     :data-state="state">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
    <figure class="min-w-0" data-test="clip-compare-original">
      <figcaption class="label-upper mb-1.5">Original</figcaption>
      <div class="relative bg-inset aspect-video rounded-lg overflow-hidden" data-test="clip-preview" data-key="<%= chunk.object_key %>">
        <video x-ref="original" src="<%= first_frame_src(url) %>" controls playsinline preload="metadata"
               class="absolute inset-0 w-full h-full bg-black" data-test="clip-player" data-signed-key="<%= chunk.object_key %>"
               @error="lost('original')"></video>
        <p x-show="renewing.original" x-cloak class="absolute bottom-0 inset-x-0 p-2 text-xs text-center bg-surface/90 text-body"
           data-test="clip-link-refreshing">This link expired: getting a fresh one…</p>
        <p x-show="failed.original" x-cloak class="absolute bottom-0 inset-x-0 p-2 text-xs text-center bg-surface/90 text-warning-ink"
           data-test="clip-load-failed">The source chunk did not load: <%= chunk.object_key.split("/").last %></p>
      </div>
    </figure>
    <figure class="min-w-0" data-test="clip-compare-version" data-number="<%= primary.number %>" data-key="<%= primary.object_key %>">
      <figcaption class="label-upper mb-1.5"><%= primary.name %> <span class="normal-case tracking-normal">(primary)</span></figcaption>
      <div class="relative bg-inset aspect-video rounded-lg overflow-hidden">
        <video x-ref="version" src="<%= first_frame_src(version_url) %>" controls playsinline preload="metadata"
               class="absolute inset-0 w-full h-full bg-black" data-test="clip-version-player" data-signed-key="<%= primary.object_key %>"
               @error="lost('version')"></video>
        <p x-show="renewing.version" x-cloak class="absolute bottom-0 inset-x-0 p-2 text-xs text-center bg-surface/90 text-body"
           data-test="clip-version-link-refreshing">This link expired: getting a fresh one…</p>
        <p x-show="failed.version" x-cloak class="absolute bottom-0 inset-x-0 p-2 text-xs text-center bg-surface/90 text-warning-ink"
           data-test="clip-version-load-failed"><%= primary.name %> did not load: <%= primary.object_key.split("/").last %></p>
      </div>
    </figure>
  </div>

  <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mt-3 min-w-0">
    <button type="button" @click="toggle()" class="btn btn-primary btn-sm shrink-0" data-test="clip-play-both">
      <svg x-show="state !== 'playing'" class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
      <svg x-show="state === 'playing'" x-cloak class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M6 5h4v14H6zM14 5h4v14h-4z"/></svg>
      <span x-text="label">Play both</span>
    </button>
    <button type="button" x-show="state === 'paused'" x-cloak @click="start()" class="btn btn-outline btn-sm shrink-0" data-test="clip-play-both-restart">
      From the start
    </button>
    <label class="sr-only" for="clip-scrub-<%= clip.chunk_ordinal %>">Scrub both players</label>
    <input id="clip-scrub-<%= clip.chunk_ordinal %>" type="range" min="0" step="0.01" :max="duration || 0" :value="t"
           :disabled="!duration" @input="scrub($event.target.value)"
           class="flex-1 min-w-[8rem] accent-primary" data-test="clip-scrub">
    <span class="text-xs text-muted font-mono tabular-nums shrink-0" data-test="clip-scrub-time"
          x-text="fmt(t) + ' / ' + fmt(duration)">0:00 / 0:00</span>
  </div>
  <p class="text-xs text-muted mt-1" data-test="clip-play-both-note">
    Sound from <%= primary.name %> only: the original plays muted.
  </p>
  <p x-show="blocked" x-cloak class="text-xs text-warning-ink mt-1" data-test="clip-play-both-blocked">
    This browser would not start both players; press play on each, or open the files from the versions list.
  </p>
</div>
