<%# The players and controls the cast page and the alt video page share: a clip row's lazy preview and prompt copy, the full-video player that plays clips back to back as if stitched, a stitch's progress poll, and a clip's drop zone. Rendered once per page. %>
<script>
  // One clip row: load the signed clip only when asked, and copy its prompt.
  window.clipRow = function () {
    return {
      open: false, failed: false, copied: false, manual: false,
      preview() {
        const player = this.$refs.player;
        player.src = this.$root.dataset.src;
        this.open = true;
        player.play().catch(() => {});
      },
      async copy() {
        const ok = await window.copyText(this.$refs.prompt.textContent.trim());
        if (ok === false) { this.selectPrompt(); this.manual = true; return; }
        this.copied = true; this.manual = false;
        setTimeout(() => { this.copied = false; }, 1400);
      },
      selectPrompt() {
        const range = document.createRange();
        range.selectNodeContents(this.$refs.prompt);
        const selection = window.getSelection();
        selection.removeAllRanges();
        selection.addRange(range);
      },
    };
  };

  // A copy control for one piece of text on a clip card (its slug, a TikTok
  // caption): copies the x-ref="text" element's text, or selects it so the
  // operator can copy it by hand when the browser blocks the clipboard.
  window.copyField = function () {
    return {
      copied: false, manual: false,
      async copy() {
        const ok = await window.copyText(this.$refs.text.textContent.trim());
        if (ok === false) {
          const range = document.createRange();
          range.selectNodeContents(this.$refs.text);
          const selection = window.getSelection();
          selection.removeAllRanges();
          selection.addRange(range);
          this.manual = true;
          return;
        }
        this.copied = true; this.manual = false;
        setTimeout(() => { this.copied = false; }, 1400);
      },
    };
  };

  // An alt video clip's players: the source chunk (x-ref original) and, once
  // the clip has a primary version, that version (x-ref version) beside it.
  // Each opens on its first frame: preload="metadata" fetches only the head
  // of the file, the src's #t=0.001 fragment (first_frame_src) starts it a
  // millisecond in, and a browser that ignores the fragment is seeked there
  // here, which is what makes it paint frame 1 instead of a black box.
  //
  // Play both: both from the start, the original MUTED so the only sound is
  // the version's. From then on the two are linked: play, pause or seek
  // either (its own controls or the shared scrub) and the other follows. The
  // version is the clock; while playing, the original is nudged back onto it
  // (playback rate 0.95/1.05 past 40 ms, about a frame; a hard seek past
  // 100 ms, which also closes the head start one player gets at Play both), so they stay within a frame or two.
  window.clipPair = function () {
    const NUDGE = 0.04, JUMP = 0.1, SEEK_LEAD = 0.05;
    return {
      linked: false, started: false, playing: false, blocked: false,
      t: 0, duration: 0, frame: null, failed: { original: false, version: false },
      get pair() { return [this.$refs.original, this.$refs.version].filter(Boolean); },
      get state() { return this.playing ? "playing" : (this.linked ? "paused" : "idle"); },
      get label() { return this.playing ? "Pause both" : (this.linked ? "Resume both" : "Play both"); },
      init() {
        this.pair.forEach((video) => {
          const firstFrame = () => {
            if (video.paused && video.currentTime === 0) video.currentTime = 0.001;
            this.measure();
          };
          if (video.readyState >= 1) firstFrame();
          video.addEventListener("loadedmetadata", firstFrame);
          video.addEventListener("play", () => { this.started = true; this.follow(video, "play"); });
          video.addEventListener("pause", () => this.follow(video, "pause"));
          video.addEventListener("seeking", () => { if (performance.now() > (video.__quietUntil || 0)) this.follow(video, "seek"); });
        });
      },
      destroy() { cancelAnimationFrame(this.frame); },
      // A seek made here (start, scrub, a peer following, a drift fix) is not
      // the operator's: its seeking event must not move the other player, or
      // fixing the muted original would drag the version's sound along.
      seekTo(video, at) {
        video.__quietUntil = performance.now() + 400;
        video.currentTime = at;
      },
      other(video) { return video === this.$refs.original ? this.$refs.version : this.$refs.original; },
      measure() {
        const lengths = this.pair.map((v) => v.duration).filter(Number.isFinite);
        this.duration = lengths.length ? Math.max(...lengths) : 0;
      },
      fmt(seconds) {
        const s = Math.floor(Number(seconds) || 0);
        return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
      },
      // One player moved; while linked, the other does the same. Every branch
      // is a no-op when the other is already there, so the echo stops at once.
      follow(video, what) {
        if (!this.linked) return;
        const peer = this.other(video);
        if (!peer) return;
        if (what === "play") {
          if (Math.abs(peer.currentTime - video.currentTime) > NUDGE) this.seekTo(peer, video.currentTime);
          if (peer.paused && !peer.ended) peer.play().catch(() => {});
          this.playing = true;
          this.loop();
        } else if (what === "pause") {
          // A shorter original holds its last frame while the version plays on.
          if (video === this.$refs.original && video.ended) return;
          if (!peer.paused) peer.pause();
          this.playing = false;
        } else if (what === "seek") {
          if (Math.abs(peer.currentTime - video.currentTime) > NUDGE) this.seekTo(peer, video.currentTime);
          this.t = video.currentTime;
        }
      },
      // Play both from the start: the original muted, sound from the version.
      start() {
        const [original, version] = [this.$refs.original, this.$refs.version];
        if (!original || !version) return;
        this.linked = true; this.blocked = false; this.started = true;
        original.muted = true;
        version.muted = false;
        original.playbackRate = 1;
        this.seekTo(original, 0); this.seekTo(version, 0); this.t = 0;
        this.playing = true;
        Promise.all([original.play(), version.play()]).catch(() => { this.blocked = true; this.pause(); });
        this.loop();
      },
      resume() {
        const [original, version] = [this.$refs.original, this.$refs.version];
        original.muted = true;
        if (version.ended) { this.start(); return; }
        this.seekTo(original, version.currentTime);
        this.playing = true;
        Promise.all([original.play(), version.play()]).catch(() => { this.blocked = true; this.pause(); });
        this.loop();
      },
      pause() {
        this.playing = false;
        cancelAnimationFrame(this.frame);
        this.pair.forEach((v) => { if (!v.paused) v.pause(); });
      },
      toggle() {
        if (this.playing) this.pause();
        else if (this.linked) this.resume();
        else this.start();
      },
      scrub(value) {
        const at = Number(value);
        this.t = at;
        this.pair.forEach((v) => this.seekTo(v, Number.isFinite(v.duration) ? Math.min(at, v.duration) : at));
      },
      // Single preview (no version yet): play the source chunk.
      playOriginal() {
        this.started = true;
        this.$refs.original.play().catch(() => {});
      },
      // While playing: keep the original on the version's clock.
      loop() {
        cancelAnimationFrame(this.frame);
        const step = () => {
          const [original, version] = [this.$refs.original, this.$refs.version];
          if (!this.playing || !version) return;
          this.t = version.currentTime;
          if (!original.paused && !original.ended && !original.seeking && !version.seeking) {
            const drift = original.currentTime - version.currentTime;
            // Aim a little ahead: the seek itself takes a few frames.
            if (Math.abs(drift) > JUMP) this.seekTo(original, version.currentTime + SEEK_LEAD);
            else if (Math.abs(drift) > NUDGE) original.playbackRate = drift > 0 ? 0.95 : 1.05;
            else if (original.playbackRate !== 1) original.playbackRate = 1;
          }
          this.frame = requestAnimationFrame(step);
        };
        this.frame = requestAnimationFrame(step);
      },
    };
  };

  // Watch full video: plays an alt video's clips back to back as if stitched,
  // without a stitched file. The server sends when each clip is on screen
  // (MusicVideos::StitchTimeline: handover at the middle of each overlap) and
  // the file it plays (its primary version, else the source chunk). The source
  // audio is the clock; the two muted videos follow it, one on screen and one
  // holding the next clip ready. Built when the modal opens, torn down (and
  // paused) when it closes, so nothing loads while the page is only read.
  window.stitchPreview = function () {
    return {
      segments: [], durationMs: 0, t: 0, index: 0, active: 0, playing: false, audioOk: true,
      frame: null, wallBase: 0, wallAt: 0, failed: [false, false],
      init() {
        const data = JSON.parse(this.$root.dataset.timeline);
        this.segments = data.segments; this.durationMs = data.duration_ms;
        this.audioOk = !!this.$refs.audio.getAttribute("src");
        if (this.segments.length) this.show(0);
      },
      destroy() { this.pause(); },
      get now() { return this.segments[this.index] || null; },
      get missing() { return !!this.now && !this.now.url; },
      get nowLabel() { return this.now ? "Clip " + this.now.ordinal + " · " + this.now.label : ""; },
      fmt(ms) {
        const s = Math.floor(ms / 1000);
        return Math.floor(s / 60) + ":" + String(s % 60).padStart(2, "0");
      },
      // The video clock in ms: the source audio while it plays, else a timer.
      clock() {
        if (this.audioOk) return this.$refs.audio.currentTime * 1000;
        return this.wallBase + (performance.now() - this.wallAt);
      },
      startWall() { this.wallBase = this.t; this.wallAt = performance.now(); },
      audioFailed() { this.audioOk = false; this.startWall(); },
      // A video whose file would not load (an expired link, a format the browser cannot play).
      loadFailed(which) { if ([this.$refs.a, this.$refs.b][which].getAttribute("src")) this.failed[which] = true; },
      // The last segment that has started by ms.
      indexAt(ms) {
        let found = 0;
        this.segments.forEach((seg, i) => { if (ms >= seg.from_ms) found = i; });
        return found;
      },
      // Point one video at a segment's file, at the frame the clock ms falls on:
      // the offset comes from the chunk's recorded start, never the file's length.
      cue(video, seg, ms, exact = false) {
        if (!seg.url) { video.dataset.ordinal = ""; video.removeAttribute("src"); video.load(); return; }
        if (video.dataset.ordinal !== String(seg.ordinal)) {
          video.dataset.ordinal = String(seg.ordinal);
          this.failed[video === this.$refs.a ? 0 : 1] = false;
          video.src = seg.url;
        }
        let want = Math.max(0, (ms - seg.start_ms) / 1000);
        if (Number.isFinite(video.duration)) want = Math.min(want, Math.max(0, video.duration - 0.05));
        // A file shorter than its window has run out: hold its last frame.
        if (video.ended && want >= video.duration - 0.1) return;
        const off = Math.abs(video.currentTime - want);
        if (video.paused || exact) { if (off > 0.03) video.currentTime = want; return; }
        // Playing: pull a drifting video back onto the clock, at most once a second,
        // aiming a little ahead to cover the seek itself.
        const now = performance.now();
        if (off > 0.2 && !video.seeking && now - Number(video.dataset.syncedAt || 0) > 1000) {
          video.dataset.syncedAt = String(now);
          video.currentTime = want + 0.1;
        }
      },
      // Put segment i on screen and load the one after it into the other video.
      show(i) {
        const seg = this.segments[i], next = this.segments[i + 1];
        const pair = [this.$refs.a, this.$refs.b];
        if (pair[1 - this.active].dataset.ordinal === String(seg.ordinal)) this.active = 1 - this.active;
        const front = pair[this.active], back = pair[1 - this.active];
        const handover = i !== this.index;
        this.index = i;
        this.cue(front, seg, this.t, handover);
        back.pause();
        if (this.playing && seg.url) front.play().catch(() => {});
        if (next) this.cue(back, next, next.from_ms);
      },
      tick() {
        if (!this.playing) return;
        this.t = Math.min(this.clock(), this.durationMs);
        if (this.t >= this.durationMs) { this.pause(); return; }
        const i = this.indexAt(this.t);
        if (i !== this.index) this.show(i);
        else if (this.now.url) this.cue([this.$refs.a, this.$refs.b][this.active], this.now, this.t);
        this.frame = requestAnimationFrame(() => this.tick());
      },
      play() {
        if (!this.segments.length || this.playing) return;
        if (this.t >= this.durationMs) this.seek(0);
        this.playing = true;
        this.startWall();
        if (this.audioOk) {
          this.$refs.audio.currentTime = this.t / 1000;
          this.$refs.audio.play().catch(() => this.audioFailed());
        }
        this.show(this.index);
        this.frame = requestAnimationFrame(() => this.tick());
      },
      pause() {
        this.playing = false;
        cancelAnimationFrame(this.frame);
        this.$refs.audio.pause(); this.$refs.a.pause(); this.$refs.b.pause();
      },
      toggle() { this.playing ? this.pause() : this.play(); },
      seek(ms) {
        if (!this.segments.length) return;
        this.t = Math.min(Math.max(0, ms), this.durationMs);
        if (this.audioOk) this.$refs.audio.currentTime = this.t / 1000;
        this.startWall();
        this.show(this.indexAt(this.t));
      },
    };
  };

  // A stitch that is waiting or running: ask the server every few seconds
  // whether it has moved on, and offer the reload when it has. Never reloads
  // on its own: the operator may be mid-upload further down the page.
  window.stitchProgress = function () {
    return {
      timer: null, changed: false, lost: false,
      init() { this.timer = setInterval(() => this.check(), 4000); },
      destroy() { clearInterval(this.timer); },
      async check() {
        try {
          const resp = await fetch(this.$root.dataset.statusUrl, { headers: { Accept: "application/json" } });
          if (!resp.ok) throw new Error(String(resp.status));
          const body = await resp.json();
          this.lost = false;
          if (body.state !== this.$root.dataset.state) { this.changed = true; clearInterval(this.timer); }
        } catch (e) { this.lost = true; }
      },
    };
  };

  // A clip's drop zone: drop the generated MP4 (or pick it) and it uploads at
  // once as the clip's next version. The size and type are checked here first,
  // so a 300 MB file or a .mov is refused before a byte is sent; the server
  // checks again (MusicVideos::StoreClipVersion).
  window.clipDrop = function () {
    return {
      over: false, busy: false, error: "",
      pick() { if (!this.busy) this.$refs.file.click(); },
      dropped(event) {
        this.over = false;
        if (this.busy) return;
        this.send(event.dataTransfer.files, true);
      },
      chosen() { this.send(this.$refs.file.files, false); },
      send(files, fromDrop) {
        const max = Number(this.$root.dataset.maxBytes);
        if (!files || files.length === 0) return;
        if (files.length > 1) { this.error = "Drop one MP4 at a time."; return; }
        const file = files[0];
        if (!/\.mp4$/i.test(file.name)) { this.error = "That file is not an MP4."; return; }
        if (file.size === 0) { this.error = "That file is empty."; return; }
        if (file.size > max) { this.error = "That MP4 is over " + Math.round(max / 1048576) + " MB."; return; }
        if (fromDrop) {
          const carry = new DataTransfer();
          carry.items.add(file);
          this.$refs.file.files = carry.files;
        }
        this.error = ""; this.busy = true;
        this.$root.requestSubmit();
      },
    };
  };
</script>
