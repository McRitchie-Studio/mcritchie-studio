<%# "Cyvasse is back": the relaunch note to the players imported from the old
    Cyvasse (task cyvasse-is-back-outreach). Mostly text and one button, so it
    reads as a letter rather than a promotion. Both links are tracked
    (Broadcast::TEMPLATE_LINKS); the newsletter opt-in page comes with the
    outreach task. %>
<% play_url  = broadcast_link(:play,  Broadcast::TEMPLATE_LINKS["cyvasse_is_back"]["play"]) %>
<% build_url = broadcast_link(:build, Broadcast::TEMPLATE_LINKS["cyvasse_is_back"]["build"]) %>
<% content_for :email_reason, "You&rsquo;re receiving this because you have an account on Cyvasse.".html_safe %>
<%= render "broadcasts/email_head",
      hero_file: "cyvasse_header_live.jpg",
      hero_alt:  "A Cyvasse board mid-game: a horse lines up its double jump",
      preheader: "Live matches, a leaderboard, and your old account came across. Hit Play Now.",
      title:     "Cyvasse is back",
      subtitle:  "Same board, same pieces &mdash; rebuilt, and your account came with it." %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:28px 32px 8px 32px;">
      <p style="margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;">Hi <%= broadcast_greeting_name %>,</p>
      <p style="margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;">You played Cyvasse with us a while back &mdash; the hex-board strategy game from <em>A Song of Ice and Fire</em>. Together, players on the old site played more than 100,000 matches.</p>
      <p style="margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;">I&rsquo;ve rebuilt it from the ground up, and it&rsquo;s live again &mdash; with <strong>live matches</strong>. Hit <strong>Play Now</strong> and you&rsquo;re paired with whoever else is looking for a game: 60 seconds to set up your army, 30 seconds a move. No one around? A computer opponent steps in.</p>
      <p style="margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;">Win and you&rsquo;re on the <strong>leaderboard</strong>. Your old account, matches and saved lineups all came across, so sign in and pick up where you left off.</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">A few rules got sharper, too: trebuchets now reach four hexes, and a king can finally strike down a dragon that strays too close.</p>
    </td>
  </tr>

  <tr>
    <td style="padding:22px 32px 8px 32px;text-align:center;">
      <%= render "broadcasts/button", url: play_url, label: "Play Now &rarr;".html_safe, color: "#7c3aed", full_width: true %>
    </td>
  </tr>

  <tr>
    <td style="padding:20px 32px 8px 32px;">
      <p style="margin:0 0 4px 0;font-size:16px;line-height:1.65;color:#2b3440;">See you on the board.</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">&mdash; Alex</p>
    </td>
  </tr>

  <tr>
    <td style="padding:14px 32px 28px 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #eef1f4;">
        <tr><td style="padding-top:16px;font-size:13px;line-height:1.6;color:#94a3b8;"><strong style="color:#64748b;">P.S.</strong> Cyvasse is built at McRitchie Studio, where we turn an idea into a working app. Got one of your own? <a href="<%= build_url %>" style="color:#7c3aed;font-weight:700;text-decoration:none;">Describe it and we&rsquo;ll build it &rarr;</a></td></tr>
      </table>
    </td>
  </tr>
</table>
