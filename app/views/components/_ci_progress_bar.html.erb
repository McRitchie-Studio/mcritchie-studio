<%# locals: (progress:, label: "CI", title: nil, test_id: "ci-progress-bar", compact: false) %>
<%#
  Numeric CI meter (12+ checks): "X / Y checks" plus the state-coloured track
  (components/_ci_progress_track). A pure view of a Ci::CheckProgress value object,
  coloured by state — emerald all-passed, amber running, red on a failure. The
  symbolic view (under 12 checks) uses components/_ci_progress_symbols instead, over
  the same track. Renders NOTHING when there is no CI data.
%>
<% if progress.respond_to?(:present?) && progress.present? %>
  <% text_class = case progress.state
     when :green then "text-emerald-700 dark:text-emerald-300"
     when :red then "text-red-700 dark:text-red-300"
     else "text-amber-700 dark:text-amber-300"
     end %>
  <% bar_title = title.presence ||
       "GitHub CI: #{progress.passed} of #{progress.total} checks passed" +
       (progress.failed.positive? ? ", #{progress.failed} failed" : "") +
       (progress.pending.positive? ? ", #{progress.pending} running" : "") %>
  <div class="ci-progress-bar w-full space-y-1"
       data-test="<%= test_id %>"
       data-ci-state="<%= progress.state %>"
       title="<%= bar_title %>">
    <div class="flex items-center justify-between gap-2 text-[10px] leading-none">
      <span class="font-semibold uppercase tracking-wide text-muted"><%= label %></span>
      <span class="font-bold tabular-nums <%= text_class %>" data-test="<%= test_id %>-fraction">
        <%= progress.fraction_label %><span class="ml-1 font-medium text-muted normal-case tracking-normal">checks</span>
      </span>
    </div>
    <%= render "components/ci_progress_track", progress: progress, test_id: test_id, compact: compact %>
  </div>
<% end %>
