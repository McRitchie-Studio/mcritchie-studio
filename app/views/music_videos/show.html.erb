<% content_for :title, "#{@video.title} · Cast · McRitchie Studio" %>
<script>
  // What both cast-card typeaheads share: a debounced search whose answer is
  // dropped once a newer search or a pick has superseded it, and the list keys.
  window.typeaheadSearch = function () {
    return {
      query: "", results: [], open: false, loading: false, failed: false, active: -1, seq: 0, picked: null,
      async search() {
        const q = this.query.trim();
        // The debounce of the keystrokes before a pick fires after it: the pick stands.
        if (this.picked !== null && this.query === this.picked) return;
        const seq = ++this.seq;
        this.picked = null;
        this.reset();
        if (q.length === 0) { this.results = []; this.open = false; this.loading = false; return; }
        this.loading = true; this.failed = false;
        let results = [], failed = false;
        try {
          const resp = await fetch(this.$root.dataset.searchUrl + "?q=" + encodeURIComponent(q),
                                   { headers: { Accept: "application/json" } });
          if (!resp.ok) throw new Error(String(resp.status));
          results = await resp.json();
        } catch (e) { failed = true; }
        // An older answer never repaints or reopens the list.
        if (seq !== this.seq) return;
        this.results = results; this.failed = failed; this.active = results.length ? 0 : -1;
        this.loading = false; this.open = true;
      },
      move(step) {
        if (!this.open || this.results.length === 0) return;
        this.active = (this.active + step + this.results.length) % this.results.length;
      },
      pickActive() { if (this.open && this.results[this.active]) this.choose(this.results[this.active]); },
      // A pick: name the input after it, close the list, and void any search in flight.
      settle(r) { this.seq++; this.loading = false; this.picked = r.name; this.query = r.name; this.open = false; },
    };
  };

  // Who is on screen, at the bottom of a cast card: an always-open search of
  // artists and People. A pick, a new artist, Mark as extra or Clear saves at
  // once as JSON (no reload). Each says the whole answer, so a change made while
  // one is in flight replaces any still waiting and the server ends on the last.
  // Each save tells the card (naming-saved): the header badge and swapCard's
  // "Swap with <name>?" offer follow it.
  window.namingCard = function () {
    return {
      ...window.typeaheadSearch(),
      named: null, creating: false, newName: "", newKind: "person",
      save: "", error: "", inflight: false, queued: null, lastBody: null,
      init() { const d = this.$root.dataset; this.named = d.named ? JSON.parse(d.named) : null; },
      reset() { this.creating = false; },
      get exactMatch() {
        const q = this.query.trim().toLowerCase();
        return this.results.some((r) => r.name.toLowerCase() === q);
      },
      choose(r) {
        this.settle(r); this.query = ""; this.creating = false;
        this.named = { kind: "artist", slug: r.type === "artist" ? r.slug : "", name: r.name, avatar_url: r.avatar_url, vocation: r.vocation, team: r.team };
        this.persist(r.type === "artist" ? { artist_slug: r.slug } : { person_slug: r.slug });
      },
      startCreate() { this.newName = this.query.trim(); this.open = false; this.creating = true; },
      createArtist() {
        const name = this.newName.trim();
        if (!name) return;
        this.creating = false; this.query = "";
        this.named = { kind: "artist", slug: "", name, vocation: this.newKind === "group" ? "group" : "musician" };
        this.persist({ new_artist_name: name, new_artist_kind: this.newKind });
      },
      markExtra() { this.named = { kind: "extra" }; this.persist({ extra: "1" }); },
      clear() { this.named = null; this.persist({ clear: "1" }); },
      persist(body) {
        this.lastBody = body; this.save = "saving"; this.error = "";
        if (this.inflight) { this.queued = body; return; }
        this.send(body);
      },
      retry() { if (this.lastBody && !this.inflight) this.send(this.lastBody); },
      async send(body) {
        this.inflight = true;
        let ok = false;
        try {
          const token = document.querySelector("meta[name='csrf-token']");
          const resp = await fetch(this.$root.dataset.saveUrl, {
            method: "PATCH", credentials: "same-origin",
            headers: { "Content-Type": "application/json", Accept: "application/json", "X-CSRF-Token": token ? token.content : "" },
            body: JSON.stringify(body),
          });
          const json = (resp.headers.get("Content-Type") || "").includes("json") ? await resp.json() : {};
          if (!resp.ok || !("named" in json)) throw new Error(json.error || "The server answered " + resp.status + ".");
          if (!this.queued) {
            this.named = json.named;
            window.dispatchEvent(new CustomEvent("naming-saved",
              { detail: { ordinal: Number(this.$root.dataset.ordinal), named: json.named, offer: json.offer } }));
          }
          ok = true;
        } catch (e) {
          this.error = e.message && e.message !== "Failed to fetch" ? e.message : "The connection dropped.";
        }
        this.inflight = false;
        if (this.queued) { const next = this.queued; this.queued = null; return this.send(next); }
        this.save = ok ? "saved" : "failed";
        if (ok) window.refreshCastOutputs();
      },
    };
  };

  // The look step of "Replaced by": a listbox of the athlete's looks, a
  // preview of the one picked, and the generate form. Mixed into swapCard,
  // which saves each pick (onLookPicked). While a look's character sheet is
  // building, the rows are polled and repainted in place.
  window.lookPicker = function () {
    return {
      athlete: null, lookSlug: "", listOpen: false, lookActive: 0, genOpen: false, genBusy: false, lookTimer: null,
      destroy() { clearTimeout(this.lookTimer); },
      get looks() { return this.athlete ? this.athlete.looks : []; },
      get chosen() { return this.looks.find((l) => l.slug === this.lookSlug) || null; },
      // Sheets building on looks other than the one previewed, by name.
      get buildingElsewhere() {
        return this.looks.filter((l) => l.state === "building" && l.slug !== this.lookSlug).map((l) => l.descriptor).join(", ");
      },
      // The athlete's own page, where a look can be added by hand; it knows the way back.
      get newLookUrl() {
        return this.athlete ? this.$root.dataset.newLookUrl.replace("__slug__", encodeURIComponent(this.athlete.slug)) : "#";
      },
      // Shown first: the preferred look (just generated, or saved), else the default, else the first.
      setAthlete(athlete, preferred) {
        this.athlete = athlete;
        const first = athlete.looks.find((l) => l.slug === preferred) || athlete.looks.find((l) => l.default) || athlete.looks[0];
        this.lookSlug = first ? first.slug : "";
        this.listOpen = false; this.genBusy = false; this.genOpen = athlete.looks.length === 0;
        this.watchBuilds();
      },
      clearAthlete() { clearTimeout(this.lookTimer); this.athlete = null; this.lookSlug = ""; this.listOpen = false; this.genOpen = false; },
      stateLabel(look) {
        if (look.state === "building") return "Character sheet building…";
        if (look.state === "failed") return "Sheet build failed";
        return look.state === "ready" ? "Character sheet ready" : "No character sheet yet";
      },
      emptyPreview(look) {
        if (look.state === "building") return "Building the character sheet. It takes about two minutes; this card updates itself.";
        if (look.state === "failed") return "The last sheet build failed" + (look.error ? ": " + look.error : ".") + " Retry it from the look's page.";
        if (look.state === "ready") return "The character sheet image could not be loaded.";
        return "No character sheet yet. Build one from the look's page.";
      },
      openList() {
        this.listOpen = true;
        this.showRow(Math.max(0, this.looks.findIndex((l) => l.slug === this.lookSlug)));
      },
      closeList() { this.listOpen = false; },
      // The rows are the looks, then "Generate a new look".
      moveLook(step) { const n = this.looks.length + 1; this.showRow((this.lookActive + step + n) % n); },
      showRow(i) {
        this.lookActive = i;
        this.$nextTick(() => setTimeout(() => {
          const row = this.$refs.lookList.querySelectorAll("[role='option']")[i];
          if (row) row.scrollIntoView({ block: "nearest" });
        }));
      },
      pickRow(i) {
        this.closeList(); this.$refs.lookTrigger.focus();
        if (i >= this.looks.length) return this.startGenerate();
        this.lookSlug = this.looks[i].slug; this.genOpen = false;
        this.onLookPicked();
      },
      // x-show paints on a timeout, so the focus waits one too.
      startGenerate() { this.genOpen = true; this.$nextTick(() => setTimeout(() => this.$refs.genName.focus())); },
      watchBuilds() {
        clearTimeout(this.lookTimer);
        if (this.looks.some((l) => l.state === "building")) this.lookTimer = setTimeout(() => this.refreshLooks(), 5000);
      },
      async refreshLooks() {
        const slug = this.athlete && this.athlete.slug;
        if (!slug) return;
        try {
          const resp = await fetch(this.$root.dataset.looksUrl.replace("__slug__", encodeURIComponent(slug)),
                                   { headers: { Accept: "application/json" } });
          if (resp.ok) {
            const rows = await resp.json();
            if (this.athlete && this.athlete.slug === slug) this.athlete.looks = rows;
          }
        } catch (e) { /* the next poll tries again */ }
        this.watchBuilds();
      },
    };
  };

  // Accessors survive (an object spread would flatten each getter to its first value).
  window.mixComponents = function (...parts) {
    return parts.reduce((mixed, part) => Object.defineProperties(mixed, Object.getOwnPropertyDescriptors(part)), {});
  };

  // After a recast saves, the prompts, swap targets and hand-offs below were
  // rewritten on the server: fetch the page again and swap in those sections
  // (Alpine starts the new nodes itself). Only the newest refresh paints.
  window.refreshCastOutputs = (function () {
    let seq = 0;
    return async function () {
      const mine = ++seq;
      try {
        const resp = await fetch(window.location.pathname + window.location.search, { headers: { Accept: "text/html" } });
        if (!resp.ok || mine !== seq) return;
        const doc = new DOMParser().parseFromString(await resp.text(), "text/html");
        if (mine !== seq) return;
        ["cast-progress", "clips-panel", "chunks-panel"].forEach((name) => {
          const fresh = doc.querySelector("[data-test='" + name + "']");
          const old = document.querySelector("[data-test='" + name + "']");
          if (fresh && old) old.replaceWith(document.importNode(fresh, true));
        });
      } catch (e) { /* the page still shows the last render; a reload brings it up to date */ }
    };
  })();

  // The swap on one cast card, rooted over the whole card body: the Replace with
  // search, the chosen athlete and the look picker near the top, and the Keep
  // Original / Swap back button pinned at the bottom. Picking a person is the swap; Keep
  // Original turns it off and remembers them. Every change is saved at once as
  // JSON to the recast endpoint, one request at a time and in the order made,
  // so the server always ends where the card does. A pick or a Clear says the
  // whole recast, so it drops any change still waiting behind the one in
  // flight; Keep Original and its undo are relative, so they queue behind it.
  // The card shows a change at once; the save state says whether the server
  // has it, with Retry (which resends the stalled change and whatever followed).
  window.swapCard = function () {
    return window.mixComponents(window.typeaheadSearch(), window.lookPicker(), {
      keep: false, offer: null, savedPerson: "", savedLook: "", save: "", error: "",
      inflight: false, queue: [],
      init() {
        const data = this.$root.dataset;
        this.savedPerson = data.savedPerson || ""; this.savedLook = data.savedLook || "";
        this.offer = data.offer ? JSON.parse(data.offer) : null;
        if (data.athlete) {
          this.keep = data.keep === "true";
          this.setAthlete(JSON.parse(data.athlete), data.freshLook || this.savedLook);
          // An athlete saved with no look: nothing is previewed as if it were cast.
          if (!this.savedLook && !data.freshLook) this.lookSlug = "";
        }
        this.$watch("open", (open) => { if (open) this.$nextTick(() => requestAnimationFrame(() => this.fitList())); });
      },
      // Swapping: someone is picked and Keep Original is unchecked.
      get swapping() { return !!this.athlete && !this.keep; },
      // What the card shows (VideoPerformer#swap_state): none, kept, pending (no look), recast.
      get state() {
        if (!this.athlete) return "none";
        if (this.keep) return "kept";
        return this.lookSlug ? "recast" : "pending";
      },
      reset() {},
      // A person from the search is the swap: Keep Original unchecks, and they are
      // cast at once in their default look (else their first); a person with no look is saved alone.
      choose(r) {
        this.settle(r); this.query = ""; this.keep = false;
        this.setAthlete(r, "");
        this.persist({ person_slug: r.slug, appearance_slug: this.lookSlug });
      },
      // "Swap with <name>?": the person the card is named after, picked as if from the search.
      offerSwap() { if (this.offer) this.choose(this.offer); },
      // The naming search saved: offer the person now named, if they have a look.
      onNamed(detail) { if (detail.ordinal === Number(this.$root.dataset.ordinal)) this.offer = detail.offer || null; },
      // The one button pinned at the bottom of the card (music_videos/_swap_toggle), in the same
      // place in both states. Keep Original: not swapped, the person and look remembered.
      keepOriginal() { this.setKeep(true); },
      // Swap back to <name>: the swap returns with no re-pick.
      swapBack() { this.setKeep(false); },
      setKeep(kept) {
        if (!this.athlete || kept === this.keep) return;
        this.keep = kept; this.open = false; this.listOpen = false;
        this.persist(kept ? { keep: "1" } : { swap: "1" });
      },
      // Forget the person entirely: the card is back to the search alone.
      clearPerson() {
        this.keep = false; this.clearAthlete();
        this.persist({ clear: "1" });
        this.$nextTick(() => setTimeout(() => this.$refs.search && this.$refs.search.focus()));
      },
      onLookPicked() {
        if (this.athlete) this.persist({ person_slug: this.athlete.slug, appearance_slug: this.lookSlug });
      },
      persist(body) {
        const whole = !!(body.person_slug || body.clear);
        if (whole) this.queue = [body]; else this.queue.push(body);
        this.save = "saving"; this.error = "";
        if (!this.inflight) this.drain();
      },
      retry() { if (!this.inflight && this.queue.length) this.drain(); },
      async drain() {
        this.inflight = true; this.save = "saving"; this.error = "";
        while (this.queue.length) {
          const body = this.queue.shift();
          try {
            const json = await this.send(body);
            this.savedPerson = json.person_slug || ""; this.savedLook = json.appearance_slug || "";
            // Back to a remembered look that is gone: the card asks for a look again
            // (unless a later change already says otherwise).
            if (body.swap && this.athlete && !this.keep && this.queue.length === 0) this.lookSlug = this.savedLook;
          } catch (e) {
            // Stall here, in order: Retry resends this change, then what followed it.
            this.queue.unshift(body);
            this.error = e.message && e.message !== "Failed to fetch" ? e.message : "The connection dropped.";
            this.inflight = false; this.save = "failed";
            return;
          }
        }
        this.inflight = false; this.save = "saved";
        window.refreshCastOutputs();
      },
      async send(body) {
        const token = document.querySelector("meta[name='csrf-token']");
        const resp = await fetch(this.$root.dataset.saveUrl, {
          method: "PATCH", credentials: "same-origin",
          headers: { "Content-Type": "application/json", Accept: "application/json", "X-CSRF-Token": token ? token.content : "" },
          body: JSON.stringify(body),
        });
        const json = (resp.headers.get("Content-Type") || "").includes("json") ? await resp.json() : {};
        if (!resp.ok || !json.state) throw new Error(json.error || "The server answered " + resp.status + ".");
        return json;
      },
      // The results list is wider than the card: slide it back inside the window.
      // Measured only once the list is painted: a box read while x-show still hides it is
      // empty, and the shift worked out from it pushed the list off a phone screen.
      fitList(tries = 0) {
        const list = this.$refs.results;
        if (!list || !this.open) return;
        list.style.transform = "";
        const box = list.getBoundingClientRect();
        if (box.width === 0) { if (tries < 10) requestAnimationFrame(() => this.fitList(tries + 1)); return; }
        const gutter = 16;
        let dx = Math.min(0, window.innerWidth - gutter - box.right);
        if (box.left + dx < gutter) dx = gutter - box.left;
        if (dx) list.style.transform = "translateX(" + dx + "px)";
      },
    });
  };

</script>
<%= render "components/copy_text_script" %>
<%= render "music_videos/player_scripts" %>

<section class="max-w-6xl mx-auto px-4 py-8 sm:py-10" data-test="cast-panel">
  <header class="mb-6 min-w-0">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2" data-test="video-kind"><%= @video.kind_label %> · Cast</p>
    <h1 class="text-2xl sm:text-3xl font-bold text-heading mb-2 break-words"><%= @video.title %></h1>
    <p class="text-sm text-muted flex flex-wrap items-center gap-x-3 gap-y-1">
      <span><%= @video.platform.titleize %></span>
      <% if @video.duration_ms %><span><%= video_timecode(@video.duration_ms) %></span><% end %>
      <span class="badge text-3xs <%= @video.cast_confirmed? ? 'bg-success/10 text-success-ink border-success/40' : 'bg-primary/10 text-primary border-primary/20' %>" data-test="video-stage"><%= @video.stage.humanize %></span>
      <%= link_to "Watch source", @video.source_url, target: "_blank", rel: "noopener", class: "text-primary hover:underline" %>
    </p>
  </header>

  <div class="card p-4 mb-6" data-test="cast-credits">
    <p class="label-upper mb-2">Credited — who should be here</p>
    <div class="flex flex-wrap gap-2">
      <% @credits.each do |credit| %>
        <span class="badge bg-surface-alt text-body border-subtle text-xs gap-1" data-test="credited-artist" data-slug="<%= credit.artist_slug %>">
          <span class="font-semibold text-heading"><%= credit.artist.name %></span>
          <span class="text-muted"><%= credit.role %> · <%= credit.artist.kind %></span>
        </span>
      <% end %>
      <% @video.unresolved_credits.each do |credit| %>
        <span class="badge bg-warning/10 text-warning-ink border-warning/40 text-xs gap-1" data-test="unresolved-credit">
          <span class="font-semibold"><%= credit["name"] %></span>
          <span><%= credit["role"] %> · <%= credit["reason"] == "ambiguous" ? "several artists match" : "no artist yet" %></span>
        </span>
      <% end %>
      <% if @credits.empty? && @video.unresolved_credits.empty? %>
        <span class="text-sm text-muted">No credits were parsed for this video.</span>
      <% end %>
    </div>
  </div>

  <div class="card p-4 mb-6 flex flex-col sm:flex-row sm:items-center gap-3 justify-between" data-test="cast-progress">
    <%# Naming and swapping are both optional: the summary counts them, and only a swap still waiting for its look is called out. %>
    <% swapped = @performers.count(&:swap?) %>
    <% named = @performers.count(&:named?) %>
    <% waiting = @video.recast_open.size %>
    <p class="text-sm text-body">
      <span class="block" data-test="recast-progress">
        <span class="font-semibold text-heading" data-test="cast-swap-count"><%= swapped %> of <%= @performers.size %></span>
        <%= @performers.size == 1 ? "person" : "people" %> swapped; the rest stay as filmed.
        <% if waiting.positive? %>
          <span class="text-warning-ink" data-test="recast-waiting"><%= waiting %> still <%= waiting == 1 ? "needs" : "need" %> a look.</span>
        <% end %>
      </span>
      <span class="block mt-1 text-muted" data-test="cast-named-count">
        <%= named.zero? ? "Nobody" : "#{named} of #{@performers.size}" %> named<%= " (#{@performers.count(&:extra?)} marked extras)" if @performers.any?(&:extra?) %>. Naming is optional: it builds the artist rolodex.
      </span>
    </p>
    <div class="flex flex-col sm:flex-row sm:items-center gap-2 shrink-0">
      <% if @video.cast_confirmed? %>
        <span class="badge bg-success/10 text-success-ink border-success/40 text-xs justify-center" data-test="cast-confirmed">Cast confirmed</span>
      <% else %>
        <%= button_to "Cast confirmed", confirm_cast_music_video_path(@video), method: :post,
                      class: "btn btn-primary w-full sm:w-auto", disabled: !@video.cast_ready?,
                      form: { data: { test: "confirm-cast-form" } } %>
      <% end %>
      <%# Build Clips: the next alt video, from the swaps above as they stand now. %>
      <%= button_to "Build Clips", music_video_alt_videos_path(@video), method: :post,
                    class: "btn #{@video.cast_confirmed? ? 'btn-primary' : 'btn-outline'} w-full sm:w-auto", disabled: !@video.can_build_clips?,
                    title: @video.build_clips_blocker&.upcase_first,
                    form: { data: { test: "build-clips-form" } } %>
    </div>
  </div>

  <% if @performers.empty? %>
    <div class="empty-state text-muted" data-test="cast-empty">
      No people yet. The cast vision pass posts them (the <span class="font-mono">digest-video</span> SOP, stage 2).
    </div>
  <% else %>
    <div class="grid gap-4 grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
      <% @performers.each do |performer| %>
        <%= render "music_videos/performer", performer: performer, video: @video, still_urls: @still_urls, recast_looks: @recast_looks,
                   recast_rows: @recast_rows, sheet_row: @sheet_row, sheet_ready: @sheet_ready, fresh_look: params[:look] %>
      <% end %>
    </div>
  <% end %>

  <section class="mt-10" data-test="looks-panel" id="looks">
    <header class="mb-4">
      <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-1"><%= @video.kind_label %> · Looks</p>
      <h2 class="text-xl font-bold text-heading">Artist looks</h2>
      <p class="text-sm text-muted mt-1">One look per labelled artist for this video, built from their stills.</p>
    </header>
    <% if !@video.cast_confirmed? %>
      <div class="empty-state text-muted" data-test="looks-locked">Looks come after the cast is confirmed.</div>
    <% else %>
      <% if @look_candidates.any? %>
        <div class="card p-4 mb-4 flex flex-col gap-2" data-test="look-candidates">
          <p class="label-upper">Labelled, no look yet</p>
          <% @look_candidates.each do |performer| %>
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 min-w-0" data-test="look-candidate" data-ordinal="<%= performer.ordinal %>">
              <p class="text-sm text-body min-w-0 break-words">
                <span class="font-semibold text-heading"><%= performer.artist.name %></span>
                <span class="text-muted">· <%= performer.name %> · <%= pluralize(performer.still_object_keys.size, "still") %></span>
              </p>
              <%= button_to "Make look", music_video_looks_path(@video), method: :post, params: { ordinal: performer.ordinal },
                            class: "btn btn-outline btn-sm shrink-0", disabled: performer.still_object_keys.empty? %>
            </div>
          <% end %>
        </div>
      <% end %>
      <% if @looks.any? %>
        <div class="grid gap-4 grid-cols-1 md:grid-cols-2 xl:grid-cols-3">
          <% @looks.each do |look| %>
            <%= render "music_videos/look", look: look, video: @video, still_urls: @still_urls,
                       sheet: @look_sheets[look.slug], sheet_row: @sheet_row, sheet_ready: @sheet_ready %>
          <% end %>
        </div>
      <% elsif @look_candidates.empty? %>
        <div class="empty-state text-muted" data-test="looks-empty">No labelled artists in this cast, so no looks to make.</div>
      <% end %>
    <% end %>
  </section>

  <section class="mt-10" data-test="clips-panel" id="clips">
    <header class="mb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-1"><%= @video.kind_label %> · Clips</p>
        <h2 class="text-xl font-bold text-heading">Clip candidates</h2>
      </div>
      <% if @clips.any? %>
        <p class="text-sm text-body" data-test="clips-approved-count">
          <span class="font-semibold text-heading"><%= @clips.count(&:approved?) %> of <%= @clips.size %></span> approved.
          <span class="text-muted">One approved clip makes the video clips ready.</span>
        </p>
      <% end %>
    </header>
    <% if @clips.any? %>
      <div class="flex flex-col gap-4">
        <% @clips.each do |clip| %>
          <%= render "music_videos/clip", clip: clip, video: @video, clip_urls: @clip_urls %>
        <% end %>
      </div>
    <% elsif @video.cast_confirmed? %>
      <div class="empty-state text-muted" data-test="clips-empty">
        No clips yet. Run <span class="font-mono">bin/find-clips <%= @video.slug %></span> on the Mac.
      </div>
    <% else %>
      <div class="empty-state text-muted" data-test="clips-locked">Clips come after the cast is confirmed.</div>
    <% end %>
  </section>

  <section class="mt-10" data-test="chunks-panel" id="chunks">
    <header class="mb-4 flex flex-col sm:flex-row sm:items-end justify-between gap-2">
      <div>
        <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-1">Source video · Chunks and alt videos</p>
        <h2 class="text-xl font-bold text-heading">Whole video, in chunks</h2>
        <p class="text-sm text-muted mt-1" data-test="chunks-tiling">
          <% if (tiling = @video.chunk_tiling) %>
            <%= clip_seconds(tiling[:chunk_ms]) %> s chunks on a <%= clip_seconds(tiling[:chunk_ms] - tiling[:overlap_ms]) %> s stride<% if tiling[:overlap_ms].positive? %>, so each shares <%= clip_seconds(tiling[:overlap_ms]) %> s with the one before<% end %>.
          <% end %>
          Cut once and shared by every alt video. Each alt video swaps them with its own cast: generate, upload and stitch on its page.
        </p>
      </div>
      <% if @chunks.any? %>
        <p class="text-sm text-body shrink-0" data-test="chunks-count">
          <span class="font-semibold text-heading"><%= pluralize(@chunks.size, "chunk") %></span>
          <span class="text-muted">· 0:00–<%= video_timecode(@chunks.last.end_ms) %></span>
        </p>
      <% end %>
    </header>
    <% if @chunks.any? %>
      <ol class="flex flex-wrap gap-1.5 mb-4" data-test="chunk-windows">
        <% @chunks.each do |chunk| %>
          <li class="badge text-xs bg-surface-alt text-body border-subtle font-mono tabular-nums" data-test="chunk-window" data-ordinal="<%= chunk.ordinal %>">
            <%= chunk.ordinal %> · <%= video_timecode(chunk.start_ms) %>–<%= video_timecode(chunk.end_ms) %>
          </li>
        <% end %>
      </ol>
      <div class="card p-4 flex flex-col gap-3 min-w-0" data-test="source-alt-videos" data-count="<%= @alt_videos.size %>">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 min-w-0">
          <p class="label-upper">Alt videos of this source</p>
          <%= link_to "All alt videos", alt_videos_path, class: "text-sm text-primary hover:underline", data: { test: "alt-videos-index-link" } %>
        </div>
        <% if @alt_videos.empty? %>
          <p class="text-sm text-muted" data-test="source-alt-videos-none">None yet. Build Clips (above, beside Cast confirmed) makes alt video 1 from the swaps as they stand.</p>
        <% else %>
          <ul class="flex flex-col gap-2">
            <% @alt_videos.each do |alt| %>
              <% with_primary, total = alt.progress %>
              <li class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 min-w-0 text-sm" data-test="source-alt-video" data-number="<%= alt.number %>">
                <span class="min-w-0 break-words">
                  <%= link_to alt.name, music_video_alt_video_path(@video, alt), class: "font-semibold text-primary hover:underline" %>
                  <span class="text-muted">· <%= alt.swaps_summary %></span>
                </span>
                <span class="text-body shrink-0"><%= with_primary %> of <%= total %> clips with a primary<% if alt.latest_stitch %> · <%= alt.latest_stitch.name.downcase %><% end %></span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state text-muted" data-test="chunks-empty">
        No chunks yet. Run <span class="font-mono">bin/find-clips <%= @video.slug %> --tile</span> on the Mac.
      </div>
    <% end %>
  </section>
</section>
