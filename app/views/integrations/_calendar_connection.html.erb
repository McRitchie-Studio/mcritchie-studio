<%# Admin only (IntegrationsController#index sets calendar for an admin and nobody else): the hub's own Google Calendar connection, on the Google Workspace card's Sign in row. Connect when nothing readable is connected and the server can take one; otherwise the account and Disconnect. Both come back to this page. No token renders. %>
<% connection = calendar[:connection] %>
<div class="mt-1.5 flex flex-wrap items-center gap-x-2 gap-y-1" data-test="calendar-connection" data-state="<%= connection ? 'connected' : 'none' %>">
  <% if connection %>
    <span class="min-w-0 text-body [overflow-wrap:anywhere]" data-test="calendar-account">Connected as <span class="font-medium text-heading"><%= connection.email %></span></span>
    <%= button_to "Disconnect", admin_google_calendar_disconnect_path(return_to: integrations_path), method: :delete,
                  class: "btn btn-neutral btn-sm",
                  form: { class: "inline-flex", data: { test: "calendar-disconnect", turbo_confirm: "Disconnect Google Calendar for #{connection.email}? This deletes the stored connection and revokes it at Google." } } %>
  <% elsif calendar[:connectable] %>
    <%= link_to "Connect Google Calendar", admin_google_calendar_connect_path(return_to: integrations_path),
                class: "btn btn-primary btn-sm", data: { test: "calendar-connect", turbo: false } %>
  <% end %>
</div>
