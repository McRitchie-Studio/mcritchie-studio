<%# A small horizontal bar chart of a running-average window's per-stage mean
    durations (Assembled/G3 Candidate/G4 Ship/Deployed). One fixed hue per stage —
    consistent across both charts — so the same stage compares by colour; each bar
    is direct-labelled with its value (the CVD-floor mitigation, dataviz skill).
    Bars share max_seconds with the sibling chart so the two windows are visually
    comparable. Total is a caption, not a bar (it would dwarf the stages). Locals:
      averages     a Release.deployment_stage_averages hash (required)
      label        chart title (required)
      max_seconds  shared bar scale across both charts (required) %>
<% averages = local_assigns.fetch(:averages) %>
<% label = local_assigns.fetch(:label) %>
<% max_seconds = local_assigns.fetch(:max_seconds).to_f %>
<% stages = averages["stages"] || {} %>
<% colors = { "assembled" => "#199e70", "g3_candidate" => "#3987e5", "g4_ship" => "#c98500", "deployed" => "#008300" } %>
<figure class="rounded-xl border border-subtle bg-surface p-4">
  <figcaption class="mb-3 flex items-baseline justify-between gap-3">
    <span class="text-sm font-semibold text-heading"><%= label %></span>
    <span class="text-xs text-muted">
      <%= averages["sample_count"].to_i %> release<%= "s" unless averages["sample_count"].to_i == 1 %>
      · Total <span class="font-mono text-secondary"><%= release_duration_label(stages.dig("total", "average_seconds")) %></span>
    </span>
  </figcaption>
  <div class="space-y-1.5" role="img" aria-label="<%= label %> per-stage average durations">
    <% Release::DEPLOYMENT_STAGES.each do |stage| %>
      <%# A nil average = the stage has no completed samples (e.g. Tested on
          pre-migration releases). Keep it nil — do NOT coerce to 0, which would hit
          the 2%-floor and draw a bar reading "<1m" for a stage with no data.
          nil → zero-width bar (no fill) + a "—" value. %>
      <% average_seconds = stages.dig(stage[:key], "average_seconds") %>
      <% pct = average_seconds && max_seconds.positive? ? [(average_seconds.to_i / max_seconds * 100).round, 2].max : 0 %>
      <div class="flex items-center gap-3">
        <%# Bars all start at the same left edge; the stage label is overlaid inside
            the bar's start (spilling onto the surface for short bars, still legible). %>
        <div class="relative h-5 min-w-0 flex-1">
          <div class="absolute inset-y-0 left-0 rounded-[4px]"
               style="width: <%= pct %>%; background-color: <%= colors[stage[:key]] %>;"
               title="<%= stage[:label] %>: <%= release_duration_label(average_seconds) %> average over <%= averages["sample_count"].to_i %> releases"></div>
          <span class="absolute inset-y-0 left-0 flex items-center pl-2 text-[11px] font-medium text-white"
                style="text-shadow: 0 1px 2px rgba(0,0,0,0.45);"><%= stage[:label] %></span>
        </div>
        <span class="w-12 shrink-0 text-right font-mono text-xs font-semibold text-heading tabular-nums"><%= release_duration_label(average_seconds) %></span>
      </div>
    <% end %>
  </div>
</figure>
