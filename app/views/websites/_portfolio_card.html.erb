<%# One /websites portfolio card (Alex McRitchie, 2026-11-08: "I really want the
    image to be the whole card and the description changes at the bottom"). The
    app's dark-mode still is the whole card, and nothing sits over it. The name,
    the host and the blurb are the row's caption (websites/_portfolio_caption),
    which the carousel shows under the open slide only. The link is named for
    the app, so a screen reader and Tab hear the name the picture shows.
    /build keeps its own card (build/_gallery_card); this one is /websites only.

    The ring takes the app's primary (WebsitesHelper#portfolio_card_style). The
    motion loop plays over the still on mouse hover or keyboard focus, as on
    /build (app/javascript/gallery_motion.js, the same data hooks). %>
<%= link_to example.url, target: "_blank", rel: "noopener", aria: { label: example.name },
      class: "portfolio-card group relative block aspect-[4/3] overflow-hidden rounded-2xl bg-surface-alt focus-visible:outline focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-primary",
      style: portfolio_card_style(example),
      data: { test: "build-example", portfolio_card: true, gallery_motion: (true if example.motion) } do %>
  <% if example.image %>
    <%= image_tag example.image, alt: example.name, loading: "lazy",
          class: "absolute inset-0 h-full w-full object-cover object-left-top transition-transform duration-500 group-hover:scale-[1.03] motion-reduce:transition-none motion-reduce:group-hover:scale-100",
          data: { test: "build-example-image" } %>
    <% if example.motion %>
      <video src="<%= asset_path(example.motion) %>"
             muted loop playsinline preload="none" aria-hidden="true" tabindex="-1"
             class="pointer-events-none absolute inset-0 h-full w-full object-cover object-left-top opacity-0 data-[playing]:opacity-100 transition-opacity duration-300 motion-reduce:hidden"
             data-gallery-motion-video data-test="build-example-motion"></video>
    <% end %>
  <% else %>
    <span class="absolute inset-0 flex items-center justify-center text-6xl" aria-hidden="true"><%= example.emoji %></span>
  <% end %>
<% end %>
