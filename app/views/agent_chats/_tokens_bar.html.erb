<%# locals: (meter:) %>
<%# The status card's token meter (AgentUsage::Meter, tokens never dollars): the app chat's compact meter: "42% used" with "Resets Nov 1 at 1am MST" beside it on the left, "10,689 / 25,000" tokens on the right (under a fifth left, a "Resets in 3d 4h" countdown instead, usage_countdown.js), over an 8px bar, re-rendered into #cto-chat-meter by every answer (AgentMessages::WebChat.broadcast_meter), so it moves after each reply without a reload. Near the cap (the warn share, config/workspace_packages.yml cto_usage) and at it, a note links the plans page; at the cap the CTO answers in code (AgentUsage.cap_reply) until the month resets. Owner-or-admin pages only. Rendered in broadcasts too: paths only, no URL helpers. The full meter, with its tier, stays on the app page (applications/_usage_meter). %>
<% fmt = ->(n) { n.to_i.to_fs(:delimited) } %>
<% bar = { ok: "bg-success", warn: "bg-warning", capped: "bg-danger" }[meter.state] %>
<% width = meter.unlimited? ? 0 : [ meter.percent, 100 ].min %>
<div class="space-y-1.5 text-sm" data-test="usage-meter" data-state="<%= meter.state %>"
     data-used="<%= meter.used.to_i %>" data-allowance="<%= meter.allowance %>">
  <div class="flex items-baseline justify-between gap-2 text-body" data-test="usage-meter-line">
    <% if meter.unlimited? %>
      <span><span class="font-semibold text-heading tabular-nums"><%= fmt.(meter.used) %></span> tokens this month</span>
      <span class="text-secondary text-xs">unlimited</span>
    <% else %>
      <%# Left: the share used, and beside it, lighter and smaller, when it resets (1am Denver on the 1st, AgentUsage.month_range). %>
      <span class="flex min-w-0 flex-wrap items-baseline gap-x-2">
        <span class="font-semibold text-heading tabular-nums" data-test="usage-meter-percent"><%= meter.percent %>&#37; used</span>
        <span class="text-xs text-muted" data-test="usage-meter-resets"><%= meter.resets_line %></span>
      </span>
      <%# Right: the tokens, until under a fifth is left (the warn share); then a countdown to the reset, ticked each minute (usage_countdown.js). %>
      <% if meter.countdown? %>
        <span class="shrink-0 text-secondary text-xs tabular-nums" data-test="usage-meter-countdown"
              data-usage-countdown data-resets-at="<%= meter.resets_at.to_i %>"><%= meter.countdown_line %></span>
      <% else %>
        <span class="shrink-0 text-secondary text-xs tabular-nums" data-test="usage-meter-tokens"><%= fmt.(meter.used) %> / <%= fmt.(meter.allowance) %></span>
      <% end %>
    <% end %>
  </div>
  <% unless meter.unlimited? %>
    <div class="h-2 w-full overflow-hidden rounded-full bg-inset" role="progressbar" aria-label="Tokens used this month"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= width %>">
      <div class="h-full rounded-full <%= bar %>" style="width: <%= width %>%"></div>
    </div>
  <% end %>
  <% if meter.capped? || meter.warn? %>
    <% resets = meter.resets_on %>
    <p class="<%= meter.capped? ? 'text-danger-ink' : 'text-warning-ink' %> text-xs" data-test="usage-cap-note">
      <% if meter.capped? %>
        This month's allowance is used up; it resets <%= resets %>.
      <% else %>
        Running low: <%= fmt.(meter.remaining) %> tokens left this month.
      <% end %>
      <% if (suggestion = meter.suggestion) %>
        <span data-test="usage-suggestion" data-kind="<%= suggestion.kind %>"><%= suggestion.line %></span>
      <% end %>
      <%= link_to "Upgrade for more", packages_path, class: "font-semibold underline", data: { test: "usage-upgrade-link" } %>
    </p>
  <% elsif (suggestion = meter.suggestion) %>
    <p class="text-warning-ink text-xs" data-test="usage-suggestion" data-kind="<%= suggestion.kind %>"><%= suggestion.line %></p>
  <% end %>
</div>
