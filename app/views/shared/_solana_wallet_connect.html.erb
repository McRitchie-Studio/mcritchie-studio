<%# Solana auth entry point — opens the "Connect Wallet" picker modal
    (modals/_wallet_connect). The connect itself runs inside the modal via
    window.solanaConnectAndVerify. link_mode is reserved for a future
    "link wallet to my logged-in account" flow (not wired yet in the hub).
    locals: (link_mode: false) %>
<% link_mode = local_assigns.fetch(:link_mode, false) %>
<div x-data x-cloak>
  <button type="button"
          @click="$store.modals.open('wallet-connect', { linkMode: <%= link_mode %>, currentUserId: <%= (link_mode && current_user&.id) || 'null' %> })"
          class="btn btn-neutral btn-lg w-full gap-3">
    <img src="/solana-mark.svg" alt="" class="w-5 h-5">
    <span>Solana</span>
  </button>
</div>
