#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/task — deterministic CLI for the McRitchie Studio agent task board.
#
# Wraps /api/v1 so agents never hand-roll auth, JSON, or stage transitions.
# Two footguns it removes for you:
#   * `update` does read-merge-write on metadata.devops, so a partial update
#     NEVER wipes existing devops fields (the raw API replaces them wholesale).
#   * list flags are repeatable and sent as arrays, so commas inside individual
#     values are preserved by the task-board API.
#
# Auth: AGENT_API_SECRET from ENV, else 1Password (op://agents/Agent API
# Secret/AGENT_API_SECRET), else the repo .env. Base URL via TASK_API_BASE
# (default https://mcritchie.studio).
#
# Usage:
#   bin/task list [--stage S] [--agent A]
#   bin/task show <slug> [--json | --verbose|-v]
#     ( default is terse; --json prints the full fetched record as pretty JSON
#       (no token dance); --verbose/-v expands the acceptance BULLETS, agent_context,
#       test_plan, checks_run, claim state, and pr_url/local_url for a human read. )
#   bin/task stale [<slug>]
#     ( flags a task whose work is already on origin/main (fixed out-of-band) while
#       the task isn't shipped/archived. Resolves the branch (devops.branch or
#       feat/<slug>), git-fetches, and reports if origin/<branch> is an ancestor of
#       origin/main. With NO slug it scans every open task and lists the stale ones. )
#   bin/task field <slug> <devops-key>       # machine-readable single value (e.g. mascot)
#   bin/task create --title T [--slug readable-handle] [--kind K] [--shape S] [--worktree-slug W] [--priority N] [--agent A] \
#   ( --slug sets a readable, immutable Task.slug → /tasks/<slug>; it also seeds
#     worktree_slug + branch (feat/<slug>). Omit it for an opaque task-<hex>. )
#                   [--repo R ...] [--risk R ...] [--accept "..." ...] [--test "..." ...] \
#                   [--checks "..." ...] [--branch B] [--pr-url U] [--local-url U] [--release-slug T] \
#                   [--po-size S] [--dev-size S] [--pm-size S] [--post-deploy-cmd "rake foo:bar"] [--no-claim]
#   ( --shape feeds bin/dor-check: one of the keys in config/feature_shapes.yml )
#   ( --no-claim files the task WITHOUT repointing this session's active-feature
#     marker at it — filing a task is not building it. Use it when a conductor /
#     batch opens follow-up tasks it is not about to build (only an explicit
#     `move building` claims). )
#   ( --po-size/--dev-size/--pm-size set the size trio: small|medium|large|xl.
#     Avi seeds --po-size at creation (the default sizer, not a hard gate);
#     actual_size is auto-derived from measured usage at ship. )
#   ( --checks records devops.checks_run; tag each line by tier, e.g. "[unit] ..." )
#   ( --post-deploy-cmd: the release pipeline runs it on the deployed app after
#     boot — QA on `bin/release prepare`, prod on `ship`. Must be idempotent. )
#   bin/task update <slug> [same flags as create]   # merges into existing devops
#   bin/task move <slug> <stage>                     # designed|building|submitted|reviewed|assembled|shipped|blocked|archived
#     [--model M] [--tokens-in N] [--tokens-out N] [--cost D] [--actor A] [--dev-size S] [--steal]
#     ( --dev-size (small|medium|large|xl) records the builder's own estimate as it
#       claims the task at `building` — optional; absent is fine. )
#     ( best-effort per-transition usage the agent burned in the stage it's
#       leaving — recorded on this move's TaskEvent. With NO usage flags, a
#       Claude/Codex session auto-captures model + token delta + cost from its
#       transcript, so a bare move still leaves a full paper trail; flags
#       override. The from/to/duration spine is recorded server-side regardless. )
#     ( the move to `building` CLAIMS the task for this live instance (session id +
#       a per-process nonce) under a TTL lease. It REFUSES (loudly) if a DIFFERENT,
#       non-expired instance already holds it — pass --steal to take it over. An
#       expired / dead-session lease is reclaimed automatically. )
#   bin/task heartbeat <slug>                         # renew this instance's build-claim lease (bin/statusline calls it)
#   bin/task session-mascot [--persona SLUG|none] [--print]
#     ( draw this Claude/Codex session's Pokémon marker before a task exists.
#       --persona jasper temporarily shows a soul instead; --persona none reverts. )
#   bin/task intent <slug> --to <stage> [--actor SLUG] [--reviewer slug:weight ...]
#     ( records an agentic INTENT — an agent STARTING a stage's work — so the board +
#       timeline show who's on it with a live ticker before the transition lands.
#       --actor for a single owner (Steffon QA → assembled, Avi ship → shipped);
#       repeat --reviewer for the senior pair (the review pair is normally recorded
#       automatically by bin/reviewer-select, which records by default). )
#   bin/task block <slug> [--kind environment|rework|dependency] [--feedback "..."] [--agent A]
#     ( shortcut: stage→blocked + records devops.block_kind + posts a qa_feedback activity )
#   bin/task note <slug> --handoff "..." | --qa-feedback "..." | --comment "..." [--agent A]
#     ( posts a task activity via POST /api/v1/activities; flags map to
#       activity_type handoff/qa_feedback/comment. Repeatable + combinable —
#       one activity is posted per flag given. )

require "net/http"
require "json"
require "uri"
require "fileutils"
require "digest"
require "shellwords"
require_relative "../lib/agent_session_usage"
require_relative "../lib/task_usage_baseline"
require_relative "../lib/claim_lease"
require_relative "../lib/stale_check"
require_relative "../lib/feature_marker"

BASE_URL = ENV.fetch("TASK_API_BASE", "https://mcritchie.studio")
OP = "/opt/homebrew/bin/op"
SECRET_REF = "op://agents/Agent API Secret/AGENT_API_SECRET"
def default_projects_dir
  candidate = File.expand_path("../..", __dir__)
  if File.basename(candidate) == ".worktrees"
    File.expand_path("../..", candidate)
  else
    candidate
  end
end

# Honors CLAUDE_PROJECTS_DIR (as bin/statusline does) so a session and its status
# line agree on the marker location — and so tests can isolate it; defaults to the
# projects root even when this script runs from an isolated worktree.
PROJECTS_DIR = (dir = ENV["CLAUDE_PROJECTS_DIR"].to_s.strip).empty? ? default_projects_dir : File.expand_path(dir)

# Per-session active-feature marker path, keyed by Claude/Codex session id so each
# session shows its OWN feature (no cross-session leak). nil when there's no
# agent session id.
def feature_marker_path
  sid = session_identity.first.to_s.strip
  return nil if sid.empty?

  File.join(PROJECTS_DIR, ".agents", "sessions", "#{sid.gsub(/[^A-Za-z0-9._-]/, "")}.json")
end

# The agent session working this task — stamped on create + on the move to
# `building` (the claim moment) so the board + status line can show which
# terminal owns a task and offer a click-to-copy resume command. Claude exposes
# CLAUDE_CODE_SESSION_ID; Codex exposes CODEX_THREAD_ID. Returns [id, provider],
# or [nil, nil] for a plain shell / CI run (stamp nothing — graceful).
def session_identity
  claude = ENV["CLAUDE_CODE_SESSION_ID"].to_s.strip
  return [claude, "claude"] unless claude.empty?

  codex = ENV["CODEX_THREAD_ID"].to_s.strip
  return [codex, "codex"] unless codex.empty?

  [nil, nil]
end

def parent_session_identity
  %w[
    MCRITCHIE_PARENT_SESSION_ID
    AGENT_PARENT_SESSION_ID
    CODEX_PARENT_THREAD_ID
    CLAUDE_PARENT_SESSION_ID
  ].each do |key|
    value = ENV[key].to_s.strip
    return value unless value.empty?
  end

  nil
end

# Merge the captured session id/provider into a devops hash. No-op (returns the
# input) when there's no session, so non-Claude/CI runs stamp nothing.
def stamp_session(devops)
  id, provider = session_identity
  return devops if id.nil?

  merged = (devops || {}).dup
  merged["session_id"] = id
  merged["session_provider"] = provider
  merged
end

def titleize_marker_name(value)
  raw = value.to_s.tr("-", " ").strip
  return "" if raw.empty?

  raw[0].upcase + raw[1..].to_s
end

def print_session_marker(marker)
  mascot = titleize_marker_name(marker["mascot"])
  head = [marker["mascot_emoji"], mascot].map(&:to_s).map(&:strip).reject(&:empty?).join(" ").strip
  parts = [head, marker["app"], marker["worktree_slug"] || marker["feature"]].map(&:to_s).map(&:strip).reject(&:empty?)
  puts parts.join(" · ")
end

# --- Build claim lease (V2: the enforcement gate) --------------------------
# The per-PROCESS-instance nonce that, with the session id, identifies the LIVE
# INSTANCE holding a claim (see lib/claim_lease.rb). It MUST be stable across the
# many short-lived bin/task invocations within ONE terminal, yet DIFFER between
# terminal-A and a `claude --resume` in terminal-B (both share
# CLAUDE_CODE_SESSION_ID). So it can't be per-invocation — it's anchored to the
# long-lived AGENT process (the `claude`/`codex` CLI), which is the common
# ancestor of every bin/task call in a terminal and a distinct OS process per
# terminal. Resolution, most-robust first:
#   1. TASK_CLAIM_NONCE — explicit injection (tests; a future agent-exported
#      per-instance token would set this).
#   2. The agent process found by walking the ancestry: a short hash of its
#      PID + start time. PID alone is reused after exit; pairing it with the
#      start time makes the identity collision-resistant. Two `claude --resume`
#      processes ⇒ different PID+start ⇒ different nonce.
#   3. Degrade: the controlling TTY of the nearest ancestor that has one (the
#      agent's per-call Bash-tool shells are detached, so this resolves to the
#      agent's own terminal); then "" — a session-only claim that still catches a
#      DIFFERENT session, just not two terminals of the same one.
# Memoized (incl. the "" degrade) so the gate + the renewal agree and ps runs once.
AGENT_COMMANDS = %w[claude codex].freeze

def claim_nonce
  return @claim_nonce if defined?(@claim_nonce)

  @claim_nonce = resolve_claim_nonce
end

def resolve_claim_nonce
  override = ENV["TASK_CLAIM_NONCE"].to_s.strip
  return override unless override.empty?

  chain = process_ancestry
  agent = chain.find { |p| AGENT_COMMANDS.include?(File.basename(p[:comm].to_s.split(/\s+/).first.to_s)) }
  return short_hash("pid:#{agent[:pid]}|start:#{proc_start(agent[:pid])}") if agent

  tty = chain.map { |p| p[:tty] }.find { |t| !t.to_s.empty? && t != "?" && t != "??" }
  return short_hash("tty:#{tty}") if tty

  "" # could not determine — degrade to a session-only claim
rescue StandardError
  ""
end

# Walk the process tree from us up to init: [{pid:, ppid:, tty:, comm:}, ...].
# One `ps` per level (≈5 deep) — cheap, and bin/task isn't a hot path.
def process_ancestry(max_depth: 12)
  chain = []
  pid = Process.pid
  max_depth.times do
    out = IO.popen(["ps", "-o", "ppid=,tty=,comm=", "-p", pid.to_s], err: File::NULL, &:read).to_s.strip
    break if out.empty?

    ppid, tty, comm = out.split(/\s+/, 3)
    chain << { pid: pid.to_i, ppid: ppid.to_i, tty: tty.to_s, comm: comm.to_s }
    pid = ppid.to_i
    break if pid <= 1
  end
  chain
rescue StandardError
  []
end

# The wall-clock start time of a pid (`ps -o lstart=`), e.g. "Mon Jun 22 13:39:32
# 2026" — the disambiguator that survives PID reuse after the process exits.
def proc_start(pid)
  IO.popen(["ps", "-o", "lstart=", "-p", pid.to_s], err: File::NULL, &:read).to_s.strip
rescue StandardError
  ""
end

def short_hash(text)
  Digest::SHA256.hexdigest(text)[0, 12]
end

# Refuse a move-to-building when the task is already claimed by a DIFFERENT,
# still-live instance — unless --steal. Unclaimed / expired / same-instance claim
# freely. Loud (not a hard block): it prints WHO holds it + how to override.
def enforce_claim_gate!(slug, devops, mover_session, steal:)
  claim = ClaimLease.from_devops(devops)
  decision = ClaimLease.evaluate(claim, session: mover_session, nonce: claim_nonce)
  return if decision != :held_by_other || steal

  held = claim["claimed_session"].to_s
  age = ClaimLease.heartbeat_age(claim)
  warn!("⚠  task #{slug} is already claimed by a DIFFERENT live instance:")
  warn!("     session …#{held[-4..] || held}  instance #{claim["claim_nonce"]}  ·  last heartbeat ~#{age}s ago " \
        "(lease TTL #{ClaimLease::DEFAULT_TTL_SECONDS}s)")
  warn!("   Another terminal looks active on this task. To take it over anyway, re-run with --steal:")
  warn!("     bin/task move #{slug} building --steal")
  exit 1
end

SCALAR_FLAGS = {
  "--kind" => "kind", "--shape" => "shape", "--worktree-slug" => "worktree_slug",
  "--branch" => "branch", "--pr-url" => "pr_url",
  "--local-url" => "local_url", "--qa-url" => "qa_url", "--prod-url" => "production_url",
  "--release-slug" => "release_slug", "--release-train" => "release_slug", "--block-kind" => "block_kind",
  "--agent-context" => "agent_context", "--post-deploy-cmd" => "post_deploy_cmd",
  # "act as <soul>": the status-line mascot becomes that agent (name + glyph + tint)
  # in place of the session's Pokémon. The server stamps the identity (Task#sync_
  # persona_identity); a new task without --persona reverts to the Pokémon. Distinct
  # from --agent, which sets the task OWNER (agent_slug).
  "--persona" => "persona"
}.freeze
LIST_FLAGS = { "--repo" => "repositories", "--risk" => "risk_tags", "--accept" => "acceptance", "--test" => "test_plan", "--checks" => "checks_run" }.freeze
NOTE_FLAGS = { "--handoff" => "handoff", "--qa-feedback" => "qa_feedback", "--comment" => "comment" }.freeze
# The size trio, set as TOP-LEVEL Task columns (not devops). Avi seeds po_size at
# creation (the default sizer — not a hard gate), the builder Pokémon stamps
# dev_size when it claims the task at `building`, pm_size is an optional extra
# estimate; actual_size is auto-derived from measured usage at ship. Every value
# is validated against SIZES before the request goes out.
SIZES = %w[small medium large xl].freeze
SIZE_FLAGS = { "--pm-size" => "pm_size", "--po-size" => "po_size", "--dev-size" => "dev_size" }.freeze
# Two-workflow status model. Stages move via PATCH stage (no named-transition
# endpoints) so the CLI, the board drag-drop, and the API share one path.
STAGES = %w[designed building submitted reviewed assembled shipped blocked archived].freeze
LEGACY_STAGE_HINTS = {
  "new" => "designed",
  "queued" => "designed",
  "in_progress" => "building",
  "pr_review" => "submitted",
  "qa_review" => "assembled",
  "prod_ready" => "assembled",
  "done" => "shipped",
  "failed" => "blocked"
}.freeze
BLOCK_KINDS = %w[environment rework dependency].freeze
PERSONA_CLEAR = %w[none clear off -].freeze

def warn!(msg)
  $stderr.puts(msg)
end

def die!(msg)
  warn!("error: #{msg}")
  exit 1
end

def validate_stage!(stage)
  return if STAGES.include?(stage)

  hint = LEGACY_STAGE_HINTS[stage]
  suffix = hint ? " (legacy stage; use #{hint.inspect})" : ""
  die!("unknown stage #{stage.inspect}#{suffix}; one of: #{STAGES.join(", ")}")
end

# Reject a size value the model would refuse, with a clear message — so a typo'd
# --po-size never reaches the API as a 422. Shared by create/update (parse_flags)
# and the building claim's --dev-size.
def validate_size!(flag, value)
  return if SIZES.include?(value)

  die!("#{flag} must be one of: #{SIZES.join(", ")} (got #{value.inspect})")
end

def agent_secret
  env = ENV["AGENT_API_SECRET"]
  return env if env && !env.empty?

  if File.executable?(OP)
    op = begin
      IO.popen([OP, "read", SECRET_REF], err: File::NULL, &:read).to_s.strip
    rescue SystemCallError
      ""
    end
    return op unless op.empty?
  end

  dotenv = File.join(__dir__, "..", ".env")
  if File.exist?(dotenv)
    line = File.readlines(dotenv).find { |l| l.start_with?("AGENT_API_SECRET=") }
    return line.split("=", 2)[1].to_s.strip if line
  end
  die!("AGENT_API_SECRET not found (checked ENV, 1Password, #{dotenv})")
end

def token
  @token ||= api(:post, "/api/v1/auth", { secret: agent_secret }, auth: false).fetch("token")
end

# NOTE: opts is a trailing positional hash, NOT a keyword arg. Under system Ruby
# (2.6) a brace-hash passed as the last positional to a method with keyword
# params is silently coerced to kwargs — which is what made `move` blow up with
# "unknown keyword: stage". Keeping auth in a positional opts hash is robust
# across every Ruby the agents might run this under.
def api(method, path, body = nil, opts = {})
  auth = opts.fetch(:auth, true)
  uri = URI.join(BASE_URL, path)
  klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch }.fetch(method)
  req = klass.new(uri)
  req["Authorization"] = "Bearer #{token}" if auth
  if body
    req["Content-Type"] = "application/json"
    req.body = JSON.generate(body)
  end
  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = (uri.scheme == "https")
  http.read_timeout = 30
  res = http.request(req)
  parsed = res.body.to_s.empty? ? {} : (JSON.parse(res.body) rescue {})
  unless res.code.to_i.between?(200, 299)
    die!("#{method.upcase} #{path} -> #{res.code}: #{parsed["error"] || res.body}")
  end
  parsed
end

# Parse repeatable + scalar flags out of argv. Returns [positionals, flags-hash].
def parse_flags(argv)
  positionals = []
  scalars = {}
  lists = Hash.new { |h, k| h[k] = [] }
  top = {}
  i = 0
  while i < argv.length
    arg = argv[i]
    if SCALAR_FLAGS.key?(arg)
      scalars[SCALAR_FLAGS[arg]] = argv[i + 1] || die!("#{arg} needs a value"); i += 2
    elsif LIST_FLAGS.key?(arg)
      lists[LIST_FLAGS[arg]] << (argv[i + 1] || die!("#{arg} needs a value")); i += 2
    elsif SIZE_FLAGS.key?(arg)
      value = argv[i + 1] || die!("#{arg} needs a value")
      validate_size!(arg, value)
      top[SIZE_FLAGS[arg]] = value; i += 2
    elsif %w[--slug --title --description --agent --priority --stage].include?(arg)
      top[arg.delete_prefix("--")] = argv[i + 1] || die!("#{arg} needs a value"); i += 2
    else
      positionals << arg; i += 1
    end
  end
  [positionals, scalars, lists, top]
end

def build_devops(base, scalars, lists)
  devops = (base || {}).dup
  scalars.each { |k, v| devops[k] = v }
  lists.each { |k, v| devops[k] = v unless v.empty? }
  devops
end

def top_body(top)
  body = {}
  body["slug"] = top["slug"] if top["slug"] # custom readable handle (create only)
  body["title"] = top["title"] if top["title"]
  body["description"] = top["description"] if top["description"]
  body["agent_slug"] = top["agent"] if top["agent"]
  body["priority"] = top["priority"].to_i if top["priority"]
  body["stage"] = top["stage"] if top["stage"]
  # The size trio (top-level Task columns) — already validated in parse_flags.
  SIZE_FLAGS.each_value { |col| body[col] = top[col] if top[col] }
  body
end

def print_task(task)
  dv = task.dig("metadata", "devops") || {}
  puts "#{task["slug"]}  [#{task["stage"]}]  #{task["title"]}"
  puts "  agent: #{task["agent_slug"] || "-"}  kind: #{dv["kind"] || "-"}  repos: #{Array(dv["repositories"]).join(", ")}"
  puts "  branch: #{dv["branch"] || "-"}  pr: #{dv["pr_url"] || "-"}"
  puts "  acceptance: #{Array(dv["acceptance"]).size} item(s)  risk: #{Array(dv["risk_tags"]).join(", ")}"
end

# Print a labeled bullet list (the actual acceptance/test_plan/checks lines), or
# "label: -" when empty — so a human read of a task never needs the curl + token
# dance just to see the acceptance bullets the terse view only counts.
def print_bullets(label, items)
  items = Array(items)
  if items.empty?
    puts "  #{label}: -"
  else
    puts "  #{label}:"
    items.each { |item| puts "    - #{item}" }
  end
end

# The human-readable expansion behind `show --verbose`: the terse header plus the
# fields an agent otherwise had to hand-curl — acceptance BULLETS (not just a
# count), agent_context, test_plan, checks_run, the build-claim state, and the
# PR / local URLs.
def print_task_verbose(task)
  print_task(task)
  dv = task.dig("metadata", "devops") || {}
  puts
  print_bullets("acceptance", dv["acceptance"])
  puts "  agent_context: #{dv["agent_context"] || "-"}"
  print_bullets("test_plan", dv["test_plan"])
  print_bullets("checks_run", dv["checks_run"])
  puts "  claim: session #{dv["claimed_session"] || "-"} · expires #{dv["claim_expires_at"] || "-"}"
  puts "  pr_url: #{dv["pr_url"] || "-"}   local_url: #{dv["local_url"] || "-"}"
end

# --- Stale check: is a task's work already on origin/main? ------------------
# The directory the stale check runs git in. Defaults to the CLI's own checkout
# (any clone/worktree that shares origin's tracking refs); TASK_GIT_DIR overrides
# it so tests can point git at a throwaway repo with no network.
def git_dir
  dir = ENV["TASK_GIT_DIR"].to_s.strip
  dir.empty? ? File.expand_path("..", __dir__) : dir
end

# Run a git command in git_dir, swallowing stderr. Returns [stdout, success?].
def git(*args)
  out = IO.popen(["git", "-C", git_dir, *args], err: File::NULL, &:read).to_s.strip
  [out, $?.success?]
end

# Resolve a task's STALE disposition — its branch already merged to origin/main
# (work shipped out-of-band) while the task itself hasn't reached shipped/archived.
# The git I/O lives here; the decision is delegated to the pure StaleCheck module.
# Pure of network on its own: the CALLER git-fetches first (once, even for a board
# scan). Returns a result hash {slug:, branch:, stage:, status:} where status is
# one of :terminal :no_branch :on_main :not_merged. A git error leaves on_main
# false, so it NEVER falsely claims "already on main".
def stale_check(task)
  branch = StaleCheck.branch_for(task)
  result = { slug: task["slug"], branch: branch, stage: task["stage"] }
  return result.merge(status: :terminal) if StaleCheck::TERMINAL_STAGES.include?(task["stage"])

  remote_branch = "refs/remotes/origin/#{branch}"
  _ref, exists = git("rev-parse", "--verify", "--quiet", remote_branch)
  on_main = exists && git("merge-base", "--is-ancestor", remote_branch, "refs/remotes/origin/main")[1]
  result.merge(status: StaleCheck.status(task, branch_exists: exists, on_main: on_main))
end

def render_stale(result)
  slug = result[:slug]
  branch = result[:branch]
  case result[:status]
  when :on_main
    puts "⚠  #{slug}: work already on main — origin/#{branch} is an ancestor of origin/main"
    puts "   stage is #{result[:stage]} → consider: bin/task move #{slug} shipped   (or archived)"
  when :not_merged
    puts "#{slug}: origin/#{branch} not yet on main (active — not stale)"
  when :no_branch
    puts "#{slug}: no origin/#{branch} branch to compare — skipped"
  when :terminal
    puts "#{slug}: already #{result[:stage]} — not stale by definition"
  end
end

def refresh_codex_session_title
  return if ENV["CODEX_SESSION_TITLE_RUNNING"] == "1"
  return if ENV["CODEX_THREAD_ID"].to_s.strip.empty?

  script = File.expand_path("codex-session-title", __dir__)
  return unless File.executable?(script)

  system({ "CODEX_SESSION_TITLE_RUNNING" => "1" }, script, out: File::NULL, err: File::NULL)
rescue StandardError
  nil
end

# Genesis trickle-down: the task slug is the single source. Creating/advancing a
# task writes the active-feature marker that bin/statusline (and the terminal
# indicator) read — no worktree required. Worktree sessions override it via their
# own .agent-context.json. Best-effort; never breaks a task command.
def write_feature_marker(task)
  return if ENV["TASK_SKIP_MARKER"] == "1"
  return if Dir.pwd.include?("/.worktrees/")
  path = feature_marker_path
  return if path.nil?
  slug = task["slug"].to_s
  return if slug.empty?

  dv = task.dig("metadata", "devops") || {}
  mascot, mascot_color, mascot_emoji = marker_mascot_attrs(task, path)
  marker = {
    "slug" => slug,
    "task_slug" => slug,
    "app" => Array(dv["repositories"]).first,
    "feature" => dv["worktree_slug"],
    "worktree_slug" => dv["worktree_slug"],
    "task_url" => "#{BASE_URL}/tasks/#{slug}",
    "stage" => task["stage"],
    "mascot" => mascot,             # bin/statusline renders <type-emoji> <mascot> — the session's Pokémon handle
    "mascot_color" => mascot_color, # …tinted with the mascot's least-common type color, riding with the name
    "mascot_emoji" => mascot_emoji, # …and prefixed with its type emoji(s), also riding with the name
    "persona" => dv["persona"],     # present only for a deliberate "act as <soul>" override
    "app_color" => dv["app_color"]  # the app's status-line tint (App#color, stamped server-side by Task#sync_app_identity)
  }.reject { |_, v| v.nil? || v.to_s.strip.empty? }

  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, "#{JSON.pretty_generate(marker)}\n")
  refresh_codex_session_title
rescue StandardError
  nil
end

# The marker's mascot AND its display attributes (color + type emoji), resolved
# TOGETHER so the color/emoji always ride with the name. Returns [mascot, color,
# emoji].
#
# The session's mascot is STICKY — once the per-session marker carries one, a later
# `create`/`move` updates the app/feature/stage context (write_feature_marker) but
# does NOT swap in the MOVED task's mascot. Why: a task's devops carries `mascot`
# (a DEVOPS_KEY) but the board does NOT serve mascot_color/mascot_emoji with it
# (they're server-owned, NOT DEVOPS_KEYS — see Task::DEVOPS_SCALAR_KEYS), so
# adopting a task's mascot dropped bin/statusline to its color/emoji-less pink
# 🛠 ⊙ fallback every time you reviewed someone else's task. The reliable source
# of a mascot WITH its color+emoji is the session marker that `bin/task
# session-mascot` writes from the /sessions/:id/mascot endpoint (which DOES return
# them). So: pin that. Order:
#   1. a PERSONA ("act as <soul>") on this task — a deliberate identity change the
#      server stamped with the soul's name+color+emoji; let it override.
#   2. the last-good on-disk marker — the sticky session mascot (its color/emoji).
#   3. this task response — only when disk has none yet (a fresh session that
#      skipped the session-mascot hook); SessionMascot makes it the session handle
#      anyway, and any missing color/emoji renders clean (never the pink glyphs).
#   4. a best-effort board read (name only).
def marker_mascot_attrs(task, path)
  dv = task.dig("metadata", "devops") || {}
  if FeatureMarker.present?(dv["persona"]) && FeatureMarker.present?(dv["mascot"])
    return [dv["mascot"], dv["mascot_color"], dv["mascot_emoji"]]
  end

  disk = existing_marker(path)
  if disk && FeatureMarker.present?(disk["persona"]) &&
     !FeatureMarker.present?(dv["persona"]) && FeatureMarker.present?(dv["mascot"])
    return [dv["mascot"], dv["mascot_color"], dv["mascot_emoji"]]
  end
  return [disk["mascot"], disk["mascot_color"], disk["mascot_emoji"]] if disk && FeatureMarker.present?(disk["mascot"])

  return [dv["mascot"], dv["mascot_color"], dv["mascot_emoji"]] if FeatureMarker.present?(dv["mascot"])

  [board_mascot(task["slug"]), nil, nil] # a board read carries the name only
end

def existing_marker(path)
  return nil unless path && File.exist?(path)

  JSON.parse(File.read(path))
rescue StandardError
  nil
end

def session_marker_persona
  marker = existing_marker(feature_marker_path)
  persona = marker && marker["persona"].to_s.strip
  persona unless persona.to_s.empty?
end

def default_block_actor(task, kind)
  return "avi" if kind.to_s == "rework" && task.is_a?(Hash) && task["stage"].to_s == "submitted"

  nil
end

def resolved_block_actor(explicit_agent, task, kind: nil)
  explicit = explicit_agent.to_s.strip
  return explicit unless explicit.empty?

  devops = task.is_a?(Hash) ? task.dig("metadata", "devops") : {}
  [session_marker_persona, devops&.fetch("persona", nil), default_block_actor(task, kind)].each do |candidate|
    actor = candidate.to_s.strip
    return actor unless actor.empty?
  end

  ""
end

# The board's devops.mascot, read in a SUBPROCESS via `bin/task field` — never
# in-process. The board read is the last, lowest-priority fallback source, so it
# must NEVER be able to abort the command that's only writing a marker: an
# in-process api() call would, on a transient non-2xx board read, hit api's die!
# → exit 1 → SystemExit, which is NOT a StandardError and so escapes both this
# rescue and write_feature_marker's — killing the move/create AFTER its server
# op already succeeded. Shelling out contains any `exit` in the child (the
# backtick yields "" on a child failure), the same isolation
# bin/agent-worktree.resolve_mascot relies on. `field` is silent + exit 0 when
# the mascot is unset, so a clean "no mascot" reads back as "".
def board_mascot(slug)
  slug = slug.to_s
  return nil if slug.empty?

  mascot = `#{__dir__}/task field #{slug.shellescape} mascot 2>/dev/null`.to_s.strip
  mascot.empty? ? nil : mascot
rescue StandardError
  nil
end

# --- Auto-captured move usage (best-effort) --------------------------------
# Per-(session, slug) baselines of cumulative token usage live under .agents
# (not committed); TASK_USAGE_DIR overrides the dir (tests point it at a tmp
# path). The storage + delta math is shared with bin/release + bin/reviewer-select
# via lib/task_usage_baseline.rb so every move/intent path computes deltas the
# same way.
def usage_dir
  dir = ENV["TASK_USAGE_DIR"].to_s.strip
  dir.empty? ? File.join(PROJECTS_DIR, ".agents", "task-usage") : dir
end

# The baseline store for THIS session, or nil when there's no session (a plain
# shell / CI run has no transcript to diff anyway).
def usage_baseline_for(session, provider: "claude")
  session = session.to_s.strip
  return nil if session.empty?

  TaskUsageBaseline.new(session: session, provider: provider, dir: usage_dir)
end

# Seed the per-(session, slug) baseline from the session's current cumulative
# totals when the session first TOUCHES the task — at CREATE (so the design phase
# is measured), at the build CLAIM (move→building), and at a review/deploy INTENT.
# Idempotent (never resets an in-progress baseline) and best-effort. Seeding here
# is what makes the first real WORK transition record a true delta instead of the
# zeroed first-move baseline (the cause of the model-only Submitted→Reviewed chip,
# and its design-phase twin, the model-only Designed→Building chip).
def seed_usage_baseline(slug)
  session, provider = session_identity
  usage_baseline_for(session, provider: provider)&.seed(slug)
rescue StandardError
  nil
end

# Fill the event's model/tokens/cost from the session transcript (the delta since
# the last touch — claim, intent, or prior move), then advance the baseline. No
# session, no transcript, or no baseline yet → record at most the model; the
# deterministic spine is recorded server-side regardless.
def autofill_move_usage(event, slug)
  session, provider = session_identity
  baseline = usage_baseline_for(session, provider: provider)
  return unless baseline

  capture = baseline.capture_delta(slug)
  return unless capture

  event["model"] = capture.model if capture.model
  return unless capture.usage?

  event["tokens_in"]  = capture.tokens_in
  event["tokens_out"] = capture.tokens_out
  event["cost"]       = format("%.4f", capture.cost) if capture.cost
rescue StandardError
  # A capture failure must degrade to spine-only, never abort the move (and its
  # stage-transition PATCH). The lib swallows IO errors; this is belt-and-braces.
  nil
end

cmd = ARGV.shift || "help"
case cmd
when "list"
  _pos, _sc, _ls, top = parse_flags(ARGV)
  q = []
  q << "stage=#{top["stage"]}" if top["stage"]
  q << "agent_slug=#{top["agent"]}" if top["agent"]
  path = "/api/v1/tasks#{q.empty? ? "" : "?#{q.join("&")}"}"
  tasks = api(:get, path)["data"] || []
  tasks.each { |t| puts "#{t["slug"]}  [#{t["stage"]}]  #{t["title"]}" }
  puts "(#{tasks.size} task(s))"
when "show"
  slug = ARGV.shift || die!("usage: bin/task show <slug> [--json | --verbose|-v]")
  data = api(:get, "/api/v1/tasks/#{slug}")["data"]
  if ARGV.include?("--json")
    # The full fetched record, machine-readable — no curl + auth-token dance.
    puts JSON.pretty_generate(data)
  elsif ARGV.include?("--verbose") || ARGV.include?("-v")
    print_task_verbose(data)
  else
    print_task(data)
  end
when "field"
  # Machine-readable single devops field — e.g. `bin/task field <slug> mascot`.
  # Prints just the value (no decoration) so scripts can capture it; silent +
  # exit 0 when unset, so callers can treat it as optional.
  slug = ARGV.shift || die!("usage: bin/task field <slug> <devops-key>")
  key  = ARGV.shift || die!("usage: bin/task field <slug> <devops-key>")
  value = (api(:get, "/api/v1/tasks/#{slug}")["data"] || {}).dig("metadata", "devops", key)
  print value unless value.nil? || value.is_a?(Enumerable)
when "stale"
  # Flag work that's already on origin/main while its task lags behind (fixed
  # out-of-band). One `git fetch` then a local ancestry check. With a slug, check
  # that one task; with none, scan every open task and list the stale ones.
  slug = ARGV.shift
  git("fetch", "-q", "origin")
  if slug
    render_stale(stale_check(api(:get, "/api/v1/tasks/#{slug}")["data"]))
  else
    tasks = api(:get, "/api/v1/tasks")["data"] || []
    stale = tasks.reject { |t| StaleCheck::TERMINAL_STAGES.include?(t["stage"]) }
                 .map { |t| stale_check(t) }
                 .select { |r| r[:status] == :on_main }
    stale.each { |r| render_stale(r) }
    puts "(#{stale.size} stale task(s) — work on main but not shipped/archived)"
  end
when "create"
  # --no-claim: file the task WITHOUT repointing this session's active-feature
  # marker at it. Filing a task is not building it — a conductor (bin/release)
  # opening a batch of follow-ups must not drag its status line (and its live
  # build-claim) onto each fresh `designed` task. Stripped before parse_flags so
  # it never lands in positionals or the request body.
  no_claim = !ARGV.delete("--no-claim").nil?
  _pos, scalars, lists, top = parse_flags(ARGV)
  die!("create needs --title") unless top["title"]
  devops = stamp_session(build_devops({}, scalars, lists))
  body = top_body(top)
  body["devops"] = devops unless devops.empty?
  task = api(:post, "/api/v1/tasks", body)["data"]
  # Seed the usage baseline at CREATE so the design phase is measured: the first
  # work transition (designed→building) then diffs against the session's totals
  # AT creation and records the real design-phase token delta — instead of the
  # zeroed first-move baseline that dropped the "Designed → Building" card to a
  # model-only chip (TOKENS — / COST —). Same fix shape as the build-claim and
  # intent seeds; idempotent + best-effort, and a no-op without a transcript.
  seed_usage_baseline(task["slug"]) if task.is_a?(Hash) && task["slug"]
  write_feature_marker(task) unless no_claim
  print_task(task)
when "update"
  slug = ARGV.shift || die!("usage: bin/task update <slug> [flags]")
  _pos, scalars, lists, top = parse_flags(ARGV)
  current = api(:get, "/api/v1/tasks/#{slug}")["data"]
  body = top_body(top)
  if scalars.any? || lists.any?
    devops = build_devops(current.dig("metadata", "devops"), scalars, lists)
    body["devops"] = devops
  end
  die!("nothing to update") if body.empty?
  print_task(api(:patch, "/api/v1/tasks/#{slug}", body)["data"])
when "move"
  slug = ARGV.shift || die!("usage: bin/task move <slug> <stage>")
  stage = ARGV.shift || die!("usage: bin/task move <slug> <stage>")
  validate_stage!(stage)
  # Best-effort per-transition usage the agent reports for the work it just did
  # in the stage it's leaving — the optional layer on top of the deterministic
  # from/to/duration spine the server records. Always tags source=cli.
  event = { "source" => "cli" }
  # Attribute this transition to whoever is RUNNING the move (the actual mover),
  # not the build session that claimed the task at `building`. So a CLI
  # reviewed/assembled/shipped move records the mover's session — the server no
  # longer backfills actor from devops_session_id. --actor (below) overrides;
  # a plain shell / CI run (no session) stamps no actor.
  mover_session = session_identity.first
  event["actor"] = mover_session unless mover_session.nil?
  steal = false
  # The builder Pokémon's own size estimate, stamped as it CLAIMS the task at
  # `building` (optional — absent is fine). Set as a top-level Task column.
  dev_size = nil
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--model"      then event["model"]      = ARGV.shift || die!("--model needs a value")
    when "--tokens-in"  then event["tokens_in"]  = (ARGV.shift || die!("--tokens-in needs a value")).to_i
    when "--tokens-out" then event["tokens_out"] = (ARGV.shift || die!("--tokens-out needs a value")).to_i
    when "--cost"       then event["cost"]       = ARGV.shift || die!("--cost needs a value")
    when "--actor"      then event["actor"]      = ARGV.shift || die!("--actor needs a value")
    when "--dev-size"   then dev_size = ARGV.shift || die!("--dev-size needs a value"); validate_size!("--dev-size", dev_size)
    when "--steal"      then steal = true # override the build-claim gate (take a live foreign claim)
    else die!("unknown flag #{flag.inspect} for move (usage flags: --model, --tokens-in, --tokens-out, --cost, --actor, --dev-size, --steal)")
    end
  end
  # No explicit usage flags → auto-capture the per-transition delta (model +
  # tokens + cost) from the session transcript so a bare move still leaves a full
  # paper trail. Best-effort; a missing transcript leaves the event spine-only.
  autofill_move_usage(event, slug) unless %w[model tokens_in tokens_out cost].any? { |k| event.key?(k) }
  body = { "stage" => stage, "event" => event }
  body["dev_size"] = dev_size if dev_size # the builder's estimate, set alongside the stage move
  # Claim the task on the move to building. The gate refuses (loudly, overridable
  # with --steal) when a DIFFERENT live instance already holds it; otherwise it
  # claims/renews the lease. Read-merge-write so the claim + session fields ride
  # alongside existing devops without wiping them (the raw API replaces
  # metadata.devops wholesale). No session → no claim (plain shell / CI degrades).
  if stage == "building" && !mover_session.nil?
    current = api(:get, "/api/v1/tasks/#{slug}")["data"]
    current_devops = current.dig("metadata", "devops") || {}
    enforce_claim_gate!(slug, current_devops, mover_session, steal: steal)
    # Seed the usage baseline at the CLAIM so the build work transition
    # (building→submitted) records a true token delta. Idempotent: a no-op when
    # autofill above already wrote a baseline this move (e.g. a bare move), it
    # matters when explicit usage flags skipped autofill.
    seed_usage_baseline(slug)
    merged = stamp_session(current_devops)
    merged.merge!(ClaimLease.renewed(session: mover_session, nonce: claim_nonce))
    body["devops"] = merged
  end
  task = api(:patch, "/api/v1/tasks/#{slug}", body)["data"]
  write_feature_marker(task)
  print_task(task)
when "intent"
  # Record an INTENT — an agent (or the two senior reviewers) STARTING a stage's
  # work, the moment it begins — so /deployments + the task timeline show who's on
  # it with a live ticker BEFORE the →stage transition lands. Append-only +
  # idempotent server-side within the current source-stage cycle, and a no-op once
  # the target stage landed in that cycle. Leaving the source stage closes the old
  # intent; rework can return a task to `submitted`, where a fresh `→reviewed`
  # intent may open. Used for the Steffon QA (--to assembled --actor
  # steffon) and Avi ship (--to shipped --actor avi) intents; the review pair
  # (--to reviewed) is normally recorded by `bin/reviewer-select` (which records
  # by default).
  slug = ARGV.shift || die!("usage: bin/task intent <slug> --to <stage> [--actor SLUG] [--reviewer slug:weight ...]")
  to_stage = nil
  actor = nil
  reviewers = []
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--to"       then to_stage = ARGV.shift || die!("--to needs a stage")
    when "--actor"    then actor = ARGV.shift || die!("--actor needs a value")
    when "--reviewer"
      raw = ARGV.shift || die!("--reviewer needs slug[:weight]")
      s, w = raw.split(":", 2)
      reviewers << { "slug" => s, "weight" => w }
    else die!("unknown flag #{flag.inspect} for intent (usage flags: --to, --actor, --reviewer)")
    end
  end
  die!("usage: bin/task intent <slug> --to <stage> [--actor SLUG] [--reviewer slug:weight ...]") if to_stage.to_s.empty?
  validate_stage!(to_stage)
  body = { "to_stage" => to_stage, "event" => { "source" => "cli" } }
  body["actor"] = actor if actor
  body["reviewers"] = reviewers if reviewers.any?
  task = api(:post, "/api/v1/tasks/#{slug}/intent", body)["data"]
  # Seed the usage baseline the moment this session STARTS the stage's work (the
  # intent), so the matching work transition (e.g. submitted→reviewed for a
  # reviewer, or a deploy-side move read by bin/release) records a true delta
  # instead of a zeroed first-touch baseline. Best-effort; only after the intent
  # landed server-side.
  seed_usage_baseline(slug)
  crew = [actor, *reviewers.map { |r| "#{r["slug"]}/#{r["weight"]}" }].compact.join(" · ")
  puts "intent recorded on #{slug}: → #{to_stage}#{crew.empty? ? "" : " · #{crew}"}"
  print_task(task) if task
when "heartbeat"
  # The live-terminal lease renewal — bin/statusline calls this each render
  # (throttled) so a crashed/closed session's claim lapses after the TTL and the
  # task becomes reclaimable. Renews THIS instance's claim on <slug> (or adopts an
  # unclaimed/expired one); NEVER steals a live foreign claim. Fully best-effort:
  # no session, no slug, or any API error → silent no-op (a heartbeat must never
  # disrupt the status line). Prints nothing on success.
  slug = ARGV.shift || die!("usage: bin/task heartbeat <slug>")
  begin
    session = session_identity.first
    unless session.nil?
      current = api(:get, "/api/v1/tasks/#{slug}")["data"] || {}
      # The heartbeat renews a BUILD claim, and a build claim only exists once the
      # task is actually `building` — forged solely by an explicit `move building`.
      # A task still in `designed` (or any non-build stage) is unclaimed by
      # definition: `bin/task create` repoints the creator's session marker to the
      # new task, so renewing here would forge a live claim on a task nobody is
      # building (the creator's mascot ticking on an unowned `designed` task). This
      # is the authoritative guard — bin/statusline already skips firing for a
      # non-building per-session marker; this refuses even a stray call.
      if current["stage"] == "building"
        devops = current.dig("metadata", "devops") || {}
        decision = ClaimLease.evaluate(ClaimLease.from_devops(devops), session: session, nonce: claim_nonce)
        unless decision == :held_by_other # don't steal a live foreign claim via a heartbeat
          merged = devops.merge(ClaimLease.renewed(session: session, nonce: claim_nonce))
          api(:patch, "/api/v1/tasks/#{slug}", { "devops" => merged })
        end
      end
    end
  rescue SystemExit, StandardError
    nil # best-effort: swallow API/transport failures
  end
when "session-mascot"
  # Eagerly paint the session's Pokémon mascot onto the per-session marker so
  # bin/statusline shows it in SECONDS — fired by a SessionStart hook, before any
  # task exists. Idempotent server-side (SessionMascot), and the board task adopts
  # the same mascot later. Also works as a manual Codex kickoff:
  #   bin/task session-mascot --print
  #   bin/task session-mascot --persona jasper --print
  #   bin/task session-mascot --persona none --print
  # Best-effort: no session, no marker path, or any API / transport failure →
  # silent no-op unless --print was requested.
  begin
    print_marker = false
    persona = nil
    until ARGV.empty?
      case (arg = ARGV.shift)
      when "--print"
        print_marker = true
      when "--persona"
        persona = ARGV.shift || die!("--persona needs a value")
      else
        die!("unknown flag #{arg.inspect} for session-mascot (use --persona SLUG|none and/or --print)")
      end
    end

    sid = session_identity.first.to_s.strip
    path = feature_marker_path
    unless ENV["TASK_SKIP_MARKER"] == "1" || sid.empty? || path.nil?
      body = {}
      body["parent_session_id"] = parent_session_identity if parent_session_identity
      data = api(:post, "/api/v1/sessions/#{sid}/mascot", body.empty? ? nil : body)["data"]
      if data && !data["mascot"].to_s.strip.empty?
        existing = (JSON.parse(File.read(path)) if File.exist?(path)) || {}
        marker = existing.merge(
          "mascot" => data["mascot"],
          "mascot_color" => data["mascot_color"],
          "mascot_emoji" => data["mascot_emoji"]
        )
        # Seed the DEFAULT app (mcritchie-studio) only when the marker has no app
        # yet — a brand-new session reads "<Pokémon> · mcritchie-studio". Once a task
        # sets the app (write_feature_marker), never override it here.
        if marker["app"].to_s.strip.empty?
          marker["app"] = data["app"]
          marker["app_color"] = data["app_color"]
        end
        raw_persona = persona.to_s.strip
        unless raw_persona.empty?
          if PERSONA_CLEAR.include?(raw_persona.downcase)
            marker.delete("persona")
          else
            agent = api(:get, "/api/v1/agents/#{raw_persona.downcase}")["data"] || {}
            marker["persona"] = raw_persona.downcase
            marker["mascot"] = agent["name"].to_s.strip.empty? ? raw_persona : agent["name"]
            marker["mascot_color"] = agent["status_color"] || agent.dig("metadata", "color")
            marker["mascot_emoji"] = agent["emoji"] || agent.dig("metadata", "emoji")
          end
        end
        marker = marker.reject { |_, v| v.nil? || v.to_s.strip.empty? }
        FileUtils.mkdir_p(File.dirname(path))
        File.write(path, "#{JSON.pretty_generate(marker)}\n")
        refresh_codex_session_title
        print_session_marker(marker) if print_marker
      end
    end
  rescue SystemExit, StandardError
    nil # best-effort: never disrupt session start
  end
when "block"
  slug = ARGV.shift || die!("usage: bin/task block <slug> [--kind environment|rework|dependency] [--feedback \"...\"] [--agent A]")
  kind = feedback = agent = nil
  i = 0
  while i < ARGV.length
    case ARGV[i]
    when "--kind"     then kind = ARGV[i + 1] || die!("--kind needs a value"); i += 2
    when "--feedback" then feedback = ARGV[i + 1] || die!("--feedback needs a value"); i += 2
    when "--agent"    then agent = ARGV[i + 1] || die!("--agent needs a value"); i += 2
    else die!("unknown flag #{ARGV[i].inspect} for block (one of: --kind, --feedback, --agent)")
    end
  end
  die!("--kind must be one of: #{BLOCK_KINDS.join(", ")}") if kind && !BLOCK_KINDS.include?(kind)
  current = api(:get, "/api/v1/tasks/#{slug}")["data"]
  devops = (current.dig("metadata", "devops") || {}).dup
  devops["block_kind"] = kind if kind
  event = { "source" => "cli" }
  blocker = resolved_block_actor(agent, current, kind: kind)
  event["actor"] = blocker unless blocker.empty?
  autofill_move_usage(event, slug) unless %w[model tokens_in tokens_out cost].any? { |k| event.key?(k) }
  body = { "stage" => "blocked", "event" => event }
  body["devops"] = devops unless devops.empty?
  task = api(:patch, "/api/v1/tasks/#{slug}", body)["data"]
  if feedback
    note = { "task_slug" => slug, "activity_type" => "qa_feedback", "description" => feedback }
    note["agent_slug"] = blocker unless blocker.empty?
    api(:post, "/api/v1/activities", note)
    puts "noted [qa_feedback] on #{slug}"
  end
  write_feature_marker(task)
  print_task(task)
when "note"
  slug = ARGV.shift || die!("usage: bin/task note <slug> --handoff|--qa-feedback|--comment \"...\" [--agent A]")
  notes = []
  agent = nil
  i = 0
  while i < ARGV.length
    arg = ARGV[i]
    if NOTE_FLAGS.key?(arg)
      desc = ARGV[i + 1] || die!("#{arg} needs a value")
      notes << [NOTE_FLAGS[arg], desc]
      i += 2
    elsif arg == "--agent"
      agent = ARGV[i + 1] || die!("--agent needs a value")
      i += 2
    else
      die!("unknown flag #{arg.inspect} for note (one of: #{NOTE_FLAGS.keys.join(", ")} [--agent A])")
    end
  end
  die!("note needs one of: #{NOTE_FLAGS.keys.join(", ")}") if notes.empty?
  notes.each do |activity_type, description|
    body = { "task_slug" => slug, "activity_type" => activity_type, "description" => description }
    body["agent_slug"] = agent if agent
    activity = api(:post, "/api/v1/activities", body)["data"] || {}
    puts "noted [#{activity_type}] on #{slug} -> #{activity["slug"] || "(created)"}"
  end
else
  warn!(File.read(__FILE__)[/# Usage:.*?(?=\nrequire)/m].to_s.gsub(/^# ?/, ""))
  exit(cmd == "help" ? 0 : 1)
end
