<% content_for(:title, "Distillation Pipeline · Alex Heartbeat") %>
<% content_for(:full_width, true) %>

<%# The OPSD distillation pipeline as three columns, left→right:
    1. ACTIVITIES    — recent narrated activities
    2. INSIGHTS      — Alex's banked grades (the distilled lessons)
    3. CONFIRMATIONS — Mr. McRitchie's mcr grades (the confirmed subset)
    Reuses the heartbeat surface (hb-* styles, category meta, agent cell). %>
<%= render "heartbeat/styles" %>

<style>
  #alex-heartbeat { --hb-bg:#0d1117; --hb-panel:#161b22; --hb-line:#2a3240; --hb-txt:#e6edf3;
    --hb-muted:#8b949e; --hb-faint:#5c6573; --hb-accent:#58a6ff; --hb-good:#3fb950;
    --hb-not:#f85149; --hb-bank:#fbbf24; --hb-mcr:#a371f7;
    min-height:calc(100vh - var(--nav-h, 7rem)); background:var(--hb-bg); color:var(--hb-txt);
    padding:18px 22px 60px; font-size:13px; line-height:1.5; }
  #alex-heartbeat .pl-topbar { display:flex; align-items:flex-end; justify-content:space-between; gap:16px; flex-wrap:wrap; border-bottom:1px solid var(--hb-line); padding-bottom:14px; margin-bottom:18px; }
  #alex-heartbeat h1 { margin:0; font-size:19px; font-weight:700; }
  #alex-heartbeat .pl-sub { margin:4px 0 0; color:var(--hb-muted); font-size:12.5px; max-width:78ch; }
  #alex-heartbeat .pl-nav { display:flex; gap:8px; flex-wrap:wrap; }
  #alex-heartbeat .pl-grid { display:grid; grid-template-columns:repeat(3, 1fr); gap:14px; align-items:start; }
  @media (max-width:1000px) { #alex-heartbeat .pl-grid { grid-template-columns:1fr; } }
  #alex-heartbeat .pl-col { background:var(--hb-panel); border:1px solid var(--hb-line); border-radius:12px; overflow:hidden; }
  #alex-heartbeat .pl-colhd { padding:12px 14px; border-bottom:1px solid var(--hb-line); position:sticky; top:0; background:var(--hb-panel); z-index:1; }
  #alex-heartbeat .pl-colhd .pl-step { font-family:ui-monospace,"SF Mono",Menlo,monospace; font-size:10px; letter-spacing:.14em; text-transform:uppercase; color:var(--hb-faint); }
  #alex-heartbeat .pl-colhd h2 { margin:2px 0 0; font-size:14px; font-weight:700; display:flex; align-items:center; gap:8px; }
  #alex-heartbeat .pl-colhd .pl-count { color:var(--hb-faint); font-weight:500; font-size:12px; }
  #alex-heartbeat .pl-list { max-height:calc(100vh - 230px); overflow-y:auto; }
  #alex-heartbeat .pl-row { padding:11px 14px; border-bottom:1px solid var(--hb-line); }
  #alex-heartbeat .pl-row:last-child { border-bottom:none; }
  #alex-heartbeat .pl-row.is-not { box-shadow:inset 3px 0 0 var(--hb-not); }
  /* top of the row: narration on the left, the agent cell aligned TOP-RIGHT */
  #alex-heartbeat .pl-rowtop { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; }
  #alex-heartbeat .pl-main { flex:1; min-width:0; }
  #alex-heartbeat .pl-agent { flex-shrink:0; }
  #alex-heartbeat .pl-narr { font-weight:600; font-size:13px; margin:4px 0 0; }
  #alex-heartbeat .pl-out { color:var(--hb-muted); font-size:12px; margin:2px 0 0; }
  #alex-heartbeat .pl-out::before { content:"→ "; color:var(--hb-faint); }
  #alex-heartbeat .pl-meta { display:flex; align-items:center; gap:10px; margin-top:8px; }
  #alex-heartbeat .pl-cost { font-family:ui-monospace,"SF Mono",Menlo,monospace; font-size:11.5px; color:var(--hb-muted); }
  #alex-heartbeat .pl-notpill { font-size:9.5px; font-weight:700; letter-spacing:.5px; text-transform:uppercase; color:var(--hb-not); border:1px solid var(--hb-not); border-radius:5px; padding:1px 6px; }
  /* the reused hb-* components (category badge, nav buttons, agent cell) are styled
     by the shared _styles partial, which scopes every rule under #alex-heartbeat —
     so this page's ROOT is #alex-heartbeat (below), giving all of them their real
     styling instead of re-scoping each rule by hand. */
  #alex-heartbeat .pl-slug { font-weight:600; font-size:13.5px; }
  #alex-heartbeat .pl-disp { font-size:9.5px; font-weight:700; letter-spacing:.5px; padding:1px 7px; border-radius:5px; border:1px solid currentColor; text-transform:uppercase; margin-left:6px; }
  #alex-heartbeat .pl-disp.good { color:var(--hb-good); } #alex-heartbeat .pl-disp.not { color:var(--hb-not); }
  #alex-heartbeat .pl-long { color:var(--hb-muted); font-size:12px; margin:6px 0 0; white-space:pre-wrap; }
  #alex-heartbeat .pl-from { color:var(--hb-faint); font-size:11px; margin-top:6px; }
  #alex-heartbeat .pl-confirm { margin-top:9px; }
  #alex-heartbeat .pl-confirm button { font:inherit; font-size:11.5px; font-weight:600; color:var(--hb-mcr); background:transparent; border:1px solid var(--hb-mcr); border-radius:7px; padding:4px 12px; cursor:pointer; }
  #alex-heartbeat .pl-confirm button:hover { background:color-mix(in srgb, var(--hb-mcr) 16%, transparent); }
  #alex-heartbeat .pl-confirmed { margin-top:8px; font-size:11px; color:var(--hb-mcr); font-weight:600; }
  #alex-heartbeat .pl-confirmed::before { content:"✓ "; }
  #alex-heartbeat .pl-empty { color:var(--hb-faint); font-size:12px; padding:26px 16px; text-align:center; }
  #alex-heartbeat .pl-flash { margin-bottom:14px; padding:9px 14px; border-radius:9px; font-size:12.5px; border:1px solid var(--hb-line); background:var(--hb-panel); color:var(--hb-good); }
  /* Candidates band — block-mined "not" grades awaiting promotion, sitting above the
     three-column loop as its newest raw material (a resolved QA block → a lesson). */
  #alex-heartbeat .pl-cands { margin-bottom:18px; border:1px solid var(--hb-not); border-radius:12px; overflow:hidden; background:var(--hb-panel); }
  #alex-heartbeat .pl-cands .pl-colhd { border-bottom:1px solid var(--hb-line); }
  #alex-heartbeat .pl-cands .pl-colhd h2 { color:var(--hb-not); }
  #alex-heartbeat .pl-cands .pl-list { display:grid; grid-template-columns:repeat(auto-fill, minmax(280px, 1fr)); gap:0; max-height:none; }
  #alex-heartbeat .pl-cands .pl-row { border-right:1px solid var(--hb-line); box-shadow:inset 3px 0 0 var(--hb-not); }
</style>

<section id="alex-heartbeat" data-test="alex-pipeline">
  <header class="pl-topbar">
    <div>
      <h1>&#127869;&#65039; Distillation Pipeline</h1>
      <p class="pl-sub">
        The learning loop, left to right: narrated <strong>Activities</strong> &rarr; Alex's
        distilled <strong>Insights</strong> &rarr; the <strong>Confirmations</strong> you keep.
        Confirm an insight to promote it toward the docs.
      </p>
    </div>
    <nav class="pl-nav">
      <%= render "heartbeat/nav", current: :pipeline, insights_count: @insights.size %>
    </nav>
  </header>

  <% if notice.present? %><div class="pl-flash" data-test="pl-flash"><%= notice %></div><% end %>
  <% if alert.present? %><div class="pl-flash" style="color:var(--hb-not)"><%= alert %></div><% end %>

  <%# ── Candidates awaiting grade · block-mined "not" grades ─────────────────
      Each is a resolved QA block (a pre-labeled failure) the miner tied to the
      activity that caused it. Read-only surfacing: grade/bank it from the activity's
      heartbeat drawer to promote it into Column 2. %>
  <% if @candidates.present? %>
    <section class="pl-cands" data-test="pl-candidates">
      <div class="pl-colhd">
        <div class="pl-step">Mined from blocks</div>
        <h2>&#9935; Candidates awaiting grade <span class="pl-count"><%= @candidates.size %> from resolved blocks</span></h2>
      </div>
      <div class="pl-list">
        <% @candidates.each do |cand| %>
          <% activity = cand.agent_activity %>
          <div class="pl-row" data-test="pl-candidate" data-source-activity="<%= cand.source_activity_slug %>">
            <div>
              <span class="pl-slug"><%= cand.slug %></span>
              <span class="pl-disp not"><%= cand.disposition.upcase %></span>
            </div>
            <% if cand.long_form.present? %><p class="pl-long"><%= cand.long_form %></p><% end %>
            <% if activity&.task_slug.present? %>
              <p class="pl-from">
                block on <%= activity.task_slug %> &middot;
                <%= link_to "grade activity", heartbeat_activity_feedback_path(activity.id), data: { test: "pl-candidate-grade" } %>
              </p>
            <% end %>
          </div>
        <% end %>
      </div>
    </section>
  <% end %>

  <div class="pl-grid">
    <%# ── Column 1 · Activities ──────────────────────────────────────────── %>
    <div class="pl-col" id="col-actions">
      <div class="pl-colhd">
        <div class="pl-step">Column 1</div>
        <h2>&#128451; Activities <span class="pl-count"><%= @activity_rows.size %></span></h2>
      </div>
      <div class="pl-list">
        <% if @activity_rows.empty? %>
          <div class="pl-empty">No activities yet.</div>
        <% end %>
        <% @activity_rows.each do |activity, actions| %>
          <% cat = heartbeat_category_meta(activity.category) %>
          <% alex_grade = @activity_grades.dig(activity.id, "alex") %>
          <% is_not = alex_grade&.not_good? %>
          <% cost = heartbeat_usage_totals(actions)[:cost] %>
          <div class="pl-row <%= "is-not" if is_not %>" data-test="pl-activity" data-activity-id="<%= activity.id %>">
            <div class="pl-rowtop">
              <div class="pl-main">
                <span class="hb-chip hb-catchip" style="color: <%= cat[:accent] %>" title="<%= cat[:description] %>"><%= activity.category %></span>
                <p class="pl-narr"><%= activity.reason_slug %></p>
                <% if activity.outcome_slug.present? %><p class="pl-out"><%= activity.outcome_slug %></p><% end %>
              </div>
              <div class="pl-agent">
                <%= heartbeat_agent_cell(mascot_slug: activity.mascot, pokemon: @pokemon_by_slug[activity.mascot],
                                         agent_slug: activity.agent, agent: @agents_by_slug[activity.agent]) %>
              </div>
            </div>
            <div class="pl-meta">
              <% if is_not %><span class="pl-notpill" data-test="pl-not" title="Alex graded this NOT">not</span><% end %>
              <span class="pl-cost"><%= cost.positive? ? number_to_currency(cost, precision: 4) : "—" %></span>
            </div>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Column 2 · Insights (Alex's banked grades) ─────────────────────── %>
    <div class="pl-col" id="col-insights">
      <div class="pl-colhd">
        <div class="pl-step">Column 2</div>
        <h2>&#128161; Insights <span class="pl-count"><%= @insights.size %> distilled</span></h2>
      </div>
      <div class="pl-list">
        <% if @insights.empty? %>
          <div class="pl-empty">No insights yet — Alex banks them with <code>grade-events</code>.</div>
        <% end %>
        <% @insights.each do |insight| %>
          <% activity_id = insight.agent_activity_id %>
          <% confirmed = activity_id && @confirmed_activity_ids.include?(activity_id) %>
          <div class="pl-row" data-test="pl-insight">
            <div>
              <span class="pl-slug"><%= insight.slug %></span>
              <span class="pl-disp <%= insight.good? ? "good" : "not" %>"><%= insight.disposition.upcase %></span>
            </div>
            <% if insight.long_form.present? %><p class="pl-long"><%= insight.long_form %></p><% end %>
            <% src = insight.agent_activity || insight.agent_action %>
            <% if src&.task_slug.present? %><p class="pl-from">from <%= src.task_slug %></p><% end %>
            <% if confirmed %>
              <div class="pl-confirmed" data-test="pl-insight-confirmed">Confirmed</div>
            <% elsif activity_id %>
              <div class="pl-confirm">
                <%= button_to "Confirm", alex_pipeline_confirm_path(activity_id),
                      params: { slug: insight.slug }, data: { test: "pl-confirm-btn" } %>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <%# ── Column 3 · Confirmations (McRitchie's mcr grades) ──────────────── %>
    <div class="pl-col" id="col-confirmations">
      <div class="pl-colhd">
        <div class="pl-step">Column 3</div>
        <h2>&#9989; Confirmations <span class="pl-count"><%= @confirmations.size %> kept</span></h2>
      </div>
      <div class="pl-list">
        <% if @confirmations.empty? %>
          <div class="pl-empty">Nothing confirmed yet — Confirm an insight in column 2.</div>
        <% end %>
        <% @confirmations.each do |conf| %>
          <div class="pl-row" data-test="pl-confirmation">
            <div><span class="pl-slug"><%= conf.slug %></span></div>
            <% if conf.long_form.present? %><p class="pl-long"><%= conf.long_form %></p><% end %>
            <% src = conf.agent_activity || conf.agent_action %>
            <% if src&.task_slug.present? %><p class="pl-from">from <%= src.task_slug %></p><% end %>
          </div>
        <% end %>
      </div>
    </div>
  </div>
</section>
