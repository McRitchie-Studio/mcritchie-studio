<% content_for(:title, "Email analytics") %>
<% s = @summary %>
<div class="max-w-6xl mx-auto px-4 py-8 space-y-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h1 class="text-2xl font-extrabold text-heading">Email analytics</h1>
      <p class="text-secondary text-sm mt-1">
        <%= @broadcast ? "“#{@broadcast.subject}”" : "Every broadcast" %> ·
        opens and clicks count people; programs that fake a read are counted apart.
      </p>
    </div>
    <%= form_with url: broadcast_analytics_path, method: :get, class: "flex flex-wrap items-center gap-2 min-w-0 max-w-full" do %>
      <label for="broadcast" class="text-sm text-secondary">Email</label>
      <select id="broadcast" name="broadcast" class="input-field min-w-0 max-w-full">
        <option value="">All broadcasts</option>
        <% @broadcasts.each do |b| %>
          <option value="<%= b.slug %>" <%= "selected" if @broadcast == b %>><%= b.subject.presence || b.slug %></option>
        <% end %>
      </select>
      <button class="btn btn-secondary">Show</button>
    <% end %>
  </div>

  <% if @unknown_filter %>
    <p class="card p-3 border border-warning/40 bg-warning/10 text-warning-ink text-sm break-words" role="status" data-unknown-filter>
      No email is called “<%= params[:broadcast] %>”, so this shows every broadcast.
    </p>
  <% end %>

  <%# Health: the two numbers Resend suspends a sender over. %>
  <section aria-labelledby="health-heading">
    <h2 id="health-heading" class="text-sm font-semibold uppercase tracking-widest text-muted mb-2">Sending health</h2>
    <div class="grid gap-3 sm:grid-cols-3">
      <% [ [ "Bounce rate", s.bounce_rate, Broadcasts::Analytics::BOUNCE, "#{s.bounced} of #{s.sent} sent (#{s.hard_bounced} hard)" ],
           [ "Complaint rate", s.complaint_rate, Broadcasts::Analytics::COMPLAINT, "#{s.complained} marked as spam" ] ].each do |label, rate, limits, detail| %>
        <% h = analytics_health(Broadcasts::Analytics.health(rate, limits)) %>
        <div class="card p-4 border <%= h[:classes] %>" data-health="<%= label.parameterize %>">
          <div class="flex items-center justify-between text-sm font-semibold">
            <span><%= label %></span>
            <span><span aria-hidden="true"><%= h[:icon] %></span> <%= h[:word] %></span>
          </div>
          <div class="text-3xl font-extrabold text-heading mt-1"><%= analytics_pct(rate) %></div>
          <p class="text-xs text-secondary mt-1"><%= detail %> · Resend's limit <%= analytics_pct(limits[:limit]) %></p>
        </div>
      <% end %>
      <div class="card p-4">
        <div class="text-sm font-semibold text-heading">Gmail spam rate</div>
        <p class="text-sm text-secondary mt-1">
          Gmail reports complaints only in aggregate, in Postmaster Tools. Keep it under 0.1%; 0.3% is Gmail's limit.
        </p>
        <%= link_to "Open Postmaster Tools", "https://postmaster.google.com", target: "_blank", rel: "noopener", class: "text-primary underline text-sm" %>
      </div>
    </div>
  </section>

  <%# The funnel: one hue, each bar a share of the emails sent. %>
  <section class="card p-4" aria-labelledby="funnel-heading">
    <h2 id="funnel-heading" class="text-sm font-semibold uppercase tracking-widest text-muted mb-3">Funnel</h2>
    <% steps = [ [ "Sent", s.sent, nil ], [ "Delivered", s.delivered, s.rate(s.delivered, s.sent) ],
                 [ "Opened (people)", s.human_opened, s.open_rate ], [ "Clicked (people)", s.human_clicked, s.click_rate ] ] +
               s.results.map { |goal, n| [ analytics_goal_label(goal), n, s.result_rate(goal) ] } %>
    <dl class="space-y-2">
      <% steps.each do |label, count, rate| %>
        <% width = s.sent.zero? ? 0 : (100.0 * count / s.sent).clamp(0, 100) %>
        <div class="grid grid-cols-[10rem_1fr_7rem] items-center gap-3 text-sm" title="<%= label %>: <%= number_with_delimiter(count) %><%= " · #{analytics_pct(rate)}" if rate %>">
          <dt class="text-secondary"><%= label %></dt>
          <dd class="h-3 rounded bg-surface-alt overflow-hidden"><div class="h-full rounded bg-primary" style="width: <%= width.round(1) %>%"></div></dd>
          <dd class="text-right tabular-nums text-heading"><%= number_with_delimiter(count) %> <span class="text-muted"><%= analytics_pct(rate) if rate %></span></dd>
        </div>
      <% end %>
    </dl>
    <p class="text-xs text-muted mt-3">
      Also: <%= number_with_delimiter(s.machine_only_opened) %> opens and <%= number_with_delimiter(s.machine_only_clicked) %> clicks by programs only ·
      <%= number_with_delimiter(s.unsubscribed) %> unsubscribed (<%= analytics_pct(s.unsubscribe_rate) %>) ·
      click-to-open <%= analytics_pct(s.click_to_open_rate) %>. Opens are a rough guide: Apple Mail loads every image in advance.
    </p>
  </section>

  <%= render "table", title: "By email", key: "Email", rows: @analytics.by_broadcast.map { |b, sum| [ link_to(b.subject.presence || b.slug, broadcast_analytics_path(broadcast: b.slug), class: "text-primary underline"), sum ] } unless @broadcast %>
  <%= render "table", title: "By send day (UTC)", key: "Day", rows: @analytics.by_send_day.map { |day, sum| [ day.strftime("%a %b %-d, %Y"), sum ] } %>
  <%= render "table", title: "By mailbox provider", key: "Provider", rows: @analytics.by_provider %>

  <div class="grid gap-6 md:grid-cols-2">
    <section class="card overflow-hidden" aria-labelledby="links-heading">
      <h2 id="links-heading" class="text-sm font-semibold uppercase tracking-widest text-muted p-4 pb-2">Clicks by link</h2>
      <div class="overflow-x-auto">
      <table class="w-full text-sm">
        <thead class="text-secondary border-b border-subtle"><tr><th class="text-left p-3">Link</th><th class="text-right p-3">People</th><th class="text-right p-3">Programs</th></tr></thead>
        <tbody>
          <% links = @analytics.by_link %>
          <% if links.empty? %><tr><td colspan="3" class="p-3 text-secondary">No clicks yet.</td></tr><% end %>
          <% links.each do |key, people, machines| %>
            <tr class="border-b border-subtle/50"><td class="p-3 text-heading break-all"><%= key %></td><td class="p-3 text-right tabular-nums"><%= number_with_delimiter(people) %></td><td class="p-3 text-right tabular-nums text-muted"><%= number_with_delimiter(machines) %></td></tr>
          <% end %>
        </tbody>
      </table>
      </div>
    </section>

    <section class="card p-4" aria-labelledby="list-heading">
      <h2 id="list-heading" class="text-sm font-semibold uppercase tracking-widest text-muted mb-2">List health</h2>
      <% list = @analytics.list_health %>
      <dl class="grid grid-cols-2 gap-y-1 text-sm">
        <dt class="text-secondary">Contacts</dt><dd class="text-right tabular-nums text-heading"><%= number_with_delimiter(list[:total]) %></dd>
        <dt class="text-secondary">Subscribed</dt><dd class="text-right tabular-nums text-heading"><%= number_with_delimiter(list[:subscribed]) %></dd>
        <% list[:unsubscribed].sort.each do |reason, count| %>
          <dt class="text-secondary">Off the list: <%= { "requested" => "unsubscribed", "bounced" => "hard bounce", "complained" => "spam complaint" }.fetch(reason, reason) %></dt>
          <dd class="text-right tabular-nums text-heading"><%= number_with_delimiter(count) %></dd>
        <% end %>
      </dl>
    </section>
  </div>
</div>
