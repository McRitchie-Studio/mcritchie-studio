<% content_for :title, "Contact · McRitchie Studio" %>
<%# The SMS opt-in page a carrier reviews. The checkbox labels and the three
    paragraphs under the form are fixed wording held in ContactSubmission, and
    no box may ever render ticked on a fresh page. %>

<section class="max-w-2xl mx-auto px-4 py-10" data-test="contact-page">
  <header class="text-center mb-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Contact</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-heading mb-3">Get in touch</h1>
    <p class="text-secondary">Send a note and Alex will reply by email.</p>
  </header>

  <% if flash[:contact_sent] %>
    <div class="card p-5 mb-6 border border-subtle bg-surface-alt" role="status" data-test="contact-sent">
      <h2 class="text-heading font-semibold mb-1">Thanks, your message is on its way.</h2>
      <p class="text-secondary text-sm">We will reply to the email address you gave us.</p>
      <% if flash[:contact_sent] == "sms" %>
        <p class="text-muted text-sm mt-2" data-test="contact-sent-sms">You are signed up for text messages from <%= ContactSubmission::SMS_NUMBER %>. Msg frequency varies. Msg &amp; data rates may apply. Reply HELP for help. Reply STOP to cancel.</p>
      <% end %>
    </div>
  <% end %>

  <div class="card p-6"
       x-data="{ care: <%= @submission.sms_care_consent? %>, marketing: <%= @submission.sms_marketing_consent? %>, declined: <%= @submission.sms_declined? %> }">
    <%= form_with model: @submission, scope: :contact_submission, url: contact_path, method: :post,
                  html: { class: "space-y-5", data: { test: "contact-form" } } do |f| %>
      <% if @submission.errors.any? %>
        <div class="rounded-lg border border-subtle bg-surface-alt p-4" role="alert" data-test="contact-errors">
          <p class="text-heading font-semibold mb-1">Please fix the following:</p>
          <ul class="list-disc pl-5 text-sm text-secondary space-y-1">
            <% @submission.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= f.label :name, "Name", class: "block text-sm font-semibold text-heading mb-1" %>
        <%= f.text_field :name, required: true, maxlength: ContactSubmission::NAME_LIMIT, autocomplete: "name", class: "input-field w-full" %>
      </div>

      <div>
        <%= f.label :email, "Email", class: "block text-sm font-semibold text-heading mb-1" %>
        <%= f.email_field :email, required: true, maxlength: ContactSubmission::EMAIL_LIMIT, autocomplete: "email", class: "input-field w-full" %>
      </div>

      <div>
        <%= f.label :phone, "Mobile phone number", class: "block text-sm font-semibold text-heading mb-1" %>
        <%= f.telephone_field :phone, maxlength: ContactSubmission::PHONE_LIMIT, autocomplete: "tel", class: "input-field w-full",
                              "aria-describedby": "contact-phone-hint", ":required": "care || marketing" %>
        <p id="contact-phone-hint" class="text-xs text-muted mt-1">Optional. Needed only if you choose to receive text messages below.</p>
      </div>

      <div>
        <%= f.label :message, "Message", class: "block text-sm font-semibold text-heading mb-1" %>
        <%= f.text_area :message, required: true, rows: 5, maxlength: ContactSubmission::MESSAGE_LIMIT, class: "input-field w-full" %>
      </div>

      <%# Off-screen, unlabelled for people: only a script fills this in. %>
      <div style="position:absolute;left:-9999px;top:auto;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
        <label for="contact_submission_company_url">Leave this field empty</label>
        <input type="text" name="contact_submission[company_url]" id="contact_submission_company_url" tabindex="-1" autocomplete="off" data-test="contact-honeypot">
      </div>

      <fieldset class="space-y-3" data-test="contact-consent">
        <legend class="text-sm font-semibold text-heading mb-2">Text messages</legend>
        <label class="flex items-start gap-3 text-secondary">
          <%= f.check_box :sms_care_consent, { class: "mt-1", "x-model": "care", "@change": "if (care) declined = false", data: { test: "consent-care" } } %>
          <span><%= ContactSubmission::CONSENT_LABELS[:sms_care_consent] %></span>
        </label>
        <label class="flex items-start gap-3 text-secondary">
          <%= f.check_box :sms_marketing_consent, { class: "mt-1", "x-model": "marketing", "@change": "if (marketing) declined = false", data: { test: "consent-marketing" } } %>
          <span><%= ContactSubmission::CONSENT_LABELS[:sms_marketing_consent] %></span>
        </label>
        <label class="flex items-start gap-3 text-secondary">
          <%= f.check_box :sms_declined, { class: "mt-1", "x-model": "declined", "@change": "if (declined) { care = false; marketing = false }", data: { test: "consent-declined" } } %>
          <span><%= ContactSubmission::CONSENT_LABELS[:sms_declined] %></span>
        </label>
      </fieldset>

      <%= f.submit "Send message", class: "btn btn-primary w-full sm:w-auto", data: { test: "contact-submit" } %>
    <% end %>

    <div class="mt-6 pt-6 border-t border-subtle space-y-3 text-sm text-muted leading-relaxed" data-test="sms-disclosure">
      <% ContactSubmission::DISCLOSURE_PARAGRAPHS.each do |paragraph| %>
        <% before, url, after = paragraph.partition(ContactSubmission::PRIVACY_URL) %>
        <p><%= before %><% if url.present? %><%= link_to url, privacy_path, class: "text-primary hover:underline" %><% end %><%= after %></p>
      <% end %>
    </div>
  </div>
</section>
