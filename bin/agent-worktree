PROJECTS_DIR = File.expand_path(ENV.fetch("PROJECTS_DIR") { ProjectsRoot.default_projects_dir })
HUB_DIR = File.join(PROJECTS_DIR, "mcritchie-studio")
STACK_ENV = ".env.agent-stack"
CONTEXT_FILE = ".agent-context.json"
TASK_BASE_URL = ENV.fetch("AGENT_TASK_BASE_URL", "https://mcritchie.studio/tasks")
# Bound the board read behind the build-claim guard (claim_hold): a hung or black-holed
# board must never stall a cleanup sweep. A timeout reads as a failed record, so the guard
# fails open (and warns). A malformed override falls back to the default rather than
# raising at load — a bad env var must not kill read-only subcommands like `list`.
# Clamped to a positive minimum: a 0 or negative value would make wait_thr.join(0) return
# nil instantly, so EVERY board read would "time out" and the guard would silently disable
# itself — the exact failure mode this whole guard exists to prevent.
TASK_READ_TIMEOUT =
  begin
    [Integer(ENV.fetch("AGENT_WORKTREE_TASK_TIMEOUT", "10")), 1].max
  rescue ArgumentError, TypeError
    10
  end
SHINY_EMOJI = "✨"
AGENT_CONTEXT_EXPORTS = %w[
  AGENT_CONTEXT_APP
  AGENT_CONTEXT_TASK
  AGENT_CONTEXT_WORKTREE_SLUG
  AGENT_CONTEXT_TASK_RECORD
  AGENT_CONTEXT_TASK_URL
  AGENT_CONTEXT_PORT
  AGENT_CONTEXT_URL
  AGENT_CONTEXT_TITLE
  AGENT_CONTEXT_BADGE
].freeze

# Worktree Redis bands separate physical capacity (Redis `databases`, fixed at
# startup) from a soft, restart-free band the launcher allocates from.
#   physical capacity  -> Redis `databases` (changing it needs a restart)
#   soft band          -> DBs redis_db_min .. redis_db_min + current_capacity - 1
# The band idles at FLOOR slots, grows by STEP when exhausted (while physical
# room remains), and shrinks by STEP (never below FLOOR) as worktrees close.
DEFAULT_REDIS_MIN_DB = 9
# Legacy stock Redis ships 16 databases (0-15). Used as the conservative
# physical fallback when redis-cli cannot be reached.
DEFAULT_REDIS_MAX_DB = 15
REDIS_BAND_FLOOR = Integer(ENV.fetch("AGENT_REDIS_FLOOR", "20"))
REDIS_BAND_STEP = Integer(ENV.fetch("AGENT_REDIS_STEP", "10"))
# Physical `databases` target for `scale --provision`. 64 leaves ~55 band slots
# above the DB-9 band start with plenty of headroom for primary apps on 0-8.
DEFAULT_REDIS_PHYSICAL_TARGET = 64

