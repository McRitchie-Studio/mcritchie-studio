<% content_for :title, "Packages · McRitchie Studio" %>
<% discount = WorkspacePackage.annual_discount_percent %>

<section class="max-w-7xl mx-auto px-4 py-10" data-test="packages-page">
  <header class="text-center mb-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Packages</p>
    <h1 class="text-3xl sm:text-4xl font-bold text-heading mb-3">From your first app to a connected company</h1>
    <p class="text-muted max-w-2xl mx-auto">
      Start free with an app our agents build for you, then add your own domain, your email and a
      marketing team as you grow. Each tier includes everything in the one before it.
    </p>
  </header>

  <div x-data="{ annual: false }">
    <% if discount.positive? %>
      <div class="flex justify-center mb-8" data-test="billing-toggle">
        <div class="inline-flex rounded-full border border-subtle bg-surface p-1 text-sm font-semibold">
          <button type="button" class="rounded-full px-4 py-1.5" :class="annual ? 'text-muted' : 'bg-primary text-white'" @click="annual = false"
                  aria-pressed="true" :aria-pressed="annual ? 'false' : 'true'" data-test="billing-monthly">Monthly</button>
          <button type="button" class="rounded-full px-4 py-1.5" :class="annual ? 'bg-primary text-white' : 'text-muted'" @click="annual = true"
                  aria-pressed="false" :aria-pressed="annual ? 'true' : 'false'" data-test="billing-annual">
            Annual <span class="ml-1 text-xs" :class="annual ? 'text-white' : 'text-primary'">save <%= discount %>%</span>
          </button>
        </div>
      </div>
    <% end %>

    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-4" data-test="package-cards">
      <% previous = nil %>
      <% @packages.each do |package| %>
        <article class="relative flex flex-col rounded-2xl border <%= package.featured? ? 'border-primary border-2 shadow-lg' : 'border-subtle' %> bg-surface p-6"
                 data-test="package-card" data-package="<%= package.key %>" data-featured="<%= package.featured? %>">
          <% if package.featured? %>
            <span class="absolute -top-3 left-6 rounded-full bg-primary px-3 py-0.5 text-xs font-semibold uppercase tracking-wide text-white"
                  data-test="featured-badge">Most popular</span>
          <% end %>
          <h2 class="text-2xl font-bold text-heading"><%= package.name %></h2>
          <p class="mt-1 min-h-[3rem] text-body" data-test="package-tagline"><%= package.tagline %></p>

          <div class="mt-4 min-h-[4.5rem]" data-test="package-price">
            <% if package.free? %>
              <div data-test="price-free">
                <span class="text-4xl font-bold text-heading">Free</span>
                <p class="text-xs text-muted mt-1">No card needed</p>
              </div>
            <% elsif package.priced? %>
              <div x-show="!annual" data-test="price-monthly">
                <span class="text-4xl font-bold text-heading"><%= number_to_currency(package.price_monthly, precision: 0) %></span>
                <span class="text-muted">/month</span>
                <% if discount.positive? %>
                  <p class="text-xs text-muted mt-1">or <%= number_to_currency(package.annual_price, precision: 0) %>/year billed annually</p>
                <% end %>
              </div>
              <div x-show="annual" style="display: none" data-test="price-annual">
                <span class="text-4xl font-bold text-heading"><%= number_to_currency(package.annual_monthly_equivalent, precision: 0) %></span>
                <span class="text-muted">/month</span>
                <p class="text-xs text-muted mt-1"><%= number_to_currency(package.annual_price, precision: 0) %> billed annually</p>
              </div>
            <% else %>
              <div data-test="price-custom">
                <span class="text-4xl font-bold text-heading"><%= package.price_label || "Pricing coming soon" %></span>
                <p class="text-xs text-muted mt-1">Priced to the systems we connect</p>
              </div>
            <% end %>
          </div>

          <%= package_cta_link package, class: "btn #{package.featured? ? 'btn-primary' : 'btn-neutral'} mt-5 w-full justify-center" %>

          <div class="mt-6 border-t border-subtle pt-5">
            <% if previous %>
              <p class="mb-3 text-sm font-semibold text-heading" data-test="includes-previous">Everything in <%= previous.name %>, plus:</p>
            <% end %>
            <ul class="space-y-2.5" data-test="package-highlights">
              <% package.highlights.each do |highlight| %>
                <li class="flex gap-2.5 text-sm text-body" data-test="package-highlight">
                  <svg class="mt-0.5 h-4 w-4 shrink-0 text-primary" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                    <path fill-rule="evenodd" d="M16.7 5.3a1 1 0 0 1 0 1.4l-8 8a1 1 0 0 1-1.4 0l-4-4a1 1 0 1 1 1.4-1.4L8 12.6l7.3-7.3a1 1 0 0 1 1.4 0Z" clip-rule="evenodd"/>
                  </svg>
                  <span><%= highlight %></span>
                </li>
              <% end %>
            </ul>
          </div>
        </article>
        <% previous = package %>
      <% end %>
    </div>
  </div>

  <div class="mt-10 text-center">
    <%= link_to packages_stack_path, class: "inline-flex items-center gap-2 rounded-full border border-primary px-5 py-2.5 font-semibold text-primary hover:bg-primary hover:text-white transition-colors",
          data: { test: "full-stack-link" } do %>
      See the full stack for every tier <span aria-hidden="true">→</span>
    <% end %>
    <p class="mt-2 text-sm text-muted">Every server, database, service and agent, tier by tier.</p>
  </div>

  <section class="mt-14" aria-labelledby="how-it-works">
    <h2 id="how-it-works" class="text-xl font-semibold text-heading mb-4 text-center">How a launch works</h2>
    <ol class="grid gap-4 sm:grid-cols-3">
      <li class="rounded-xl bg-surface-alt p-4">
        <p class="font-semibold text-heading mb-1">1. You describe it</p>
        <p class="text-sm text-muted">Tell us what you want built. Our agents design it, build it and check every step.</p>
      </li>
      <li class="rounded-xl bg-surface-alt p-4">
        <p class="font-semibold text-heading mb-1">2. You approve</p>
        <p class="text-sm text-muted">Purchases and account approvals stay yours: your card, your admin console.</p>
      </li>
      <li class="rounded-xl bg-surface-alt p-4">
        <p class="font-semibold text-heading mb-1">3. We run it</p>
        <p class="text-sm text-muted">Hosting, email, backups and marketing handled, and watched, after launch.</p>
      </li>
    </ol>
  </section>
</section>
