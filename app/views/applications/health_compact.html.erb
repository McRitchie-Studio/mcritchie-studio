<%# The /applications index's health cell for one live app: one badge from the central health report (the same read as health.html.erb), lazy-loaded after the page renders. %>
<%= turbo_frame_tag "application-health-#{@app.slug}" do %>
  <% state = @health.nil? ? :not_reported : (@health.not_wired? || @health.unreachable? ? @health.state : @health.category) %>
  <span data-test="application-health-compact" data-state="<%= state %>">
    <% case state %>
    <% when :errors %>
      <span class="badge text-xs bg-warning/10 text-warning-ink border-warning/40">Errors</span>
    <% when :activity %>
      <span class="badge text-xs bg-success/10 text-success-ink border-success/40">Healthy</span>
    <% when :quiet %>
      <span class="badge text-xs bg-success/10 text-success-ink border-success/40">Quiet</span>
    <% when :unreachable %>
      <span class="badge text-xs bg-warning/10 text-warning-ink border-warning/40">Unread</span>
    <% when :not_wired %>
      <span class="text-muted text-xs">Not wired</span>
    <% else %>
      <span class="text-muted text-xs">Not reported</span>
    <% end %>
  </span>
<% end %>
