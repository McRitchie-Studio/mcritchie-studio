<%# SETS THE HUB THEME a link asked for, before the page paints: ?context=dark
    or ?context=watermark (dark), or ?context=light. The same three things the
    moon icon's switch changes (studio-engine studio/alpine_stores): the root's
    `dark` class, localStorage 'theme', and $store.theme when Alpine is already
    running (a Turbo visit). Without a context param nothing is set and the page
    shows the logos of whatever theme the hub is already in. Inline, like the
    engine's own pre-paint theme script, because no deferred module runs before
    the first paint. %>
<% if @theme %>
  <script data-test="logo-theme-pin" data-theme="<%= @theme %>">
    (function () {
      var dark = <%= @theme == :dark %>;
      document.documentElement.classList.toggle('dark', dark);
      try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
      var store = window.Alpine && window.Alpine.store && window.Alpine.store('theme');
      if (store) store.value = dark ? 'dark' : 'light';
    })();
  </script>
<% end %>
