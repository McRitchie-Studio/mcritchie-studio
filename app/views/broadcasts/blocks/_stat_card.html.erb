<%# One giant number on a colour card. Locals: bg, color, label, big, note. %>
<tr>
  <td style="background-color:<%= bg %>;padding:44px 24px;text-align:center;color:<%= color %>;">
    <div style="font-size:13px;font-weight:800;letter-spacing:2px;"><%= label %></div>
    <div style="font-size:92px;line-height:1.05;font-weight:900;letter-spacing:-3px;padding:8px 0;"><%= big %></div>
    <div style="font-size:18px;line-height:1.4;"><%= note %></div>
  </td>
</tr>
