<%# Tasks ⇄ Deployments toggle for the board header. The page title already says
    where you are, so the button for the CURRENT board is hidden as redundant —
    only the link to the other board shows (on /stages neither is active, so both
    show). Each button carries glance count badges: Tasks → building; Deployments
    → reviewed + assembled (muted when zero). Counts come from @tasks_by_stage
    (TasksController#load_board); /stages runs no board load, so counts read zero.
    On /deployments at full width the six-lane board already shows the whole Build
    lane (designed · building · submitted), so the Tasks link is redundant and is
    hidden above 1400px — the complement of the board's lane collapse.
    Below that the upstream lanes fold away, so the link reappears (the only way
    back to them). /stages has no board, so its Tasks link is never hidden.
    Local: current ("tasks" | "deployments" | "stages"). %>
<% current = local_assigns.fetch(:current, nil) %>
<% by_stage = @tasks_by_stage || {} %>
<% building_count  = (by_stage["building"]  || []).size %>
<% reviewed_count  = (by_stage["reviewed"]  || []).size %>
<% assembled_count = (by_stage["assembled"] || []).size %>
<% btn   = "inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-sm font-medium transition bg-surface text-secondary border border-subtle hover:text-heading" %>
<% badge = "inline-flex items-center justify-center min-w-[18px] h-[18px] px-1 rounded-full text-[10px] font-bold leading-none" %>
<% muted = "bg-surface-alt text-muted" %>
<%# On /deployments the full-width board already shows the Build lane, so hide the
    Tasks link at 1400px+ (mirrors the board's max-[1399px] collapse). %>
<% tasks_btn = current == "deployments" ? "#{btn} min-[1400px]:hidden" : btn %>
<nav class="flex items-center gap-1.5" aria-label="Board views">
  <% unless current == "tasks" %>
    <%= link_to tasks_path, class: tasks_btn do %>
      <span>Tasks</span>
      <span class="<%= badge %> <%= building_count > 0 ? task_stage_count_classes('building') : muted %>"
            title="<%= building_count %> building"><%= building_count %></span>
    <% end %>
  <% end %>
  <% unless current == "triage" %>
    <%= link_to triage_path, class: btn do %>
      <span>Triage</span>
    <% end %>
  <% end %>
  <% unless current == "deployments" %>
    <%= link_to deployments_path, class: btn do %>
      <span>Deployments</span>
      <span class="<%= badge %> <%= reviewed_count > 0 ? task_stage_count_classes('reviewed') : muted %>"
            title="<%= reviewed_count %> reviewed"><%= reviewed_count %></span>
      <span class="<%= badge %> <%= assembled_count > 0 ? task_stage_count_classes('assembled') : muted %>"
            title="<%= assembled_count %> assembled"><%= assembled_count %></span>
    <% end %>
  <% end %>
</nav>
