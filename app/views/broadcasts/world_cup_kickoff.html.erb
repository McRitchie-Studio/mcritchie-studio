<% survivor_url    = @broadcast&.survivor_url.presence    || "{{SURVIVOR_URL}}" %>
<% turf_totals_url = @broadcast&.turf_totals_url.presence || "{{TURF_TOTALS_URL}}" %>
<%= render "broadcasts/email_head",
      hero_file: "world_cup_header.png",
      preheader: "The first-ever 48-team World Cup starts Thursday — two ways to play all summer.",
      title:     "&#9917;&nbsp; It&rsquo;s almost here",
      subtitle:  "The World Cup kicks off <strong style=\"color:#ffffff;\">next Thursday, June&nbsp;11</strong>" %>

<%
  groups = [
    ["A", [["&#127474;&#127485;","Mexico"],["&#127487;&#127462;","South Africa"],["&#127472;&#127479;","South Korea"],["&#127915;","UEFA Play-off&nbsp;D"]]],
    ["B", [["&#127464;&#127462;","Canada"],["&#127915;","UEFA Play-off&nbsp;A"],["&#127478;&#127462;","Qatar"],["&#127464;&#127469;","Switzerland"]]],
    ["C", [["&#127463;&#127479;","Brazil"],["&#127474;&#127462;","Morocco"],["&#127469;&#127481;","Haiti"],["&#127988;&#917607;&#917602;&#917619;&#917603;&#917620;&#917631;","Scotland"]]],
    ["D", [["&#127482;&#127480;","USA"],["&#127477;&#127486;","Paraguay"],["&#127462;&#127482;","Australia"],["&#127481;&#127479;","Turkey"]]],
    ["E", [["&#127465;&#127466;","Germany"],["&#127464;&#127484;","Cura&ccedil;ao"],["&#127466;&#127464;","Ecuador"],["&#127464;&#127470;","Ivory Coast"]]],
    ["F", [["&#127475;&#127473;","Netherlands"],["&#127480;&#127466;","Sweden"],["&#127481;&#127475;","Tunisia"],["&#127471;&#127477;","Japan"]]],
    ["G", [["&#127463;&#127466;","Belgium"],["&#127466;&#127468;","Egypt"],["&#127470;&#127479;","Iran"],["&#127475;&#127487;","New Zealand"]]],
    ["H", [["&#127466;&#127480;","Spain"],["&#127464;&#127483;","Cape Verde"],["&#127480;&#127462;","Saudi Arabia"],["&#127482;&#127486;","Uruguay"]]],
    ["I", [["&#127467;&#127479;","France"],["&#127480;&#127475;","Senegal"],["&#127470;&#127478;","Iraq"],["&#127475;&#127476;","Norway"]]],
    ["J", [["&#127462;&#127479;","Argentina"],["&#127465;&#127487;","Algeria"],["&#127462;&#127481;","Austria"],["&#127471;&#127476;","Jordan"]]],
    ["K", [["&#127477;&#127481;","Portugal"],["&#127464;&#127465;","DR Congo"],["&#127482;&#127487;","Uzbekistan"],["&#127464;&#127476;","Colombia"]]],
    ["L", [["&#127988;&#917607;&#917602;&#917605;&#917614;&#917607;&#917631;","England"],["&#127469;&#127479;","Croatia"],["&#127468;&#127469;","Ghana"],["&#127477;&#127462;","Panama"]]]
  ]
%>

<!-- intro -->
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:28px 32px 8px 32px;">
      <p style="margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;">Hey everyone,</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">The wait is nearly over. Mexico opens the tournament at the Estad&iacute;o Azteca on June&nbsp;11 &mdash; and this World Cup is unlike any that came before it.</p>
    </td>
  </tr>

  <!-- 48-team callout -->
  <tr>
    <td style="padding:16px 32px 8px 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f0fdf4;border:1px solid #bbf7d0;border-radius:10px;">
        <tr>
          <td style="padding:18px 20px;">
            <div style="font-size:18px;line-height:1.4;color:#14532d;font-weight:700;">&#127758;&nbsp; The first-ever 48-team World Cup</div>
            <p style="margin:8px 0 0 0;font-size:15px;line-height:1.6;color:#3f6049;">For the first time in history, <strong>48 nations</strong> &mdash; up from 32 &mdash; battle across <strong>12 groups</strong>, co-hosted by the USA, Canada &amp; Mexico. More teams, more debutants, more drama, and a brand-new knockout Round of 32.</p>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- groups heading -->
  <tr>
    <td style="padding:24px 32px 6px 32px;">
      <h2 style="margin:0;font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#64748b;font-weight:700;">How the groups shook out</h2>
    </td>
  </tr>

  <!-- groups grid: 2 columns -->
  <tr>
    <td style="padding:8px 24px 8px 24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <% groups.each_slice(2) do |pair| %>
          <tr>
            <% pair.each do |label, teams| %>
              <td width="50%" valign="top" style="padding:6px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fafc;border:1px solid #e6eaef;border-radius:9px;">
                  <tr><td style="padding:11px 12px 9px 12px;"><span style="display:inline-block;background-color:#0b1220;color:#ffffff;font-size:11px;font-weight:700;letter-spacing:1px;padding:3px 9px;border-radius:5px;">GROUP <%= label %></span></td></tr>
                  <tr><td style="padding:0 12px 12px 12px;font-size:14px;line-height:1.85;color:#2b3440;">
                    <%= raw teams.map { |flag, name| "#{flag} #{name}" }.join("<br>") %>
                  </td></tr>
                </table>
              </td>
            <% end %>
          </tr>
        <% end %>
      </table>
      <p style="margin:8px 6px 0 6px;font-size:12px;line-height:1.5;color:#94a3b8;font-style:italic;">Two slots go to the UEFA play-off winners, decided just before kickoff.</p>
    </td>
  </tr>

  <!-- contests heading -->
  <tr>
    <td style="padding:18px 32px 0 32px;">
      <h2 style="margin:0 0 4px 0;font-size:22px;line-height:1.3;color:#0b1220;font-weight:800;">&#127942;&nbsp; Two ways to play all summer</h2>
      <p style="margin:0;font-size:15px;line-height:1.6;color:#56616e;">Both are beginner-friendly &mdash; jump in even if it&rsquo;s your first time.</p>
    </td>
  </tr>

  <!-- Turf Totals card -->
  <tr>
    <td style="padding:16px 32px 6px 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e6eaef;border-radius:11px;border-left:4px solid #6366f1;">
        <tr>
          <td style="padding:18px 20px;">
            <div style="font-size:18px;font-weight:700;color:#0b1220;">Turf Totals &mdash; our new weekly DFS game <span style="display:inline-block;background-color:#eef0ff;color:#4f46e5;font-size:10px;font-weight:700;letter-spacing:1px;padding:2px 7px;border-radius:5px;vertical-align:middle;">NEW</span></div>
            <p style="margin:8px 0 16px 0;font-size:15px;line-height:1.6;color:#56616e;">A fresh <strong>weekly daily-fantasy</strong> game built for the Cup. Draft your lineup, rack up points off real match action, and come back for a new slate each week &mdash; every gameweek is a clean shot at the top.</p>
            <%= render "broadcasts/button", url: broadcast_link(:turf_totals, turf_totals_url), label: "Check out Turf Totals &rarr;".html_safe, color: "#6366f1" %>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- Survivor card -->
  <tr>
    <td style="padding:10px 32px 6px 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e6eaef;border-radius:11px;border-left:4px solid #16a34a;">
        <tr>
          <td style="padding:18px 20px;">
            <div style="font-size:18px;font-weight:700;color:#0b1220;">Survivor &mdash; last fan standing</div>
            <p style="margin:8px 0 16px 0;font-size:15px;line-height:1.6;color:#56616e;">A <strong>season-long Splash Survivor</strong> contest. Pick one team to win each round. Survive and advance &mdash; lose, and you&rsquo;re out. One pick, all tournament, rising stakes every week.</p>
            <%= render "broadcasts/button", url: broadcast_link(:survivor, survivor_url), label: "Join Survivor &rarr;".html_safe, color: "#16a34a" %>
          </td>
        </tr>
      </table>
    </td>
  </tr>

  <!-- closing -->
  <tr>
    <td style="padding:22px 32px 8px 32px;">
      <p style="margin:0 0 16px 0;font-size:16px;line-height:1.65;color:#2b3440;">Whether you&rsquo;ve already memorized the bracket or you&rsquo;re just here for the vibes and the flags, there&rsquo;s a spot for you. Pick your contest (or play both), rally your friends, and let&rsquo;s enjoy the greatest World Cup ever together.</p>
      <p style="margin:0 0 4px 0;font-size:16px;line-height:1.65;color:#2b3440;">See you on the pitch. &#9917;</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">&mdash; Alex</p>
    </td>
  </tr>

  <!-- PS -->
  <tr>
    <td style="padding:14px 32px 28px 32px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-top:1px solid #eef1f4;">
        <tr><td style="padding-top:16px;font-size:13px;line-height:1.6;color:#94a3b8;"><strong style="color:#64748b;">P.S.</strong> The group stage moves fast &mdash; lock your Survivor pick and your first Turf Totals lineup before June&nbsp;11.</td></tr>
      </table>
    </td>
  </tr>
</table>
