<%# Header for the Next Release module. Shared by the active and empty-state branches
    so the two never drift: the section label on the left, the QA-release kickoff chip
    floated to the right. %>
<div class="mb-3 flex items-center justify-between gap-2 flex-wrap">
  <span class="text-[11px] uppercase tracking-wide text-muted font-semibold">Next Release</span>
  <%= render "kickoff_chip", command: qa_release_kickoff %>
</div>
