#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/install-git-credential-helper — pin the GitHub App credential helper
# OUTSIDE every working tree, so a `git push` cannot lose it mid-checkout.
#
# WHY (measured four times on 2026-09-10, across three sessions). `~/.gitconfig`
# names the helper by a path inside the hub primary's WORKING TREE. `git
# checkout` unlinks and recreates every file whose content differs between the
# two commits, so that path briefly does not exist, and a git operation landing
# in that window dies with `gh-app-git-credential: No such file or directory`.
# The mechanism, the closure it copies, and why relocation is safe for the
# shared token session are all in bin/lib/credential_helper_install.rb.
#
# IT DOES NOT TOUCH ~/.gitconfig. Wiring a global config file is
# operator-visible, so this command installs the snapshot and PRINTS the exact
# one-line change plus its revert. Run them yourself.
#
# Usage:
#   bin/install-git-credential-helper              install, then print the wiring
#   bin/install-git-credential-helper --check      report state; exit 1 if stale
#   bin/install-git-credential-helper --print-config   print wiring only
#   bin/install-git-credential-helper --root PATH  install somewhere else
#   bin/install-git-credential-helper --help
#
# --check and --print-config INSTALL NOTHING and WRITE NOTHING.

require_relative "lib/cli_arg_guard"
require_relative "lib/credential_helper_install"

SOURCE_ROOT = File.expand_path("..", __dir__)

USAGE = <<~USAGE
  Usage: bin/install-git-credential-helper [--check|--print-config] [--root PATH]

  Installs a snapshot of the GitHub App credential helper OUTSIDE every working
  tree, so a `git push` cannot lose it while a checkout moves under it.

    --check          report installed/stale/wired state; INSTALLS NOTHING (exit 1 if stale)
    --print-config   print the git config commands only; INSTALLS NOTHING
    --root PATH      install root (default #{CredentialHelperInstall::DEFAULT_ROOT})
    --help, -h       this text

  This command never edits ~/.gitconfig. It prints the one-line change and its
  revert; you run them.
USAGE

# The guard runs FIRST — ahead of any copy — because this script MUTATES the
# filesystem, and `--help` is the probe every operator tries before reading a
# word of it. See bin/lib/cli_arg_guard.rb for the five times an unaccounted
# argument ran a real mutation on this ecosystem.
ARGS = CliArgGuard.guard!(
  ARGV,
  program: "install-git-credential-helper",
  usage: USAGE,
  bool: %w[--check --print-config],
  value: %w[--root],
  help_exit: 0,
  consequence: "NOTHING was installed and no git config was printed as current."
)

root = ARGS.first("--root") ? File.expand_path(ARGS.first("--root")) : CredentialHelperInstall::DEFAULT_ROOT
options = { mode: :install }
options[:mode] = :print_config if ARGS.bool?("--print-config")
options[:mode] = :check if ARGS.bool?("--check")

def print_wiring(root)
  puts
  puts "WIRE IT (run this yourself — this command does not edit ~/.gitconfig):"
  puts "  #{CredentialHelperInstall.git_config_command(root)}"
  puts
  puts "REVERT IT (back to the in-tree path this replaces):"
  puts "  #{CredentialHelperInstall.git_config_revert_command}"
end

case options[:mode]
when :print_config
  print_wiring(root)
  exit 0

when :check
  installed = CredentialHelperInstall.installed_digest(root)
  wanted = CredentialHelperInstall.digest(SOURCE_ROOT)
  # --get-all, never --get: `--get` returns only the LAST value, so a key holding
  # three helpers and a key holding one printed the same line and the same OK.
  # That is what kept the wiring command's re-run duplication invisible.
  wired_values = `git config --global --get-all credential."https://github.com".helper`
                 .split("\n").map(&:strip).reject(&:empty?)
  wired = wired_values.last.to_s
  expected = CredentialHelperInstall.helper_path(root)

  puts "source:    #{SOURCE_ROOT} (digest #{wanted})"
  puts "installed: #{installed || 'NOTHING INSTALLED'}"
  puts "helper:    #{expected}"
  puts "git wired: #{wired.empty? ? '(unset)' : wired}" \
       "#{wired_values.size > 1 ? " (+#{wired_values.size - 1} MORE — see below)" : ''}"

  stamp = CredentialHelperInstall.stamp_state(source_root: SOURCE_ROOT, root: root)
  stamped = CredentialHelperInstall.stamped_projects_root(root)
  puts "op-reads:  #{stamped ? "attributed to #{stamped}" : 'NOT STAMPED'}"

  problems = []
  problems << "the installed snapshot is stale — re-run bin/install-git-credential-helper" if installed != wanted
  case stamp
  when :missing
    problems << "the snapshot carries no op-reads stamp, so the 1Password reads bin/gh-token makes from " \
                "it land INSIDE the snapshot and bin/op-reads loses them (the helper's own bash-metered " \
                "reads still land in the real log) — re-run bin/install-git-credential-helper"
  when :wrong_root
    problems << "the op-reads stamp names projects root #{stamped}, but this source resolves " \
                "#{CredentialHelperInstall.projects_root_for(SOURCE_ROOT)} — re-run bin/install-git-credential-helper"
  end
  if wired != expected
    problems << "git is not wired to the installed helper" \
                "#{wired.empty? ? '' : " (it points at #{wired})"}"
  end
  if wired_values.size > 1
    problems << "credential.\"https://github.com\" holds #{wired_values.size} helper values " \
                "(#{wired_values.join(', ')}) — git runs one per value, and the first to answer wins. " \
                "Re-run the wiring command below; its value-pattern collapses them to one."
  end

  if problems.empty?
    puts
    puts "OK credential helper is installed, current, and wired outside every working tree"
    exit 0
  end

  puts
  problems.each { |p| puts "FAIL #{p}" }
  print_wiring(root)
  exit 1

else
  id = CredentialHelperInstall.install!(source_root: SOURCE_ROOT, root: root)
  files = CredentialHelperInstall.manifest(SOURCE_ROOT)
  puts "installed #{files.size} file(s) as #{CredentialHelperInstall.version_dir(root, id)}"
  puts "current -> versions/#{id}  (repointed atomically)"
  puts "helper:    #{CredentialHelperInstall.helper_path(root)}"
  print_wiring(root)
end
