<% content_for :title, "Thank you · McRitchie Studio" %>
<%# The page after a survey is sent (task first-game-feedback-survey). The
    play link carries the email's token as ?ref= when there is one, so a game
    played from here still counts toward the email's results. %>
<section class="max-w-xl mx-auto px-4 py-12 text-center" data-test="survey-thanks">
  <div class="card p-6 sm:p-8">
    <p class="text-5xl mb-4" aria-hidden="true">🙏</p>
    <h1 class="text-2xl sm:text-3xl font-bold text-heading mb-3">Thank you</h1>
    <p class="text-secondary mb-6">Alex reads every answer. It shapes what gets built next.</p>
    <% if @play_url %>
      <%= link_to "#{@survey.play_label} →", @play_url, class: "btn btn-primary w-full sm:w-auto text-base py-3", data: { test: "survey-play" } %>
    <% end %>
    <% if @token %>
      <p class="text-sm text-muted mt-6">
        Want to change something? <%= link_to "Edit your answers", survey_form_path(@survey, t: @token), class: "text-primary hover:underline", data: { test: "survey-edit" } %>.
      </p>
    <% end %>
  </div>
</section>
