<section>
  <div class="mb-6 flex items-center justify-between">
    <%= link_to "&larr; All Tasks".html_safe, tasks_path, class: "text-secondary hover:text-heading text-sm transition" %>
    <div class="flex items-center gap-2">
      <%= link_to "Sizing", task_sizing_path(@task), class: "btn btn-outline btn-sm" %>
      <% if logged_in? %>
        <%= link_to "Edit", edit_task_path(@task.slug), class: "btn btn-outline btn-sm" %>
      <% end %>
    </div>
  </div>

  <div class="card p-6 mb-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h2 class="text-2xl font-bold text-heading"><%= @task.title %></h2>
        <div class="flex items-center gap-3 mt-2">
          <%= render "components/badge", text: @task.stage.humanize, scheme: stage_scheme(@task.stage) %>
          <% if @task.priority > 0 %>
            <span class="text-xs text-yellow-400 font-medium">Priority <%= @task.priority %></span>
          <% end %>
          <% if @task.agent_slug.present? %>
            <%= link_to @task.agent_slug, agent_path(@task.agent_slug), class: "text-xs text-primary hover:text-primary-300" %>
          <% end %>
        </div>
      </div>
      <span class="text-xs text-muted font-mono"><%= @task.slug %></span>
    </div>

    <% if @task.description.present? %>
      <div class="mb-4">
        <p class="text-body text-sm whitespace-pre-wrap"><%= @task.description %></p>
      </div>
    <% end %>

    <!-- Timestamps -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-4">
      <div class="bg-surface-alt rounded-lg p-3">
        <p class="label-upper">Created</p>
        <p class="text-heading text-sm"><%= @task.created_at.strftime("%b %d, %H:%M") %></p>
      </div>
      <% if @task.queued_at %>
        <div class="bg-surface-alt rounded-lg p-3">
          <p class="label-upper">Queued</p>
          <p class="text-heading text-sm"><%= @task.queued_at.strftime("%b %d, %H:%M") %></p>
        </div>
      <% end %>
      <% if @task.started_at %>
        <div class="bg-surface-alt rounded-lg p-3">
          <p class="label-upper">Started</p>
          <p class="text-heading text-sm"><%= @task.started_at.strftime("%b %d, %H:%M") %></p>
        </div>
      <% end %>
      <% if @task.completed_at %>
        <div class="bg-surface-alt rounded-lg p-3">
          <p class="label-upper">Completed</p>
          <p class="text-heading text-sm"><%= @task.completed_at.strftime("%b %d, %H:%M") %></p>
        </div>
      <% end %>
    </div>

    <% if @task.error_message.present? %>
      <div class="bg-red-900/30 border border-red-700/50 rounded-lg p-3 mb-4">
        <p class="text-xs text-red-400 uppercase tracking-wider mb-1">Error</p>
        <p class="text-red-300 text-sm"><%= @task.error_message %></p>
      </div>
    <% end %>

    <% if @task.devops? %>
      <div class="bg-surface-alt rounded-lg p-3 mb-4">
        <div class="flex items-center justify-between mb-3">
          <p class="label-upper">DevOps handoff</p>
          <% if @task.requires_release_conductor? %>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-orange-900/50 text-orange-300 border border-orange-700/50">RELEASE LANE</span>
          <% end %>
        </div>

        <div class="grid md:grid-cols-3 gap-3 mb-3">
          <div class="bg-surface rounded p-2">
            <p class="text-[10px] text-muted uppercase tracking-wide">Type</p>
            <p class="text-heading text-sm font-bold mt-0.5"><%= @task.devops_kind.humanize %></p>
          </div>
          <div class="bg-surface rounded p-2">
            <p class="text-[10px] text-muted uppercase tracking-wide">Shape</p>
            <p class="text-heading text-sm font-bold mt-0.5"><%= @task.devops_shape || "—" %></p>
          </div>
          <div class="bg-surface rounded p-2">
            <p class="text-[10px] text-muted uppercase tracking-wide">Worktree Slug</p>
            <p class="text-heading text-sm font-mono mt-0.5 break-all"><%= @task.devops_worktree_slug || "—" %></p>
          </div>
          <div class="bg-surface rounded p-2">
            <p class="text-[10px] text-muted uppercase tracking-wide">Repositories</p>
            <p class="text-heading text-sm mt-0.5"><%= @task.devops_repositories.presence&.join(", ") || "—" %></p>
          </div>
        </div>

        <div class="grid md:grid-cols-3 gap-3 mb-3">
          <div class="bg-surface rounded p-2">
            <p class="text-[10px] text-muted uppercase tracking-wide">Release Train</p>
            <p class="text-heading text-sm mt-0.5"><%= @task.devops_release_train || "—" %></p>
          </div>
          <div class="bg-surface rounded p-2">
            <p class="text-[10px] text-muted uppercase tracking-wide">Branch</p>
            <p class="text-heading text-sm font-mono mt-0.5 break-all"><%= @task.devops_field("branch") || "—" %></p>
          </div>
          <div class="bg-surface rounded p-2">
            <p class="text-[10px] text-muted uppercase tracking-wide">Pull Request</p>
            <% if (pr_url = @task.devops_url("pr")) %>
              <%= link_to pr_url, pr_url, class: "text-primary text-sm break-all hover:underline", target: "_blank", rel: "noopener" %>
            <% else %>
              <p class="text-heading text-sm mt-0.5">—</p>
            <% end %>
          </div>
        </div>

        <div class="grid md:grid-cols-3 gap-3 mb-3">
          <% [["Local", "local"], ["QA", "qa"], ["Production", "production"]].each do |label, key| %>
            <div class="bg-surface rounded p-2">
              <p class="text-[10px] text-muted uppercase tracking-wide"><%= label %> URL</p>
              <% if (url = @task.devops_url(key)) %>
                <%= link_to url, url, class: "text-primary text-sm break-all hover:underline", target: "_blank", rel: "noopener" %>
              <% else %>
                <p class="text-heading text-sm mt-0.5">—</p>
              <% end %>
            </div>
          <% end %>
        </div>

        <% if @task.devops_risk_tags.any? %>
          <div class="flex flex-wrap gap-1 mb-3">
            <% @task.devops_risk_tags.each do |tag| %>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-surface text-secondary border border-subtle"><%= tag %></span>
            <% end %>
          </div>
        <% end %>

        <div class="grid md:grid-cols-3 gap-3">
          <div class="bg-surface rounded p-3">
            <p class="text-[10px] text-muted uppercase tracking-wide mb-2">Acceptance Criteria</p>
            <% if @task.devops_acceptance.any? %>
              <ul class="space-y-1 text-sm text-body list-disc pl-4">
                <% @task.devops_acceptance.each do |item| %>
                  <li><%= item %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-sm text-muted">No criteria recorded.</p>
            <% end %>
          </div>
          <div class="bg-surface rounded p-3">
            <p class="text-[10px] text-muted uppercase tracking-wide mb-2">Expected Test Plan</p>
            <% if @task.devops_test_plan.any? %>
              <ul class="space-y-1 text-sm text-body list-disc pl-4">
                <% @task.devops_test_plan.each do |item| %>
                  <li><%= item %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-sm text-muted">No expected checks recorded.</p>
            <% end %>
          </div>
          <div class="bg-surface rounded p-3">
            <p class="text-[10px] text-muted uppercase tracking-wide mb-2">Checks Run</p>
            <% if @task.devops_checks_run.any? %>
              <ul class="space-y-1 text-sm text-body list-disc pl-4">
                <% @task.devops_checks_run.each do |item| %>
                  <li><%= item %></li>
                <% end %>
              </ul>
            <% else %>
              <p class="text-sm text-muted">No completed checks recorded.</p>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <!-- Conversation -->
    <div class="bg-surface-alt rounded-lg p-3 mb-4">
      <div class="flex items-center justify-between gap-3 mb-3">
        <div>
          <p class="label-upper">Conversation</p>
          <p class="text-xs text-muted mt-1">QA review feedback, agent handoffs, and follow-up notes for this task.</p>
        </div>
      </div>

      <% if @task_activity&.errors&.any? %>
        <div class="mb-3 p-3 bg-red-900/50 border border-red-700 rounded-lg text-red-300 text-sm">
          <% @task_activity.errors.full_messages.each do |msg| %>
            <p><%= msg %></p>
          <% end %>
        </div>
      <% end %>

      <% if admin? %>
        <%= form_with model: @task_activity, url: comment_task_path(@task.slug), scope: :activity, local: true, class: "mb-4" do |f| %>
          <div class="grid md:grid-cols-[180px_1fr_auto] gap-3 items-start">
            <div>
              <label class="block text-xs text-muted uppercase tracking-wide mb-1">Type</label>
              <%= f.select :activity_type,
                    options_for_select(Activity::TASK_CONVERSATION_TYPES.map { |type| [Activity::TASK_CONVERSATION_LABELS.fetch(type), type] }, @task_activity.activity_type),
                    {},
                    class: "input-field" %>
            </div>
            <div>
              <label class="block text-xs text-muted uppercase tracking-wide mb-1">Feedback</label>
              <%= f.text_area :description,
                    rows: 3,
                    class: "input-field",
                    placeholder: "Record QA feedback, handoff notes, or agent response..." %>
            </div>
            <div class="md:pt-6">
              <button type="submit" class="btn btn-primary whitespace-nowrap">Add Note</button>
            </div>
          </div>
        <% end %>
      <% end %>

      <% if @task_activities.any? %>
        <div class="space-y-2">
          <% @task_activities.each do |activity| %>
            <div class="bg-surface rounded p-3 border border-subtle">
              <div class="flex flex-wrap items-center gap-2 mb-2">
                <%= render "components/badge", text: activity.activity_type_label, scheme: activity.activity_type == "qa_feedback" ? "warning" : "violet" %>
                <% if activity.agent.present? %>
                  <%= link_to activity.agent_slug, agent_path(activity.agent_slug), class: "text-xs text-primary hover:text-primary-300" %>
                <% elsif activity.agent_slug.present? %>
                  <span class="text-xs text-secondary"><%= activity.agent_slug %></span>
                <% end %>
                <span class="text-xs text-muted"><%= time_ago_in_words(activity.created_at) %> ago</span>
              </div>
              <p class="text-sm text-body whitespace-pre-wrap"><%= activity.description %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-muted">No task feedback has been recorded yet.</p>
      <% end %>
    </div>

    <!-- Sizing -->
    <div class="bg-surface-alt rounded-lg p-3">
      <div class="flex items-center justify-between mb-3">
        <p class="label-upper">Sealed-bid sizing</p>
        <%= link_to "Edit →", task_sizing_path(@task), class: "text-xs text-primary hover:text-primary-300" %>
      </div>
      <div class="grid grid-cols-4 gap-2">
        <% [
          ["Alex (PM)", @task.pm_size],
          ["Avi (PO)",  @task.po_size],
          ["Dev",       @task.dev_size],
          ["Actual",    @task.actual_size]
        ].each do |label, size| %>
          <div class="bg-surface rounded p-2 text-center">
            <p class="text-[10px] text-muted uppercase tracking-wide"><%= label %></p>
            <p class="<%= size.present? ? 'text-heading font-bold' : 'text-muted' %> text-sm mt-0.5"><%= size&.upcase || "—" %></p>
          </div>
        <% end %>
      </div>
      <% if @task.requires_migration %>
        <div class="flex items-center gap-2 mt-3 pt-3 border-t border-subtle">
          <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-orange-900/50 text-orange-300 border border-orange-700/50">MIG</span>
          <span class="text-xs text-secondary">Requires <code class="text-xs">backend_migration</code> lane</span>
        </div>
      <% end %>
    </div>
  </div>

  <!-- Stage transitions — move via PATCH update (one path: board, bin/task, API) -->
  <% if logged_in? %>
    <%
      advance = {
        "designed"  => ["Start Building",     "building",  "btn btn-secondary"],
        "building"  => ["Submit",             "submitted", "btn btn-warning"],
        "submitted" => ["Approve → Reviewed", "reviewed",  "btn btn-success"],
        "reviewed"  => ["Assemble",           "assembled", "btn btn-secondary"],
        "assembled" => ["Ship",               "shipped",   "btn btn-success"],
        "blocked"   => ["Resume",             "building",  "btn btn-secondary"]
      }
    %>
    <div class="flex flex-wrap gap-2">
      <% if (step = advance[@task.stage]) %>
        <%= button_to step[0], task_path(@task.slug), method: :patch, params: { task: { stage: step[1] } }, class: step[2] %>
      <% end %>
      <% unless %w[blocked archived].include?(@task.stage) %>
        <%= button_to "Block", task_path(@task.slug), method: :patch, params: { task: { stage: "blocked" } }, class: "btn btn-danger" %>
      <% end %>
      <% unless @task.stage == "archived" %>
        <%= button_to "Archive", task_path(@task.slug), method: :patch, params: { task: { stage: "archived" } }, class: "btn bg-surface-alt text-body hover:bg-inset" %>
      <% end %>
    </div>
  <% end %>
</section>
