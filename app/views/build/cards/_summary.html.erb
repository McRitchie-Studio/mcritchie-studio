<%# locals: (card:, message:, request_row:, refusal: nil) %>
<%# The summary card: once every step is set, Ray's answer carries it (BuildIntake::Card "summary", attached by code when the answer offered no other card). Drawn from the REQUEST, never from the model: the app's title and features, the CTO, the theme and the domain, then Build My App, which runs the same launch as before (BuildController#update, AppLaunch). Signed out, the same press opens the sign-in modal, and the sign-in finishes the launch (BuildController#launch). A summary from before a later change still shows the request as it stands now. A refused launch (BuildController#refuse_launch) redraws this card, by its id, with `refusal`: the reason and a next step (the app they already have and the plans for a plan limit; another address for a taken name), above the button, which stays to try again. %>
<% answers = request_row.answers.is_a?(Hash) ? request_row.answers : {} %>
<% ready = request_row.draft? && request_row.intake_complete? %>
<div id="<%= BuildController.summary_dom_id(message) %>" class="rounded-2xl border <%= refusal ? 'border-danger' : 'border-primary' %> bg-surface p-3 sm:p-4 space-y-4"
     data-test="build-card-summary" data-ready="<%= ready %>" data-refused="<%= refusal.present? %>">
  <div>
    <p class="text-xs font-semibold uppercase tracking-wider text-muted mb-1">Your app</p>
    <p class="text-lg text-heading font-bold leading-snug break-words" data-test="build-summary-title"><%= answers["title"].presence || answers["idea"] %></p>
    <% if answers["features"].present? %>
      <ul class="mt-2 list-disc pl-5 space-y-0.5 text-sm text-body" data-test="build-summary-features">
        <% Array(answers["features"]).each do |feature| %><li class="break-words"><%= feature %></li><% end %>
      </ul>
    <% end %>
  </div>
  <%# One <div> per pair, holding only its <dt> and <dd> (the dl content model): the portrait and the swatches ride inside the value. %>
  <dl class="grid grid-cols-1 sm:grid-cols-3 gap-2 text-sm">
    <div class="min-w-0 rounded-xl border border-subtle p-2" data-test="build-summary-cto">
      <dt class="text-2xs text-muted">CTO</dt>
      <dd class="mt-1 flex items-center gap-2 min-w-0">
        <% if (path = BuildIntake::Portraits.path(request_row.cto_avatar)) %>
          <%= image_tag path, alt: "", class: "h-7 w-7 shrink-0 rounded-full" %>
        <% end %>
        <span class="font-semibold text-heading truncate"><%= request_row.cto_name %></span>
      </dd>
    </div>
    <div class="min-w-0 rounded-xl border border-subtle p-2" data-test="build-summary-theme">
      <dt class="text-2xs text-muted">Theme</dt>
      <dd class="mt-1 flex items-center gap-2 min-w-0">
        <% if request_row.palette.present? %>
          <span class="flex shrink-0 -space-x-1" aria-hidden="true">
            <% %w[primary accent surface].each do |role| %>
              <span class="h-5 w-5 rounded-full border border-subtle" style="background-color: <%= request_row.palette.dig("dark", role) %>"></span>
            <% end %>
          </span>
        <% end %>
        <span class="font-semibold text-heading truncate"><%= request_row.palette.presence&.dig("name") %></span>
      </dd>
    </div>
    <div class="min-w-0 rounded-xl border border-subtle p-2" data-test="build-summary-domain">
      <dt class="text-2xs text-muted">Domain</dt>
      <dd class="mt-1 font-mono text-xs text-heading break-all"><%= request_row.host %></dd>
    </div>
  </dl>

  <% if refusal %>
    <div class="rounded-xl border border-danger/40 bg-danger/10 p-3 space-y-2 text-sm" role="alert" data-test="build-summary-refusal">
      <p class="font-semibold text-danger-ink" data-test="build-summary-refusal-reason"><%= refusal[:reason] %></p>
      <% if refusal[:plan_limit] %>
        <p class="text-body" data-test="build-summary-next">
          <% if refusal[:existing_app] %>
            <%= link_to "Open the app you have", refusal[:existing_app], class: "font-semibold text-primary-ink underline", data: { turbo_frame: "_top", test: "build-summary-existing-app" } %>, or
          <% end %>
          <%= link_to "see the plans", packages_path, class: "font-semibold text-primary-ink underline", data: { test: "build-summary-upgrade" } %> for more apps.
        </p>
      <% elsif refusal[:domain] %>
        <p class="text-body" data-test="build-summary-next">Ask <%= BuildController::AGENT_NAME %> for another address in the chat below, then tap Build My App again.</p>
      <% else %>
        <p class="text-body" data-test="build-summary-next">Finish that step with <%= BuildController::AGENT_NAME %> in the chat below, then tap Build My App again.</p>
      <% end %>
    </div>
  <% end %>
  <% if !ready %>
    <p class="text-xs text-muted" data-test="build-summary-not-ready"><%= request_row.draft? ? "A step changed; finish it and Ray will sum up again." : "This app is already in the build queue." %></p>
  <% else %>
    <%# Turbo, so the 303 to the new CTO's chat is a view-transition visit (cto_chats/show, whose first visit plays the launch panel). Signed out, the same press opens the sign-in modal (BuildController#sign_in_to_launch), and the sign-in comes back to launch. While the press is in flight Turbo disables the button and marks the form aria-busy, which swaps its label for a spinner (the group-aria-busy classes) until the panel or the modal arrives. %>
    <%= form_with url: build_request_path(request_row.token), method: :patch, class: "group", data: { test: "build-summary-form" } do %>
      <%= hidden_field_tag "app_request[subdomain]", request_row.subdomain %>
      <%= hidden_field_tag "message_id", message.id, id: nil %>
      <%= tag.span class: "cta-glow", style: cta_glow_style(request_row.palette), data: { test: "build-summary-glow" } do %>
        <button type="submit" class="btn btn-primary w-full disabled:cursor-wait group-aria-busy:cursor-wait" data-test="build-summary-build" data-signs-in="<%= !logged_in? %>">
          <span class="group-aria-busy:hidden">Build My App</span>
          <span class="hidden group-aria-busy:inline-flex items-center gap-2" data-test="build-summary-working">
            <svg class="h-4 w-4 animate-spin motion-reduce:animate-none" viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="3" opacity="0.25"/><path d="M21 12a9 9 0 0 0-9-9" stroke="currentColor" stroke-width="3" stroke-linecap="round"/></svg>
            <%= logged_in? ? "Building…" : "One moment…" %>
          </span>
        </button>
      <% end %>
    <% end %>
    <% if logged_in? %>
      <p class="text-xs text-muted text-center">Claims <span class="font-mono"><%= request_row.host %></span> and starts the build.</p>
    <% else %>
      <p class="text-xs text-muted text-center">Free. We'll ask you to sign in first.</p>
    <% end %>
  <% end %>
</div>
