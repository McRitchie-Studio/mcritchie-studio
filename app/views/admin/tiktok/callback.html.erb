<%# What /admin/tiktok/callback shows once the sign-in is stored: which account, what TikTok granted, and when the refresh token dies. It renders the stored connection and no token: nothing here is to be copied anywhere. %>
<section class="max-w-3xl mx-auto px-4 py-10 space-y-6" data-tiktok-connected>
  <h1 class="text-3xl font-bold text-heading">TikTok connected and saved</h1>
  <p class="text-secondary">
    This server stored the connection, with its refresh token encrypted. There is nothing to copy:
    drafting uses it from here on.
  </p>

  <p class="card p-4 text-body" data-tiktok-grant>
    <% if !@can_draft %>
      <span class="font-semibold text-warning">video.upload was not granted</span>, so this connection cannot draft.
      Start again and leave the upload permission on.
    <% elsif @direct_post %>
      <span class="font-semibold">Drafts and direct post.</span>
      This connection can upload to the TikTok inbox and publish to the public feed.
    <% else %>
      <span class="font-semibold">Drafts only.</span>
      This connection can upload to the TikTok inbox. It cannot publish: a direct post is refused until the
      sign-in is run again with video.publish.
    <% end %>
  </p>

  <dl class="card p-4 space-y-3 text-sm">
    <div>
      <dt class="text-muted text-xs mb-1">Account</dt>
      <dd class="text-heading font-semibold break-all" data-tiktok-field="account"><%= @connection.account %></dd>
    </div>
    <div>
      <dt class="text-muted text-xs mb-1">Granted by TikTok</dt>
      <dd class="text-body break-words" data-tiktok-field="scope"><%= @connection.scope.presence || "TikTok named no scope" %></dd>
    </div>
    <div>
      <dt class="text-muted text-xs mb-1">Refresh token expires</dt>
      <dd class="text-body" data-tiktok-field="refresh-expires">
        <% if @connection.refresh_expires_at %>
          <%= @connection.refresh_expires_at.utc.strftime("%B %-d, %Y") %>
          <span class="text-muted">(sign in again before then)</span>
        <% else %>
          TikTok gave no expiry
        <% end %>
      </dd>
    </div>
    <div>
      <dt class="text-muted text-xs mb-1">Connected</dt>
      <dd class="text-body break-all" data-tiktok-field="connected">
        <%= @connection.connected_at.utc.strftime("%B %-d, %Y at %H:%M UTC") %><% if @connection.connected_by.present? %> by <%= @connection.connected_by %><% end %>
      </dd>
    </div>
  </dl>

  <p class="text-secondary text-sm">
    Prove it with <code class="text-primary">bin/tiktok-draft --whoami --production</code>: it prints the
    account this connection posts as.
  </p>
</section>
