<%# ONE BRAND'S LOGOS, TABBED BY TYPE: Icon, Navbar Logo (the default) or
    Stacked Logo. Each tab shows that type's logos once, in the context the
    dropdown picks (light, dark or watermark), with a download and a copy of
    the logo as shown: the icon, or the three text versions. The Navbar Logo tab
    has a Rule control (3, 4 or 6) and shows one rule at a time; it and the Stacked
    Logo tab has a Form control (the brand's own form, and With tagline where
    the brand has a tagline); both can swap every logo for its guide drawing, which fits its plate
    until its labels would be too small, then scrolls sideways. Every control is a
    plain link or a GET form built from logo_page_params, so each keeps the
    others' settings. Read-only. Admin only (LogosController). %>
<%= render "components/copy_text_script" %>
<% name = Logos::Variant.brand_name(@logo) %>
<%# A control's look, chosen or not. A chosen one gets a transparent border, because the neutral button has a 1 px
    border and the primary has none: without it the chosen control is 2 px smaller and the row shifts on a change. %>
<%# This page's focus ring, a fixed colour per hub theme (indigo on light, white on dark). The engine's own .btn
    ring is --color-cta at 70 percent, which measures about 2:1 on the light theme's white card. %>
<% ring = "focus-visible:outline-[#4338CA]! dark:focus-visible:outline-white!" %>
<% chosen = ->(on) { "btn btn-sm #{on ? 'btn-primary border border-transparent' : 'btn-neutral'} #{ring}" } %>
<div class="max-w-6xl mx-auto px-4 py-6 space-y-5">
  <nav class="flex items-center gap-1.5 text-2xs text-muted flex-wrap" aria-label="Breadcrumb">
    <%= link_to "Logos", logos_path(logo_page_params.slice(:context)), class: "hover:text-primary", data: { test: "logos-crumb" } %>
    <span aria-hidden="true">/</span>
    <span class="text-heading font-bold font-mono break-all"><%= @logo.brand %></span>
  </nav>

  <div class="card p-4 sm:p-5 space-y-3">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="text-xl sm:text-2xl font-bold text-heading break-words min-w-0 mr-auto"><%= name %></h1>
      <%= render "context_form", url: logo_brand_path(@logo.brand) %>
    </div>

    <nav class="flex flex-wrap items-center gap-2" aria-label="Logo type" data-test="logo-tabs">
      <% Logos::Variant::TYPES.each do |type, label| %>
        <%= link_to label, logo_brand_path(@logo.brand, logo_page_params(type: (type unless type == :navbar))),
                    class: chosen.(type == @type), aria: { current: ("page" if type == @type) }, data: { test: "logo-tab", type: type } %>
      <% end %>
    </nav>

    <% unless @type == :icon %>
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2" data-test="logo-controls">
        <% if @type == :navbar %>
          <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Rule" data-test="rule-control">
            <span class="text-3xs font-semibold uppercase tracking-wide text-muted" aria-hidden="true">Rule</span>
            <% Logos::Variant::RULES.each do |rule, label| %>
              <%= link_to label, logo_brand_path(@logo.brand, logo_page_params(rule: (rule unless rule == 4))),
                          class: chosen.(rule == @rule), aria: { current: ("true" if rule == @rule) }, data: { test: "rule-option", rule: rule } %>
            <% end %>
          </div>
        <% end %>
        <% if @type == :stacked %>
          <div class="flex flex-wrap items-center gap-2" role="group" aria-label="Form" data-test="form-control">
            <span class="text-3xs font-semibold uppercase tracking-wide text-muted" aria-hidden="true">Form</span>
            <% @logo.forms.each do |form| %>
              <%= link_to Logos::Variant::FORMS.fetch(form), logo_brand_path(@logo.brand, logo_page_params(form: (form unless form == @logo.form))),
                          class: chosen.(form == @form), aria: { current: ("true" if form == @form) }, data: { test: "form-option", form: form } %>
            <% end %>
          </div>
        <% end %>
        <%= link_to (@guides ? "Hide guides" : "Show guides"), logo_brand_path(@logo.brand, logo_page_params(guides: (1 unless @guides))),
                    class: chosen.(@guides), data: { test: "guides-toggle" } %>
      </div>
    <% end %>

    <p class="text-sm text-secondary" data-test="type-sentence"><%= logo_type_sentence(@logo, @type, @rule, (@form if @type == :stacked)) %></p>
    <% if @type == :stacked && @logo.tagline.nil? %>
      <p class="text-sm text-secondary" data-test="no-tagline"><%= name %> has no tagline, so there is no tagline form.</p>
    <% end %>
    <% if @guides && @type != :icon %>
      <p class="text-sm text-secondary" data-test="guides-sentence">
        <% if @type == :navbar %>
          The guide drawings: the numbered rows, filled with faint copies of the name one row tall, so the rows can be counted against the icon; the icon's right edge and where the name starts; and a bracket marked ½ over each of the two equal gaps, after the icon and between the words, each half a cap height.
        <% else %>
          <% small = { two_line: "the small word", one_line: "the name at a third of its size", tagline: "the tagline" }.fetch(@form) %>
          <% turned = @form == :one_line ? "the name at 60% of its size turned on end" : "one copy turned on end" %>
          The guide drawings prove each measurement with faint copies of <%= small %>, spaced exactly as the logo spaces it: one copy per unit, stacked beside the logo and numbered, so each band can be counted, and <%= turned %> beside the icon, bracketed, reading up from its foot to its top, so the icon is as tall as that line is long. A line marks each boundary.
        <% end %>
        They are for looking at, never for shipping. A drawing never shrinks below a readable size: where one is wider than its plate, scroll it sideways.
      </p>
    <% end %>
    <p class="text-2xs text-muted" data-test="read-only-note">This page only shows the logos. Choosing one for the brand comes later, with the brand kit record.</p>
    <%= render "context_notes", logo: (@logo unless @type == :icon) %>
    <% if @logo.note.present? %>
      <p class="text-2xs text-muted" data-test="brand-note"><%= @logo.note %></p>
    <% end %>
  </div>

  <section class="card p-4 sm:p-5" data-test="logo-type" data-type="<%= @type %>" aria-label="<%= Logos::Variant::TYPES.fetch(@type) %>">
    <div class="grid gap-4 <%= 'md:grid-cols-3' if @type == :stacked && !@guides %>">
      <% @variants.each do |variant| %>
        <div class="min-w-0 space-y-1.5" data-test="logo-example" data-tone="<%= variant.tone %>" data-text="<%= variant.text %>">
          <% if variant.text %>
            <h2 class="text-2xs font-semibold uppercase tracking-wide text-muted"><%= Logos::Variant::TEXTS.fetch(variant.text) %></h2>
          <% end %>
          <% if variant.guides %>
            <%# A guide drawing fits its plate until its labels would be too small to read; from there it keeps its width
                and the plate scrolls sideways inside itself. The plate is a tab stop only while it scrolls:
                app/javascript/scroll_tab_stop.js takes the tabindex away when the drawing fits and puts it back when
                it does not. With JavaScript off it stays a tab stop, which costs one extra Tab. %>
            <div class="overflow-x-auto rounded-lg border border-subtle p-4 sm:p-6 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
                 style="<%= logo_plate_style(variant.tone) %>" data-test="logo-plate" data-tone="<%= variant.tone %>"
                 tabindex="0" data-scroll-tab-stop role="group" aria-label="Guide drawing: <%= variant.label %>">
              <%= logo_image(variant, height: logo_height(variant)) %>
            </div>
          <% else %>
            <div class="flex items-center justify-center rounded-lg border border-subtle p-4 sm:p-6 min-w-0" style="<%= logo_plate_style(variant.tone) %>" data-test="logo-plate" data-tone="<%= variant.tone %>">
              <%= logo_image(variant, height: logo_height(variant)) %>
            </div>
          <% end %>
          <div class="flex flex-wrap items-center justify-end gap-2"
               x-data="{ state: 'idle', words: { idle: 'Copy SVG', copied: 'Copied', failed: 'Copy failed' } }">
            <%= link_to "Download", logo_asset_path(variant, download: 1),
                        class: "btn btn-sm btn-neutral #{ring}", data: { test: "logo-download", turbo: false },
                        aria: { label: "Download: #{variant.label}" } %>
            <%# copyText answers false (or rejects) when nothing reached the clipboard: say that, not "Copied". %>
            <button type="button" class="btn btn-sm btn-neutral <%= ring %>" data-test="logo-copy" data-clip="<%= variant.svg %>"
                    aria-label="Copy SVG: <%= variant.label %>" x-text="words[state]"
                    @click="Promise.resolve(window.copyText($el.dataset.clip)).then(ok => ok === false ? 'failed' : 'copied', () => 'failed').then(result => { state = result; setTimeout(() => state = 'idle', 1600) })">Copy SVG</button>
            <span class="sr-only" role="status" x-text="state === 'idle' ? '' : words[state]"></span>
          </div>
        </div>
      <% end %>
    </div>
  </section>
</div>
