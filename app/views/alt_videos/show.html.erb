<% content_for :title, "#{@alt_video.name} · #{@video.title} · McRitchie Studio" %>
<%= render "components/copy_text_script" %>
<%= render "music_videos/player_scripts" %>

<section class="max-w-6xl mx-auto px-4 py-8 sm:py-10" data-test="alt-video" data-number="<%= @alt_video.number %>">
  <header class="mb-6 min-w-0">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2" data-test="alt-video-kicker">
      Source video · <%= @alt_video.name %>
    </p>
    <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3 mb-2 min-w-0">
      <h1 class="text-2xl sm:text-3xl font-bold text-heading break-words min-w-0"><%= @video.title %></h1>
      <% if @clips.any? %>
        <%# The page's primary action: every clip's hand-off in one zip, one folder per clip (AltVideoDownloadsController). %>
        <%= link_to music_video_alt_video_download_path(@video, @alt_video), download: "",
                    class: "btn btn-primary w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2",
                    title: "The source clips, prompts, lettered frames and sheets, one folder per clip",
                    data: { test: "alt-video-download-all", turbo: false } do %>
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16"/></svg>
          <span>Download all assets</span>
        <% end %>
      <% end %>
    </div>
    <p class="text-sm text-muted flex flex-wrap items-center gap-x-3 gap-y-1">
      <span data-test="alt-video-clip-count"><%= pluralize(@clips.size, "clip") %></span>
      <span>built <%= l(@alt_video.created_at, format: :short) %></span>
      <%= link_to "Source video and cast", music_video_path(@video), class: "text-primary hover:underline", data: { test: "alt-video-source-link" } %>
      <%= link_to "All alt videos", alt_videos_path, class: "text-primary hover:underline", data: { test: "alt-video-index-link" } %>
    </p>
  </header>

  <div class="card p-4 mb-4 min-w-0" data-test="alt-video-swaps" data-count="<%= @swaps.size %>">
    <p class="label-upper mb-2">Swaps <span class="normal-case tracking-normal">· snapshotted from the cast when the clips were built; editing the cast never changes them</span></p>
    <% if @swaps.empty? %>
      <p class="text-sm text-muted" data-test="alt-video-swaps-none">Nobody is swapped in this alt video: everyone stays as filmed.</p>
    <% else %>
      <ul class="flex flex-col gap-1.5 text-sm">
        <% performers = @performers.index_by(&:ordinal) %>
        <% @swaps.to_a.each do |entry| %>
          <% performer = performers[entry.performer_ordinal] %>
          <li class="min-w-0 break-words" data-test="alt-video-swap" data-ordinal="<%= entry.performer_ordinal %>">
            <span class="font-semibold text-heading">Person <%= MusicVideos::PersonLetters.for(entry.performer_ordinal) %></span>
            <span class="text-muted">· Person <%= entry.performer_ordinal %><% if performer %> (<%= performer.label %>)<% end %></span>
            <span class="text-muted">→</span>
            <% if (number = @numbers[entry.appearance_slug]) %><span class="font-semibold text-heading">#<%= number %></span><% end %>
            <span class="font-semibold text-heading"><%= entry.label %></span>
            <% unless entry.look_name %><span class="text-warning-ink">· no look was chosen</span><% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <% if @clips.any? %>
    <%= render "alt_videos/watch", alt_video: @alt_video, clips: @clips, watch: @watch, audio_url: @urls[@video.source_object_key] %>
    <%= render "alt_videos/full_video", video: @video, alt_video: @alt_video, clips: @clips, stitches: @stitches, urls: @stitch_urls,
               downloads: @stitch_downloads, here: @stitch_here %>
    <div class="flex flex-col gap-4" data-test="alt-clips">
      <% @clips.each do |clip| %>
        <%= render "alt_videos/clip", clip: clip, chunk: @chunk_for[clip.chunk_ordinal], alt_video: @alt_video, video: @video,
                   swaps: @swaps, urls: @urls, downloads: @downloads, sheets: @sheets, numbers: @numbers,
                   overlap_ms: @video.chunk_overlap_ms.to_i %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state text-muted" data-test="alt-clips-empty">This alt video has no clips: its source had no chunks when it was built.</div>
  <% end %>
</section>
