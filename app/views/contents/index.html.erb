<%# /contents — the Content pipeline kanban, rebased onto the studio/board ENGINE
    PRIMITIVE (studio/board/board). The primitive's `studioBoard` factory
    (studio/_board_assets, homed in the layout) owns drag / cross-column move (PATCH) /
    reorder (POST) / counts / toasts, driving the VENDORED SortableJS (no CDN). This
    wrapper owns only the per-card delete write; the single-column FOCUS/expand lives on
    the primitive's chrome-state home (board_state → studioBoard.state). Cards render
    INSIDE the studioBoard scope but resolve deleteContent from THIS parent scope
    (Alpine nests). No archived column and no live channel — content has neither. %>
<% stages = Content::STAGES %>
<% stage_labels = { "idea" => "Idea", "hook" => "Hook", "script" => "Script", "assets" => "Assets", "assembly" => "Assembly", "posted" => "Posted", "reviewed" => "Reviewed" } %>
<%# gap 2 — per-column count-chip colours (was an inline `case stage`). %>
<% count_colors = {
     "idea" => "bg-blue-900/50 text-blue-300",
     "hook" => "bg-yellow-900/50 text-yellow-300",
     "script" => "bg-mint-900/50 text-mint-300",
     "assets" => "bg-green-900/50 text-green-300",
     "assembly" => "bg-violet-900/50 text-violet-300",
     "posted" => "bg-emerald-900/50 text-emerald-300",
     "reviewed" => "bg-surface-alt text-muted"
   } %>

<%# contentBoardChrome — owns the per-card delete write the primitive stays neutral on,
    delegating the shared toast + count refresh back to the inner studioBoard via
    Alpine.$data. The FOCUS toggle is NOT here — it lives on the studioBoard chrome-state
    home (board_state), reached by the column labels. %>
<script>
function contentBoardChrome() {
  return {
    _pending: {},

    boardData() {
      const section = this.$el.querySelector('[data-test="studio-board"]');
      return (section && window.Alpine && window.Alpine.$data) ? window.Alpine.$data(section) : null;
    },
    boardToast(msg, type) {
      const d = this.boardData();
      if (d && d.toast) { d.toast(msg, type); return; }
      if (type === 'error' && typeof window.alert === 'function') window.alert(msg);
    },
    boardRefreshCounts() { const d = this.boardData(); if (d && d.updateCounts) d.updateCounts(); },
    responseError(resp, fallback) {
      return resp.json().then((err) => new Error(err.error || fallback)).catch(() => new Error(fallback));
    },

    async deleteContent(slug) {
      if (!confirm('Delete this content?')) return;
      if (this._pending[slug]) return;
      this._pending[slug] = true;
      const card = document.getElementById('card-' + slug);
      try {
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/contents/' + slug + '.json', {
          method: 'DELETE',
          headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrf }
        });
        if (!resp.ok) throw await this.responseError(resp, 'Delete failed');
        if (card) { card.remove(); this.boardRefreshCounts(); }
        this.boardToast('Content deleted', 'success');
      } catch (err) {
        this.boardToast(err.message || 'Delete failed', 'error');
      } finally {
        delete this._pending[slug];
      }
    }
  }
}
</script>

<section x-data="contentBoardChrome()" class="min-h-screen">
  <!-- Header -->
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-2xl font-bold text-heading">Content Pipeline</h2>
    <% if logged_in? %>
      <%= link_to "New Idea", new_content_path, class: "btn btn-primary" %>
    <% end %>
  </div>

  <!-- Stage Progression -->
  <%= render "shared/pipeline_progression", highlight: "content" %>

  <%
    # gap 5 — a clickable column label toggles the single-column FOCUS on the
    # studioBoard chrome-state home (state.focusedStage). Rendered raw inside the
    # column <h3>, so `state` resolves against the studioBoard scope; when a column
    # is focused the others' show_expr hides them, so the sole visible one fills the
    # row (the old flex-[3] expand, achieved by hiding siblings).
    focus_label = lambda do |stage, label|
      %(<span class="cursor-pointer hover:text-primary transition" @click="state.focusedStage = state.focusedStage === '#{stage}' ? null : '#{stage}'">#{label}</span>).html_safe
    end
  %>

  <%# The board — rendered by the engine primitive. Columns are the stage keys; each
      card is contents/_content_card, bound to :content. A cross-column drop PATCHes
      { content: { stage } } (the update action); a reorder POSTs the DOM-ordered slugs
      to the shared reorder action (Studio::Board::Reorderable). Static board. %>
  <%= render "studio/board/board",
        board_state: { focusedStage: nil },
        columns: stages.map { |stage|
          {
            key: stage,
            label: focus_label.call(stage, stage_labels[stage]),
            cards: (@contents_by_stage[stage] || []),
            count_class: count_colors[stage],
            min_width: "sm:min-w-[180px]",
            show_expr: "(!state.focusedStage || state.focusedStage === '#{stage}')"
          }
        },
        card_partial: "contents/content_card",
        card_as: :content,
        reorder_url: reorder_contents_path(format: :json),
        reorder_payload: :slugs,
        move_url: "/contents/:id.json",
        move_param: { resource: :content, attr: :stage },
        group: "kanban",
        id_attr: "slug",
        zone_attr: "stage",
        live_channel: nil,
        toasts: true,
        empty_label: "Drop content here" %>
</section>
