<% content_for(:title, "Alex · Learning Heartbeat") %>
<% content_for(:full_width, true) %>

<%# Alex learning heartbeat — the agent-narrated activity table. Each row is an
    AgentActivity (category, reason -> result) with its measured span usage; expand an
    activity to drill into attributed raw actions read-only, or drop into the trailing
    "Unlabeled" group for the tool-calls the agent never narrated. A
    deliberate fixed-dark dashboard (like the launcher terminal, which stays dark on a
    light desktop) sitting on the theme-aware body. The palette mirrors the prototype;
    styles are scoped under the section id so they touch nothing else. The table is
    read-only; clicking a drilled-down action opens the grading drawer, where Alex
    grades the action and the McRitchie audit-of-Alex banks the keepers. %>
<%= render "heartbeat/styles" %>

<%= render "heartbeat/scripts" %>

<section id="alex-heartbeat" data-test="heartbeat" x-data="heartbeatDrawer()" @keydown.escape.window="closeDrawer()">
  <div class="hb-head">
    <header class="hb-topbar">
      <div class="hb-title">
        <h1>Session Activities &middot; Alex Heartbeat</h1>
        <p>
          The activities this session narrated, oldest &rarr; newest &mdash; each a category and a reason &rarr; result.
          Expand an activity to drill into the raw actions it framed; open one to grade it and its McRitchie audit.
        </p>
      </div>
      <% session_totals = heartbeat_usage_totals(@actions) %>
      <div class="hb-stats">
        <div class="hb-stat"><b><%= @activities.size %></b><span>activities</span></div>
        <div class="hb-stat"><b><%= @actions.size %></b><span>actions</span></div>
        <div class="hb-stat"><b><%= heartbeat_tokens_compact(session_totals[:tokens_total]) %></b><span>tokens</span></div>
        <div class="hb-stat"><b><%= heartbeat_cost(session_totals[:cost]) %></b><span>cost</span></div>
        <div class="hb-stat"><b id="hb-stat-graded"><%= @counts[:graded] %></b><span>graded</span></div>
        <div class="hb-stat"><b id="hb-stat-audited"><%= @counts[:audited] %></b><span>audited</span></div>
        <div class="hb-stat"><b id="hb-stat-insights"><%= @counts[:insights] %></b><span>insights</span></div>
      </div>
    </header>

    <div class="hb-toolbar">
      <% if @sessions.size > 1 %>
        <%= form_with url: alex_heartbeat_path, method: :get, data: { turbo: false } do %>
          <span class="hb-lab">Session</span>
          <%= select_tag :session_id,
                options_for_select(@sessions, @session_id),
                class: "hb-sel", onchange: "this.form.requestSubmit()" %>
        <% end %>
      <% elsif @session_id.present? %>
        <span class="hb-lab">Session</span>
        <span class="hb-meta hb-mono"><%= @session_id %></span>
      <% end %>
      <%= render "heartbeat/nav", current: :session, insights_count: @counts[:insights] %>
      <span class="hb-legend">
        <span><b>activity:</b> category &middot; reason &rarr; result</span>
        <span><b>drill down:</b> expand an activity &middot; click an action to grade</span>
      </span>
    </div>
  </div>

  <% if @activity_rows.any? || @unlabeled.any? %>
    <%= render "heartbeat/activity_table", activity_rows: @activity_rows, unlabeled: @unlabeled,
          pokemon_by_slug: @pokemon_by_slug, agents_by_slug: @agents_by_slug,
          activity_grades: @activity_grades, shared_turn_ids: @shared_turn_ids,
          stage_transitions: @stage_transitions %>
  <% else %>
    <div class="hb-empty" data-test="heartbeat-empty">
      <b>No activities captured yet</b>
      <p>Capture is forward-only — activities and actions land here as sessions run. Seed demo activity locally with <code class="hb-mono">rake atomic:demo_seed</code>.</p>
      <p><%= link_to "&lsaquo; back to the session launcher".html_safe, launcher_path %></p>
    </div>
  <% end %>

  <%= render "heartbeat/drawer_host" %>
</section>
