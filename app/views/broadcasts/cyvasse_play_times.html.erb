<%# "How was your first game, and when can you play": a short personal note to
    legacy Cyvasse players (task cyvasse-play-times-email). It asks about the
    first game on the new Cyvasse (optional in the survey for anyone who has not
    played), then when they are free, to pick a standing biweekly Cyvasse Night.
    One button and one plain link, both the tracked l=survey link to Cyvasse's
    play-times survey; the click tracker adds the reader's token as ?ref=. The
    engine survey cannot pre-fill an answer from the URL, so the email shows no
    per-answer links. The subject comes from Broadcasts::CyvassePlayTimes; no
    merge field is required. %>
<% links      = Broadcast::TEMPLATE_LINKS["cyvasse_play_times"] %>
<% survey_url = broadcast_link(:survey, links["survey"]) %>
<% p_style    = "margin:0 0 18px 0;font-size:16px;line-height:1.65;color:#2b3440;" %>
<% content_for :email_reason, "You&rsquo;re receiving this because you have an account on Cyvasse.".html_safe %>
<%= render "broadcasts/email_head",
      hero_file: "cyvasse_header_live.jpg",
      hero_alt:  "A Cyvasse board mid-game",
      preheader: "And help us pick a time for a regular Cyvasse Night. It takes 30 seconds.",
      title:     "How was your first game?",
      subtitle:  "And when can you play?" %>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td style="padding:28px 32px 8px 32px;">
      <p style="<%= p_style %>">Hi &#x1F44B;&#x1F3FB;</p>
      <p style="<%= p_style %>" data-block="body">How was your first game on the new Cyvasse? We&rsquo;re also starting a regular <strong>Cyvasse Night</strong>, every other week, when everyone plays live at the same time.</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;" data-block="ask">Tell us when you&rsquo;re free and we&rsquo;ll pick the time. It takes 30 seconds, and you can skip the first question if you haven&rsquo;t played yet.</p>
    </td>
  </tr>

  <tr>
    <td style="padding:22px 32px 8px 32px;text-align:center;">
      <%= render "broadcasts/button", url: survey_url, label: "Tell us (30 seconds) &rarr;".html_safe, color: "#8E82FE", full_width: true %>
    </td>
  </tr>

  <tr>
    <td style="padding:6px 32px 8px 32px;text-align:center;">
      <p style="margin:0;font-size:13px;line-height:1.6;color:#64748b;" data-block="plain-link">Or open it here: <a href="<%= survey_url %>" style="color:#6d5ff5;text-decoration:underline;">cyvasse.mcritchie.studio/surveys/play-times</a></p>
    </td>
  </tr>

  <tr>
    <td style="padding:20px 32px 28px 32px;">
      <p style="margin:0 0 4px 0;font-size:16px;line-height:1.65;color:#2b3440;">Thanks,</p>
      <p style="margin:0;font-size:16px;line-height:1.65;color:#2b3440;">&mdash; Alex</p>
    </td>
  </tr>
</table>
