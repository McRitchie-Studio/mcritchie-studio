<%# Who is on screen, at the bottom of the card under the Keep Original / Swap back button: optional, quieter than Replace with, and always open. A plain search input (artists and People who are not athletes or coaches, Artists::Search, so an athlete meant for Replace with is not picked here); typing searches and a pick names the performer and saves at once (window.namingCard, a JSON PATCH, no reload). Named: the person (headshot, vocation, team) with a small Clear, the input still underneath to rename. An extra: a small removable chip. "Mark as extra" is a text link by the input. What it shows comes from MusicVideos::CastCardNaming, as the endpoint answers it. %>
<% n = performer.ordinal %>
<% named = MusicVideos::CastCardNaming.state(performer, rows: local_assigns[:rows]) %>
<div x-data="namingCard()" class="min-w-0 space-y-1.5" data-test="performer-resolution"
     data-save-url="<%= music_video_performer_path(video, n) %>" data-search-url="<%= search_artists_path(format: :json) %>"
     data-ordinal="<%= n %>"<% if named %> data-named="<%= named.to_json %>"<% end %>>
  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-0.5 min-w-0">
    <label for="artist-search-<%= n %>" class="text-xs text-muted">Who is this on screen? <span class="italic">(optional)</span></label>
    <span role="status" aria-live="polite" class="text-3xs min-w-0" data-test="naming-save-state">
      <span x-show="save === 'saving'" x-cloak class="text-muted">Saving…</span>
      <span x-show="save === 'saved'" x-cloak class="text-success-ink" data-test="naming-saved">Saved</span>
      <span x-show="save === 'failed'" x-cloak class="text-warning-ink" data-test="naming-failed">
        Not saved. <button type="button" @click="retry()" class="font-semibold underline hover:text-heading">Retry</button>
      </span>
    </span>
  </div>
  <p x-show="save === 'failed' && error" x-cloak x-text="error" class="text-3xs text-warning-ink break-words" data-test="naming-error"></p>

  <div x-show="named && named.kind === 'artist'" <%= "x-cloak" unless named&.dig(:kind) == "artist" %>
       class="flex items-center gap-2 min-w-0 rounded-lg border border-subtle p-1.5" data-test="performer-artist" :title="named ? named.slug : ''">
    <%= render "music_videos/person_avatar", person: "named", size: "w-8 h-8", icon: "w-5 h-5", failed: "avatarFailed" %>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-semibold text-heading truncate" x-text="named ? named.name : ''" data-test="performer-artist-name"><%= named[:name] if named&.dig(:kind) == "artist" %></span>
      <span class="block text-3xs text-muted truncate" x-text="named ? [named.vocation, named.team].filter(Boolean).join(' · ') : ''"
            data-test="performer-artist-utility"><%= [named[:vocation], named[:team]].compact.join(" · ") if named&.dig(:kind) == "artist" %></span>
    </span>
    <button type="button" @click="clear()" class="text-xs text-muted hover:text-primary hover:underline shrink-0 px-1"
            :aria-label="named ? 'Clear ' + named.name : 'Clear'" data-test="performer-artist-clear">Clear</button>
  </div>

  <span x-show="named && named.kind === 'extra'" <%= "x-cloak" unless named&.dig(:kind) == "extra" %>
        class="badge text-3xs bg-surface-alt text-secondary border-subtle gap-1" data-test="performer-extra">
    An extra, not a named artist
    <button type="button" @click="clear()" aria-label="Not an extra" class="text-muted hover:text-heading leading-none" data-test="performer-extra-remove">&times;</button>
  </span>

  <div class="relative min-w-0" @click.outside="open = false" data-test="performer-typeahead">
    <input id="artist-search-<%= n %>" type="text" autocomplete="off" role="combobox"
           aria-autocomplete="list" :aria-expanded="open" aria-controls="artist-results-<%= n %>"
           placeholder="Search artists and people"
           class="input-field py-1.5 text-sm w-full min-w-0" x-model="query" @input.debounce.250ms="search()"
           @keydown.arrow-down.prevent="move(1)" @keydown.arrow-up.prevent="move(-1)"
           @keydown.enter.prevent="pickActive()" @keydown.escape="open = false">

    <div x-show="open" x-cloak id="artist-results-<%= n %>" role="listbox"
         class="absolute z-20 left-0 right-0 mt-1 card shadow-lg max-h-80 overflow-y-auto p-1" data-test="typeahead-results">
      <template x-for="(r, i) in results" :key="r.type + r.slug">
        <%= render "music_videos/search_row", option_test: "typeahead-option", hint: "r.hint",
                   badge: "r.type === 'person' ? 'people' : r.kind",
                   badge_class: "r.kind === 'group' ? 'bg-primary/10 text-primary border-primary/20' : 'bg-surface-alt text-secondary border-subtle'" %>
      </template>
      <p x-show="!loading && failed" class="px-3 py-2 text-sm text-warning-ink">Search failed. Try again.</p>
      <p x-show="!loading && !failed && results.length === 0" class="px-3 py-2 text-sm text-muted">No artist or person matches.</p>
      <button type="button" x-show="!loading && query.trim().length > 0 && !exactMatch" @click="startCreate()"
              class="w-full text-left rounded-lg px-3 py-2 text-sm text-primary hover:bg-surface-alt" data-test="typeahead-create">
        Create new artist “<span x-text="query.trim()"></span>”
      </button>
    </div>
  </div>

  <div x-show="creating" x-cloak class="flex flex-col sm:flex-row gap-2" data-test="create-artist">
    <input type="text" x-model="newName" aria-label="New artist name" class="input-field py-1.5 text-sm flex-1 min-w-0" data-test="create-artist-name">
    <select x-model="newKind" aria-label="Kind" class="input-field py-1.5 text-sm sm:w-auto">
      <option value="person">Person</option>
      <option value="group">Group</option>
    </select>
    <button type="button" @click="createArtist()" class="btn btn-primary btn-sm" :disabled="newName.trim().length === 0" data-test="create-artist-submit">Create and link</button>
  </div>

  <div class="flex flex-wrap items-center justify-between gap-x-3 text-3xs text-muted">
    <span>Names the artist in the rolodex, not who replaces them.</span>
    <button type="button" x-show="!named || named.kind !== 'extra'" <%= "x-cloak" if named&.dig(:kind) == "extra" %> @click="markExtra()"
            class="hover:text-primary hover:underline" data-test="mark-extra">Mark as extra</button>
  </div>
</div>
