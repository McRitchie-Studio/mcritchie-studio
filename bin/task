#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/task — deterministic CLI for the McRitchie Studio agent task board.
#
# Wraps /api/v1 so agents never hand-roll auth, JSON, or stage transitions.
# Three footguns it removes for you:
#   * `update` does read-merge-write on metadata.devops, so a partial update
#     NEVER wipes existing devops fields (the raw API replaces them wholesale).
#   * list flags are repeatable and sent as arrays, so commas inside individual
#     values are preserved by the task-board API.
#   * unknown flags are REJECTED (exit 1) with a nearest-flag suggestion —
#     a typo'd flag can never silently drop data (`--pr` means `--pr-url`).
#
# Auth: AGENT_API_SECRET from ENV, else 1Password (op://agents/Agent API
# Secret/AGENT_API_SECRET), else the repo .env. Base URL via TASK_API_BASE
# (default https://mcritchie.studio).
#
# Usage:
#   bin/task list [--stage S] [--agent A]
#   bin/task show <slug> [--json | --verbose|-v]
#     ( default is terse; --json prints the full fetched record as pretty JSON
#       (no token dance); --verbose/-v expands the acceptance BULLETS, agent_context,
#       test_plan, checks_run, claim state, pr_url/local_url, and the top-level
#       `merged` + `release_slug` columns for a human read. )
#     ( `merged` and `release_slug` are TOP-LEVEL Task columns, NOT devops keys:
#       `.metadata.devops.<either>` is null on every task, stamped or not — the
#       server refuses a devops write to both names (Task::DEVOPS_COLUMN_KEYS).
#       --verbose always prints both, and distinguishes empty ("not merged") from a
#       payload that carries no such key at all ("UNREPORTED"). )
#   bin/task stale [<slug>]
#     ( flags a task whose work is already on origin/main (fixed out-of-band) while
#       the task isn't shipped/archived. Resolves the branch (devops.branch or
#       feat/<slug>), git-fetches, and reports if origin/<branch> is an ancestor of
#       origin/main. With NO slug it scans every open task and lists the stale ones. )
#   bin/task field <slug> <key>              # machine-readable single value (e.g. mascot)
#     ( `merged` and `release_slug` resolve from the COLUMN only — same store as
#       --verbose. Every other key is devops-first with a column fallback. )
#   bin/task create --title T [--slug readable-handle] [--kind K] [--shape S] [--worktree-slug W] [--priority N] [--agent A] \
#   ( --slug sets a readable, immutable Task.slug → /tasks/<slug>; it also seeds
#     worktree_slug + branch (feat/<slug>). Omit it for an opaque task-<hex>. )
#                   [--repo R ...] [--risk R ...] [--accept "..." ...] [--test "..." ...] \
#                   [--checks "..." ...] [--branch B] [--pr-url U] [--local-url U] [--approval waiting|approved|changes_requested|none] \
#                   [--po-size S] [--dev-size S] [--pm-size S] [--post-deploy-cmd "rake foo:bar"] [--no-claim]
#   ( --shape feeds bin/dor-check: one of the keys in config/feature_shapes.yml )
#   ( --no-claim files the task WITHOUT repointing this session's active-feature
#     marker at it — filing a task is not building it. Use it when a conductor /
#     batch opens follow-up tasks it is not about to build (only an explicit
#     `move building` claims). )
#   ( --po-size/--dev-size/--pm-size set the size trio: small|medium|large|xl.
#     Avi seeds --po-size at creation (the default sizer, not a hard gate);
#     actual_size is auto-derived from measured usage at ship. )
#   ( --checks records devops.checks_run; tag each line by tier, e.g. "[unit] ...".
#     It REPLACES your tier tags (pass every one you want kept) but can NOT drop the
#     cert evidence bin/fast-check / bin/full-suite-check stamp — "[full-suite@<fp>]"
#     lines are machine-owned and carried forward. Record checks before or after you
#     certify; both orders are safe. See lib/cert_evidence.rb. )
#   ( --post-deploy-cmd: the release pipeline runs it on the deployed app after
#     boot — QA on `bin/release prepare`, prod on `ship`. Must be idempotent. )
#   ( --requires-migration / --no-requires-migration: the `backend_migration`
#     exclusive-lane flag, a top-level Task column. SELF-FLAG it the moment you
#     discover the task needs a schema change, then take the lane with
#     `bin/task migration-lane acquire <slug>`. See exclusive-lanes.md. )
#   bin/task begin --title T [--repo APP] [--steal] [same flags as create]
#   bin/task begin <slug> [--steal]                  # resume a partial begin
#     ( the fast-lane SESSION-START wrapper: create + agent-worktree new +
#       bind-task + move building + session-preflight in ONE command, printing
#       the worktree path, port, and task URL. The slug is derived from the
#       title CLIENT-side and passed explicitly, so rerunning the same begin —
#       or `begin <slug>` — RESUMES after a partial failure instead of minting
#       a duplicate task. Orchestration only: the claim gate, preflight, and
#       every later gate keep their own semantics — a resume of an already-
#       `building` task runs the SAME build-claim gate the move applies, so a
#       task a DIFFERENT live instance holds refuses before any worktree step;
#       --steal overrides it exactly as it does on `move`, and is forwarded to
#       the child `move building` on the fresh path. bin/ship is the handoff twin. )
#   bin/task update <slug> [same flags as create]   # merges into existing devops
#   bin/task move <slug> <stage>                     # designed|building|submitted|reviewed|assembled|shipped|blocked|archived
#     [--model M] [--tokens-in N] [--tokens-out N] [--cost D] [--actor A] [--dev-size S] [--steal]
#     ( --dev-size (small|medium|large|xl) records the builder's own estimate as it
#       claims the task at `building` — optional; absent is fine. )
#     ( best-effort per-transition usage the agent burned in the stage it's
#       leaving — recorded on this move's TaskEvent. With NO usage flags, a
#       Claude/Codex session auto-captures model + token delta + cost from its
#       transcript, so a bare move still leaves a full paper trail; flags
#       override. The from/to/duration spine is recorded server-side regardless. )
#     ( the move to `building` CLAIMS the task for this live instance (session id +
#       a per-process nonce) under a TTL lease. It REFUSES (loudly) if a DIFFERENT,
#       non-expired instance already holds it — pass --steal to take it over. An
#       expired / dead-session lease is reclaimed automatically. )
#   bin/task merged <slug> <accepted|release|main>
#     ( set the git-location crash-recovery signal (Task::MERGED_STATES) — where the
#       task's code physically is. Review stamps `accepted` when it lands a feat PR
#       on the accepted branch (the ladder's first rung); the sweep/ship stamp
#       release/main. NOT a stage move, NOT event-recorded; read back to confirm it
#       persisted so a dropped stamp never strands the task off every RC. )
#   bin/task heartbeat <slug>                         # renew this instance's build-claim lease (bin/statusline calls it)
#   bin/task session-mascot [--persona SLUG|none] [--print]
#     ( draw this Claude/Codex session's Pokémon marker before a task exists.
#       --persona jasper temporarily shows a soul instead; --persona none reverts. )
#   bin/task intent <slug> --to <stage> [--actor SLUG] [--reviewer slug:weight ...]
#     ( records an agentic INTENT — an agent STARTING a stage's work — so the board +
#       timeline show who's on it with a live ticker before the transition lands.
#       --actor for a single owner (Avi QA → assembled, Steffon ship → shipped);
#       repeat --reviewer for the senior pair (the review pair is normally recorded
#       automatically by bin/reviewer-select, which records by default). )
#   bin/task bounces <slug>
#     ( THE TWO-BOUNCE CIRCUIT BREAKER's read — run it BEFORE a rework block.
#       Counts the task's prior send-backs from its durable qa_feedback activity
#       trail (never the live block columns: a compliant resubmission wipes those,
#       so they read CLEAR exactly when the breaker must fire).
#       Exit: 0 CLEAR — the ONLY exit that authorizes a re-block · 10 TRIPPED
#       (escalate) · any other non-zero = a FAILED read (1) or an unknown slug (4),
#       never a zero. It never prints a count it could not read; the recipe this
#       replaced answered "0" for every task on earth, because it counted rows on
#       an unparsed Net::HTTPResponse, whose #[] reads HTTP HEADERS. )
#   bin/task block <slug> [--kind environment|rework|dependency] [--feedback "..."] [--agent A] [--breaker-ack "reason"]
#     ( marks a `building` ATTRIBUTE: stamps blocked_at/blocked_from/blocked_by/
#       block_kind (no →blocked stage) + posts a qa_feedback activity stamped with
#       the kind, so the bounce ledger stays classifiable after the columns clear.
#       A --kind rework block with NO --feedback still posts one (with a placeholder
#       body + a warning): the columns are wiped on resubmit, so a prose-less bounce
#       would otherwise vanish from every durable store and never be counted. )
#     ( --kind rework RUNS `bounces` FIRST and REFUSES (exit 10) when the breaker is
#       tripped, naming the escalation. --breaker-ack "reason" proceeds anyway for a
#       MECHANICAL bounce (red CI, merge conflict — nothing to arbitrate); the reason
#       is recorded on the activity, so an override is evidence, not a bypass. )
#   bin/task note <slug> --handoff "..." | --qa-feedback "..." | --clarification "..." | --comment "..." [--agent A] [--resolves-feedback]
#     ( posts a task activity via POST /api/v1/activities; flags map to
#       activity_type handoff/qa_feedback/clarification/comment. Repeatable +
#       combinable — one activity is posted per flag given. --resolves-feedback
#       marks handoff notes as explicitly addressing open QA feedback; it
#       requires a --handoff note (on other note types it would silently
#       no-op, so the CLI dies instead of dropping the flag). )
#   bin/task usage-audit [--dir PATH]
#     ( READ-ONLY sweep of the usage/cost baseline store (<projects>/.agents/task-usage)
#       for rows a TEST run left behind — a stub slug, or a cache-read total no single
#       task could burn. Those rows price into measured $cost, which derives
#       actual_size and the reviewer-select baselines. Reports only — purging is the
#       operator's call. Exit 2 when suspects are found. )
#   bin/task migration-lane <acquire|release|status> [<task-slug>] [--label L] [--agent A]
#     ( The `backend_migration` EXCLUSIVE LANE — one Dev writes a migration at a time
#       (docs/agents/system/exclusive-lanes.md). Acquire BEFORE `bin/rails g migration`,
#       before creating a file in db/migrate/, before touching db/schema.rb; release on
#       the way out. The lane is global, so the optional <task-slug> only RECORDS which
#       task holds it, so a refused Dev knows whom to ask for an ETA.
#       Pair it with `--requires-migration` on create/update: the flag says this task
#       needs a schema change, the lane serializes the work.
#       `status` is a plain read and needs no agent session; acquire/release do.
#       Exit: 0 acquired/reported · 10 REFUSED (a live holder — queue, don't retry-storm)
#       · 1 error. )
#   bin/task <cmd> --help | -h                        # print this usage from any position
#
# Unknown flags are rejected (exit 1) with a nearest-flag suggestion; a dashed
# token is never parsed as a slug.
#
# Exit codes are a CONTRACT (bin/agent-worktree's reclaim guard classifies on
# them — a destroy path):
#   0  success
#   4  EXIT_TASK_NOT_FOUND — the board POSITIVELY answered "there is no such
#      task" (HTTP 404 + the API's own "task not found" body). Never fired on a
#      failed read: a Heroku router 404, a route-level 404, a 5xx, or a rejected
#      flag all stay on 1, because the guard FREES a worktree on this code.
#  10  REFUSED — a live holder refused `migration-lane acquire`, or the two-bounce
#      circuit breaker refused `bounces` / `block --kind rework` (escalate, do not
#      retry). Distinct from 1 so "the breaker says escalate" is never confused
#      with "the read failed".
#   1  everything else — transport/API failures, usage errors, rejected flags.

require "net/http"
require "json"
require "uri"
require "fileutils"
require "shellwords"
require_relative "../lib/agent_session_usage"
require_relative "../lib/task_usage_baseline"
require_relative "../lib/task_usage_sandbox"
require_relative "../lib/task_usage_audit"
require_relative "../lib/claim_lease"
require_relative "../lib/desk_activity"
require_relative "../lib/cert_evidence"
require_relative "../lib/stale_check"
require_relative "../lib/feature_marker"
require_relative "lib/task_board"
require_relative "lib/bounce_ledger"
require_relative "lib/task_column_fields"
require_relative "lib/session_identity"
require_relative "lib/projects_root"
require_relative "lib/bin_helpers"
require_relative "lib/cert_root_guard"
require_relative "lib/fast_lane"
require_relative "lib/stamp_confirmation"

BASE_URL = ENV.fetch("TASK_API_BASE", "https://mcritchie.studio")
SHINY_EMOJI = "✨"

# Honors CLAUDE_PROJECTS_DIR (as bin/statusline does) so a session and its status
# line agree on the marker location — and so tests can isolate it; defaults to the
# projects root even when this script runs from an isolated worktree.
PROJECTS_DIR = (dir = ENV["CLAUDE_PROJECTS_DIR"].to_s.strip).empty? ? ProjectsRoot.default_projects_dir : File.expand_path(dir)

# Per-session active-feature marker path, keyed by Claude/Codex session id so each
# session shows its OWN feature (no cross-session leak). nil when there's no
# agent session id.
def feature_marker_path
  sid = session_identity.first.to_s.strip
  return nil if sid.empty?

  File.join(PROJECTS_DIR, ".agents", "sessions", "#{sid.gsub(/[^A-Za-z0-9._-]/, "")}.json")
end

# READ-ONLY audit of the cost store. A METHOD, not four inline lines in the dispatch
# `case` below, because test/lib/state_store_containment_test.rb forbids top-level
# script code from reaching a raw <projects>/.agents path at all: every store path must
# live in a named method, where the containment scan can see it and where it must be
# either laundered or declared (this one is declared — TaskUsageAudit.report only reads).
# An inline store path in a 1,200-line `case` is exactly where the next unguarded write
# goes unnoticed, which is the bug that PR #549's review found in bin/atomic-event.
def usage_audit!(dir)
  text, suspects = TaskUsageAudit.report(dir || File.join(PROJECTS_DIR, ".agents", "task-usage"))
  print(text)
  exit(suspects.zero? ? 0 : 2)
end

# The agent session working this task — stamped on create + on the move to
# `building` (the claim moment) so the board + status line can show which
# terminal owns a task and offer a click-to-copy resume command. Claude exposes
# CLAUDE_CODE_SESSION_ID; Codex exposes CODEX_THREAD_ID. Returns [id, provider],
# or [nil, nil] for a plain shell / CI run (stamp nothing — graceful).
def session_identity
  SessionIdentity.identity
end

def parent_session_identity
  %w[
    MCRITCHIE_PARENT_SESSION_ID
    AGENT_PARENT_SESSION_ID
    CODEX_PARENT_THREAD_ID
    CLAUDE_PARENT_SESSION_ID
  ].each do |key|
    value = ENV[key].to_s.strip
    return value unless value.empty?
  end

  nil
end

# Merge the captured session id/provider into a devops hash. No-op (returns the
# input) when there's no session, so non-Claude/CI runs stamp nothing.
def stamp_session(devops)
  id, provider = session_identity
  return devops if id.nil?

  merged = (devops || {}).dup
  merged["session_id"] = id
  merged["session_provider"] = provider
  merged
end

def titleize_marker_name(value)
  raw = value.to_s.tr("-", " ").strip
  return "" if raw.empty?

  raw[0].upcase + raw[1..].to_s
end

def truthy_marker_value?(value)
  value == true || %w[true 1 yes on].include?(value.to_s.strip.downcase)
end

def shiny_marker_state(value)
  return true if truthy_marker_value?(value)
  return false if value == false || %w[false 0 no off].include?(value.to_s.strip.downcase)

  nil
end

def marker_display_emoji(marker)
  emoji = marker["mascot_emoji"].to_s.strip
  state = shiny_marker_state(marker["mascot_shiny"])
  shiny = state.nil? ? emoji.include?(SHINY_EMOJI) : state
  if state == false
    base = emoji.delete(SHINY_EMOJI)
    return base.empty? ? nil : base
  end
  return emoji unless shiny

  base = emoji.delete(SHINY_EMOJI)
  base.empty? ? SHINY_EMOJI : "#{base}#{SHINY_EMOJI}"
end

def print_session_marker(marker)
  mascot = titleize_marker_name(marker["mascot"])
  head = [marker_display_emoji(marker), mascot].map(&:to_s).map(&:strip).reject(&:empty?).join(" ").strip
  parts = [head, marker["app"], marker["worktree_slug"] || marker["feature"]].map(&:to_s).map(&:strip).reject(&:empty?)
  puts parts.join(" · ")
end

# --- Build claim lease (V2: the enforcement gate) --------------------------
# The per-PROCESS-instance nonce that, with the session id, identifies the LIVE
# INSTANCE holding a claim (see lib/claim_lease.rb). Anchored to the long-lived
# `claude`/`codex` agent process so it's stable across a terminal's many bin/task
# calls yet differs between two terminals — the shared resolution now lives on
# SessionIdentity.nonce (reused by bin/devops-shift's shift lease). Memoized here so
# the gate + the renewal agree and `ps` runs once.
def claim_nonce
  return @claim_nonce if defined?(@claim_nonce)

  @claim_nonce = SessionIdentity.nonce(ENV)
end

# The narration CLI (fast-lane-narrates-activities): `begin` opens the session's
# ORIENT activity through this so the default fast-lane path leaves a
# task-attributed trail instead of stranding orientation in the Unlabeled bucket.
# Overridable for tests.
ACTIVITY_BIN = ENV.fetch("TASK_ACTIVITY_BIN", File.expand_path("agent-activity", __dir__))

# Fire one bin/agent-activity subcommand, best-effort — narration is NON-FATAL by
# contract and must NEVER fail a board op. No session identity → skip (nothing to
# attribute to), mirroring the claim/plain-shell degrade. Output is discarded so
# narration never clutters the CLI.
def narrate(*args)
  return if session_identity.first.nil?

  system(ACTIVITY_BIN, *args, out: File::NULL, err: File::NULL)
rescue StandardError
  nil
end

# Refuse a move-to-building when the task is already claimed by a DIFFERENT,
# still-live instance — unless --steal. Unclaimed / expired / corrupt /
# same-instance claim freely. Loud (not a hard block): it prints WHO holds it +
# how to override.
#
# :corrupt (an unparseable lease) stays DELIBERATELY fail-open here, unlike the
# reclaim guard (bin/agent-worktree), which withholds on it: claiming a task
# WRITES a fresh parseable lease via ClaimLease.renewed — a reversible act that
# heals the corrupted record — whereas reclaiming destroys a desk, which heals
# nothing. Same disposition, opposite stakes.
def enforce_claim_gate!(slug, devops, mover_session, steal:, task: nil, steal_hint: nil)
  claim = ClaimLease.from_devops(devops)
  decision = ClaimLease.evaluate(claim, session: mover_session, nonce: claim_nonce)
  return if decision != :held_by_other || steal

  held = claim["claimed_session"].to_s
  age = ClaimLease.heartbeat_age(claim)
  warn!("⚠  task #{slug} is already claimed by a DIFFERENT live instance:")
  warn!("     session …#{held[-4..] || held}  instance #{claim["claim_nonce"]}  ·  last heartbeat ~#{age}s ago " \
        "(lease TTL #{ClaimLease::DEFAULT_TTL_SECONDS}s)")
  # The heartbeat above only proves a TERMINAL IS PAINTING — it says nothing about
  # whether the holder is advancing. Name the progress fact too, so the decision to
  # --steal is made on evidence instead of on a green dot.
  warn!("     #{progress_line(task, challenger: mover_session)}") if task
  warn!("   Another terminal looks active on this task. To take it over anyway, re-run with --steal:")
  # The hint names the caller's OWN command (`begin` passes its resume form) so
  # the operator re-runs the path they were on, not a different one.
  warn!("     #{steal_hint || "bin/task move #{slug} building --steal"}")
  exit 1
end

# "last durable progress ~28m ago (cert failed)" — or an honest "unknown" when the
# task has produced no artifact yet. Never dress an absence of evidence as trouble.
#
# AND NEVER CREDIT THE HOLDER WITH WORK IT DID NOT DO. This line is the evidence a
# second agent decides `--steal` on, and on 2026-08-13 it manufactured that
# evidence: the refused agent had just run `bin/full-suite-check`, its cert landed
# a g1_cert row on the task, and this line reported "last durable progress ~2m ago
# (g1_cert passed)" as the holder's. The gate credited the challenger's own work to
# the holder and cited it as grounds to keep the challenger out — a claim that
# generates its own justification, which is unfalsifiable rather than merely wrong.
#
# So progress is reported HOLDER-SCOPED, and the unattributed remainder is named
# as what it is. `challenger` is the session asking, so the one reading that it
# cannot use its own cert as proof of someone else's liveness is the session that
# ran it.
def progress_line(task, challenger: nil)
  holder_seconds = task["holder_progress_seconds_ago"]
  return holder_progress_line(task, holder_seconds) unless holder_seconds.nil?

  seconds = task["progress_seconds_ago"]
  return "last durable progress: none recorded yet (no cert, gate, or stage move)" if seconds.nil?

  # Something landed, but not the holder's. Say whose, and say plainly that it is
  # not evidence about the holder.
  actor = task["last_progress_actor"].to_s
  detail = task["last_progress_label"].to_s.empty? ? "" : " (#{task['last_progress_label']})"
  whose =
    if !actor.empty? && actor == challenger.to_s
      "is THIS session's own work"
    elsif actor.empty?
      "has no recorded owner"
    else
      "belongs to …#{actor[-4..] || actor}"
    end

  "the holder has landed nothing attributable to it — the newest artifact " \
    "(~#{ClaimLease.humanize_age(seconds)} ago#{detail}) #{whose}, so it says nothing about the holder"
end

# A holder-scoped liveness fact, falling back to its task-wide twin when the board
# does not publish one. A MISSING key means an older board, which is an unknown —
# and the fallback is the conservative direction, because the task-wide signals are
# strictly more protective (they count everyone's work, so they can only keep a
# desk, never free one). A key that is present and nil is a real answer and is
# passed through as one.
def holder_scoped(task, holder_key, task_wide_key)
  task.key?(holder_key) ? task[holder_key] : task[task_wide_key]
end

# Has the holder walked away? Gathers the four independent channels ClaimLease
# .abandoned? weighs and hands them over — the arithmetic stays in the shared
# module (so the unit tier can exercise every combination), the I/O stays here.
#
# The desk is asked FIRST and its unknown answer decides alone, because the desk
# is the only channel that can see an agent editing code without touching the
# board — the exact holder this gate must never evict. `desk_root` refuses any
# directory not bound to this task, so a heartbeat fired from a primary checkout
# (whose mtimes belong to every agent on the machine, and so are always fresh)
# resolves nil and the claim is kept rather than judged on someone else's work.
#
# THE BOARD CHANNELS ARE HOLDER-SCOPED, and that is the difference between fixing
# this and half-fixing it. Both remaining channels used to read the TASK-WIDE fact,
# so a queued challenger running `bin/full-suite-check` on the held slug landed a
# checkpoint and opened a g1_cert on someone else's task — and the abandoned holder
# renewed for another 1h29m on the strength of the challenger's own work. That is
# the incident this gate exists to end, one indirection over from where it was
# fixed in the refusal message.
#
# The gate_in_flight channel is FILTERED, never dropped: a cert writes nothing into
# the desk for up to 94 measured minutes, so a holder mid-cert still needs it. A
# gate opened BY the holder protects the holder; one opened by a challenger does
# not; one nobody signed is an unknown and still protects.
def heartbeat_abandoned?(slug, task, devops, desk_hint)
  root = DeskActivity.desk_root(desk_hint || Dir.pwd, slug)
  touched = root.nil? ? nil : DeskActivity.touched_since?(root, Time.now - ClaimLease::DESK_IDLE_SECONDS)

  ClaimLease.abandoned?(
    desk_touched: touched,
    progress_age: holder_scoped(task, "holder_liveness_seconds_ago", "progress_seconds_ago"),
    gate_in_flight: holder_scoped(task, "holder_gate_in_flight", "gate_in_flight") ? true : false,
    awaiting_approval: devops["approval_status"].to_s.strip == "waiting"
  )
rescue StandardError
  # A liveness check that blew up has told us NOTHING, and nothing must never
  # free a desk. Best-effort like the rest of the heartbeat.
  false
end

def holder_progress_line(task, seconds)
  label = task["holder_progress_label"].to_s
  detail = label.empty? ? "" : " (#{label})"
  quiet = task["progress_quiet"] ? "  ← held, but nothing has landed in a long time" : ""
  # ClaimLease owns the formatter (required above): the gate and the board card
  # state the same fact, so they render it through the same code.
  "last durable progress by the holder ~#{ClaimLease.humanize_age(seconds)} ago#{detail}#{quiet}"
end

SCALAR_FLAGS = {
  "--kind" => "kind", "--shape" => "shape", "--worktree-slug" => "worktree_slug",
  "--branch" => "branch", "--pr-url" => "pr_url",
  "--local-url" => "local_url", "--qa-url" => "qa_url", "--prod-url" => "production_url",
  # NO --release-slug / --release-train, deliberately. `release_slug` was the
  # ecosystem's one name that existed in BOTH stores at once: a top-level Task
  # column AND a devops key, disjoint. These flags wrote the devops key, which no
  # release code ever read — the sweep writes the column (Release#record_members)
  # and bin/conductor reads the column — so the flag could not reach the field the
  # release lane uses, while the value it did write rendered on the task page.
  # Retired rather than re-pointed: release membership is a fact the sweep
  # establishes when a PR lands on the release branch, not an intention anyone
  # types. Nothing sets it by hand, so no flag is the correct surface.
  # Read it with `bin/task field <slug> release_slug` or `show --verbose`; the
  # server refuses a devops write (Task::DEVOPS_COLUMN_KEYS).
  "--agent-context" => "agent_context", "--post-deploy-cmd" => "post_deploy_cmd",
  # The gem bump OVERRIDE. Never required: bin/release computes the version from the
  # candidate's members (Release::GemVersion). Set it only when the derived bump is
  # wrong — most often a `chore` that is actually breaking.
  "--gem-bump" => "gem_bump",
  "--approval" => "approval_status", "--approval-status" => "approval_status",
  # "act as <soul>": the status-line mascot becomes that agent (name + glyph + tint)
  # in place of the session's Pokémon. The server stamps the identity (Task#sync_
  # persona_identity); a new task without --persona reverts to the Pokémon. Distinct
  # from --agent, which sets the task OWNER (agent_slug).
  "--persona" => "persona"
}.freeze
LIST_FLAGS = { "--repo" => "repositories", "--risk" => "risk_tags", "--accept" => "acceptance", "--test" => "test_plan", "--checks" => "checks_run" }.freeze
NOTE_FLAGS = {
  "--handoff" => "handoff",
  "--qa-feedback" => "qa_feedback",
  "--clarification" => "clarification",
  "--comment" => "comment"
}.freeze
# The size trio, set as TOP-LEVEL Task columns (not devops). Avi seeds po_size at
# creation (the default sizer — not a hard gate), the builder Pokémon stamps
# dev_size when it claims the task at `building`, pm_size is an optional extra
# estimate; actual_size is auto-derived from measured usage at ship. Every value
# is validated against SIZES before the request goes out.
SIZES = %w[small medium large xl].freeze
SIZE_FLAGS = { "--pm-size" => "pm_size", "--po-size" => "po_size", "--dev-size" => "dev_size" }.freeze
# Top-level Task columns parse_flags accepts alongside the devops flags.
TOP_FLAGS = %w[--slug --title --description --agent --priority --stage].freeze
# VALUELESS top-level boolean columns. `requires_migration` is the
# `backend_migration` exclusive-lane flag (docs/agents/system/exclusive-lanes.md):
# the SOP tells a backend Dev to SELF-FLAG the moment they discover they need a
# migration, and until this flag existed there was no way to do it — the column
# was writable only through the admin-gated /sizing editor, so the instruction
# named a behaviour no agent could perform. Both polarities are explicit because
# un-flagging matters too (a task that turns out NOT to need a migration should
# hand the lane back and say so).
BOOL_FLAGS = {
  "--requires-migration"    => ["requires_migration", true],
  "--no-requires-migration" => ["requires_migration", false]
}.freeze
# Everything parse_flags (list/create/update) understands — the dictionary an
# unknown flag is rejected against (and suggestion-matched, --pr → --pr-url).
PARSE_FLAG_NAMES = (SCALAR_FLAGS.keys + LIST_FLAGS.keys + SIZE_FLAGS.keys + TOP_FLAGS + BOOL_FLAGS.keys).freeze
HELP_FLAGS = %w[--help -h].freeze
# Two-workflow status model. Stages move via PATCH stage (no named-transition
# endpoints) so the CLI, the board drag-drop, and the API share one path.
STAGES = %w[designed building submitted reviewed assembled shipped archived].freeze
# `blocked`/`failed` are no longer stages — a block is a `building` attribute set
# via `bin/task block`, so nudge the legacy names toward it.
LEGACY_STAGE_HINTS = {
  "new" => "designed",
  "queued" => "designed",
  "in_progress" => "building",
  "pr_review" => "submitted",
  "qa_review" => "assembled",
  "prod_ready" => "assembled",
  "done" => "shipped"
}.freeze
BLOCK_KINDS = %w[environment rework dependency].freeze
PERSONA_CLEAR = %w[none clear off -].freeze
APPROVAL_STATUS_ALIASES = {
  "changes-requested" => "changes_requested",
  "change_requested" => "changes_requested",
  "clear" => "none",
  "cleared" => "none"
}.freeze
APPROVAL_STATUSES = %w[waiting approved changes_requested none].freeze

def warn!(msg)
  $stderr.puts(msg)
end

# The board POSITIVELY answered "there is no such task" — see the exit-code
# contract in the header. Mirrored by bin/agent-worktree's TASK_NOT_FOUND_EXIT
# (its fetch_task_record frees a desk on this code); keep the two in lockstep.
EXIT_TASK_NOT_FOUND = 4

# The two-bounce circuit breaker REFUSED this rework block (`bounces` reports the
# same code when the breaker is tripped). Same "refused, do not retry-storm"
# meaning `migration-lane` gives 10; distinct from 1 so a caller can tell "the
# breaker says escalate" from "the read failed".
EXIT_BREAKER_TRIPPED = 10

def die!(msg, code: 1)
  warn!("error: #{msg}")
  exit code
end

def print_usage!
  warn!(File.read(__FILE__)[/# Usage:.*?(?=\nrequire)/m].to_s.gsub(/^# ?/, ""))
end

# --help/-h print usage and exit 0 from ANY position — never parsed as a slug
# (`update --help` once issued GET /api/v1/tasks/--help → 404, actively
# misleading the one agent already confused about the flags).
def help!
  print_usage!
  exit 0
end

# Nearest-valid-flag suggestions for an unknown flag: exact-prefix candidates
# first ("--pr" → --pr-url / --priority / --prod-url — the shorthand typo), then
# DidYouMean spelling candidates ("--pr-ulr" → --pr-url). [] when nothing is close.
def flag_suggestions(unknown, valid)
  prefix = valid.select { |flag| flag.start_with?(unknown) }.sort
  return prefix unless prefix.empty?

  require "did_you_mean"
  DidYouMean::SpellChecker.new(dictionary: valid).correct(unknown)
rescue LoadError, NameError
  [] # suggestions are a courtesy; the rejection stands without them
end

# Reject an unrecognized flag LOUDLY — exit nonzero, name the flag, suggest the
# nearest valid one. The old parse loop dropped an unknown flag (and its value)
# into ignored positionals and exited 0: `update <slug> --pr <url>` printed the
# task as if the PR were recorded while the board still said `pr: -`, and the
# next gate (bin/dor-check NO_PR) failed naming nothing about the real cause.
# A CLI must never report an operation that did not happen.
def unknown_flag!(flag, valid: [], context: nil)
  help! if HELP_FLAGS.include?(flag)
  suggestions = flag_suggestions(flag, valid)
  hint =
    if suggestions.any?
      " — did you mean #{suggestions.join(", ")}?"
    elsif valid.any?
      " (valid flags: #{valid.join(", ")})"
    else
      ""
    end
  die!("unknown flag #{flag.inspect}#{context ? " for #{context}" : ""}#{hint}")
end

# A dashed token is never a slug (or any other positional): --help/-h print
# usage, anything else dies naming the misplaced flag instead of riding into a
# 404ing GET /api/v1/tasks/<flag>.
def positional!(arg, usage)
  help! if HELP_FLAGS.include?(arg)
  die!("expected a positional argument, got flag #{arg.inspect} (#{usage})") if arg.to_s.start_with?("-")
  arg
end

def validate_stage!(stage)
  return if STAGES.include?(stage)

  hint = LEGACY_STAGE_HINTS[stage]
  suffix = hint ? " (legacy stage; use #{hint.inspect})" : ""
  die!("unknown stage #{stage.inspect}#{suffix}; one of: #{STAGES.join(", ")}")
end

# Reject a size value the model would refuse, with a clear message — so a typo'd
# --po-size never reaches the API as a 422. Shared by create/update (parse_flags)
# and the building claim's --dev-size.
def validate_size!(flag, value)
  return if SIZES.include?(value)

  die!("#{flag} must be one of: #{SIZES.join(", ")} (got #{value.inspect})")
end

# The gem bump override (patch|minor|major). Never required — bin/release derives the
# bump from the candidate's members; this only overrides it.
def validate_gem_bump!(flag, value)
  return if %w[patch minor major].include?(value.to_s.strip.downcase)

  die!("#{flag} must be one of: patch, minor, major (got #{value.inspect}) — " \
       "leave it unset to let the release derive the bump from the task's kind")
end

def normalize_approval_status!(flag, value)
  normalized = APPROVAL_STATUS_ALIASES.fetch(value.to_s.strip.downcase, value.to_s.strip.downcase)
  return normalized if APPROVAL_STATUSES.include?(normalized)

  die!("#{flag} must be one of: #{APPROVAL_STATUSES.join(", ")} (got #{value.inspect})")
end

def agent_secret
  dotenv = File.join(__dir__, "..", ".env")
  TaskBoard.agent_secret(dotenv) ||
    die!("AGENT_API_SECRET not found (checked ENV, 1Password, #{dotenv})")
end

def token
  @token ||= api(:post, "/api/v1/auth", { secret: agent_secret }, auth: false).fetch("token")
end

# NOTE: opts is a trailing positional hash, NOT a keyword arg. Under system Ruby
# (2.6) a brace-hash passed as the last positional to a method with keyword
# params is silently coerced to kwargs — which is what made `move` blow up with
# "unknown keyword: stage". Keeping auth in a positional opts hash is robust
# across every Ruby the agents might run this under.
def api(method, path, body = nil, opts = {})
  auth = opts.fetch(:auth, true)
  res = TaskBoard.request(method, path, base_url: BASE_URL, token: (auth ? token : nil), body: body)
  parsed = TaskBoard.parse_body(res)
  unless res.code.to_i.between?(200, 299)
    die!("#{method.upcase} #{path} -> #{res.code}: #{parsed["error"] || res.body}",
         code: task_not_found_response?(res, parsed) ? EXIT_TASK_NOT_FOUND : 1)
  end
  parsed
end

# Classify the board's answer HERE, where the response is still structured (status
# + parsed JSON body), instead of leaving callers to pattern-match the die! stderr
# rendering. The 404 status alone is NOT enough: a Heroku router 404 (board app
# renamed/deleted) or a route-level 404 (moved path, stale board) is a FAILED
# read, not an answer — only the tasks API's own body counts
# (app/controllers/api/v1/tasks_controller.rb#set_task renders exactly
# "task not found", pinned by its controller test). A false positive here frees a
# live builder's worktree for teardown during an outage, so match the exact
# message, not the family (the generic "Not found" backstop stays exit 1).
def task_not_found_response?(res, parsed)
  res.code.to_i == 404 && parsed.is_a?(Hash) && parsed["error"].to_s.strip.casecmp?("task not found")
end

# Parse repeatable + scalar flags out of argv. Returns [positionals, scalars,
# lists, top]. An unrecognized flag is REJECTED (unknown_flag!), never skipped.
def parse_flags(argv, context: nil)
  positionals = []
  scalars = {}
  lists = Hash.new { |h, k| h[k] = [] }
  top = {}
  i = 0
  while i < argv.length
    arg = argv[i]
    if SCALAR_FLAGS.key?(arg)
      key = SCALAR_FLAGS[arg]
      value = argv[i + 1] || die!("#{arg} needs a value")
      value = normalize_approval_status!(arg, value) if key == "approval_status"
      # A typo here would silently degrade to the DERIVED bump and publish the wrong
      # number — irreversibly. Reject it where a human can still fix it.
      validate_gem_bump!(arg, value) if key == "gem_bump"
      scalars[key] = value; i += 2
    elsif LIST_FLAGS.key?(arg)
      lists[LIST_FLAGS[arg]] << (argv[i + 1] || die!("#{arg} needs a value")); i += 2
    elsif SIZE_FLAGS.key?(arg)
      value = argv[i + 1] || die!("#{arg} needs a value")
      validate_size!(arg, value)
      top[SIZE_FLAGS[arg]] = value; i += 2
    elsif TOP_FLAGS.include?(arg)
      top[arg.delete_prefix("--")] = argv[i + 1] || die!("#{arg} needs a value"); i += 2
    elsif BOOL_FLAGS.key?(arg)
      # Valueless — consumes ONE token. Storing the boolean (including `false`)
      # means top_body must ask `key?`, never truthiness, or --no-requires-migration
      # would silently vanish.
      column, value = BOOL_FLAGS[arg]
      top[column] = value; i += 1
    else
      # A dashed token here is an unrecognized flag. The old whitelist-and-skip
      # loop dropped it (and its value) into these ignored positionals and
      # exited 0 — data silently lost. Reject it loudly instead.
      unknown_flag!(arg, valid: PARSE_FLAG_NAMES, context: context) if arg.start_with?("-")
      positionals << arg; i += 1
    end
  end
  [positionals, scalars, lists, top]
end

def build_devops(base, scalars, lists)
  base = (base || {})
  devops = base.dup
  scalars.each { |k, v| devops[k] = v }
  lists.each { |k, v| devops[k] = v unless v.empty? }
  # checks_run is TWO namespaces in one list. The author owns the tier tags
  # ("[unit] ...") and --checks REPLACES those, as documented. The cert writers
  # (bin/fast-check, bin/full-suite-check) own the fingerprint-bound evidence
  # ("[full-suite@<fp>] ..."), and --checks must NOT be able to replace THAT: an
  # agent recording its test plan after certifying used to wipe its own cert, and
  # bin/dor-check then called freshly certified code "full-suite: MISSING" (a
  # false negative in the G1 gate whose only visible remedy was another suite
  # run). Carry every evidence lane the caller did not itself supply. The board
  # enforces the same rule (Task#preserve_cert_evidence) for every other writer;
  # doing it here too means an agent is protected the moment it pulls this branch,
  # and the PATCH body says what the caller actually meant. See lib/cert_evidence.rb.
  if devops.key?("checks_run")
    devops["checks_run"] = CertEvidence.preserve(prior: base["checks_run"], incoming: devops["checks_run"])
  end
  devops
end

def top_body(top)
  body = {}
  body["slug"] = top["slug"] if top["slug"] # custom readable handle (create only)
  body["title"] = top["title"] if top["title"]
  body["description"] = top["description"] if top["description"]
  body["agent_slug"] = top["agent"] if top["agent"]
  body["priority"] = top["priority"].to_i if top["priority"]
  body["stage"] = top["stage"] if top["stage"]
  # The size trio (top-level Task columns) — already validated in parse_flags.
  SIZE_FLAGS.each_value { |col| body[col] = top[col] if top[col] }
  # Boolean columns: presence-tested, NOT truth-tested — `false` is a value the
  # caller asked for (--no-requires-migration), not an absent flag.
  BOOL_FLAGS.each_value { |(col, _)| body[col] = top[col] if top.key?(col) }
  body
end

def print_task(task)
  dv = task.dig("metadata", "devops") || {}
  puts "#{task["slug"]}  [#{task["stage"]}]  #{task["title"]}"
  puts "  agent: #{task["agent_slug"] || "-"}  kind: #{dv["kind"] || "-"}  repos: #{Array(dv["repositories"]).join(", ")}"
  puts "  branch: #{dv["branch"] || "-"}  pr: #{dv["pr_url"] || "-"}"
  puts "  acceptance: #{Array(dv["acceptance"]).size} item(s)  risk: #{Array(dv["risk_tags"]).join(", ")}"
end

# Print a labeled bullet list (the actual acceptance/test_plan/checks lines), or
# "label: -" when empty — so a human read of a task never needs the curl + token
# dance just to see the acceptance bullets the terse view only counts.
def print_bullets(label, items)
  items = Array(items)
  if items.empty?
    puts "  #{label}: -"
  else
    puts "  #{label}:"
    items.each { |item| puts "    - #{item}" }
  end
end

# The git-location columns, printed UNCONDITIONALLY and never as a bare "-".
#
# `merged` is the field whose absence makes the release sweep skip a `reviewed`
# task as a HELD anomaly, so it is read back constantly — and it used to be the
# one field --verbose did not print, while printing every devops neighbour around
# it. Agents therefore looked in `metadata.devops.merged`, found `null` (nothing
# writes there, on any task), and concluded the stamp had dropped. Three of them
# did, inside 24 hours. `release_slug` rides along because it WAS the same trap
# one step worse: the one name that existed in both universes at once — a
# top-level column (what the release sweep and bin/conductor read) and a
# same-named devops key (written by this CLI's own --release-slug flag and by the
# board edit form, displayed on the task page, read by no release code). That
# shadow is now retired at the server (Task::DEVOPS_COLUMN_KEYS refuses the write
# and sheds any stored value), the flag is gone, and the task page renders the
# column — so printing the COLUMN here agrees with every other surface rather
# than merely making the two tellable apart.
#
# Two properties make that inference impossible now, and both are load-bearing:
#   1. The line is ALWAYS emitted, so a missing value can never be mistaken for a
#      missing feature. Do not make either field conditional.
#   2. TaskColumnFields renders three states, so "empty" ("not merged") and
#      "this board did not return the field" (UNREPORTED) read differently.
# The trailing locator line names WHERE the fields live, which is the lookup
# error that actually cost the time — printed even when the values are set,
# because the worst case was a reader mis-pathing a stamp that WAS there.
def print_column_fields(task)
  puts "  #{TaskColumnFields.pair(task, "merged")}   #{TaskColumnFields.pair(task, "release_slug")}"
  puts "  ↳ #{TaskColumnFields::LOCATOR}"
end

# The human-readable expansion behind `show --verbose`: the terse header plus the
# fields an agent otherwise had to hand-curl — acceptance BULLETS (not just a
# count), agent_context, test_plan, checks_run, the build-claim state, the
# PR / local URLs, and the top-level git-location columns (`merged` +
# `release_slug`, see print_column_fields).
def print_task_verbose(task)
  print_task(task)
  dv = task.dig("metadata", "devops") || {}
  puts
  print_bullets("acceptance", dv["acceptance"])
  puts "  agent_context: #{dv["agent_context"] || "-"}"
  print_bullets("test_plan", dv["test_plan"])
  print_bullets("checks_run", dv["checks_run"])
  puts "  claim: session #{dv["claimed_session"] || "-"} · expires #{dv["claim_expires_at"] || "-"}"
  puts "  approval_status: #{dv["approval_status"] || "-"}"
  puts "  pr_url: #{dv["pr_url"] || "-"}   local_url: #{dv["local_url"] || "-"}"
  print_column_fields(task)
  puts "  review_in_progress: #{task["review_in_progress"] ? "yes" : "no"}" if task.key?("review_in_progress")
  if task.key?("unresolved_feedback")
    feedback = task["unresolved_feedback"]
    summary = feedback && feedback["description"].to_s.strip
    puts "  unresolved_feedback: #{summary && !summary.empty? ? summary : "-"}"
  end
end

# --- Stale check: is a task's work already on origin/main? ------------------
# The directory the stale check runs git in. Defaults to the CLI's own checkout
# (any clone/worktree that shares origin's tracking refs); TASK_GIT_DIR overrides
# it so tests can point git at a throwaway repo with no network.
def git_dir
  dir = ENV["TASK_GIT_DIR"].to_s.strip
  dir.empty? ? File.expand_path("..", __dir__) : dir
end

# Run a git command in git_dir, swallowing stderr. Returns [stdout, success?].
def git(*args)
  out = IO.popen(["git", "-C", git_dir, *args], err: File::NULL, &:read).to_s.strip
  [out, $?.success?]
end

# Resolve a task's STALE disposition — its branch already merged to origin/main
# (work shipped out-of-band) while the task itself hasn't reached shipped/archived.
# The git I/O lives here; the decision is delegated to the pure StaleCheck module.
# Pure of network on its own: the CALLER git-fetches first (once, even for a board
# scan). Returns a result hash {slug:, branch:, stage:, status:} where status is
# one of :terminal :no_branch :on_main :not_merged. A git error leaves on_main
# false, so it NEVER falsely claims "already on main".
def stale_check(task)
  branch = StaleCheck.branch_for(task)
  result = { slug: task["slug"], branch: branch, stage: task["stage"] }
  return result.merge(status: :terminal) if StaleCheck::TERMINAL_STAGES.include?(task["stage"])

  remote_branch = "refs/remotes/origin/#{branch}"
  _ref, exists = git("rev-parse", "--verify", "--quiet", remote_branch)
  on_main = exists && git("merge-base", "--is-ancestor", remote_branch, "refs/remotes/origin/main")[1]
  result.merge(status: StaleCheck.status(task, branch_exists: exists, on_main: on_main))
end

def render_stale(result)
  slug = result[:slug]
  branch = result[:branch]
  case result[:status]
  when :on_main
    puts "⚠  #{slug}: work already on main — origin/#{branch} is an ancestor of origin/main"
    puts "   stage is #{result[:stage]} → consider: bin/task move #{slug} shipped   (or archived)"
  when :not_merged
    puts "#{slug}: origin/#{branch} not yet on main (active — not stale)"
  when :no_branch
    puts "#{slug}: no origin/#{branch} branch to compare — skipped"
  when :terminal
    puts "#{slug}: already #{result[:stage]} — not stale by definition"
  end
end

def refresh_codex_session_title
  return if ENV["CODEX_SESSION_TITLE_RUNNING"] == "1"
  return if ENV["CODEX_THREAD_ID"].to_s.strip.empty?

  script = File.expand_path("codex-session-title", __dir__)
  return unless File.executable?(script)

  system({ "CODEX_SESSION_TITLE_RUNNING" => "1" }, script, out: File::NULL, err: File::NULL)
rescue StandardError
  nil
end

# Genesis trickle-down: the task slug is the single source. Creating/advancing a
# task writes the active-feature marker that bin/statusline (and the terminal
# indicator) read — no worktree required. Worktree sessions override it via their
# own .agent-context.json. Best-effort; never breaks a task command.
def write_feature_marker(task)
  return if ENV["TASK_SKIP_MARKER"] == "1"
  return if Dir.pwd.include?("/.worktrees/")
  # The one condition under which feature_marker_path returns nil — asked HERE, of the
  # session id, rather than by binding the path and testing it for nil. Nothing in this
  # file may hold a raw store path: the containment scan subtracts the path expression
  # the guard was HANDED, so a path that reaches a local first is a path the guard is
  # trusted-not-proven to have seen. See test/lib/state_store_containment_test.rb.
  return if session_identity.first.to_s.strip.empty?

  slug = task["slug"].to_s
  return if slug.empty?

  # Committed to a write from here — so guard it before we even READ the existing
  # marker (below) out of what might be the operator's real state dir. Under
  # TASK_USAGE_SANDBOX an unpinned CLAUDE_PROJECTS_DIR aborts instead of falling
  # back to <projects>/.agents/sessions. See lib/task_usage_sandbox.rb.
  path = TaskUsageSandbox.enforce!(feature_marker_path, store: "session-marker")

  dv = task.dig("metadata", "devops") || {}
  mascot, mascot_color, mascot_emoji, mascot_shiny = marker_mascot_attrs(task, path)
  marker = {
    "slug" => slug,
    "task_slug" => slug,
    "app" => Array(dv["repositories"]).first,
    "feature" => dv["worktree_slug"],
    "worktree_slug" => dv["worktree_slug"],
    "task_url" => "#{BASE_URL}/tasks/#{slug}",
    "stage" => task["stage"],
    "mascot" => mascot,             # bin/statusline renders <type-emoji> <mascot> — the session's Pokémon handle
    "mascot_color" => mascot_color, # …tinted with the mascot's least-common type color, riding with the name
    "mascot_emoji" => marker_display_emoji("mascot_emoji" => mascot_emoji, "mascot_shiny" => mascot_shiny), # …and carries its type emoji(s), with ✨ when shiny
    "mascot_shiny" => (true if truthy_marker_value?(mascot_shiny)),
    "persona" => dv["persona"],     # present only for a deliberate "act as <soul>" override
    "app_color" => dv["app_color"]  # the app's status-line tint (App#color, stamped server-side by Task#sync_app_identity)
  }.reject { |_, v| v.nil? || v.to_s.strip.empty? }

  # Write-once genesis: the first task this session claims is why the session
  # exists. A later create/move/block repoints the ACTIVE fields above; the
  # on-disk genesis is carried forward verbatim (FeatureMarker.genesis).
  marker.merge!(FeatureMarker.genesis(existing_marker(path),
                                      "genesis_slug" => slug,
                                      "genesis_feature" => dv["worktree_slug"] || slug,
                                      "genesis_url" => "#{BASE_URL}/tasks/#{slug}",
                                      "genesis_at" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")))

  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, "#{JSON.pretty_generate(marker)}\n")
  refresh_codex_session_title
rescue StandardError
  nil
end

# The marker's mascot AND its display attributes (color + type emoji), resolved
# TOGETHER so the color/emoji always ride with the name. Returns [mascot, color,
# emoji, shiny].
#
# The session's mascot is STICKY — once the per-session marker carries one, a later
# `create`/`move` updates the app/feature/stage context (write_feature_marker) but
# does NOT swap in the MOVED task's mascot. Why: a task's devops carries `mascot`
# (a DEVOPS_KEY) but the board does NOT serve mascot_color/mascot_emoji with it
# (they're server-owned, NOT DEVOPS_KEYS — see Task::DEVOPS_SCALAR_KEYS), so
# adopting a task's mascot dropped bin/statusline to its color/emoji-less pink
# 🛠 ⊙ fallback every time you reviewed someone else's task. The reliable source
# of a mascot WITH its color+emoji is the session marker that `bin/task
# session-mascot` writes from the /sessions/:id/mascot endpoint (which DOES return
# them). So: pin that. Order:
#   1. a PERSONA ("act as <soul>") on this task — a deliberate identity change the
#      server stamped with the soul's name+color+emoji; let it override.
#   2. the last-good on-disk marker — the sticky session mascot (its color/emoji).
#   3. this task response — only when disk has none yet (a fresh session that
#      skipped the session-mascot hook); SessionMascot makes it the session handle
#      anyway, and any missing color/emoji renders clean (never the pink glyphs).
#   4. a best-effort board read (name only).
def marker_mascot_attrs(task, path)
  dv = task.dig("metadata", "devops") || {}
  if FeatureMarker.present?(dv["persona"]) && FeatureMarker.present?(dv["mascot"])
    return [dv["mascot"], dv["mascot_color"], dv["mascot_emoji"], nil]
  end

  disk = existing_marker(path)
  if disk && FeatureMarker.present?(disk["persona"]) &&
     !FeatureMarker.present?(dv["persona"]) && FeatureMarker.present?(dv["mascot"])
    return [dv["mascot"], dv["mascot_color"], dv["mascot_emoji"], dv["mascot_shiny"]]
  end
  return [disk["mascot"], disk["mascot_color"], disk["mascot_emoji"], disk["mascot_shiny"]] if disk && FeatureMarker.present?(disk["mascot"])

  return [dv["mascot"], dv["mascot_color"], dv["mascot_emoji"], dv["mascot_shiny"]] if FeatureMarker.present?(dv["mascot"])

  [board_mascot(task["slug"]), nil, nil, nil] # a board read carries the name only
end

def existing_marker(path)
  return nil unless path && File.exist?(path)

  JSON.parse(File.read(path))
rescue StandardError
  nil
end

def session_marker_persona
  marker = existing_marker(feature_marker_path)
  persona = marker && marker["persona"].to_s.strip
  persona unless persona.to_s.empty?
end

def default_block_actor(task, kind)
  return "avi" if kind.to_s == "rework" && task.is_a?(Hash) && task["stage"].to_s == "submitted"

  nil
end

# ---------------------------------------------------------------------------
# Two-bounce circuit breaker — the READ (bin/lib/bounce_ledger.rb owns the rules).
#
# This used to be prose in three SOPs telling each agent to GET the activities
# endpoint and count the rows, and the hand-rolled form answered ZERO for every
# task on the planet because Net::HTTPResponse#[] reads HTTP headers. Nobody
# hand-rolls it now: the read lives here, and every failure raises instead of
# counting.
# ---------------------------------------------------------------------------

# Pages the task's qa_feedback activities and returns a BounceLedger::Verdict.
# Raises BounceLedger::UnreadableResponse on ANY answer it cannot trust. It does
# NOT go through `api` on purpose: `api` uses TaskBoard.parse_body, whose lenient
# `rescue {}` turns a non-JSON body into an empty hash — the exact "quietly answer
# zero" shape this command exists to refuse.
BOUNCE_PAGE_SIZE = 100
BOUNCE_MAX_PAGES = 10

def bounce_verdict(slug, verify_task: true)
  # A TASK THAT DOES NOT EXIST MUST NOT READ AS CLEAR. The activities endpoint
  # filters by task_slug and answers a 200 with an EMPTY data array for a slug
  # nobody has ever heard of — so a typo, a renamed slug, or a stale handle scores
  # zero bounces and green-lights the block. That is the same defect this whole
  # command exists to kill, one layer out, and it is not hypothetical: the first
  # smoke test of this command hit it. `api` die!s with EXIT_TASK_NOT_FOUND when
  # the board POSITIVELY answers "no such task", so an unknown slug is refused
  # rather than cleared. (`verify_task: false` exists for a caller that has already
  # fetched the task and would only be paying for the round trip twice.)
  api(:get, "/api/v1/tasks/#{slug}") if verify_task

  rows = []
  page = 1
  loop do
    query = URI.encode_www_form(task_slug: slug, activity_type: "qa_feedback",
                                per_page: BOUNCE_PAGE_SIZE, page: page)
    res = TaskBoard.request(:get, "/api/v1/activities?#{query}", base_url: BASE_URL, token: token)
    payload = BounceLedger.payload_from(res)
    page_rows = BounceLedger.from_payload(payload).rows
    rows.concat(page_rows)

    # Stop on the LAST page, not on "the server reported more than this page holds"
    # — meta.total counts the whole filtered set, so comparing it to one page's
    # size stays true forever and would walk empty pages to the cap.
    break if page_rows.size < BOUNCE_PAGE_SIZE
    break unless BounceLedger.truncated?(payload.merge("data" => rows))
    break if (page += 1) > BOUNCE_MAX_PAGES
  end
  BounceLedger::Verdict.new(rows: rows)
end

def escalation_recipe(slug)
  "bin/task block #{slug} --kind dependency \\\n" \
  "    --summary \"Escalated: <4-6 word disagreement>\" \\\n" \
  "    --feedback \"<builder's position vs review's position, in brief>\""
end

def print_bounce_verdict(slug, verdict)
  if verdict.tripped?
    puts "BREAKER: TRIPPED — #{verdict.count} prior send-back(s) on #{slug}"
  else
    puts "BREAKER: CLEAR — no prior send-back on #{slug} " \
         "(#{verdict.rows.size} qa_feedback row(s) read, none countable)"
  end
  verdict.rows.each_with_index do |row, i|
    mark = row.countable? ? "counts" : "not a bounce"
    puts "  #{i + 1}. #{row.created_at} [#{row.kind}] #{row.summary} (#{mark})"
  end
  puts "  by kind: #{verdict.by_kind.map { |k, n| "#{k} #{n}" }.join(", ")}" unless verdict.rows.empty?
  return unless verdict.tripped?

  puts ""
  puts "  A repeat bounce is a review DEADLOCK, and a deadlock is the operator's call."
  puts "  Do NOT re-block to the builder. Escalate instead:"
  puts "    #{escalation_recipe(slug)}"
end

def resolved_block_actor(explicit_agent, task, kind: nil)
  explicit = explicit_agent.to_s.strip
  return explicit unless explicit.empty?

  devops = task.is_a?(Hash) ? task.dig("metadata", "devops") : {}
  [session_marker_persona, devops&.fetch("persona", nil), default_block_actor(task, kind)].each do |candidate|
    actor = candidate.to_s.strip
    return actor unless actor.empty?
  end

  ""
end

# The board's devops.mascot, read in a SUBPROCESS via `bin/task field` — never
# in-process. The board read is the last, lowest-priority fallback source, so it
# must NEVER be able to abort the command that's only writing a marker: an
# in-process api() call would, on a transient non-2xx board read, hit api's die!
# → exit 1 → SystemExit, which is NOT a StandardError and so escapes both this
# rescue and write_feature_marker's — killing the move/create AFTER its server
# op already succeeded. Shelling out contains any `exit` in the child (the
# backtick yields "" on a child failure), the same isolation
# bin/agent-worktree.resolve_mascot relies on. `field` is silent + exit 0 when
# the mascot is unset, so a clean "no mascot" reads back as "".
def board_mascot(slug)
  slug = slug.to_s
  return nil if slug.empty?

  mascot = `#{__dir__}/task field #{slug.shellescape} mascot 2>/dev/null`.to_s.strip
  mascot.empty? ? nil : mascot
rescue StandardError
  nil
end

# --- Auto-captured move usage (best-effort) --------------------------------
# Per-(session, slug) baselines of cumulative token usage live under .agents
# (not committed); TASK_USAGE_DIR overrides the dir (tests point it at a tmp
# path). The storage + delta math is shared with bin/release + bin/reviewer-select
# via lib/task_usage_baseline.rb so every move/intent path computes deltas the
# same way.
#
# The fallback below is a LIVE-STORE write, so it is sandbox-guarded: under
# TASK_USAGE_SANDBOX (every test process) an unset TASK_USAGE_DIR ABORTS rather
# than falling back here. That fallback, unpinned by test/lib/task_cli_test.rb,
# is exactly how a test child once wrote a 1.9-billion-token fixture row into the
# operator's real cost store. See lib/task_usage_sandbox.rb.
def usage_dir
  pinned = ENV["TASK_USAGE_DIR"].to_s.strip
  # The raw fallback is an ARGUMENT to the guard, never a local the guard is told about
  # afterwards. The containment scan subtracts what enforce! was handed and re-asks the
  # path question of what is left, so a path that lands in a local first is a path the
  # scan cannot prove was laundered — and it says so.
  TaskUsageSandbox.enforce!(
    pinned.empty? ? File.join(PROJECTS_DIR, ".agents", "task-usage") : pinned,
    store: "task-usage"
  )
end

# The baseline store for THIS session, or nil when there's no session (a plain
# shell / CI run has no transcript to diff anyway).
def usage_baseline_for(session, provider: "claude")
  session = session.to_s.strip
  return nil if session.empty?

  TaskUsageBaseline.new(session: session, provider: provider, dir: usage_dir)
end

# Seed the per-(session, slug) baseline from the session's current cumulative
# totals when the session first TOUCHES the task — at CREATE (so the design phase
# is measured), at the build CLAIM (move→building), and at a review/deploy INTENT.
# Idempotent (never resets an in-progress baseline) and best-effort. Seeding here
# is what makes the first real WORK transition record a true delta instead of the
# zeroed first-move baseline (the cause of the model-only Submitted→Reviewed chip,
# and its design-phase twin, the model-only Designed→Building chip).
def seed_usage_baseline(slug)
  session, provider = session_identity
  usage_baseline_for(session, provider: provider)&.seed(slug)
rescue StandardError
  nil
end

# Fill the event's model/tokens/cost from the session transcript (the delta since
# the last touch — claim, intent, or prior move), then advance the baseline. No
# session, no transcript, or no baseline yet → record at most the model; the
# deterministic spine is recorded server-side regardless.
def autofill_move_usage(event, slug)
  session, provider = session_identity
  baseline = usage_baseline_for(session, provider: provider)
  return unless baseline

  capture = baseline.capture_delta(slug)
  return unless capture

  event["model"] = capture.model if capture.model
  return unless capture.usage?

  event["tokens_in"]  = capture.tokens_in
  event["tokens_out"] = capture.tokens_out
  # The un-folded cache buckets ride alongside the folded tokens_in so the SERVER can
  # re-derive this event's cost at an operator's overridden rate — this process has no
  # ActiveRecord and prices at LIST rate only, so `cost` below is just the fallback.
  event["cache_creation_tokens"] = capture.cache_creation_tokens
  event["cache_read_tokens"]     = capture.cache_read_tokens
  event["cost"]       = format("%.4f", capture.cost) if capture.cost
rescue StandardError
  # A capture failure must degrade to spine-only, never abort the move (and its
  # stage-transition PATCH). The lib swallows IO errors; this is belt-and-braces.
  nil
end

# --- Persistence verification: never report success on a write that didn't land
# A best-effort AUTHORITATIVE read of a task's current stage, used to VERIFY a
# just-issued stage move actually persisted. Deliberately NOT api(): a non-2xx or
# transport failure here returns nil (we could not verify) instead of die!-ing. A
# failed VERIFICATION read is not proof the write failed, and the standing
# invariant that a transient board read never aborts a move whose PATCH already
# landed (see board_mascot) holds. Returns the persisted stage String, or nil
# when the board could not be read back.
def read_back_stage(slug)
  res = TaskBoard.request(:get, "/api/v1/tasks/#{slug}", base_url: BASE_URL, token: token)
  return nil unless res.code.to_i.between?(200, 299)

  data = TaskBoard.parse_body(res)["data"]
  data.is_a?(Hash) ? data["stage"].to_s : nil
rescue StandardError
  nil
end

# CONFIRM a stage move actually landed before reporting success. The board can
# answer a stage PATCH with 200 while the transition never persisted — a
# server-side save that fails silently returns the assigned-but-UNSAVED in-memory
# record, so the response echoes the requested stage and bin/task prints
# "[submitted]" and exits 0 while a fresh read still shows "building". A task
# stranded that way is invisible to reviewers and skipped by the qa-release
# sweep, and its handoff LIES (it once made a supervisor misread the failed write
# as a rival session re-claiming the task). So after the PATCH, read the task
# back and compare: on a DEFINITE mismatch, exit NONZERO and say so loudly (never
# the success line). A read we could not complete (nil) degrades to the prior
# behavior rather than abort — an unverifiable read is not proof of a failed write.
def verify_move_persisted!(slug, expected_stage)
  persisted = read_back_stage(slug)
  return if persisted.nil? || persisted == expected_stage

  warn!("✗ move NOT persisted: #{slug} → #{expected_stage} reported success, but a fresh read of the board still shows [#{persisted}].")
  warn!("  The stage-transition write did not land — the task has NOT moved. Do not hand it off as #{expected_stage}.")
  warn!("  Re-run: bin/task move #{slug} #{expected_stage}   (if it recurs the board write is failing server-side — check ErrorLog).")
  exit 1
end

# The `merged` twin of read_back_stage — the git-location crash-recovery signal
# (nil/accepted/release/main). Same degrade-on-unverifiable contract: a non-2xx
# or transport error returns nil (could not verify), never an abort. Empty string
# means the board read the task back with no merged stamp.
def read_back_merged(slug)
  res = TaskBoard.request(:get, "/api/v1/tasks/#{slug}", base_url: BASE_URL, token: token)
  return nil unless res.code.to_i.between?(200, 299)

  data = TaskBoard.parse_body(res)["data"]
  data.is_a?(Hash) ? data["merged"].to_s : nil
rescue StandardError
  nil
end

# CONFIRM a `merged` stamp actually landed before reporting success — the twin of
# verify_move_persisted!. A dropped git-location write is not cosmetic: the sweep
# classifies a `reviewed` member with merged:"" as a HELD anomaly and leaves it
# behind, so a silently-non-persisting stamp would strand the task off every RC.
# On a DEFINITE mismatch exit nonzero + loud; an unverifiable read (nil) degrades
# to the prior behavior (not proof of a failed write).
def verify_merged_persisted!(slug, expected)
  # A 200 is not persistence: confirm the stamp by reading it back. Only an EXACT match
  # passes — a blank value (the write dropped) AND an unreadable board (the read-back GET
  # failed) both stay unconfirmed. The old code returned on a nil read-back, treating an
  # unreadable board as verified; under load the PATCH drops and the GET fails together, so
  # that silent pass is exactly how a dropped stamp reached a `reviewed` member as merged:None
  # (2026-07-21). Retries survive a transient read miss without accepting a genuine drop.
  return if StampConfirmation.confirmed?(expected,
                                         read_back: -> { read_back_merged(slug) },
                                         sleeper: ->(seconds) { sleep(seconds) })

  last = read_back_merged(slug)
  shown = last.nil? ? "unreadable" : (last.empty? ? "nil" : last)
  warn!("✗ merged NOT persisted: #{slug} → merged:#{expected} reported success, but the read-back shows merged:[#{shown}].")
  warn!("  A failed read is NOT a confirmation — the git-location write did not land (or the board is unreadable); the sweep treats an unstamped `reviewed` member as an anomaly and leaves it behind.")
  warn!("  Re-run: bin/task merged #{slug} #{expected}   (if it recurs the board write is failing server-side — check ErrorLog / PG connections).")
  exit 1
end

# --- Fast lane: `begin` ------------------------------------------------------
# The task record for `begin`'s resume decision: the data on 2xx, nil on the
# board's POSITIVE "task not found" (create it), die on everything else — a
# failed read must never be read as "no such task" (that is the same contract
# task_not_found_response? guards for the worktree reclaim path).
def fetch_task_for_begin(slug)
  res = TaskBoard.request(:get, "/api/v1/tasks/#{slug}", base_url: BASE_URL, token: token)
  parsed = TaskBoard.parse_body(res)
  return parsed["data"] if res.code.to_i.between?(200, 299)
  return nil if task_not_found_response?(res, parsed)

  die!("GET /api/v1/tasks/#{slug} -> #{res.code}: #{parsed["error"] || res.body}")
end

# One begin step that shells a tool: narrate, run, die with a RESUME hint on
# failure — rerunning `bin/task begin <slug>` continues from the failed step.
def begin_step!(label, slug, *cmd, chdir: nil)
  warn!("begin #{label} — #{cmd.join(" ")}#{chdir ? " (from #{chdir})" : ""}")
  opts = chdir ? { chdir: chdir } : {}
  return if system(*cmd, **opts)

  die!("#{label} failed — fix what it printed above, then re-run: bin/task begin #{slug}   (it resumes).")
end

cmd = ARGV.shift || "help"
case cmd
when "list"
  # --reviewable is a boolean filter (submitted PRs with NO live review claim — the
  # parallel-review queue). Strip it before parse_flags (which rejects any flag not
  # in PARSE_FLAG_NAMES) and pass it through as a query param: the same read as
  # GET /api/v1/tasks?reviewable=1, powered by the Task.reviewable scope.
  reviewable = !ARGV.delete("--reviewable").nil?
  _pos, _sc, _ls, top = parse_flags(ARGV, context: "list")
  q = []
  q << "stage=#{top["stage"]}" if top["stage"]
  q << "agent_slug=#{top["agent"]}" if top["agent"]
  q << "reviewable=1" if reviewable
  path = "/api/v1/tasks#{q.empty? ? "" : "?#{q.join("&")}"}"
  tasks = api(:get, path)["data"] || []
  tasks.each { |t| puts "#{t["slug"]}  [#{t["stage"]}]  #{t["title"]}" }
  puts "(#{tasks.size} task(s))"
when "show"
  usage = "usage: bin/task show <slug> [--json | --verbose|-v]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  show_flags = %w[--json --verbose -v]
  ARGV.each { |arg| unknown_flag!(arg, valid: show_flags, context: "show") unless show_flags.include?(arg) }
  data = api(:get, "/api/v1/tasks/#{slug}")["data"]
  if ARGV.include?("--json")
    # The full fetched record, machine-readable — no curl + auth-token dance.
    puts JSON.pretty_generate(data)
  elsif ARGV.include?("--verbose") || ARGV.include?("-v")
    print_task_verbose(data)
  else
    print_task(data)
  end
when "field"
  # Machine-readable single field — e.g. `bin/task field <slug> mascot`. Prints
  # just the value (no decoration) so scripts can capture it; silent + exit 0
  # when unset, so callers can treat it as optional.
  #
  # Resolution order, and why it is not uniform:
  #
  #   • TaskColumnFields::COLUMN_NAMES (`merged`, `release_slug`) resolve from the
  #     COLUMN, full stop — never from devops. These names are column-backed, and a
  #     devops-first lookup on them is the machine-readable half of the two-universe
  #     bug: `show --verbose` would print the column while `field` printed a stale
  #     shadow for the same task, in the surface scripts capture from. One store per
  #     name, and the same store as --verbose.
  #   • Everything else keeps devops-first with a column fallback, so ordinary
  #     callers (`field <slug> mascot|branch|worktree_slug`) are untouched.
  #
  # The shadow is unwritable server-side now (Task::DEVOPS_COLUMN_KEYS), so this is
  # belt-and-braces — but it is the belt that makes the CLI honest against a row
  # written before that landed.
  usage = "usage: bin/task field <slug> <devops-key-or-column>"
  slug = positional!(ARGV.shift || die!(usage), usage)
  key  = positional!(ARGV.shift || die!(usage), usage)
  record = api(:get, "/api/v1/tasks/#{slug}")["data"] || {}
  value =
    if TaskColumnFields::COLUMN_NAMES.include?(key)
      record[key]
    else
      devops_value = record.dig("metadata", "devops", key)
      devops_value.nil? ? record[key] : devops_value
    end
  print value unless value.nil? || value.is_a?(Enumerable)
when "stale"
  # Flag work that's already on origin/main while its task lags behind (fixed
  # out-of-band). One `git fetch` then a local ancestry check. With a slug, check
  # that one task; with none, scan every open task and list the stale ones.
  slug = ARGV.shift
  slug = positional!(slug, "usage: bin/task stale [<slug>]") if slug
  git("fetch", "-q", "origin")
  if slug
    render_stale(stale_check(api(:get, "/api/v1/tasks/#{slug}")["data"]))
  else
    tasks = api(:get, "/api/v1/tasks")["data"] || []
    stale = tasks.reject { |t| StaleCheck::TERMINAL_STAGES.include?(t["stage"]) }
                 .map { |t| stale_check(t) }
                 .select { |r| r[:status] == :on_main }
    stale.each { |r| render_stale(r) }
    puts "(#{stale.size} stale task(s) — work on main but not shipped/archived)"
  end
when "create"
  # --no-claim: file the task WITHOUT repointing this session's active-feature
  # marker at it. Filing a task is not building it — a conductor (bin/release)
  # opening a batch of follow-ups must not drag its status line (and its live
  # build-claim) onto each fresh `designed` task. Stripped before parse_flags so
  # it never lands in positionals or the request body.
  no_claim = !ARGV.delete("--no-claim").nil?
  _pos, scalars, lists, top = parse_flags(ARGV, context: "create")
  die!("create needs --title") unless top["title"]
  devops = stamp_session(build_devops({}, scalars, lists))
  body = top_body(top)
  body["devops"] = devops unless devops.empty?
  task = api(:post, "/api/v1/tasks", body)["data"]
  # Seed the usage baseline at CREATE so the design phase is measured: the first
  # work transition (designed→building) then diffs against the session's totals
  # AT creation and records the real design-phase token delta — instead of the
  # zeroed first-move baseline that dropped the "Designed → Building" card to a
  # model-only chip (TOKENS — / COST —). Same fix shape as the build-claim and
  # intent seeds; idempotent + best-effort, and a no-op without a transcript.
  seed_usage_baseline(task["slug"]) if task.is_a?(Hash) && task["slug"]
  write_feature_marker(task) unless no_claim
  print_task(task)
when "begin"
  # The fast-lane SESSION-START wrapper: create → worktree → bind → claim →
  # preflight, one command, idempotent at every seam. Orchestration ONLY — the
  # create API's naming discipline, the worktree allocator, the build-claim
  # gate, and session-preflight all keep their own semantics; `begin` sequences
  # them and skips whatever a previous partial run already landed. The claim
  # gate holds on BOTH paths: a fresh/designed task rides the explicit child
  # `move building` (which enforces it), and a resume of an already-`building`
  # task runs the SAME gate inline below — a resume must never bypass a live
  # foreign build claim. bin/ship is the handoff twin at the other end.
  usage = "usage: bin/task begin --title \"Three To Five Words\" [--repo APP] [--steal] [create flags]  |  bin/task begin <slug> [--steal]"
  # --steal: the house build-claim override, same meaning as on `move` — take
  # over a task a DIFFERENT live instance holds. Honored by the resume gate
  # below and forwarded to the child `move building`. Stripped before
  # parse_flags (create's --no-claim pattern) so it never rides into the body.
  steal = !ARGV.delete("--steal").nil?
  positionals, scalars, lists, top = parse_flags(ARGV, context: "begin")
  die!(usage) if positionals.size > 1
  # The resume key: an explicit --slug, the positional slug of a prior begin, or
  # the slug the board WOULD derive from the title (FastLane.derive_slug mirrors
  # Task#generate_slug's parameterize) passed explicitly so client and server
  # agree — rerunning the same begin finds its own task instead of a suffixed twin.
  slug = [top["slug"], positionals.first, FastLane.derive_slug(top["title"])].find { |v| !v.to_s.strip.empty? }
  die!(usage) if slug.to_s.empty?

  task = fetch_task_for_begin(slug)
  if task.nil?
    die!("no task #{slug.inspect} to resume — pass --title to create one") unless top["title"]
    scalars["kind"] = "feature" unless scalars.key?("kind")
    devops = stamp_session(build_devops({}, scalars, lists))
    body = top_body(top.merge("slug" => slug))
    body["devops"] = devops unless devops.empty?
    task = api(:post, "/api/v1/tasks", body)["data"]
    seed_usage_baseline(task["slug"]) if task.is_a?(Hash) && task["slug"]
    write_feature_marker(task)
    warn!("begin 1/5 task — created #{slug} [designed]")
  else
    warn!("begin 1/5 task — #{slug} already exists [#{task["stage"]}]; resuming")
  end

  stage = task["stage"].to_s
  unless %w[designed building].include?(stage)
    die!("#{slug} is [#{stage}] — begin only starts a designed/building task. " \
         "Pick a different title (or --slug) for new work; a #{stage} task is past the build seam.")
  end

  dv = task.dig("metadata", "devops") || {}

  # THE RESUME CLAIM GATE. An already-`building` task skips the child `move
  # building` below — which is where the build-claim gate lives — so a bare
  # resume once continued a task ANOTHER live instance owned (the review-blocked
  # build-ownership hole). Run the SAME gate here, and run it BEFORE the
  # worktree steps so a foreign-held desk is refused before begin touches it:
  # :held_by_other refuses loudly (holder + progress named) unless --steal;
  # unclaimed / expired / corrupt stay fail-open exactly as the move's gate
  # treats them (the 4/5 re-claim writes the fresh, healing lease). No session
  # identity → no gate and no claim, mirroring `move`'s plain-shell degrade.
  mover_session = session_identity.first
  if stage == "building" && !mover_session.nil?
    enforce_claim_gate!(slug, dv, mover_session, steal: steal, task: task,
                        steal_hint: "bin/task begin #{slug} --steal")
  end

  # Open the session's ORIENT activity now — after the claim gate admits this
  # instance, before the worktree/preflight steps that are the session's first
  # real tool calls — so the fast-lane trail is task-attributed from the start
  # (fast-lane-narrates-activities). Non-fatal; the agent stays free to open its
  # own finer-grained activities in between, and bin/ship closes the trail.
  narrate("start", "--category", "Explore", "--task", slug,
          "--reason", "orient: #{task["title"].to_s.strip.empty? ? slug : task["title"]}")

  app = [(lists["repositories"].first if lists.key?("repositories")), Array(dv["repositories"]).first,
         "mcritchie-studio"].find { |v| !v.to_s.strip.empty? }
  worktree_slug = [dv["worktree_slug"], slug].find { |v| !v.to_s.strip.empty? }
  worktree_bin = BinHelpers.bin_for("TASK_BEGIN_WORKTREE_BIN", "agent-worktree")
  # agent-worktree `new` is idempotent (an existing desk is reused) and `bind-task`
  # re-binds safely — `new` does NOT auto-bind, which is why begin welds them.
  begin_step!("2/5 worktree", slug, worktree_bin, "new", app, worktree_slug)
  begin_step!("3/5 bind", slug, worktree_bin, "bind-task", app, worktree_slug, slug)

  if stage == "building"
    if mover_session.nil?
      warn!("begin 4/5 claim — already [building]; no session identity, leaving the claim as-is")
    else
      # The gate above admitted this instance — now WRITE the claim so ownership
      # durably lands on it: a --steal transfers it, an expired/corrupt lease is
      # adopted (and healed), our own lease is renewed. Same read-merge-write as
      # `move building` and `heartbeat` — a FRESH read so bind-task's writes are
      # not clobbered — plus the marker + usage seed the move path stamps, so the
      # statusline heartbeat renews the new holder's lease instead of letting a
      # stolen claim silently lapse back after the TTL.
      current = api(:get, "/api/v1/tasks/#{slug}")["data"] || {}
      merged = stamp_session(current.dig("metadata", "devops") || {})
      # prior: the stored claim, so a blank-nonce renewal never erases a good nonce.
      merged.merge!(ClaimLease.renewed(session: mover_session, nonce: claim_nonce,
                                       prior: current.dig("metadata", "devops")))
      api(:patch, "/api/v1/tasks/#{slug}", { "devops" => merged })
      seed_usage_baseline(slug)
      write_feature_marker(current.merge("metadata" => { "devops" => merged }))
      warn!("begin 4/5 claim — already [building]; claim renewed for this instance")
    end
  else
    # An explicit child `move building` so the claim lease, --dev-size stamp,
    # usage-baseline seed, and read-back verify all ride the ONE existing path.
    move_cmd = [File.expand_path(__FILE__), "move", slug, "building"]
    move_cmd += ["--dev-size", top["dev_size"]] if top["dev_size"]
    move_cmd << "--steal" if steal
    begin_step!("4/5 claim", slug, *move_cmd)
  end

  worktree_dir = CertRootGuard.worktree_hint(worktree_slug, ENV["TASK_BEGIN_PROJECTS_DIR"])
  die!("worktree #{worktree_slug.inspect} not found on disk after allocation — check bin/agent-worktree output") if worktree_dir.nil?
  preflight_bin = BinHelpers.bin_for("TASK_BEGIN_PREFLIGHT_BIN", "session-preflight")
  # Pin the inspected root to the worktree. session-preflight resolves its own
  # root from __dir__, so `chdir` alone left the primary's copy inspecting the
  # PRIMARY (begin-preflight-wrong-root): a false GREEN, and a false RED that
  # exited begin whenever the primary drifted behind accepted. --root names the
  # desk explicitly; session-preflight self-defends that it really is this task's.
  begin_step!("5/5 preflight", slug, preflight_bin, slug, "--root", worktree_dir, chdir: worktree_dir)

  context = begin
    JSON.parse(File.read(File.join(worktree_dir, ".agent-context.json")))
  rescue StandardError
    {}
  end
  puts "#{app} · #{slug} · #{BASE_URL}/tasks/#{slug}"
  puts "worktree: #{worktree_dir}"
  puts "port: #{context["app_port"]}" if context["app_port"]
  puts "url: #{context["local_url"]}" if context["local_url"]
  puts "task: #{BASE_URL}/tasks/#{slug}"
  puts "next: build in the worktree, then hand off with: bin/ship #{slug}"
when "update"
  usage = "usage: bin/task update <slug> [flags]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  _pos, scalars, lists, top = parse_flags(ARGV, context: "update")
  current = api(:get, "/api/v1/tasks/#{slug}")["data"]
  body = top_body(top)
  if scalars.any? || lists.any?
    devops = build_devops(current.dig("metadata", "devops"), scalars, lists)
    body["devops"] = devops
  end
  die!("nothing to update") if body.empty?
  print_task(api(:patch, "/api/v1/tasks/#{slug}", body)["data"])
when "move"
  usage = "usage: bin/task move <slug> <stage>"
  slug = positional!(ARGV.shift || die!(usage), usage)
  stage = positional!(ARGV.shift || die!(usage), usage)
  validate_stage!(stage)
  # Best-effort per-transition usage the agent reports for the work it just did
  # in the stage it's leaving — the optional layer on top of the deterministic
  # from/to/duration spine the server records. Always tags source=cli.
  event = { "source" => "cli" }
  # Attribute this transition to whoever is RUNNING the move (the actual mover),
  # not the build session that claimed the task at `building`. So a CLI
  # reviewed/assembled/shipped move records the mover's session — the server no
  # longer backfills actor from devops_session_id. --actor (below) overrides;
  # a plain shell / CI run (no session) stamps no actor.
  mover_session = session_identity.first
  event["actor"] = mover_session unless mover_session.nil?
  steal = false
  # The builder Pokémon's own size estimate, stamped as it CLAIMS the task at
  # `building` (optional — absent is fine). Set as a top-level Task column.
  dev_size = nil
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--model"      then event["model"]      = ARGV.shift || die!("--model needs a value")
    when "--tokens-in"  then event["tokens_in"]  = (ARGV.shift || die!("--tokens-in needs a value")).to_i
    when "--tokens-out" then event["tokens_out"] = (ARGV.shift || die!("--tokens-out needs a value")).to_i
    when "--cost"       then event["cost"]       = ARGV.shift || die!("--cost needs a value")
    when "--actor"      then event["actor"]      = ARGV.shift || die!("--actor needs a value")
    when "--dev-size"   then dev_size = ARGV.shift || die!("--dev-size needs a value"); validate_size!("--dev-size", dev_size)
    when "--steal"      then steal = true # override the build-claim gate (take a live foreign claim)
    else unknown_flag!(flag, valid: %w[--model --tokens-in --tokens-out --cost --actor --dev-size --steal], context: "move")
    end
  end
  # No explicit usage flags → auto-capture the per-transition delta (model +
  # tokens + cost) from the session transcript so a bare move still leaves a full
  # paper trail. Best-effort; a missing transcript leaves the event spine-only.
  autofill_move_usage(event, slug) unless %w[model tokens_in tokens_out cost].any? { |k| event.key?(k) }
  body = { "stage" => stage, "event" => event }
  body["dev_size"] = dev_size if dev_size # the builder's estimate, set alongside the stage move
  # Claim the task on the move to building. The gate refuses (loudly, overridable
  # with --steal) when a DIFFERENT live instance already holds it; otherwise it
  # claims/renews the lease. Read-merge-write so the claim + session fields ride
  # alongside existing devops without wiping them (the raw API replaces
  # metadata.devops wholesale). No session → no claim (plain shell / CI degrades).
  if stage == "building" && !mover_session.nil?
    current = api(:get, "/api/v1/tasks/#{slug}")["data"]
    current_devops = current.dig("metadata", "devops") || {}
    enforce_claim_gate!(slug, current_devops, mover_session, steal: steal, task: current)
    # Seed the usage baseline at the CLAIM so the build work transition
    # (building→submitted) records a true token delta. Idempotent: a no-op when
    # autofill above already wrote a baseline this move (e.g. a bare move), it
    # matters when explicit usage flags skipped autofill.
    seed_usage_baseline(slug)
    merged = stamp_session(current_devops)
    merged.merge!(ClaimLease.renewed(session: mover_session, nonce: claim_nonce, prior: current_devops))
    body["devops"] = merged
  end
  task = api(:patch, "/api/v1/tasks/#{slug}", body)["data"]
  # The board answered 2xx — but a 2xx is not persistence. Read the task back and
  # confirm the stage actually moved before printing the success line, so a
  # silently-non-persisting write exits nonzero + loud instead of stranding the
  # task while the handoff claims it advanced.
  verify_move_persisted!(slug, stage)
  write_feature_marker(task)
  print_task(task)
when "merged"
  # Set the git-location crash-recovery signal (Task::MERGED_STATES). Review stamps
  # `accepted` the moment it lands a feat PR on the accepted branch — the ladder's
  # first rung — so an interrupted sweep can promote accepted→release WITHOUT
  # re-reviewing (Release#add later downgrades it to "release" at sweep). NOT a
  # stage move and NOT event-recorded: it's the durable "where is the code" fact
  # the deploy heartbeats read. Set through the same one-path PATCH update as
  # `move` (config/routes.rb: no named-transition endpoint), then read back to
  # confirm it persisted — a 200 is not persistence, and a dropped stamp would
  # strand the task off every RC (the sweep leaves a merged:"" `reviewed` member
  # behind as a HELD anomaly).
  usage = "usage: bin/task merged <slug> <accepted|release|main>"
  slug = positional!(ARGV.shift || die!(usage), usage)
  state = positional!(ARGV.shift || die!(usage), usage)
  valid = %w[accepted release main]
  die!("merged must be one of #{valid.join(", ")} (got #{state.inspect})") unless valid.include?(state)
  die!(usage) unless ARGV.empty?
  task = api(:patch, "/api/v1/tasks/#{slug}", { "merged" => state })["data"]
  verify_merged_persisted!(slug, state)
  puts "merged set on #{slug}: #{state}"
  print_task(task)
when "intent"
  # Record an INTENT — an agent (or the two senior reviewers) STARTING a stage's
  # work, the moment it begins — so /deployments + the task timeline show who's on
  # it with a live ticker BEFORE the →stage transition lands. Append-only +
  # idempotent server-side within the current source-stage cycle, and a no-op once
  # the target stage landed in that cycle. Leaving the source stage closes the old
  # intent; rework can return a task to `submitted`, where a fresh `→reviewed`
  # intent may open. Used for the Avi QA (--to assembled --actor
  # avi) and Steffon ship (--to shipped --actor steffon) intents; the review pair
  # (--to reviewed) is normally recorded by `bin/reviewer-select` (which records
  # by default).
  usage = "usage: bin/task intent <slug> --to <stage> [--actor SLUG] [--reviewer slug:weight ...]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  to_stage = nil
  actor = nil
  reviewers = []
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--to"       then to_stage = ARGV.shift || die!("--to needs a stage")
    when "--actor"    then actor = ARGV.shift || die!("--actor needs a value")
    when "--reviewer"
      raw = ARGV.shift || die!("--reviewer needs slug[:weight]")
      s, w = raw.split(":", 2)
      reviewers << { "slug" => s, "weight" => w }
    else unknown_flag!(flag, valid: %w[--to --actor --reviewer], context: "intent")
    end
  end
  die!("usage: bin/task intent <slug> --to <stage> [--actor SLUG] [--reviewer slug:weight ...]") if to_stage.to_s.empty?
  validate_stage!(to_stage)
  body = { "to_stage" => to_stage, "event" => { "source" => "cli" } }
  body["actor"] = actor if actor
  body["reviewers"] = reviewers if reviewers.any?
  task = api(:post, "/api/v1/tasks/#{slug}/intent", body)["data"]
  # Seed the usage baseline the moment this session STARTS the stage's work (the
  # intent), so the matching work transition (e.g. submitted→reviewed for a
  # reviewer, or a deploy-side move read by bin/release) records a true delta
  # instead of a zeroed first-touch baseline. Best-effort; only after the intent
  # landed server-side.
  seed_usage_baseline(slug)
  crew = [actor, *reviewers.map { |r| "#{r["slug"]}/#{r["weight"]}" }].compact.join(" · ")
  puts "intent recorded on #{slug}: → #{to_stage}#{crew.empty? ? "" : " · #{crew}"}"
  print_task(task) if task
when "checkpoint"
  # Emit a CHECKPOINT event — a named moment WITHIN the current stage that does not
  # move it. bin/full-suite-check bookends the local-certification testing phase with
  # `checkpoint <slug> cert --status started` then `--status completed`. POSTs to the
  # same events/<name>/{start,complete} endpoints the API checkpoint path uses;
  # source defaults to "system" so it skips the usage gate (a marker, not agent work).
  usage = "usage: bin/task checkpoint <slug> <name> --status started|completed [--source S] [--message M]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  name = positional!(ARGV.shift || die!("checkpoint needs a <name>: bin/task checkpoint <slug> <name> --status started|completed"), usage)
  status = nil
  source = "system"
  message = nil
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--status"  then status = ARGV.shift || die!("--status needs started or completed")
    when "--source"  then source = ARGV.shift || die!("--source needs a value")
    when "--message" then message = ARGV.shift || die!("--message needs a value")
    else unknown_flag!(flag, valid: %w[--status --source --message], context: "checkpoint")
    end
  end
  status = status.to_s
  die!("--status must be started or completed") unless %w[started completed].include?(status)
  event = { "source" => source }
  event["message"] = message if message
  # WHOSE checkpoint this is. A cert emits two artifacts — this event and a
  # g1_cert GateRun — and until 2026-08-13 neither carried an owner, so the claim
  # gate credited a challenger's own cert to the holder it was refusing the
  # challenger on behalf of. Stamped in metadata (not `actor`, which souls use) and
  # omitted entirely in a plain shell / CI run: unattributed must stay honestly
  # unattributed. See Task#progress_evidence.
  checkpoint_session = session_identity.first
  event["metadata"] = { "session" => checkpoint_session } unless checkpoint_session.nil?
  api(:post, "/api/v1/tasks/#{slug}/events/#{name}/#{status == "started" ? "start" : "complete"}", { "event" => event })
  puts "checkpoint #{name} #{status} on #{slug}"
when "heartbeat"
  # The live-terminal lease renewal — bin/statusline calls this each render
  # (throttled) so a crashed/closed session's claim lapses after the TTL and the
  # task becomes reclaimable. Renews THIS instance's claim on <slug> (or adopts an
  # unclaimed/expired one); NEVER steals a live foreign claim. Fully best-effort:
  # no session, no slug, or any API error → silent no-op (a heartbeat must never
  # disrupt the status line). Prints nothing on success.
  usage = "usage: bin/task heartbeat <slug> [--desk PATH]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  # The desk whose file mtimes decide whether this claim is still being WORKED.
  # bin/statusline passes its cwd when that cwd is a bound worktree; absent, we
  # try cwd anyway. Either way DeskActivity.desk_root refuses any directory not
  # bound to THIS task, so a heartbeat fired from a primary checkout resolves no
  # desk and falls back to renewing — see the abandonment check below.
  heartbeat_desk = nil
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--desk" then heartbeat_desk = ARGV.shift || die!("--desk needs a path")
    else unknown_flag!(flag, valid: %w[--desk], context: "heartbeat")
    end
  end
  begin
    session = session_identity.first
    unless session.nil?
      current = api(:get, "/api/v1/tasks/#{slug}")["data"] || {}
      # The heartbeat renews a BUILD claim, and a build claim only exists once the
      # task is actually `building` — forged solely by an explicit `move building`.
      # A task still in `designed` (or any non-build stage) is unclaimed by
      # definition: `bin/task create` repoints the creator's session marker to the
      # new task, so renewing here would forge a live claim on a task nobody is
      # building (the creator's mascot ticking on an unowned `designed` task). This
      # is the authoritative guard — bin/statusline already skips firing for a
      # non-building per-session marker; this refuses even a stray call.
      if current["stage"] == "building"
        devops = current.dig("metadata", "devops") || {}
        decision = ClaimLease.evaluate(ClaimLease.from_devops(devops), session: session, nonce: claim_nonce)
        # Don't steal a live foreign claim via a heartbeat — and don't renew a claim
        # this session has ABANDONED. bin/statusline fires this every ~45s from a
        # painting terminal, so without the second guard an open terminal renews a
        # build claim forever whether or not anyone is working: the 2026-08-13 stall,
        # where a lease ticked 16:05:16Z → 16:06:46Z with three agents queued behind
        # it and several `claude` processes on this machine days old.
        #
        # Declining is the WHOLE mechanism. Nothing is reclaimed, blocked, or
        # deleted here; the lease simply stops being renewed and lapses on the
        # ordinary TTL, after which the ordinary gate admits the next claimant. If
        # this call is wrong, the holder's very next heartbeat re-claims the task —
        # the mistake heals itself, which is why declining is safe and expiring
        # eagerly would not be.
        if decision != :held_by_other && !heartbeat_abandoned?(slug, current, devops, heartbeat_desk)
          merged = devops.merge(ClaimLease.renewed(session: session, nonce: claim_nonce, prior: devops))
          api(:patch, "/api/v1/tasks/#{slug}", { "devops" => merged })
        end
      end
    end
  rescue SystemExit, StandardError
    nil # best-effort: swallow API/transport failures
  end
when "session-mascot"
  # Eagerly paint the session's Pokémon mascot onto the per-session marker so
  # bin/statusline shows it in SECONDS — fired by a SessionStart hook, before any
  # task exists. Idempotent server-side (SessionMascot), and the board task adopts
  # the same mascot later. Also works as a manual Codex kickoff:
  #   bin/task session-mascot --print
  #   bin/task session-mascot --persona jasper --print
  #   bin/task session-mascot --persona none --print
  # Best-effort: no session, no marker path, or any API / transport failure →
  # silent no-op unless --print was requested.
  # Parse BEFORE the best-effort rescue below: a bad flag must exit nonzero, not
  # be swallowed — die!'s SystemExit was rescued, so `--bogus` printed the error
  # yet exited 0 (the same silent-no-op disease as the old parse_flags loop).
  print_marker = false
  persona = nil
  until ARGV.empty?
    case (arg = ARGV.shift)
    when "--print"
      print_marker = true
    when "--persona"
      persona = ARGV.shift || die!("--persona needs a value")
    else
      unknown_flag!(arg, valid: %w[--persona --print], context: "session-mascot")
    end
  end
  begin
    sid = session_identity.first.to_s.strip
    # `sid.empty?` IS feature_marker_path's nil case (it is the only one), asked without
    # binding the raw path — see write_feature_marker.
    unless ENV["TASK_SKIP_MARKER"] == "1" || sid.empty?
      # The marker store's second write seam — guarded like write_feature_marker's.
      path = TaskUsageSandbox.enforce!(feature_marker_path, store: "session-marker")
      body = {}
      body["parent_session_id"] = parent_session_identity if parent_session_identity
      data = api(:post, "/api/v1/sessions/#{sid}/mascot", body.empty? ? nil : body)["data"]
      if data && !data["mascot"].to_s.strip.empty?
        existing = (JSON.parse(File.read(path)) if File.exist?(path)) || {}
        marker = existing.merge(
          "mascot" => data["mascot"],
          "mascot_color" => data["mascot_color"],
          "mascot_emoji" => marker_display_emoji(data),
          "mascot_shiny" => (true if truthy_marker_value?(data["mascot_shiny"]))
        )
        # Seed the DEFAULT app (mcritchie-studio) only when the marker has no app
        # yet — a brand-new session reads "<Pokémon> · mcritchie-studio". Once a task
        # sets the app (write_feature_marker), never override it here.
        if marker["app"].to_s.strip.empty?
          marker["app"] = data["app"]
          marker["app_color"] = data["app_color"]
        end
        raw_persona = persona.to_s.strip
        unless raw_persona.empty?
          if PERSONA_CLEAR.include?(raw_persona.downcase)
            marker.delete("persona")
          else
            agent = api(:get, "/api/v1/agents/#{raw_persona.downcase}")["data"] || {}
            marker["persona"] = raw_persona.downcase
            marker["mascot"] = agent["name"].to_s.strip.empty? ? raw_persona : agent["name"]
            marker["mascot_color"] = agent["status_color"] || agent.dig("metadata", "color")
            marker["mascot_emoji"] = agent["emoji"] || agent.dig("metadata", "emoji")
          end
        end
        marker = marker.reject { |_, v| v.nil? || v.to_s.strip.empty? }
        FileUtils.mkdir_p(File.dirname(path))
        File.write(path, "#{JSON.pretty_generate(marker)}\n")
        refresh_codex_session_title
        print_session_marker(marker) if print_marker
      end
    end
  rescue SystemExit, StandardError
    nil # best-effort: never disrupt session start
  end
when "bounces"
  usage = "usage: bin/task bounces <slug>"
  slug = positional!(ARGV.shift || die!(usage), usage)
  unknown_flag!(ARGV[0], valid: [], context: "bounces") unless ARGV.empty?
  begin
    verdict = bounce_verdict(slug)
  rescue BounceLedger::UnreadableResponse => e
    # UNKNOWN is NOT clear. This is the whole point of the command: the failure
    # mode it replaces answered "0 prior bounces" here and let the review proceed.
    warn!("BREAKER: UNKNOWN — could not read the bounce ledger for #{slug}")
    warn!("  #{e.message}")
    warn!("  Treat UNKNOWN as NOT CLEAR: fix the read, or escalate. Never proceed as if it were zero.")
    exit 1
  end
  print_bounce_verdict(slug, verdict)
  exit(verdict.tripped? ? EXIT_BREAKER_TRIPPED : 0)
when "block"
  usage = "usage: bin/task block <slug> [--kind environment|rework|dependency] [--summary \"4-6 words\"] [--feedback \"...\"] [--agent A] [--breaker-ack \"reason\"]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  kind = feedback = summary = agent = breaker_ack = nil
  i = 0
  while i < ARGV.length
    case ARGV[i]
    when "--kind"                  then kind = ARGV[i + 1] || die!("--kind needs a value"); i += 2
    when "--summary"               then summary = ARGV[i + 1] || die!("--summary needs a value"); i += 2
    # --feedback is the details body; --details is an alias for it.
    when "--feedback", "--details" then feedback = ARGV[i + 1] || die!("#{ARGV[i]} needs a value"); i += 2
    when "--agent"                 then agent = ARGV[i + 1] || die!("--agent needs a value"); i += 2
    when "--breaker-ack"           then breaker_ack = ARGV[i + 1] || die!("--breaker-ack needs a value"); i += 2
    else unknown_flag!(ARGV[i], valid: %w[--kind --summary --feedback --details --agent --breaker-ack], context: "block")
    end
  end
  die!("--kind must be one of: #{BLOCK_KINDS.join(", ")}") if kind && !BLOCK_KINDS.include?(kind)
  die!("--breaker-ack only applies to --kind rework") if breaker_ack && kind != "rework"
  # This read doubles as the existence check the breaker would otherwise repeat —
  # an unknown slug die!s here with EXIT_TASK_NOT_FOUND before anything else runs.
  current = api(:get, "/api/v1/tasks/#{slug}")["data"]
  # THE BREAKER FIRES HERE, before the block lands — a warning printed after the
  # bounce is recorded is a receipt, not a safety mechanism. Only `rework` is
  # gated: `dependency` IS the escalation this refusal routes you to, and
  # `environment` is a blocked desk, not a send-back.
  if kind == "rework"
    begin
      breaker = bounce_verdict(slug, verify_task: false)
    rescue BounceLedger::UnreadableResponse => e
      # No silent pass. This costs nothing a caller did not already owe: the block
      # needs the same token and the same board, so an unreadable ledger means the
      # block's own writes were going to fail too.
      die!("could not read the bounce ledger for #{slug}, so the two-bounce circuit " \
           "breaker cannot be evaluated: #{e.message}")
    end
    if breaker.tripped? && breaker_ack.to_s.strip.empty?
      warn!("BREAKER: TRIPPED — #{breaker.count} prior send-back(s) on #{slug}; this block would be the next one.")
      breaker.rows.each_with_index do |row, n|
        warn!("  #{n + 1}. #{row.created_at} [#{row.kind}] #{row.summary}#{row.countable? ? "" : " (not a bounce)"}")
      end
      warn!("")
      warn!("  A repeat bounce is a review DEADLOCK, and a deadlock is the operator's call, never a ping-pong.")
      warn!("  Escalate instead:")
      warn!("    #{escalation_recipe(slug)}")
      warn!("")
      warn!("  If this bounce is MECHANICAL and not a disagreement (red CI, a merge conflict, a")
      warn!("  dirty base — nothing for the operator to arbitrate), say so and it proceeds:")
      warn!("    bin/task block #{slug} --kind rework ... --breaker-ack \"red CI, mechanical\"")
      exit EXIT_BREAKER_TRIPPED
    end
    # An override that only shows up in the database is not an override anyone will
    # notice. Say it in the run output too, where the operator reading the wave
    # report can see the breaker was overruled and on what grounds.
    if breaker.tripped?
      warn!("BREAKER: OVERRIDDEN — #{breaker.count} prior send-back(s) on #{slug}; " \
            "proceeding as MECHANICAL: #{breaker_ack.strip}")
    end
  end
  event = { "source" => "cli" }
  blocker = resolved_block_actor(agent, current, kind: kind)
  event["actor"] = blocker unless blocker.empty?
  autofill_move_usage(event, slug) unless %w[model tokens_in tokens_out cost].any? { |k| event.key?(k) }
  # Block is a `building` ATTRIBUTE now (not a stage) — PATCH the dedicated block
  # endpoint so the server stamps blocked_at/blocked_from/blocked_by/block_kind via
  # Task#block! and lands the task on building. The feedback rides as a qa_feedback
  # activity below (the durable prose marker retros/insights mine).
  body = { "event" => event }
  body["by"] = blocker unless blocker.empty?
  body["kind"] = kind if kind
  task = api(:patch, "/api/v1/tasks/#{slug}/block", body)["data"]
  # A REWORK BOUNCE MUST LEAVE A ROW EVEN WHEN THE CALLER LEFT NO PROSE. The
  # block COLUMNS are wiped by the builder's compliant resubmission, so a
  # feedback-less rework block used to vanish completely — invisible to the
  # circuit breaker forever, which is the same silent-zero this task is about,
  # arriving from the write side instead of the read side. The placeholder is
  # deliberately unflattering: a send-back with no send-back in it is
  # malpractice per the review SOP, and the ledger should say so.
  if kind == "rework" && feedback.to_s.strip.empty?
    warn!("warning: a rework block with no --feedback gives the builder nothing to fix from.")
    feedback = "Blocked for rework with NO send-back recorded — the blocking agent left no --feedback. " \
               "This row exists so the bounce is countable by the two-bounce circuit breaker."
  end
  if feedback
    note = { "task_slug" => slug, "activity_type" => "qa_feedback", "description" => feedback }
    note["agent_slug"] = blocker unless blocker.empty?
    # The 4-6 word summary rides in the activity's metadata (no column, no
    # migration). The details stay in `description`; Activity#block_summary reads
    # this back and falls back to a derived headline for legacy blocks.
    metadata = {}
    metadata["summary"] = summary.strip if summary && !summary.strip.empty?
    # STAMP THE KIND. The block COLUMNS (block_kind) are wiped by a compliant
    # resubmission, so this row is the only durable record of what kind of block
    # this was — and without it the circuit breaker cannot tell a send-back from
    # an environment blocker or from its own escalation, and counts all three the
    # same. bin/lib/bounce_ledger.rb reads it back; rows written before this
    # classify as `unknown` and still count (fail safe).
    metadata["kind"] = kind if kind
    metadata["breaker_ack"] = breaker_ack.strip if breaker_ack && !breaker_ack.strip.empty?
    note["metadata"] = metadata unless metadata.empty?
    api(:post, "/api/v1/activities", note)
    puts "noted [qa_feedback] on #{slug}"
  end
  write_feature_marker(task)
  print_task(task)
when "note"
  usage = "usage: bin/task note <slug> --handoff|--qa-feedback|--clarification|--comment \"...\" [--agent A] [--resolves-feedback]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  notes = []
  agent = nil
  resolves_feedback = false
  i = 0
  while i < ARGV.length
    arg = ARGV[i]
    if NOTE_FLAGS.key?(arg)
      desc = ARGV[i + 1] || die!("#{arg} needs a value")
      notes << [NOTE_FLAGS[arg], desc]
      i += 2
    elsif arg == "--agent"
      agent = ARGV[i + 1] || die!("--agent needs a value")
      i += 2
    elsif arg == "--resolves-feedback"
      resolves_feedback = true
      i += 1
    else
      unknown_flag!(arg, valid: NOTE_FLAGS.keys + %w[--agent --resolves-feedback], context: "note")
    end
  end
  die!("note needs one of: #{NOTE_FLAGS.keys.join(", ")}") if notes.empty?
  if resolves_feedback && notes.none? { |activity_type, _| activity_type == "handoff" }
    die!("--resolves-feedback marks handoff notes as explicitly addressing open QA feedback; " \
         "use: bin/task note <slug> --handoff \"...\" --resolves-feedback")
  end
  notes.each do |activity_type, description|
    body = { "task_slug" => slug, "activity_type" => activity_type, "description" => description }
    body["agent_slug"] = agent if agent
    body["metadata"] = { "resolves_feedback" => true } if resolves_feedback && activity_type == "handoff"
    activity = api(:post, "/api/v1/activities", body)["data"] || {}
    puts "noted [#{activity_type}] on #{slug} -> #{activity["slug"] || "(created)"}"
  end
when "usage-audit"
  # READ-ONLY. Surfaces baseline rows in the usage/cost store that a test run left
  # behind — a stub slug ("demo-task"), or a cache-read total no single task could
  # plausibly burn. Those rows are not inert: measured $cost derives actual_size
  # (Task::ACTUAL_SIZE_COST_THRESHOLDS) and seeds the reviewer-select baselines, so
  # a fixture row silently skews the sizing intelligence.
  #
  # It reports and exits. It does NOT purge: a baseline is indistinguishable at the
  # file level from real operator state, and the deletion is not reversible — that
  # call is the operator's. Exit 2 when suspects are found, so a check can gate on it.
  dir = nil
  until ARGV.empty?
    case (arg = ARGV.shift)
    when "--dir" then dir = ARGV.shift || die!("--dir needs a value")
    else unknown_flag!(arg, valid: %w[--dir], context: "usage-audit")
    end
  end
  usage_audit!(dir)
when "review-claim"
  # The per-TASK REVIEW claim (per-task-pr-review-claim) — the review LANE's per-task
  # lease, so MANY pr-review sessions run in parallel and each SKIPS a task already
  # under live review. Delegated whole to ReviewClaimCli (bin/lib/review_claim_cli.rb),
  # the mirror of bin/devops-shift one granularity down (lane → task): same
  # live-instance identity, TTL, and detached renewer. `cmd` is already shifted, so
  # ARGV is [<sub> <slug> ...flags]. Exit codes: 0 claimed · 10 skipped (already under
  # review by another) · 1 fail-open (no session / no board).
  require_relative "lib/review_claim_cli"
  exit(ReviewClaimCli.new.run(ARGV))
when "claim-next-review"
  # The ATOMIC server-side review pop (relocate-review-selection-to-server): ask the
  # board for the single highest-ranked reviewable GREEN-CI task and claim it in ONE
  # request, instead of assembling that decision client-side (reviewable list →
  # per-PR CI read → per-task acquire). Prints the claimed slug (exit 0), or "none"
  # (exit 4) when nothing is eligible. Delegated to ReviewClaimCli, reusing its
  # live-instance identity + detached-renewer machinery. ARGV is [<flags>] (the
  # subcommand is already shifted off).
  require_relative "lib/review_claim_cli"
  exit(ReviewClaimCli.new.run(["claim-next", *ARGV]))
when "migration-lane"
  # The `backend_migration` exclusive lane (docs/agents/system/exclusive-lanes.md).
  # Before `bin/rails g migration`, before creating a file in db/migrate/, before
  # touching db/schema.rb — acquire. If the lane is held, queue and chat the holder.
  #
  # The lane is GLOBAL, so `acquire`/`release` take no slug of their own; the
  # optional <task-slug> only RECORDS which task holds it, so a refused Dev is told
  # who to ask. Exit codes: 0 acquired / lane reported · 10 refused (a live holder)
  # · 1 error. 10 is distinct from 1 because "someone else is migrating" is a normal
  # outcome a script should branch on, not a failure.
  usage = "usage: bin/task migration-lane <acquire|release|status> [<task-slug>] [--label L] [--agent A]"
  sub = positional!(ARGV.shift || die!(usage), usage)
  die!(usage) unless %w[acquire release status].include?(sub)

  lane_task = nil
  lane_label = nil
  lane_agent = nil
  until ARGV.empty?
    arg = ARGV.shift
    case arg
    when "--label" then lane_label = ARGV.shift || die!("--label needs a value")
    when "--agent" then lane_agent = ARGV.shift || die!("--agent needs a value")
    else
      unknown_flag!(arg, valid: %w[--label --agent], context: "migration-lane") if arg.start_with?("-")
      lane_task = arg
    end
  end

  # `status` is a pure read, so it must work from a plain shell with no agent
  # session. acquire/release cannot: a lease with no identity could never be
  # renewed or released by its owner, and a lane holder nobody can name is exactly
  # the wedged lane this build exists to prevent.
  if sub == "status"
    holder = api(:get, "/api/v1/migration_lane")["data"]["holder"]
    if holder.nil? || !holder["live"]
      puts "migration lane: FREE"
      exit 0
    end
    puts "migration lane: HELD"
    puts "  task:    #{holder["task_slug"] || "-"}"
    puts "  agent:   #{holder["agent"] || "-"}"
    puts "  label:   #{holder["label"] || "-"}"
    puts "  since:   #{holder["acquired_at"] || "-"}"
    puts "  expires: #{holder["expires_at"] || "-"}"
    exit 0
  end

  session, = session_identity
  die!("migration-lane #{sub} needs an agent session (CLAUDE_CODE_SESSION_ID / CODEX_THREAD_ID); `status` works without one") if session.nil?
  nonce = claim_nonce

  if sub == "acquire"
    data = api(:post, "/api/v1/migration_lane", {
      session: session, nonce: nonce, task_slug: lane_task, agent: lane_agent, label: lane_label
    })["data"]
    holder = data["holder"] || {}
    if data["acquired"]
      puts "migration lane ACQUIRED#{lane_task ? " for #{lane_task}" : ""} (expires #{holder["expires_at"]})"
      puts "release it with: bin/task migration-lane release"
      exit 0
    end
    warn "migration lane HELD by #{holder["agent"] || holder["label"] || holder["session"] || "another session"}" \
         "#{holder["task_slug"] ? " (task #{holder["task_slug"]})" : ""} since #{holder["acquired_at"]}"
    warn "queue: pick up a non-migration task and ask the holder for an ETA."
    exit 10
  end

  data = api(:post, "/api/v1/migration_lane/release", { session: session, nonce: nonce })["data"]
  # Releasing something you never held is a harmless no-op, not an error — the
  # SOP's belt-and-suspenders release fires on every exit path.
  puts data["released"] ? "migration lane RELEASED" : "migration lane not held by this session (no-op)"
  exit 0
else
  print_usage!
  exit(cmd == "help" || HELP_FLAGS.include?(cmd) ? 0 : 1)
end
