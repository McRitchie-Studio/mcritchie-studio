#!/usr/bin/env sh
set -eu

script_dir=$(CDPATH= cd "$(dirname "$0")" && pwd)
app_root=$(CDPATH= cd "$script_dir/.." && pwd)
ruby_version_file="$app_root/.ruby-version"
ruby_version=""

if [ -f "$ruby_version_file" ]; then
  ruby_version=$(tr -d '[:space:]' < "$ruby_version_file")
fi

if [ -n "$ruby_version" ] && command -v mise >/dev/null 2>&1; then
  exec mise x "ruby@$ruby_version" -- ruby "$script_dir/release.rb" "$@"
fi

ruby_major=$(ruby -e 'print RUBY_VERSION.split(".").first' 2>/dev/null || true)
case "$ruby_major" in
  ''|*[!0-9]*) ruby_major=0 ;;
esac

if [ "$ruby_major" -lt 3 ]; then
  echo "bin/release requires Ruby ${ruby_version:-3.x}; install mise or activate the repo Ruby before running release commands." >&2
  exit 1
fi

exec ruby "$script_dir/release.rb" "$@"
