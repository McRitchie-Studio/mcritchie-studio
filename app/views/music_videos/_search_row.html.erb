<%# One typeahead result on the cast card, shared by the artist search and "Replaced by". Sits inside an Alpine x-for over results as (r, i). The artist search passes no look and draws one line: a headshot or a placeholder, the name over a utility row (primary vocation, team, then any hint), and a trailing badge. "Replaced by" passes look, the Alpine expression for the person's default look, and draws three columns in its wider list: the headshot; the name, the utility row and the looks count; and that look's character-sheet thumbnail and name (or "No look yet"). Below sm the third column drops under the second. %>
<% look = local_assigns[:look] %>
<% if look %>
  <button type="button" role="option" :aria-selected="i === active" @click="choose(r)" @mouseenter="active = i"
          class="w-full text-left rounded-lg px-3 py-2 min-w-0 grid grid-cols-[auto_minmax(0,1fr)] sm:grid-cols-[auto_minmax(0,1fr)_minmax(0,15rem)] items-center gap-x-3 gap-y-2"
          :class="i === active ? 'bg-surface-alt' : ''" data-test="<%= option_test %>" :data-slug="r.slug">
    <%= render "music_videos/person_avatar", person: "r", size: "w-11 h-11", icon: "w-6 h-6", failed: "avatarFailed" %>
    <span class="min-w-0">
      <span class="block text-sm font-semibold text-heading truncate" x-text="r.name" data-test="search-row-name"></span>
      <span class="block text-xs text-muted truncate" :title="r.slug" data-test="search-row-utility">
        <span class="text-body" x-text="r.vocation || 'person'" data-test="search-row-vocation"></span><span x-show="r.team"> · <span x-text="r.team" data-test="search-row-team"></span></span>
      </span>
      <span class="badge text-3xs mt-1" :class="<%= badge_class %>" x-text="<%= badge %>" data-test="search-row-badge"></span>
    </span>
    <span class="col-start-2 sm:col-start-auto min-w-0" data-test="search-row-look-cell">
      <span x-show="<%= look %>" class="flex items-center gap-2 min-w-0" data-test="search-row-look">
        <%= render "music_videos/look_thumb", look: look, size: "w-20 h-12" %>
        <span class="min-w-0 flex-1">
          <span class="block text-3xs uppercase tracking-wide text-muted">Primary look</span>
          <span class="block text-xs font-semibold text-heading truncate" x-text="<%= look %> ? <%= look %>.descriptor : ''" data-test="search-row-look-name"></span>
        </span>
      </span>
      <span x-show="!<%= look %>" class="flex items-center gap-2 min-w-0 text-xs text-muted" data-test="search-row-no-look">
        <span class="w-20 h-12 shrink-0 rounded-md border border-dashed border-subtle" aria-hidden="true"></span>
        <span x-text="r.looks.length ? 'No primary look' : 'No look yet'"></span>
      </span>
    </span>
  </button>
<% else %>
  <button type="button" role="option" :aria-selected="i === active" @click="choose(r)" @mouseenter="active = i"
          class="w-full text-left rounded-lg px-3 py-2 min-w-0"
          :class="i === active ? 'bg-surface-alt' : ''" data-test="<%= option_test %>" :data-slug="r.slug">
    <span class="flex items-center gap-3 min-w-0">
      <%= render "music_videos/person_avatar", person: "r", size: "w-9 h-9", icon: "w-5 h-5", failed: "avatarFailed" %>
      <span class="min-w-0 flex-1">
        <span class="block text-sm font-semibold text-heading truncate" x-text="r.name" data-test="search-row-name"></span>
        <span class="block text-xs text-muted truncate" :title="r.slug" data-test="search-row-utility">
          <span class="text-body" x-text="r.vocation || 'person'" data-test="search-row-vocation"></span><span x-show="r.team"> · <span x-text="r.team" data-test="search-row-team"></span></span><span x-show="<%= hint %>"> · <span x-text="<%= hint %>"></span></span>
        </span>
      </span>
      <span class="badge text-3xs shrink-0" :class="<%= badge_class %>" x-text="<%= badge %>" data-test="search-row-badge"></span>
    </span>
  </button>
<% end %>
