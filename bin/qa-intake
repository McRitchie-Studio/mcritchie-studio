#!/usr/bin/env ruby
# frozen_string_literal: true

# Conductor-facing PR/worktree intake for the parallel-agent DevOps cycle.
#
# Reads the local non-secret worktree registry produced by:
#   bin/agent-worktree snapshot --write
#
# Then, when GitHub CLI is available, joins that local state with open PRs so
# Avi can see what is ready, what is stale, and what needs cleanup.

require "json"
require "open3"
require "optparse"
require "shellwords"
require "time"
require "yaml"
require_relative "lib/projects_root"

SCRIPT_ROOT = File.expand_path("..", __dir__)

PROJECTS_DIR = File.expand_path(ENV.fetch("PROJECTS_DIR") { ProjectsRoot.default_projects_dir })
DEFAULT_REGISTRY = File.join(PROJECTS_DIR, ".agents", "worktree-registry.json")
RELEASE_REPOS_CONFIG = File.join(SCRIPT_ROOT, "config", "release_repos.yml")
QA_ENVIRONMENTS_CONFIG = File.join(SCRIPT_ROOT, "config", "qa_environments.yml")

OPTIONS = {
  refresh: false,
  json: false,
  gh: true,
  registry: File.expand_path(ENV.fetch("AGENT_WORKTREE_REGISTRY", DEFAULT_REGISTRY)),
  apps: nil
}

# CLI option parsing + dispatch live at the bottom of this file, behind a
# `$PROGRAM_NAME == __FILE__` guard (see `parse_options!` / `run!`), so the
# classification helpers can be `load`ed as a library in unit tests without
# parsing ARGV or reading a registry.

def capture_status(*cmd, chdir: nil, env: {})
  options = {}
  options[:chdir] = chdir if chdir
  out, err, status = Open3.capture3(env, *cmd, **options)
  [status.success?, out, err]
end

def command_available?(name)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
    path = File.join(dir, name)
    File.file?(path) && File.executable?(path)
  end
end

def refresh_registry(path, warnings)
  env = { "AGENT_WORKTREE_REGISTRY" => path }
  ok, out, err = capture_status("bin/agent-worktree", "snapshot", "--write", chdir: SCRIPT_ROOT, env: env)
  return out.strip if ok

  warnings << "registry refresh failed: #{[err, out].join(" ").strip}"
  nil
end

def read_registry(path)
  abort "missing worktree registry: #{path}\nRun: bin/agent-worktree snapshot --write" unless File.exist?(path)

  JSON.parse(File.read(path))
rescue JSON::ParserError => e
  abort "invalid worktree registry JSON at #{path}: #{e.message}"
end

def github_repo_for(repo_path)
  ok, out, = capture_status("git", "remote", "get-url", "origin", chdir: repo_path)
  return nil unless ok

  remote = out.strip
  case remote
  when %r{\Agit@github\.com:(.+?)(?:\.git)?\z}
    Regexp.last_match(1).delete_suffix(".git")
  when %r{\Ahttps://github\.com/(.+?)(?:\.git)?\z}
    Regexp.last_match(1).delete_suffix(".git")
  end
end

def fetch_open_prs(apps, warnings)
  return [] unless OPTIONS[:gh]
  unless command_available?("gh")
    warnings << "GitHub PR lookup skipped: gh CLI is not available"
    return []
  end

  apps.flat_map do |app|
    repo_path = app.fetch("repo")
    repo = github_repo_for(repo_path)
    unless repo
      warnings << "GitHub PR lookup skipped for #{app.fetch("slug")}: no GitHub origin remote"
      next []
    end

    fields = "number,title,url,isDraft,headRefName,baseRefName,mergeStateStatus,mergeable,reviewDecision,updatedAt,author,labels"
    ok, out, err = capture_status("gh", "pr", "list", "--repo", repo, "--state", "open", "--json", fields)
    unless ok
      warnings << "GitHub PR lookup failed for #{repo}: #{err.lines.first.to_s.strip}"
      next []
    end

    JSON.parse(out).map { |pr| pr.merge("app" => app.fetch("slug"), "repo" => repo) }
  rescue JSON::ParserError => e
    warnings << "GitHub PR lookup returned invalid JSON for #{app.fetch("slug")}: #{e.message}"
    []
  end
end

def release_managed_apps
  release_apps = YAML.load_file(RELEASE_REPOS_CONFIG).fetch("apps", {})
  qa_envs = YAML.load_file(QA_ENVIRONMENTS_CONFIG).fetch("qa_environments", {})
  release_apps.keys.each_with_object([]) do |slug, apps|
    repo = File.join(PROJECTS_DIR, slug)
    next unless Dir.exist?(repo)

    qa = qa_envs.fetch(slug, {})
    apps << {
      "slug" => slug,
      "display_name" => qa.fetch("display_name", slug.split("-").map(&:capitalize).join(" ")),
      "repo" => repo,
      "status" => "release-managed"
    }
  end
rescue StandardError
  []
end

def known_apps(registry)
  apps = registry.fetch("apps", []).each_with_object({}) do |app, index|
    index[app.fetch("slug")] = app
  end
  release_managed_apps.each { |app| apps[app.fetch("slug")] ||= app }
  apps.values
end

def selected_apps(registry)
  apps = known_apps(registry)
  return apps unless OPTIONS[:apps]

  selected = OPTIONS[:apps]
  apps.select { |app| selected.include?(app.fetch("slug")) }
end

def selected_worktrees(registry, apps)
  app_slugs = apps.map { |app| app.fetch("slug") }
  registry.fetch("worktrees", []).select { |worktree| app_slugs.include?(worktree.fetch("app")) }
end

# The integration base is resolved by bin/agent-worktree (`origin/release` once a
# repo has run `bin/release init`, else `origin/main`) and carried per-worktree in
# the registry as `base_ref`. The registry's *_origin_main keys are historical
# names that now measure against that resolved base; read `base_ref` to know which
# base a worktree's ahead/behind/merged numbers and "behind <base>" issue reflect.
BEHIND_BASE_ISSUE = %r{behind origin/(?:main|release)}

def base_ref_for(worktree)
  value = worktree["base_ref"].to_s
  value.empty? ? "origin/main" : value
end

def truthy?(value)
  value == true || value.to_s == "true"
end

def zeroish?(value)
  %w[0 ?].include?(value.to_s)
end

# `ignore_staleness:` drops the "behind base" signal (the behind-count gate and the
# BEHIND_BASE_ISSUE blocker) when GitHub already calls the PR a clean merge — a
# behind-but-clean branch fast-forwards, so staleness is not a readiness blocker.
def worktree_ready_for_avi?(worktree, ignore_staleness: false)
  blockers = blocking_issues(worktree)
  blockers = blockers.reject { |issue| issue.match?(BEHIND_BASE_ISSUE) } if ignore_staleness

  !truthy?(worktree["dirty"]) &&
    !truthy?(worktree["merged_to_origin_main"]) &&
    !truthy?(worktree["cleanup_candidate"]) &&
    worktree["ahead_origin_main"].to_s != "0" &&
    (ignore_staleness || zeroish?(worktree["behind_origin_main"])) &&
    blockers.empty?
end

# The structured verdict written by bin/agent-worktree's reclaim guard
# (stack_record_snapshot): the reason a git-eligible desk was withheld from reclaim —
# a live builder claim, or a bound task whose board record could not be read — or nil
# when the desk is free. Only a non-blank String counts: a registry written by
# pre-guard code has no key at all, so this returns nil and every occupied-desk path
# no-ops, meaning the merge order between the guard and this consumer cannot break
# intake. The verdict is read from this field, never inferred from issue prose — a
# substring match on the doctor text once inverted a negation on this very path.
def withheld_reason_for(worktree)
  reason = worktree["withheld_reason"]
  return nil unless reason.is_a?(String)

  stripped = reason.strip
  stripped.empty? ? nil : stripped
end

def worktree_occupied?(worktree)
  !withheld_reason_for(worktree).nil?
end

def worktree_needs_attention?(worktree)
  return false if truthy?(worktree["cleanup_candidate"])
  # Occupied desks get their own bucket. The generic attention action ("inspect
  # listed issues and assign back to the owning agent") invites the conductor to act
  # on a desk whose only correct action is to leave it alone.
  return false if worktree_occupied?(worktree)

  truthy?(worktree["dirty"]) ||
    !zeroish?(worktree["behind_origin_main"]) ||
    Array(worktree["issues"]).any?
end

def blocking_issues(worktree)
  Array(worktree["issues"]).select do |issue|
    issue.match?(/dirty worktree/) ||
      issue.match?(BEHIND_BASE_ISSUE) ||
      issue.match?(/missing \.env\.agent-stack/) ||
      issue.match?(/missing APP_PORT/) ||
      issue.match?(/missing REDIS_URL/) ||
      issue.match?(/Redis DB/) ||
      issue.match?(/LOCAL_EMAIL_CAPTURE/) ||
      issue.match?(/API_KEY|SMTP/) ||
      issue.match?(/port .* listens but \/up/)
  end
end

# GitHub reports the PR is safe to merge as-is: mergeable, no conflicts, CI not
# failing. mergeStateStatus CLEAN/HAS_HOOKS both mean "mergeable and passing commit
# status", so a behind-but-clean branch still fast-forward merges. Note GitHub's own
# BEHIND state (head out of date under up-to-date branch protection) is deliberately
# excluded — there the rebase is genuinely required, so it must stay a blocker.
def pr_clean_merge?(pr)
  return false unless %w[CLEAN HAS_HOOKS].include?(pr["mergeStateStatus"].to_s)
  return false if pr["mergeable"].to_s == "CONFLICTING"

  true
end

def status_label_for_pr(pr, worktree)
  return "missing-local-branch" unless worktree

  clean_merge = pr_clean_merge?(pr)
  # When GitHub already calls the merge clean+green, pure "behind base" staleness is
  # a no-op fast-forward, not a return-to-agent blocker. Drop only that contradiction;
  # every other blocker (conflicts, dirty/down local state, missing env) is preserved.
  blockers = blocking_issues(worktree)
  blockers = blockers.reject { |issue| issue.match?(BEHIND_BASE_ISSUE) } if clean_merge
  return "needs-agent" if blockers.any?

  return "merge-risk" if %w[DIRTY BLOCKED UNKNOWN].include?(pr["mergeStateStatus"].to_s)
  return "checks-review" if pr["mergeStateStatus"].to_s == "UNSTABLE"
  return "avi-ready-draft" if pr["isDraft"]
  return "avi-ready" if worktree_ready_for_avi?(worktree, ignore_staleness: clean_merge)

  "review"
end

def pr_notes(pr, worktree)
  notes = []
  notes << "draft" if pr["isDraft"]
  notes << "review=#{pr["reviewDecision"]}" if pr["reviewDecision"].to_s != ""
  notes << "merge=#{pr["mergeStateStatus"]}" if pr["mergeStateStatus"].to_s != ""

  if worktree
    notes << "local=#{worktree["health"]}"
    notes << "+#{worktree["ahead_origin_main"]}/-#{worktree["behind_origin_main"]}"
    notes.concat(pr_issue_notes(pr, worktree))
  else
    notes << "no matching local worktree"
  end

  notes
end

# Worktree issues as they should read in the PR queue. When GitHub already calls the
# PR a clean merge, rewrite pure "behind base" staleness as an informational note
# ("no action needed") instead of surfacing it as a blocker-shaped issue.
def pr_issue_notes(pr, worktree)
  clean_merge = pr_clean_merge?(pr)
  Array(worktree["issues"]).map do |issue|
    next issue unless clean_merge && issue.match?(BEHIND_BASE_ISSUE)

    core = issue.split(";").first.strip
    "info: #{core} (clean merge, no action needed)"
  end
end

def pr_action(status, pr, worktree)
  case status
  when "missing-local-branch"
    "recreate a local worktree for `#{pr.fetch("branch", pr["headRefName"])}` or ask the branch owner to rebase; do not merge blind"
  when "needs-agent"
    "return to the feature agent to resolve local blockers before Avi review"
  when "merge-risk"
    "rebase or repair the branch until GitHub reports a clean merge state"
  when "checks-review"
    "inspect checks/merge state and wait for green or an explicit conductor override"
  when "avi-ready-draft"
    "confirm owner intent, mark ready for review, then Avi can review"
  when "avi-ready"
    "Avi can review for scope, tests, and merge safety"
  else
    if worktree_ready_for_avi?(worktree)
      "Avi can review, but inspect notes because this did not hit the fast-path label"
    else
      "inspect notes and decide whether this belongs with the feature agent, Avi, or Steffon"
    end
  end
end

def local_action(worktree)
  if truthy?(worktree["cleanup_candidate"])
    cleanup_action(worktree)
  elsif worktree_ready_for_avi?(worktree)
    "open a draft PR with `bin/agent-worktree finish #{worktree.fetch("app")} #{worktree.fetch("task")} --push --pr`"
  elsif truthy?(worktree["dirty"])
    "commit, stash, or intentionally discard local edits before QA handoff"
  elsif !zeroish?(worktree["behind_origin_main"])
    "rebase on `#{base_ref_for(worktree)}`, resolve conflicts, test, and force-push with lease if already pushed"
  elsif Array(worktree["issues"]).any?
    "resolve listed lifecycle issues, then rerun `bin/qa-intake --refresh`"
  else
    "inspect manually; branch is ahead but did not satisfy QA readiness rules"
  end
end

def attention_action(worktree)
  base = base_ref_for(worktree)
  issues = Array(worktree["issues"]).join("; ")
  return "run cleanup workflow after approval; branch is already contained in `#{base}`" if issues.include?("cleanup candidate")
  return "remove stale pidfiles or restart the stack with `bin/agent-worktree up #{worktree.fetch("app")} #{worktree.fetch("task")}`" if issues.include?("stale")
  return "rebase this worktree on `#{base}` before QA handoff" if issues.match?(BEHIND_BASE_ISSUE)
  return "commit or intentionally clear uncommitted changes" if issues.include?("dirty worktree")
  return "fix stack env/database/port health, then rerun intake" if issues.match?(/missing|database|port|Redis|LOCAL_EMAIL_CAPTURE/)

  "inspect listed issues and assign back to the owning agent"
end

def cleanup_action(worktree)
  "remove after approval with `bin/agent-worktree remove #{worktree.fetch("app")} #{worktree.fetch("task")} --yes`; the command ledgers, stops, removes, deletes the local branch, and refreshes the registry"
end

# The occupied desk's one correct treatment, whichever withhold case applies: leave it
# alone. The registry's reason is quoted verbatim rather than paraphrased — "a builder
# is on this desk" is true for a live claim but would misstate the unreadable-board
# withhold, the naming trap the guard's field shape (a reason string, not a
# `withheld_by_live_claim` boolean) exists to avoid.
def occupied_action(worktree)
  "occupied — #{withheld_reason_for(worktree)}; leave this desk alone"
end

def build_intake(registry, prs, apps, worktrees, warnings)
  by_app_branch = worktrees.each_with_object({}) do |worktree, index|
    index[[worktree.fetch("app"), worktree.fetch("branch")]] = worktree
  end

  prs_by_app_branch = prs.each_with_object({}) do |pr, index|
    index[[pr.fetch("app"), pr.fetch("headRefName")]] = pr
  end

  pr_queue = prs.sort_by { |pr| [pr.fetch("app"), pr.fetch("number")] }.map do |pr|
    worktree = by_app_branch[[pr.fetch("app"), pr.fetch("headRefName")]]
    status = status_label_for_pr(pr, worktree)
    {
      "status" => status,
      "app" => pr.fetch("app"),
      "repo" => pr.fetch("repo"),
      "number" => pr.fetch("number"),
      "title" => pr.fetch("title"),
      "url" => pr.fetch("url"),
      "draft" => pr["isDraft"],
      "branch" => pr.fetch("headRefName"),
      "base" => pr.fetch("baseRefName"),
      "updated_at" => pr.fetch("updatedAt"),
      "task_record_slug" => worktree&.fetch("task_record_slug", nil),
      "task_url" => worktree&.fetch("task_url", nil),
      "local_worktree" => worktree&.fetch("worktree"),
      "notes" => pr_notes(pr, worktree),
      "action" => pr_action(status, pr, worktree)
    }
  end

  local_without_pr = worktrees.select do |worktree|
    next false if %w[main master].include?(worktree.fetch("branch").to_s)
    next false if truthy?(worktree["merged_to_origin_main"])
    next false if truthy?(worktree["cleanup_candidate"])
    next false if worktree["ahead_origin_main"].to_s == "0"

    !prs_by_app_branch.key?([worktree.fetch("app"), worktree.fetch("branch")])
  end.sort_by { |worktree| [worktree.fetch("app"), worktree.fetch("task")] }
    .map { |worktree| worktree.merge("action" => local_action(worktree)) }

  # Withheld desks (a live builder claim, or a claim the board could not verify) are
  # labeled occupied and split out of attention — worktree_needs_attention? excludes
  # them — so the conductor reads "leave this desk alone", never the generic "inspect
  # listed issues and assign back to the owning agent". Registries written by
  # pre-guard code carry no withheld_reason, so this bucket is simply empty there.
  occupied = worktrees.select { |worktree| worktree_occupied?(worktree) }
                      .sort_by { |worktree| [worktree.fetch("app"), worktree.fetch("task")] }
                      .map { |worktree| worktree.merge("status" => "occupied", "action" => occupied_action(worktree)) }

  attention = worktrees.select { |worktree| worktree_needs_attention?(worktree) }
                       .sort_by { |worktree| [worktree.fetch("app"), worktree.fetch("task")] }
                       .map { |worktree| worktree.merge("action" => attention_action(worktree)) }

  cleanup = worktrees.select { |worktree| truthy?(worktree["cleanup_candidate"]) }
                     .sort_by { |worktree| [worktree.fetch("app"), worktree.fetch("task")] }
                     .map { |worktree| worktree.merge("action" => cleanup_action(worktree)) }

  {
    "generated_at" => Time.now.utc.iso8601,
    "registry_path" => OPTIONS[:registry],
    "registry_generated_at" => registry["generated_at"],
    "summary" => {
      "apps" => apps.size,
      "open_prs" => pr_queue.size,
      "local_branches_without_pr" => local_without_pr.size,
      "attention_items" => attention.size,
      "occupied_desks" => occupied.size,
      "cleanup_candidates" => cleanup.size,
      "registry" => registry["summary"]
    },
    "prs" => pr_queue,
    "local_branches_without_pr" => local_without_pr,
    "attention" => attention,
    "occupied" => occupied,
    "cleanup_candidates" => cleanup,
    "warnings" => warnings
  }
end

def print_section(title)
  puts
  puts "#{title}"
  puts "-" * title.length
end

def print_pr_queue(prs)
  print_section("PR Queue")
  if prs.empty?
    puts "No open PRs found or GitHub lookup unavailable."
    return
  end

  prs.each do |pr|
    puts "[#{pr.fetch("status")}] #{pr.fetch("app")} ##{pr.fetch("number")} #{pr.fetch("title")}"
    puts "  #{pr.fetch("url")}"
    puts "  task=#{pr["task_url"] || pr["task_record_slug"] || "not bound"}"
    puts "  branch=#{pr.fetch("branch")} base=#{pr.fetch("base")} local=#{pr["local_worktree"] || "none"}"
    puts "  notes: #{pr.fetch("notes").join("; ")}"
    puts "  action: #{pr.fetch("action")}"
  end
end

def print_local_without_pr(worktrees)
  print_section("Local Branches Without PR")
  if worktrees.empty?
    puts "No local ahead branches without a matching open PR."
    return
  end

  worktrees.each do |worktree|
    readiness = worktree_ready_for_avi?(worktree) ? "ready-to-open-pr" : "needs-agent"
    puts "[#{readiness}] #{worktree.fetch("label")} #{worktree.fetch("branch")} +#{worktree["ahead_origin_main"]}/-#{worktree["behind_origin_main"]}"
    puts "  #{worktree["compare_url"] || "no compare URL"}"
    puts "  local: #{worktree["local_url"] || "none"}  inbox: #{worktree["local_inbox_url"] || "none"}"
    issues = Array(worktree["issues"])
    puts "  issues: #{issues.empty? ? "none" : issues.join("; ")}"
    puts "  action: #{worktree.fetch("action") { local_action(worktree) }}"
  end
end

def print_attention(worktrees)
  print_section("Worktree Attention")
  if worktrees.empty?
    puts "No dirty, stale, behind, missing-env, or unhealthy worktrees in scope."
    return
  end

  worktrees.each do |worktree|
    puts "#{worktree.fetch("label")} #{worktree.fetch("health")} #{worktree.fetch("branch")} +#{worktree["ahead_origin_main"]}/-#{worktree["behind_origin_main"]}"
    puts "  path: #{worktree.fetch("worktree")}"
    puts "  issues: #{Array(worktree["issues"]).join("; ")}"
    puts "  action: #{worktree.fetch("action") { attention_action(worktree) }}"
  end
end

# Printed only when a desk is occupied: a registry written by pre-guard code (no
# withheld_reason field) must produce the pre-feature output shape, and an empty
# section would be noise in the common all-free case.
def print_occupied(worktrees)
  return if worktrees.empty?

  print_section("Occupied Desks")
  worktrees.each do |worktree|
    puts "[occupied] #{worktree.fetch("label")} #{worktree.fetch("branch")}"
    puts "  path: #{worktree.fetch("worktree")}"
    puts "  reason: #{withheld_reason_for(worktree)}"
    puts "  action: #{worktree.fetch("action") { occupied_action(worktree) }}"
  end
end

def print_cleanup(worktrees)
  print_section("Cleanup Candidates")
  if worktrees.empty?
    puts "No clean merged or base-equivalent worktrees in scope."
    return
  end

  worktrees.each do |worktree|
    puts "#{worktree.fetch("label")} #{worktree.fetch("worktree")}"
    puts "  branch=#{worktree.fetch("branch")} head=#{worktree.fetch("head")}"
    puts "  action: #{worktree.fetch("action") { cleanup_action(worktree) }}"
  end
  puts
  puts "Removal remains approval-gated. Use bin/agent-worktree remove <app> <task> --yes only after approval."
end

def parse_options!
  OptionParser.new do |opts|
    opts.banner = <<~TEXT
      Usage: bin/qa-intake [options]

      Builds an Avi-ready intake queue from local worktree state and open GitHub PRs.

      Options:
    TEXT

    opts.on("--refresh", "Refresh the local registry before reading it") { OPTIONS[:refresh] = true }
    opts.on("--registry PATH", "Read/write this registry path") { |path| OPTIONS[:registry] = File.expand_path(path) }
    opts.on("--apps LIST", "Comma-separated app slugs to include") { |value| OPTIONS[:apps] = value.split(",").map(&:strip).reject(&:empty?) }
    opts.on("--no-gh", "Skip GitHub PR lookup and use local registry only") { OPTIONS[:gh] = false }
    opts.on("--json", "Print machine-readable intake JSON") { OPTIONS[:json] = true }
    opts.on("-h", "--help", "Show this help") do
      puts opts
      exit 0
    end
  end.parse!
end

def run!
  parse_options!

  warnings = []
  refresh_registry(OPTIONS[:registry], warnings) if OPTIONS[:refresh]
  registry = read_registry(OPTIONS[:registry])
  apps = selected_apps(registry)
  worktrees = selected_worktrees(registry, apps)
  prs = fetch_open_prs(apps, warnings)
  intake = build_intake(registry, prs, apps, worktrees, warnings)

  if OPTIONS[:json]
    puts JSON.pretty_generate(intake)
    return
  end

  puts "QA Intake Queue"
  puts "Generated: #{intake.fetch("generated_at")}"
  puts "Registry:  #{intake.fetch("registry_path")}"
  puts "Snapshot:  #{intake["registry_generated_at"] || "unknown"}"
  puts
  puts "Summary: #{intake.fetch("summary").reject { |key, _| key == "registry" }.map { |key, value| "#{key}=#{value}" }.join("  ")}"

  print_pr_queue(intake.fetch("prs"))
  print_local_without_pr(intake.fetch("local_branches_without_pr"))
  print_attention(intake.fetch("attention"))
  print_occupied(intake.fetch("occupied"))
  print_cleanup(intake.fetch("cleanup_candidates"))

  return unless intake.fetch("warnings").any?

  print_section("Warnings")
  intake.fetch("warnings").each { |warning| puts "- #{warning}" }
end

run! if $PROGRAM_NAME == __FILE__
