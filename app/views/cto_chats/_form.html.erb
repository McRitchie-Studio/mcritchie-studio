<%# locals: (app:, cto:, error:, text:) %>
<%# The chat's composer. A fresh client id per render makes a double submit store one message (AgentMessages::WebIngest). Enter sends; Shift+Enter is a new line (app/javascript/cto_chat.js). %>
<%= form_with scope: :cto_chat, url: chat_application_path(app.slug), id: "cto-chat-form",
              class: "border-t border-subtle p-3 flex flex-col gap-2", data: { test: "cto-chat-form", cto_chat_form: true } do |f| %>
  <%= f.hidden_field :client_id, value: SecureRandom.uuid %>
  <% if error %>
    <p class="text-xs text-danger-ink" role="alert" data-test="cto-chat-error"><%= error %></p>
  <% end %>
  <div class="flex items-end gap-2">
    <%= f.label :text, "Message #{cto.display_name}", class: "sr-only" %>
    <%= f.text_area :text, value: text, rows: 2, maxlength: AgentMessages::WebIngest::MAX_LENGTH, required: true,
                    placeholder: "Message #{cto.display_name}…", autocomplete: "off",
                    class: "input-field flex-1 min-w-0 resize-none text-sm", data: { test: "cto-chat-input" } %>
    <%= f.submit "Send", class: "btn btn-primary btn-sm shrink-0", data: { test: "cto-chat-send", turbo_submits_with: "Sending…" } %>
  </div>
<% end %>
