# The desk's git identity: the soul `bin/ship` authors from, stamped into the desk
# (turf-monster-git-identity-wrong). See reconcile_desk_identity below.
require_relative "../lib/commit_identity"
require_relative "lib/stamp_confirmation"
require_relative "lib/approval_request_notice"

# THE ABSOLUTE `bin/task` A REFUSAL HANDS BACK — this very script, resolved from its
# OWN __dir__. A RE-RUN remedy names the script for the tree the reader is ALREADY
# standing in, so it passes one directory and carries no `cd`; FastLane.remedy_command
# holds the full policy, including why the form is unconditionally absolute even on a
# hub desk. The bare `bin/task` this replaced resolves ONLY from a hub desk — bin/task
# lives in mcritchie-studio/bin alone, so a builder on a turf-monster, rolio or gem
# desk reached this script through its ABSOLUTE path and could not run the bare form
# back. Pinned by test/lib/remedy_hint_guard_test.rb, which keys on the FILESYSTEM
# (File.executable?) rather than on what the line says, because an absolute path
# CONTAINS the bare form and a substring assertion is blind to this defect.
#
# USAGE BANNERS DELIBERATELY DO NOT USE THIS. A banner is a synopsis of the grammar the
# reader JUST TYPED, not a command handed over to run, so it echoes the invocation with
# $PROGRAM_NAME: absolute when they reached this script absolutely, bare when they typed
# the bare form, and never a 90-character path in front of every flag list.
SELF_CMD = FastLane.remedy_command("task", __dir__).freeze
# The self-service credential fix every lane is told to run itself. Same reasoning,
# and bin/ship has carried the routed form since wave 1 (GH_AUTH_REFRESH_CMD there).
GH_AUTH_REFRESH_CMD = FastLane.remedy_command("gh-auth-refresh", __dir__).freeze

BASE_URL = ENV.fetch("TASK_API_BASE", "https://mcritchie.studio")
SHINY_EMOJI = "✨"

# Honors CLAUDE_PROJECTS_DIR (as bin/statusline does) so a session and its status
# line agree on the marker location — and so tests can isolate it; defaults to the
# projects root even when this script runs from an isolated worktree.
PROJECTS_DIR = (dir = ENV["CLAUDE_PROJECTS_DIR"].to_s.strip).empty? ? ProjectsRoot.default_projects_dir : File.expand_path(dir)

# Per-session active-feature marker path, keyed by Claude/Codex session id so each
# session shows its OWN feature (no cross-session leak). nil when there's no
# agent session id.
def feature_marker_path
  sid = session_identity.first.to_s.strip
  return nil if sid.empty?

  File.join(PROJECTS_DIR, ".agents", "sessions", "#{sid.gsub(/[^A-Za-z0-9._-]/, "")}.json")
end

# READ-ONLY audit of the cost store. A METHOD, not four inline lines in the dispatch
# `case` below, because test/lib/state_store_containment_test.rb forbids top-level
# script code from reaching a raw <projects>/.agents path at all: every store path must
# live in a named method, where the containment scan can see it and where it must be
# either laundered or declared (this one is declared — TaskUsageAudit.report only reads).
# An inline store path in a 1,200-line `case` is exactly where the next unguarded write
# goes unnoticed, which is the bug that PR #549's review found in bin/atomic-event.
def usage_audit!(dir)
  text, suspects = TaskUsageAudit.report(dir || File.join(PROJECTS_DIR, ".agents", "task-usage"))
  print(text)
  exit(suspects.zero? ? 0 : 2)
end

# The agent session working this task — stamped on create + on the move to
# `building` (the claim moment) so the board + status line can show which
# terminal owns a task and offer a click-to-copy resume command. Claude exposes
# CLAUDE_CODE_SESSION_ID; Codex exposes CODEX_THREAD_ID. Returns [id, provider],
# or [nil, nil] for a plain shell / CI run (stamp nothing — graceful).
def session_identity
  SessionIdentity.identity
end

def parent_session_identity
  %w[
    MCRITCHIE_PARENT_SESSION_ID
    AGENT_PARENT_SESSION_ID
    CODEX_PARENT_THREAD_ID
    CLAUDE_PARENT_SESSION_ID
  ].each do |key|
    value = ENV[key].to_s.strip
    return value unless value.empty?
  end

  nil
end

# Merge the captured session id/provider into a devops hash. No-op (returns the
# input) when there's no session, so non-Claude/CI runs stamp nothing.
def stamp_session(devops)
  id, provider = session_identity
  return devops if id.nil?

  merged = (devops || {}).dup
  merged["session_id"] = id
  merged["session_provider"] = provider
  merged
end

def titleize_marker_name(value)
  raw = value.to_s.tr("-", " ").strip
  return "" if raw.empty?

  raw[0].upcase + raw[1..].to_s
end

def truthy_marker_value?(value)
  value == true || %w[true 1 yes on].include?(value.to_s.strip.downcase)
end

def shiny_marker_state(value)
  return true if truthy_marker_value?(value)
  return false if value == false || %w[false 0 no off].include?(value.to_s.strip.downcase)

  nil
end

def marker_display_emoji(marker)
  emoji = marker["mascot_emoji"].to_s.strip
  state = shiny_marker_state(marker["mascot_shiny"])
  shiny = state.nil? ? emoji.include?(SHINY_EMOJI) : state
  if state == false
    base = emoji.delete(SHINY_EMOJI)
    return base.empty? ? nil : base
  end
  return emoji unless shiny

  base = emoji.delete(SHINY_EMOJI)
  base.empty? ? SHINY_EMOJI : "#{base}#{SHINY_EMOJI}"
end

def print_session_marker(marker)
  mascot = titleize_marker_name(marker["mascot"])
  head = [marker_display_emoji(marker), mascot].map(&:to_s).map(&:strip).reject(&:empty?).join(" ").strip
  parts = [head, marker["app"], marker["worktree_slug"] || marker["feature"]].map(&:to_s).map(&:strip).reject(&:empty?)
  puts parts.join(" · ")
end

# The narration CLI (fast-lane-narrates-activities): `begin` opens the session's
# ORIENT activity through this so the default fast-lane path leaves a
# task-attributed trail instead of stranding orientation in the Unlabeled bucket.
# Overridable for tests.
ACTIVITY_BIN = ENV.fetch("TASK_ACTIVITY_BIN", File.expand_path("agent-activity", __dir__))

# Fire one bin/agent-activity subcommand, best-effort — narration is NON-FATAL by
# contract and must NEVER fail a board op. No session identity → skip (nothing to
# attribute to), mirroring the claim/plain-shell degrade. Output is discarded so
# narration never clutters the CLI.
def narrate(*args)
  return if session_identity.first.nil?

  system(ACTIVITY_BIN, *args, out: File::NULL, err: File::NULL)
rescue StandardError
  nil
end

# THE BUILD-CLAIM GATE: THE DESK IS THE CLAIM (bin/lib/desk_claim.rb). There is no
# lease to take or renew. It REFUSES — exit 1, before any write — in exactly one
# case: a DIFFERENT live session's desk is bound to this task AND that desk has
# uncommitted changes, which is the one case where claiming can lose work. The
# refusal names the desk. `--steal` is the override for that case; it prints the
# desks it is claiming over and proceeds. Every other case claims freely.
#
# test/commands/task_claim_gate_test.rb pins the refusal by asserting the gate
# sends NO PATCH on the refused path, and reads the exit code out of THIS function.
def enforce_claim_gate!(slug, mover_session, steal:, steal_hint: nil)
  blockers = DeskClaim.blocking_on_disk(slug, session: mover_session, projects_dir: PROJECTS_DIR)
  return if blockers.empty?

  if steal
    DeskClaim.steal_notice(slug, blockers).each { |line| warn!(line) }
    return
  end

  takeover = steal_hint || "#{ClaimHolder::TASK_COMMAND} move #{slug} building --steal"
  warn!(DeskClaim.refusal(slug, blockers, steal_command: takeover,
                                        retry_command: takeover.sub(" --steal", "")).join("\n"))
  exit 1
end

# The desks bound to `slug` on this machine, for `show`. Never raises: a read that
# failed says so instead of passing for "no desk".
def desk_claim_summary(slug)
  desks = DeskContext.holders_of(slug, desks: DeskContext.desks(root: PROJECTS_DIR, table: ProcessTable.process_table))
  return "none on this machine" if desks.empty?

  desks.map { |d| "#{DeskClaim.path(d)} · #{d[:grade].to_s.upcase} · session #{DeskClaim.short_session(d)}" }.join("; ")
rescue StandardError => e
  "unreadable (#{e.class})"
end

# --- the ARCHIVE holder gate ---------------------------------------------------
#
# `archived` is TERMINAL, and what it destroys is UNCOMMITTED work no gate, review,
# or CI would ever surface. So this path REFUSES what it cannot prove is free and
# NAMES what it could not verify, rather than proceeding on a guess — the posture
# bin/lib/cert_orphan_guard.rb already applies to the far less destructive act of
# reaping a process. The decision table and every message live in
# lib/archive_holder_guard.rb; this function is only the I/O around them.
#
# It reads the task FRESH rather than trusting anything already in hand: the whole
# question is whether somebody is working RIGHT NOW, and a stale record answers a
# different one.
def enforce_archive_holder_gate!(slug, force:)
  task = api(:get, "/api/v1/tasks/#{slug}")["data"]
  devops = task.dig("metadata", "devops") || {}
  claim = ClaimLease.from_devops(devops)
  facts = archive_holder_facts(slug, task, devops, claim)

  grade = ArchiveHolderGuard.decide(
    stage: task["stage"], devops: devops,
    claim_live: facts[:claim_live], abandoned: facts[:abandoned]
  )
  return if ArchiveHolderGuard.permitted?(grade)

  # NAME WHAT IS BEING OVERRIDDEN. A --force that prints nothing turns the gate
  # into a speed bump nobody remembers clearing; the operator (or the next reader
  # of the log) must be able to see which proof was waived.
  if force
    warn!("--force: archiving #{slug} anyway — the holder gate graded it #{grade.to_s.upcase} " \
          "and could not prove the task free.")
    return
  end

  warn!(ArchiveHolderGuard.refusal(
          grade, slug: slug, stage: task["stage"], devops: devops, claim: claim,
          channel: ArchiveHolderGuard.working_channel(facts[:channels])
        ))
  exit 1
end

# The liveness facts the gate decides on. I/O only — ClaimLease owns the
# arithmetic, so the unit tier can drive every combination without a board or a
# filesystem.
#
# THE CHANNELS ARE THE THREE THAT ATTEST WORK AT RISK, and the board-progress
# channel this function used to gather is deliberately absent. Graded against the
# live board on 2026-09-02 it held 31 of 34 tasks — 16 of them with no desk at all —
# because Task#holder_liveness_seconds_ago degrades to the age of the task's own
# CREATE where no holder owns an artifact, and because every `bin/task` write resets
# it, so triaging a task armed this gate against archiving that same task. See
# lib/archive_holder_guard.rb, "WHY BOARD PROGRESS IS NOT A CHANNEL HERE".
#
# A CHECK THAT BLEW UP HAS TOLD US NOTHING, and nothing must never authorize a
# destructive act. So the rescue resolves to the PROTECTIVE direction — claim
# assumed live, not abandoned, desk unknown — and the resulting refusal says
# plainly that the check could not be completed: the unknown protects the holder.
# It assumes the claim is live rather than merely declining to free it.
def archive_holder_facts(slug, task, devops, claim)
  channels = {
    desk_touched: archive_desk_touched(devops),
    gate_in_flight: holder_scoped(task, "holder_gate_in_flight", "gate_in_flight") ? true : false,
    awaiting_approval: devops["approval_status"].to_s.strip == "waiting"
  }
  {
    claim_live: ClaimLease.live?(claim),
    abandoned: ArchiveHolderGuard.abandonable?(**channels),
    channels: channels
  }
rescue StandardError => e
  warn "warning: #{slug}: the holder check could not be completed (#{e.class}: #{e.message}) — withholding"
  { claim_live: true, abandoned: false, channels: { desk_touched: nil } }
end

# Has anyone written into this task's desk lately? true / false / nil.
#
# THE DESK IS ASKED WHERE THE TASK SAYS IT IS, never where we happen to be standing.
# An archive runs from the primary checkout, and
# DeskActivity.desk_root refuses any directory not bound to the task, so a cwd-based
# resolution here would answer nil every single time and the gate would refuse every
# archive on the machine. A guard that refuses everything gets switched off, and then
# it protects nothing.
#
# A task may name several repos, so every candidate desk is asked and the answers are
# folded PROTECTIVELY: any desk being worked in wins, then any desk we could not read,
# and only an all-quiet reading returns false.
def archive_desk_touched(devops)
  answers = archive_desk_dirs(devops).map do |dir|
    ArchiveHolderGuard.desk_touched_for(
      dir,
      exists: File.directory?(dir),
      reader: ->(root) { DeskActivity.touched_since?(root, Time.now - ClaimLease::DESK_IDLE_SECONDS) }
    )
  end
  # No desk recorded at all is a REAL answer, not an unknown: a task with no worktree
  # has no uncommitted work in one for an archive to destroy.
  return false if answers.empty?
  return true if answers.include?(true)

  answers.include?(nil) ? nil : false
end

def archive_desk_dirs(devops)
  worktree = devops["worktree_slug"].to_s.strip
  return [] if worktree.empty?

  Array(devops["repositories"]).map { |repo| repo.to_s.strip }.reject(&:empty?).map do |repo|
    File.join(PROJECTS_DIR, repo, ".worktrees", worktree)
  end
end

# --- the ARCHIVE open-PR gate --------------------------------------------------
#
# THE OTHER HALF OF THE ARCHIVE QUESTION. `enforce_archive_holder_gate!` above asks
# whether a live session's UNCOMMITTED work is at risk, and by design says nothing
# about durable artifacts. This one asks whether the archive would leave a PR OPEN
# and UNWATCHED — neither merged nor closed, with no board state describing it.
# Different harms, different evidence, and neither covered the other: on 2026-09-01
# `move-web3-modals-to-solana` was archived with studio-engine #245 still open, and
# it took a human backlog audit a month later to notice.
#
# Returns nil when there is nothing to record, or the FULL devops hash the caller
# must PATCH when `--force` abandoned open PRs. The decision table and every message
# live in lib/open_pr_guard.rb; this function is only the I/O around them.
#
# It reads the task FRESH for the same reason the holder gate does: the question is
# what is open RIGHT NOW, and a stale record answers a different one.
def enforce_archive_open_pr_gate!(slug, force:, by: nil)
  task = api(:get, "/api/v1/tasks/#{slug}")["data"]
  devops = task.dig("metadata", "devops") || {}
  prs = archive_pr_states(OpenPrGuard.refs(devops))
  grade = OpenPrGuard.decide(prs: prs, stage: task["stage"])
  # ONE dispatcher owns grade → message, so this function cannot drift into having
  # an opinion the guard's own completeness test never sees. nil means the grade
  # genuinely has nothing to say (:concluded, :none, :clear).
  message = OpenPrGuard.message_for(grade: grade, slug: slug, stage: task["stage"], prs: prs)

  # A check that did not complete has established NOTHING, and says so. It must not
  # borrow the refusal's voice — see "WHY AN UNREADABLE PR STATE WARNS" in the guard.
  # PERMITTED and SILENT are different questions: :unreadable proceeds AND speaks.
  if OpenPrGuard.permitted?(grade)
    warn!(message) if message
    return nil
  end

  unless force
    # A grade with NO message would exit 1 in silence, and a refusing gate that says
    # nothing is worse than no gate — the operator learns only that something went
    # wrong. OpenPrGuard's completeness property keeps this branch unreachable; it is
    # here so that if it ever is reached, it is survivable and names its own defect.
    warn!(message || "⚠  REFUSING to archive #{slug} — open-PR grade #{grade.inspect} carries no " \
                     "message. That is a defect in lib/open_pr_guard.rb#message_for, not a fact " \
                     "about your PRs. Check them yourself, then archive with --force.")
    exit 1
  end

  # NAME WHAT IS BEING OVERRIDDEN, then RECORD it. A --force that prints nothing
  # turns the gate into a speed bump nobody remembers clearing; a --force that
  # records nothing leaves a board state indistinguishable from the bug itself.
  #
  # THE ABANDONED SET IS WIDER THAN THE OPEN SET. One keystroke drops the open PRs
  # AND every sibling whose state could not be read, so both are named and both get
  # a receipt — see OpenPrGuard.abandoned_prs.
  abandoned = OpenPrGuard.abandoned_prs(prs)
  named = abandoned.map { |pr| "#{pr[:repo]}##{pr[:number]}" }.join(", ")
  unread = OpenPrGuard.unreadable_prs(prs).size
  aside = unread.zero? ? "" : " (#{unread} of them UNREADABLE — dropped by the same choice)"
  warn!("--force: archiving #{slug} anyway — ABANDONING #{abandoned.size} unresolved PR(s): " \
        "#{named}#{aside}. Recording the choice on the task so a later reader knows they were " \
        "dropped deliberately.")

  entries = OpenPrGuard.record(prs: prs, at: Time.now.utc.iso8601, by: by || session_identity.first)
  # SEND ONLY THE KEY THIS GATE OWNS, merged onto whatever the task already carried in
  # it. NOT a full read-merge-write echo of `devops`, which is what the `move building`
  # claim path does — and which would BREAK HERE.
  #
  # MEASURED 2026-09-02 against the live board: 156 of 1,586 tasks carry `block_kind` or
  # `release_train` INSIDE metadata.devops — legacy rows from before those names moved to
  # columns. Both are Task::DEVOPS_COLUMN_KEYS, and normalize_devops_metadata RAISES on a
  # non-blank one ("devops.block_kind is not writable"), which both controllers turn into
  # a 422. So echoing a task's stored devops back breaks on exactly that population.
  #
  # STATED PRECISELY, because the number alone overstates it: every one of those 156 is
  # ALREADY `archived`, and this gate returns :concluded for an archived task without
  # writing anything. So the 422 needs a REVIVAL first — and `archived` is not a lock; a
  # task an operator dropped has been un-archived and shipped since. The failure is
  # therefore narrow but real, and it would land at the worst possible moment: after an
  # operator deliberately chose to abandon a PR, destroying the receipt this path exists
  # to write. Not depending on that revival never happening is cheaper than the receipt.
  #
  # Sending one key is safe because the board MERGES a devops PATCH onto what is stored
  # (Task.merge_devops_into_metadata, shared by both controllers since
  # `api-devops-patch-replaces`) — verified live on this task, whose `kind`, `branch`,
  # `repositories` and `acceptance` all survived two partial `bin/task update` writes.
  { OpenPrGuard::RECORD_KEY => OpenPrGuard.merged_record(devops[OpenPrGuard::RECORD_KEY], entries) }
end

# Each ref enriched with its live PR state. I/O only — OpenPrGuard owns the
# vocabulary, so one notion of "is this PR open" serves both this gate and
# bin/devops-reconcile.
#
# EVERY FAILURE RESOLVES TO :unknown, never to a state. A `gh` that could not run,
# a non-zero exit, unparseable output, or a payload with no `state` are all facts we
# did not read — and reading an unread fact as "merged" is the direction that
# strands work silently.
def archive_pr_states(refs)
  refs.map { |ref| ref.merge(state: archive_pr_state(ref)) }
end

def archive_pr_state(ref)
  raw = IO.popen(["gh", "pr", "view", ref[:number], "--repo", ref[:repo], "--json", "state"],
                 err: File::NULL, &:read)
  return :unknown unless $?.success?

  OpenPrGuard.state_of(JSON.parse(raw.to_s)["state"])
rescue StandardError
  :unknown
end

# The abandonment record has to SURVIVE the write. `abandoned_prs` must be a
# storable name in Task::DEVOPS_LIST_KEYS; anything outside DEVOPS_KEYS is dropped
# by normalize_devops_metadata and the caller still gets a 200. That silent
# evaporation is exactly what `release_slug` cost and what `agent_slug` cost inside
# ArchiveHolderGuard::PAINT_KEYS, so this reads the record back and fails LOUDLY
# rather than reporting an override that recorded nothing.
#
# The archive has ALREADY LANDED by the time this runs — the stage move and the
# record ride one PATCH, so there is no ordering that could verify first. The honest
# response to a dropped record is therefore a loud non-zero telling the operator the
# archive stands and the receipt does not.
def verify_abandonment_recorded!(slug, expected)
  stored = Array(api(:get, "/api/v1/tasks/#{slug}")["data"].dig("metadata", "devops",
                                                               OpenPrGuard::RECORD_KEY)).map(&:to_s)
  missing = Array(expected).map(&:to_s) - stored
  return if missing.empty?

  die!("#{slug}: ARCHIVED, but devops.#{OpenPrGuard::RECORD_KEY} did not persist — the board " \
       "dropped #{missing.size} of #{Array(expected).size} entr(ies). The archive stands and the " \
       "receipt does not, so the abandoned PR now reads as forgotten rather than dropped on " \
       "purpose. Most likely this board predates #{OpenPrGuard::RECORD_KEY} in Task::DEVOPS_LIST_KEYS; " \
       "deploy it, then re-record: #{missing.join(" | ")}")
end

# --- the INVERSE ALARM: open PRs whose task is archived ---------------------------
#
# The gate above stops a NEW orphan. This finds the ones that already exist, and it
# is the reason an unreadable PR state is allowed to warn rather than refuse: every
# archive the gate lets through wrongly stays findable here.
#
# IT ASKS THE QUESTION FROM THE PR SIDE, which is what makes it cheap. Resolving one
# `gh pr view` per recorded PR would be hundreds of calls across the archived board;
# `gh pr list --state open` is ONE call per repo, and the repos are only those the
# archived tasks actually name. Seven repos, seven calls, however large the board.
def fetch_archived_tasks(per_page: 100, max_pages: 40)
  rows = []
  (1..max_pages).each do |page|
    batch = api(:get, "/api/v1/tasks?stage=archived&per_page=#{per_page}&page=#{page}")["data"] || []
    rows.concat(batch)
    return rows if batch.size < per_page
  end
  # Hitting the cap means the scan is TRUNCATED, and a truncated scan that prints
  # "nothing found" is the false all-clear this alarm exists to remove.
  warn "warning: stopped after #{max_pages} pages (#{rows.size} tasks) — results may be incomplete"
  rows
end

# Every OPEN PR number in one repo, or nil when the listing could not be read. nil is
# NOT an empty list: an empty list means "this repo has no open PRs", and reporting a
# failed read as a clean one is how an alarm goes quiet while the thing it watches
# for is still there.
def gh_open_pr_numbers(repo)
  raw = IO.popen(["gh", "pr", "list", "--repo", repo, "--state", "open",
                  "--limit", "200", "--json", "number"], err: File::NULL, &:read)
  return nil unless $?.success?

  JSON.parse(raw.to_s).map { |row| row["number"].to_s }
rescue StandardError
  nil
end

# { "owner/repo#number" => {slug:, url:, repo:, number:, deliberate:} } for every PR
# named by an archived task. `deliberate` reads the abandonment receipt --force
# writes, so a PR an operator DROPPED ON PURPOSE is reported differently from one
# that was simply forgotten — which is the entire point of recording it.
def archived_pr_index(tasks)
  tasks.each_with_object({}) do |task, index|
    devops = task.dig("metadata", "devops") || {}
    recorded = Array(devops[OpenPrGuard::RECORD_KEY]).map(&:to_s)
    OpenPrGuard.refs(devops).each do |ref|
      key = "#{ref[:repo]}##{ref[:number]}"
      # ANCHORED, never `entry.include?(ref[:url])` — a receipt for .../pull/245
      # CONTAINS .../pull/24, and reading that as "abandoned on purpose" silences
      # this alarm about a real orphan. OpenPrGuard owns the comparison so the
      # receipt's writer and its reader cannot drift apart.
      index[key] ||= ref.merge(slug: task["slug"],
                               deliberate: OpenPrGuard.abandonment_recorded?(recorded, ref[:url]))
    end
  end
end

# A holder-scoped liveness fact, falling back to its task-wide twin when the board
# does not publish one — see ClaimLease.holder_scoped for why the fallback is the
# conservative direction. It lives in the shared module because bin/agent-worktree's
# reclaim guard asks the same question of the same payload about a DIRECTORY, and
# two spellings of "is the holder working" is how those two answers drift apart.
def holder_scoped(task, holder_key, task_wide_key)
  ClaimLease.holder_scoped(task, holder_key, task_wide_key)
end

SCALAR_FLAGS = {
  "--kind" => "kind", "--shape" => "shape", "--worktree-slug" => "worktree_slug",
  "--branch" => "branch", "--pr-url" => "pr_url",
  "--local-url" => "local_url", "--qa-url" => "qa_url", "--prod-url" => "production_url",
  # NO --release-slug / --release-train, deliberately. `release_slug` was the
  # ecosystem's one name that existed in BOTH stores at once: a top-level Task
  # column AND a devops key, disjoint. These flags wrote the devops key, which no
  # release code ever read — the sweep writes the column (Release#record_members)
  # and bin/conductor reads the column — so the flag could not reach the field the
  # release lane uses, while the value it did write rendered on the task page.
  # Retired rather than re-pointed: release membership is a fact the sweep
  # establishes when a PR lands on the release branch, not an intention anyone
  # types. Nothing sets it by hand, so no flag is the correct surface.
  # Read it with `bin/task field <slug> release_slug` or `show --verbose`; the
  # server refuses a devops write (Task::DEVOPS_COLUMN_KEYS).
  "--agent-context" => "agent_context", "--post-deploy-cmd" => "post_deploy_cmd",
  # The gem bump OVERRIDE. Never required: bin/release computes the version from the
  # candidate's members (Release::GemVersion). Set it only when the derived bump is
  # wrong — most often a `chore` that is actually breaking.
  "--gem-bump" => "gem_bump",
  "--approval" => "approval_status", "--approval-status" => "approval_status",
  # "act as <soul>": the status-line mascot becomes that agent (name + glyph + tint)
  # in place of the session's Pokémon. The server stamps the identity (Task#sync_
  # persona_identity); a new task without --persona reverts to the Pokémon. Distinct
  # from --agent, which sets the task OWNER (agent_slug).
  "--persona" => "persona"
}.freeze
LIST_FLAGS = { "--repo" => "repositories", "--risk" => "risk_tags", "--accept" => "acceptance", "--test" => "test_plan", "--checks" => "checks_run" }.freeze
# The LIST_FLAGS whose values are IDENTIFIERS rather than prose, and which
# therefore REFUSE a comma. Read the per-flag reasoning before adding a sixth:
# this set is deliberately smaller than LIST_FLAGS, and growing it wrongly is a
# worse defect than the one it fixes.
#
# THE DEFECT. Every LIST_FLAG is repeatable (`--repo a --repo b`), so `--repo a,b`
# is user error. The defect was that it was accepted SILENTLY, storing a
# one-element array holding the joined string — and producing a record that reads
# correctly everywhere except where it matters. `bin/task show` prints
# `repos: a,b` for the joined entry and for the correct pair alike, so nothing at
# create time, and nothing on the board, can tell them apart.
#
# WHERE IT SURFACES, measured 2026-09-15 across the production board (2066 tasks):
#   repositories  the LOUD reader, and the one that cost a sweep. Release::
#                 Conductor resolves each entry to a repo, finds a phantom with no
#                 PR, and refuses at step 3a — the guard added after the
#                 2026-08-13 half-ship. It ABORTED a live QA release sweep on
#                 /tasks/sweep-stale-signer-claims: nothing promoted, recorded or
#                 deployed, repaired by hand and re-run. A SECOND instance was
#                 typed the same night, by the operator who had just watched the
#                 first one abort. The failure mode does not teach, because the
#                 record looks right — which is the whole argument for a guard.
#   risk_tags     the SILENT readers, and 1117 tasks already carry a joined entry.
#                 Release::BuilderPolicy intersects the tags with auto_qa's
#                 blocked_risk_tags and ReviewerSelector looks each tag up in
#                 RISK_DOMAINS: BOTH match EXACTLY, so a joined entry matches
#                 nothing and the gate fails OPEN. 31 tasks would have hit the
#                 auto-QA block and did not; 464 would have pulled a domain
#                 reviewer light and did not. (Release::GemVersion is the one
#                 reader unharmed — BREAKING_TAG is a substring regex.)
#
# WHY THESE TWO AND NOT THE OTHER THREE. `--accept`, `--test` and `--checks` carry
# free PROSE, where a comma is ordinary punctuation — 291, 230 and 1605 board TASKS
# respectively carry one, and those are 360, 309 and 5883 individual ENTRIES
# (re-measured 2026-09-16; the first cut of this sentence printed the TASK counts and
# called them entries — what a blanket rule would shred is the 6552 entries, not the
# 2126 tasks). Every one of those entries is correct. Guarding them would
# refuse legitimate acceptance criteria, and SPLITTING them would silently shred
# an acceptance bullet into fragments. That is a worse defect than the one being
# fixed, and it is exactly why this is a per-flag decision and not one blanket
# rule. The invariant is asserted, not merely written here:
# test_the_comma_guard_covers_identifier_flags_and_never_prose in
# test/lib/task_cli_test.rb reads this constant out of this file.
#
# WHY REFUSE RATHER THAN SPLIT. Splitting cannot be WRONG — no legal repo name or
# risk tag contains a comma — so it was the live alternative. It loses on two
# counts. First, consistency: every other value this parser cannot honor dies
# here (`--agent Steffon`, `--depends-on "Adopt Modal Primitive"`, a malformed
# `--pr-url-for` pair, an unknown flag), each with the same stated reason — die
# where a human can still fix it. A single flag that silently rewrites what the
# operator typed, sitting among four that refuse, is its own trap. Second, and
# decisive: splitting teaches the WRONG lesson. An agent whose `--repo a,b`
# quietly works has learned that this CLI takes comma lists, and will next type
# `--accept "one thing, then another"` expecting two criteria — which must stay
# ONE, and will. Refusing states the flag's shape once, and the lesson transfers
# to the flags that can never be guarded. The cost is one retyped command line,
# paid by the operator who was already wrong, at the only moment it is still free.
#
# WHY THE GUARD LIVES HERE — AND WHY IT IS NOT THE ONLY ONE.
# The VALUE alone cannot be judged: `["a,b"]` from --repo and `["one thing, then
# another"]` from --accept are both one-element arrays, and the board form posts the
# same two shapes as strings.
#
# The KEY can be, and SINCE 2026-09-16 IT IS. normalize_devops_metadata branches per
# key (DEVOPS_LIST_KEYS) and LIST_FLAGS maps 1:1 onto those keys, so
# Task::DEVOPS_IDENTIFIER_LIST_KEYS carries the same rule scoped to
# `repositories`/`risk_tags` — splitting a joined entry there, never in prose,
# WHATEVER SHAPE THE PAYLOAD ARRIVES IN. That last clause was the second half of the
# fix and landed a day late: Task.normalize_devops_list decided by INPUT SHAPE, so
# scoping the array branch to the key left the string branch splitting for every key,
# and the board form's "One criterion per line" TEXTAREAS still shredded any criterion
# carrying a comma. The identifier keys do still split on that branch — it is how the
# form's own "auth, solana, migration" text field files three tags — but because the
# KEY says so now, not because the value arrived as a string.
#
# That server rule is the backstop for the raw JSON API, which this file cannot see
# at all. Do NOT read it as making this guard redundant: the server
# SPLITS where this REFUSES, deliberately and for reasons argued at that constant (a
# 422 teaches a scripted caller nothing, and costs it the whole write). This is
# where the lesson gets taught, and where all 1104 joined entries the 2026-09-15
# census found were typed — guard here FIRST, not only. The two never disagree in
# front of a human, because this refusal runs before any request goes out.
COMMA_FREE_LIST_FLAGS = %w[--repo --risk].freeze
# REPEATABLE repo-keyed MAP flags: `--pr-url-for <repo>=<url>`, one per repo.
#
# `--pr-url` holds ONE url, and the release lane parses that url for the repo it
# plans against — so a task naming two repos had exactly one place to record a PR,
# and the repo it named won. On 2026-08-13 `land-rails-security-patch` named
# [mcritchie-studio, turf-monster] with the hub's PR url: turf's PR #305 had
# NOWHERE TO LIVE, turf was never promoted or deployed, and the task was still
# stamped shipped + merged:"main" while turf production ran the unpatched code.
# This flag is where the second repo's PR finally lives.
#
# THE SWEEP READS THIS MAP; NOTHING REFUSES AN INCOMPLETE ONE YET. Both halves,
# plainly, rather than a comment that implies a guard. READ: Task#release_repos
# folds these keys into the task's release identity, so a repo reaches the promote
# /QA/ship plan by being declared in `repositories` OR by having its PR recorded
# here, and Release::Conductor#member_plan carries each repo's url alongside it.
# REFUSED: nothing. Task#repos_missing_pr_url is the query that will answer "which
# repo has no PR", and it still has no caller until
# /tasks/merge-promotes-every-repo ships the refusal — so a repo you neither
# declare nor record is simply absent from the plan, and a repo you DECLARE
# without recording its PR is planned, promoted and QA-deployed like any other:
# the release then has evidence for it, so Release::MemberEvidence does NOT hold
# the member. That guard keys on what the RUN LANDED per repo, never on PR
# coverage — it catches a repo missing from the PLAN, not a repo missing a PR.
# KEEP HAND-CHECKING PR COVERAGE until the refusal lands. A comment promising a
# guard that does not run is the exact defect this family exists to stop — see
# app/models/task.rb#repos_missing_pr_url.
#
# MERGES per repo (read-merge-write, like every other `update` flag): recording
# turf's PR leaves the hub's entry alone. SEQUENTIALLY — say the caveat rather
# than write "never". The merge happens CLIENT-side, and the server treats a
# POSTED name as authoritative with no optimistic lock, so a peer devops writer
# that read the record first still overwrites the map with its own copy — one
# without the entry. That is true of every devops key and is not new here; the
# house's ≤5-concurrent-writers norm is what keeps it theoretical, not a mechanism
# in this file. (The server-side merge closes the OMISSION hazard, not this
# read-then-write one: a lost update needs two writers, a silent wipe needed one.)
#
# `--pr-url` stays the primary and is folded into the map automatically by
# Task#release_pr_urls — you do not repeat it here, and it WINS for the repo it
# names (one repo, one authoritative PR).
MAP_FLAGS = { "--pr-url-for" => "pr_urls" }.freeze
NOTE_FLAGS = {
  "--handoff" => "handoff",
  "--qa-feedback" => "qa_feedback",
  "--clarification" => "clarification",
  "--comment" => "comment"
}.freeze
# The size trio, set as TOP-LEVEL Task columns (not devops). Avi seeds po_size at
# creation (the default sizer — not a hard gate), the builder Pokémon stamps
# dev_size when it claims the task at `building`, pm_size is an optional extra
# estimate; actual_size is auto-derived from measured usage at ship. Every value
# is validated against SIZES before the request goes out.
SIZES = %w[small medium large xl].freeze
# The SOUL-SLUG shape, a deliberate mirror of Task::SOUL_SLUG (this CLI holds no
# Rails constants — same posture as the PR-url pattern above). It is the contract
# `Task#builder_to_stamp` reads: a value that does NOT match is accepted by the
# board (agent_slug is a free-form column, `belongs_to :agent, optional: true`),
# stored, and then SILENTLY skipped by the stamp — so `--agent Steffon` or
# `--agent turf_monster` records an assignee whose only job was to feed
# `devops.built_by` and feeds it nothing. Refuse it here, where a human can still
# fix it, exactly as --po-size and --gem-bump are refused.
SOUL_SLUG = /\A[a-z]+(?:-[a-z]+)*\z/
SIZE_FLAGS = { "--pm-size" => "pm_size", "--po-size" => "po_size", "--dev-size" => "dev_size" }.freeze
# Top-level Task columns parse_flags accepts alongside the devops flags.
TOP_FLAGS = %w[--slug --title --description --agent --priority --stage].freeze
# VALUELESS top-level boolean columns. `requires_migration` is a plain flag a
# builder SELF-FLAGS the moment they discover they need a migration. Both
# polarities are explicit because un-flagging matters too.
BOOL_FLAGS = {
  "--requires-migration"    => ["requires_migration", true],
  "--no-requires-migration" => ["requires_migration", false]
}.freeze
# REPEATABLE top-level LIST columns. One member: `--depends-on <task-slug>`, the
# explicit task-to-task release edge.
#
# WHY IT EXISTS. `tasks.dependencies` is a real jsonb column that
# `Release::Ordering.producer_first` topologically sorts on — reached from
# `Release#ordered_members` and `Release::Conductor` — and until this flag it had
# no writer outside tests calling `Task.create!`. `grep -c dependencies bin/task`
# was 0. Meanwhile `config/feature_shapes.yml`'s library notes and
# `docs/agents/modules/modal-lifecycle.md` BOTH told agents to "declare
# `dependencies: [<gem-task>]` so the release sequences the gem first" — a
# behaviour no command could perform, in a syntax nothing parsed. The consumer
# was shipped and the producer was not, which is the same half-built shape
# `--requires-migration` above was added to close.
#
# REPLACES, it does not append — the same semantics as the devops LIST_FLAGS, and
# said out loud because `--checks` replacing its list has bitten this house
# repeatedly. Send the whole set in one call: `--depends-on a --depends-on b`.
# `--depends-on none` (LIST_CLEAR_VALUES) clears the field; mixing it with a real
# slug is a contradiction and dies rather than picking a winner.
#
# The value is validated for SLUG SHAPE here and for EXISTENCE at the server
# (Task#dependencies_name_real_tasks), because the failure mode is silence:
# `producer_first` skips a dependency it cannot resolve on purpose (a dependency
# outside the release must not hold a member back), so a typo'd slug is
# indistinguishable from no dependency at all — forever, with the only evidence a
# release that shipped in the wrong order.
TOP_LIST_FLAGS = { "--depends-on" => "dependencies" }.freeze
# Top-level SCALAR columns with a CLEAR token. One member: `--epic <epic-slug>`
# writes `tasks.epic_slug`, the handle the board card's epic chip prints and
# `/tasks?epic=<slug>` filters on (devops-v3-design.md §3).
#
# A fourth family rather than a TOP_FLAGS entry, because TOP_FLAGS stores the
# value verbatim and this one has a CLEAR: `--epic none` must reach the wire as
# JSON `null`, and a nil in `top` is falsy, so top_body has to presence-test the
# KEY — the BOOL_FLAGS / TOP_LIST_FLAGS rule — which a plain TOP_FLAGS scalar
# never needed. It lands in `top`, never in `scalars`: `scalars` is the DEVOPS
# namespace, and metadata.devops.epic_slug is the shadow store
# Task::DEVOPS_COLUMN_KEYS refuses (a value visible on the task page that no
# chip and no filter would ever read).
#
# Validated for SLUG SHAPE here, where a human can still fix it, and lowercased
# so the CLI and the model agree on the canonical form before the board sees it.
TOP_SCALAR_FLAGS = { "--epic" => "epic_slug" }.freeze
# A task slug, mirrored from Task::DEPENDENCY_SLUG (this CLI holds no Rails
# constants — same posture as SOUL_SLUG and the PR-url pattern). Refused HERE so
# `--depends-on "Adopt Modal Primitive"` dies where a human can still fix it,
# rather than travelling to a 422 or, worse, landing as a slug the ordering pass
# silently never resolves.
DEPENDENCY_SLUG = /\A[a-z0-9]+(?:[-_][a-z0-9]+)*\z/
# Everything parse_flags (list/create/update) understands — the dictionary an
# unknown flag is rejected against (and suggestion-matched, --pr → --pr-url).
PARSE_FLAG_NAMES = (SCALAR_FLAGS.keys + LIST_FLAGS.keys + MAP_FLAGS.keys + SIZE_FLAGS.keys + TOP_FLAGS +
                    BOOL_FLAGS.keys + TOP_LIST_FLAGS.keys + TOP_SCALAR_FLAGS.keys).freeze
HELP_FLAGS = %w[--help -h].freeze
# Two-workflow status model. Stages move via PATCH stage (no named-transition
# endpoints) so the CLI, the board drag-drop, and the API share one path.
STAGES = %w[designed building submitted reviewed assembled shipped archived].freeze
# `blocked`/`failed` are no longer stages — a block is a `building` attribute set
# via `bin/task block`, so nudge the legacy names toward it.
LEGACY_STAGE_HINTS = {
  "new" => "designed",
  "queued" => "designed",
  "in_progress" => "building",
  "pr_review" => "submitted",
  "qa_review" => "assembled",
  "prod_ready" => "assembled",
  "done" => "shipped"
}.freeze
BLOCK_KINDS = %w[environment rework dependency].freeze
PERSONA_CLEAR = %w[none clear off -].freeze
# REMOVING one entry from a repo-keyed map: `--pr-url-for <repo>=none`. Same
# vocabulary as PERSONA_CLEAR so the CLI has ONE clear-token idiom, not two.
#
# An entry had to be removable. `build_devops` only ever merges, and the server
# drops an empty map, so before this a typo'd repo key was permanent: there was
# no value you could pass that unfiled it. A word sentinel rather than an empty
# value is deliberate — `--pr-url-for turf-monster=$URL` with URL unset would
# otherwise silently DELETE the entry it was meant to write.
MAP_CLEAR_VALUES = PERSONA_CLEAR
# The clear token for a TOP_LIST_FLAGS field (`--depends-on none`), sharing
# PERSONA_CLEAR's vocabulary so the CLI keeps ONE clear-token idiom rather than a
# third. Defined HERE, below PERSONA_CLEAR, rather than beside TOP_LIST_FLAGS —
# this file is a script, so a constant referenced above its definition is a
# load-time NameError that takes out every subcommand, not just the new flag.
LIST_CLEAR_VALUES = PERSONA_CLEAR
# The clear token for a TOP_SCALAR_FLAGS field (`--epic none`) — the same
# vocabulary again, and defined here for the same load-order reason.
EPIC_CLEAR_VALUES = PERSONA_CLEAR
APPROVAL_STATUS_ALIASES = {
  "changes-requested" => "changes_requested",
  "change_requested" => "changes_requested",
  "clear" => "none",
  "cleared" => "none"
}.freeze
APPROVAL_STATUSES = %w[waiting approved changes_requested none].freeze
# The one status a stage move can SETTLE (Task::OPERATOR_APPROVAL_WAITING). Named
# rather than spelled at the comparison site: the drop warning turns on this exact
# value, and a literal there reads as an incidental string rather than the rule.
APPROVAL_WAITING = "waiting"

def warn!(msg)
  $stderr.puts(msg)
end

# The board POSITIVELY answered "there is no such task" — see the exit-code
# contract in the header. Mirrored by bin/agent-worktree's TASK_NOT_FOUND_EXIT
# (its fetch_task_record frees a desk on this code); keep the two in lockstep.
EXIT_TASK_NOT_FOUND = 4

# The two-bounce circuit breaker REFUSED this rework block (`bounces` reports the
# same code when the breaker is tripped). Distinct from 1 so a caller can tell "the
# breaker says escalate" from "the read failed".
EXIT_BREAKER_TRIPPED = 10

# Page size `list --json` asks for. 100 is the index's own ceiling
# (Api::Paginatable clamps per_page), so this is "as few round trips as the API
# will allow" — the loop above walks any remainder.
LIST_JSON_PER_PAGE = 100

def die!(msg, code: 1)
  warn!("error: #{msg}")
  exit code
end

# A stage move OUT of the approval-request stages SETTLES a pending operator-approval
# request to "none" (Task#settle_operator_approval_past_request_window). That rule is
# deliberate — past `reviewed` the work has merged and the desk serving the local
# demo is reclaimable, so the request points at a page nobody can open — but it used
# to happen in SILENCE, and the silence is the defect this warning closes.
#
# Reproduced 2026-09-07: an agent set --approval waiting at `building`, read it back
# as "waiting", then ran bin/ship. The handoff move cleared it, `local_url` from the
# same call survived, and nothing was printed. So the agent believed it had asked,
# the board never pulsed, and Mr. McRitchie was never asked — a human gate that
# reports success and does nothing.
#
# THAT REPRODUCTION IS HISTORY AS OF 2026-09-09, and it is the SECOND fix to the
# same wound. This warning was the first: it made the drop loud. Making it loud then
# made it countable, and it was counted — three times in one night (turf PRs 644,
# 647, 653), every one of them a builder who followed the documented flow exactly.
# A defect that reproduces on the documented path is not a reporting problem, so
# `submitted` joined APPROVAL_REQUEST_STAGES and the ship handoff now drops nothing
# to announce. The warning stays, aimed at the boundary that is still real: a move
# to `reviewed` or past it, where the local demo genuinely has gone away.
#
# THE WARNING ASKS ABOUT THIS MOVE'S EFFECT, NOT ABOUT A CLOCK. The first cut
# compared the drop receipt against the instant the move began, with a 300s grace
# for board-vs-laptop skew, and a clock cannot answer the question the warning
# asks. Measured 2026-09-07 against the real binary: with a 60-second-old stamp,
# `bin/task move <slug> building` announced a discarded request — on a move INTO
# one of the stages where a request is ACTIONABLE, where the settle provably
# never runs — and a re-run `move <slug> submitted` (the documented killed-ship
# resume) announced the SAME single drop a second time. Neither example routes here
# at all any more — `submitted` joined the actionable stages in 2026-09-09, so both
# are now `settleable == false` — but the conclusion they forced is what survives:
# the warning asks what THIS move did, and never how old a stamp is. Every one of those was a
# stamp the move did not write. So the grace window is gone, and with it the skew
# problem it existed to paper over: nothing is compared against this machine's
# clock any more.
#
# The move dropped the request when EITHER half says so, and the halves are OR-ed
# because each covers the other's blind spot. The OR only ever widens — the union
# warns wherever either half does, and is never quieter than either half alone. It
# is NOT silence-free: three real drops go unannounced, named below and MEASURED,
# not reasoned.
#
#   1. THE PRE-STATE PREDICTED IT — the request read "waiting" before the PATCH and
#      the destination cannot hold one. That is Task#settle_operator_approval_past_request_window's
#      own rule, so it fires even against a board too old to write the receipt at all
#      (this CLI has to stay correct against a board that has not taken that fix).
#      It is also the ONLY half that catches the SAME-SECOND COLLISION, where the
#      fresh stamp renders identically to the one already on the record.
#   2. THE RECEIPT MOVED — approval_request_dropped_at differs across the PATCH.
#      That catches a drop the pre-read could not predict: a writer that set
#      "waiting" in the window between our read and our write. It does NOT catch the
#      same-second collision — this is a plain INEQUALITY, so identical renderings
#      make it false, and half 1 is what covers that case. Stated as an inequality
#      on purpose: an earlier cut also required the post-receipt to be non-empty,
#      which no test could kill (the board only ever WRITES this stamp, so a receipt
#      cannot vanish) and which was the single place the verdict resolved an unknown
#      toward SILENCE. Every branch but the three residuals below now resolves the
#      other way.
#
# An UNREADABLE pre-state (`before` nil — the board hiccuped) is not silence BY
# ITSELF: half 2 reads a receipt on the record as news and warns. Failing safe is
# the point — a spurious line costs a reader one sentence, a missed one costs the
# operator gate.
#
# THE THREE RESIDUALS, measured 2026-09-08 by DRIVING this binary across the whole
# nine-cell board-state matrix (both pins are named at the end of this note). Each
# is a REAL drop that neither half can see:
#
#   (i)   an unreadable pre-read AND a board too old to write a receipt — nothing
#         to predict from, and nothing to compare.
#   (ii)  a racing writer AND a fresh stamp that renders in the SAME SECOND as the
#         prior one — the pre-read said "none", and the inequality sees no change.
#   (iii) a racing writer AND a board too old to write a receipt.
#
# The mechanism under all three is the string inequality plus drop_receipt_of(nil)
# => "": `"" != ""` is false, and so is `STAMP != STAMP`. There is no FOURTH case
# hiding behind an unreadable pre-read plus a same-second stamp — with `before` nil
# the left side is "" and only a receipt-less board makes the right side "" too,
# which is (i). The test DRIVES that cell rather than assuming it away.
#
# They stay open because closing them costs more: (i) would warn on every unreadable
# pre-read — a false line on every transient board hiccup, and a warning readers
# learn to skip is the defect this whole path exists to prevent — while (ii) and
# (iii) are observationally IDENTICAL to a move that dropped nothing, so no rule can
# be quiet on the common state and loud on the rare one. What a reader must take
# from this: a quiet move is weak evidence, never a receipt.
#
# Pinned in TWO places, and it takes both. test/lib/task_move_approval_drop_test.rb
# drives the three cells above plus the would-be fourth, checks that THIS list still
# names what it measured, and proves the half-1/half-2 attribution with a controlled
# pair. test/docs/approval_drop_warning_docs_test.rb drives the FULL nine-cell
# matrix, so a residual appearing in a cell the first file does not drive still turns
# something red. Close a residual and both ask this note to say so.
#
# A destination that CAN hold a request never reaches here at all — the `settleable`
# test at the call site is the single place that decision is made, so the message can
# no longer contradict itself by naming `building` as a stage where a request is fine
# while warning about the move INTO it.
#
# A MIRROR of Task::APPROVAL_REQUEST_STAGES, kept in sync by
# test/models/task_approval_request_guard_test.rb, which reads this literal out of
# this file. It is duplicated rather than imported because this CLI is an HTTP
# client with no Rails boot, and it must stay correct against a board that has not
# taken the latest fix.
#
# `submitted` JOINED THE LIST ON 2026-09-09, which is why the most common move this
# warning ever fired on — the `bin/ship` handoff — is now silent: it no longer drops
# anything. The warning's remaining job is the merge boundary, `reviewed` and past.
APPROVAL_REQUEST_STAGES = %w[designed building submitted].freeze

# A GET that DEGRADES instead of aborting. The move itself is correct and must
# still succeed when the board is briefly unreadable; only the warning's accuracy
# depends on this read, and it fails loud (see half 2) rather than quiet.
def read_task_softly(slug)
  res = TaskBoard.request(:get, "/api/v1/tasks/#{slug}", base_url: BASE_URL, token: token)
  return nil unless res.code.to_i.between?(200, 299)

  data = TaskBoard.parse_body(res)["data"]
  data.is_a?(Hash) ? data : nil
rescue StandardError
  nil
end

def approval_status_of(task)
  task.is_a?(Hash) ? task.dig("metadata", "devops", "approval_status").to_s.strip : ""
end

def drop_receipt_of(task)
  task.is_a?(Hash) ? task.dig("metadata", "devops", "approval_request_dropped_at").to_s.strip : ""
end

# EVERY COMMAND THIS MESSAGE PRINTS IS EXECUTED BY A TEST
# (test_every_command_the_warning_prints_actually_runs). The first draft of this
# very rewrite advertised `bin/task move <slug> building --approval waiting` — a
# flag `move` does not have, so the one command a stuck reader would paste dies on
# unknown_flag!. Asserting the text CONTAINS a command proves only that a string is
# present; running it is what proves the advice is real.
#
# `before` is a trailing POSITIONAL on purpose. Adding a KEYWORD to a method whose
# callers pass a brace-less trailing hash silently re-binds that hash to the
# keywords — the trap that cost PR 1276 four red tests on a shard no diff-mapped
# lane runs, and the same one bin/task's own `api` helper carries a note about.
def warn_dropped_approval_request!(task, slug, before)
  return unless move_dropped_approval_request?(task, before)

  # NEVER ADVISE A BACKWARD MOVE. This used to say "move the task back and ask again"
  # (`move <slug> building`, then `--approval waiting`). From `reviewed` on the code is
  # already on `accepted`, so that move un-merged nothing: it made the board show
  # `building` for code that had landed. docs/agents/modules/devops-task-board.md
  # (Operator Validation Gate, item 8) states the same remedy in prose — change both.
  warn!("warning: this move DISCARDED a pending operator-approval request " \
        "(approval_status waiting → none). Nobody was asked and the board will not pulse. " \
        "If the operator already approved in words, record it: #{SELF_CMD} update #{slug} " \
        "--approval approved; if he asked for changes: #{SELF_CMD} update #{slug} " \
        "--approval changes_requested. If you still need his eyes on merged work, point him " \
        "at the QA candidate once the qa-release sweep deploys it. Do not move the task back " \
        "to re-open the request: from reviewed on the code is on accepted, and a backward move " \
        "un-merges nothing. A request is only actionable in " \
        "#{APPROVAL_REQUEST_STAGES.join(" or ")}.")
end

def move_dropped_approval_request?(task, before)
  predicted = approval_status_of(before) == APPROVAL_WAITING
  receipt_moved = drop_receipt_of(task) != drop_receipt_of(before)

  predicted || receipt_moved
end

def print_usage!
  warn!(File.read(__FILE__)[/# Usage:.*?(?=\nrequire)/m].to_s.gsub(/^# ?/, ""))
end

# --help/-h print usage and exit 0 from ANY position — never parsed as a slug
# (`update --help` once issued GET /api/v1/tasks/--help → 404, actively
# misleading the one agent already confused about the flags).
def help!
  print_usage!
  exit 0
end

# Nearest-valid-flag suggestions for an unknown flag: exact-prefix candidates
# first ("--pr" → --pr-url / --priority / --prod-url — the shorthand typo), then
# DidYouMean spelling candidates ("--pr-ulr" → --pr-url). [] when nothing is close.
def flag_suggestions(unknown, valid)
  prefix = valid.select { |flag| flag.start_with?(unknown) }.sort
  return prefix unless prefix.empty?

  require "did_you_mean"
  DidYouMean::SpellChecker.new(dictionary: valid).correct(unknown)
rescue LoadError, NameError
  [] # suggestions are a courtesy; the rejection stands without them
end

# Reject an unrecognized flag LOUDLY — exit nonzero, name the flag, suggest the
# nearest valid one. The old parse loop dropped an unknown flag (and its value)
# into ignored positionals and exited 0: `update <slug> --pr <url>` printed the
# task as if the PR were recorded while the board still said `pr: -`, and the
# next gate (bin/dor-check NO_PR) failed naming nothing about the real cause.
# A CLI must never report an operation that did not happen.
# `hint:` appends a caller-supplied REMEDY after the generic suggestion — for the
# refusals where naming the valid flags is not enough to unstick the caller (the
# resume form, whose fix is "pass --title" or "use bin/task update", neither of
# which is a flag this call could suggest).
def unknown_flag!(flag, valid: [], context: nil, hint: nil)
  help! if HELP_FLAGS.include?(flag)
  suggestions = flag_suggestions(flag, valid)
  suffix =
    if suggestions.any?
      " — did you mean #{suggestions.join(", ")}?"
    elsif valid.any?
      " (valid flags: #{valid.join(", ")})"
    else
      ""
    end
  suffix += " — #{hint}" if hint
  die!("unknown flag #{flag.inspect}#{context ? " for #{context}" : ""}#{suffix}")
end

# A dashed token is never a slug (or any other positional): --help/-h print
# usage, anything else dies naming the misplaced flag instead of riding into a
# 404ing GET /api/v1/tasks/<flag>.
def positional!(arg, usage)
  help! if HELP_FLAGS.include?(arg)
  die!("expected a positional argument, got flag #{arg.inspect} (#{usage})") if arg.to_s.start_with?("-")
  arg
end

def validate_stage!(stage)
  return if STAGES.include?(stage)

  hint = LEGACY_STAGE_HINTS[stage]
  suffix = hint ? " (legacy stage; use #{hint.inspect})" : ""
  die!("unknown stage #{stage.inspect}#{suffix}; one of: #{STAGES.join(", ")}")
end

# Reject a size value the model would refuse, with a clear message — so a typo'd
# --po-size never reaches the API as a 422. Shared by create/update (parse_flags)
# and the building claim's --dev-size.
def validate_size!(flag, value)
  return if SIZES.include?(value)

  die!("#{flag} must be one of: #{SIZES.join(", ")} (got #{value.inspect})")
end

# The task's assigned soul. Validated for SHAPE only — the CLI cannot see the
# Agent table, and a missing Agent row is NOT what breaks the stamp (checked:
# db/seeds/02_agents.rb seeds every soul). What breaks it is a value outside
# SOUL_SLUG, which `Task#builder_to_stamp` rules 1 and 4 both test before they
# stamp `devops.built_by`. reviewer-select reads ONLY that key and REFUSES an
# unknown builder (bin/reviewer-select), so a dropped stamp does not fail the
# review — it stalls it, and a hand-picked reviewer once turned out to be the PR's
# own author. A flag whose whole purpose is stamping must never no-op quietly.
def validate_agent_slug!(flag, value)
  return if value.to_s.match?(SOUL_SLUG)

  die!("#{flag} must be a soul slug — lowercase letters and single hyphens " \
       "(e.g. steffon, turf-monster) — got #{value.inspect}. " \
       "Anything else is stored but never stamped onto devops.built_by, " \
       "which is what bin/reviewer-select reads to keep a soul off their own PR.")
end

# A comma inside the value of a repeatable IDENTIFIER flag — the `--repo a,b`
# defect. The full argument (which flags, why refuse rather than split, and what
# a joined entry costs downstream) lives at COMMA_FREE_LIST_FLAGS; this is the
# one refusal every guarded call site shares.
#
# `remedy` is the corrected command line, built from the value the operator
# ACTUALLY typed rather than described in the abstract, so the fix is copyable.
# The list flags default to repeating the flag per entry; `--pr-url-for` passes
# its own, because a repo-keyed map cannot be split (two repos, one url).
def refuse_comma_list!(flag, value, remedy: nil)
  return unless value.to_s.include?(",")

  entries = value.to_s.split(",").map(&:strip).reject(&:empty?)
  remedy ||= entries.map { |entry| "#{flag} #{entry}" }.join(" ")
  # A value of "," alone splits to nothing; name the SHAPE rather than print an
  # empty remedy, which would read as "pass it once per entry: " and teach zero.
  remedy = "#{flag} <entry> #{flag} <entry>" if remedy.strip.empty?

  die!("#{flag} #{value.to_s.inspect} is ONE value containing a comma, not a list — and no repo " \
       "name or risk tag contains a comma. #{flag} is REPEATABLE; pass it once per entry:\n" \
       "  #{remedy}\n" \
       "Accepted as typed it stores a single joined entry that renders identically to the correct " \
       "pair (`bin/task show` prints both as `a,b`) and is read correctly by nothing: the release " \
       "conductor resolves it to a phantom repo and ABORTS the sweep, Release::BuilderPolicy's " \
       "blocked_risk_tags never matches it, and ReviewerSelector::RISK_DOMAINS pulls no light. " \
       "The prose flags — --accept, --test, --checks — are NOT guarded: a comma is legal there.")
end

# The gem bump override (patch|minor|major). Never required — bin/release derives the
# bump from the candidate's members; this only overrides it.
def validate_gem_bump!(flag, value)
  return if %w[patch minor major].include?(value.to_s.strip.downcase)

  die!("#{flag} must be one of: patch, minor, major (got #{value.inspect}) — " \
       "leave it unset to let the release derive the bump from the task's kind")
end

def normalize_approval_status!(flag, value)
  normalized = APPROVAL_STATUS_ALIASES.fetch(value.to_s.strip.downcase, value.to_s.strip.downcase)
  return normalized if APPROVAL_STATUSES.include?(normalized)

  die!("#{flag} must be one of: #{APPROVAL_STATUSES.join(", ")} (got #{value.inspect})")
end

def agent_secret
  dotenv = File.join(__dir__, "..", ".env")
  TaskBoard.agent_secret(dotenv) ||
    die!("AGENT_API_SECRET not found (checked ENV, #{dotenv}, 1Password)")
end

def token
  @token ||= api(:post, "/api/v1/auth", { secret: agent_secret }, auth: false).fetch("token")
end

# NOTE: opts is a trailing positional hash, NOT a keyword arg. Under system Ruby
# (2.6) a brace-hash passed as the last positional to a method with keyword
# params is silently coerced to kwargs — which is what made `move` blow up with
# "unknown keyword: stage". Keeping auth in a positional opts hash is robust
# across every Ruby the agents might run this under.
def api(method, path, body = nil, opts = {})
  auth = opts.fetch(:auth, true)
  res = TaskBoard.request(method, path, base_url: BASE_URL, token: (auth ? token : nil), body: body)
  parsed = TaskBoard.parse_body(res)
  unless res.code.to_i.between?(200, 299)
    die!("#{method.upcase} #{path} -> #{res.code}: #{parsed["error"] || res.body}",
         code: task_not_found_response?(res, parsed) ? EXIT_TASK_NOT_FOUND : 1)
  end
  parsed
end

# Classify the board's answer HERE, where the response is still structured (status
# + parsed JSON body), instead of leaving callers to pattern-match the die! stderr
# rendering. The 404 status alone is NOT enough: a Heroku router 404 (board app
# renamed/deleted) or a route-level 404 (moved path, stale board) is a FAILED
# read, not an answer — only the tasks API's own body counts
# (app/controllers/api/v1/tasks_controller.rb#set_task renders exactly
# "task not found", pinned by its controller test). A false positive here frees a
# live builder's worktree for teardown during an outage, so match the exact
# message, not the family (the generic "Not found" backstop stays exit 1).
def task_not_found_response?(res, parsed)
  res.code.to_i == 404 && parsed.is_a?(Hash) && parsed["error"].to_s.strip.casecmp?("task not found")
end

# Parse repeatable + scalar flags out of argv. Returns [positionals, scalars,
# lists, top]. An unrecognized flag is REJECTED (unknown_flag!), never skipped.
def parse_flags(argv, context: nil)
  positionals = []
  scalars = {}
  lists = Hash.new { |h, k| h[k] = [] }
  # Repo-keyed maps (MAP_FLAGS) ride in `scalars` so the [positionals, scalars,
  # lists, top] contract every caller destructures stays exactly four wide; the
  # value is a Hash rather than a String, which build_devops merges per key.
  #
  # THE COST OF THAT ALIASING: MAP_FLAGS and SCALAR_FLAGS now share ONE devops
  # namespace, so a future map flag whose devops key collides with a scalar flag's
  # would silently overwrite it — whichever came last in argv. The invariant is
  # ASSERTED, not merely written here: test_map_and_scalar_flags_never_share_a_
  # devops_key in test/lib/task_cli_test.rb reads both constants out of this file
  # and fails on the collision.
  maps = scalars
  top = {}
  i = 0
  while i < argv.length
    arg = argv[i]
    if SCALAR_FLAGS.key?(arg)
      key = SCALAR_FLAGS[arg]
      value = argv[i + 1] || die!("#{arg} needs a value")
      value = normalize_approval_status!(arg, value) if key == "approval_status"
      # A typo here would silently degrade to the DERIVED bump and publish the wrong
      # number — irreversibly. Reject it where a human can still fix it.
      validate_gem_bump!(arg, value) if key == "gem_bump"
      scalars[key] = value; i += 2
    elsif LIST_FLAGS.key?(arg)
      value = argv[i + 1] || die!("#{arg} needs a value")
      # Identifier flags only (COMMA_FREE_LIST_FLAGS) — the prose flags keep their
      # commas. A no-op for the other three, so the branch keeps one shape.
      refuse_comma_list!(arg, value) if COMMA_FREE_LIST_FLAGS.include?(arg)
      lists[LIST_FLAGS[arg]] << value; i += 2
    elsif MAP_FLAGS.key?(arg)
      # `<repo>=<url>`. Split on the FIRST `=` only — the url carries none, but a
      # query string could. A malformed pair dies here rather than writing half a
      # record: a silently-dropped entry would re-open the exact hole this map
      # closes. The URL itself is validated SERVER-side (one parser, in
      # Task::PR_URL_REPO_PATTERN — this CLI holds no Rails constants), so a
      # nonsense url comes back a 422 and nothing is written.
      #
      # `<repo>=none` (MAP_CLEAR_VALUES) REMOVES the entry — carried as a nil
      # value, which build_devops turns into a delete.
      pair = argv[i + 1] || die!("#{arg} needs a value (<repo>=<pr-url>)")
      repo, url = pair.split("=", 2)
      repo = repo.to_s.strip
      url = url.to_s.strip
      die!("#{arg} expects <repo>=<pr-url>, got #{pair.inspect}") if repo.empty? || url.empty?
      # The repo KEY is an identifier, and Task#release_repos folds these keys into
      # the task's release identity — so a comma here reaches the release plan as a
      # phantom repo by the other door. Splitting is not even available (two repos,
      # one url), which makes refusing the only answer rather than the chosen one.
      refuse_comma_list!(arg, repo,
                         remedy: repo.split(",").map(&:strip).reject(&:empty?)
                                     .map { |name| "#{arg} #{name}=<that repo's own pr url>" }.join(" "))
      url = nil if MAP_CLEAR_VALUES.include?(url.downcase)
      (maps[MAP_FLAGS[arg]] ||= {})[repo] = url; i += 2
    elsif SIZE_FLAGS.key?(arg)
      value = argv[i + 1] || die!("#{arg} needs a value")
      validate_size!(arg, value)
      top[SIZE_FLAGS[arg]] = value; i += 2
    elsif TOP_FLAGS.include?(arg)
      key = arg.delete_prefix("--")
      value = argv[i + 1] || die!("#{arg} needs a value")
      # The assignee is the stamp's rule-4 input; a non-soul value is a silent
      # no-op downstream, so it dies here instead.
      validate_agent_slug!(arg, value) if key == "agent"
      top[key] = value; i += 2
    elsif BOOL_FLAGS.key?(arg)
      # Valueless — consumes ONE token. Storing the boolean (including `false`)
      # means top_body must ask `key?`, never truthiness, or --no-requires-migration
      # would silently vanish.
      column, value = BOOL_FLAGS[arg]
      top[column] = value; i += 1
    elsif TOP_LIST_FLAGS.key?(arg)
      # Repeatable top-level LIST column. It accumulates in `top` rather than in
      # `lists` — `lists` is the DEVOPS namespace (build_devops nests every one of
      # its keys under "devops"), and this value is a COLUMN. Landing it there
      # would have written metadata.devops.dependencies: the exact shadow store
      # Task::DEVOPS_COLUMN_KEYS exists to refuse, and the one nothing reads.
      #
      # The four-wide [positionals, scalars, lists, top] contract is preserved by
      # aliasing into an existing bucket, exactly as MAP_FLAGS rides in `scalars`.
      # The three states are distinguished by the KEY, never by truthiness:
      # absent key = flag not passed (top_body omits it, the column is untouched);
      # present-and-EMPTY = the clear token was passed (top_body sends `[]`, which
      # the server assigns, clearing the column); present-and-populated = slugs.
      # An empty array is falsy-looking but meaningful, exactly like
      # --no-requires-migration's `false` above.
      column = TOP_LIST_FLAGS[arg]
      value = (argv[i + 1] || die!("#{arg} needs a value")).to_s.strip
      cleared = top.key?(column) && top[column].empty?
      if LIST_CLEAR_VALUES.include?(value.downcase)
        die!("#{arg} #{value} CLEARS the list, so it cannot be combined with a slug " \
             "(already given: #{top[column].map(&:inspect).join(", ")}) — pass either the clear " \
             "token or the slugs, not both") if top.key?(column) && top[column].any?

        top[column] = []
      else
        die!("#{arg} #{value.inspect} is not a task slug — lowercase letters, digits and single " \
             "separators (e.g. adopt-modal-primitive). An unresolvable slug is NOT refused by the " \
             "release ordering pass, it is silently ignored, so a typo here disables the sequencing " \
             "you asked for with no error anywhere.") unless value.match?(DEPENDENCY_SLUG)
        die!("#{arg} cannot follow the clear token — pass either the clear token or the slugs, " \
             "not both") if cleared

        (top[column] ||= []) << value unless (top[column] || []).include?(value)
      end
      i += 2
    elsif TOP_SCALAR_FLAGS.key?(arg)
      # Top-level scalar column with a clear token (see TOP_SCALAR_FLAGS). Lands
      # in `top` for the same reason TOP_LIST_FLAGS does: it is a COLUMN, and
      # `lists`/`scalars` are the devops namespace. Two states, told apart by the
      # KEY: absent = flag not passed (the column is untouched); present-and-nil =
      # the clear token, which top_body sends as JSON null.
      column = TOP_SCALAR_FLAGS[arg]
      value = (argv[i + 1] || die!("#{arg} needs a value")).to_s.strip
      if EPIC_CLEAR_VALUES.include?(value.downcase)
        top[column] = nil
      else
        value = value.downcase
        die!("#{arg} #{value.inspect} is not a slug — lowercase letters, digits and single " \
             "separators (e.g. devops-v3). The board would refuse it with a 422; refusing it here " \
             "keeps the message beside the flag that needs fixing.") unless value.match?(DEPENDENCY_SLUG)
        top[column] = value
      end
      i += 2
    else
      # A dashed token here is an unrecognized flag. The old whitelist-and-skip
      # loop dropped it (and its value) into these ignored positionals and
      # exited 0 — data silently lost. Reject it loudly instead.
      unknown_flag!(arg, valid: PARSE_FLAG_NAMES, context: context) if arg.start_with?("-")
      positionals << arg; i += 1
    end
  end
  [positionals, scalars, lists, top]
end

# Fold one map flag's entries into whatever the board already holds for that key.
# A nil value is the TOMBSTONE `--pr-url-for <repo>=none` writes: it DELETES the
# entry rather than storing a blank, so the PATCH body carries the map the
# operator meant. It sticks because the server treats a POSTED name as
# authoritative — `pr_urls` is in the body, so the stored map is replaced by this
# one, not merged with it. A map left empty by the last delete is sent as `{}`,
# which the server drops — the key disappears, which is the point.
#
# That survived the server-side merge (api-devops-patch-replaces) precisely
# BECAUSE Task.merge_devops_metadata keys on the posted NAMES rather than on the
# values that survive normalization. Pinned by "emptying the pr_urls map still
# removes the key" in test/controllers/api/v1/tasks_controller_test.rb.
def merge_devops_map(prior, incoming)
  merged = prior.is_a?(Hash) ? prior.dup : {}
  incoming.each { |repo, value| value.nil? ? merged.delete(repo) : merged[repo] = value }
  merged
end

def build_devops(base, scalars, lists)
  base = (base || {})
  devops = base.dup
  scalars.each do |k, v|
    # A MAP flag MERGES into the prior map (per-repo read-merge-write): recording
    # turf's PR must not wipe the hub's, or completing a task's PR record would be
    # a one-repo-at-a-time race the operator can lose.
    devops[k] = v.is_a?(Hash) ? merge_devops_map(base[k], v) : v
  end
  lists.each { |k, v| devops[k] = v unless v.empty? }
  # checks_run is TWO namespaces in one list. The author owns the tier tags
  # ("[unit] ...") and --checks REPLACES those, as documented. bin/control-check
  # owns the fingerprint-bound control stamp ("[control@<fp>] ..."), and --checks
  # must NOT be able to replace THAT: an agent recording its test plan after the
  # local cert used to wipe the cert's line, and bin/dor-check then called freshly
  # certified code "full-suite: MISSING" (a false negative whose only visible
  # remedy was another suite
  # run). Carry every evidence lane the caller did not itself supply. The board
  # enforces the same rule (Task#preserve_cert_evidence) for every other writer;
  # doing it here too means an agent is protected the moment it pulls this branch,
  # and the PATCH body says what the caller actually meant. See lib/cert_evidence.rb.
  if devops.key?("checks_run")
    devops["checks_run"] = CertEvidence.preserve(prior: base["checks_run"], incoming: devops["checks_run"])
  end
  devops
end

def top_body(top)
  body = {}
  body["slug"] = top["slug"] if top["slug"] # custom readable handle (create only)
  body["title"] = top["title"] if top["title"]
  body["description"] = top["description"] if top["description"]
  body["agent_slug"] = top["agent"] if top["agent"]
  body["priority"] = top["priority"].to_i if top["priority"]
  body["stage"] = top["stage"] if top["stage"]
  # The size trio (top-level Task columns) — already validated in parse_flags.
  SIZE_FLAGS.each_value { |col| body[col] = top[col] if top[col] }
  # Boolean columns: presence-tested, NOT truth-tested — `false` is a value the
  # caller asked for (--no-requires-migration), not an absent flag.
  BOOL_FLAGS.each_value { |(col, _)| body[col] = top[col] if top.key?(col) }
  # List columns: presence-tested for the same reason one line up. `[]` is the
  # value `--depends-on none` asked for — the CLEAR — and truth-testing it would
  # drop the clear from the body, leaving the operator with a 200 for a write that
  # never happened. This is the one flag family where the empty value is the point.
  TOP_LIST_FLAGS.each_value { |col| body[col] = top[col] if top.key?(col) }
  # Scalar-with-clear columns: presence-tested too. `nil` is the value
  # `--epic none` asked for, and it must reach the wire as JSON null or the
  # operator gets a 200 for a clear that never happened.
  TOP_SCALAR_FLAGS.each_value { |col| body[col] = top[col] if top.key?(col) }
  body
end

# `<repo>=<url>` pairs for a repo-keyed devops map (pr_urls), sorted by repo and
# with blanks dropped. Deliberately the SAME syntax `--pr-url-for` takes, so a
# read-back round-trips straight back into the write flag.
#
# Renders what is STORED, not the effective register: Task#release_pr_urls folds
# the singular `pr_url` in at read time, and folding it in here would show the
# operator entries they never wrote — the opposite of what a read-back is for.
# The singular is printed on its own line right beside this one.
def map_pairs(value)
  return [] unless value.is_a?(Hash)

  value.reject { |repo, url| repo.to_s.strip.empty? || url.to_s.strip.empty? }
       .sort_by { |repo, _url| repo.to_s }
       .map { |repo, url| "#{repo}=#{url}" }
end

def print_task(task)
  dv = task.dig("metadata", "devops") || {}
  puts "#{task["slug"]}  [#{task["stage"]}]  #{task["title"]}"
  # TWO FACTS, TWO NAMES. This line used to read `agent: <agent_slug>` — the
  # ASSIGNEE — while every agent reading it was checking for the AUTHOR, because
  # the operating model tells them devops.built_by is what keeps a soul off their
  # own PR. `bin/task move <slug> building --actor <soul>` stamps the author and
  # sets no assignee at all, so three of four tasks measured on 2026-08-30 printed
  # `agent: -` while correctly stamped, and two agents filed the blank as an
  # incident. Renaming the label without printing the author would have moved the
  # ambiguity rather than removed it; both facts are printed, under names that say
  # which is which. See bin/lib/task_author_fields.rb.
  puts "  #{TaskAuthorFields.assignee_pair(task)}  #{TaskAuthorFields.pair(task)}  " \
       "kind: #{dv["kind"] || "-"}  repos: #{Array(dv["repositories"]).join(", ")}"
  puts "  branch: #{dv["branch"] || "-"}  pr: #{dv["pr_url"] || "-"}"
  # The epic, only when the task HAS one — most tasks belong to no epic, and the
  # terse view stays terse. `--verbose` prints the column in all three states
  # (print_column_fields), where "no epic" and UNREPORTED must stay distinct.
  puts "  epic: #{task["epic_slug"]}" unless task["epic_slug"].to_s.strip.empty?
  # The per-repo register, only when there IS one — the terse view stays terse for
  # the single-repo task that is most of the board, and a multi-repo task's extra
  # PRs are visible without reaching for --verbose. --verbose prints it always.
  pairs = map_pairs(dv["pr_urls"])
  puts "  pr_urls: #{pairs.join("  ")}" if pairs.any?
  puts "  acceptance: #{Array(dv["acceptance"]).size} item(s)  risk: #{Array(dv["risk_tags"]).join(", ")}"
  print_approval_request_notice(task)
end

# THE MERGE-TIME SURFACE for a carried operator-approval request
# (surface-waiting-request-at-merge). Review may merge while it is waiting, and
# nothing refuses; this makes sure the person merging SEES it. It rides the task
# header, so it prints wherever a reviewer reads a task: `show` (the pre-merge line
# in pr-review-primary.md step 6), and `merged` (after the merge, before the move
# that settles it). STDERR, so a caller capturing stdout parses what it always did.
def print_approval_request_notice(task)
  return unless ApprovalRequestNotice.waiting?(task)

  ApprovalRequestNotice.lines(task, note: latest_handoff_note(task["slug"])).each { |line| warn!(line) }
end

# The latest handoff note: the builder's words beside the request. Soft — an
# unreadable board prints "no handoff note on record" rather than failing the command.
def latest_handoff_note(slug)
  query = URI.encode_www_form(task_slug: slug, activity_type: "handoff", per_page: 1)
  res = TaskBoard.request(:get, "/api/v1/activities?#{query}", base_url: BASE_URL, token: token)
  return nil unless res.code.to_i.between?(200, 299)

  row = Array(TaskBoard.parse_body(res)["data"]).first
  row.is_a?(Hash) ? row["description"] : nil
rescue StandardError
  nil
end

# Print a labeled bullet list (the actual acceptance/test_plan/checks lines), or
# "label: -" when empty — so a human read of a task never needs the curl + token
# dance just to see the acceptance bullets the terse view only counts.
def print_bullets(label, items)
  items = Array(items)
  if items.empty?
    puts "  #{label}: -"
  else
    puts "  #{label}:"
    items.each { |item| puts "    - #{item}" }
  end
end

# The git-location columns, printed UNCONDITIONALLY and never as a bare "-".
#
# `merged` is the field whose absence makes the release sweep skip a `reviewed`
# task as a HELD anomaly, so it is read back constantly — and it used to be the
# one field --verbose did not print, while printing every devops neighbour around
# it. Agents therefore looked in `metadata.devops.merged`, found `null` (nothing
# writes there, on any task), and concluded the stamp had dropped. Three of them
# did, inside 24 hours. `release_slug` rides along because it WAS the same trap
# one step worse: the one name that existed in both universes at once — a
# top-level column (what the release sweep and bin/conductor read) and a
# same-named devops key (written by this CLI's own --release-slug flag and by the
# board edit form, displayed on the task page, read by no release code). That
# shadow is now retired at the server (Task::DEVOPS_COLUMN_KEYS refuses the write
# and sheds any stored value), the flag is gone, and the task page renders the
# column — so printing the COLUMN here agrees with every other surface rather
# than merely making the two tellable apart.
#
# Two properties make that inference impossible now, and both are load-bearing:
#   1. The line is ALWAYS emitted, so a missing value can never be mistaken for a
#      missing feature. Do not make either field conditional.
#   2. TaskColumnFields renders three states, so "empty" ("not merged") and
#      "this board did not return the field" (UNREPORTED) read differently.
# The trailing locator line names WHERE the fields live, which is the lookup
# error that actually cost the time — printed even when the values are set,
# because the worst case was a reader mis-pathing a stamp that WAS there.
# The AUTHORSHIP sources, printed UNCONDITIONALLY — same rule as
# print_column_fields above, for the same reason and after the same kind of
# incident. The terse header already names the author SET; this expands it into
# the three raw fields behind it, so an agent verifying a stamp reads the exact
# paths instead of guessing one. The locator is what actually cost the time: both
# false alarms were lookups in the wrong store, not wrong values.
def print_author_fields(task)
  puts "  #{TaskAuthorFields.source_line(task)}"
  puts "  ↳ #{TaskAuthorFields::LOCATOR}"
end

def print_column_fields(task)
  puts "  #{TaskColumnFields.pair(task, "merged")}   #{TaskColumnFields.pair(task, "release_slug")}   " \
       "#{TaskColumnFields.pair(task, "epic_slug")}"
  # On its own line: the value is a list, so it is the one column here that can
  # grow past the width a shared line survives. Unconditional like its two
  # neighbours, and for the identical reason — a field printed only when set
  # reads, when absent, as "this tool does not report it", which is what sent
  # three agents looking in metadata.devops for a stamp that was never there.
  puts "  #{TaskColumnFields.pair(task, "dependencies")}"
  puts "  ↳ #{TaskColumnFields::LOCATOR}"
end

# The human-readable expansion behind `show --verbose`: the terse header plus the
# fields an agent otherwise had to hand-curl — acceptance BULLETS (not just a
# count), agent_context, test_plan, checks_run, the build-claim state, the
# PR / local URLs, and the top-level git-location columns (`merged` +
# `release_slug`, see print_column_fields).
def print_task_verbose(task)
  print_task(task)
  dv = task.dig("metadata", "devops") || {}
  puts
  print_bullets("acceptance", dv["acceptance"])
  puts "  agent_context: #{dv["agent_context"] || "-"}"
  print_bullets("test_plan", dv["test_plan"])
  print_bullets("checks_run", dv["checks_run"])
# THE CLAIM IS THE DESK (bin/lib/desk_claim.rb): the desks on this machine bound
# to the task, each with its holder's grade. No lease is read.
puts "  claim: desk #{desk_claim_summary(task["slug"] || dv["worktree_slug"])}"
  print_author_fields(task)
  puts "  approval_status: #{dv["approval_status"] || "-"}   requested_by: #{dv["approval_requested_by"] || "-"}   " \
       "requested_at: #{dv["approval_requested_at"] || "-"}   dropped_at: #{dv["approval_request_dropped_at"] || "-"}"
  puts "  pr_url: #{dv["pr_url"] || "-"}   local_url: #{dv["local_url"] || "-"}"
  # THE OPERATOR WINDOWS (devops-v3-design.md section 6), derived server-side and
  # carried on the payload as `windows` — the same list `wait-window` polls. "-"
  # when nothing waits on the operator; else each open window's kind, its mm:ss
  # (or lapsed label) as the board painted it, and the ISO end it counts to.
  if task.key?("windows")
    windows = Array(task["windows"]).map { |w| "#{w["kind"]} #{w["label"]} (ends #{w["ends_at"]})" }
    puts "  windows: #{windows.empty? ? "-" : windows.join(" · ")}"
  end
  # ALWAYS emitted, "-" when empty — the same rule print_column_fields is built
  # on, for the same reason. This is the surface an operator confirms a
  # --pr-url-for write on, and a line that vanishes when the map is empty makes
  # "nothing recorded" indistinguishable from "this CLI cannot show it".
  print_bullets("pr_urls", map_pairs(dv["pr_urls"]))
  # THE ABANDONMENT RECEIPT, on the surface a human actually reads. Its whole
  # purpose is that a later reader can tell a PR dropped ON PURPOSE from one that
  # was forgotten — and until this line existed the only readers that showed it were
  # raw JSON and `orphan-prs`, which lists a PR only while it is still OPEN. So the
  # moment the abandoned PR closed, the record survived in a place no default tool
  # would print. Unconditional, "-" when empty, for print_column_fields' reason:
  # this is where an operator confirms what `--force` just recorded, and a line that
  # vanishes makes "recorded nothing" look like "this CLI cannot show it".
  print_bullets("abandoned_prs", dv[OpenPrGuard::RECORD_KEY])
  print_column_fields(task)
  puts "  review_in_progress: #{task["review_in_progress"] ? "yes" : "no"}" if task.key?("review_in_progress")
  if task.key?("unresolved_feedback")
    feedback = task["unresolved_feedback"]
    summary = feedback && feedback["description"].to_s.strip
    puts "  unresolved_feedback: #{summary && !summary.empty? ? summary : "-"}"
  end
end

# --- Stale check: is a task's work already on origin/main? ------------------
# The directory the stale check runs git in. Defaults to the CLI's own checkout
# (any clone/worktree that shares origin's tracking refs); TASK_GIT_DIR overrides
# it so tests can point git at a throwaway repo with no network.
def git_dir
  dir = ENV["TASK_GIT_DIR"].to_s.strip
  dir.empty? ? File.expand_path("..", __dir__) : dir
end

# Run a git command in git_dir, swallowing stderr. Returns [stdout, success?].
def git(*args)
  out = IO.popen(["git", "-C", git_dir, *args], err: File::NULL, &:read).to_s.strip
  [out, $?.success?]
end

# Resolve a task's STALE disposition — its branch already merged to origin/main
# (work shipped out-of-band) while the task itself hasn't reached shipped/archived.
# The git I/O lives here; the decision is delegated to the pure StaleCheck module.
# Pure of network on its own: the CALLER git-fetches first (once, even for a board
# scan). Returns a result hash {slug:, branch:, stage:, status:} where status is
# one of :terminal :no_branch :on_main :not_merged. A git error leaves on_main
# false, so it NEVER falsely claims "already on main".
def stale_check(task)
  branch = StaleCheck.branch_for(task)
  result = { slug: task["slug"], branch: branch, stage: task["stage"] }
  return result.merge(status: :terminal) if StaleCheck::TERMINAL_STAGES.include?(task["stage"])

  remote_branch = "refs/remotes/origin/#{branch}"
  _ref, exists = git("rev-parse", "--verify", "--quiet", remote_branch)
  on_main = exists && git("merge-base", "--is-ancestor", remote_branch, "refs/remotes/origin/main")[1]
  result.merge(status: StaleCheck.status(task, branch_exists: exists, on_main: on_main))
end

def render_stale(result)
  slug = result[:slug]
  branch = result[:branch]
  case result[:status]
  when :on_main
    puts "⚠  #{slug}: work already on main — origin/#{branch} is an ancestor of origin/main"
    puts "   stage is #{result[:stage]} → consider: #{SELF_CMD} move #{slug} shipped   (or archived)"
  when :not_merged
    puts "#{slug}: origin/#{branch} not yet on main (active — not stale)"
  when :no_branch
    puts "#{slug}: no origin/#{branch} branch to compare — skipped"
  when :terminal
    puts "#{slug}: already #{result[:stage]} — not stale by definition"
  end
end

def refresh_codex_session_title
  return if ENV["CODEX_SESSION_TITLE_RUNNING"] == "1"
  return if ENV["CODEX_THREAD_ID"].to_s.strip.empty?

  script = File.expand_path("codex-session-title", __dir__)
  return unless File.executable?(script)

  system({ "CODEX_SESSION_TITLE_RUNNING" => "1" }, script, out: File::NULL, err: File::NULL)
rescue StandardError
  nil
end

# Genesis trickle-down: the task slug is the single source. Creating/advancing a
# task writes the active-feature marker that bin/statusline (and the terminal
# indicator) read — no worktree required. Worktree sessions override it via their
# own .agent-context.json. Best-effort; never breaks a task command.
def write_feature_marker(task)
  return if ENV["TASK_SKIP_MARKER"] == "1"
  return if Dir.pwd.include?("/.worktrees/")
  # The one condition under which feature_marker_path returns nil — asked HERE, of the
  # session id, rather than by binding the path and testing it for nil. Nothing in this
  # file may hold a raw store path: the containment scan subtracts the path expression
  # the guard was HANDED, so a path that reaches a local first is a path the guard is
  # trusted-not-proven to have seen. See test/lib/state_store_containment_test.rb.
  return if session_identity.first.to_s.strip.empty?

  slug = task["slug"].to_s
  return if slug.empty?

  # Committed to a write from here — so guard it before we even READ the existing
  # marker (below) out of what might be the operator's real state dir. Under
  # TASK_USAGE_SANDBOX an unpinned CLAUDE_PROJECTS_DIR aborts instead of falling
  # back to <projects>/.agents/sessions. See lib/task_usage_sandbox.rb.
  path = TaskUsageSandbox.enforce!(feature_marker_path, store: "session-marker")

  dv = task.dig("metadata", "devops") || {}
  mascot, mascot_color, mascot_emoji, mascot_shiny = marker_mascot_attrs(task, path)
  marker = {
    "slug" => slug,
    "task_slug" => slug,
    "app" => Array(dv["repositories"]).first,
    "feature" => dv["worktree_slug"],
    "worktree_slug" => dv["worktree_slug"],
    "task_url" => "#{BASE_URL}/tasks/#{slug}",
    "stage" => task["stage"],
    "mascot" => mascot,             # bin/statusline renders <type-emoji> <mascot> — the session's Pokémon handle
    "mascot_color" => mascot_color, # …tinted with the mascot's least-common type color, riding with the name
    "mascot_emoji" => marker_display_emoji("mascot_emoji" => mascot_emoji, "mascot_shiny" => mascot_shiny), # …and carries its type emoji(s), with ✨ when shiny
    "mascot_shiny" => (true if truthy_marker_value?(mascot_shiny)),
    "persona" => dv["persona"],     # present only for a deliberate "act as <soul>" override
    "app_color" => dv["app_color"]  # the app's status-line tint (App#color, stamped server-side by Task#sync_app_identity)
  }.reject { |_, v| v.nil? || v.to_s.strip.empty? }

  # Write-once genesis: the first task this session claims is why the session
  # exists. A later create/move/block repoints the ACTIVE fields above; the
  # on-disk genesis is carried forward verbatim (FeatureMarker.genesis).
  marker.merge!(FeatureMarker.genesis(existing_marker(path),
                                      "genesis_slug" => slug,
                                      "genesis_feature" => dv["worktree_slug"] || slug,
                                      "genesis_url" => "#{BASE_URL}/tasks/#{slug}",
                                      "genesis_at" => Time.now.utc.strftime("%Y-%m-%dT%H:%M:%SZ")))

  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, "#{JSON.pretty_generate(marker)}\n")
  refresh_codex_session_title
rescue StandardError
  nil
end

# The marker's mascot AND its display attributes (color + type emoji), resolved
# TOGETHER so the color/emoji always ride with the name. Returns [mascot, color,
# emoji, shiny].
#
# The session's mascot is STICKY — once the per-session marker carries one, a later
# `create`/`move` updates the app/feature/stage context (write_feature_marker) but
# does NOT swap in the MOVED task's mascot. Why: a task's devops carries `mascot`
# (a DEVOPS_KEY) but the board does NOT serve mascot_color/mascot_emoji with it
# (they're server-owned, NOT DEVOPS_KEYS — see Task::DEVOPS_SCALAR_KEYS), so
# adopting a task's mascot dropped bin/statusline to its color/emoji-less pink
# 🛠 ⊙ fallback every time you reviewed someone else's task. The reliable source
# of a mascot WITH its color+emoji is the session marker that `bin/task
# session-mascot` writes from the /sessions/:id/mascot endpoint (which DOES return
# them). So: pin that. Order:
#   1. a PERSONA ("act as <soul>") on this task — a deliberate identity change the
#      server stamped with the soul's name+color+emoji; let it override.
#   2. the last-good on-disk marker — the sticky session mascot (its color/emoji).
#   3. this task response — only when disk has none yet (a fresh session that
#      skipped the session-mascot hook); SessionMascot makes it the session handle
#      anyway, and any missing color/emoji renders clean (never the pink glyphs).
#   4. a best-effort board read (name only).
def marker_mascot_attrs(task, path)
  dv = task.dig("metadata", "devops") || {}
  if FeatureMarker.present?(dv["persona"]) && FeatureMarker.present?(dv["mascot"])
    return [dv["mascot"], dv["mascot_color"], dv["mascot_emoji"], nil]
  end

  disk = existing_marker(path)
  if disk && FeatureMarker.present?(disk["persona"]) &&
     !FeatureMarker.present?(dv["persona"]) && FeatureMarker.present?(dv["mascot"])
    return [dv["mascot"], dv["mascot_color"], dv["mascot_emoji"], dv["mascot_shiny"]]
  end
  return [disk["mascot"], disk["mascot_color"], disk["mascot_emoji"], disk["mascot_shiny"]] if disk && FeatureMarker.present?(disk["mascot"])

  return [dv["mascot"], dv["mascot_color"], dv["mascot_emoji"], dv["mascot_shiny"]] if FeatureMarker.present?(dv["mascot"])

  [board_mascot(task["slug"]), nil, nil, nil] # a board read carries the name only
end

def existing_marker(path)
  return nil unless path && File.exist?(path)

  JSON.parse(File.read(path))
rescue StandardError
  nil
end

def session_marker_persona
  marker = existing_marker(feature_marker_path)
  persona = marker && marker["persona"].to_s.strip
  persona unless persona.to_s.empty?
end

def default_block_actor(task, kind)
  return "avi" if kind.to_s == "rework" && task.is_a?(Hash) && task["stage"].to_s == "submitted"

  nil
end

# ---------------------------------------------------------------------------
# Two-bounce circuit breaker — the READ (bin/lib/bounce_ledger.rb owns the rules).
#
# This used to be prose in three SOPs telling each agent to GET the activities
# endpoint and count the rows, and the hand-rolled form answered ZERO for every
# task on the planet because Net::HTTPResponse#[] reads HTTP headers. Nobody
# hand-rolls it now: the read lives here, and every failure raises instead of
# counting.
# ---------------------------------------------------------------------------

# Pages the task's qa_feedback activities and returns a BounceLedger::Verdict.
# Raises BounceLedger::UnreadableResponse on ANY answer it cannot trust. It does
# NOT go through `api` on purpose: `api` uses TaskBoard.parse_body, whose lenient
# `rescue {}` turns a non-JSON body into an empty hash — the exact "quietly answer
# zero" shape this command exists to refuse.
BOUNCE_PAGE_SIZE = 100
BOUNCE_MAX_PAGES = 10

def bounce_verdict(slug, verify_task: true)
  # A TASK THAT DOES NOT EXIST MUST NOT READ AS CLEAR. The activities endpoint
  # filters by task_slug and answers a 200 with an EMPTY data array for a slug
  # nobody has ever heard of — so a typo, a renamed slug, or a stale handle scores
  # zero bounces and green-lights the block. That is the same defect this whole
  # command exists to kill, one layer out, and it is not hypothetical: the first
  # smoke test of this command hit it. `api` die!s with EXIT_TASK_NOT_FOUND when
  # the board POSITIVELY answers "no such task", so an unknown slug is refused
  # rather than cleared. (`verify_task: false` exists for a caller that has already
  # fetched the task and would only be paying for the round trip twice.)
  api(:get, "/api/v1/tasks/#{slug}") if verify_task

  rows = []
  page = 1
  loop do
    query = URI.encode_www_form(task_slug: slug, activity_type: "qa_feedback",
                                per_page: BOUNCE_PAGE_SIZE, page: page)
    res = TaskBoard.request(:get, "/api/v1/activities?#{query}", base_url: BASE_URL, token: token)
    payload = BounceLedger.payload_from(res)
    page_rows = BounceLedger.from_payload(payload).rows
    rows.concat(page_rows)

    # Stop on the LAST page, not on "the server reported more than this page holds"
    # — meta.total counts the whole filtered set, so comparing it to one page's
    # size stays true forever and would walk empty pages to the cap.
    break if page_rows.size < BOUNCE_PAGE_SIZE
    break unless BounceLedger.truncated?(payload.merge("data" => rows))
    break if (page += 1) > BOUNCE_MAX_PAGES
  end
  BounceLedger::Verdict.new(rows: rows)
end

def print_bounce_verdict(slug, verdict)
  if verdict.tripped?
    puts "BREAKER: TRIPPED — #{verdict.count} prior send-back(s) on #{slug}"
  else
    puts "BREAKER: CLEAR — no prior send-back on #{slug} " \
         "(#{verdict.rows.size} qa_feedback row(s) read, none countable)"
  end
  verdict.rows.each_with_index do |row, i|
    mark = row.countable? ? "counts" : "not a bounce"
    puts "  #{i + 1}. #{row.created_at} [#{row.kind}] #{row.summary} (#{mark})"
  end
  puts "  by kind: #{verdict.by_kind.map { |k, n| "#{k} #{n}" }.join(", ")}" unless verdict.rows.empty?
  return unless verdict.tripped?

  puts ""
  puts "  A repeat bounce is a review DEADLOCK, and a deadlock is the operator's call."
  puts "  Do NOT re-block to the builder. Escalate instead:"
  # No block is in flight here, so there is no `blocker` to echo — resolve the
  # reader's own soul from their session marker instead, and fall back to the
  # visible blank when even that is silent. Never to a default: a confidently
  # wrong soul is worse than one the reader can see is missing.
  puts "    #{BlockRecipe.escalation(slug, agent: resolved_block_actor(nil, nil, kind: "dependency"))}"
end

def resolved_block_actor(explicit_agent, task, kind: nil)
  explicit = explicit_agent.to_s.strip
  return explicit unless explicit.empty?

  devops = task.is_a?(Hash) ? task.dig("metadata", "devops") : {}
  [session_marker_persona, devops&.fetch("persona", nil), default_block_actor(task, kind)].each do |candidate|
    actor = candidate.to_s.strip
    return actor unless actor.empty?
  end

  ""
end

# The board's devops.mascot, read in a SUBPROCESS via `bin/task field` — never
# in-process. The board read is the last, lowest-priority fallback source, so it
# must NEVER be able to abort the command that's only writing a marker: an
# in-process api() call would, on a transient non-2xx board read, hit api's die!
# → exit 1 → SystemExit, which is NOT a StandardError and so escapes both this
# rescue and write_feature_marker's — killing the move/create AFTER its server
# op already succeeded. Shelling out contains any `exit` in the child (the
# backtick yields "" on a child failure), the same isolation
# bin/agent-worktree.resolve_mascot relies on. `field` is silent + exit 0 when
# the mascot is unset, so a clean "no mascot" reads back as "".
def board_mascot(slug)
  slug = slug.to_s
  return nil if slug.empty?

  mascot = `#{__dir__}/task field #{slug.shellescape} mascot 2>/dev/null`.to_s.strip
  mascot.empty? ? nil : mascot
rescue StandardError
  nil
end

# --- Auto-captured move usage (best-effort) --------------------------------
# Per-(session, slug) baselines of cumulative token usage live under .agents
# (not committed); TASK_USAGE_DIR overrides the dir (tests point it at a tmp
# path). The storage + delta math is shared with bin/release + bin/reviewer-select
# via lib/task_usage_baseline.rb so every move/intent path computes deltas the
# same way.
#
# The fallback below is a LIVE-STORE write, so it is sandbox-guarded: under
# TASK_USAGE_SANDBOX (every test process) an unset TASK_USAGE_DIR ABORTS rather
# than falling back here. That fallback, unpinned by test/lib/task_cli_test.rb,
# is exactly how a test child once wrote a 1.9-billion-token fixture row into the
# operator's real cost store. See lib/task_usage_sandbox.rb.
def usage_dir
  pinned = ENV["TASK_USAGE_DIR"].to_s.strip
  # The raw fallback is an ARGUMENT to the guard, never a local the guard is told about
  # afterwards. The containment scan subtracts what enforce! was handed and re-asks the
  # path question of what is left, so a path that lands in a local first is a path the
  # scan cannot prove was laundered — and it says so.
  TaskUsageSandbox.enforce!(
    pinned.empty? ? File.join(PROJECTS_DIR, ".agents", "task-usage") : pinned,
    store: "task-usage"
  )
end

# The baseline store for THIS session, or nil when there's no session (a plain
# shell / CI run has no transcript to diff anyway).
def usage_baseline_for(session, provider: "claude")
  session = session.to_s.strip
  return nil if session.empty?

  TaskUsageBaseline.new(session: session, provider: provider, dir: usage_dir)
end

# Seed the per-(session, slug) baseline from the session's current cumulative
# totals when the session first TOUCHES the task — at CREATE (so the design phase
# is measured), at the build CLAIM (move→building), and at a review/deploy INTENT.
# Idempotent (never resets an in-progress baseline) and best-effort. Seeding here
# is what makes the first real WORK transition record a true delta instead of the
# zeroed first-move baseline (the cause of the model-only Submitted→Reviewed chip,
# and its design-phase twin, the model-only Designed→Building chip).
def seed_usage_baseline(slug)
  session, provider = session_identity
  usage_baseline_for(session, provider: provider)&.seed(slug)
rescue StandardError
  nil
end

# Fill the event's model/tokens/cost from the session transcript (the delta since
# the last touch — claim, intent, or prior move), then advance the baseline. No
# session, no transcript, or no baseline yet → record at most the model; the
# deterministic spine is recorded server-side regardless.
def autofill_move_usage(event, slug)
  session, provider = session_identity
  baseline = usage_baseline_for(session, provider: provider)
  return unless baseline

  capture = baseline.capture_delta(slug)
  return unless capture

  event["model"] = capture.model if capture.model
  return unless capture.usage?

  event["tokens_in"]  = capture.tokens_in
  event["tokens_out"] = capture.tokens_out
  # The un-folded cache buckets ride alongside the folded tokens_in so the SERVER can
  # re-derive this event's cost at an operator's overridden rate — this process has no
  # ActiveRecord and prices at LIST rate only, so `cost` below is just the fallback.
  event["cache_creation_tokens"] = capture.cache_creation_tokens
  event["cache_read_tokens"]     = capture.cache_read_tokens
  event["cost"]       = format("%.4f", capture.cost) if capture.cost
rescue StandardError
  # A capture failure must degrade to spine-only, never abort the move (and its
  # stage-transition PATCH). The lib swallows IO errors; this is belt-and-braces.
  nil
end

# --- Persistence verification: never report success on a write that didn't land
# A best-effort AUTHORITATIVE read of a task's current stage, used to VERIFY a
# just-issued stage move actually persisted. Deliberately NOT api(): a non-2xx or
# transport failure here returns nil (we could not verify) instead of die!-ing. A
# failed VERIFICATION read is not proof the write failed, and the standing
# invariant that a transient board read never aborts a move whose PATCH already
# landed (see board_mascot) holds. Returns the persisted stage String, or nil
# when the board could not be read back.
def read_back_stage(slug)
  res = TaskBoard.request(:get, "/api/v1/tasks/#{slug}", base_url: BASE_URL, token: token)
  return nil unless res.code.to_i.between?(200, 299)

  data = TaskBoard.parse_body(res)["data"]
  data.is_a?(Hash) ? data["stage"].to_s : nil
rescue StandardError
  nil
end

# CONFIRM a stage move actually landed before reporting success. The board can
# answer a stage PATCH with 200 while the transition never persisted — a
# server-side save that fails silently returns the assigned-but-UNSAVED in-memory
# record, so the response echoes the requested stage and bin/task prints
# "[submitted]" and exits 0 while a fresh read still shows "building". A task
# stranded that way is invisible to reviewers and skipped by the qa-release
# sweep, and its handoff LIES (it once made a supervisor misread the failed write
# as a rival session re-claiming the task). So after the PATCH, read the task
# back and compare: on a DEFINITE mismatch, exit NONZERO and say so loudly (never
# the success line). A read we could not complete (nil) degrades to the prior
# behavior rather than abort — an unverifiable read is not proof of a failed write.
def verify_move_persisted!(slug, expected_stage)
  persisted = read_back_stage(slug)
  return if persisted.nil? || persisted == expected_stage

  warn!("✗ move NOT persisted: #{slug} → #{expected_stage} reported success, but a fresh read of the board still shows [#{persisted}].")
  warn!("  The stage-transition write did not land — the task has NOT moved. Do not hand it off as #{expected_stage}.")
  warn!("  Re-run: #{SELF_CMD} move #{slug} #{expected_stage}   (if it recurs the board write is failing server-side — check ErrorLog).")
  exit 1
end

# The `merged` twin of read_back_stage — the git-location crash-recovery signal
# (nil/accepted/release/main). Same degrade-on-unverifiable contract: a non-2xx
# or transport error returns nil (could not verify), never an abort. Empty string
# means the board read the task back with no merged stamp.
def read_back_merged(slug)
  res = TaskBoard.request(:get, "/api/v1/tasks/#{slug}", base_url: BASE_URL, token: token)
  return nil unless res.code.to_i.between?(200, 299)

  data = TaskBoard.parse_body(res)["data"]
  data.is_a?(Hash) ? data["merged"].to_s : nil
rescue StandardError
  nil
end

# CONFIRM a `merged` stamp actually landed before reporting success — the twin of
# verify_move_persisted!. A dropped git-location write is not cosmetic: the sweep
# classifies a `reviewed` member with merged:"" as a HELD anomaly and leaves it
# behind, so a silently-non-persisting stamp would strand the task off every RC.
# On a DEFINITE mismatch exit nonzero + loud; an unverifiable read (nil) degrades
# to the prior behavior (not proof of a failed write).
def verify_merged_persisted!(slug, expected)
  # A 200 is not persistence: confirm the stamp by reading it back. Only an EXACT match
  # passes — a blank value (the write dropped) AND an unreadable board (the read-back GET
  # failed) both stay unconfirmed. The old code returned on a nil read-back, treating an
  # unreadable board as verified; under load the PATCH drops and the GET fails together, so
  # that silent pass is exactly how a dropped stamp reached a `reviewed` member as merged:None
  # (2026-07-21). Retries survive a transient read miss without accepting a genuine drop.
  return if StampConfirmation.confirmed?(expected,
                                         read_back: -> { read_back_merged(slug) },
                                         sleeper: ->(seconds) { sleep(seconds) })

  last = read_back_merged(slug)
  shown = last.nil? ? "unreadable" : (last.empty? ? "nil" : last)
  warn!("✗ merged NOT persisted: #{slug} → merged:#{expected} reported success, but the read-back shows merged:[#{shown}].")
  warn!("  A failed read is NOT a confirmation — the git-location write did not land (or the board is unreadable); the sweep treats an unstamped `reviewed` member as an anomaly and leaves it behind.")
  warn!("  Re-run: #{SELF_CMD} merged #{slug} #{expected}   (if it recurs the board write is failing server-side — check ErrorLog / PG connections).")
  exit 1
end

# --- Fast lane: `begin` ------------------------------------------------------

# THE FLAGS `begin` HONOURS ON A RESUME — the single source, read back by the
# wiring guard in test/commands/task_begin_flag_grammar_test.rb. DERIVED FROM
# WHAT THE CODE READS, not from what feels like a create flag: an earlier draft
# omitted --repo and thereby turned a WORKING flag into a refused one.
#   --slug     the resume key                       (read as top["slug"])
#   --repo     picks the app whose desk is allocated (read as lists["repositories"])
#   --agent    forwarded to the claim as --actor     (read as top["agent"])
#   --dev-size forwarded to the claim on BOTH branches (read as top["dev_size"])
#   --steal    consumed before parse_flags, then forwarded to the claim gate
# If you add a flag here, WIRE IT FIRST — an advertised flag no branch reads is
# the silent drop this whole guard exists to remove.
BEGIN_RESUME_FLAGS = %w[--slug --repo --agent --dev-size --steal].freeze

# REFUSE — never drop — a create flag on a path that cannot honour it.
#
# TWO DOORS REACH A RESUME, and keying on only the first is the defect this
# replaces:
#   1. NO --title. `begin` cannot create at all, so every create flag is inert.
#      This door is decided in argument parsing, BEFORE the board lookup, and it
#      stays there on purpose: the refusal must not depend on the network.
#   2. THE TASK ALREADY EXISTS. `begin` resumes it, so every create flag is inert
#      here TOO — including when --title was passed. This is the door a real
#      builder walks through, because `begin` is advertised as resumable and
#      re-running it is normal: `bin/task begin --title "Some Existing Title"
#      --shape backend` accepted --shape and dropped it in silence. Only the task
#      EXISTING makes a create flag inert; a blank title is merely one way to get
#      there. --title itself stays legal on this door — it is how a re-run names
#      the task whose slug it derives.
def refuse_inert_create_flags!(raw_argv, because:, hint_lead:, also_valid: [], update_target: "<slug>", tail: nil)
  valid = BEGIN_RESUME_FLAGS + also_valid
  raw_argv.each do |arg|
    next unless arg.to_s.start_with?("--")
    next if valid.include?(arg)

    unknown_flag!(arg, valid: valid, context: "begin's resume form (#{because})",
                  hint: "#{hint_lead} — set it on the existing task with " \
                        "`#{SELF_CMD} update #{update_target} #{arg} ...`#{tail}")
  end
end

# The task record for `begin`'s resume decision: the data on 2xx, nil on the
# board's POSITIVE "task not found" (create it), die on everything else — a
# failed read must never be read as "no such task" (that is the same contract
# task_not_found_response? guards for the worktree reclaim path).
def fetch_task_for_begin(slug)
  res = TaskBoard.request(:get, "/api/v1/tasks/#{slug}", base_url: BASE_URL, token: token)
  parsed = TaskBoard.parse_body(res)
  return parsed["data"] if res.code.to_i.between?(200, 299)
  return nil if task_not_found_response?(res, parsed)

  die!("GET /api/v1/tasks/#{slug} -> #{res.code}: #{parsed["error"] || res.body}")
end

# THE DESK'S GIT IDENTITY, reconciled against the claim that just landed
# (turf-monster-git-identity-wrong).
#
# `new` stamped the desk from --agent, the builder begin was TOLD about. The
# authoritative soul is the one the claim RECORDED — devops.built_by, the value
# bin/ship authors its own commit from (CommitIdentity.soul_of) — and it differs
# from --agent in exactly the cases Task#builder_to_stamp resolves without one: a
# resume with no --agent keeps the builder already on record, and a create with no
# --agent falls to the persona or the assignee. Reading the claim back, rather than
# re-deriving that chain here, is what keeps a hand commit in the desk and the ship
# commit spelling the SAME soul; a client-side copy of the chain would drift.
#
# NEVER FATAL. Every failure below leaves a whole desk and a claimed task, so it
# warns with the exact remedy instead of dying past the claim — the same posture
# `bin/agent-worktree new` takes toward a stamp that does not land.
def reconcile_desk_identity(slug, app, worktree_slug, worktree_bin, stamped:)
  remedy = "#{worktree_bin} identity #{app} #{worktree_slug} <soul>"
  res = TaskBoard.request(:get, "/api/v1/tasks/#{slug}", base_url: BASE_URL, token: token)
  unless res.code.to_i.between?(200, 299)
    warn!("begin 4/5 identity — could not read #{slug}'s builder back (HTTP #{res.code}), so the desk keeps " \
          "whatever identity `new` printed above. Once the board answers: #{remedy}")
    return
  end

  soul = CommitIdentity.soul_of(TaskBoard.parse_body(res).dig("data", "metadata", "devops"))
  if soul.nil?
    warn!("begin 4/5 identity — #{slug} names NO builder (devops.built_by is blank), so the desk is UNSTAMPED: " \
          "a hand-run git commit there names no soul. Claim it with --agent <soul>, or stamp it: #{remedy}")
    return
  end
  # `new --soul` already stamped exactly this soul and printed the result.
  return if soul == stamped

  warn!("begin 4/5 identity — #{worktree_bin} identity #{app} #{worktree_slug} #{soul}   (the claim recorded #{soul})")
  return if system(worktree_bin, "identity", app, worktree_slug, soul)

  warn!("  ✗ the desk identity did not land — hand commits there will not name #{soul}. " \
        "Fix what it printed above, then: #{worktree_bin} identity #{app} #{worktree_slug} #{soul}")
rescue StandardError => e
  # A board read that RAISES (connection refused, timeout) is the same non-answer as
  # a non-2xx — and must be just as non-fatal, or a network blip past the claim kills
  # a begin whose desk and claim are both already whole.
  warn!("begin 4/5 identity — could not read #{slug}'s builder back (#{e.class}: #{e.message}); " \
        "the desk keeps whatever identity `new` printed above. Once the board answers: " \
        "#{worktree_bin} identity #{app} #{worktree_slug} <soul>")
end

# One begin step that shells a tool: narrate, run, die with a RESUME hint on
# failure — rerunning `bin/task begin <slug>` continues from the failed step.
def begin_step!(label, slug, *cmd, chdir: nil)
  warn!("begin #{label} — #{cmd.join(" ")}#{chdir ? " (from #{chdir})" : ""}")
  opts = chdir ? { chdir: chdir } : {}
  return if system(*cmd, **opts)

  die!("#{label} failed — fix what it printed above, then re-run: #{ClaimHolder::TASK_COMMAND} begin #{slug}   (it resumes).")
end

cmd = ARGV.shift || "help"
case cmd
when "list"
  # --reviewable is a boolean filter (submitted PRs with NO live review claim — the
  # parallel-review queue). Strip it before parse_flags (which rejects any flag not
  # in PARSE_FLAG_NAMES) and pass it through as a query param: the same read as
  # GET /api/v1/tasks?reviewable=1, powered by the Task.reviewable scope.
  reviewable = !ARGV.delete("--reviewable").nil?
  # --json prints the FETCHED RECORDS, not the three-column rendering — the same
  # payload `show --json` prints, one array for the whole page. The read already
  # returns full records; only the rendering was lossy. It exists so a caller that
  # needs N tasks makes ONE board read instead of N `show` calls: bin/agent-worktree's
  # reclaim sweep resolved a build claim per desk, and at 141 desks that serialised
  # into a sweep that never finished.
  as_json = !ARGV.delete("--json").nil?
  # --all walks every page (as --json does) but keeps the three-column rendering.
  # Without it a bare list shows one page of 20 and says so in its total line.
  every_page = as_json | !ARGV.delete("--all").nil?
  # --json is for callers that DECIDE on the record, so it asks the index for the
  # show-shaped row (full=1) and for every page, not the default 20. A batch that
  # silently carried the raw row would answer review_in_progress/gate_in_flight
  # with nil, and a guard reading nil as "no" frees a desk it should hold.
  _pos, _sc, _ls, top = parse_flags(ARGV, context: "list")
  q = []
  q << "stage=#{top["stage"]}" if top["stage"]
  q << "agent_slug=#{top["agent"]}" if top["agent"]
  # `--epic <slug>` narrows to that epic's tasks (GET /api/v1/tasks?epic=). The
  # clear token is meaningless as a filter — it would read as "everything" — so
  # it dies here rather than silently listing the whole board.
  if top.key?("epic_slug")
    die!("list --epic needs an epic slug to filter on (the clear token is not a filter)") if top["epic_slug"].nil?
    q << "epic=#{top["epic_slug"]}"
  end
  q << "reviewable=1" if reviewable
  q << "full=1" if as_json
  q << "per_page=#{LIST_JSON_PER_PAGE}" if every_page
  path = "/api/v1/tasks#{q.empty? ? "" : "?#{q.join("&")}"}"
  # A board that predates `full` rejects it with a 400 naming the param. Degrade to
  # the raw listing rather than dying: this CLI ships in worktrees and CI while the
  # board deploys on its own cadence, so the two are ALWAYS briefly out of step.
  # The raw rows are still a truthful listing — they are simply missing the derived
  # fields, and every consumer that DECIDES on them is required to notice that for
  # itself (see bin/agent-worktree's BATCH_REQUIRED_FIELDS).
  first = begin
    api(:get, path)
  rescue SystemExit
    raise unless as_json

    q -= ["full=1"]
    path = "/api/v1/tasks?#{q.join("&")}"
    warn "note: this board does not serve full=1 yet; listing raw rows (derived fields absent)"
    api(:get, path)
  end
  tasks = first["data"] || []
  # The index's meta.total: how many rows the filter matches across every page.
  total = first.dig("meta", "total")
  # Walk the remaining pages so --json is the WHOLE set, not the newest page. The
  # index caps per_page at 100, and Task.recent is newest-first: a single page
  # would hand a batch caller the newest 20 — i.e. exactly the live work — and
  # silently omit the rest.
  if every_page
    page = 1
    while tasks.size == (page * LIST_JSON_PER_PAGE)
      page += 1
      more = api(:get, "#{path}&page=#{page}")["data"] || []
      break if more.empty?

      tasks += more
    end
  end
  if as_json
    puts JSON.pretty_generate(tasks)
  else
    tasks.each { |t| puts "#{t["slug"]}  [#{t["stage"]}]  #{t["title"]}" }
    # Say so when this is one page of a longer list: a bare "(20 task(s))" read as
    # the whole board, and the rest was silently missing.
    if total.is_a?(Integer) && total > tasks.size
      puts "(#{tasks.size} of #{total} — pass --all or --json for every row)"
    else
      puts "(#{tasks.size} task(s))"
    end
  end
when "show"
  usage = "usage: #{$PROGRAM_NAME} show <slug> [--json | --verbose|-v]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  show_flags = %w[--json --verbose -v]
  ARGV.each { |arg| unknown_flag!(arg, valid: show_flags, context: "show") unless show_flags.include?(arg) }
  data = api(:get, "/api/v1/tasks/#{slug}")["data"]
  if ARGV.include?("--json")
    # The full fetched record, machine-readable — no curl + auth-token dance.
    puts JSON.pretty_generate(data)
  elsif ARGV.include?("--verbose") || ARGV.include?("-v")
    print_task_verbose(data)
  else
    print_task(data)
  end
when "field"
  # Machine-readable single field — e.g. `bin/task field <slug> mascot`. Prints
  # just the value (no decoration) so scripts can capture it; silent + exit 0
  # when unset, so callers can treat it as optional. A repo-keyed MAP (`pr_urls`)
  # prints one `<repo>=<url>` per line — see the Hash branch below.
  #
  # Resolution order, and why it is not uniform:
  #
  #   • TaskColumnFields::COLUMN_NAMES (`merged`, `release_slug`) resolve from the
  #     COLUMN, full stop — never from devops. These names are column-backed, and a
  #     devops-first lookup on them is the machine-readable half of the two-universe
  #     bug: `show --verbose` would print the column while `field` printed a stale
  #     shadow for the same task, in the surface scripts capture from. One store per
  #     name, and the same store as --verbose.
  #   • Everything else keeps devops-first with a column fallback, so ordinary
  #     callers (`field <slug> mascot|branch|worktree_slug`) are untouched.
  #
  # The shadow is unwritable server-side now (Task::DEVOPS_COLUMN_KEYS), so this is
  # belt-and-braces — but it is the belt that makes the CLI honest against a row
  # written before that landed.
  usage = "usage: #{$PROGRAM_NAME} field <slug> <devops-key-or-column>"
  slug = positional!(ARGV.shift || die!(usage), usage)
  key  = positional!(ARGV.shift || die!(usage), usage)
  record = api(:get, "/api/v1/tasks/#{slug}")["data"] || {}
  value =
    if TaskColumnFields::COLUMN_NAMES.include?(key)
      record[key]
    else
      devops_value = record.dig("metadata", "devops", key)
      devops_value.nil? ? record[key] : devops_value
    end
  if value.is_a?(Hash)
    # Repo-keyed MAP (pr_urls): one `<repo>=<url>` per line, which is what makes
    # `field` a read-back at all for this key. It used to fall through the
    # Enumerable guard below — a Hash IS Enumerable — and print NOTHING at exit 0,
    # indistinguishable from unset, in the surface scripts capture from. An
    # operator could write turf's PR url and have no way to confirm it landed.
    # An empty map still prints nothing, and correctly so: the server drops an
    # empty map, so empty and unset are the same state.
    puts map_pairs(value)
  elsif value.is_a?(Array)
    # LIST column (dependencies): one slug per line — the shape a script consumes
    # (`bin/task field <slug> dependencies | while read dep`) and the shape that
    # feeds straight back into `--depends-on`. Without this branch it would fall
    # through the Enumerable guard below and print NOTHING at exit 0, which is
    # the identical defect the Hash branch above was added to fix: a read-back
    # that cannot distinguish "declared" from "unset" is not a read-back, and
    # this field's whole failure mode is a write that reached nothing. An empty
    # list still prints nothing, correctly — there is nothing declared.
    puts value.map { |entry| entry.to_s.strip }.reject(&:empty?)
  else
    print value unless value.nil? || value.is_a?(Enumerable)
  end
when "stale"
  # Flag work that's already on origin/main while its task lags behind (fixed
  # out-of-band). One `git fetch` then a local ancestry check. With a slug, check
  # that one task; with none, scan every open task and list the stale ones.
  slug = ARGV.shift
  slug = positional!(slug, "usage: #{$PROGRAM_NAME} stale [<slug>]") if slug
  git("fetch", "-q", "origin")
  if slug
    render_stale(stale_check(api(:get, "/api/v1/tasks/#{slug}")["data"]))
  else
    tasks = api(:get, "/api/v1/tasks")["data"] || []
    stale = tasks.reject { |t| StaleCheck::TERMINAL_STAGES.include?(t["stage"]) }
                 .map { |t| stale_check(t) }
                 .select { |r| r[:status] == :on_main }
    stale.each { |r| render_stale(r) }
    puts "(#{stale.size} stale task(s) — work on main but not shipped/archived)"
  end
when "orphan-prs"
  # READ-ONLY. The inverse of the archive gate: a PR still OPEN whose task is already
  # ARCHIVED. The work is neither merged nor closed and no board state describes it,
  # so nothing downstream will ever raise its hand about it again.
  #
  # WHY IT EXISTS SEPARATELY FROM THE GATE. `bin/release archive` flips shipped tasks
  # through Release::Conductor.archive_completed! — the MODEL path — which by design
  # bypasses the CLI gate entirely (see lib/archive_holder_guard.rb, "THIS GATE IS
  # THE CLI PATH, DELIBERATELY"). So the gate cannot be the only answer even in
  # principle, and it says nothing at all about the orphans already on the board:
  # studio-engine #245 sat open under an archived task for a month and surfaced only
  # because a human asked for a backlog audit.
  #
  # NEVER BLOCKS — it exits 0 whether or not it found anything, the same policy
  # bin/devops-reconcile fixes for the same reason.
  as_json = false
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--json" then as_json = true
    else unknown_flag!(flag, valid: %w[--json], context: "orphan-prs")
    end
  end
  tasks = fetch_archived_tasks
  index = archived_pr_index(tasks)
  findings = []
  index.values.map { |entry| entry[:repo] }.uniq.sort.each do |repo|
    numbers = gh_open_pr_numbers(repo)
    if numbers.nil?
      # A failed read is not a clean read. Say which repo went unchecked, or the
      # summary line below silently understates the board.
      warn "warning: #{repo}: could not list open PRs — NOT checked. " \
           "Usually a stale token: eval \"$(#{GH_AUTH_REFRESH_CMD} --export)\""
      next
    end
    numbers.each { |number| findings << index["#{repo}##{number}"] if index["#{repo}##{number}"] }
  end
  # Forgotten first — those are the ones needing a decision. A deliberate
  # abandonment is already decided and only needs to stay visible.
  findings.sort_by! { |f| [f[:deliberate] ? 1 : 0, f[:repo], f[:number].to_i] }
  if as_json
    puts JSON.pretty_generate(findings.map { |f| f.transform_keys(&:to_s) })
  else
    findings.each do |finding|
      mark = finding[:deliberate] ? "abandoned on purpose" : "ORPHANED"
      puts "#{mark}  #{finding[:repo]}##{finding[:number]}  #{finding[:url]}"
      puts "   task /tasks/#{finding[:slug]} is archived while this PR is still open"
      unless finding[:deliberate]
        puts "   decide: gh pr merge/close it, or revive the task (`archived` is not a lock)"
      end
    end
    forgotten = findings.count { |f| !f[:deliberate] }
    puts "(#{forgotten} orphaned PR(s), #{findings.size - forgotten} deliberately abandoned, " \
         "across #{tasks.size} archived task(s))"
  end
when "create"
  # --no-claim: file the task WITHOUT repointing this session's active-feature
  # marker at it. Filing a task is not building it — a conductor (bin/release)
  # opening a batch of follow-ups must not drag its status line (and its live
  # build-claim) onto each fresh `designed` task. Stripped before parse_flags so
  # it never lands in positionals or the request body.
  no_claim = !ARGV.delete("--no-claim").nil?
  _pos, scalars, lists, top = parse_flags(ARGV, context: "create")
  die!("create needs --title") unless top["title"]
  devops = stamp_session(build_devops({}, scalars, lists))
  body = top_body(top)
  body["devops"] = devops unless devops.empty?
  task = api(:post, "/api/v1/tasks", body)["data"]
  # Seed the usage baseline at CREATE so the design phase is measured: the first
  # work transition (designed→building) then diffs against the session's totals
  # AT creation and records the real design-phase token delta — instead of the
  # zeroed first-move baseline that dropped the "Designed → Building" card to a
  # model-only chip (TOKENS — / COST —). Same fix shape as the build-claim and
  # intent seeds; idempotent + best-effort, and a no-op without a transcript.
  seed_usage_baseline(task["slug"]) if task.is_a?(Hash) && task["slug"]
  write_feature_marker(task) unless no_claim
  print_task(task)
when "begin"
  # The fast-lane SESSION-START wrapper: create → worktree → bind → claim →
  # preflight, one command, idempotent at every seam. Orchestration ONLY — the
  # create API's naming discipline, the worktree allocator, the build-claim
  # gate, and session-preflight all keep their own semantics; `begin` sequences
  # them and skips whatever a previous partial run already landed. The claim
  # gate holds on BOTH paths: a fresh/designed task rides the explicit child
  # `move building` (which enforces it), and a resume of an already-`building`
  # task runs the SAME gate inline below — a resume must never bypass a live
  # foreign build claim. bin/ship is the handoff twin at the other end.
  usage = "usage: #{$PROGRAM_NAME} begin --title \"Three To Five Words\" [--repo APP] [--agent SOUL] [--steal] [create flags]  |  " \
          "#{$PROGRAM_NAME} begin <slug> [--agent SOUL] [--dev-size SIZE] [--steal]"
  # --steal: the house build-claim override, same meaning as on `move` — take
  # over a task a DIFFERENT live instance holds. Honored by the resume gate
  # below and forwarded to the child `move building`. Stripped before
  # parse_flags (create's --no-claim pattern) so it never rides into the body.
  steal = !ARGV.delete("--steal").nil?
  # The argv BEFORE parse_flags consumes it — the resume-form grammar check below
  # needs the literal flags the caller typed, which the parsed [scalars, lists,
  # top] triple has already re-keyed to devops/column names.
  raw_argv = ARGV.dup
  positionals, scalars, lists, top = parse_flags(ARGV, context: "begin")
  die!(usage) if positionals.size > 1

  # ⛔ DOOR 1 — NO --title, SO `begin` CANNOT CREATE. Every create flag on this
  # path is definitionally inert, and until this guard existed it was dropped in
  # SILENCE. Measured 2026-08-29: four tasks resumed with `bin/task begin <slug>
  # --agent alex` came out with agent_slug nil and devops.built_by nil, while the
  # same flag on a CREATE stamped both. begin reported success and printed the
  # worktree either way, so the builder had no signal; the failure surfaced a day
  # later at review, where bin/reviewer-select refuses an unknown builder and a
  # human hand-picks — and a hand-picked light once turned out to be the PR's own
  # author.
  #
  # THIS DOOR IS DECIDED BEFORE THE BOARD LOOKUP, and must stay that way: the
  # refusal is a grammar fact, so it must not depend on the network. Door 2 (the
  # task already exists) necessarily runs after the lookup — see below.
  if top["title"].to_s.strip.empty?
    refuse_inert_create_flags!(
      raw_argv, because: "#{$PROGRAM_NAME} begin <slug>",
      hint_lead: "a resumed task is never re-shaped by begin: pass --title to CREATE one"
    )
  end

  # THE BUILDER. `--agent <soul>` is what the documented fast lane passes, and it
  # reached `devops.built_by` on ONE path only: a CREATE, via agent_slug, via
  # rule 4 of Task#builder_to_stamp. Forward it to the claim as `--actor` too, so
  # the stamp rides rule 1 — the rule that does not care whether agent_slug was
  # ever set, and the one `bin/task move <slug> building --actor <soul>` has
  # always used. Shape-validated in parse_flags, so this is a soul or begin died.
  builder = top["agent"].to_s.strip
  # The resume key: an explicit --slug, the positional slug of a prior begin, or
  # the slug the board WOULD derive from the title (FastLane.derive_slug mirrors
  # Task#generate_slug's parameterize) passed explicitly so client and server
  # agree — rerunning the same begin finds its own task instead of a suffixed twin.
  slug = [top["slug"], positionals.first, FastLane.derive_slug(top["title"])].find { |v| !v.to_s.strip.empty? }
  die!(usage) if slug.to_s.empty?

  task = fetch_task_for_begin(slug)
  if task.nil?
    die!("no task #{slug.inspect} to resume — pass --title to create one") unless top["title"]
    scalars["kind"] = "feature" unless scalars.key?("kind")
    devops = stamp_session(build_devops({}, scalars, lists))
    body = top_body(top.merge("slug" => slug))
    body["devops"] = devops unless devops.empty?
    task = api(:post, "/api/v1/tasks", body)["data"]
    seed_usage_baseline(task["slug"]) if task.is_a?(Hash) && task["slug"]
    write_feature_marker(task)
    warn!("begin 1/5 task — created #{slug} [designed]")
  else
    # ⛔ DOOR 2 — THE TASK ALREADY EXISTS, so this is a RESUME and every create
    # flag is inert, --title or no --title. Door 1 catches only the blank-title
    # spelling; what actually makes a create flag inert is the task EXISTING.
    # `begin --title "Some Existing Title" --shape backend` walked straight past
    # door 1 and dropped --shape in silence — on the DOCUMENTED re-run path, since
    # `begin` is advertised as resumable. Refuse it here instead, naming the task
    # so the remedy is copy-pasteable. --title stays legal: it is what named the
    # task whose slug we just resolved, not an attempt to re-create it.
    # THE REFUSAL MUST LEAVE A WAY FORWARD. Re-running the whole create line is a
    # real habit — the fast lane prints it and `begin` is advertised as resumable
    # — so a refusal that only says "no" trades a silent drop for a dead end. Name
    # both moves: where the value DOES belong, and how to resume without it.
    refuse_inert_create_flags!(
      raw_argv, also_valid: %w[--title], update_target: slug,
      because: "#{slug} already exists",
      hint_lead: "begin RESUMES an existing task and never re-shapes it",
      tail: ", then resume with `#{ClaimHolder::TASK_COMMAND} begin #{slug}`"
    )
    warn!("begin 1/5 task — #{slug} already exists [#{task["stage"]}]; resuming")
  end

  stage = task["stage"].to_s
  unless %w[designed building].include?(stage)
    die!("#{slug} is [#{stage}] — begin only starts a designed/building task. " \
         "Pick a different title (or --slug) for new work; a #{stage} task is past the build seam.")
  end

  dv = task.dig("metadata", "devops") || {}

  # THE RESUME CLAIM GATE. An already-`building` task skips the child `move
  # building` below — which is where the build-claim gate lives — so run the SAME
  # desk rule here, BEFORE the worktree steps: a foreign live desk with uncommitted
  # changes refuses unless --steal. No session identity → no gate, mirroring
  # `move`'s plain-shell degrade.
  mover_session = session_identity.first
  if stage == "building" && !mover_session.nil?
    hint = "#{ClaimHolder::TASK_COMMAND} begin #{slug} --steal"
    enforce_claim_gate!(slug, mover_session, steal: steal, steal_hint: hint)
  end

  # Open the session's ORIENT activity now — after the claim gate admits this
  # instance, before the worktree/preflight steps that are the session's first
  # real tool calls — so the fast-lane trail is task-attributed from the start
  # (fast-lane-narrates-activities). Non-fatal; the agent stays free to open its
  # own finer-grained activities in between, and bin/ship closes the trail.
  narrate("start", "--category", "Explore", "--task", slug,
          "--reason", "orient: #{task["title"].to_s.strip.empty? ? slug : task["title"]}")

  # WHICH APP'S DESK. --repo wins (read here as lists["repositories"] — parse_flags
  # re-keys the flag to the devops list name), then the task's own recorded repo,
  # then the hub. This is the ONLY place --repo is read, which is why the wiring
  # guard names `lists["repositories"]` as its reader; deleting it here while
  # leaving this comment standing is the mutation that guard now has to fail.
  app = [(lists["repositories"].first if lists.key?("repositories")), Array(dv["repositories"]).first,
         "mcritchie-studio"].find { |v| !v.to_s.strip.empty? }
  worktree_slug = [dv["worktree_slug"], slug].find { |v| !v.to_s.strip.empty? }
  worktree_bin = BinHelpers.bin_for("TASK_BEGIN_WORKTREE_BIN", "agent-worktree")
  # agent-worktree `new` is idempotent (an existing desk is reused) and `bind-task`
  # re-binds safely — `new` does NOT auto-bind, which is why begin welds them.
  # --soul stamps the desk's own git config at the moment it is cut, so a hand
  # commit made there is authored by the builder rather than by whatever the
  # checkout carries. Only when begin was TOLD the builder; reconcile_desk_identity
  # below settles every other case from the recorded claim.
  new_cmd = [worktree_bin, "new", app, worktree_slug]
  new_cmd += ["--soul", builder] unless builder.empty?
  begin_step!("2/5 worktree", slug, *new_cmd)
  begin_step!("3/5 bind", slug, worktree_bin, "bind-task", app, worktree_slug, slug)

  if stage == "building"
    if mover_session.nil?
      warn!("begin 4/5 claim — already [building]; no session identity, leaving the claim as-is")
    else
      # The gate above admitted this session — now record the CLAIM so the builder
      # stamp runs. The desk bound in step 3 IS the claim; this write carries no
      # lease. It names `stage: building` (unchanged, so no TaskEvent is written) and
      # the mover's session on the event: the board reads that pair as a build claim
      # (Api::V1::TasksController#capture_task_event_context → Task#build_claim_save?).
      # A FRESH read so bind-task's writes are not clobbered.
      current = api(:get, "/api/v1/tasks/#{slug}")["data"] || {}
      merged = stamp_session(current.dig("metadata", "devops") || {})
      resume_claim = { "stage" => "building", "devops" => merged }
      # dev_size is a TOP-LEVEL column, so it rides beside "devops", exactly as
      # `move` sends it.
      resume_claim["dev_size"] = top["dev_size"] if top["dev_size"]
      resume_claim["event"] = { "source" => "cli", "session" => mover_session }
      resume_claim["event"]["actor"] = builder unless builder.empty?
      api(:patch, "/api/v1/tasks/#{slug}", resume_claim)
      seed_usage_baseline(slug)
      write_feature_marker(current.merge("metadata" => { "devops" => merged }))
      warn!("begin 4/5 claim — already [building]; claimed from this desk")
    end
  else
    # An explicit child `move building` so the build claim, --dev-size stamp,
    # usage-baseline seed, and read-back verify all ride the ONE existing path.
    # The child move is THIS script. TASK_BEGIN_MOVE_BIN overrides it for tests —
    # the same seam shape as TASK_BEGIN_WORKTREE_BIN / TASK_BEGIN_PREFLIGHT_BIN
    # above — so the argv begin hands down (above all, --actor) is observable
    # without a board. Unset in production, which is every real run.
    move_cmd = [BinHelpers.bin_for("TASK_BEGIN_MOVE_BIN", File.basename(__FILE__)), "move", slug, "building"]
    move_cmd += ["--dev-size", top["dev_size"]] if top["dev_size"]
    # Without this the child move defaults its actor to the SESSION UUID, which is
    # not a soul, so rule 1 cannot fire — and on a resume agent_slug is nil, so
    # rule 4 cannot either. That is the whole of why begin had no path to built_by.
    move_cmd += ["--actor", builder] unless builder.empty?
    move_cmd << "--steal" if steal
    begin_step!("4/5 claim", slug, *move_cmd)
  end

  reconcile_desk_identity(slug, app, worktree_slug, worktree_bin, stamped: builder.empty? ? nil : builder)

  worktree_dir = TaskTree.worktree_hint(worktree_slug, ENV["TASK_BEGIN_PROJECTS_DIR"])
  die!("worktree #{worktree_slug.inspect} not found on disk after allocation — check bin/agent-worktree output") if worktree_dir.nil?
  preflight_bin = BinHelpers.bin_for("TASK_BEGIN_PREFLIGHT_BIN", "session-preflight")
  # Pin the inspected root to the worktree. session-preflight resolves its own
  # root from __dir__, so `chdir` alone left the primary's copy inspecting the
  # PRIMARY (begin-preflight-wrong-root): a false GREEN, and a false RED that
  # exited begin whenever the primary drifted behind accepted. --root names the
  # desk explicitly; session-preflight self-defends that it really is this task's.
  begin_step!("5/5 preflight", slug, preflight_bin, slug, "--root", worktree_dir, chdir: worktree_dir)

  context = begin
    JSON.parse(File.read(File.join(worktree_dir, ".agent-context.json")))
  rescue StandardError
    {}
  end
  puts "#{app} · #{slug} · #{BASE_URL}/tasks/#{slug}"
  puts "worktree: #{worktree_dir}"
  puts "port: #{context["app_port"]}" if context["app_port"]
  puts "url: #{context["local_url"]}" if context["local_url"]
  puts "task: #{BASE_URL}/tasks/#{slug}"
  # Absolute script + the desk to run it from, on its own line so it is
  # copy-pasteable verbatim. See FastLane.handoff_command for why the bare
  # `bin/ship <slug>` this replaced was wrong from every desk but the hub's.
  puts "next: build in the worktree, then hand off with:"
  puts "  #{FastLane.handoff_command(slug, worktree_dir, __dir__)}"
when "update"
  usage = "usage: #{$PROGRAM_NAME} update <slug> [flags]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  _pos, scalars, lists, top = parse_flags(ARGV, context: "update")
  current = api(:get, "/api/v1/tasks/#{slug}")["data"]
  body = top_body(top)
  if scalars.any? || lists.any?
    devops = build_devops(current.dig("metadata", "devops"), scalars, lists)
    body["devops"] = devops
  end
  die!("nothing to update") if body.empty?
  print_task(api(:patch, "/api/v1/tasks/#{slug}", body)["data"])
when "move"
  usage = "usage: #{$PROGRAM_NAME} move <slug> <stage>"
  slug = positional!(ARGV.shift || die!(usage), usage)
  stage = positional!(ARGV.shift || die!(usage), usage)
  validate_stage!(stage)
  # Best-effort per-transition usage the agent reports for the work it just did
  # in the stage it's leaving — the optional layer on top of the deterministic
  # from/to/duration spine the server records. Always tags source=cli.
  event = { "source" => "cli" }
  # Attribute this transition to whoever is RUNNING the move (the actual mover),
  # not the build session that claimed the task at `building`. So a CLI
  # reviewed/assembled/shipped move records the mover's session — the server no
  # longer backfills actor from devops_session_id. --actor (below) overrides;
  # a plain shell / CI run (no session) stamps no actor.
  mover_session = session_identity.first
  event["actor"] = mover_session unless mover_session.nil?
  steal = false
  # The operator's explicit "I have established that nobody holds this" on the
  # ARCHIVE path. `archived` is terminal and destroys UNCOMMITTED work, so that
  # path refuses what it cannot prove free rather than guessing — the same posture
  # bin/lib/cert_orphan_guard.rb takes toward a process it cannot prove is its own.
  # This flag is the human decision seam, exactly as `remove <app> <task> --yes` is
  # for a desk: it warns, names what it is overriding, and proceeds.
  force = false
  # The builder Pokémon's own size estimate, stamped as it CLAIMS the task at
  # `building` (optional — absent is fine). Set as a top-level Task column.
  dev_size = nil
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--model"      then event["model"]      = ARGV.shift || die!("--model needs a value")
    when "--tokens-in"  then event["tokens_in"]  = (ARGV.shift || die!("--tokens-in needs a value")).to_i
    when "--tokens-out" then event["tokens_out"] = (ARGV.shift || die!("--tokens-out needs a value")).to_i
    when "--cost"       then event["cost"]       = ARGV.shift || die!("--cost needs a value")
    when "--actor"      then event["actor"]      = ARGV.shift || die!("--actor needs a value")
    when "--dev-size"   then dev_size = ARGV.shift || die!("--dev-size needs a value"); validate_size!("--dev-size", dev_size)
    when "--steal"      then steal = true # override the build-claim gate (take a live foreign claim)
    when "--force"      then force = true # override the ARCHIVE holder gate (see lib/archive_holder_guard.rb)
    else unknown_flag!(flag, valid: %w[--model --tokens-in --tokens-out --cost --actor --dev-size --steal --force], context: "move")
    end
  end
  # No explicit usage flags → auto-capture the per-transition delta (model +
  # tokens + cost) from the session transcript so a bare move still leaves a full
  # paper trail. Best-effort; a missing transcript leaves the event spine-only.
  autofill_move_usage(event, slug) unless %w[model tokens_in tokens_out cost].any? { |k| event.key?(k) }
  # ARCHIVE REFUSES WHAT IT CANNOT PROVE FREE. Runs BEFORE the PATCH, so a refusal
  # leaves the task exactly where it was. lib/archive_holder_guard.rb owns the
  # decision table and every refusal message.
  # BOTH ARCHIVE GATES, in order of what they protect. The holder gate guards
  # UNCOMMITTED work (irreversible if wrong); the open-PR gate guards a DURABLE PR
  # from going unwatched (recoverable, and bin/task orphan-prs is the recovery).
  # Both run BEFORE the PATCH, so a refusal leaves the task exactly where it was.
  archive_devops = nil
  if stage == "archived"
    enforce_archive_holder_gate!(slug, force: force)
    # `by:` is the EVENT ACTOR, so `move <slug> archived --actor carl` records the
    # soul who dropped the PR rather than an opaque session id. It falls back to the
    # session inside the gate, so a plain shell still writes a receipt.
    archive_devops = enforce_archive_open_pr_gate!(slug, force: force, by: event["actor"])
  end
  body = { "stage" => stage, "event" => event }
  # The abandonment receipt rides the SAME PATCH as the stage move, so there is no
  # window in which a task is archived without the record of why its PR was dropped.
  body["devops"] = archive_devops if archive_devops
  body["dev_size"] = dev_size if dev_size # the builder's estimate, set alongside the stage move
  # Claim the task on the move to building. The desk is the claim: the gate
  # refuses only a foreign live desk with uncommitted changes (overridable with
  # --steal). No lease is written. The mover's session rides on the event so the
  # board knows who claimed (Task#build_claim_save?). Read-merge-write so the
  # session fields ride alongside existing devops without wiping them.
  # No session → no claim gate (plain shell / CI degrades).
  if stage == "building" && !mover_session.nil?
    enforce_claim_gate!(slug, mover_session, steal: steal)
    current = api(:get, "/api/v1/tasks/#{slug}")["data"]
    current_devops = current.dig("metadata", "devops") || {}
    # Seed the usage baseline at the CLAIM so the build work transition
    # (building→submitted) records a true token delta. Idempotent: a no-op when
    # autofill above already wrote a baseline this move (e.g. a bare move), it
    # matters when explicit usage flags skipped autofill.
    seed_usage_baseline(slug)
    body["devops"] = stamp_session(current_devops)
    event["session"] = mover_session
  end
  # Can this move settle a pending approval request at all? That is
  # Task#settle_operator_approval_past_request_window's own first line, and it is asked ONCE:
  # a destination that can HOLD a request discarded nothing, so there is no warning
  # to consider and no read to spend on dating one. Everything downstream — whether
  # to read, whether to warn — hangs off this single test.
  settleable = !APPROVAL_REQUEST_STAGES.include?(stage)
  # The approval facts as they stood BEFORE the write, the only way to tell a drop
  # THIS move caused from one already on the record. nil here means UNREADABLE and
  # nothing else — which the verdict resolves toward WARNING wherever the receipt can
  # still speak, and toward silence only in residual (i) of the note above, where the
  # board writes no receipt to compare either.
  approval_before = settleable ? read_task_softly(slug) : nil
  task = api(:patch, "/api/v1/tasks/#{slug}", body)["data"]
  # The board answered 2xx — but a 2xx is not persistence. Read the task back and
  # confirm the stage actually moved before printing the success line, so a
  # silently-non-persisting write exits nonzero + loud instead of stranding the
  # task while the handoff claims it advanced.
  verify_move_persisted!(slug, stage)
  # ...and a move that SETTLED a pending approval request must say so. The move
  # itself is correct and still succeeds; what must not happen is doing it quietly.
  warn_dropped_approval_request!(task, slug, approval_before) if settleable
  verify_abandonment_recorded!(slug, archive_devops[OpenPrGuard::RECORD_KEY]) if archive_devops
  write_feature_marker(task)
  print_task(task)
when "merged"
  # Set the git-location crash-recovery signal (Task::MERGED_STATES). Review stamps
  # `accepted` the moment it lands a feat PR on the accepted branch — the ladder's
  # first rung — so an interrupted sweep can promote accepted→release WITHOUT
  # re-reviewing (Release#add later downgrades it to "release" at sweep). NOT a
  # stage move and NOT event-recorded: it's the durable "where is the code" fact
  # the deploy heartbeats read. Set through the same one-path PATCH update as
  # `move` (config/routes.rb: no named-transition endpoint), then read back to
  # confirm it persisted — a 200 is not persistence, and a dropped stamp would
  # strand the task off every RC (the sweep leaves a merged:"" `reviewed` member
  # behind as a HELD anomaly).
  usage = "usage: #{$PROGRAM_NAME} merged <slug> <accepted|release|main>"
  slug = positional!(ARGV.shift || die!(usage), usage)
  state = positional!(ARGV.shift || die!(usage), usage)
  valid = %w[accepted release main]
  die!("merged must be one of #{valid.join(", ")} (got #{state.inspect})") unless valid.include?(state)
  die!(usage) unless ARGV.empty?
  task = api(:patch, "/api/v1/tasks/#{slug}", { "merged" => state })["data"]
  verify_merged_persisted!(slug, state)
  puts "merged set on #{slug}: #{state}"
  print_task(task)
when "fix-forward"
  # THE REVIEWER FIX-FORWARD (a "zap"), recorded as the AUTHORSHIP act it is.
  #
  # A reviewer who fixes forward puts his own commit in the merged diff, so he is an
  # author of that PR. But the author set (devops.built_by + devops.builders) is
  # stamped ONLY by the build CLAIM, and a zap makes none — so the exclusion set
  # never grew. Measured twice on merged PRs the night of 2026-09-09: #1321 seated
  # STEFFON on a PR carrying steffon's own zap (be5579a5); on #1322 the reviewer had
  # to DISCLOSE his push in prose because nothing recorded it.
  #
  # NOT a stage move and NOT a build claim — deliberately. `bin/task move <slug>
  # building --actor <soul>` is the documented repair for a MISSING builder stamp,
  # and it is the wrong instrument here twice over: it drags a submitted task back
  # onto `building` mid-review, and it re-points built_by at a reviewer, which is the
  # same defect inverted (a reviewer recorded as the CURRENT builder of the PR he
  # reviewed). This posts one devops key and moves nothing.
  #
  # APPENDS. The list is read, unioned, and re-posted, so a second zap by a different
  # soul cannot drop the first.
  usage = "usage: #{$PROGRAM_NAME} fix-forward <slug> --agent <soul>[,<soul>]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  souls = []
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--agent" then souls.concat((ARGV.shift || die!("--agent needs a value")).split(/[,\s]+/))
    else unknown_flag!(flag, valid: %w[--agent], context: "fix-forward")
    end
  end
  souls = souls.map { |soul| soul.to_s.strip }.reject(&:empty?).uniq
  die!(usage) if souls.empty?
  # Handle SHAPE is checked here, not on the server: `--agent Steffon` or
  # `--agent turf_monster` matches no soul, so it would join nobody.
  bad = souls.reject { |soul| soul.match?(/\A[a-z]+(?:-[a-z]+)*\z/) }
  die!("not soul slugs (lowercase, single hyphens): #{bad.join(", ")}") if bad.any?

  current = Array((api(:get, "/api/v1/tasks/#{slug}")["data"] || {}).dig("metadata", "devops", "fix_forward"))
             .map { |entry| entry.to_s.strip }.reject(&:empty?)
  posted = (current + souls).uniq
  api(:patch, "/api/v1/tasks/#{slug}", { "devops" => { "fix_forward" => posted } })

  # READ BACK. A 200 is not persistence, and this stamp's whole job is to be there
  # when someone else selects a reviewer — a drop restores the exact silent
  # fail-OPEN the command exists to close, so it must be loud here instead.
  back = (api(:get, "/api/v1/tasks/#{slug}")["data"] || {}).dig("metadata", "devops") || {}
  landed = Array(back["fix_forward"]).map { |entry| entry.to_s.strip }
  authors = Array(back["builders"]).map { |entry| entry.to_s.strip }
  missing = posted - landed
  if missing.any?
    warn!("✗ fix-forward NOT persisted on #{slug}: posted #{posted.join(", ")}, read back #{landed.join(", ")}.")
    warn!("  The reviewer-select exclusion still does not know about this zap. Re-run, and")
    warn!("  if it recurs the board write is failing server-side — check ErrorLog.")
    exit 1
  end
  if (short = souls - authors).any?
    warn!("✗ fix-forward recorded on #{slug} but #{short.join(", ")} did NOT join the author set.")
    warn!("  devops.builders reads [#{authors.join(", ")}]. The record landed and the fold did")
    warn!("  not, so bin/reviewer-select would still seat them. Check Task#builder_roll_call.")
    exit 1
  end
  puts "fix-forward recorded on #{slug}: #{souls.join(", ")} (authors: #{authors.join(", ")})"
when "intent"
  # Record an INTENT — an agent (or the two senior reviewers) STARTING a stage's
  # work, the moment it begins — so /deployments + the task timeline show who's on
  # it with a live ticker BEFORE the →stage transition lands. Append-only +
  # idempotent server-side within the current source-stage cycle, and a no-op once
  # the target stage landed in that cycle. Leaving the source stage closes the old
  # intent; rework can return a task to `submitted`, where a fresh `→reviewed`
  # intent may open. Used for the Avi QA (--to assembled --actor
  # avi) and Steffon ship (--to shipped --actor steffon) intents; the review pair
  # (--to reviewed) is normally recorded by `bin/reviewer-select` (which records
  # by default).
  usage = "usage: #{$PROGRAM_NAME} intent <slug> --to <stage> [--actor SLUG] [--reviewer slug:weight ...]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  to_stage = nil
  actor = nil
  reviewers = []
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--to"       then to_stage = ARGV.shift || die!("--to needs a stage")
    when "--actor"    then actor = ARGV.shift || die!("--actor needs a value")
    when "--reviewer"
      raw = ARGV.shift || die!("--reviewer needs slug[:weight]")
      s, w = raw.split(":", 2)
      reviewers << { "slug" => s, "weight" => w }
    else unknown_flag!(flag, valid: %w[--to --actor --reviewer], context: "intent")
    end
  end
  die!("usage: #{$PROGRAM_NAME} intent <slug> --to <stage> [--actor SLUG] [--reviewer slug:weight ...]") if to_stage.to_s.empty?
  validate_stage!(to_stage)
  body = { "to_stage" => to_stage, "event" => { "source" => "cli" } }
  body["actor"] = actor if actor
  body["reviewers"] = reviewers if reviewers.any?
  task = api(:post, "/api/v1/tasks/#{slug}/intent", body)["data"]
  # Seed the usage baseline the moment this session STARTS the stage's work (the
  # intent), so the matching work transition (e.g. submitted→reviewed for a
  # reviewer, or a deploy-side move read by bin/release) records a true delta
  # instead of a zeroed first-touch baseline. Best-effort; only after the intent
  # landed server-side.
  seed_usage_baseline(slug)
  crew = [actor, *reviewers.map { |r| "#{r["slug"]}/#{r["weight"]}" }].compact.join(" · ")
  puts "intent recorded on #{slug}: → #{to_stage}#{crew.empty? ? "" : " · #{crew}"}"
  print_task(task) if task
when "checkpoint"
  # Emit a CHECKPOINT event — a named moment WITHIN the current stage that does not
  # move it. (The retired local cert bookended its testing phase with
  # `checkpoint <slug> cert --status started` then `--status completed`.) POSTs to the
  # same events/<name>/{start,complete} endpoints the API checkpoint path uses;
  # source defaults to "system" so it skips the usage gate (a marker, not agent work).
  usage = "usage: #{$PROGRAM_NAME} checkpoint <slug> <name> --status started|completed [--source S] [--message M]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  name = positional!(ARGV.shift || die!("checkpoint needs a <name>: #{$PROGRAM_NAME} checkpoint <slug> <name> --status started|completed"), usage)
  status = nil
  source = "system"
  message = nil
  while ARGV.any?
    case (flag = ARGV.shift)
    when "--status"  then status = ARGV.shift || die!("--status needs started or completed")
    when "--source"  then source = ARGV.shift || die!("--source needs a value")
    when "--message" then message = ARGV.shift || die!("--message needs a value")
    else unknown_flag!(flag, valid: %w[--status --source --message], context: "checkpoint")
    end
  end
  status = status.to_s
  die!("--status must be started or completed") unless %w[started completed].include?(status)
  event = { "source" => source }
  event["message"] = message if message
  # WHOSE checkpoint this is. A cert emits two artifacts — this event and a
  # g1_cert GateRun — and until 2026-08-13 neither carried an owner, so the claim
  # gate credited a challenger's own cert to the holder it was refusing the
  # challenger on behalf of. Stamped in metadata (not `actor`, which souls use) and
  # omitted entirely in a plain shell / CI run: unattributed must stay honestly
  # unattributed. See Task#progress_evidence.
  checkpoint_session = session_identity.first
  event["metadata"] = { "session" => checkpoint_session } unless checkpoint_session.nil?
  api(:post, "/api/v1/tasks/#{slug}/events/#{name}/#{status == "started" ? "start" : "complete"}", { "event" => event })
  puts "checkpoint #{name} #{status} on #{slug}"
when "session-mascot"
  # Eagerly paint the session's Pokémon mascot onto the per-session marker so
  # bin/statusline shows it in SECONDS — fired by a SessionStart hook, before any
  # task exists. Idempotent server-side (SessionMascot), and the board task adopts
  # the same mascot later. Also works as a manual Codex kickoff:
  #   bin/task session-mascot --print
  #   bin/task session-mascot --persona jasper --print
  #   bin/task session-mascot --persona none --print
  # Best-effort: no session, no marker path, or any API / transport failure →
  # silent no-op unless --print was requested.
  # Parse BEFORE the best-effort rescue below: a bad flag must exit nonzero, not
  # be swallowed — die!'s SystemExit was rescued, so `--bogus` printed the error
  # yet exited 0 (the same silent-no-op disease as the old parse_flags loop).
  print_marker = false
  persona = nil
  until ARGV.empty?
    case (arg = ARGV.shift)
    when "--print"
      print_marker = true
    when "--persona"
      persona = ARGV.shift || die!("--persona needs a value")
    else
      unknown_flag!(arg, valid: %w[--persona --print], context: "session-mascot")
    end
  end
  begin
    sid = session_identity.first.to_s.strip
    # `sid.empty?` IS feature_marker_path's nil case (it is the only one), asked without
    # binding the raw path — see write_feature_marker.
    unless ENV["TASK_SKIP_MARKER"] == "1" || sid.empty?
      # The marker store's second write seam — guarded like write_feature_marker's.
      path = TaskUsageSandbox.enforce!(feature_marker_path, store: "session-marker")
      body = {}
      body["parent_session_id"] = parent_session_identity if parent_session_identity
      data = api(:post, "/api/v1/sessions/#{sid}/mascot", body.empty? ? nil : body)["data"]
      if data && !data["mascot"].to_s.strip.empty?
        existing = (JSON.parse(File.read(path)) if File.exist?(path)) || {}
        marker = existing.merge(
          "mascot" => data["mascot"],
          "mascot_color" => data["mascot_color"],
          "mascot_emoji" => marker_display_emoji(data),
          "mascot_shiny" => (true if truthy_marker_value?(data["mascot_shiny"]))
        )
        # Seed the DEFAULT app (mcritchie-studio) only when the marker has no app
        # yet — a brand-new session reads "<Pokémon> · mcritchie-studio". Once a task
        # sets the app (write_feature_marker), never override it here.
        if marker["app"].to_s.strip.empty?
          marker["app"] = data["app"]
          marker["app_color"] = data["app_color"]
        end
        raw_persona = persona.to_s.strip
        unless raw_persona.empty?
          if PERSONA_CLEAR.include?(raw_persona.downcase)
            marker.delete("persona")
          else
            agent = api(:get, "/api/v1/agents/#{raw_persona.downcase}")["data"] || {}
            marker["persona"] = raw_persona.downcase
            marker["mascot"] = agent["name"].to_s.strip.empty? ? raw_persona : agent["name"]
            marker["mascot_color"] = agent["status_color"] || agent.dig("metadata", "color")
            marker["mascot_emoji"] = agent["emoji"] || agent.dig("metadata", "emoji")
          end
        end
        marker = marker.reject { |_, v| v.nil? || v.to_s.strip.empty? }
        FileUtils.mkdir_p(File.dirname(path))
        File.write(path, "#{JSON.pretty_generate(marker)}\n")
        refresh_codex_session_title
        print_session_marker(marker) if print_marker
      end
    end
  rescue SystemExit, StandardError
    nil # best-effort: never disrupt session start
  end
when "bounces"
  usage = "usage: #{$PROGRAM_NAME} bounces <slug>"
  slug = positional!(ARGV.shift || die!(usage), usage)
  unknown_flag!(ARGV[0], valid: [], context: "bounces") unless ARGV.empty?
  begin
    verdict = bounce_verdict(slug)
  rescue BounceLedger::UnreadableResponse => e
    # UNKNOWN is NOT clear. This is the whole point of the command: the failure
    # mode it replaces answered "0 prior bounces" here and let the review proceed.
    warn!("BREAKER: UNKNOWN — could not read the bounce ledger for #{slug}")
    warn!("  #{e.message}")
    warn!("  Treat UNKNOWN as NOT CLEAR: fix the read, or escalate. Never proceed as if it were zero.")
    exit 1
  end
  print_bounce_verdict(slug, verdict)
  exit(verdict.tripped? ? EXIT_BREAKER_TRIPPED : 0)
when "block"
  usage = "usage: #{$PROGRAM_NAME} block <slug> [--kind environment|rework|dependency] [--summary \"4-6 words\"] [--feedback \"...\"] [--agent A] [--breaker-ack \"reason\"]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  kind = feedback = summary = agent = breaker_ack = nil
  i = 0
  while i < ARGV.length
    case ARGV[i]
    when "--kind"                  then kind = ARGV[i + 1] || die!("--kind needs a value"); i += 2
    when "--summary"               then summary = ARGV[i + 1] || die!("--summary needs a value"); i += 2
    # --feedback is the details body; --details is an alias for it.
    when "--feedback", "--details" then feedback = ARGV[i + 1] || die!("#{ARGV[i]} needs a value"); i += 2
    when "--agent"                 then agent = ARGV[i + 1] || die!("--agent needs a value"); i += 2
    when "--breaker-ack"           then breaker_ack = ARGV[i + 1] || die!("--breaker-ack needs a value"); i += 2
    else unknown_flag!(ARGV[i], valid: %w[--kind --summary --feedback --details --agent --breaker-ack], context: "block")
    end
  end
  die!("--kind must be one of: #{BLOCK_KINDS.join(", ")}") if kind && !BLOCK_KINDS.include?(kind)
  die!("--breaker-ack only applies to --kind rework") if breaker_ack && kind != "rework"
  # This read doubles as the existence check the breaker would otherwise repeat —
  # an unknown slug die!s here with EXIT_TASK_NOT_FOUND before anything else runs.
  current = api(:get, "/api/v1/tasks/#{slug}")["data"]
  # WHO THIS BLOCK WOULD BE ATTRIBUTED TO — the breaker's recipes print it.
  blocker = resolved_block_actor(agent, current, kind: kind)
  # THE BREAKER FIRES HERE, before the block lands — a warning printed after the
  # bounce is recorded is a receipt, not a safety mechanism. Only `rework` is
  # gated: `dependency` IS the escalation this refusal routes you to, and
  # `environment` is a blocked desk, not a send-back.
  if kind == "rework"
    begin
      breaker = bounce_verdict(slug, verify_task: false)
    rescue BounceLedger::UnreadableResponse => e
      # No silent pass. This costs nothing a caller did not already owe: the block
      # needs the same token and the same board, so an unreadable ledger means the
      # block's own writes were going to fail too.
      die!("could not read the bounce ledger for #{slug}, so the two-bounce circuit " \
           "breaker cannot be evaluated: #{e.message}")
    end
    if breaker.tripped? && breaker_ack.to_s.strip.empty?
      warn!("BREAKER: TRIPPED — #{breaker.count} prior send-back(s) on #{slug}; this block would be the next one.")
      breaker.rows.each_with_index do |row, n|
        warn!("  #{n + 1}. #{row.created_at} [#{row.kind}] #{row.summary}#{row.countable? ? "" : " (not a bounce)"}")
      end
      warn!("")
      warn!("  A repeat bounce is a review DEADLOCK, and a deadlock is the operator's call, never a ping-pong.")
      warn!("  Escalate instead:")
      # EACH RECIPE RESOLVES ITS SOUL UNDER ITS OWN `--kind`, not under the caller's.
      # This one is a `--kind dependency` block, and `default_block_actor` answers the
      # literal "avi" for rework-on-submitted and NIL for every other kind — so reusing
      # `blocker` (resolved above under `rework`) printed `--agent avi` to a caller who
      # had passed no `--agent`, carried no persona, and held no review claim. Pasting
      # that files a dependency block by a soul that did nothing. Resolving it again
      # under `dependency` prints the visible blank instead, while an explicit
      # `--agent carl` still rides through unchanged.
      #
      # An escalation pasted with NO soul at all writes `{"event":{"source":"cli"}}`:
      # no actor, no `by`. It leaves a block whose audit row names nobody. (It does not
      # poison `bin/reviewer-select`: `Task#block!` lands the task on `building` with
      # `blocked_at` set, which is neither a `build_claim_save?` nor a `submit_save?`,
      # so `enforce_builder_stamp` writes no author.)
      warn!("    #{BlockRecipe.escalation(slug, agent: resolved_block_actor(agent, current, kind: "dependency"))}")
      warn!("")
      warn!("  If this bounce is MECHANICAL and not a disagreement (red CI, a merge conflict, a")
      warn!("  dirty base — nothing for the operator to arbitrate), say so and it proceeds:")
      # THIS one KEEPS `blocker`, and that is not an oversight — it is the rule above
      # applied, not exempted. This recipe IS the block being refused, re-run with
      # `--breaker-ack`: same slug, same `--kind rework`, same caller. So the soul this
      # run already resolved to is what it will ACTUALLY record, and printing it is how
      # a wrong one becomes VISIBLE rather than silent. (A pasted block does not run as
      # whoever pasted it: `resolved_block_actor` returns the literal "avi" for
      # rework-on-submitted, so a bare remedy would record the wrong soul.)
      warn!("    #{BlockRecipe.breaker_ack(slug, agent: blocker)}")
      exit EXIT_BREAKER_TRIPPED
    end
    # An override that only shows up in the database is not an override anyone will
    # notice. Say it in the run output too, where the operator reading the wave
    # report can see the breaker was overruled and on what grounds.
    if breaker.tripped?
      warn!("BREAKER: OVERRIDDEN — #{breaker.count} prior send-back(s) on #{slug}; " \
            "proceeding as MECHANICAL: #{breaker_ack.strip}")
    end
  end
  event = { "source" => "cli" }
  event["actor"] = blocker unless blocker.empty?
  autofill_move_usage(event, slug) unless %w[model tokens_in tokens_out cost].any? { |k| event.key?(k) }
  # Block is a `building` ATTRIBUTE now (not a stage) — PATCH the dedicated block
  # endpoint so the server stamps blocked_at/blocked_from/blocked_by/block_kind via
  # Task#block! and lands the task on building. The feedback rides as a qa_feedback
  # activity below (the durable prose marker retros/insights mine).
  body = { "event" => event }
  body["by"] = blocker unless blocker.empty?
  body["kind"] = kind if kind
  task = api(:patch, "/api/v1/tasks/#{slug}/block", body)["data"]
  # A REWORK BOUNCE MUST LEAVE A ROW EVEN WHEN THE CALLER LEFT NO PROSE. The
  # block COLUMNS are wiped by the builder's compliant resubmission, so a
  # feedback-less rework block used to vanish completely — invisible to the
  # circuit breaker forever, which is the same silent-zero this task is about,
  # arriving from the write side instead of the read side. The placeholder is
  # deliberately unflattering: a send-back with no send-back in it is
  # malpractice per the review SOP, and the ledger should say so.
  if kind == "rework" && feedback.to_s.strip.empty?
    warn!("warning: a rework block with no --feedback gives the builder nothing to fix from.")
    feedback = "Blocked for rework with NO send-back recorded — the blocking agent left no --feedback. " \
               "This row exists so the bounce is countable by the two-bounce circuit breaker."
  end
  if feedback
    note = { "task_slug" => slug, "activity_type" => "qa_feedback", "description" => feedback }
    note["agent_slug"] = blocker unless blocker.empty?
    # The 4-6 word summary rides in the activity's metadata (no column, no
    # migration). The details stay in `description`; Activity#block_summary reads
    # this back and falls back to a derived headline for legacy blocks.
    metadata = {}
    metadata["summary"] = summary.strip if summary && !summary.strip.empty?
    # STAMP THE KIND. The block COLUMNS (block_kind) are wiped by a compliant
    # resubmission, so this row is the only durable record of what kind of block
    # this was — and without it the circuit breaker cannot tell a send-back from
    # an environment blocker or from its own escalation, and counts all three the
    # same. bin/lib/bounce_ledger.rb reads it back; rows written before this
    # classify as `unknown` and still count (fail safe).
    metadata["kind"] = kind if kind
    metadata["breaker_ack"] = breaker_ack.strip if breaker_ack && !breaker_ack.strip.empty?
    note["metadata"] = metadata unless metadata.empty?
    api(:post, "/api/v1/activities", note)
    puts "noted [qa_feedback] on #{slug}"
  end
  write_feature_marker(task)
  print_task(task)
when "note"
  usage = "usage: #{$PROGRAM_NAME} note <slug> --handoff|--qa-feedback|--clarification|--comment \"...\" [--agent A] [--resolves-feedback]"
  slug = positional!(ARGV.shift || die!(usage), usage)
  notes = []
  agent = nil
  resolves_feedback = false
  i = 0
  while i < ARGV.length
    arg = ARGV[i]
    if NOTE_FLAGS.key?(arg)
      desc = ARGV[i + 1] || die!("#{arg} needs a value")
      notes << [NOTE_FLAGS[arg], desc]
      i += 2
    elsif arg == "--agent"
      agent = ARGV[i + 1] || die!("--agent needs a value")
      i += 2
    elsif arg == "--resolves-feedback"
      resolves_feedback = true
      i += 1
    else
      unknown_flag!(arg, valid: NOTE_FLAGS.keys + %w[--agent --resolves-feedback], context: "note")
    end
  end
  die!("note needs one of: #{NOTE_FLAGS.keys.join(", ")}") if notes.empty?
  if resolves_feedback && notes.none? { |activity_type, _| activity_type == "handoff" }
    die!("--resolves-feedback marks handoff notes as explicitly addressing open QA feedback; " \
         "use: #{SELF_CMD} note <slug> --handoff \"...\" --resolves-feedback")
  end
  notes.each do |activity_type, description|
    body = { "task_slug" => slug, "activity_type" => activity_type, "description" => description }
    body["agent_slug"] = agent if agent
    body["metadata"] = { "resolves_feedback" => true } if resolves_feedback && activity_type == "handoff"
    activity = api(:post, "/api/v1/activities", body)["data"] || {}
    puts "noted [#{activity_type}] on #{slug} -> #{activity["slug"] || "(created)"}"
  end
when "usage-audit"
  # READ-ONLY. Surfaces baseline rows in the usage/cost store that a test run left
  # behind — a stub slug ("demo-task"), or a cache-read total no single task could
  # plausibly burn. Those rows are not inert: measured $cost derives actual_size
  # (Task::ACTUAL_SIZE_COST_THRESHOLDS) and seeds the reviewer-select baselines, so
  # a fixture row silently skews the sizing intelligence.
  #
  # It reports and exits. It does NOT purge: a baseline is indistinguishable at the
  # file level from real operator state, and the deletion is not reversible — that
  # call is the operator's. Exit 2 when suspects are found, so a check can gate on it.
  dir = nil
  until ARGV.empty?
    case (arg = ARGV.shift)
    when "--dir" then dir = ARGV.shift || die!("--dir needs a value")
    else unknown_flag!(arg, valid: %w[--dir], context: "usage-audit")
    end
  end
  usage_audit!(dir)
when "wait-window"
  # THE OPERATOR-WINDOW WAIT (devops-v3-design.md section 6): block until the
  # task's open window is answered — the `Escalated:` block cleared, or the
  # approval request answered — or it lapses. Reads the DERIVED `windows` list the
  # task API carries (Task#operator_windows), so this CLI holds no window math and
  # reads no YAML: the board's clock decides. Bounded by construction — the loop's
  # deadline is the latest open end plus the grace — so it can never wait forever
  # on a task nobody answers. Exit codes and the loop: bin/lib/wait_window.rb.
  require_relative "lib/wait_window"
  begin
    window_opts = WaitWindow.parse_args(ARGV)
  rescue WaitWindow::UsageError => e
    warn e.message
    exit WaitWindow::EXIT_USAGE
  end
  # A read that fails is NOT an empty window list: nil here is counted by the
  # loop, and only the board's own "task not found" ends the wait at once.
  window_reader = lambda do
    res = TaskBoard.request(:get, "/api/v1/tasks/#{window_opts.slug}", base_url: BASE_URL, token: token)
    parsed = TaskBoard.parse_body(res)
    next :not_found if task_not_found_response?(res, parsed)
    next nil unless res.code.to_i.between?(200, 299)

    parsed["data"].is_a?(Hash) ? parsed["data"] : nil
  rescue StandardError
    nil
  end
  exit WaitWindow.run(slug: window_opts.slug, reader: window_reader, sleeper: ->(seconds) { sleep(seconds) },
                      clock: -> { Time.now }, interval: window_opts.interval, grace: window_opts.grace,
                      out: $stdout, err: $stderr, json: window_opts.json)
when "review-claim"
  # The per-TASK REVIEW claim (per-task-pr-review-claim) — the review LANE's per-task
  # lease, so MANY pr-review sessions run in parallel and each SKIPS a task already
  # under live review. Delegated whole to ReviewClaimCli (bin/lib/review_claim_cli.rb),
  # the mirror of bin/devops-shift one granularity down (lane → task): same
  # live-instance identity, TTL, and detached renewer. `cmd` is already shifted, so
  # ARGV is [<sub> <slug> ...flags]. Exit codes: 0 claimed/renewed · 10 skipped (already
  # under review by another) · 12 (renew) no lease of yours to renew · 1 fail-open (no
  # session / no board). `renew` exits NONZERO when it renewed nothing — it used to
  # exit 0 either way, which is renew-exits-zero-renewing.
  require_relative "lib/review_claim_cli"
  exit(ReviewClaimCli.new.run(ARGV))
when "claim-next-review"
  # The ATOMIC server-side review pop (relocate-review-selection-to-server): ask the
  # board for the single highest-ranked reviewable GREEN-CI task and claim it in ONE
  # request, instead of assembling that decision client-side (reviewable list →
  # per-PR CI read → per-task acquire). Prints the claimed slug (exit 0), or "none"
  # (exit 4) when nothing is eligible. Delegated to ReviewClaimCli, reusing its
  # live-instance identity + detached-renewer machinery. ARGV is [<flags>] (the
  # subcommand is already shifted off).
  #
  # ReviewClaimCli validates the whole line BEFORE it pops: --help/-h prints usage
  # and claims nothing, an argument it cannot account for refuses. Nothing here may
  # reach `claim-next` on an unparsed line — this branch hands the CLI raw ARGV, and
  # a `--help` that fell through it once claimed a real task.
  require_relative "lib/review_claim_cli"
  exit(ReviewClaimCli.new.run(["claim-next", *ARGV]))
else
  print_usage!
  exit(cmd == "help" || HELP_FLAGS.include?(cmd) ? 0 : 1)
end
