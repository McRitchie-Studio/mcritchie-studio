def usage
  warn <<~TEXT
    bin/agent-worktree - hidden worktrees + isolated local stacks

      apps
      list [app]
      plan <app> <task-slug> [type]
      new <app> <task-slug> [type] [--start]
      bind-task <app> <task-slug> <task-record-slug-or-url>
      whereami [app task-slug] [--json|--shell]
      shell-hook zsh
      env <app> <task-slug>
      up <app> <task-slug>
      test <app> <task-slug> [-- rails-test-args]
      status <app> <task-slug>
      finish <app> <task-slug> [--push] [--pr]
      restore-primary <app> [--dry-run]
      doctor [app]
      snapshot [app] [--write]
      cleanup [app] [--write]
      cleanup [app] --reclaim [--yes]
      remove <app> <task-slug> [--force] [--yes]
      down <app> <task-slug>

      remove --force: override the content-on-<base> guard ONLY for a
        merge-verified branch (a merged PR on GitHub). Never overrides
        the dirty or not-git-registered guards.
      scale [status|out|in]
      scale --provision [--yes]

    Environment:
      AGENT_REDIS_MIN_DB         first Redis DB in the worktree band (default 9)
      AGENT_REDIS_MAX_DB         override the band's top DB (default: derived from band size)
      AGENT_REDIS_FLOOR          steady-state band size in slots (default 20)
      AGENT_REDIS_STEP           grow/shrink increment in slots (default 10)
      AGENT_REDIS_PHYSICAL_TARGET  Redis `databases` target for --provision (default 64)
      AGENT_REDIS_CONF           brew redis.conf path for --provision (default <brew>/etc/redis.conf)

    Examples:
      bin/agent-worktree plan turf-monster button-color
      bin/agent-worktree new turf-monster button-color
      bin/agent-worktree up turf-monster button-color
  TEXT
  exit 1
end

def sh(*cmd, chdir: nil, env: {}, allow_fail: false)
  shown = cmd.shelljoin
  options = {}
  options[:chdir] = chdir if chdir
  ok = system(env, *cmd, **options)
  return true if ok
  return false if allow_fail

  where = chdir ? " in #{chdir}" : ""
  abort "command failed#{where}: #{shown}"
end

def capture(*cmd, chdir: nil, env: {})
  options = {}
  options[:chdir] = chdir if chdir
  out, err, status = Open3.capture3(env, *cmd, **options)
  abort "command failed: #{cmd.shelljoin}\n#{err}" unless status.success?
  out
end

# Returns [ok, stdout, stderr, exitstatus]. The 4th element is the child's exit
# code — an Integer, or NIL when there is no code to report (spawn failure,
# timeout, killed by a signal). fetch_task_record classifies bin/task's not-found
# exit-code contract on it, and nil can never equal a contract code, so an
# unclassifiable exit always reads as a FAILED command. Callers that only
# destructure three names simply ignore it.
# Real defaults for the timeout injection seams (below): the monotonic clock the grace
# loop measures against, and the sleep it yields between liveness probes.
MONOTONIC_CLOCK = -> { Process.clock_gettime(Process::CLOCK_MONOTONIC) }
REAL_SLEEPER = ->(seconds) { sleep(seconds) }

# `clock:`/`sleeper:` are injection seams (same shape as bin/lib/cert_orphan_guard.rb):
# they default to the real monotonic clock and sleep so every production call site is
# unchanged, and a test drives the bound's ENFORCEMENT deterministically instead of
# asserting a spawn-latency-inflated wall-clock elapsed. They matter only on the bounded
# lane (they thread to terminate_group's grace loop); the plain lane never sleeps.
def capture_status(*cmd, chdir: nil, env: {}, timeout: nil, clock: MONOTONIC_CLOCK, sleeper: REAL_SLEEPER)
  options = {}
  options[:chdir] = chdir if chdir
  return capture_bounded(cmd, options, env, timeout, clock: clock, sleeper: sleeper) if timeout

  out, err, status = Open3.capture3(env, *cmd, **options)
  [status.success?, out, err, status.exitstatus]
rescue SystemCallError => e
  # A missing chdir target makes spawn raise Errno::ENOENT before the command
  # ever runs (e.g. a PRUNABLE git worktree git still lists but whose directory
  # was deleted on disk). Read-only callers — doctor and snapshot --write —
  # must degrade to a failed command, never crash the whole run.
  [false, "", e.message, nil]
end

# A REAL bound on a child command — it KILLS the child when the deadline passes.
#
# Timeout.timeout around Open3.capture3 does NOT bound anything, and the failure is
# silent: capture3's ensure joins the wait thread, which blocks until the child exits, so
# the Timeout::Error is swallowed into that join. Verified on this repo's Ruby 3.3.11 — a
# 2s guard around `sleep 6` returned after 6.01s and sprayed "stream closed in another
# thread (IOError)". A hung board would therefore have stalled a whole sweep while the
# code claimed to be bounded. The only way to bound a child is to signal it.
#
# The child runs in its OWN process group (pgroup: true) so the signal reaches anything it
# spawned (bin/task shells out to Ruby, which opens the socket that actually hangs).
# Timing out reads exactly like any other failed command → the guard fails open.
def capture_bounded(cmd, options, env, timeout, clock: MONOTONIC_CLOCK, sleeper: REAL_SLEEPER)
  Open3.popen3(env, *cmd, **options.merge(pgroup: true)) do |stdin, stdout, stderr, wait_thr|
    stdin.close
    # Drain both pipes on threads: a child that fills a pipe buffer would otherwise block
    # forever on write while we sit in wait_thr.join, deadlocking the "bound".
    out_reader = drain(stdout)
    err_reader = drain(stderr)

    if wait_thr.join(timeout).nil?
      # NOTE: popen3's own ensure does an UNBOUNDED wait_thr.join on the way out, so the
      # bound holds only because we kill the group first. If both signals were to fail
      # (EPERM — the child is not ours), that ensure would block; terminate_group therefore
      # escalates TERM -> KILL, and a KILL we are permitted to send always lands.
      terminate_group(wait_thr.pid, clock: clock, sleeper: sleeper)
      wait_thr.join(2)
      [out_reader, err_reader].each { |thread| thread.join(1) || thread.kill }
      # No exit code on a timeout — the child was killed, it did not ANSWER. nil
      # keeps a timed-out board read in the failed bucket (see capture_status).
      next [false, "", "timed out after #{timeout}s", nil]
    end

    status = wait_thr.value
    [status.success?, reap(out_reader), reap(err_reader), status.exitstatus]
  end
rescue SystemCallError => e
  [false, "", e.message, nil]
end

def drain(io)
  Thread.new do
    io.read.to_s
  rescue IOError
    ""
  end
end

def reap(thread)
  return thread.value.to_s if thread.join(5)

  thread.kill
  ""
end

# TERM the child's whole process group, and escalate to KILL only if it does not go. A
# well-behaved child (bin/task) exits on TERM, so the blind KILL was both unnecessary and a
# needless 0.2s on every timeout. ESRCH/EPERM mean it is already gone (or was never ours) —
# either way there is nothing left to bound.
def terminate_group(pid, grace: 2.0, clock: MONOTONIC_CLOCK, sleeper: REAL_SLEEPER)
  Process.kill("TERM", -pid)

  deadline = clock.call + grace
  while clock.call < deadline
    return unless process_group_alive?(pid)

    sleeper.call(0.05)
  end

  Process.kill("KILL", -pid)
rescue Errno::ESRCH, Errno::EPERM
  nil
end

# Signal 0 probes liveness without delivering anything.
def process_group_alive?(pid)
  Process.kill(0, -pid)
  true
rescue Errno::ESRCH
  false
rescue Errno::EPERM
  true
end

# Side-channel log helpers for automatic capacity/flush events. They write to
# stderr so plan/snapshot stdout (consumed by other tooling) stays clean.
def log_ok(message)
  warn "ok: #{message}"
end

def log_act(message)
  warn "scale: #{message}"
end

def log_fail(message)
  warn "warn: #{message}"
end

def apps
  data = {
    "mcritchie-studio" => {
      "slug" => "mcritchie-studio",
      "display_name" => "McRitchie Studio",
      "port" => 3000,
      "status" => "active"
    }
  }

  satellites_path = File.join(HUB_DIR, "config", "satellites.yml")
  if File.exist?(satellites_path)
    YAML.load_file(satellites_path).fetch("satellites", []).each do |satellite|
      slug = satellite.fetch("slug")
      data[slug] = satellite.transform_keys(&:to_s)
    end
  end

  data.each do |slug, config|
    override = APP_OVERRIDES.fetch(slug, {})
    port = Integer(config.fetch("port"))
    range_start = (port / 100) * 100
    data[slug] = config.merge(
      "slug" => slug,
      "repo" => File.join(PROJECTS_DIR, slug),
      "primary_port" => port,
      "range_start" => range_start,
      "range_end" => range_start + 99,
      "stack" => override.fetch("stack", "rails"),
      "ruby_path" => override.fetch("ruby_path", nil),
      "session_env" => override.fetch("session_env", "#{slug.tr("-", "_").upcase}_SESSION_KEY"),
      "session_key" => override.fetch("session_key", "_#{slug.tr("-", "_")}_session"),
      "sidekiq" => override.fetch("sidekiq", false),
      "reserved_ports" => override.fetch("reserved_ports", [])
    )
  end
end

def app_for(name)
  slug = ALIASES.fetch(name, name)
  config = apps[slug]
  abort "unknown app: #{name}\nRun: bin/agent-worktree apps" unless config
  abort "repo missing: #{config.fetch("repo")}" unless Dir.exist?(config.fetch("repo"))
  config
end

# app_for, widened to the repos the SWEEP can see.
#
# app_for stays registry-only on purpose: it is what the allocating commands
# (`new`, `up`, `plan`) resolve through, and those need a port range, a session
# key and a stack — things a discovered repo has no answer for. Scoping a desk to
# one of them there would half-build a worktree.
#
# The sweep asks a narrower question — "which desks do I inspect?" — and the whole
# point of discovery is that the answer is not limited to registered apps. Without
# this, `cleanup --reclaim studio-engine` aborted with "unknown app" even though the
# unscoped sweep had just listed studio-engine desks as candidates: the headline
# case the coverage work exists for, unusable in the form an operator reaches for.
def sweep_app_for(name)
  slug = ALIASES.fetch(name, name)
  config = apps[slug] || discovered_worktree_configs.find { |c| c["slug"] == slug }
  unless config
    known = (apps.keys + discovered_worktree_configs.map { |c| c["slug"] }).sort
    abort "unknown app: #{name}\nSweepable: #{known.join(", ")}"
  end
  abort "repo missing: #{config.fetch("repo")}" unless Dir.exist?(config.fetch("repo"))

  config
end

def clean_slug(raw)
  slug = raw.to_s.downcase.gsub(/[^a-z0-9]+/, "-").gsub(/\A-|-+\z/, "")
  abort "invalid task slug: #{raw.inspect}" if slug.empty?
  slug
end

def worktree_dir(app, task)
  File.join(app.fetch("repo"), ".worktrees", task)
end

def stack_env_path(app, task)
  File.join(worktree_dir(app, task), STACK_ENV)
end

def context_path(dir)
  File.join(dir, CONTEXT_FILE)
end

def existing_stack_envs(app)
  Dir.glob(File.join(app.fetch("repo"), ".worktrees", "*", STACK_ENV))
end

def parse_env(path)
  return {} unless File.exist?(path)

  File.readlines(path, chomp: true).each_with_object({}) do |line, env|
    next if line.strip.empty? || line.start_with?("#")
    key, value = line.split("=", 2)
    env[key] = value.to_s
  end
end

def local_url(port)
  port.to_s.empty? ? nil : "http://localhost:#{port}"
end

def local_inbox_url(port)
  port.to_s.empty? ? nil : "http://localhost:#{port}/_studio/local_emails"
end

def env_truthy?(value)
  %w[1 true yes on].include?(value.to_s.strip.downcase)
end

def port_listening?(port)
  system("lsof", "-nP", "-iTCP:#{port}", "-sTCP:LISTEN", out: File::NULL, err: File::NULL)
end

def port_pid(port)
  ok, out, = capture_status("lsof", "-tiTCP:#{port}", "-sTCP:LISTEN")
  ok ? out.lines.first.to_s.strip : ""
end

# The working directory of a running process, via lsof (the `n` field of its cwd
# fd). Used to tell THIS worktree's server apart from a foreign app squatting on
# the same port. "" when the pid is gone or unreadable.
def process_cwd(pid)
  return "" if pid.to_s.empty?

  ok, out, = capture_status("lsof", "-a", "-p", pid.to_s, "-d", "cwd", "-Fn")
  return "" unless ok

  line = out.lines.find { |l| l.start_with?("n") }
  line ? line[1..].to_s.strip : ""
end

# True when the process listening on `port` is THIS worktree's stack — i.e. its
# cwd is the worktree dir (we always spawn the server with chdir: dir). False for
# a foreign app on the port (e.g. rolio squatting a port inside our band), so the
# caller can refuse to adopt it instead of reporting a bogus healthy /up.
def own_stack_on_port?(port, dir)
  pid = port_pid(port)
  return false if pid.empty?

  File.expand_path(process_cwd(pid)) == File.expand_path(dir)
end

# Refuse to adopt a server we didn't start: if the live process on `port` isn't
# rooted in this worktree, it's a foreign app squatting the port — abort loudly
# rather than writing its pid into our pidfile and reporting a bogus healthy /up
# (the rolio-on-3020 trap). No-op when the port is ours or free.
def assert_own_stack!(port, dir, live_pid)
  return if live_pid.to_s.empty? || own_stack_on_port?(port, dir)

  cwd = process_cwd(live_pid)
  abort "port #{port} is held by a FOREIGN process (pid #{live_pid}#{cwd.empty? ? "" : ", cwd #{cwd}"}) — " \
        "not this worktree's stack at #{dir}. Free that port or reallocate the worktree, then retry."
end

def pid_alive?(pid)
  return false if pid.to_s.empty?

  Process.kill(0, Integer(pid))
  true
rescue Errno::EPERM
  true
rescue ArgumentError, Errno::ESRCH
  false
end

def pidfile_state(path)
  return "missing" unless File.exist?(path)

  pid = File.read(path).strip
  return "empty" if pid.empty?

  pid_alive?(pid) ? "alive #{pid}" : "stale #{pid}"
end

def http_code(port)
  return "?" if port.to_s.empty? || port.to_s == "?"

  out, = Open3.capture3("curl", "-sS", "-o", "/dev/null", "-m", "2", "-w", "%{http_code}", "http://localhost:#{port}/up")
  out.to_s.strip.empty? ? "down" : out.to_s.strip
rescue StandardError
  "down"
end

def allocated_ports(app)
  existing_stack_envs(app).map { |path| parse_env(path)["APP_PORT"]&.to_i }.compact
end

def allocated_redis_dbs
  apps.values.flat_map do |app|
    existing_stack_envs(app).map do |path|
      parse_env(path)["REDIS_URL"].to_s.split("/").last&.to_i
    end
  end.compact
end

def integer_env(name, default)
  Integer(ENV.fetch(name, default.to_s))
rescue ArgumentError
  abort "#{name} must be an integer"
end

def redis_db_min
  integer_env("AGENT_REDIS_MIN_DB", DEFAULT_REDIS_MIN_DB)
end

def redis_db_max
  # The band top DB is derived from the elastic soft band. An explicit
  # AGENT_REDIS_MAX_DB still wins for manual overrides / drift detection.
  return integer_env("AGENT_REDIS_MAX_DB", redis_db_min + load_current_capacity - 1) if ENV.key?("AGENT_REDIS_MAX_DB")

  redis_db_min + load_current_capacity - 1
end

def redis_db_range
  min = redis_db_min
  max = redis_db_max
  abort "AGENT_REDIS_MIN_DB must be <= AGENT_REDIS_MAX_DB" if min > max

  min..max
end

# --- Elastic Redis band: persisted soft capacity + physical ceiling ---------

def redis_capacity_path
  File.expand_path(ENV.fetch("AGENT_REDIS_CAPACITY_FILE") { File.join(agent_registry_dir, "redis-capacity.json") })
end

def worktree_lock_path
  File.expand_path(ENV.fetch("AGENT_WORKTREE_LOCK") { File.join(agent_registry_dir, "agent-worktree.lock") })
end

# Reentrant exclusive file lock around DB allocation + capacity mutation so two
# concurrent `new`/`up`/`scale` runs cannot grab the same DB or corrupt
# redis-capacity.json. Reentrant within a process (single-threaded CLI) so
# nested calls (allocate inside a locked `new`) do not self-deadlock.
def with_worktree_lock
  $worktree_lock_depth ||= 0
  if $worktree_lock_depth.positive?
    $worktree_lock_depth += 1
    begin
      return yield
    ensure
      $worktree_lock_depth -= 1
    end
  end

  # Guarded like every other write into the operator's real .agents state: a
  # sandboxed run with an unpinned AGENT_WORKTREE_LOCK would flock the LIVE lock that
  # serialises real DB allocation, and hold it for the length of a test.
  lock_path = TaskUsageSandbox.enforce!(worktree_lock_path, store: "worktree-lock")
  FileUtils.mkdir_p(File.dirname(lock_path))
  File.open(lock_path, File::RDWR | File::CREAT, 0o644) do |lock|
    lock.flock(File::LOCK_EX)
    $worktree_lock_depth += 1
    begin
      yield
    ensure
      $worktree_lock_depth -= 1
    end
  end
end

def load_current_capacity
  path = redis_capacity_path
  return REDIS_BAND_FLOOR unless File.exist?(path)

  value = JSON.parse(File.read(path))["current_capacity"].to_i
  value >= REDIS_BAND_FLOOR ? value : REDIS_BAND_FLOOR
rescue JSON::ParserError, Errno::ENOENT
  REDIS_BAND_FLOOR
end

def write_current_capacity(value)
  value = REDIS_BAND_FLOOR if value < REDIS_BAND_FLOOR
  # Guarded: an unpinned sandboxed run would rewrite the REAL Redis band, and the
  # band is what keeps two live worktrees off the same Redis DB.
  path = TaskUsageSandbox.enforce!(redis_capacity_path, store: "redis-capacity")
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, "#{JSON.pretty_generate(
    "current_capacity" => value,
    "floor" => REDIS_BAND_FLOOR,
    "step" => REDIS_BAND_STEP,
    "updated_at" => Time.now.utc.iso8601
  )}\n")
  value
end

# Physical `databases` exposed by the running Redis, or nil if redis-cli is
# unavailable. This is the hard ceiling; the band may never hand out a DB index
# at or beyond it.
def redis_physical_databases
  ok, out, = capture_status("redis-cli", "-p", "6379", "CONFIG", "GET", "databases")
  return nil unless ok

  out.lines.map(&:strip).reject(&:empty?).last&.to_i
rescue StandardError
  nil
end

# Physical count with a conservative stock fallback (16 databases, DBs 0-15)
# when redis-cli cannot be reached, so allocation never optimistically hands out
# a database that does not exist.
def redis_physical_count
  redis_physical_databases || (DEFAULT_REDIS_MAX_DB + 1)
end

def redis_physical_target
  integer_env("AGENT_REDIS_PHYSICAL_TARGET", DEFAULT_REDIS_PHYSICAL_TARGET)
end

# Largest band size (slots) that physically fits above the band start.
def physical_band_capacity(physical = redis_physical_count)
  physical - redis_db_min
end

def allocated_band_dbs
  allocated_redis_dbs.select { |db| db >= redis_db_min }
end

def allocate_redis_db
  with_worktree_lock do
    physical = redis_physical_count
    physical_top = physical - 1

    loop do
      capacity = load_current_capacity
      band_top = redis_db_min + capacity - 1
      ceiling = [band_top, physical_top].min
      used = allocated_redis_dbs

      (redis_db_min..ceiling).each do |db|
        return db unless used.include?(db)
      end

      # Band exhausted within physical reach. Grow the soft band (restart-free)
      # if physical room remains, then retry.
      room = physical_band_capacity(physical)
      if capacity < room
        grown = [capacity + REDIS_BAND_STEP, room].min
        write_current_capacity(grown)
        log_act("scaled out: #{capacity} -> #{grown} slots (band redis DBs #{redis_db_min}-#{redis_db_min + grown - 1})")
        next
      end

      abort <<~MSG.strip
        no free Redis DB in band #{redis_db_min}-#{ceiling}; physical Redis ceiling reached (databases=#{physical}).
        Free a slot:   bin/agent-worktree cleanup   (then remove merged worktrees)
        Raise ceiling: bin/agent-worktree scale --provision   (raises Redis databases to #{redis_physical_target}, restarts Redis once)
      MSG
    end
  end
end

# Restart-free shrink hook: invoked after slots free up (remove/cleanup). Drops
# the band by STEP increments toward FLOOR without ever stranding a still-used
# DB above the new band top.
def maybe_scale_in
  with_worktree_lock do
    current = load_current_capacity
    return if current <= REDIS_BAND_FLOOR

    highest_used = allocated_band_dbs.max
    min_capacity_for_used = highest_used ? (highest_used - redis_db_min + 1) : 0

    target = current
    while (target - REDIS_BAND_STEP) >= REDIS_BAND_FLOOR && (target - REDIS_BAND_STEP) >= min_capacity_for_used
      target -= REDIS_BAND_STEP
    end
    return if target >= current

    write_current_capacity(target)
    log_act("scaled in: #{current} -> #{target} slots (band redis DBs #{redis_db_min}-#{redis_db_min + target - 1})")
  end
end

def allocate_port(app)
  used = allocated_ports(app)
  # Ports a foreign app owns inside this band (e.g. rolio on 3020) — skipped even
  # when the squatter is momentarily down, which the live-listener check below
  # can't catch. Otherwise the worktree later collides + adopts the foreign server.
  reserved = Array(app.fetch("reserved_ports", []))
  ((app.fetch("primary_port") + 1)..app.fetch("range_end")).each do |port|
    next if used.include?(port)
    next if reserved.include?(port)
    next if port_listening?(port)

    return port
  end
  abort "no free worktree port in #{app.fetch("range_start")}-#{app.fetch("range_end")}"
end

# PostgreSQL truncates identifiers to NAMEDATALEN-1 = 63 bytes. A worktree's
# DEV database name (`<app>_development_<slug>`) is the LONGEST identifier we mint
# — its `_development_` marker is longer than the `_test_` marker that
# test_database_url rewrites it to — so bounding the dev name keeps BOTH the dev
# name AND its derived test name <= 63 with an identical <slug> base, which is
# what lets db:test:prepare resolve the same DB. Names that already fit pass
# through byte-for-byte (no churn to existing worktrees). See task
# worktree-db-name-overflow: at 64 bytes Postgres truncated the stored datname
# while Rails still looked it up by the full literal string, so the lookup missed.
MAX_PG_IDENTIFIER = 63
DB_SLUG_HASH_LEN = 8

# Fit <slug> into max_len bytes. A slug that fits is returned unchanged. An
# overflowing slug is truncated and suffixed with `_` + the first
# DB_SLUG_HASH_LEN hex of its SHA256 so distinct long slugs stay unique and the
# mapping is deterministic (same slug -> same DB name across runs).
def bounded_db_slug(slug, max_len)
  return slug if slug.length <= max_len

  digest = Digest::SHA256.hexdigest(slug)[0, DB_SLUG_HASH_LEN]
  keep = max_len - DB_SLUG_HASH_LEN - 1 # reserve room for the "_" separator + digest
  keep = 0 if keep.negative?
  "#{slug[0, keep]}_#{digest}"[0, max_len]
end

# The worktree's DEV database name, bounded under Postgres' 63-byte identifier
# limit with headroom reserved for the longest env marker (`_development_`).
def worktree_db_name(app_slug, task)
  prefix = "#{app_slug.tr("-", "_")}_development_"
  "#{prefix}#{bounded_db_slug(task.tr("-", "_"), MAX_PG_IDENTIFIER - prefix.length)}"
end

def stack_values(app, task, requested_port = nil)
  port = requested_port || allocate_port(app)
  redis_db = allocate_redis_db
  db_name = worktree_db_name(app.fetch("slug"), task)
  session_key = "#{app.fetch("session_key")}_#{task.tr("-", "_")}"

  {
    "AGENT_WORKTREE" => "1",
    "APP_SLUG" => app.fetch("slug"),
    "TASK_SLUG" => task,
    "APP_PORT" => port.to_s,
    "PORT" => port.to_s,
    "REDIS_URL" => "redis://localhost:6379/#{redis_db}",
    "DATABASE_URL" => "postgresql://localhost/#{db_name}",
    "TASK_RECORD_SLUG" => ENV.fetch("TASK_RECORD_SLUG", ""),
    "TASK_URL" => ENV.fetch("TASK_URL", ""),
    app.fetch("session_env") => session_key,
    "TM_PORT" => port.to_s,
    "TM_REDIS_DB" => redis_db.to_s
  }.merge(local_email_values)
end

def local_email_values
  {
    "LOCAL_EMAIL_CAPTURE" => "1",
    "MAIL_TRANSPORT" => "",
    "RESEND_API_KEY" => "",
    "SES_SMTP_USERNAME" => "",
    "SES_SMTP_PASSWORD" => ""
  }
end

def write_stack_env(app, task, values)
  path = stack_env_path(app, task)
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, <<~ENVFILE)
    # Generated by mcritchie-studio/bin/agent-worktree.
    # Safe to regenerate; do not commit this file.
    #{values.map { |key, value| "#{key}=#{value}" }.join("\n")}
  ENVFILE
  path
end

def load_stack_env(app, task)
  path = stack_env_path(app, task)
  abort "missing #{path}\nRun: bin/agent-worktree new #{app.fetch("slug")} #{task}" unless File.exist?(path)
  local_email_values.merge(parse_env(path))
end

def command_env(app, values)
  path_parts = [app["ruby_path"], ENV["PATH"]].compact
  values.merge("PATH" => path_parts.join(":"))
end

# The worktree header's `task:` value: the bound task URL, or a non-alarming
# "not yet bound, here's how" fallback (fast-lane-output-clarity). The old
# fallback ("bind after task creation"), read top-down inside `bin/task begin`
# — which binds at its very next step — looked as if the bind had FAILED.
def task_line_value(task_record_url)
  task_record_url || "(unbound — run bind-task to bind)"
end

def print_plan(app, task, values, dir = worktree_dir(app, task))
  redis_db = values.fetch("REDIS_URL").split("/").last
  task_record_url = task_url(values)
  puts "app:      #{app.fetch("display_name", app.fetch("slug"))}"
  puts "repo:     #{app.fetch("repo")}"
  puts "task:     #{task_line_value(task_record_url)}"
  puts "worktree: #{dir}"
  puts "url:      http://localhost:#{values.fetch("APP_PORT")}"
  puts "email:    http://localhost:#{values.fetch("APP_PORT")}/_studio/local_emails"
  puts "branch:   feat/#{task} (or the type you pass to new) off origin/#{base_branch_for(app.fetch("repo"))}"
  puts "db:       #{values.fetch("DATABASE_URL").sub("postgresql://localhost/", "")}"
  puts "redis:    db #{redis_db}"
  puts "session:  #{app.fetch("session_env")}=#{values.fetch(app.fetch("session_env"))}"
  puts
  puts "start:    bin/agent-worktree up #{app.fetch("slug")} #{task}"
  puts "stop:     bin/agent-worktree down #{app.fetch("slug")} #{task}"
  puts
  physical = redis_physical_count
  if redis_db.to_i >= physical
    puts "warning: Redis db #{redis_db} is at/beyond the physical Redis ceiling (databases=#{physical})."
    puts "         The soft band grows restart-free, but only DBs 0-#{physical - 1} physically exist."
    puts "         Run: bin/agent-worktree scale --provision  to raise capacity, or cleanup/remove a stack."
    puts
  end
  puts "callback-heavy flows stay on primary http://localhost:#{app.fetch("primary_port")} unless providers are configured for this port."
end

def ensure_git_worktree(app, task, type)
  primary = app.fetch("repo")
  dir = worktree_dir(app, task)
  return dir if Dir.exist?(dir)

  FileUtils.mkdir_p(File.dirname(dir))
  sh("git", "-C", primary, "fetch", "origin", "--quiet")

  # Cut from the persistent `accepted` branch (the feature-PR target) when the
  # repo has one; fall back to `origin/release`, then `origin/main`, then to
  # local HEAD for a repo with no fetched remote base at all.
  base_ref = base_ref_for(primary)
  unless sh("git", "-C", primary, "rev-parse", "--verify", base_ref, allow_fail: true)
    base_ref = "HEAD"
  end

  branch = "#{type}/#{task}"
  sh("git", "-C", primary, "worktree", "add", dir, "-b", branch, base_ref)

  env_source = File.join(primary, ".env")
  env_target = File.join(dir, ".env")
  if File.exist?(env_source) && !File.exist?(env_target)
    FileUtils.cp(env_source, env_target)
    puts "copied .env"
  end

  dir
end

# The worktree's TEST database URL, derived from its (development) DATABASE_URL.
# e.g. .../<app>_development_<slug> -> .../<app>_test_<slug>. Returns nil if the
# stack has no DATABASE_URL to derive from.
def test_database_url(values)
  url = values["DATABASE_URL"].to_s.strip
  return nil if url.empty?

  base, _, name = url.rpartition("/")
  return nil if name.empty?

  # Rewrite the env marker specifically (`_development_<slug>` or a trailing
  # `_development`), never a coincidental "development" elsewhere in the name.
  test_name = name.sub(/_development(_|\z)/, '_test\1')
  test_name = "#{name}_test" if test_name == name
  "#{base}/#{test_name}"
end

# Test-env command env: ruby PATH + RAILS_ENV=test + the worktree's test DB.
# Minimal, hermetic test env: ruby PATH + RAILS_ENV=test + the isolated test DB.
# Deliberately does NOT inherit the worktree's STACK runtime vars (APP_PORT,
# LOCAL_EMAIL_CAPTURE, MAILER_HOST, REDIS_URL, ...) — those change app behavior
# (mailer host/port, local email capture) and made the suite diverge from CI.
# The worktree's .env (loaded by dotenv) supplies the canonical test defaults.
# Tradeoff: the isolated stack REDIS_URL is dropped too — inert in test (null
# cache, fake jobs), but two worktrees running `test` at once would share the
# default Redis rather than per-worktree DBs.
def test_command_env(app, values)
  path_parts = [app["ruby_path"], ENV["PATH"]].compact
  env = { "PATH" => path_parts.join(":"), "RAILS_ENV" => "test" }
  test_url = test_database_url(values)
  env["DATABASE_URL"] = test_url if test_url
  env
end

# Path to the worktree's dotenv test-env override. dotenv-rails auto-loads
# `.env.test.local` (its highest-priority file) whenever RAILS_ENV=test, so this
# is the seam that makes a PLAIN `bin/rails test` find the isolated test DB
# without sourcing .env.agent-stack or unsetting DATABASE_URL. Gitignored (/.env*).
def test_env_local_path(dir)
  File.join(dir, ".env.test.local")
end

# Pin the worktree's TEST env to its OWN isolated test DB via a distinct
# TEST_DATABASE_URL. config/database.yml's `test.url` reads it and an explicit
# url wins over DATABASE_URL — which the worktree exports at the seeded DEV DB.
# Written to .env.test.local (auto-loaded by dotenv for RAILS_ENV=test), so a
# plain `bin/rails test` resolves here even when DATABASE_URL points at dev.
# Idempotent: safe to (re)write on every prepare. No-op without a derivable test DB.
def write_test_env_local(dir, values)
  test_url = test_database_url(values)
  return unless test_url

  File.write(test_env_local_path(dir), <<~ENVFILE)
    # Generated by mcritchie-studio/bin/agent-worktree.
    # Safe to regenerate; do not commit (gitignored via /.env*).
    # dotenv-rails auto-loads this for RAILS_ENV=test; config/database.yml's
    # `test.url` reads TEST_DATABASE_URL so a plain `bin/rails test` resolves to
    # this isolated DB even when DATABASE_URL points at the seeded dev DB.
    TEST_DATABASE_URL=#{test_url}
  ENVFILE
end

# Prepare the worktree's TEST environment: the isolated test DB *and* the bundled
# assets, in ONE rails boot.
#
# db:test:prepare — must be db:test:prepare (NOT db:schema:load): it leaves the base
# test DB in a state where minitest's parallel workers can clone their per-worker DBs.
# A schema:load'd test DB DEADLOCKS the first parallel `bin/rails test` at worker-DB
# setup, and is what surfaced the transient `before_setup` fixture errors on a fresh
# worktree. Also (re)writes .env.test.local so a plain `bin/rails test` resolves here.
#
# test:prepare — Rails' standard pre-test hook, which tailwindcss-rails enhances with
# `tailwindcss:build` (cssbundling/jsbundling enhance it the same way). It is what
# BUILDS app/assets/builds/tailwind.css, and that directory is GITIGNORED — a virgin
# worktree has nothing but .keep in it. db:test:prepare does NOT build it (tailwindcss
# falls back to enhancing db:test:prepare only when test:prepare is undefined, which it
# never is in a Rails app), and neither does a test run that passes explicit paths:
# Rails::Command::TestCommand runs the prepare task only `if self.args.none?(
# EXACT_TEST_ARGUMENT_PATTERN)`, so `bin/rails test test/models/x_test.rb` SKIPS it while
# an argless `bin/rails test` (CI, bin/full-suite-check) gets it for free. (The release
# gate workspaces prep their own env the same way as this method — `db:test:prepare
# test:prepare` in prepare_gate_workspace! since PR #522.)
# Without this, `bin/agent-worktree test <app> <task> <file>` and every
# bin/fast-check lane went red on a fresh worktree with `The asset "tailwind.css" is not
# present in the asset pipeline` — a false-red G1 cert on a diff that never touched a view.
# Named "prepare the test ENV", not "the test DB", because it is now both.
#
# The asset build is deliberately NOT gated on the test DB: a worktree with no
# derivable test DB still renders views, and gating the CSS build behind a DATABASE
# concern is exactly how this bug would creep back in. No test DB → we skip only
# db:test:prepare, and still build.
def prepare_test_env(dir, app, values)
  tasks = []
  if test_database_url(values)
    write_test_env_local(dir, values)
    tasks << "db:test:prepare"
  end
  tasks << "test:prepare"
  sh("bin/rails", *tasks, chdir: dir, env: test_command_env(app, values), allow_fail: true)
end

def prepare_rails(dir, app, values)
  env = command_env(app, values)
  sh("bin/rails", "db:prepare", chdir: dir, env: env)
  # No separate tailwindcss:build here: prepare_test_env's test:prepare already builds
  # app/assets/builds/tailwind.css, unconditionally, and the compiled CSS is the same
  # file whatever RAILS_ENV compiled it — a second dev-env build would be pure duplicate work.
  prepare_test_env(dir, app, values)
end

# Run the worktree's test suite reliably: correct ruby PATH, RAILS_ENV=test, the
# isolated worktree test DB (freshly prepared), and SINGLE-PROCESS execution.
#
# Single-process (PARALLEL_WORKERS=1) is deliberate: minitest's parallel workers
# clone the test DB at fork time (CREATE DATABASE ... TEMPLATE base), which races
# the base connection and intermittently DEADLOCKS the first run in a fresh
# worktree (and is what surfaced the transient before_setup fixture errors).
# Single-process uses the base test DB directly — ~2x slower on the full suite
# (~30s vs ~15s) but green on the first try, every time. CI keeps parallel.
# Extra args pass through (e.g. a single test file). The hermetic env
# (test_command_env) keeps the worktree's stack runtime vars out of the run, so
# the suite behaves like CI — the "order-dependent" mailer/delivery failures were
# really the stack's APP_PORT / LOCAL_EMAIL_CAPTURE leaking in.
def run_worktree_tests(dir, app, values, args)
  clear_orphan_test_procs(dir)
  # Prepares the DB *and* the bundled assets: passing a test file in `args` makes Rails
  # skip its own test:prepare, so this is the only thing that builds the CSS for that run.
  prepare_test_env(dir, app, values)
  env = test_command_env(app, values).merge("PARALLEL_WORKERS" => "1")
  sh("bin/rails", "test", *args, chdir: dir, env: env)
end

# Kill leftover `rails test` processes from a prior killed/hung run whose working
# directory is THIS worktree — they hold the worktree's test DB and would deadlock
# the next run (the friction that surfaced single-process in the first place).
# Scoped by BOTH the command line ("rails test") and the cwd, so it never touches
# the worktree's dev server (a puma/"rails server" proc) or another worktree's run.
def clear_orphan_test_procs(dir)
  target = File.expand_path(dir)
  pids = `pgrep -f "rails test" 2>/dev/null`.split.map(&:to_i).reject(&:zero?)
  pids.each do |pid|
    next if pid == Process.pid

    cwd_line = `lsof -a -p #{pid} -d cwd -Fn 2>/dev/null`.lines.find { |line| line.start_with?("n") }
    next unless cwd_line && cwd_line[1..].strip == target

    warn "clearing orphaned test proc #{pid} (cwd #{target})"
    Process.kill("KILL", pid)
  rescue Errno::ESRCH, Errno::EPERM
    # already gone, or not ours to kill — skip
  end
end

def start_generic_rails(dir, app, values)
  prepare_rails(dir, app, values)

  pidfile = File.join(dir, "tmp", "pids", "agent-web.pid")
  logfile = File.join(dir, "log", "agent-web.log")
  FileUtils.mkdir_p(File.dirname(pidfile))
  FileUtils.mkdir_p(File.dirname(logfile))

  if File.exist?(pidfile)
    pid = File.read(pidfile).strip
    if pid_alive?(pid)
      puts "web already running pid #{pid}"
      return
    end
    live_pid = port_pid(values.fetch("APP_PORT"))
    unless live_pid.empty?
      assert_own_stack!(values.fetch("APP_PORT"), dir, live_pid)
      File.write(pidfile, "#{live_pid}\n")
      puts "repaired web pidfile with live pid #{live_pid} on port #{values.fetch("APP_PORT")}"
      return
    end
    FileUtils.rm_f(pidfile)
  end

  live_pid = port_pid(values.fetch("APP_PORT"))
  unless live_pid.empty?
    assert_own_stack!(values.fetch("APP_PORT"), dir, live_pid)
    File.write(pidfile, "#{live_pid}\n")
    puts "web already running pid #{live_pid} on port #{values.fetch("APP_PORT")}"
    return
  end

  env = command_env(app, values)
  pid = Process.spawn(env, "bin/rails", "server", "-p", values.fetch("APP_PORT"),
                      chdir: dir, in: File::NULL, out: [logfile, "a"], err: [:child, :out], pgroup: true)
  Process.detach(pid)
  File.write(pidfile, "#{pid}\n")
  puts "started web pid #{pid}"
end

def start_tm(dir, app, values)
  prepare_rails(dir, app, values)
  sh("bin/tm", "up", "--no-stripe", chdir: dir, env: command_env(app, values))
end

def wait_for_url(port)
  url = "http://localhost:#{port}/up"
  last_code = nil
  30.times do
    out, = Open3.capture3("curl", "-sS", "-o", "/dev/null", "-m", "2", "-w", "%{http_code}", url)
    code = out.strip
    last_code = code unless code.empty?
    return code if code == "200"

    sleep 1
  end
  last_code || "down"
end

def tail_file(path, lines = 80)
  return "(missing #{path})" unless File.exist?(path)

  File.readlines(path, chomp: true).last(lines).join("\n")
rescue Errno::ENOENT
  "(missing #{path})"
end

def verify_started_stack!(app, dir, port)
  pidfile = app.fetch("stack") == "tm" ? File.join(dir, "tmp", "pids", "tm-web.pid") : File.join(dir, "tmp", "pids", "agent-web.pid")
  logfile = app.fetch("stack") == "tm" ? File.join(dir, "log", "tm-web.log") : File.join(dir, "log", "agent-web.log")

  sleep 1
  record = stack_record(app, dir)
  return record if record[:code] == "200" && !record[:port_pid].empty? && !record[:pidfile_state].start_with?("stale")

  warn "worktree server did not stay healthy after startup"
  warn "  url: http://localhost:#{port}"
  warn "  /up: #{record[:code]}"
  warn "  port pid: #{record[:port_pid].empty? ? "none" : record[:port_pid]}"
  warn "  pidfile: #{pidfile} (#{record[:pidfile_state]})"
  warn "  log: #{logfile}"
  warn
  warn tail_file(logfile)
  exit 1
end

def git_value(dir, *args)
  ok, out, = capture_status("git", *args, chdir: dir)
  ok ? out.strip : "?"
end

def git_success?(dir, *args)
  ok, = capture_status("git", *args, chdir: dir)
  ok
end

# Resolve the integration base ref ONCE for branch-cut, ahead/behind, and merge
# checks. Post-v2-cutover feature branches cut from and PR into the persistent
# `accepted` integration branch (created off `release`), so it is preferred here.
# We fall back to `origin/release` (pre-v2, or a repo not yet on the accepted
# ladder) and then `origin/main` (no `bin/release init`), so nothing breaks during
# or after cutover.
def base_ref_for(dir)
  return "origin/accepted" if git_success?(dir, "rev-parse", "--verify", "origin/accepted")
  return "origin/release" if git_success?(dir, "rev-parse", "--verify", "origin/release")

  "origin/main"
end

# Bare base branch name (`accepted` | `release` | `main`) for `gh pr create --base` and the
# GitHub compare URL — derived from the same resolution as base_ref_for.
def base_branch_for(dir)
  base_ref_for(dir).delete_prefix("origin/")
end

def git_dirty?(dir)
  !git_value(dir, "status", "--porcelain").empty?
end

def git_branch(dir)
  git_value(dir, "branch", "--show-current")
end

def git_head(dir)
  git_value(dir, "rev-parse", "--short", "HEAD")
end

def git_commit_subject(dir)
  git_value(dir, "log", "-1", "--pretty=%s")
end

def git_ahead_behind(dir, base = base_ref_for(dir))
  return ["?", "?"] unless git_success?(dir, "rev-parse", "--verify", base)

  value = git_value(dir, "rev-list", "--left-right", "--count", "#{base}...HEAD")
  behind, ahead = value.split(/\s+/, 2)
  [ahead || "?", behind || "?"]
end

# True when HEAD is already contained in the resolved base (a real merge). A
# branch merged into `release` but not yet shipped to `main` counts as done for
# feature work, so cleanup/reclaim release it.
def git_merged_to_base?(dir, base = base_ref_for(dir))
  return false unless git_success?(dir, "rev-parse", "--verify", base)

  git_success?(dir, "merge-base", "--is-ancestor", "HEAD", base)
end

# True when HEAD's final diff against the resolved base is empty (the squash-merge
# case, where the feature SHA is not preserved on the base).
def git_equivalent_to_base?(dir, base = base_ref_for(dir))
  return false unless git_success?(dir, "rev-parse", "--verify", base)

  git_success?(dir, "diff", "--quiet", "#{base}..HEAD")
end

def cleanup_ready?(record)
  !record.fetch(:dirty) && (record.fetch(:merged) || record.fetch(:equivalent_to_main))
end

def github_repo_slug(dir)
  remote = git_value(dir, "remote", "get-url", "origin")
  case remote
  when %r{\Agit@github\.com:(.+?)(?:\.git)?\z}
    Regexp.last_match(1).delete_suffix(".git")
  when %r{\Ahttps://github\.com/(.+?)(?:\.git)?\z}
    Regexp.last_match(1).delete_suffix(".git")
  end
end

def github_compare_url(record)
  repo = github_repo_slug(record[:dir])
  return nil unless repo

  branch = record[:branch]
  base = record[:base_branch] || base_branch_for(record[:dir])
  "https://github.com/#{repo}/compare/#{base}...#{branch}?expand=1"
end

def command_available?(name)
  ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
    path = File.join(dir, name)
    File.file?(path) && File.executable?(path)
  end
end

# --- merge-verified force removal -------------------------------------------
# `remove --force` exists for ONE broken case: a worktree whose PR was
# squash-merged into the base under the old pre-`release`-branch flow. Squash
# merges do not preserve the feature SHA, so `git_merged_to_base?` is false and
# `cleanup_ready?` stays false forever — the branch shipped, yet `remove` refuses
# it with "branch content is not represented on <base>". `--force` overrides ONLY
# that content guard, and ONLY when a merged PR is verified on GitHub. It never
# touches the `dirty` or `not-git-registered` guards (those are genuine
# data-loss / wrong-state, not a squash-merge artifact).

# Pure decision: should `--force` clear the "branch content is not represented on
# <base>" blocker for this record? Only when force is set AND a merged PR was
# verified AND the worktree is clean. `dirty` is a SEPARATE blocker computed
# independently in run_remove and is never suppressed here; returning false for a
# dirty record keeps that intent explicit and unit-testable. The not-registered
# guard is computed by registered_worktree? and is not an input to this method,
# so --force can never clear it.
def force_clears_content_blocker?(record, force:, merged:)
  force && merged && !record.fetch(:dirty)
end

# Merge verification, injectable for tests (mirrors dor-check's
# DOR_CHECK_CHANGED_FILES seam). AGENT_WORKTREE_MERGED_PR set to a non-empty
# value short-circuits the real gh call and reports that PR number as merged;
# empty / unset falls through to `gh`. Returns [status, pr_number]:
#   [:merged, "<n>"]    a merged PR exists for the branch
#   [:none, nil]        gh ran but found no merged PR for the branch
#   [:unavailable, nil] gh is not installed, or there is no GitHub remote
def merged_pr_for_branch(record)
  override = ENV["AGENT_WORKTREE_MERGED_PR"].to_s.strip
  return [:merged, override] unless override.empty?

  return [:unavailable, nil] unless command_available?("gh")

  slug = github_repo_slug(record[:dir])
  return [:unavailable, nil] unless slug

  branch = record[:branch].to_s
  return [:none, nil] if branch.empty? || branch == "?"

  ok, out, = capture_status("gh", "pr", "list", "--repo", slug, "--head", branch, "--state", "merged", "--json", "number")
  return [:unavailable, nil] unless ok

  prs =
    begin
      JSON.parse(out)
    rescue JSON::ParserError
      []
    end
  first = prs.is_a?(Array) ? prs.first : nil
  number = first.is_a?(Hash) ? first["number"] : nil
  number ? [:merged, number.to_s] : [:none, nil]
end

def human_title(slug)
  slug.split("-").map(&:capitalize).join(" ")
end

def compact_value(value)
  value = value.to_s.strip
  value.empty? ? nil : value
end

def truthy_value?(value)
  value == true || %w[true 1 yes on].include?(compact_value(value).to_s.downcase)
end

def shiny_state(value)
  return true if truthy_value?(value)
  return false if value == false || %w[false 0 no off].include?(compact_value(value).to_s.downcase)

  nil
end

def mascot_display_emoji(emoji, shiny)
  raw = compact_value(emoji).to_s
  state = shiny_state(shiny)
  wants_shiny = state.nil? ? raw.include?(SHINY_EMOJI) : state
  return compact_value(raw.delete(SHINY_EMOJI)) if state == false
  return compact_value(raw) unless wants_shiny

  base = raw.delete(SHINY_EMOJI)
  compact_value("#{base}#{SHINY_EMOJI}")
end

def task_slug_from_url(value)
  compact_value(value)&.match(%r{/tasks/([^/?#]+)})&.captures&.first
end

def task_record_slug(values)
  compact_value(values["TASK_RECORD_SLUG"]) ||
    compact_value(values["MCRITCHIE_TASK_SLUG"]) ||
    compact_value(values["TASK_BOARD_SLUG"]) ||
    task_slug_from_url(values["TASK_URL"])
end

def task_url(values)
  explicit = compact_value(values["TASK_URL"])
  return explicit if explicit

  slug = task_record_slug(values)
  slug ? "#{TASK_BASE_URL}/#{slug}" : nil
end

def parse_task_reference(value)
  value = compact_value(value)
  abort "task record slug or URL required" unless value

  if value.match?(%r{\Ahttps?://})
    slug = task_slug_from_url(value)
    abort "task URL must include /tasks/<task-slug>: #{value}" unless slug

    [slug, value]
  else
    [value, "#{TASK_BASE_URL}/#{value}"]
  end
end

def ensure_context_file_excluded(dir)
  ok, out, = capture_status("git", "rev-parse", "--git-path", "info/exclude", chdir: dir)
  return unless ok

  exclude_path = out.strip
  return if exclude_path.empty?

  FileUtils.mkdir_p(File.dirname(exclude_path))
  existing = File.exist?(exclude_path) ? File.read(exclude_path) : ""
  return if existing.lines.map(&:strip).include?(CONTEXT_FILE)

  File.open(exclude_path, "a") do |file|
    file.puts
    file.puts "# Local agent session context; generated by bin/agent-worktree."
    file.puts CONTEXT_FILE
  end
end

def prompt_badge(app, task, port, stage = nil, task_record = nil)
  stage_part = stage.to_s.empty? ? nil : stage
  parts = [app.fetch("slug"), task, task_record, port.to_s.empty? ? nil : ":#{port}", stage_part].compact
  "[#{parts.join(" ")}]"
end

def terminal_title(app, task, port, task_record = nil)
  port_part = port.to_s.empty? ? nil : ":#{port}"
  [app.fetch("display_name", app.fetch("slug")), task, task_record, port_part].compact.join(" | ")
end

def shell_export(name, value)
  "export #{name}=#{value.to_s.shellescape}"
end

def context_scalar(context, key)
  value = context[key]
  return nil if value.nil?
  return value.to_s if value.is_a?(String) || value.is_a?(Numeric) || value == true || value == false

  nil
end

def shell_context_from_payload(context)
  app_slug = context_scalar(context, "app")
  app_name = context_scalar(context, "app_name") || app_slug
  task = context_scalar(context, "task_slug") || context_scalar(context, "worktree_slug")
  worktree_slug = context_scalar(context, "worktree_slug") || task
  task_record = context_scalar(context, "task_record_slug")
  task_record_url = context_scalar(context, "task_url")
  port = context_scalar(context, "app_port")
  local_review_url = context_scalar(context, "local_url") || local_url(port)
  stage = context_scalar(context, "stage")
  port_part = port.to_s.empty? ? nil : ":#{port}"
  title = [app_name, task, task_record, port_part].compact.join(" | ")
  badge_parts = [app_slug, worktree_slug, task_record, port_part, stage].compact
  badge = "[#{badge_parts.join(" ")}]"

  {
    "title_command" => "printf '\\033]0;%s\\007' #{title.shellescape}",
    "exports" => [
      shell_export("AGENT_CONTEXT_APP", app_slug),
      shell_export("AGENT_CONTEXT_TASK", task),
      shell_export("AGENT_CONTEXT_WORKTREE_SLUG", worktree_slug),
      shell_export("AGENT_CONTEXT_TASK_RECORD", task_record),
      shell_export("AGENT_CONTEXT_TASK_URL", task_record_url),
      shell_export("AGENT_CONTEXT_PORT", port),
      shell_export("AGENT_CONTEXT_URL", local_review_url),
      shell_export("AGENT_CONTEXT_TITLE", title),
      shell_export("AGENT_CONTEXT_BADGE", badge)
    ]
  }
end

def refresh_codex_session_title(dir)
  return if ENV["CODEX_SESSION_TITLE_RUNNING"] == "1"
  return if ENV["CODEX_THREAD_ID"].to_s.strip.empty?

  script = File.join(__dir__, "codex-session-title")
  return unless File.executable?(script)

  system({ "CODEX_SESSION_TITLE_RUNNING" => "1" }, script, out: File::NULL, err: File::NULL, chdir: dir)
rescue StandardError
  nil
end

# Resolve the session's Pokemon mascot with a fallback chain so a context
# regeneration can never downgrade a known mascot to blank (the observed
# "Jigglypuff -> task link" flip-flop, where a from-scratch values rebuild —
# `new`, test-DB provisioning — overwrote the bound mascot). Order:
#   1. values["TASK_MASCOT"]      — set by bind-task, persisted in .env.agent-stack
#   2. the mascot already on disk  — last good .agent-context.json value
#   3. the task record            — devops.mascot via `bin/task field` (best-effort)
def resolve_mascot(values, dir, task)
  from_values = compact_value(values["TASK_MASCOT"])
  return from_values if from_values

  on_disk = existing_context_mascot(dir)
  return on_disk if on_disk

  record_mascot(task_record_slug(values) || task)
end

def existing_context_mascot(dir)
  path = context_path(dir)
  return nil unless File.exist?(path)

  compact_value(JSON.parse(File.read(path))["mascot"])
rescue JSON::ParserError
  nil
end

# Best-effort devops.mascot lookup for the first context paint (before bind-task
# has persisted TASK_MASCOT). Mirrors run_bind_task's fetch; never raises or
# blocks a context write — an unreachable board just leaves the mascot unset.
def record_mascot(record_slug)
  slug = compact_value(record_slug)
  return nil unless slug

  mascot = `#{task_cli_path.shellescape} field #{slug.shellescape} mascot 2>/dev/null`.to_s.strip
  mascot.empty? ? nil : mascot
end

# The mascot's display attributes (color + type emoji), each resolved to RIDE WITH
# the mascot and never downgrade — the same no-downgrade guarantee resolve_mascot
# gives the name. The last-good on-disk value wins over a fresh board read, but
# ONLY when it belongs to the SAME mascot we're about to write: so a momentary
# blank board read — or a task that never re-stamped the attribute — keeps the
# known value instead of flipping ⊙<mascot> back to the default tint/glyphs, while
# a DIFFERENT mascot never inherits the old one's. (This is why the slug AND its
# display attributes all need the fallback chain.)
def resolve_mascot_color(values, dir, task, mascot)
  existing_context_attr(dir, mascot, "mascot_color") ||
    record_mascot_field(task_record_slug(values) || task, "mascot_color")
end

def resolve_mascot_emoji(values, dir, task, mascot)
  shiny = resolve_mascot_shiny(values, dir, task, mascot)
  emoji = existing_context_attr(dir, mascot, "mascot_emoji") ||
          record_mascot_field(task_record_slug(values) || task, "mascot_emoji")
  mascot_display_emoji(emoji, shiny)
end

def resolve_mascot_shiny(values, dir, task, mascot)
  [
    values["TASK_MASCOT_SHINY"],
    existing_context_raw_attr(dir, mascot, "mascot_shiny"),
    record_mascot_field(task_record_slug(values) || task, "mascot_shiny")
  ].each do |value|
    state = shiny_state(value)
    return state unless state.nil?
  end

  nil
end

# The on-disk context's <key>, but only when its mascot matches `mascot`, so an
# attribute can never be stale-paired to a changed mascot.
def existing_context_attr(dir, mascot, key)
  compact_value(existing_context_raw_attr(dir, mascot, key))
end

def existing_context_raw_attr(dir, mascot, key)
  return nil unless compact_value(mascot)

  path = context_path(dir)
  return nil unless File.exist?(path)

  data = JSON.parse(File.read(path))
  return nil unless compact_value(data["mascot"]) == mascot

  data[key]
rescue JSON::ParserError
  nil
end

# A best-effort devops.<field> board read via `bin/task field` — the last-resort
# source (first paint, before the attribute is on disk).
def record_mascot_field(record_slug, field)
  slug = compact_value(record_slug)
  return nil unless slug

  value = `#{task_cli_path.shellescape} field #{slug.shellescape} #{field.shellescape} 2>/dev/null`.to_s.strip
  value.empty? ? nil : value
end

# The app's status-line tint (App#color, stamped server-side onto devops.app_color),
# resolved to ride with the app slug and never downgrade — the same no-downgrade
# guarantee resolve_mascot_color gives, keyed on the app. The last-good on-disk
# value wins over a fresh board read, but ONLY when it belongs to the SAME app, so
# an offline `bin/task field` (or a task that hasn't re-stamped) keeps the known
# tint while a DIFFERENT app never inherits the old one's.
def resolve_app_color(values, dir, task, app_slug)
  existing_context_app_color(dir, app_slug) ||
    record_mascot_field(task_record_slug(values) || task, "app_color")
end

def existing_context_app_color(dir, app_slug)
  return nil unless compact_value(app_slug)

  path = context_path(dir)
  return nil unless File.exist?(path)

  data = JSON.parse(File.read(path))
  return nil unless compact_value(data["app"]) == app_slug

  compact_value(data["app_color"])
rescue JSON::ParserError
  nil
end

def context_payload(app, task, values, dir, record: nil, stage: nil)
  port = values["APP_PORT"].to_s
  redis_db = redis_db_from_url(values["REDIS_URL"])
  database = db_name_from_url(values["DATABASE_URL"])
  branch = record ? record[:branch] : git_branch(dir)
  head = record ? record[:head] : git_head(dir)
  task_record = task_record_slug(values)
  task_record_url = task_url(values)
  title = terminal_title(app, task, port, task_record)
  badge = prompt_badge(app, task, port, stage, task_record)
  # Resolve the mascot once so its color can ride with it (same name → same tint).
  mascot = resolve_mascot(values, dir, task)
  mascot_shiny = resolve_mascot_shiny(values, dir, task, mascot)

  {
    "schema_version" => 1,
    "generated_at" => Time.now.utc.iso8601,
    "app" => app.fetch("slug"),
    "app_name" => app.fetch("display_name", app.fetch("slug")),
    "app_color" => resolve_app_color(values, dir, task, app.fetch("slug")),
    "task_slug" => task,
    "worktree_slug" => task,
    "task_record_slug" => task_record,
    "task_url" => task_record_url,
    "mascot" => mascot,
    "mascot_color" => resolve_mascot_color(values, dir, task, mascot),
    "mascot_emoji" => resolve_mascot_emoji(values, dir, task, mascot),
    "mascot_shiny" => (true if mascot_shiny),
    "branch" => branch,
    "head" => head,
    "repo" => app.fetch("repo"),
    "worktree" => dir,
    "context_file" => context_path(dir),
    "local_url" => local_url(port),
    "local_inbox_url" => local_inbox_url(port),
    "app_port" => port.empty? ? nil : port.to_i,
    "redis_db" => redis_db.empty? ? nil : redis_db.to_i,
    "database" => database.empty? ? nil : database,
    "health" => record ? stack_health(record) : nil,
    "up_code" => record ? record[:code] : nil,
    "dirty" => record ? record[:dirty] : nil,
    "stage" => stage,
    "terminal_title" => title,
    "prompt_badge" => badge
  }
end

def write_context_marker(app, task, values, dir, record: nil, stage: nil)
  ensure_context_file_excluded(dir)
  payload = context_payload(app, task, values, dir, record: record, stage: stage)
  File.write(context_path(dir), "#{JSON.pretty_generate(payload)}\n")
  refresh_codex_session_title(dir)
  payload
end

def find_context_path(start_dir = Dir.pwd)
  dir = File.expand_path(start_dir)
  loop do
    path = context_path(dir)
    return path if File.exist?(path)

    parent = File.dirname(dir)
    return nil if parent == dir

    dir = parent
  end
end

def read_context(path)
  JSON.parse(File.read(path))
rescue JSON::ParserError => e
  abort "invalid #{path}: #{e.message}"
end

def print_context(context)
  puts "session context"
  puts "app:      #{context["app_name"] || context["app"]} (#{context["app"]})"
  puts "task:     #{context["task_record_slug"] || "not bound"}"
  puts "task url: #{context["task_url"] || "not bound"}"
  puts "worktree: #{context["task_slug"]}"
  puts "branch:   #{context["branch"]}"
  puts "head:     #{context["head"]}" if context["head"]
  puts "path:     #{context["worktree"]}"
  puts "url:      #{context["local_url"] || "not started"}"
  puts "email:    #{context["local_inbox_url"] || "not started"}"
  puts "port:     #{context["app_port"] || "?"}"
  puts "redis:    #{context["redis_db"] ? "db #{context["redis_db"]}" : "?"}"
  puts "db:       #{context["database"] || "?"}"
  puts "health:   #{context["health"] || "unknown"}#{context["up_code"] ? " (/up #{context["up_code"]})" : ""}"
  puts
  puts "terminal title:"
  puts "  #{context["terminal_title"]}"
  puts "prompt badge:"
  puts "  #{context["prompt_badge"]}"
  puts
  puts "shell:"
  shell_context = shell_context_from_payload(context)
  shell_context.fetch("exports").each { |line| puts "  #{line}" }
  puts "  #{shell_context.fetch("title_command")}"
end

def run_whereami(app = nil, task = nil, json: false, shell: false)
  context =
    if app && task
      values = load_stack_env(app, task)
      dir = worktree_dir(app, task)
      record = Dir.exist?(dir) ? stack_record(app, dir) : nil
      write_context_marker(app, task, values, dir, record: record)
    else
      path = find_context_path
      abort "no #{CONTEXT_FILE} found from #{Dir.pwd}; run bin/agent-worktree whereami <app> <task-slug> or recreate the stack with bin/agent-worktree new." unless path
      read_context(path)
    end

  if json
    puts JSON.pretty_generate(context)
  elsif shell
    shell_context = shell_context_from_payload(context)
    shell_context.fetch("exports").each { |line| puts line }
    puts shell_context.fetch("title_command")
  else
    print_context(context)
  end
end

def run_bind_task(app, task, reference)
  values = load_stack_env(app, task)
  dir = worktree_dir(app, task)
  abort "missing worktree: #{dir}\nRun: bin/agent-worktree new #{app.fetch("slug")} #{task}" unless Dir.exist?(dir)

  record_slug, url = parse_task_reference(reference)
  values["TASK_RECORD_SLUG"] = record_slug
  values["TASK_URL"] = url
  # Best-effort: capture the task's Pokémon mascot for the status line. The
  # bin/task field reader hits the board API; any failure (offline / auth / no
  # mascot) just leaves it unset, so binding never depends on it.
  if record_slug =~ /\A[\w.-]+\z/
    mascot = `#{task_cli_path.shellescape} field #{record_slug} mascot 2>/dev/null`.to_s.strip
    values["TASK_MASCOT"] = mascot unless mascot.empty?
    shiny = `#{task_cli_path.shellescape} field #{record_slug} mascot_shiny 2>/dev/null`.to_s.strip
    case shiny_state(shiny)
    when true
      values["TASK_MASCOT_SHINY"] = "true"
    when false
      values["TASK_MASCOT_SHINY"] = "false"
    end
  end
  write_stack_env(app, task, values)

  record = stack_record(app, dir)
  context = write_context_marker(app, task, values, dir, record: record)

  puts "task bound"
  puts "task:     #{context.fetch("task_record_slug")}"
  puts "task url: #{context.fetch("task_url")}"
  puts "worktree: #{context.fetch("worktree_slug")}"
  puts "context:  #{context.fetch("context_file")}"
end

def run_shell_hook(shell)
  usage unless shell == "zsh"

  launcher = File.expand_path($PROGRAM_NAME)
  puts <<~ZSH
    # Source with:
    #   eval "$(#{launcher.shellescape} shell-hook zsh)"
    #
    # Exposes AGENT_CONTEXT_* variables and keeps the terminal title current
    # whenever the shell prompt is redrawn or the working directory changes.
    _agent_worktree_context_refresh() {
      local agent_context_script
      agent_context_script="$(#{launcher.shellescape} whereami --shell 2>/dev/null)"
      if [ $? -eq 0 ]; then
        eval "$agent_context_script"
      else
        unset #{AGENT_CONTEXT_EXPORTS.join(" ")}
      fi
    }

    if autoload -Uz add-zsh-hook 2>/dev/null; then
      add-zsh-hook chpwd _agent_worktree_context_refresh
      add-zsh-hook precmd _agent_worktree_context_refresh
    fi

    _agent_worktree_context_refresh
  ZSH
end

def db_name_from_url(url)
  url.to_s.split("/").last.to_s.split("?").first.to_s
end

def redis_db_from_url(url)
  url.to_s.split("/").last.to_s.split("?").first.to_s
end

def database_exists?(db_name)
  return nil if db_name.empty?
  return nil unless system("pg_isready", "-q", out: File::NULL, err: File::NULL)

  ok, out, = capture_status("psql", "-Atqc", "SELECT 1 FROM pg_database WHERE datname='#{db_name.gsub("'", "''")}'", "postgres")
  ok ? out.strip == "1" : nil
end

def stack_dirs(app)
  # Discovered repos carry their resolved tree (the sibling-tree convention puts it
  # beside the repo, not inside it); registered apps use the managed layout.
  root = app["worktrees_dir"] || File.join(app.fetch("repo"), ".worktrees")
  Dir.glob(File.join(root, "*")).select { |dir| File.directory?(dir) }.sort
end

def stack_record(app, dir)
  env_path = File.join(dir, STACK_ENV)
  raw_env = parse_env(env_path)
  values = local_email_values.merge(raw_env)
  task = File.basename(dir)
  port = values["APP_PORT"].to_s
  redis_db = redis_db_from_url(values["REDIS_URL"])
  db_name = db_name_from_url(values["DATABASE_URL"])
  pidfile = app.fetch("stack") == "tm" ? File.join(dir, "tmp", "pids", "tm-web.pid") : File.join(dir, "tmp", "pids", "agent-web.pid")
  sidekiq_pidfile = File.join(dir, "tmp", "pids", "tm-sidekiq.pid")
  base_ref = base_ref_for(dir)
  ahead, behind = git_ahead_behind(dir, base_ref)
  {
    app: app,
    task: task,
    dir: dir,
    env_path: env_path,
    env_exists: File.exist?(env_path),
    env: values,
    raw_env: raw_env,
    port: port,
    port_pid: port_pid(port),
    code: http_code(port),
    redis_db: redis_db,
    db_name: db_name,
    db_exists: database_exists?(db_name),
    branch: git_branch(dir),
    head: git_head(dir),
    commit_subject: git_commit_subject(dir),
    dirty: git_dirty?(dir),
    # base_ref is the resolved integration target (`origin/release` else
    # `origin/main`); ahead/behind/merged/equivalent_to_main are all reckoned
    # against it. The :equivalent_to_main symbol keeps its historical name as an
    # internal label but measures equivalence to base_ref, not necessarily main.
    base_ref: base_ref,
    base_branch: base_ref.delete_prefix("origin/"),
    ahead: ahead,
    behind: behind,
    merged: git_merged_to_base?(dir, base_ref),
    equivalent_to_main: git_equivalent_to_base?(dir, base_ref),
    pidfile: pidfile,
    pidfile_state: pidfile_state(pidfile),
    sidekiq_pidfile_state: File.exist?(sidekiq_pidfile) ? pidfile_state(sidekiq_pidfile) : "missing"
  }
end

# Repos that carry worktrees but are NOT registered apps — discovered from disk.
#
# `apps` is built from config/satellites.yml, whose job is to register satellite
# APPS: it drives the navbar, SSO roles and bin/ecosystem-build. A gem or library
# repo (studio-engine, solana-studio, turf-vault) has no port and no stack, so it
# has no business in that file — but it still collects desks, and before this the
# sweep could not see them at all. `cleanup --reclaim studio-engine` answered
# "unknown app" while 64 desks sat there unswept, more than any registered app had.
#
# So sweep COVERAGE is derived from the ground truth — what has worktrees on disk —
# rather than from a hand-maintained list that exists for another purpose. A repo
# cannot silently escape the sweep by not being a satellite, and adding one needs no
# registry edit (which would be a product decision, not a cleanup).
#
# Two on-disk conventions, both real:
#   <root>/<repo>/.worktrees/<slug>      the managed app layout
#   <root>/<repo>.worktrees/<slug>       the sibling tree gem repos use
STACKLESS_STACK = "none"

# A desk belongs to a DISCOVERED repo when its config came from disk (a repo with a
# .worktrees tree that is not in the registry) rather than from the app registry. The
# reclaim hold and the teardown both key on this, so they cannot drift apart.
def discovered_app?(app_config)
  return false unless app_config

  app_config["status"].to_s == "discovered"
end

def discovered_worktree_configs
  registered = apps.values.map { |config| config.fetch("repo") }

  roots = Dir.glob(File.join(PROJECTS_DIR, "*", ".worktrees")).map { |dir| [File.dirname(dir), dir] } +
          Dir.glob(File.join(PROJECTS_DIR, "*.worktrees")).map { |dir| [dir.sub(/\.worktrees\z/, ""), dir] }

  roots.filter_map do |repo, worktrees_dir|
    next unless File.directory?(worktrees_dir)
    next if registered.include?(repo)

    # The sibling tree (<repo>.worktrees) and the managed one (<repo>/.worktrees)
    # are two homes for the SAME repo, so basename alone gives both configs one
    # slug. The dirs are distinct, so nothing is torn down twice — but every label
    # built from the slug (worktree_label, the delete-later ledger row, the
    # registry) then names two different desks identically, which is exactly the
    # ambiguity an archive record must not have.
    slug = File.basename(repo)
    slug = "#{slug}(sibling)" if worktrees_dir == "#{repo}.worktrees"
    # No port, no Redis DB, no server: these desks are a git worktree and nothing
    # else, so the teardown must skip stack stop / DB drop / Redis flush rather
    # than fail trying. `stack` is the field the rest of the file already keys on.
    # Carry the SAME key set a registry config carries, even where the values are
    # inert. Callers reach for these with app.fetch(...) — a deliberate "this must
    # exist" — so a config that merely omits them turns every such caller into a
    # KeyError at teardown time, i.e. mid-sweep, inside the lock. Matching the
    # shape is what lets a discovered repo travel every code path a registered one
    # does; `stack` is the field that then says "do nothing" where it matters.
    {
      "slug" => slug,
      "display_name" => slug,
      "repo" => repo,
      "worktrees_dir" => worktrees_dir,
      "stack" => STACKLESS_STACK,
      "status" => "discovered",
      "sidekiq" => false,
      "ruby_path" => nil,
      "primary_port" => nil,
      "range_start" => nil,
      "range_end" => nil,
      "session_env" => "#{slug.tr("-", "_").upcase}_SESSION_KEY",
      "session_key" => "_#{slug.tr("-", "_")}_session",
      "reserved_ports" => []
    }
  end
end

def stack_records(app = nil)
  selected = app ? [app] : apps.values + discovered_worktree_configs
  selected.flat_map { |config| stack_dirs(config).map { |dir| stack_record(config, dir) } }
end

def stack_health(record)
  return "missing-env" unless record[:env_exists]
  return "up" if record[:code] == "200"
  return "port-busy" if !record[:port_pid].empty?

  "down"
end

def duplicate_values(records, key)
  records.group_by { |record| record[key].to_s }.select { |value, grouped| !value.empty? && value != "?" && grouped.size > 1 }
end

def stop_generic_rails(dir, port = nil)
  pidfile = File.join(dir, "tmp", "pids", "agent-web.pid")
  unless File.exist?(pidfile)
    live_pid = port ? port_pid(port) : ""
    if live_pid.empty?
      puts "no agent-web pidfile"
      return
    end

    Process.kill("TERM", live_pid.to_i)
    puts "stopped web pid #{live_pid} on port #{port}"
    return
  end

  pid = File.read(pidfile).strip
  if pid_alive?(pid)
    Process.kill("TERM", pid.to_i)
    puts "stopped web pid #{pid}"
  elsif port && !(live_pid = port_pid(port)).empty?
    Process.kill("TERM", live_pid.to_i)
    puts "stopped web pid #{live_pid} on port #{port}"
  else
    puts "web not running"
  end
  FileUtils.rm_f(pidfile)
end

def list_worktrees(app = nil)
  selected = app ? [app] : apps.values
  selected.each do |config|
    records = stack_records(config)
    puts "#{config.fetch("slug")}  primary http://localhost:#{config.fetch("primary_port")}  range #{config.fetch("range_start")}-#{config.fetch("range_end")}"
    if records.empty?
      puts "  no worktrees"
      next
    end

    records.each do |record|
      url = record[:port].empty? ? "missing-port" : "http://localhost:#{record[:port]}"
      email_url = record[:port].empty? ? "missing-port" : "http://localhost:#{record[:port]}/_studio/local_emails"
      dirty = record[:dirty] ? "dirty" : "clean"
      merge = if record[:merged]
                "merged"
              elsif record[:equivalent_to_main]
                "base-eq"
              else
                "unmerged"
              end
      db = record[:db_exists].nil? ? record[:db_name] : "#{record[:db_name]}:#{record[:db_exists] ? "ok" : "missing"}"
      puts "  #{record[:task].ljust(24)} #{stack_health(record).ljust(11)} #{url.ljust(23)} #{record[:branch].ljust(28)} #{dirty} #{merge} +#{record[:ahead]}/-#{record[:behind]}"
      puts "    redis=#{record[:redis_db]} db=#{db} pid=#{record[:pidfile_state]} email=#{email_url}"
    end
  end
end

# Canonicalize for cross-source path comparison: `git worktree list` reports
# realpath'd paths (macOS /var and /tmp are symlinks into /private), while
# Dir.glob keeps PROJECTS_DIR as given. Fall back to expand_path if the path no
# longer exists on disk.
def canonical_path(path)
  File.realpath(path)
rescue SystemCallError
  File.expand_path(path)
end

# Every worktree git tracks for a repo (the primary checkout plus any
# `git worktree add` targets), canonicalized for comparison against managed dirs.
def git_worktree_dirs(repo)
  ok, out, = capture_status("git", "-C", repo, "worktree", "list", "--porcelain")
  return [] unless ok

  out.lines.each_with_object([]) do |line, dirs|
    line = line.chomp
    next unless line.start_with?("worktree ")

    dirs << canonical_path(line.delete_prefix("worktree "))
  end
end

# Pure reconciliation (set difference): any git-registered worktree that is
# neither the primary checkout nor a managed `.worktrees/*` dir is an ORPHAN the
# launcher never created and the registry never tracks. Paths are canonicalized
# by callers; this compares strings so it stays trivially unit-testable.
def orphan_worktree_dirs(primary, managed_dirs, git_dirs)
  known = [primary, *managed_dirs]
  git_dirs.reject { |dir| known.include?(dir) }
end

# Stable, collision-free doctor label for an orphan worktree. doctor_issues_by_label
# groups by label, so two orphans that share a basename (e.g. /a/foo and /b/foo)
# must not collapse to one key — append a short hash of the full canonical path.
def orphan_label(app, dir)
  digest = Digest::SHA1.hexdigest(dir)[0, 8]
  "#{app.fetch("slug")}/orphan:#{File.basename(dir)}-#{digest}"
end

# Reconcile `git worktree list` against the managed registry for an app and emit
# a doctor issue for each orphan, carrying its path, branch, merge state, and
# clean/dirty state so doctor stops reporting "no issues" while orphans pile up.
def orphan_worktree_issues(app)
  repo = app.fetch("repo")
  primary = canonical_path(repo)
  managed = stack_dirs(app).map { |dir| canonical_path(dir) }

  orphan_worktree_dirs(primary, managed, git_worktree_dirs(repo)).map do |dir|
    label = orphan_label(app, dir)

    # PRUNABLE: git still lists the worktree but its directory was deleted on
    # disk. Computing branch/merge/clean state would chdir into the missing dir
    # and raise Errno::ENOENT (the capture_status guard now also catches this),
    # which used to crash BOTH `doctor` and `snapshot --write`. Flag it
    # distinctly and skip the git calls so both still exit 0.
    next [label, "prunable git worktree at #{dir} (directory deleted on disk, still in `git worktree list`); run `git -C #{repo} worktree prune` then review"] unless Dir.exist?(dir)

    branch = git_branch(dir)
    branch = "detached" if branch.empty? || branch == "?"
    base = base_ref_for(dir)
    merge = git_merged_to_base?(dir, base) ? "merged to #{base}" : "unmerged"
    state = git_dirty?(dir) ? "dirty" : "clean"
    [label, "untracked git worktree at #{dir} (branch #{branch}, #{merge}, #{state}); not in managed registry — review then remove"]
  end
end

# Is this desk's port outside the band its app was allocated? Returns the issue message, or
# nil when there is nothing to report — INCLUDING when there is no band to report against.
#
# A discovered repo is allocated no port band (the registry hands those out), so range_start
# and range_end are nil and there is no range to be outside of. Comparing anyway raised
# `comparison of Integer with nil failed`. That ran inside doctor AND snapshot --write, and
# snapshot --write runs at the END of run_reclaim — so the sweep tore desks down and then died
# before refreshing the registry: the same sweep-aborts-registry-never-refreshes class as the
# KeyError, one step later. Discovered desks that DO carry a port are not hypothetical —
# moms-app and acquisition-studio are discovered Rails apps with live servers.
def port_range_issue(app_config, port)
  range_start = app_config.fetch("range_start")
  range_end = app_config.fetch("range_end")
  return nil if range_start.nil? || range_end.nil?
  return nil if port >= range_start && port <= range_end

  "APP_PORT #{port} outside #{range_start}-#{range_end}"
end

def doctor_issues(app = nil)
  records = stack_records(app)
  issues = []
  port_dupes = duplicate_values(records, :port)
  redis_dupes = duplicate_values(records, :redis_db)

  records.each do |record|
    app_config = record[:app]
    label = "#{app_config.fetch("slug")}/#{record[:task]}"
    issues << [label, "missing #{STACK_ENV}"] unless record[:env_exists]

    port = record[:port].to_i
    if port.zero?
      issues << [label, "missing APP_PORT"]
    else
      issue = port_range_issue(app_config, port)
      issues << [label, issue] if issue
    end

    if port_dupes.key?(record[:port].to_s)
      issues << [label, "APP_PORT #{record[:port]} reused by #{port_dupes.fetch(record[:port].to_s).map { |r| r[:task] }.join(", ")}"]
    end

    if record[:redis_db].empty?
      issues << [label, "missing REDIS_URL Redis DB"]
    elsif redis_dupes.key?(record[:redis_db].to_s)
      issues << [label, "Redis DB #{record[:redis_db]} reused by #{redis_dupes.fetch(record[:redis_db].to_s).map { |r| r[:task] }.join(", ")}"]
    elsif record[:redis_db].to_i < redis_db_min || record[:redis_db].to_i > redis_db_max
      issues << [label, "Redis DB #{record[:redis_db]} outside AGENT_REDIS_MIN_DB=#{redis_db_min} and AGENT_REDIS_MAX_DB=#{redis_db_max}"]
    end

    issues << [label, "LOCAL_EMAIL_CAPTURE is not enabled"] unless env_truthy?(record[:env]["LOCAL_EMAIL_CAPTURE"])
    %w[RESEND_API_KEY SES_SMTP_USERNAME SES_SMTP_PASSWORD].each do |key|
      issues << [label, "#{key} is present in stack env"] unless record[:env][key].to_s.empty?
    end

    issues << [label, "dirty worktree"] if record[:dirty]
    base = record[:base_ref]
    if !record[:equivalent_to_main] && !%w[0 ?].include?(record[:behind].to_s)
      issues << [label, "branch is #{record[:behind]} commit(s) behind #{base}; rebase before QA handoff"]
    end
    # Doctor must not call a held desk a "cleanup candidate" either — that is the same
    # misleading nomination the registry used to make, just in advisory prose. Same
    # predicate; quiet (a read-only report should not warn).
    #
    # The held text must not contain the phrase "cleanup candidate" AT ALL, even negated.
    # Consumers substring-match this prose (bin/qa-intake joins the issue list and tests
    # `include?`), so "not a cleanup candidate" READ AS a cleanup candidate and the
    # conductor's front door recommended tearing down a desk with a live builder at it.
    # qa-intake now reads the structured verdict instead, but the phrase stays out of the
    # negative branch regardless: a message that inverts its meaning under a substring test
    # is a landmine for the next consumer, and this one destroys desks.
    candidate, hold_reason = reclaim_verdict(record)
    if hold_reason
      issues << [label, "clean and landed on #{base}, but #{hold_reason}; withheld from reclaim"]
    elsif candidate
      message = record[:merged] ? "branch is merged to #{base} and clean; cleanup candidate" : "branch final diff matches #{base}; likely squash-merged cleanup candidate"
      issues << [label, message]
    end
    issues << [label, "port #{record[:port]} listens but /up is #{record[:code]}"] if !record[:port_pid].empty? && record[:code] != "200"
    issues << [label, "stale web pidfile #{record[:pidfile_state]}"] if record[:pidfile_state].start_with?("stale")
    issues << [label, "stale sidekiq pidfile #{record[:sidekiq_pidfile_state]}"] if record[:sidekiq_pidfile_state].start_with?("stale")
    issues << [label, "database #{record[:db_name]} missing"] if record[:db_exists] == false
  end

  # Reconcile against git itself: stack_records only sees `.worktrees/*` dirs the
  # launcher created, so orphan worktrees at non-standard paths are otherwise
  # invisible. Reconcile per managed repo so doctor flags every untracked one.
  selected_apps = app ? [app] : apps.values
  selected_apps.each { |config| issues.concat(orphan_worktree_issues(config)) }

  issues
end

def run_doctor(app = nil)
  issues = doctor_issues(app)
  if issues.empty?
    puts "doctor: no worktree lifecycle issues found"
    return
  end

  puts "doctor: #{issues.size} issue(s)"
  issues.each do |label, message|
    puts "  - #{label}: #{message}"
  end
end

def doctor_issues_by_label(app = nil)
  doctor_issues(app).each_with_object(Hash.new { |hash, key| hash[key] = [] }) do |(label, message), grouped|
    grouped[label] << message
  end
end

def agent_registry_dir
  File.join(PROJECTS_DIR, ".agents")
end

def snapshot_path
  File.expand_path(ENV.fetch("AGENT_WORKTREE_REGISTRY") { File.join(agent_registry_dir, "worktree-registry.json") })
end

def app_snapshot(app)
  {
    "slug" => app.fetch("slug"),
    "display_name" => app.fetch("display_name", app.fetch("slug")),
    "repo" => app.fetch("repo"),
    "primary_port" => app.fetch("primary_port"),
    "range_start" => app.fetch("range_start"),
    "range_end" => app.fetch("range_end"),
    "status" => app.fetch("status", "unknown"),
    "stack" => app.fetch("stack"),
    "sidekiq" => app.fetch("sidekiq")
  }
end

def stack_record_snapshot(record, issues_by_label)
  app = record.fetch(:app)
  label = "#{app.fetch("slug")}/#{record.fetch(:task)}"
  port = record.fetch(:port)
  has_port = !port.to_s.empty? && port != "?"
  # The registry is the CONTRACT the conductor reads, and it is a DESTROY path by proxy:
  # bin/qa-intake builds its "Cleanup Candidates" section straight off `cleanup_candidate`
  # and prints a `remove … --yes` line for each. So it must agree with the sweep — during a
  # board outage the sweep withholds a live builder's desk, and if this lane failed open the
  # front door would recommend tearing that very desk down, with no warning. It announces,
  # exactly like the sweep.
  #
  # `withheld_reason` carries the reason itself, not a boolean: a desk is withheld for a live
  # claim OR because we could not verify it (unreadable board), and a name that says only
  # "live claim" would misstate the outage case — the mistake this field is here to prevent.
  # nil when the desk is free. (A dirty worktree is already excluded by dirtiness, so it
  # carries no reason: the field answers "why is this not a candidate", not "is somebody
  # working here".)
  # ONE call, so the nomination and its explanation can never describe different
  # decisions: `cleanup_rationale` is the same `Cleared: …` evidence the dry run prints,
  # carried to the conductor's front door — which prints a `remove … --yes` line per
  # candidate and therefore owes the same account of why.
  evidence = reclaim_evidence(record, announce: true)
  candidate = evidence[:free]
  withheld_reason = evidence[:hold]

  {
    "label" => label,
    "app" => app.fetch("slug"),
    "task" => record.fetch(:task),
    "task_record_slug" => task_record_slug(record.fetch(:env)),
    "task_url" => task_url(record.fetch(:env)),
    "worktree" => record.fetch(:dir),
    "context_file" => context_path(record.fetch(:dir)),
    "context_exists" => File.exist?(context_path(record.fetch(:dir))),
    "env_exists" => record.fetch(:env_exists),
    "health" => stack_health(record),
    "local_url" => has_port ? "http://localhost:#{port}" : nil,
    "local_inbox_url" => has_port ? "http://localhost:#{port}/_studio/local_emails" : nil,
    "app_port" => has_port ? port.to_i : nil,
    "port_pid" => record.fetch(:port_pid).empty? ? nil : record.fetch(:port_pid).to_i,
    "up_code" => record.fetch(:code),
    "redis_db" => record.fetch(:redis_db).empty? ? nil : record.fetch(:redis_db).to_i,
    "database" => record.fetch(:db_name).empty? ? nil : record.fetch(:db_name),
    "database_exists" => record.fetch(:db_exists),
    "branch" => record.fetch(:branch),
    "head" => record.fetch(:head),
    "commit_subject" => record.fetch(:commit_subject),
    "dirty" => record.fetch(:dirty),
    # base_ref/base_branch are the resolved integration target (`origin/release`
    # else `origin/main`). The *_origin_main keys keep their historical names as
    # a stable registry contract but are now measured against base_ref — read
    # base_ref to know which base the merged/ahead/behind numbers reflect.
    "base_ref" => record.fetch(:base_ref),
    "base_branch" => record.fetch(:base_branch),
    "merged_to_origin_main" => record.fetch(:merged),
    "equivalent_to_origin_main" => record.fetch(:equivalent_to_main),
    "ahead_origin_main" => record.fetch(:ahead),
    "behind_origin_main" => record.fetch(:behind),
    "pidfile_state" => record.fetch(:pidfile_state),
    "sidekiq_pidfile_state" => record.fetch(:sidekiq_pidfile_state),
    "cleanup_candidate" => candidate,
    "withheld_reason" => withheld_reason,
    "cleanup_rationale" => evidence[:rationale],
    "compare_url" => github_compare_url(record),
    "issues" => issues_by_label[label]
  }
end

# Slots that can actually be handed out right now: the soft band intersected with
# the physically-existing Redis DBs, minus what's already allocated. Band-free
# alone (current - used) overstates availability whenever the band exceeds
# physical room (e.g. floor 20 on a stock databases=16 Redis).
def allocatable_free(current_capacity, physical_count, used_count)
  band_top = redis_db_min + current_capacity - 1
  usable_ceiling = [band_top, physical_count - 1].min
  usable = [usable_ceiling - redis_db_min + 1, 0].max
  [usable - used_count, 0].max
end

def capacity_snapshot
  current = load_current_capacity
  used = allocated_band_dbs.size
  physical_count = redis_physical_count
  {
    "floor" => REDIS_BAND_FLOOR,
    "step" => REDIS_BAND_STEP,
    "current" => current,
    "used" => used,
    "free" => allocatable_free(current, physical_count, used),
    "physical_max" => redis_physical_databases
  }
end

def snapshot_payload(app = nil)
  selected_apps = app ? [app] : apps.values
  records = stack_records(app)
  issues_by_label = doctor_issues_by_label(app)
  # Build the per-worktree snapshots ONCE and DERIVE the summary count from them, so the
  # registry field and the summary can never drift apart (they were two separate
  # `cleanup_ready?` calls before, which is how the summary kept counting desks the sweep
  # would refuse) — and so the board read behind the claim guard is spent only once.
  worktrees = records.map { |record| stack_record_snapshot(record, issues_by_label) }

  {
    "generated_at" => Time.now.utc.iso8601,
    "projects_dir" => PROJECTS_DIR,
    "hub_dir" => HUB_DIR,
    "redis_db_range" => {
      "min" => redis_db_min,
      "max" => redis_db_max
    },
    "capacity" => capacity_snapshot,
    "apps" => selected_apps.sort_by { |config| config.fetch("primary_port") }.map { |config| app_snapshot(config) },
    "summary" => {
      "worktrees" => records.size,
      "issues" => issues_by_label.values.sum(&:size),
      "cleanup_candidates" => worktrees.count { |worktree| worktree["cleanup_candidate"] },
      "withheld" => worktrees.count { |worktree| worktree["withheld_reason"] },
      "dirty_worktrees" => records.count { |record| record.fetch(:dirty) },
      "running_or_port_busy" => records.count { |record| !record.fetch(:port_pid).empty? },
      "behind_origin_main" => records.count { |record| !cleanup_ready?(record) && !%w[0 ?].include?(record.fetch(:behind).to_s) }
    },
    "worktrees" => worktrees
  }
end

def run_snapshot(app = nil, write: false)
  payload = snapshot_payload(app)
  json = JSON.pretty_generate(payload)

  unless write
    puts json
    return
  end

  # The registry is cross-repo state under the operator's real <projects>/.agents,
  # resolved by the same env-else-real-root fallback as every other store in this
  # family — so it gets the same fail-closed guard. Reads stay unguarded (bin/qa-intake
  # only READS this file; a read cannot pollute). Under TASK_USAGE_SANDBOX an
  # unpinned AGENT_WORKTREE_REGISTRY aborts rather than overwriting the live
  # registry that every conductor and QA session reads.
  path = TaskUsageSandbox.enforce!(snapshot_path, store: "worktree-registry")
  FileUtils.mkdir_p(File.dirname(path))
  File.write(path, "#{json}\n")
  puts "wrote #{payload.fetch("worktrees").size} worktree record(s) to #{path}"
rescue Errno::EACCES, Errno::EPERM => e
  # Report the LAUNDERED path, not a second raw `snapshot_path`: the containment scan
  # subtracts only the expression enforce! was handed, so re-naming the producer here
  # is a raw hold it (correctly) flags. `path` is bound before the write that can EACCES.
  abort "could not write worktree registry to #{path}: #{e.message}\nSet AGENT_WORKTREE_REGISTRY=/tmp/worktree-registry.json for a scratch write, or rerun with filesystem approval for the projects registry."
end

# The git-eligible worktrees split into [free, withheld], where withheld is
# [[record, reason], …]. Partitioning here (rather than filtering) means the ONE board
# read per git-eligible worktree is spent once AND the caller can NARRATE why a desk was
# held back — a silent skip on a destructive path is how "no candidates" ends up lying
# about a worktree that is clean, base-equivalent, and simply occupied.
def cleanup_partition(app = nil)
  free = []
  withheld = []
  records = stack_records(app)
  # One board read for the whole sweep, before the per-desk verdicts start asking.
  prefetch_task_records!(records)
  records.each do |record|
    ok, reason = reclaim_verdict(record, announce: true)
    if ok
      free << record
    elsif reason
      withheld << [record, reason]
    end
  end
  [free, withheld]
end

# Narrate every desk the guard held back, with the real reason (the builder's heartbeat
# age makes it exact). The file's convention is to explain a skip, and this is the only
# thing standing between a live desk and an irreversible teardown.
def report_withheld(withheld)
  withheld.each { |record, reason| puts "withheld #{worktree_label(record)}: #{reason}" }
end

# The truthful empty-set message. Two ways to lie here, and this helper exists to avoid both:
# "no clean merged or base-equivalent candidates" is false when a desk WAS clean and
# base-equivalent and simply withheld; and naming the REASON in the summary is false whenever
# the desks were withheld for different reasons (a live claim vs a board we could not read).
# The per-desk lines above already carry each reason exactly — the summary just counts.
def no_candidates_message(kind, withheld)
  return "#{kind}: no clean merged or base-equivalent worktree candidates" if withheld.empty?

  desks = withheld.size == 1 ? "desk" : "desks"
  "#{kind}: no free candidates — #{withheld.size} #{desks} withheld (see the reasons above)"
end

def ledger_path
  File.join(HUB_DIR, "docs", "agents", "maintenance", "delete-later.md")
end

# The ledger row's reason — the archive record a reader lands on months later, when the
# desk and its session are long gone.
#
# It carries the git facts AND the safety rationale, because the git facts alone are what
# made the 2026-08-14 nominations look sound: "clean and contained in origin/accepted" is
# true of a desk a release sweep is writing into right now. `cleared:` names the questions
# that were actually asked (see reclaim_clearances) — so a row filed by a sweep whose PR or
# review channel was blind is legible as such instead of reading like a considered decision.
def cleanup_reason(record)
  base = record[:base_ref] || "origin/main"
  operational = "health #{stack_health(record)}, Redis DB #{record[:redis_db]}, database #{cleanup_database_summary(record)}"
  containment =
    if record[:merged]
      "clean and HEAD #{record[:head]} is contained in #{base}"
    else
      "clean and its final diff against #{base} is empty, usually after a squash merge"
    end
  "Hidden worktree; branch `#{record[:branch]}` is #{containment}; #{operational} " \
    "#{cleanup_rationale_sentence(record)}"
end

# The rationale sentence for a ledger row. A desk that is NOT free still gets a row (the
# explicit `remove … --yes` override files one), and it must never borrow the language of a
# cleared candidate — so it states the hold instead.
def cleanup_rationale_sentence(record)
  evidence = reclaim_evidence(record)
  return "Cleared: #{evidence[:rationale]}." if evidence[:free]
  return "Removed against a hold — #{evidence[:hold]}." if evidence[:hold]

  "No automatic clearance recorded (not a sweep candidate)."
end

def cleanup_database_summary(record)
  db = record[:db_name].to_s
  return "unknown" if db.empty?
  return db if record[:db_exists].nil?

  "#{db}:#{record[:db_exists] ? "ok" : "missing"}"
end

def cleanup_safety_label(record)
  record[:merged] ? "merged" : "base-equivalent"
end

def cleanup_command(record)
  "bin/agent-worktree remove #{record[:app].fetch("slug")} #{record[:task]} --yes"
end

def print_cleanup_candidate(record)
  puts "  - #{record[:app].fetch("slug")}/#{record[:task]}"
  puts "    worktree: #{record[:dir]}"
  puts "    safe: #{cleanup_safety_label(record)} on #{record[:base_ref]} (clean, +#{record[:ahead]}/-#{record[:behind]})"
  # The `safe:` line above is a GIT fact. This is the safety argument — the questions each
  # guard channel asked and the answers it got. A dry run that cannot explain a nomination
  # is asking the operator to take 29 teardowns on faith.
  puts "    rationale: #{reclaim_evidence(record)[:rationale]}"
  puts "    branch: #{record[:branch]} @ #{record[:head]}"
  puts "    stack: #{stack_health(record)} /up=#{record[:code]} pid=#{record[:pidfile_state]} redis=#{record[:redis_db]} db=#{cleanup_database_summary(record)}"
  puts "    remove: #{cleanup_command(record)}"
end

def cleanup_row(record, status: "pending approval")
  path = record[:dir]
  command = cleanup_command(record)
  condition = status.start_with?("removed") ? "Removed with `#{command}` during approved lifecycle cleanup." : "Remove with `#{command}` after operator approval."
  "| `#{path}` | worktree | #{cleanup_reason(record)} | #{condition} | #{status} |"
end

def write_cleanup_ledger_record(record, status:)
  row = cleanup_row(record, status: status)
  path_cell = "| `#{record[:dir]}` |"
  existing = File.exist?(ledger_path) ? File.read(ledger_path) : ""

  if existing.include?(path_cell)
    updated = existing.lines.map { |line| line.include?(path_cell) ? "#{row}\n" : line }.join
    File.write(ledger_path, updated)
    puts "updated cleanup ledger: #{ledger_path}"
    return
  end

  File.open(ledger_path, "a") do |file|
    file.puts
    file.puts "<!-- agent-worktree remove #{Time.now.strftime("%Y-%m-%d")} -->"
    file.puts row
  end
  puts "wrote cleanup ledger: #{ledger_path}"
end

def run_cleanup(app = nil, write: false)
  candidates, withheld = cleanup_partition(app)
  report_withheld(withheld)
  if candidates.empty?
    puts no_candidates_message("cleanup", withheld)
    return
  end

  puts "cleanup candidates:"
  candidates.each { |record| print_cleanup_candidate(record) }

  unless write
    puts
    puts "dry run only. Re-run with --write to append candidates to #{ledger_path}."
    return
  end

  existing = File.exist?(ledger_path) ? File.read(ledger_path) : ""
  rows = candidates.map { |record| cleanup_row(record) }.reject { |row| existing.include?(row.split("`")[1].to_s) }
  if rows.empty?
    puts "cleanup: candidates already present in #{ledger_path}"
    return
  end

  File.open(ledger_path, "a") do |file|
    file.puts
    file.puts "<!-- agent-worktree cleanup #{Time.now.strftime("%Y-%m-%d")} -->"
    rows.each { |row| file.puts row }
  end
  puts "wrote #{rows.size} candidate(s) to #{ledger_path}"
  maybe_scale_in
end

def registered_worktree?(app, dir)
  ok, out, = capture_status("git", "-C", app.fetch("repo"), "worktree", "list", "--porcelain")
  ok && out.lines.any? { |line| line.chomp == "worktree #{dir}" }
end

def stop_pidfile(path, label)
  return unless File.exist?(path)

  pid = File.read(path).strip
  if pid_alive?(pid)
    Process.kill("TERM", pid.to_i)
    puts "stopped #{label} pid #{pid}"
  else
    puts "#{label} not running"
  end
  FileUtils.rm_f(path)
end

def stop_stack_for_removal(app, dir, record)
  # Skip only a desk that genuinely has nothing running: a discovered repo AND no
  # stack env on this desk. Both halves are load-bearing.
  #
  # The repo half: a stackless repo (a gem — no server, no port, no Redis DB) has
  # nothing to stop, and trying was not harmless. Every branch below reaches for a
  # key with app.fetch, so the generic path raised KeyError on "sidekiq" and took
  # the sweep down with it — inside with_worktree_lock, after earlier candidates
  # were already destroyed, leaving a half-finished run and a stale registry. This
  # is the branch that makes "stackless repos skip stack teardown" TRUE; before it,
  # STACKLESS_STACK was set at its construction site and never read, so the claim
  # lived only in a comment while the code did the opposite.
  #
  # The desk half: discovery is per-REPO but a stack is per-DESK. moms-app and
  # acquisition-studio are discovered too, and they are ordinary Rails apps — a
  # desk of theirs with a stack env has a real server to stop, and skipping it
  # would orphan the process and its Redis DB. So the repo classification alone
  # must never authorise a skip; the desk has to be quiet as well.
  return if app["stack"].to_s == STACKLESS_STACK && !record[:env_exists]

  if record[:env_exists]
    values = local_email_values.merge(parse_env(record[:env_path]))
    if app.fetch("stack") == "tm"
      ok = sh("bin/tm", "down", chdir: dir, env: command_env(app, values), allow_fail: true)
      warn "warning: bin/tm down failed; falling back to pidfile cleanup" unless ok
    else
      stop_generic_rails(dir, values["APP_PORT"])
    end
  else
    stop_generic_rails(dir, record[:port])
  end

  stop_pidfile(File.join(dir, "tmp", "pids", "tm-web.pid"), "tm web") if app.fetch("stack") == "tm"
  stop_pidfile(File.join(dir, "tmp", "pids", "tm-sidekiq.pid"), "tm sidekiq") if app.fetch("sidekiq")
end

def delete_local_branch_if_safe(app, branch)
  return if branch.to_s.empty? || branch == "?"
  # Never delete an integration branch: `release` is the persistent feature-PR
  # target, alongside main/master.
  return if %w[main master release].include?(branch)

  ok, out, = capture_status("git", "-C", app.fetch("repo"), "branch", "--list", branch)
  return unless ok && !out.strip.empty?

  sh("git", "-C", app.fetch("repo"), "branch", "-D", branch)
end

# The per-worktree teardown shared by `remove` and `cleanup --reclaim`:
# stop the stack, flush its Redis DB, record the ledger row, drop the git
# worktree, and delete the local branch. Callers handle band scale-in and the
# registry refresh once, after the (possibly batched) teardown.
def teardown_worktree(app, dir, record)
  stop_stack_for_removal(app, dir, record)
  flush_redis_db(record)
  write_cleanup_ledger_record(record, status: "removed #{Time.now.strftime("%Y-%m-%d")}")
  sh("git", "-C", app.fetch("repo"), "worktree", "remove", dir)
  delete_local_branch_if_safe(app, record[:branch])
end

# Scale-down-on-close normal flow: release every worktree whose branch is
# already represented on the resolved base (merged or squash-equivalent) and clean.
# Dry-run by default; --yes performs the teardown. Never touches dirty/unmerged
# worktrees or the primary checkout (cleanup_ready? + .worktrees-only source),
# and re-verifies each candidate under the lock before removing it.
def run_reclaim(app = nil, yes: false)
  # Refresh the SAME set the sweep will judge, discovered repos included. Skipping
  # them meant a discovered desk's git-eligibility was decided against whatever
  # origin happened to be on disk: conservative (a stale origin makes a merged
  # branch look unmerged, so a desk is withheld, not destroyed), but it made the
  # coverage claim read stronger than it was — the repo was enumerated and then
  # judged on stale evidence. A .git directory is required either way, which is
  # also what keeps a bare directory out of the loop.
  (app ? [app] : apps.values + discovered_worktree_configs).each do |config|
    next unless Dir.exist?(File.join(config.fetch("repo"), ".git"))
    sh("git", "-C", config.fetch("repo"), "fetch", "origin", "--quiet", allow_fail: true)
  end

  candidates, withheld = cleanup_partition(app)
  report_withheld(withheld)
  if candidates.empty?
    puts no_candidates_message("reclaim", withheld)
    return
  end

  unless yes
    puts "reclaim candidates:"
    candidates.each { |record| print_cleanup_candidate(record) }
    puts
    puts "dry run only. Re-run with --reclaim --yes to stop each stack, flush its Redis DB, remove the worktree, delete the local branch, scale the band in, and refresh the registry."
    return
  end

  freed = []
  with_worktree_lock do
    candidates.each do |record|
      dir = record[:dir]
      next unless registered_worktree?(record[:app], dir)

      # Re-read under the lock so a worktree that turned dirty/unmerged between
      # listing and teardown is skipped, not destroyed.
      fresh = stack_record(record[:app], dir)

      # Re-verify the claim here — the last line of defense before an irreversible
      # teardown. The candidate list (and its board reads) was computed ONCE above, but the
      # teardowns below run SERIALLY inside the lock (stack stop + Redis flush + worktree
      # remove + branch delete), so by the time we reach a later candidate the claim
      # evidence can be minutes stale. A builder who sat down and claimed a task mid-sweep
      # must not have their clean HEAD==base desk destroyed — and git state alone
      # (cleanup_ready?) provably cannot tell that desk from merged work. `fresh: true`
      # bypasses the per-slug memo: a cached answer here would reintroduce the very
      # staleness this read exists to close.
      #
      # ACCEPTED RESIDUAL (do not re-litigate): a TOCTOU window remains between this check
      # and teardown_worktree below — a builder could claim in that gap. Closing it needs a
      # lease on the WORKTREE itself, not the task. We accept it: the window is
      # milliseconds (not the minutes the stale candidate list allowed), and the blast
      # radius is a fresh desk, whose branch is by definition already on the base.
      ok, reason = reclaim_verdict(fresh, fresh: true, announce: true)
      if reason
        puts "skipping #{worktree_label(fresh)}: #{reason}"
        next
      end

      unless ok
        puts "skipping #{worktree_label(fresh)}: no longer a safe candidate"
        next
      end

      teardown_worktree(fresh[:app], dir, fresh)
      freed << { slug: "#{fresh[:app].fetch("slug")}/#{fresh[:task]}", redis_db: fresh[:redis_db] }
      puts "reclaimed #{fresh[:app].fetch("slug")}/#{fresh[:task]} (freed redis db #{fresh[:redis_db]})"
    end
    maybe_scale_in
  end
  run_snapshot(app, write: true)

  if freed.empty?
    puts "reclaim: nothing reclaimed (candidates changed under lock)"
  else
    dbs = freed.map { |entry| entry[:redis_db] }.compact.sort
    puts
    puts "reclaimed #{freed.size} worktree(s); freed redis DBs: #{dbs.join(", ")}"
    band = load_current_capacity
    puts "current band: #{band} slots (redis DBs #{redis_db_min}-#{redis_db_min + band - 1})"
  end
end

def run_remove(app, task, yes: false, force: false)
  dir = worktree_dir(app, task)
  abort "missing worktree: #{dir}" unless Dir.exist?(dir)

  sh("git", "-C", app.fetch("repo"), "fetch", "origin", "--quiet", allow_fail: true)
  record = stack_record(app, dir)
  base = record[:base_ref]

  # The content guard fires when the branch is not represented on base — which a
  # squash merge always breaks. `--force` overrides it ONLY when a merged PR is
  # merge-verified (see force_clears_content_blocker?); we only spend a gh call
  # when --force is set and the content guard is actually firing.
  content_blocked = !cleanup_ready?(record)
  merge_status, merged_pr =
    if force && content_blocked
      merged_pr_for_branch(record)
    else
      [:skip, nil]
    end
  force_clears = content_blocked &&
                 force_clears_content_blocker?(record, force: force, merged: merge_status == :merged)

  blockers = []
  blockers << "dirty worktree" if record[:dirty]
  if content_blocked && !force_clears
    blockers << "branch content is not represented on #{base}"
    # Explain why --force did not clear the content guard, but only when the
    # merge check itself failed (not when an unrelated guard like dirty is what
    # holds removal back — merge_status is then :merged or :skip).
    case merge_status
    when :unavailable
      blockers << "--force needs gh; not available (install gh or add a GitHub remote)"
    when :none
      blockers << "--force requires a merged PR; none found for #{record[:branch]}"
    end
  end
  blockers << "worktree is not registered with git" unless registered_worktree?(app, dir)

  if blockers.any?
    puts "refusing to remove #{app.fetch("slug")}/#{task}:"
    blockers.each { |blocker| puts "  - #{blocker}" }
    puts "inspect with: git -C #{dir.shellescape} diff --stat #{base}..HEAD"
    exit 1
  end

  puts "✓ #{record[:branch]} PR ##{merged_pr} merged — overriding content-not-on-#{record[:base_branch]} guard (--force)" if force_clears

  # `remove` is the explicit operator path — a named worktree plus `--yes` — so an occupied
  # desk warns rather than blocks: you may be deliberately evicting a desk whose session
  # died mid-lease, or clearing a fresh one you know is yours. The automatic paths (cleanup,
  # reclaim, and the registry the conductor reads) refuse it outright, so nothing ever
  # recommends this removal. Both channels warn, because both hold the automatic paths back.
  #
  # The second line is deliberately REASON-AGNOSTIC. It used to assert "a builder appears to
  # be on this desk", which is true of a live claim and false of every other hold this now
  # prints — a desk minutes old, a desk we could not date, a cert running. Asserting a
  # builder nobody confirmed is exactly the misattribution ClaimLease.corrupt_expiry? was
  # split out to prevent; the reason above already says what we actually found.
  if (reason = reclaim_hold(record, fresh: true, announce: true))
    warn "warning: #{worktree_label(record)}: #{reason}"
    warn "         the automatic guards do not treat this desk as free. `remove` is explicit, so this is not a block."
  end

  unless yes
    puts "remove candidate: #{app.fetch("slug")}/#{task}"
    puts "worktree: #{dir}"
    puts "branch:   #{record[:branch]}"
    puts "reason:   #{cleanup_reason(record)}"
    puts
    puts "dry run only. Re-run with --yes after approval to stop the stack, update the ledger, remove the worktree, delete the local branch, and refresh the registry."
    return
  end

  teardown_worktree(app, dir, record)
  maybe_scale_in
  run_snapshot(app, write: true)
end

def graduation_blockers(record)
  blockers = []
  branch = record[:branch]
  base = record[:base_ref] || "origin/main"

  blockers << "missing #{STACK_ENV}" unless record[:env_exists]
  blockers << "worktree has uncommitted changes; commit or intentionally revert them before QA handoff" if record[:dirty]
  blockers << "branch is #{branch.inspect}; feature work must not graduate from an integration branch (main/master/release)" if %w[main master release].include?(branch)
  blockers << "branch has no commits ahead of #{base}" if record[:ahead].to_s == "0"
  blockers << "branch is #{record[:behind]} commit(s) behind #{base}; rebase before PR" if !record[:equivalent_to_main] && !%w[0 ?].include?(record[:behind].to_s)
  blockers << "branch content is already represented on #{base}; use cleanup/remove instead of finish" if cleanup_ready?(record)

  blockers
end

def task_bound?(values)
  task_record_slug(values) && task_url(values)
end

# The task's board record as a Hash, or NIL when the read itself FAILED.
#
# nil vs {} is the load-bearing distinction: {} is a task we READ successfully that simply
# carries no claim (free), while nil is a board we could NOT read (500, timeout, auth,
# malformed). The destroy path treats those completely differently — see claim_hold — so
# collapsing them (as an earlier cut did) makes an unclaimed task look like an outage.
#
# MEMOIZED per task slug for the life of one command: a sweep otherwise spends several
# serial `bin/task show --json` subprocesses per candidate. `fresh: true` BYPASSES the memo
# — the under-lock re-verify passes it, because that read exists precisely to catch a claim
# taken AFTER selection, and a cached answer there would reintroduce the staleness it
# guards against.
def task_record_for_pr(record, fresh: false)
  override = ENV["AGENT_WORKTREE_TASK_JSON"].to_s.strip
  return parse_task_record(override) unless override.empty?

  slug = task_record_slug(record[:env] || {})
  return {} unless slug # unbound: nothing to read, which is NOT a failed read

  @task_record_cache ||= {}
  return @task_record_cache[slug] if !fresh && @task_record_cache.key?(slug)

  @task_record_cache[slug] = fetch_task_record(record, slug)
end

# Warm @task_record_cache for a WHOLE sweep in one board read.
#
# The per-desk read above is correct and stays; what it is not is scalable. A sweep
# resolves the build claim for every bound desk, so N desks meant N `bin/task show`
# spawns and N HTTPS round-trips, serialised. At 141 desks the full-suite sweep ran
# past ten minutes at 0% CPU and never emitted a candidate.
#
# Parallelising those reads is the wrong fix, and reclaim_evidence already says why:
# the board 500s under Postgres connection pressure during heavy parallel devops, and
# a mass reclaim is CORRELATED with that pressure. More concurrent reads make the
# outage this guard exists to survive more likely, not less.
#
# THE SAFETY RULE, and the reason this cannot weaken the guard: only a POSITIVELY READ
# record is ever cached. A slug the batch does not mention is left absent, so it falls
# through to fetch_task_record and gets today's exact classification — 404 means free,
# an unreadable board means withheld. Absence here is never evidence of anything, which
# matters because a list read can legitimately omit a task (archived, filtered, paged),
# and turning that omission into "no claim" would destroy a live builder's desk.
def prefetch_task_records!(records)
  return unless ENV["AGENT_WORKTREE_TASK_JSON"].to_s.strip.empty?

  @task_record_cache ||= {}
  bound = records.select { |record| task_record_slug(record[:env] || {}) }
  wanted = bound.map { |record| task_record_slug(record[:env] || {}) }.uniq - @task_record_cache.keys
  # One desk costs one read either way, and the batch would be the slower of the two.
  return if wanted.size <= 1

  batch = fetch_task_records_batch(bound.first)
  return unless batch # unreadable: say nothing, and let the per-desk reads classify

  batch.each { |slug, task_record| @task_record_cache[slug] = task_record if wanted.include?(slug) }
end

# THE FIELDS A CACHED RECORD MUST CARRY BEFORE IT MAY ANSWER A HOLD QUESTION.
#
# This list is the whole safety property, so it is worth being explicit about why
# it exists. The batch reads the API INDEX; every consumer of @task_record_cache
# was written against the API SHOW. Those are different serializers: show runs
# task_json, which MERGES derived fields, while the index deliberately keeps the
# raw column ("no per-row rebuild cost", tasks_controller.rb). A raw row is not
# malformed and it is not missing — it is a complete Task with these keys simply
# ABSENT, and absent reads as nil, and every one of these guards treats nil as a
# negative:
#
#   review_hold          reads review_in_progress   -> nil -> no reviewer -> free
#   desk_hold            reads *gate_in_flight      -> nil -> no gate     -> free
#   desk_hold            reads progress_seconds_ago -> nil -> no progress -> free
#
# So a desk whose builder is mid-cert (cert p99 is 94 minutes, LONGER than the
# 1h29m idle window — which is the entire reason the gate channel exists) reads as
# abandoned and is torn down. That is not a degraded sweep; it is the incident the
# guards were written to prevent, re-introduced by a cache that looked complete.
#
# Hence: a record missing ANY of these is NEVER cached. It falls through to the
# per-slug show read, which is slower and correct. Unknown holds; it never frees.
#
# This also makes the batch SELF-ACTIVATING across the deploy boundary. bin/task
# ships in worktrees and CI while the board deploys separately, so a board without
# `full=1` hands back raw rows — nothing qualifies, nothing caches, and the sweep
# behaves exactly as it did before the batch existed. When the board can serve the
# derived fields, records start qualifying and the speed-up turns itself on. No
# version check, no flag to forget, and no window where it is fast but blind.
BATCH_REQUIRED_FIELDS = %w[
  review_in_progress
  gate_in_flight
  holder_gate_in_flight
  progress_seconds_ago
  holder_liveness_seconds_ago
].freeze

def batch_record_complete?(task_record)
  return false unless task_record.is_a?(Hash)

  BATCH_REQUIRED_FIELDS.all? { |field| task_record.key?(field) }
end

# One `bin/task list --json` — the same board read `list` already performs, printing the
# full fetched records instead of three columns. Returns slug => record, or nil when the
# read failed at all (transport, auth, 5xx, malformed) so the caller stays silent.
#
# Only records that pass batch_record_complete? are returned. An incomplete row is
# dropped rather than downgraded, because there is no safe way to answer a hold
# question from a record that cannot carry the answer.
def fetch_task_records_batch(record)
  task_bin = File.join(record[:dir], "bin", "task")
  task_bin = File.join(HUB_DIR, "bin", "task") unless File.exist?(task_bin)
  return nil unless File.exist?(task_bin)

  ok, out, = capture_status(task_bin, "list", "--json", chdir: record[:dir],
                                                        env: command_env(record[:app], record[:env]),
                                                        timeout: TASK_READ_TIMEOUT)
  return nil unless ok

  parsed = JSON.parse(out.to_s)
  return nil unless parsed.is_a?(Array)

  parsed.each_with_object({}) do |task_record, acc|
    next unless batch_record_complete?(task_record)

    slug = task_record["slug"].to_s
    acc[slug] = task_record unless slug.empty?
  end
rescue JSON::ParserError
  nil
end

# bin/task's EXIT_TASK_NOT_FOUND — its exit-code CONTRACT for "the board positively
# answered: there is no such task". bin/task classifies at the source (HTTP 404 + the
# tasks API's own body) and exits this code ONLY for that answer; every failed read —
# transport, 5xx, router/route 404s, rejected flags — exits 1. Keep in lockstep with
# the constant in bin/task.
TASK_NOT_FOUND_EXIT = 4

def fetch_task_record(record, slug)
  task_bin = File.join(record[:dir], "bin", "task")
  task_bin = File.join(HUB_DIR, "bin", "task") unless File.exist?(task_bin)
  return nil unless File.exist?(task_bin) # cannot read the board at all

  ok, out, err, code = capture_status(task_bin, "show", slug, "--json", chdir: record[:dir],
                                                                        env: command_env(record[:app], record[:env]),
                                                                        timeout: TASK_READ_TIMEOUT)
  return parse_task_record(out) if ok

  # A genuine 404 is a SUCCESSFUL read with a definite answer — "there is no such task",
  # therefore no claim. By the same nil-vs-{} doctrine, that belongs in the FREE bucket, not
  # the unreadable one: a desk bound to a deleted or renamed slug would otherwise be withheld
  # FOREVER on the destroy path, and the "re-run once the board is reachable" message would
  # be a lie — the board answered. (`bin/task show` exits nonzero on a 404 but 0 for an
  # ARCHIVED task, so the happy path is untouched.)
  #
  # The EXIT CODE is the primary classifier: bin/task verifies the 404 + the API's own body
  # where the response is still structured, so its rendering can change freely without this
  # guard reclassifying an outage as "free". The stderr match below is only the FALLBACK for
  # an OLDER bin/task (exits 1 for every failure) — e.g. a worktree pinned to an older branch.
  return {} if code == TASK_NOT_FOUND_EXIT || task_not_found?(err)

  nil # a real failure: 500, timeout, auth, connection refused — we could not read it
end

# FALLBACK lane (older bin/task only): the board answered "no such task", read from the
# stderr rendering. A bin/task that speaks the exit-code contract never needs this — it
# exits TASK_NOT_FOUND_EXIT above — but an older one exits 1 for every failure, and this
# match is what keeps its genuine 404s classifying.
#
# BOTH halves are required, and the `&&` is load-bearing. bin/task renders every non-2xx as
# "<METHOD> <path> -> <code>: <body>", so matching the status alone would accept ANY 404:
# a Heroku ROUTER 404 (the board app renamed, deleted, or a misconfigured host) or a Rails
# ROUTE 404 (the API path moved, or a stale local board missing the route). Those are FAILED
# READS, not a successful "there is no such task" — and because they are board-WIDE, an `||`
# here would make EVERY bound desk read free at once and silently disarm the guard on the
# destroy path, tearing down live builder desks. That is the original incident through a new
# door, and it inverts this file's own doctrine (nil = failed read → withhold; {} = read
# fine, no claim → free).
#
# Only the API's genuine NOT_FOUND body means the task does not exist
# (app/controllers/api/v1/tasks_controller.rb renders exactly "task not found").
def task_not_found?(stderr)
  text = stderr.to_s
  text.match?(/->\s*404\b/) && text.match?(/task not found/i)
end

# A Hash on a good parse, nil when the payload is unusable — a malformed board response is
# an unreadable board, not an unclaimed task.
def parse_task_record(text)
  parsed = JSON.parse(text.to_s)
  parsed.is_a?(Hash) ? parsed : nil
rescue JSON::ParserError
  nil
end

def task_devops_for_pr(task_record)
  metadata = task_record.is_a?(Hash) ? task_record["metadata"] : nil
  devops = metadata.is_a?(Hash) ? metadata["devops"] : nil
  devops.is_a?(Hash) ? devops : {}
end

# The fixed-path ship/cert workspaces (bin/release's Release::GateWorkspace `_gate` +
# `_ship`), keyed by their worktree basename — which is `record[:task]` (stack_record sets
# task = File.basename(dir)). These are infrastructure, not task desks.
SHIP_WORKSPACE_TASKS = %w[_ship _gate].freeze

def ship_workspace_record?(record)
  SHIP_WORKSPACE_TASKS.include?(record[:task].to_s)
end

# The release-lifecycle claim roles, mirroring ReleaseConductorClaim::ROLES — BOTH of them,
# and that is the whole point of this constant.
#
# THE 2026-08-14 INCIDENT. This guard used to ask about `deployer` alone, on the reading
# that `_ship` is "the tree the DEPLOY works in". It is not: `bin/release prepare` — the
# ASSEMBLER, Avi's qa-release sweep — does its two tree-needing steps in the very same
# workspace (merge_forward_release_branches and bump_consumer_locks_for_qa, which runs
# `bundle lock` there to write each consumer's Gemfile.lock). So during a live prepare the
# deployer claim is legitimately free, this guard read :none, and a `cleanup --reclaim`
# listed BOTH repos' `_ship` desks as "safe: merged on origin/accepted (clean)" while a
# release sweep was building gem locks inside them. Asking one role of a two-role lifecycle
# is not a narrower guard; it is a guard that is absent exactly half the time.
#
# So the question this file asks is the one the operator's rule states: does ANY release
# hold ANY conductor claim right now? A new role added to ReleaseConductorClaim::ROLES must
# be added here too — the closed set is the contract, and a role missing from it silently
# re-opens this incident.
RELEASE_CLAIM_ROLES = %w[assembler deployer].freeze

# Is a release conductor working right now? A live ReleaseConductorClaim in EITHER role on
# ANY release means `_ship`/`_gate` are pinned by a running `bin/release prepare` (assembler)
# or `bin/release ship` (deployer). Returns :live / :none / :unknown. Read over the SAME
# board this file's task reads hit, via the release-claim CLI's `any-live` query (exit 0
# live / 3 none / else can't-tell), once per role. Overridable for tests with
# AGENT_WORKTREE_RELEASE_CLAIM=live|none|unknown (the older AGENT_WORKTREE_DEPLOYER_CLAIM is
# still honoured as an alias so pinned callers keep working). Memoized for the command.
#
# `fresh: true` BYPASSES that memo and re-reads the live board — EXACT parity with the
# build-claim guard's task_record_for_pr(fresh:), for the SAME reason: the under-lock
# re-verify (reclaim_verdict → claim_hold, fresh: true) exists precisely to catch a claim
# taken AFTER the candidate list was selected, so a cached :none there would reintroduce
# the very staleness it guards against — a release STARTING mid `cleanup --reclaim --yes`
# loop would read the memoized stale :none and reclaim its live `_ship`/`_gate`, breaking
# the in-flight release.
def release_claim_liveness(fresh: false)
  return @release_claim_liveness if !fresh && defined?(@release_claim_liveness)

  @release_claim_liveness = compute_release_claim_liveness
end

def compute_release_claim_liveness
  override = ENV["AGENT_WORKTREE_RELEASE_CLAIM"].to_s.strip
  override = ENV["AGENT_WORKTREE_DEPLOYER_CLAIM"].to_s.strip if override.empty?
  return %w[live none unknown].include?(override) ? override.to_sym : :unknown unless override.empty?

  cli = File.join(HUB_DIR, "bin", "lib", "release_claim_cli.rb")
  return :unknown unless File.exist?(cli) # no CLI to ask ⇒ can't tell (withhold on a destroy path)

  combine_claim_liveness(RELEASE_CLAIM_ROLES.map { |role| role_claim_liveness(cli, role) })
end

def role_claim_liveness(cli, role)
  _ok, _out, _err, code = capture_status(RbConfig.ruby, cli, "any-live", "--role", role,
                                         timeout: TASK_READ_TIMEOUT)
  case code
  when 0 then :live
  when 3 then :none
  else :unknown # 1/other/nil — could not read the board (fail-closed for a destroy path)
  end
end

# Fold the per-role answers into one, PURE so the precedence is unit-testable.
#
# The order is the safety order, not the arithmetic one: one live role is enough to hold
# (a prepare and a ship pin the same trees), and one unreadable role is enough to hold even
# when the other answered "none" — a partial read cannot rule out the role it failed on.
# :none only when every role positively answered "none". An empty set is :unknown: asking
# nothing is not the same as being told nothing is live.
def combine_claim_liveness(states)
  return :live if states.include?(:live)
  return :unknown if states.empty? || states.include?(:unknown)

  :none
end

# The withhold reason for a `_ship`/`_gate` workspace while a release may be live, or nil
# when no conductor is running (then they are ordinary reclaim candidates). Fail-CLOSED on
# can't-tell: a release MIGHT be running and reclaiming its workspace breaks a prepare or a
# production deploy, so an unreadable liveness read withholds — matching claim_hold's
# withhold-on-outage posture, and cheap here because bin/release recreates the workspaces on
# demand.
#
# `fresh:` threads straight through to release_claim_liveness so the under-lock re-verify
# (claim_hold fresh: true) re-reads the board here too — parity with the build-claim guard,
# which already bypasses its own memo on the re-verify. Without it, a cached :none from the
# selection pass would let a mid-loop release's `_ship`/`_gate` be reclaimed.
def ship_workspace_hold(record, fresh: false, announce: false)
  ws = record[:task]
  roles = RELEASE_CLAIM_ROLES.join("/")
  case release_claim_liveness(fresh: fresh)
  when :live
    warn "note: #{worktree_label(record)}: a release is live (#{roles} claim held) — withholding #{ws} from reclaim" if announce
    "a release is live (a #{roles} conductor claim is held) — withholding #{ws} from reclaim; " \
      "bin/release recreates it on demand"
  when :unknown
    warn "warning: #{worktree_label(record)}: could not check for a live release (#{roles} claim) — withholding #{ws}" if announce
    "could not check for a live release (#{roles} conductor claim), so cannot rule out an in-flight " \
      "prepare or ship; withholding #{ws} rather than reclaiming a workspace a live release may be " \
      "using (re-run once the board is reachable)"
  else # :none — the board answered: no release conductor is live
    nil
  end
end

# The reason this worktree is withheld from destruction, or nil when it is free to release.
#
# A desk is held when its bound task carries a live build-claim lease: a builder is on it,
# their status line renewing the claim under the ClaimLease TTL. That claim is the only
# signal that separates a builder who just sat down from finished work — a fresh worktree
# and a fast-forward-merged one are git-identical (clean, HEAD == base, 0-ahead), so
# cleanup_ready? alone cannot tell them apart.
#
# Withholds (returns a reason) in THREE cases, not one:
#   - a confirmed LIVE claim — a builder is at the desk;
#   - a CORRUPT claim — the lease is present but its expiry is unparseable, so liveness
#     cannot be verified. "We could not check" is not "a builder is here": it withholds
#     (an unverifiable desk must never read free on a destroy path), but names the hold
#     honestly as "expiry unverifiable", never as a live builder — corrupt_expiry? branches
#     it out before the live-builder message (which would also interpolate a nil age); and
#   - a bound task whose board record could NOT be read — we know the desk could be
#     claimed and failed to find out, so we cannot verify it is free. Board outages and
#     mass-reclaim are correlated (the board 500s under the same parallel-devops load that
#     spawns many worktrees), so failing open here reopens the incident precisely when
#     everyone believes it is covered.
# Fail-open (nil ⇒ reclaimable) survives only where it is FORCED or CORRECT: an unbound
# task (no slug, nothing to look up) and a lapsed claim (we checked; the builder is gone).
# Every branch that gives up on checking says so when `announce` is set — a guard that
# silently disables itself is worse than no guard.
def claim_hold(record, fresh: false, announce: false)
  # SHIP WORKSPACES FIRST. `_ship`/`_gate` are the ship/cert INFRASTRUCTURE workspaces
  # (fixed-path, detached checkouts bin/release recreates on demand), not task desks — so
  # they carry no bound task and would otherwise fail open through the UNBOUND branch
  # below. But a `bin/release ship` PINS `_ship` (and the cert pins `_gate`) for its whole
  # run, so reclaiming them MID-SHIP breaks a live production deploy. Before the
  # release-conductor-claims PR the shared `avi` shift excluded clean-up from a live ship;
  # ship now holds the per-release `deployer` claim instead, so we RE-ENFORCE that
  # exclusion here — withhold `_ship`/`_gate` whenever a live deployer claim exists (a ship
  # is in progress), or when we cannot tell (a destroy path withholds on an unreadable
  # board, per this file's doctrine). No live claim ⇒ fall through: they are then safe to
  # reclaim, exactly as the clean-up SOP says. `fresh:` threads through so the under-lock
  # re-verify re-reads the deployer claim (parity with the build-claim guard below) — a ship
  # STARTING mid `cleanup --reclaim` loop is caught, not read from a stale :none.
  if ship_workspace_record?(record)
    hold = ship_workspace_hold(record, fresh: fresh, announce: announce)
    return hold if hold
  end

  # nil-safe: a record without :env must not raise into the rescue below — that would
  # silently disable the guard on a destructive path, the exact failure the warnings exist
  # to prevent.
  slug = task_record_slug(record[:env] || {})

  # UNBOUND: no task, so there is no claim to look up. A forced fail-open on every path —
  # withholding every unidentifiable desk would wedge cleanup entirely. But this is the
  # original incident's own desk (TASK_RECORD_SLUG is written by bind-task, never by `new`),
  # so it never goes quietly.
  if slug.nil?
    # DISCOVERED REPOS: here "unbound" is PERMANENT, not incidental, so the fail-open below
    # would be a standing licence to destroy rather than a best-effort. TASK_RECORD_SLUG is
    # written by bind-task, which routes through app_for — registry-only, because new/up/plan
    # need a port range a discovered repo has no answer for. So such a desk can NEVER carry a
    # bound task.
    #
    # That matters because the other three channels are structurally dead for it too:
    # review_hold reads a task record there is none of, pr_hold_reason returns nil the moment
    # board_pr_url is nil (always), and desk_hold's progress / gate_in_flight /
    # awaiting_approval channels all read that same absent record. What survives is desk age
    # plus mtimes — and desk_activity prunes tmp, log, coverage, vendor and .bundle, which is
    # exactly and only what a gem builder writes while running a suite. Cert p99 is 94
    # minutes, LONGER than the 1h29m idle window, which is the very reason the gate channel
    # exists. Measured on the pre-split branch: `cleanup --reclaim studio-engine` nominated 4
    # desks on the rationale "no bound task, so no build claim to hold it; desk idle" —
    # mtime-only evidence on a destroy path, contradicting this file's own doctrine that a
    # desk we cannot prove abandoned is never destroyed.
    #
    # So: unbound + unverifiable = HOLD. Coverage buys VISIBILITY (doctor, list, snapshot, and
    # the dry run's withheld lines), not automated teardown. Recovering that later means
    # giving gem desks a REAL liveness signal — most promisingly by not pruning tmp/ for
    # stackless repos, where a write genuinely means a suite is running, unlike a Rails desk
    # whose server churns tmp/ constantly. That is a separate task.
    if discovered_app?(record[:app])
      if announce
        warn "note: #{worktree_label(record)} is a discovered repo's desk, which can never " \
             "carry a bound task; withholding rather than judging it on mtimes alone"
      end
      return "a discovered repo's desk can never carry a bound task (bind-task routes through " \
             "the registry), so the build, review and PR channels can never answer for it — and " \
             "desk mtimes alone cannot prove a gem desk abandoned, because a cert writes " \
             "nothing into its desk for longer than the idle window. Withholding rather than " \
             "nominating a desk we cannot verify; tear it down deliberately with " \
             "#{cleanup_command(record)}"
    end

    if announce
      warn "note: #{worktree_label(record)} has no bound task, so no build claim can be checked; " \
           "treating it as free"
    end
    return nil
  end

  task_record = task_record_for_pr(record, fresh: fresh)

  # BOUND but UNREADABLE (board 500, timeout, auth failure, malformed payload). The one case
  # where we KNOW the desk could be claimed and simply failed to find out — unlike unbound
  # (cannot identify it) or lapsed (checked; the builder is gone). On a path that DESTROYS
  # the desk, we refuse.
  #
  # Why this case and not the others: the board 500s under Postgres connection pressure
  # during heavy parallel devops — exactly when many worktrees exist and the reclaim sweep
  # gets run. Board outage and mass-reclaim are CORRELATED, not independent, so failing open
  # here re-opens the original incident precisely when everyone believes it is covered. And
  # the costs are asymmetric: withholding during an outage is a DEFERRAL (re-run once the
  # board is back); failing open is an IRREVERSIBLE teardown. Validate before irreversible
  # side effects.
  if task_record.nil?
    if announce
      warn "warning: #{worktree_label(record)} is bound to task #{slug}, but its board record could " \
           "not be read, so the build claim could not be checked. Withholding it."
    end
    return "bound to task #{slug}, but the board record could not be read, so the build claim " \
           "could not be checked; withholding rather than nominating a desk we cannot verify " \
           "(re-run once the board is reachable)"
  end

  # We READ the record. An empty devops here means "checked, and this task carries no
  # claim" — free, not an outage.
  claim = ClaimLease.from_devops(task_devops_for_pr(task_record))
  return nil unless ClaimLease.live?(claim)

  # CORRUPT: the claim's lease timestamp is PRESENT but unparseable, so liveness cannot be
  # verified. live? folds this into "possibly live" (rightly withholding, since an
  # unverifiable desk must never read free on a destroy path) — but the honest reason is NOT
  # "a builder is here": we never confirmed one, we only failed to check. Emitting the
  # live-builder line here both misattributes the hold AND interpolates a nil heartbeat_age
  # ("heartbeat  s ago"), because heartbeat_age has no parseable lease to derive from.
  # ClaimLease.corrupt_expiry? exists precisely to split this out.
  if ClaimLease.corrupt_expiry?(claim)
    return "claim expiry unverifiable (#{slug}) — the build claim's lease timestamp is present " \
           "but unparseable, so the builder's liveness cannot be checked; withholding rather " \
           "than nominating a desk we cannot verify — inspect task #{slug}"
  end

  age = ClaimLease.heartbeat_age(claim)
  "held by a live builder claim (#{slug}) — builder heartbeat #{age}s ago " \
    "(lease TTL #{ClaimLease::DEFAULT_TTL_SECONDS}s)"
rescue StandardError => e
  # Always log — a guard that disables itself in silence is worse than no guard, and on the
  # quiet (doctor/registry) lane an unexpected error would otherwise nominate a held desk
  # with no trace, which is the one contract this guard exists to protect.
  warn "warning: #{worktree_label(record)}: could not check the build claim (#{e.class}: #{e.message})"
  "the build claim could not be checked (#{e.class}); withholding rather than nominating a desk " \
    "we cannot verify"
end

# --- the DESK channel: is anybody working in this DIRECTORY? -------------------------
#
# claim_hold above asks the BOARD who holds the task. This asks the FILESYSTEM whether
# anyone is at the desk, and it exists because the board answer has a hole the git test
# cannot cover for it.
#
# THE HOLE, from the 2026-08-13 incident. A builder created and bound an industries
# desk and a `cleanup --reclaim` sweep removed it while he was working in it. Nothing
# malfunctioned: the desk was CLEAN (nobody had committed yet) and carried NOTHING
# ahead of its base, so `cleanup_ready?` passed — and a fresh desk is byte-identical to
# a fast-forward-merged one, so no amount of git can separate them. The claim channel
# did not save it either: a claim is only as live as its lease, and the desk that most
# needs protecting is precisely the one in the `new` → `bind-task` → `move building`
# window, or whose renewal has not landed yet, or (the half-allocated desks the Redis
# band ceiling produced the same day) whose bind FAILED outright and which therefore
# has no task to look up at all. Every one of those reads as a free, safest-looking
# candidate. The blast radius is another session's UNCOMMITTED work, which no gate,
# review, or CI will ever catch, because it never becomes a commit.
#
# WHY IT REUSES ClaimLease.abandoned? RATHER THAN INVENTING A SECOND RULE. The lease
# work already answered "is this holder working?" for a claim, with measured thresholds
# and a deliberately lopsided posture (every unknown protects). This is the SAME
# question asked about a directory, so it hands the same four channels to the same
# predicate. A second notion of liveness would drift from the first, and the two would
# disagree about a live worker on the day it mattered.
#
# WHY AN AGE THRESHOLD ALONE WOULD NOT DO. An hour-old desk mid-cert is live, and a
# cert writes NOTHING into its desk for up to the measured 94-minute p99 — which is
# exactly why the gate channel exists here as well as in the heartbeat.
#
# WHAT THIS COSTS, stated plainly because it is a real trade. Desks now linger up to
# DESK_IDLE_SECONDS (1h29m) after their work is done, holding a Redis band slot while
# they wait. Disk and a slot are recoverable; a destroyed desk is not. The operator's
# explicit `bin/agent-worktree remove <app> <task> --yes` still tears one down on
# demand (it warns and proceeds), so nothing is stuck — only nothing is AUTOMATIC.

# Seconds since the desk was created, or nil when we cannot tell. An I/O seam, so the
# unit tier can drive the decision without staging a real git worktree.
def desk_age_seconds(record)
  DeskActivity.age_seconds(record[:dir])
end

# Has any authored file under the desk been written inside the idle window?
# true / false / nil, where nil is "could not tell" and never frees a desk.
def desk_touched_recently?(record)
  dir = record[:dir].to_s
  return nil if dir.empty?

  DeskActivity.touched_since?(dir, Time.now - ClaimLease::DESK_IDLE_SECONDS)
end

# The reason this desk is withheld because somebody may be WORKING in it, or nil when
# every channel agrees it has been abandoned.
#
# `fresh:` is deliberately absent. The two desk facts (age, mtimes) are read live on
# every call, so they can never be stale; the two board facts come from
# task_record_for_pr's per-slug memo, which claim_hold — always called first, and with
# the caller's own `fresh:` — has just populated. So the under-lock re-verify gets a
# re-read board here too, without spending a second subprocess per candidate.
def desk_hold(record, announce: false)
  age = desk_age_seconds(record)
  if age.nil?
    warn "warning: #{worktree_label(record)}: the desk could not be dated (no worktree `.git` marker), so a desk created moments ago cannot be ruled out — withholding it" if announce
    return "the desk could not be dated (no worktree `.git` marker at #{record[:dir]}), so a desk " \
           "created moments ago cannot be ruled out; withholding rather than destroying a desk we " \
           "cannot date"
  end

  if ClaimLease.too_young_to_abandon?(age)
    return "the desk is only #{ClaimLease.humanize_age(age)} old, younger than the " \
           "#{ClaimLease.humanize_age(ClaimLease::DESK_IDLE_SECONDS)} idle window, so it cannot have " \
           "been idle long enough to call abandoned; a fresh desk is git-identical to a merged one, " \
           "which is how a live desk was destroyed on 2026-08-13"
  end

  touched = desk_touched_recently?(record)
  task_record = task_record_for_pr(record)
  channels = {
    desk_touched: touched,
    progress_age: ClaimLease.holder_scoped(task_record, "holder_liveness_seconds_ago", "progress_seconds_ago"),
    gate_in_flight: ClaimLease.holder_scoped(task_record, "holder_gate_in_flight", "gate_in_flight") ? true : false,
    awaiting_approval: task_devops_for_pr(task_record)["approval_status"].to_s.strip == "waiting"
  }
  return nil if ClaimLease.abandoned?(**channels)

  reason = desk_hold_reason(channels)
  warn "warning: #{worktree_label(record)}: #{reason}" if announce && touched.nil?
  reason
end

# Name the channel that spoke. The DECISION is ClaimLease.abandoned?'s and only its —
# this renders it — so the two can never disagree about WHETHER to hold, at most about
# how to explain it. The trailing fallback exists for exactly that residue: if some
# channel combination ever fits none of the branches below, the desk is still HELD,
# with an honest "could not be shown abandoned" rather than a confident lie.
def desk_hold_reason(channels)
  window = ClaimLease.humanize_age(ClaimLease::DESK_IDLE_SECONDS)
  touched = channels[:desk_touched]
  if touched.nil?
    return "the desk's files could not be read, so we could not tell whether anyone is working in " \
           "it; withholding rather than destroying a desk we could not check"
  end
  if touched
    return "the desk was written to within the last #{window} — somebody is working in it, and " \
           "their uncommitted work is exactly what a teardown destroys"
  end
  if channels[:gate_in_flight]
    cert_p99 = ClaimLease.humanize_age(ClaimLease::MEASURED_SILENCE_SECONDS[:cert_p99])
    return "a gate the holder may have opened is still running — a cert writes nothing into its " \
           "desk for up to #{cert_p99}, so a quiet desk mid-cert is a working one"
  end
  if channels[:awaiting_approval]
    return "the bound task is waiting on the operator's approval, so its agent is right to be " \
           "doing nothing and its desk is right to still be here"
  end
  progress = channels[:progress_age]
  if !progress.nil? && progress <= ClaimLease::DESK_IDLE_SECONDS
    return "the bound task landed a durable artifact #{ClaimLease.humanize_age(progress)} ago, " \
           "inside the #{window} idle window"
  end

  "the desk could not be shown abandoned, and a desk we cannot prove abandoned is never destroyed"
end

# --- the PR channel: has this branch's work actually LANDED? ---------------------------
#
# THE HOLE THIS CLOSES. Git-eligibility asks whether the branch's CONTENT is represented on
# the base. That is not the same question as whether the WORK is finished, and the two come
# apart in exactly the case that hurts: a branch whose diff against the base is empty — the
# base moved on, someone cherry-picked it, an equivalent change landed by another route —
# while its pull request is still OPEN and UNMERGED. To git the desk is spent litter; to the
# pipeline it is live work with a reviewer's name on it. The 2026-08-13 archive incident was
# this same confusion one lane over: the ONE task in a 14-task sweep with an open, green,
# unmerged PR was archived as a never-started idea, and archived is terminal.
#
# So the sweep asks GitHub, and an OPEN PR withholds the desk. `remove … --yes` still tears
# it down on demand; only the AUTOMATIC paths refuse.
#
# Returns [status, reference]:
#   [:open, "<n>"]      an OPEN pull request exists for this branch
#   [:none, nil]        gh answered: no open PR for this branch
#   [:unavailable, nil] gh is missing, there is no GitHub remote, or the call failed
#
# Memoized per branch: the rationale renderer re-reads this for a nominated desk, and a
# second network round-trip per candidate would be pure cost for an answer we already have.
# Overridable for tests with AGENT_WORKTREE_OPEN_PR=<number>|none|unavailable.
def open_pr_for_branch(record)
  branch = record[:branch].to_s
  @open_pr_cache ||= {}
  return @open_pr_cache[branch] if @open_pr_cache.key?(branch)

  @open_pr_cache[branch] = compute_open_pr_for_branch(record, branch)
end

def compute_open_pr_for_branch(record, branch)
  override = ENV["AGENT_WORKTREE_OPEN_PR"].to_s.strip
  unless override.empty?
    return [:none, nil] if override == "none"
    return [:unavailable, nil] if override == "unavailable"

    return [:open, override]
  end

  # No branch to ask about: a detached checkout (`_ship`/`_gate` live here) has no head
  # branch, so no PR can point at it. That is an ANSWER, not a failed read.
  return [:none, nil] if branch.empty? || branch == "?"
  return [:unavailable, nil] unless command_available?("gh")

  slug = github_repo_slug(record[:dir])
  return [:unavailable, nil] unless slug

  # `--state open` is GitHub's own answer to "is this PR still open". Do NOT reach for
  # `mergeable`/`mergeStateStatus`: those go stale and misreport on a merged PR — state is
  # the only field that tells the truth about a PR's lifecycle.
  ok, out, = capture_status("gh", "pr", "list", "--repo", slug, "--head", branch, "--state", "open",
                            "--json", "number")
  return [:unavailable, nil] unless ok

  prs =
    begin
      JSON.parse(out)
    rescue JSON::ParserError
      return [:unavailable, nil] # a body we cannot parse is a read we did not make
    end
  first = prs.is_a?(Array) ? prs.first : nil
  number = first.is_a?(Hash) ? first["number"] : nil
  number ? [:open, number.to_s] : [:none, nil]
end

# PURE: the withhold reason for the PR channel, or nil when the branch carries no open work.
# Split out from the I/O so the precedence is unit-testable — and the precedence IS the
# guard.
#
#   :open        → withhold. GitHub is authoritative and it says the PR is still open.
#   :none        → free. GitHub answered; there is nothing open on this branch.
#   :unavailable → we could not ask. Fall back to the BOARD, which is the other thing that
#                  knows: a task with a `pr_url` and no `merged` stamp is unlanded work, so
#                  withhold; a merged stamp (or no PR at all) is an independent reason to
#                  believe nothing is open, so free.
#
# Why the fallback is not simply fail-closed like the claim channel's: gh is optional
# tooling, not the board. Withholding every desk on a machine without `gh` would wedge the
# sweep permanently and silently — and a wedged sweep is how this file's guards get ripped
# out. Withholding only the desks the BOARD also calls unlanded keeps the refusal aimed at
# the dangerous case.
def pr_hold_reason(gh_status:, pr_ref:, branch:, board_pr_url:, board_merged:)
  case gh_status
  when :open
    "an OPEN, unmerged pull request (##{pr_ref}) is still on branch #{branch}; reclaiming " \
      "deletes that local branch and the desk behind live review work — merge, close, or " \
      "`remove … --yes` it deliberately"
  when :unavailable
    return nil if board_merged || board_pr_url.nil?

    "could not ask GitHub whether #{branch} has an open PR, and the bound task still carries " \
      "#{board_pr_url} with no merged stamp; withholding rather than reclaiming a desk whose " \
      "work may never have landed (re-run once `gh` can reach GitHub)"
  end
end

# The reason this desk is withheld because its PR is still open, or nil. Reads the board
# record claim_hold has already memoized, so the fallback costs nothing extra.
def pr_hold(record, announce: false)
  status, pr_ref = open_pr_for_branch(record)
  task_record = task_record_for_pr(record)
  reason = pr_hold_reason(
    gh_status: status,
    pr_ref: pr_ref,
    branch: record[:branch].to_s,
    board_pr_url: compact_value(task_devops_for_pr(task_record)["pr_url"]),
    board_merged: !compact_value(task_record.is_a?(Hash) ? task_record["merged"] : nil).nil?
  )
  warn "note: #{worktree_label(record)}: #{reason}" if reason && announce
  reason
end

# --- the REVIEW channel: is somebody else's session AT this desk right now? -------------
#
# The build claim answers "who is BUILDING here". Review is a second lane with its own
# claim (bin/task review-claim), and a reviewer works the builder's desk — reading it,
# running its suite, merging from it — without ever taking the build claim and often
# without WRITING a file, so the desk's mtimes stay quiet. On 2026-08-14 a sweep nominated
# exactly such a desk while another live session was reviewing it.
#
# The board already publishes the answer as a top-level `review_in_progress` column, so
# this costs nothing on top of the read claim_hold just made. Positive-signal only: TRUE
# withholds. An absent key means an older board that cannot answer, and the unreadable-board
# case is already withheld by claim_hold — this channel must not re-decide it.
def review_hold(record)
  task_record = task_record_for_pr(record)
  return nil unless task_record.is_a?(Hash) && task_record["review_in_progress"] == true

  slug = task_record_slug(record[:env] || {}) || record[:task]
  "a review is in progress on task #{slug} — a reviewer is working this desk (reading it, " \
    "running its suite, merging from it) without holding the BUILD claim, and a quiet desk " \
    "under review is a working one"
end

# --- the rationale: why a nominated desk was judged free --------------------------------
#
# "Every archive records its rationale." A dry run that prints `safe: merged on
# origin/accepted (clean)` states one git fact and implies a safety conclusion the git fact
# does not support — which is precisely how 29 desks, three of them load-bearing, read as
# safe. These render what EACH channel actually observed, so the operator reading the dry
# run (or the ledger row, months later) can see which questions were asked and what came
# back, and can spot the channel that was blind.
#
# Every clearance below reads memoized facts (the per-slug board record, the per-branch PR
# answer, local stat calls), so narrating costs no extra round-trips.
def reclaim_clearances(record)
  [
    git_clearance(record),
    pr_clearance(record),
    claim_clearance(record),
    review_clearance(record),
    desk_clearance(record)
  ].compact
end

def git_clearance(record)
  label = record[:merged] ? "merged into" : "diff-empty against"
  "#{label} #{record[:base_ref]}, tree clean"
end

def pr_clearance(record)
  status, = open_pr_for_branch(record)
  branch = record[:branch].to_s
  branch = "(detached — no branch)" if branch.empty? || branch == "?"
  case status
  when :none then "no open PR for #{branch} (GitHub asked)"
  else "no open PR recorded for #{branch} (GitHub unreachable; the bound task shows nothing unlanded)"
  end
end

def claim_clearance(record)
  return "no live release conductor claim (#{RELEASE_CLAIM_ROLES.join("/")})" if ship_workspace_record?(record)

  slug = task_record_slug(record[:env] || {})
  return "no bound task, so no build claim to hold it" unless slug

  "no live build claim on #{slug}"
end

def review_clearance(record)
  task_record = task_record_for_pr(record)
  return nil unless task_record.is_a?(Hash) && task_record.key?("review_in_progress")

  "no review in progress"
end

def desk_clearance(record)
  age = desk_age_seconds(record)
  born = age ? "born #{ClaimLease.humanize_age(age)} ago" : "age unknown"
  "desk idle (#{born}, no writes in the last #{ClaimLease.humanize_age(ClaimLease::DESK_IDLE_SECONDS)})"
end

# Every hold channel, in cost order, first reason wins. The ORDER is about spend, not
# priority — a desk held by any one of them is held, and each reason is true on its own.
# claim_hold runs first because it is the one that spends the board read the next three
# reuse; pr_hold runs last because it is the only one that may reach the network.
def reclaim_hold(record, fresh: false, announce: false)
  claim_hold(record, fresh: fresh, announce: announce) ||
    review_hold(record) ||
    desk_hold(record, announce: announce) ||
    pr_hold(record, announce: announce)
end

# The whole verdict in one shape: `{ free:, hold:, rationale: }`. reclaim_verdict renders
# its historical [ok, reason] pair from this, and the dry run/ledger read `rationale` from
# the SAME call — so an explanation can never describe a decision other than the one made.
def reclaim_evidence(record, fresh: false, announce: false)
  return { free: false, hold: nil, rationale: nil } unless cleanup_ready?(record)

  hold = reclaim_hold(record, fresh: fresh, announce: announce)
  { free: hold.nil?, hold: hold, rationale: hold ? nil : reclaim_clearances(record).join("; ") }
end

# THE one reclaim decision, in one place: may this worktree be destroyed, and if it is
# being withheld, why. Returns [reclaimable?, hold_reason]:
#
#   [true,  nil]      free — git-eligible and unheld
#   [false, "held …"] withheld — git-eligible, but a builder is live-claiming it
#   [false, nil]      not git-eligible (dirty / not landed on base) — never a candidate
#
# cleanup_partition, the under-lock re-verify, doctor AND the registry snapshot all route
# through here, so the conductor's front door (bin/qa-intake reads `cleanup_candidate`)
# cannot nominate a desk the sweep would refuse. Costs at most one board read, only for a
# git-eligible worktree, and memoized per slug across the command.
# There is no "advisory" lane. EVERY caller here answers one question — "is this desk a
# cleanup candidate?" — and that answer is consumed to DESTROY: the registry feeds
# bin/qa-intake, which prints a `remove … --yes` per candidate; the cleanup dry-run prints the
# same removal command; `cleanup --write` files the desk in the delete-later ledger; doctor
# labels it a candidate. An earlier cut split these into "destroy" and "advisory" and let the
# advisory ones fail open on an unreadable board — so during exactly the outage this guard
# exists to survive, the sweep withheld a live builder's desk while the conductor's front door
# recommended tearing it down. During an outage the truthful answer is "I cannot tell", and
# WITHHOLDING is that answer; nominating is the lie. So an unverifiable desk is withheld
# everywhere, and only `remove … --yes` (the explicit operator override) still proceeds — with
# a warning.
# FOUR CHANNELS, and no one of them subsumes another — each was added because the ones
# before it read a load-bearing desk as free:
#   claim_hold   asks the BOARD who is BUILDING here (and, for `_ship`/`_gate`, whether a
#                release conductor is live);
#   review_hold  asks the board whether a REVIEWER is on the task — a lane with its own
#                claim, whose sessions read far more than they write;
#   desk_hold    asks the FILESYSTEM whether anyone is at the desk — the only channel that
#                sees an unbound or not-yet-claimed desk;
#   pr_hold      asks GITHUB whether the branch's work actually landed — the only channel
#                that separates "content is on the base" from "the PR is finished".
# A claim can be live while the desk sits untouched mid-cert; a desk can be in active use
# while its task carries no readable claim at all (the desk the 08-13 sweep ate); and a
# desk can be quiet, unclaimed and diff-empty while its PR is still open (the 08-14 sweep).
# See reclaim_hold for why they run in this order.
def reclaim_verdict(record, fresh: false, announce: false)
  evidence = reclaim_evidence(record, fresh: fresh, announce: announce)
  [evidence[:free], evidence[:hold]]
end

def worktree_label(record)
  app = record[:app]
  slug = app.is_a?(Hash) ? app["slug"] : nil
  [slug, record[:task]].compact.join("/")
end

def list_from_task_devops(devops, key)
  raw = devops[key]
  case raw
  when Array
    raw.map(&:to_s).map(&:strip).reject(&:empty?)
  else
    raw.to_s.split(/\r?\n/).map(&:strip).reject(&:empty?)
  end
end

def bullet_lines(items, fallback)
  lines = Array(items).map(&:to_s).map(&:strip).reject(&:empty?)
  lines = [fallback] if lines.empty?
  lines.map { |line| "- #{line}" }.join("\n")
end

def pr_summary_lines(task_record)
  devops = task_devops_for_pr(task_record)
  acceptance = list_from_task_devops(devops, "acceptance")
  return acceptance if acceptance.any?

  title = task_record.is_a?(Hash) ? task_record["title"].to_s.strip : ""
  title.empty? ? [] : ["Implements #{title}."]
end

def pr_verification_lines(task_record)
  list_from_task_devops(task_devops_for_pr(task_record), "checks_run")
end

def pr_body(record)
  url = record[:port].empty? ? "not started" : "http://localhost:#{record[:port]}"
  email_url = record[:port].empty? ? "not started" : "http://localhost:#{record[:port]}/_studio/local_emails"
  task_record = task_record_slug(record[:env])
  task_record_url = task_url(record[:env])
  task_line = task_record_url ? "#{task_record_url} (`#{task_record}`)" : "`#{record[:task]}` worktree slug; bind the production task with `bin/agent-worktree bind-task #{record[:app].fetch("slug")} #{record[:task]} task-...` before PR review."
  task_metadata = task_record_for_pr(record)
  <<~BODY
    ## Summary
    #{bullet_lines(pr_summary_lines(task_metadata), "Scope is recorded on the linked task.")}

    ## Task
    - McRitchie Studio task: #{task_line}

    ## Local Proof
    - App: #{record[:app].fetch("display_name", record[:app].fetch("slug"))}
    - Worktree slug: #{record[:task]}
    - Worktree: `#{record[:dir]}`
    - Review URL: #{url}
    - Local inbox: #{email_url}
    - Stack health: #{stack_health(record)} (/up #{record[:code]})

    ## Verification
    #{bullet_lines(pr_verification_lines(task_metadata), "No checks_run recorded on the linked task yet.")}

    ## QA Notes
    - Carl: verify scope/spec match and merge safety.
    - Avi: run QA checks when risk warrants.
    - Do not delete this branch/worktree until the PR is merged or intentionally abandoned.
  BODY
end

# --- restore-primary: return a primary checkout to a clean canonical `main` ---
#
# The COMPLEMENT of Release::ShipSequence.preflight_offenders. The conductor's
# ship preflight DETECTS a primary that drifted off a clean `main` during a
# review/QA cycle (retro-rel-20260623 line 54: a primary left on a stray review
# branch, so the next session integrated/deployed from the wrong floor). This
# FIXES it: it REFUSES (loud, non-zero) any checkout with uncommitted or unpushed
# work — never discarding it — and otherwise checks out `main` and fast-forwards
# to origin. The safety call is the IO-free Release::RestorePrimary.decision; this
# owns only the git reads/writes.

# The current branch + dirty-file list + unpushed-commit list for a checkout (live
# git reads), the I/O seam — mirrors bin/release's repo_git_state. `unpushed` is
# commits reachable from HEAD but on NO remote branch — the work a restore would
# leave behind; empty for a checked-out remote branch whose commits are all
# pushed.
def restore_primary_state(repo)
  _b_ok, branch, = capture_status("git", "rev-parse", "--abbrev-ref", "HEAD", chdir: repo)
  _s_ok, status, = capture_status("git", "status", "--porcelain", chdir: repo)
  files = status.to_s.lines.map { |line| line[3..].to_s.strip }.reject(&:empty?)
  _u_ok, unpushed, = capture_status("git", "log", "--format=%h %s", "HEAD", "--not", "--remotes", chdir: repo)
  commits = unpushed.to_s.lines.map(&:strip).reject(&:empty?)
  { "branch" => branch.to_s.strip, "dirty_files" => files, "unpushed" => commits }
end

# Restore an app's PRIMARY checkout to a clean `main`. Returns true on a
# successful restore (or safe no-op), false on a refusal or a git failure — so the
# CLI exit code and the conductor can react. With dry: true it reports the plan
# and runs no mutating git.
def run_restore_primary(app, dry: false)
  repo  = app.fetch("repo")
  label = app.fetch("slug")

  # Fetch is best-effort: an offline/unreachable origin still lets us restore to
  # the last-known origin/main ref (mirrors run_finish/run_remove's allow_fail
  # fetch). A failure only means "may not be the very latest origin/main".
  unless sh("git", "fetch", "origin", "--quiet", chdir: repo, allow_fail: true)
    log_fail("#{label}: git fetch origin failed — restoring against the last-known origin/main")
  end

  plan = Release::RestorePrimary.decision(restore_primary_state(repo))

  if Release::RestorePrimary.refuse?(plan)
    warn(Release::RestorePrimary.refusal_message(label, plan, root: PROJECTS_DIR))
    return false
  end

  target     = plan["branch"]            # "main"
  remote_ref = "origin/#{target}"
  from       = plan["from_branch"]

  unless capture_status("git", "rev-parse", "--verify", "--quiet", remote_ref, chdir: repo).first
    log_fail("#{label}: #{remote_ref} not found — cannot restore #{repo}")
    return false
  end

  if dry
    note = plan["already_on_canonical"] ? "ff #{target} to #{remote_ref}" : "checkout #{target} (from #{from}) + ff to #{remote_ref}"
    log_ok("#{label}: would restore primary — #{note}")
    return true
  end

  # Switch to the canonical branch first (git DWIM creates the tracking branch
  # from origin/main when there is no local main). Skipped when already on it.
  unless plan["already_on_canonical"]
    return false unless sh("git", "checkout", target, chdir: repo, allow_fail: true)
  end

  # --ff-only can never create a merge commit; the unpushed guard above means main
  # has no local-only commits, so this fast-forward always applies cleanly. If main
  # itself somehow diverged, ff-only REFUSES rather than clobbering it — the same
  # never-discard-work guarantee, fail-closed.
  unless sh("git", "merge", "--ff-only", remote_ref, chdir: repo, allow_fail: true)
    log_fail("#{label}: fast-forward to #{remote_ref} failed (diverged?) — left on #{target}; resolve by hand")
    return false
  end

  if plan["already_on_canonical"]
    log_ok("#{label}: primary already on #{target}; fast-forwarded to #{remote_ref}")
  else
    log_ok("#{label}: restored primary #{from} → clean #{target} (ff to #{remote_ref})")
  end
  true
end

# The created PR's URL, parsed from `gh pr create` output (gh prints it on
# stdout, warnings and all). Nil when no PR URL is present.
def pr_url_from_output(output)
  output.to_s[%r{https://github\.com/\S+/pull/\d+}]
end

# The task CLI every HUB-side board call in this script goes through — the pr_url
# stamp below, and the best-effort mascot reads (record_mascot,
# record_mascot_field, run_bind_task).
#
# AGENT_WORKTREE_TASK_BIN IS THE SEAM, and it had to become a real one: this
# comment used to promise "a seam so tests can point the stamp at a fake
# executable" while the body hardcoded `File.join(__dir__, "task")` and the mascot
# readers each spelled that path again in backticks. There was nothing to point.
# The cost was not theoretical — bin/task defaults TASK_API_BASE to
# https://mcritchie.studio, so every one of those calls from a test child
# authenticated against the PRODUCTION board, silently (each read ends
# `2>/dev/null`). test/commands/agent_worktree_test.rb spawns this script ~11 ways
# and pinned neither the binary nor the base URL.
#
# NOT the same lookup as fetch_task_record, deliberately. That one reads the
# INSPECTED repo's own bin/task (falling back to the hub's), because a sweep asks
# each desk's checkout about its task; this is the HUB's CLI speaking for the
# script itself. Sealing them together would break the planted-fake tests that
# exercise the inspected-repo path.
def task_cli_path
  override = ENV["AGENT_WORKTREE_TASK_BIN"].to_s.strip
  override.empty? ? File.join(__dir__, "task") : override
end

# Best-effort devops.pr_url stamp on the bound task — the same `bin/task`
# board-write path the handoff already uses (bind-task, mascot reads). A board
# blip must NEVER fail the finish: failures warn with the manual command and
# return false.
def stamp_task_pr_url(record_slug, pr_url)
  slug = compact_value(record_slug)
  url = compact_value(pr_url)
  return false unless slug && url

  ok = system(task_cli_path, "update", slug, "--pr-url", url, out: File::NULL, err: File::NULL)
  warn "warning: could not stamp pr_url on task #{slug}; run: bin/task update #{slug} --pr-url #{url}" unless ok
  !!ok
end

# Open the graduation draft PR and stamp its URL onto the bound task record
# (devops.pr_url) in the same handoff. Regression guard: finish --pr used to
# open the PR without stamping, so bin/dor-check's CI gate reported NO_PR until
# someone ran `bin/task update --pr-url` by hand. Returns the PR URL (nil when
# it could not be parsed).
def open_draft_pr(record, dir, task)
  title = human_title(task)
  body = pr_body(record)
  # Feature PRs target the persistent `accepted` branch (falling back down the
  # ladder for repos without one) so review can merge them; never base on `main`.
  ok, out, err = capture_status("gh", "pr", "create", "--draft", "--base", record[:base_branch],
                                "--head", record[:branch], "--title", title, "--body", body, chdir: dir)
  $stderr.print err unless err.to_s.empty?
  print out
  abort "command failed in #{dir}: gh pr create" unless ok

  puts "opened PR base: #{record[:base_branch]}"
  pr_url = pr_url_from_output(out)
  slug = task_record_slug(record[:env])
  if pr_url.nil?
    warn "warning: could not parse the PR URL from gh output; stamp it manually: bin/task update #{slug || task} --pr-url <url>"
  elsif stamp_task_pr_url(slug, pr_url)
    puts "stamped:  pr_url -> #{pr_url}"
  end
  pr_url
end

def run_finish(app, task, push: false, pr: false)
  dir = worktree_dir(app, task)
  abort "missing worktree: #{dir}\nRun: bin/agent-worktree new #{app.fetch("slug")} #{task}" unless Dir.exist?(dir)
  load_stack_env(app, task)

  fetch_ok, _fetch_out, fetch_err = capture_status("git", "fetch", "origin", "--quiet", chdir: dir)
  record = stack_record(app, dir)
  warn "warning: git fetch failed; using local #{record[:base_ref]} state: #{fetch_err.lines.first.to_s.strip}" unless fetch_ok
  compare_url = github_compare_url(record)
  blockers = graduation_blockers(record)
  blockers << "worktree is not bound to a production McRitchie Studio task; run `bin/agent-worktree bind-task #{app.fetch("slug")} #{task} task-...` before `finish --push --pr`" if pr && !task_bound?(record[:env])

  puts "feature graduation packet"
  puts "app:      #{app.fetch("display_name", app.fetch("slug"))}"
  puts "task:     #{task_url(record[:env]) || "not bound"}"
  puts "worktree: #{task}"
  puts "branch:   #{record[:branch]}"
  puts "head:     #{record[:head]} #{record[:commit_subject]}"
  puts "path:     #{dir}"
  puts "url:      #{record[:port].empty? ? "not started" : "http://localhost:#{record[:port]}"}"
  puts "email:    #{record[:port].empty? ? "not started" : "http://localhost:#{record[:port]}/_studio/local_emails"}"
  puts "health:   #{stack_health(record)} (/up #{record[:code]})"
  puts "base:     #{record[:base_ref]} (PR base #{record[:base_branch]})"
  puts "git:      #{record[:dirty] ? "dirty" : "clean"} #{record[:merged] ? "merged" : "unmerged"} +#{record[:ahead]}/-#{record[:behind]}"
  puts "compare:  #{compare_url || "unknown remote"}"
  puts

  if blockers.any?
    puts "not ready for QA:"
    blockers.each { |blocker| puts "  - #{blocker}" }
    exit 1
  end

  if push || pr
    sh("git", "push", "-u", "origin", record[:branch], chdir: dir)
    puts "pushed:   #{record[:branch]}"
  end

  if pr
    abort "gh CLI is not available; pushed branch, then open #{compare_url}" unless command_available?("gh")

    open_draft_pr(record, dir, task)
  else
    puts "ready for QA. Open a draft PR with this body:"
    puts
    puts pr_body(record)
  end
end

# Flush a worktree's Redis DB on removal so a reused DB number cannot inherit
# stale keys from the previous stack.
def flush_redis_db(record)
  url = record[:env]["REDIS_URL"].to_s
  db = redis_db_from_url(url)
  return if db.empty?

  host = "localhost"
  port = "6379"
  if url =~ %r{redis://([^:/]+):(\d+)/}
    host = Regexp.last_match(1)
    port = Regexp.last_match(2)
  end

  if sh("redis-cli", "-h", host, "-p", port, "-n", db, "flushdb", allow_fail: true)
    log_ok("flushed redis DB #{db}")
  else
    log_fail("could not flush redis DB #{db} (redis-cli unavailable or redis down)")
  end
end

def run_scale_status
  current = load_current_capacity
  physical = redis_physical_databases
  physical_count = physical || redis_physical_count
  physical_top = physical_count - 1
  used = allocated_band_dbs.size
  free = allocatable_free(current, physical_count, used)
  band_top = redis_db_min + current - 1

  puts "redis worktree band"
  puts "  floor:        #{REDIS_BAND_FLOOR} slots"
  puts "  step:         #{REDIS_BAND_STEP} slots"
  puts "  current band: #{current} slots (redis DBs #{redis_db_min}-#{band_top})"
  puts "  used:         #{used}"
  puts "  free:         #{free}"
  if physical
    puts "  physical:     databases=#{physical} (max redis DB #{physical_top})"
  else
    puts "  physical:     unknown (redis-cli unavailable); assuming databases=#{physical_count}"
  end

  room = physical_band_capacity(physical_count)
  return unless current > room

  puts
  puts "  warning: band (#{current} slots) exceeds physical room (#{room} slots);"
  puts "           only redis DBs #{redis_db_min}-#{[band_top, physical_top].min} are usable."
  puts "           run: bin/agent-worktree scale --provision  to raise Redis databases to #{redis_physical_target}."
end

def run_scale_out
  with_worktree_lock do
    current = load_current_capacity
    room = physical_band_capacity
    if current >= room
      puts "at physical ceiling: #{current} slots (redis databases ceiling). Run scale --provision to raise it."
      return
    end

    target = [current + REDIS_BAND_STEP, room].min
    write_current_capacity(target)
    puts "scaled out: #{current} -> #{target} slots (band redis DBs #{redis_db_min}-#{redis_db_min + target - 1})"
  end
end

def run_scale_in
  with_worktree_lock do
    current = load_current_capacity
    if current <= REDIS_BAND_FLOOR
      puts "already at floor: #{current} slots"
      return
    end

    highest_used = allocated_band_dbs.max
    min_capacity_for_used = highest_used ? (highest_used - redis_db_min + 1) : 0
    target = [current - REDIS_BAND_STEP, REDIS_BAND_FLOOR].max
    if target < min_capacity_for_used
      puts "cannot shrink to #{target} slots; redis DB #{highest_used} is still allocated. Free higher worktrees first."
      return
    end

    write_current_capacity(target)
    puts "scaled in: #{current} -> #{target} slots (band redis DBs #{redis_db_min}-#{redis_db_min + target - 1})"
  end
end

def brew_prefix
  return ENV["HOMEBREW_PREFIX"] if ENV["HOMEBREW_PREFIX"].to_s != ""

  ok, out, = capture_status("brew", "--prefix")
  ok ? out.strip : "/opt/homebrew"
rescue StandardError
  "/opt/homebrew"
end

def redis_conf_path
  File.expand_path(ENV.fetch("AGENT_REDIS_CONF") { File.join(brew_prefix, "etc", "redis.conf") })
end

# Raise local Redis `databases` to the target and restart Redis exactly once.
# Idempotent; warns that it bounces every running stack; requires --yes to skip
# the interactive confirm. This is the ONE place that restarts Redis.
def run_scale_provision(yes: false)
  target = redis_physical_target
  current_physical = redis_physical_databases
  if current_physical && current_physical >= target
    puts "redis already exposes #{current_physical} databases (>= target #{target}); no restart needed."
    return
  end

  conf = redis_conf_path
  abort "redis config not found at #{conf}. Set AGENT_REDIS_CONF to the brew redis.conf path." unless File.exist?(conf)

  warn "WARNING: provisioning restarts local Redis once."
  warn "Every running worktree stack (and anything else on localhost:6379) will be bounced."
  warn "  config:  #{conf}"
  warn "  current: databases=#{current_physical || "unknown"}"
  warn "  target:  databases=#{target}"

  unless yes
    $stderr.print "Type yes to proceed: "
    answer = $stdin.gets.to_s.strip
    abort "aborted; Redis not changed" unless answer == "yes"
  end

  content = File.read(conf)
  updated =
    if content =~ /^\s*databases\s+\d+.*$/
      content.gsub(/^\s*databases\s+\d+.*$/, "databases #{target}")
    else
      "#{content.chomp}\ndatabases #{target}\n"
    end
  File.write(conf, updated)
  log_act("set databases #{target} in #{conf}")

  sh("brew", "services", "restart", "redis")
  puts "redis restarted with databases #{target}."
end

if $PROGRAM_NAME == __FILE__
  cmd = ARGV.shift || "help"

  case cmd
  when "apps"
    apps.values.sort_by { |app| app.fetch("primary_port") }.each do |app|
      puts "#{app.fetch("slug").ljust(18)} #{app.fetch("display_name", app.fetch("slug")).ljust(22)} primary #{app.fetch("primary_port")}  range #{app.fetch("range_start")}-#{app.fetch("range_end")}  #{app.fetch("status", "unknown")}"
    end
  when "list"
    # sweep_app_for: the INSPECTION commands must be able to name a discovered repo, or
    # "discovered repos appear in doctor and snapshot" is true only for the unscoped sweep
    # and `doctor studio-engine` still answers "unknown app" about desks it just listed.
    # The LIFECYCLE commands (plan/new/up/env/bind-task/test/status/finish/down) keep
    # app_for on purpose: they need a port range and a stack, which a discovered repo has
    # no answer for — that is the same constraint that makes such a desk permanently
    # unbound, and why the reclaim hold above exists.
    app = ARGV[0] ? sweep_app_for(ARGV[0]) : nil
    list_worktrees(app)
  when "plan"
    app_name, raw_task, type = ARGV
    usage unless app_name && raw_task
    app = app_for(app_name)
    task = clean_slug(raw_task)
    values = with_worktree_lock { stack_values(app, task) }
    print_plan(app, task, values)
  when "new"
    app_name, raw_task, maybe_type, *rest = ARGV
    usage unless app_name && raw_task
    app = app_for(app_name)
    task = clean_slug(raw_task)
    type = maybe_type&.start_with?("--") ? "feat" : (maybe_type || "feat")
    start = ARGV.include?("--start")
    dir = ensure_git_worktree(app, task, type)
    values, path = with_worktree_lock do
      existing = parse_env(stack_env_path(app, task))
      resolved = existing.empty? ? stack_values(app, task) : local_email_values.merge(existing)
      [resolved, write_stack_env(app, task, resolved)]
    end
    write_context_marker(app, task, values, dir)
    puts "worktree ready: #{dir}"
    puts "stack env:      #{path}"
    puts "context:        #{context_path(dir)}"
    # Provision the isolated TEST DB, write .env.test.local, and BUILD the bundled
    # assets now, so a fresh worktree runs `bin/rails test` — and bin/fast-check, whose
    # lanes pass explicit test paths — out of the box (no manual db:create / unsetting
    # DATABASE_URL / tailwindcss:build). app/assets/builds/ is gitignored, so a virgin
    # worktree has no CSS until something builds it; see prepare_test_env. allow_fail
    # keeps `new` resilient if Postgres/Rails are unavailable — `up`/`test` re-run
    # prepare_test_env idempotently.
    puts "test db:        #{db_name_from_url(test_database_url(values))} (provisioning)" if test_database_url(values)
    puts "assets:         app/assets/builds/tailwind.css (building)"
    unless prepare_test_env(dir, app, values)
      warn "agent-worktree: best-effort test-env prepare failed (Postgres/Rails down?) — " \
           "`up`/`test` will retry; run `bin/rails db:test:prepare test:prepare` in the worktree to see why."
    end
    puts
    print_plan(app, task, values, dir)
    if start
      puts
      ARGV.replace(["up", app.fetch("slug"), task])
      exec($PROGRAM_NAME, *ARGV)
    end
  when "env"
    app_name, raw_task = ARGV
    usage unless app_name && raw_task
    app = app_for(app_name)
    task = clean_slug(raw_task)
    puts File.read(stack_env_path(app, task))
  when "bind-task"
    app_name, raw_task, reference = ARGV
    usage unless app_name && raw_task && reference
    app = app_for(app_name)
    task = clean_slug(raw_task)
    run_bind_task(app, task, reference)
  when "up"
    app_name, raw_task = ARGV
    usage unless app_name && raw_task
    app = app_for(app_name)
    task = clean_slug(raw_task)
    dir = worktree_dir(app, task)
    abort "missing worktree: #{dir}\nRun: bin/agent-worktree new #{app.fetch("slug")} #{task}" unless Dir.exist?(dir)
    values = load_stack_env(app, task)
    app.fetch("stack") == "tm" ? start_tm(dir, app, values) : start_generic_rails(dir, app, values)
    code = wait_for_url(values.fetch("APP_PORT"))
    record = verify_started_stack!(app, dir, values.fetch("APP_PORT"))
    write_context_marker(app, task, values, dir, record: record)
    code = record[:code]
    puts
    puts "url: http://localhost:#{values.fetch("APP_PORT")} (/up #{code})"
    puts "email: http://localhost:#{values.fetch("APP_PORT")}/_studio/local_emails"
    puts "context: #{context_path(dir)}"
  when "test"
    app_name, raw_task, *rest = ARGV
    usage unless app_name && raw_task
    app = app_for(app_name)
    task = clean_slug(raw_task)
    dir = worktree_dir(app, task)
    abort "missing worktree: #{dir}\nRun: bin/agent-worktree new #{app.fetch("slug")} #{task}" unless Dir.exist?(dir)
    run_worktree_tests(dir, app, load_stack_env(app, task), rest)
  when "status"
    app_name, raw_task = ARGV
    usage unless app_name && raw_task
    app = app_for(app_name)
    task = clean_slug(raw_task)
    values = load_stack_env(app, task)
    code = wait_for_url(values.fetch("APP_PORT"))
    record = stack_record(app, worktree_dir(app, task))
    write_context_marker(app, task, values, worktree_dir(app, task), record: record)
    print_plan(app, task, values)
    puts "status: /up #{code}"
    puts "health: #{stack_health(record)}"
    merge = if record[:merged]
              "merged"
            elsif record[:equivalent_to_main]
              "base-eq"
            else
              "unmerged"
            end
    puts "git:    #{record[:branch]} #{record[:head]} #{record[:dirty] ? "dirty" : "clean"} #{merge} +#{record[:ahead]}/-#{record[:behind]}"
    puts "web:    port_pid=#{record[:port_pid].empty? ? "none" : record[:port_pid]} pidfile=#{record[:pidfile_state]}"
    puts "sidekiq: pidfile=#{record[:sidekiq_pidfile_state]}" if app.fetch("sidekiq")
    puts "db:     #{record[:db_name]}#{record[:db_exists].nil? ? "" : " #{record[:db_exists] ? "ok" : "missing"}"}"
    puts "redis:  db #{record[:redis_db]}"
    puts "context: #{context_path(worktree_dir(app, task))}"
  when "whereami"
    json = ARGV.delete("--json")
    shell = ARGV.delete("--shell")
    usage if json && shell
    case ARGV.length
    when 0
      run_whereami(json: !!json, shell: !!shell)
    when 2
      app = app_for(ARGV[0])
      task = clean_slug(ARGV[1])
      run_whereami(app, task, json: !!json, shell: !!shell)
    else
      usage
    end
  when "shell-hook"
    shell = ARGV.shift
    usage unless shell && ARGV.empty?
    run_shell_hook(shell)
  when "finish"
    push = ARGV.delete("--push")
    pr = ARGV.delete("--pr")
    app_name, raw_task = ARGV
    usage unless app_name && raw_task
    app = app_for(app_name)
    task = clean_slug(raw_task)
    run_finish(app, task, push: !!push, pr: !!pr)
  when "restore-primary"
    dry = ARGV.delete("--dry-run")
    app_name = ARGV[0]
    usage unless app_name
    app = app_for(app_name)
    exit(run_restore_primary(app, dry: !!dry) ? 0 : 1)
  when "doctor"
    # sweep_app_for: the INSPECTION commands must be able to name a discovered repo, or
    # "discovered repos appear in doctor and snapshot" is true only for the unscoped sweep
    # and `doctor studio-engine` still answers "unknown app" about desks it just listed.
    # The LIFECYCLE commands (plan/new/up/env/bind-task/test/status/finish/down) keep
    # app_for on purpose: they need a port range and a stack, which a discovered repo has
    # no answer for — that is the same constraint that makes such a desk permanently
    # unbound, and why the reclaim hold above exists.
    app = ARGV[0] ? sweep_app_for(ARGV[0]) : nil
    run_doctor(app)
  when "snapshot"
    write = ARGV.delete("--write")
    # sweep_app_for: the INSPECTION commands must be able to name a discovered repo, or
    # "discovered repos appear in doctor and snapshot" is true only for the unscoped sweep
    # and `doctor studio-engine` still answers "unknown app" about desks it just listed.
    # The LIFECYCLE commands (plan/new/up/env/bind-task/test/status/finish/down) keep
    # app_for on purpose: they need a port range and a stack, which a discovered repo has
    # no answer for — that is the same constraint that makes such a desk permanently
    # unbound, and why the reclaim hold above exists.
    app = ARGV[0] ? sweep_app_for(ARGV[0]) : nil
    run_snapshot(app, write: !!write)
  when "cleanup"
    reclaim = ARGV.delete("--reclaim")
    yes = ARGV.delete("--yes")
    write = ARGV.delete("--write")
    # sweep_app_for, not app_for: a discovered repo is sweepable even though it is
    # not allocatable.
    app = ARGV[0] ? sweep_app_for(ARGV[0]) : nil
    if reclaim
      run_reclaim(app, yes: !!yes)
    else
      run_cleanup(app, write: !!write)
    end
  when "remove"
    yes = ARGV.delete("--yes")
    force = ARGV.delete("--force")
    app_name, raw_task = ARGV
    usage unless app_name && raw_task
    # sweep_app_for, not app_for: the sweep PRINTS this exact command for every desk it
    # nominates or withholds, and writes it into the delete-later ledger as the archive
    # record. Resolving through the registry made every one of those lines dead for a
    # discovered repo ("unknown app: studio-engine") — an archive record naming a command
    # that cannot run. run_remove already handles a stackless desk: stop_stack_for_removal
    # branches on STACKLESS_STACK, so there is no stack to stop, no DB to drop, no Redis to
    # flush. This widens only the MANUAL, explicitly-named path; the automated sweep still
    # withholds every discovered desk (see claim_hold).
    app = sweep_app_for(app_name)
    task = clean_slug(raw_task)
    run_remove(app, task, yes: !!yes, force: !!force)
  when "down"
    app_name, raw_task = ARGV
    usage unless app_name && raw_task
    app = app_for(app_name)
    task = clean_slug(raw_task)
    dir = worktree_dir(app, task)
    values = load_stack_env(app, task)
    if app.fetch("stack") == "tm"
      sh("bin/tm", "down", chdir: dir, env: command_env(app, values))
    else
      stop_generic_rails(dir, values["APP_PORT"])
    end
  when "scale"
    if ARGV.include?("--provision")
      ARGV.delete("--provision")
      yes = ARGV.delete("--yes")
      run_scale_provision(yes: !!yes)
    else
      case ARGV[0] || "status"
      when "status" then run_scale_status
      when "out" then run_scale_out
      when "in" then run_scale_in
      else usage
      end
    end
  else
    usage
  end
end
