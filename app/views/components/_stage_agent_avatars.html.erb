<%# locals: (task:, agents:, variant: :stack, events: nil, mascot: nil) %>
<%#
  Per-stage agent attribution across a task's WHOLE journey — who designed, built,
  submitted, reviewed, assembled, and shipped it, with the time each stage took.

  Source: stage_agent_groups(task, agents) reads the task's TaskEvents +
  (review only) reviewers metadata (see StageAgentsHelper). Build-lane stages show
  the event's actor (the feature agent); reviewed shows the 2 senior reviewers;
  assembled shows Steffon; shipped shows Avi. A task renders nothing only when it
  has no stage events with a crew to attribute — the partial then renders nothing
  at all (no empty container).

  variant:
    :stack    (default) one near-fully stacked circle per lane (Build · Review ·
              Deploy) carrying that lane's duration or a live build counter — the
              board card glance; the lane row flex-wraps so a full crew never
              spills a narrow column.
    :detailed grouped per stage with a studio-engine badge, names, weights, and
              the full humanized duration — the task detail.

  Avatars are theme-token only (ring-surface separators, surface-alt pills) so
  dark/light parity holds; faces reuse the components/agent_avatar primitive
  (image with a deterministic initials fallback).
%>
<%# Build-lane crew wears the task's mascot. Callers (the board) pass it from a
    preloaded map to avoid an N+1; the detail page resolves it here. %>
<% mascot = local_assigns.fetch(:mascot) { Pokemon.find_by(slug: task.devops["mascot"].to_s.presence) } %>
<% entries = stage_agent_groups(task, agents, events: events, mascot: mascot) %>
<% if entries.any? %>
  <% if variant.to_sym == :detailed %>
    <div class="bg-surface-alt rounded-lg p-3" data-test="stage-agent-avatars">
      <p class="label-upper mb-3">Stage crew</p>
      <div class="space-y-3">
        <% entries.group_by(&:stage).each do |stage, stage_entries| %>
          <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
            <%= render "components/badge", text: Task::STAGE_LABELS.fetch(stage, stage.humanize), scheme: stage_scheme(stage) %>
            <% stage_entries.each do |entry| %>
              <div class="flex items-center gap-2">
                <div class="relative rounded-full ring-2 ring-surface">
                  <%= render "components/agent_avatar", agent: entry, size: "xs" %>
                </div>
                <div class="leading-tight">
                  <p class="text-sm text-heading flex items-center gap-1.5">
                    <%= entry.name %>
                    <% if entry.weight.present? %>
                      <span class="px-1 py-px rounded text-[9px] font-bold uppercase tracking-wide
                                   <%= entry.heavy? ? 'bg-primary/15 text-primary border border-primary/30' : 'bg-surface text-muted border border-subtle' %>"
                            title="<%= entry.heavy? ? 'Heavy (deep) review' : 'Light review' %>">
                        <%= entry.weight %>
                      </span>
                    <% end %>
                  </p>
                  <% if (spent = humanize_stage_duration(entry.seconds)) %>
                    <p class="text-xs text-muted"><%= spent %> in <%= entry.from_label %></p>
                  <% end %>
                </div>
              </div>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>
  <% else %>
    <%#
      Board-card glance (a dashboard, not the read view): collapse each lane to ONE
      stacked circle — Build · Review · Deploy — so a full crew fits a small card;
      the row also flex-wraps as a final guard against spilling a narrow column.
      Each cluster stacks its faces (priority on top) and shows the one duration that
      matters for the lane (build total / longer review / QA→prod). The build lane
      ticks a LIVE counter while the task is still being built. The detail page
      (:detailed) still shows every stage per-usual.
    %>
    <% by_lane = crew_clusters(task, entries).index_by(&:lane) %>
    <%# Four fixed 25% columns so the crew is always one solid row (build · review ·
        assembled · shipped), each centered; an absent stage leaves its column blank. %>
    <div class="grid grid-cols-4 gap-1 mt-2 mb-1" data-test="stage-agent-avatars" title="Stage crew">
      <% %i[build review assembled shipped].each do |lane| %>
        <div class="flex justify-center">
          <% if (cluster = by_lane[lane]) %>
            <div class="relative" data-test="crew-cluster" data-lane="<%= cluster.lane %>">
              <%# Tight stack — virtually one circle; priority last = on top. The whole
                  stack scales up on card hover (transform only, so siblings don't shift). %>
              <div class="flex items-center -space-x-9 transition-transform duration-150 group-hover:scale-110">
                <% cluster.stacked.each do |entry| %>
                  <div class="rounded-full ring-2 ring-surface"
                       title="<%= [entry.name, (entry.weight.presence && "(#{entry.weight})")].compact.join(' ') %>">
                    <%= render "components/agent_avatar", agent: entry, size: "sm" %>
                  </div>
                <% end %>
              </div>
              <% if cluster.live_since %>
                <%# Live elapsed counter (s → m → h → d → w), ticking each second. %>
                <span class="absolute -bottom-1 -right-1 px-1 py-px rounded-full text-[9px] font-semibold leading-none
                             bg-primary/20 text-primary border border-primary/40 ring-1 ring-surface tabular-nums"
                      data-test="crew-live"
                      x-data="{ start: <%= cluster.live_since.to_i %>, now: Math.floor(Date.now() / 1000) }"
                      x-init="setInterval(() => now = Math.floor(Date.now() / 1000), 1000)"
                      x-text="window.elapsedLabel(now - start)">…</span>
              <% elsif cluster.seconds.to_i.positive? %>
                <span class="absolute -bottom-1 -right-1 px-1 py-px rounded-full text-[9px] font-semibold leading-none
                             bg-surface-alt text-secondary border border-subtle ring-1 ring-surface tabular-nums"
                      data-test="crew-duration"><%= compact_stage_duration(cluster.seconds) %></span>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
<% end %>
