<%# One clip of an alt video (alt video x source chunk): the source chunk's preview, or once the clip has a primary version the two side by side with Play both (alt_videos/_clip_compare), each showing its first frame; its window; whom the alt video's swaps replace here, by letter (Person 2 is B in every clip); the hand-off (a one-zip download of all of it, the 25 s source clip, the lettered reference frames, the swapped people's character sheets numbered as the prompt numbers them, the prompt built from the alt video's own swaps); a drop zone for the generated MP4; every version, one primary; Draft to TikTok with its attempts (alt_videos/_clip_tiktok); and the regenerate flag. The header carries the clip's slug with a copy control, the name the tiktok-draft SOP takes. %>
<% url = chunk && urls[chunk.object_key] %>
<% versions = clip.versions.to_a %>
<% primary = clip.primary_version %>
<% target = chunk&.swap_target(swaps) %>
<% swap = target && swaps[target.ordinal] %>
<% swapped = chunk ? chunk.swapped_present(swaps) : [] %>
<% lettered = chunk ? MusicVideos::ClipPrompts.lettered(chunk, swaps: swaps, numbers: numbers) : [] %>
<% frames = chunk ? chunk.reference_frame_list : [] %>
<% prompt = chunk && MusicVideos::ClipPrompts.for(chunk, swaps: swaps, numbers: numbers) %>
<% version_url = primary && urls[primary.object_key] %>
<% compare = url.present? && version_url.present? %>
<article id="clip-<%= clip.chunk_ordinal %>" class="card overflow-hidden scroll-mt-24 min-w-0"
         x-data="clipRow()" data-src="<%= url %>"
         data-test="alt-clip" data-ordinal="<%= clip.chunk_ordinal %>"
         data-primary="<%= primary&.number %>" data-flagged="<%= clip.regenerate_requested? %>" data-compare="<%= compare %>">
  <div class="grid grid-cols-1 <%= compare ? "" : "lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]" %>">
    <% if compare %>
      <%= render "alt_videos/clip_compare", clip: clip, chunk: chunk, primary: primary, url: url, version_url: version_url %>
    <% else %>
    <div class="relative bg-inset aspect-video" data-test="clip-preview" data-key="<%= chunk&.object_key %>">
      <% if url %>
        <div x-data="clipPair()" class="absolute inset-0" data-test="clip-solo">
          <video x-ref="original" src="<%= first_frame_src(url) %>" controls playsinline preload="metadata"
                 class="absolute inset-0 w-full h-full bg-black" data-test="clip-player"
                 @error="failed.original = true"></video>
          <button type="button" x-show="!started" @click="playOriginal()"
                  class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 flex items-center gap-2 rounded-full px-4 py-2 bg-surface/90 text-heading shadow hover:text-primary"
                  data-test="clip-preview-button">
            <svg class="w-6 h-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
            <span class="text-sm font-semibold whitespace-nowrap">Preview the source chunk</span>
          </button>
          <p x-show="failed.original" x-cloak class="absolute bottom-0 inset-x-0 p-2 text-xs text-center bg-surface/90 text-warning-ink"
             data-test="clip-load-failed">The source chunk did not load: <%= chunk.object_key.split("/").last %></p>
        </div>
      <% elsif chunk %>
        <p class="absolute inset-0 flex items-center justify-center p-3 text-xs text-muted text-center break-all"
           data-test="clip-unreachable">Source chunk not reachable: <%= chunk.object_key.split("/").last %></p>
      <% else %>
        <p class="absolute inset-0 flex items-center justify-center p-3 text-xs text-warning-ink text-center"
           data-test="clip-no-chunk">The source is no longer cut at this window: it was re-tiled after this alt video was built.</p>
      <% end %>
    </div>
    <% end %>

    <div class="p-4 flex flex-col gap-3 min-w-0">
      <header class="min-w-0">
        <h3 class="text-lg font-bold text-heading"><%= clip.name %></h3>
        <div x-data="copyField()" class="flex flex-wrap items-center gap-x-2 gap-y-1 min-w-0" data-test="clip-slug-row">
          <code x-ref="text" class="text-xs font-mono text-muted break-all select-all min-w-0" data-test="clip-slug"><%= clip.slug %></code>
          <button type="button" @click="copy()" class="text-xs text-primary hover:underline shrink-0" data-test="clip-slug-copy"
                  title="Copy this clip's slug, the name the tiktok-draft SOP takes">
            <span x-text="copied ? 'Copied' : 'Copy slug'">Copy slug</span>
          </button>
          <span x-show="manual" x-cloak class="text-xs text-warning-ink">Selected: copy it from here.</span>
        </div>
        <p class="text-sm text-body font-mono tabular-nums" data-test="clip-window">
          <%= video_timecode(clip.start_ms) %>–<%= video_timecode(clip.end_ms) %>
          <span class="text-muted">· <%= format("%.1f", clip.duration_ms / 1000.0) %> s</span>
        </p>
      </header>

      <div class="flex flex-wrap gap-1.5">
        <% if chunk %>
          <span class="badge text-xs bg-surface-alt text-body border-subtle" data-test="clip-shape"><%= clip_shape_label(chunk.cast_shape) %></span>
        <% end %>
        <% if clip.chunk_ordinal > 1 && overlap_ms.positive? %>
          <span class="badge text-xs bg-primary/10 text-primary border-primary/20" data-test="clip-overlap">First <%= clip_seconds(overlap_ms) %> s repeat clip <%= clip.chunk_ordinal - 1 %></span>
        <% end %>
        <% if primary %>
          <span class="badge text-xs bg-success/10 text-success-ink border-success/40" data-test="clip-state"><%= primary.name %> primary</span>
        <% else %>
          <span class="badge text-xs bg-surface-alt text-muted border-subtle" data-test="clip-state">No version yet</span>
        <% end %>
        <% if clip.regenerate_requested? %>
          <span class="badge text-xs bg-warning/10 text-warning-ink border-warning/40" data-test="clip-flag">Regenerate requested</span>
        <% end %>
      </div>

      <% if lettered.any? %>
        <div class="text-sm text-body min-w-0" data-test="clip-swaps" data-count="<%= lettered.size %>">
          <p class="label-upper mb-1">Swapped here</p>
          <ul class="flex flex-col gap-1">
            <% lettered.each do |row| %>
              <li class="min-w-0 break-words" data-test="clip-swap-row" data-letter="<%= row.letter %>" data-lead="<%= row.lead %>">
                <span class="font-semibold text-heading">Person <%= row.letter %></span>
                <span class="badge text-3xs <%= row.lead ? 'bg-primary/10 text-primary border-primary/20' : 'bg-surface-alt text-muted border-subtle' %>"><%= row.lead ? "lead" : "background" %></span>
                <span class="text-muted">→</span>
                <span class="font-semibold text-heading"><%= row.player %></span><% if row.look %><span class="text-muted">, <%= row.look %></span><% end %>
                <span class="text-muted">· sheet <%= row.sheet %></span>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
      <p class="text-sm text-body min-w-0" data-test="clip-target">
        <span class="label-upper mr-1">Target</span>
        <% if target %>
          <%= target.name %><% if target.artist %> · <span class="font-semibold text-heading"><%= target.artist.name %></span><% end %>
          <span class="text-muted">(<%= target.label %>)</span>
          <% if swap %>
            <span class="block mt-1 break-words" data-test="clip-swap">
              <span class="label-upper mr-1">Replaced by</span>
              <span class="font-semibold text-heading"><%= swap.label %></span>
            </span>
          <% else %>
            <span class="block mt-1 text-muted" data-test="clip-swap-none">This alt video keeps <%= target.name %> as filmed, so the prompt leaves {athlete} blank.</span>
          <% end %>
        <% elsif chunk %>
          <span class="text-muted">Nobody in this window is labelled or swapped.</span>
        <% end %>
      </p>
      <% end %>

      <% if prompt %>
        <div class="min-w-0">
          <div class="flex items-center justify-between gap-2 mb-1.5">
            <p class="label-upper">Swap prompt</p>
            <button type="button" @click="copy()" class="btn btn-outline btn-sm" data-test="clip-copy">
              <span x-text="copied ? 'Copied' : 'Copy prompt'">Copy prompt</span>
            </button>
          </div>
          <p x-ref="prompt" class="text-sm text-body bg-surface-alt border border-subtle rounded-lg p-3 whitespace-pre-wrap break-words select-all"
             data-test="clip-prompt"><%= prompt %></p>
          <p x-show="manual" x-cloak class="text-xs text-warning-ink mt-1" data-test="clip-copy-manual">Copy is blocked here: the prompt is selected, so copy it from there.</p>
        </div>
      <% end %>

      <% if chunk %>
        <div class="min-w-0" data-test="clip-frames" data-count="<%= frames.size %>">
          <p class="label-upper mb-1.5">Lettered frames <span class="normal-case tracking-normal">· the people marked A, B, C… as the prompt names them; add them to Higgsfield as references</span></p>
          <% if frames.any? %>
            <div class="grid grid-cols-2 sm:grid-cols-3 gap-2">
              <% frames.each_with_index do |frame, i| %>
                <% frame_url = urls[frame["object_key"]] %>
                <figure class="min-w-0" data-test="clip-frame" data-key="<%= frame["object_key"] %>" data-letters="<%= frame["letters"].join(",") %>">
                  <% if frame_url %>
                    <%= link_to frame_url, target: "_blank", rel: "noopener", class: "block" do %>
                      <img src="<%= frame_url %>" alt="Frame <%= i + 1 %> at <%= video_timecode(frame["t_ms"]) %>, people <%= frame["letters"].join(", ") %>"
                           loading="lazy" class="w-full aspect-video object-cover rounded-md border border-subtle bg-inset">
                    <% end %>
                  <% else %>
                    <div class="w-full aspect-video rounded-md border border-subtle bg-inset flex items-center justify-center text-3xs text-muted p-1 text-center">Frame not reachable</div>
                  <% end %>
                  <figcaption class="flex flex-wrap items-center justify-between gap-x-2 mt-1 text-xs min-w-0">
                    <span class="text-muted font-mono tabular-nums"><%= video_timecode(frame["t_ms"]) %> · <%= frame["letters"].join(" ") %></span>
                    <% if (frame_download = downloads[frame["object_key"]]) %>
                      <%= link_to "Download", frame_download, download: frame["object_key"].split("/").last,
                                  class: "text-primary hover:underline shrink-0", data: { test: "clip-frame-download" } %>
                    <% end %>
                  </figcaption>
                </figure>
              <% end %>
            </div>
          <% else %>
            <p class="text-sm text-muted" data-test="clip-frames-none">No lettered frames yet: run <code class="text-xs">bin/clip-references <%= video.slug %></code> on the Mac.</p>
          <% end %>
        </div>
      <% end %>

      <div class="min-w-0" data-test="clip-handoff">
        <div class="flex flex-wrap items-center justify-between gap-2 mb-1.5 min-w-0">
          <p class="label-upper min-w-0">Hand-off <span class="normal-case tracking-normal">· the source clip, the swapped people's sheets in the prompt's order, and the prompt</span></p>
          <% if chunk %>
            <%= link_to music_video_alt_video_clip_download_path(video, alt_video, clip.chunk_ordinal), download: "",
                        class: "btn btn-primary btn-sm w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-1.5",
                        title: "This clip's source clip, prompt, lettered frames and sheets in one zip",
                        data: { test: "clip-download-assets", turbo: false } do %>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-5-5m5 5 5-5M4 21h16"/></svg>
              <span>Download clip assets</span>
            <% end %>
          <% end %>
        </div>
        <div class="flex flex-col sm:flex-row sm:flex-wrap gap-2 min-w-0">
          <% if chunk && (download = downloads[chunk.object_key]) %>
            <%= link_to "Download #{clip_seconds(clip.duration_ms)} s clip", download, download: chunk.object_key.split("/").last,
                        class: "btn btn-outline btn-sm", data: { test: "clip-chunk-download" } %>
          <% else %>
            <span class="text-sm text-muted" data-test="clip-chunk-unreachable">Source clip not reachable.</span>
          <% end %>
          <% swapped.zip(lettered).each do |entry, row| %>
            <% sheet = entry.appearance_slug && sheets[entry.appearance_slug] %>
            <% sheet_label = "Sheet #{row.sheet} · Person #{row.letter} · #{row.player}" %>
            <% if sheet %>
              <%= link_to sheet.image_url, target: "_blank", rel: "noopener", download: "#{entry.appearance_slug}_character_sheet",
                          title: entry.label, class: "btn btn-outline btn-sm min-w-0",
                          data: { test: "clip-sheet", look: entry.appearance_slug, ordinal: entry.performer_ordinal, sheet: row.sheet } do %>
                <span class="whitespace-normal break-words"><%= sheet_label %></span>
              <% end %>
            <% else %>
              <span class="text-sm text-warning-ink min-w-0 break-words" data-test="clip-sheet-missing" data-ordinal="<%= entry.performer_ordinal %>">
                <%= sheet_label %>: no character sheet for <%= entry.label %> yet.
                <%= link_to "Open the athlete", person_path(entry.person_slug), class: "text-primary hover:underline" %> to build one.
              </span>
            <% end %>
          <% end %>
          <% if swapped.empty? %>
            <span class="text-sm text-muted" data-test="clip-sheet-none">No character assets: this alt video swaps nobody in this window.</span>
          <% end %>
        </div>
      </div>

      <div class="min-w-0 pt-3 border-t border-subtle" data-test="clip-versions" data-count="<%= versions.size %>">
        <p class="label-upper mb-1.5">Generated versions</p>
        <%= form_with url: music_video_alt_video_clip_versions_path(video, alt_video, clip.chunk_ordinal), method: :post, multipart: true, local: true,
                      html: { "x-data": "clipDrop()", "@submit": "busy = true",
                              data: { test: "clip-drop-form", max_bytes: MusicVideos::StoreClipVersion::MAX_BYTES } } do %>
          <label for="clip-file-<%= clip.chunk_ordinal %>"
                 class="flex flex-col items-center justify-center gap-1 rounded-lg border-2 border-dashed px-3 py-5 text-center cursor-pointer transition-colors min-w-0"
                 :class="over ? 'border-primary bg-primary/10' : 'border-subtle bg-surface-alt hover:border-primary/60'"
                 @dragenter.prevent="over = true" @dragover.prevent="over = true" @dragleave.prevent="over = false" @drop.prevent="dropped($event)"
                 data-test="clip-drop">
            <span class="text-sm font-semibold text-heading" x-show="!busy">Drop the generated MP4 here</span>
            <span class="text-sm font-semibold text-heading" x-show="busy" x-cloak>Uploading, keep this tab open…</span>
            <span class="text-xs text-muted" x-show="!busy">or click to choose it · MP4 up to <%= MusicVideos::StoreClipVersion::MAX_BYTES / 1024 / 1024 %> MB · it becomes the primary version</span>
          </label>
          <input id="clip-file-<%= clip.chunk_ordinal %>" x-ref="file" type="file" name="file" accept="video/mp4,.mp4" required
                 class="sr-only" @change="chosen()" data-test="clip-file">
          <p x-show="error" x-cloak x-text="error" class="text-xs text-warning-ink mt-1" data-test="clip-drop-error"></p>
        <% end %>
        <% if versions.empty? %>
          <p class="text-sm text-muted mt-2" data-test="clip-versions-empty">None yet: Watch full video plays the source chunk here.</p>
        <% else %>
          <ul class="flex flex-col gap-1.5 mt-2">
            <% versions.reverse_each do |version| %>
              <li class="flex flex-wrap items-center justify-between gap-2 min-w-0 text-sm" data-test="clip-version"
                  data-number="<%= version.number %>" data-primary="<%= version == primary %>" data-key="<%= version.object_key %>">
                <span class="min-w-0 break-words">
                  <span class="font-semibold text-heading"><%= version.name %></span>
                  <span class="text-muted">· <%= take_size(version.byte_size) %> · <%= l(version.created_at, format: :short) %></span>
                </span>
                <span class="flex items-center gap-2 shrink-0">
                  <% if (version_url = urls[version.object_key]) %>
                    <%= link_to "Open", version_url, target: "_blank", rel: "noopener", class: "text-primary hover:underline", data: { test: "clip-version-open" } %>
                  <% end %>
                  <% if version == primary %>
                    <span class="badge text-3xs bg-success/10 text-success-ink border-success/40">Primary</span>
                  <% else %>
                    <%= button_to "Make primary", primary_music_video_alt_video_clip_version_path(video, alt_video, clip.chunk_ordinal, version.number),
                                  method: :post, class: "btn btn-outline btn-sm", form: { class: "contents", data: { test: "clip-make-primary" } } %>
                  <% end %>
                </span>
              </li>
            <% end %>
          </ul>
        <% end %>
      </div>

      <%= render "alt_videos/clip_tiktok", clip: clip, video: video, alt_video: alt_video, primary: primary %>

      <div class="min-w-0 pt-3 border-t border-subtle" data-test="clip-regenerate">
        <% if clip.regenerate_requested? %>
          <div class="flex items-start justify-between gap-2 min-w-0">
            <p class="text-sm text-warning-ink min-w-0 break-words" data-test="clip-regenerate-note">
              <span class="font-semibold">Regenerate requested</span><% if clip.regenerate_note.present? %>: <%= clip.regenerate_note %><% end %>
              <span class="block text-muted">The next uploaded version clears it.</span>
            </p>
            <%= button_to "Clear", music_video_alt_video_clip_regenerate_path(video, alt_video, clip.chunk_ordinal), method: :delete,
                          class: "btn btn-outline btn-sm shrink-0", form: { data: { test: "clip-regenerate-clear" } } %>
          </div>
        <% else %>
          <%= form_with url: music_video_alt_video_clip_regenerate_path(video, alt_video, clip.chunk_ordinal), method: :post, local: true,
                        class: "flex flex-col sm:flex-row gap-2 min-w-0", data: { test: "clip-regenerate-form" } do %>
            <label class="sr-only" for="clip-regenerate-note-<%= clip.chunk_ordinal %>">What is wrong with <%= clip.name.downcase %> (optional)</label>
            <input id="clip-regenerate-note-<%= clip.chunk_ordinal %>" type="text" name="note" maxlength="<%= AltVideoClip::REGENERATE_NOTE_MAX %>"
                   placeholder="What is wrong (optional)" class="input-field py-2 text-sm min-w-0 flex-1" data-test="clip-regenerate-input">
            <button type="submit" class="btn btn-outline btn-sm shrink-0">Request regenerate</button>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
</article>
