<%# The hub's page header: studio-engine's studio/_page_header (its docs/PAGE_HEADER.md)
    with the hub's registry wired in. The crumb trail comes from the page's parents in
    config/navigation.yml, a section sub-nav becomes the links line under the title, and
    a block renders on the right, for the page's own controls. Render it as a layout to
    pass one:

      render layout: "components/page_header", locals: { title: "Stages", page: :stages } do ... end

    Call it from the page's long container: the row is sticky, and a sticky row travels
    only as far as its parent.

    Locals:
      title        the page title, the page's one h1
      page         the page's key in config/navigation.yml, for the crumb trail
                   (optional; the sub-nav's current page by default)
      eyebrow      a short kicker beside the title (optional)
      description  the lead paragraph, text or captured markup, under the row (optional)
      sub_nav      { nav:, current: } for the links line (optional)
      class        classes for the description (optional) %>
<% sub_nav = local_assigns[:sub_nav] %>
<% page = local_assigns[:page] || sub_nav&.dig(:current) %>
<% actions = yield %>
<%= render "studio/page_header",
      title: title,
      crumbs: (page ? studio_crumbs(page) : []),
      meta: local_assigns[:eyebrow].presence,
      actions_html: actions.presence,
      links: (sub_nav ? sub_nav_links(sub_nav[:nav], current: sub_nav[:current]) : []),
      links_label: (Navigation.sub_nav(sub_nav[:nav]).label if sub_nav),
      data: { test: "page-header" } %>
<% if local_assigns[:description].present? %>
  <p class="text-muted text-sm max-w-3xl mt-2 <%= local_assigns[:class] %>" data-test="page-header-description"><%= description %></p>
<% end %>
