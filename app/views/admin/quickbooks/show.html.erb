<%# The standing QuickBooks Online connection page (/admin/quickbooks): each connected company, its Intuit environment, and a live read proving it: the company's name from CompanyInfo, and this year's profit and loss to date (its period, basis, top-level sections and net income); or Intuit's error said plainly. Connect adds a company; each company has its own Disconnect. Until the Intuit app and encryption keys are set, Connect renders disabled and the missing setup shows by NAME only. It renders no token and no part of one, and no value of any env var. %>
<% can_connect = @configured && @encryption_ready %>
<% stamp = ->(time) { time.in_time_zone("America/Denver").strftime("%a %b %-d, %Y, %-l:%M %p %Z") } %>
<% money = ->(value, currency) { value.nil? ? "unknown" : "#{number_to_currency(value, unit: "", precision: 2)}#{" #{currency}" if currency}" } %>
<section class="max-w-3xl mx-auto px-4 py-10 space-y-6" data-test="quickbooks-connection-page" data-count="<%= @reads.size %>">
  <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
    <div class="min-w-0">
      <h1 class="text-3xl font-bold text-heading">QuickBooks connection</h1>
      <p class="text-secondary mt-2">
        The QuickBooks Online companies this server reads, each connected by signing in with Intuit. It reads company info and reports and never writes to the books. No token is shown here.
      </p>
    </div>
    <% if can_connect %>
      <%= link_to "Connect QuickBooks", admin_quickbooks_connect_path,
                  class: "btn btn-primary btn-sm w-full sm:w-auto shrink-0 text-center", data: { test: "quickbooks-connect", turbo: false } %>
    <% else %>
      <button type="button" class="btn btn-primary btn-sm w-full sm:w-auto shrink-0 opacity-50 cursor-not-allowed" disabled
              data-test="quickbooks-connect-disabled" title="Not set up on this server yet">Connect QuickBooks</button>
    <% end %>
  </div>

  <% if @unreadable.any? %>
    <p class="card p-4 text-sm text-body" data-test="quickbooks-unreadable">
      <span class="font-semibold text-warning-ink">Stored but unreadable:</span> <%= @unreadable.map(&:company_name).to_sentence %>. It was encrypted with keys this server no longer has; connecting that company again replaces it.
    </p>
  <% end %>

  <% if @reads.empty? %>
    <div class="card p-4 text-sm space-y-2" data-test="quickbooks-section" data-state="none">
      <span class="badge text-xs bg-warning/10 text-warning-ink border-warning/40" data-test="quickbooks-badge">Not connected</span>
      <p class="text-muted" data-test="quickbooks-detail"><%= can_connect ? "No company connected. Connect signs in with Intuit; you pick the company there. New connections land in the #{@environment} environment." : "Connect is off until the setup below is done." %></p>
    </div>
  <% end %>

  <% @reads.each do |read| %>
    <% connection = read.connection %>
    <div class="card p-4 space-y-3 text-sm" data-test="quickbooks-section" data-state="<%= read.error ? 'read_failed' : 'connected' %>" data-environment="<%= connection.environment %>">
      <div class="flex flex-col sm:flex-row sm:items-start sm:justify-between gap-3">
        <div class="min-w-0 space-y-1">
          <h2 class="font-semibold text-heading text-base break-words" data-field="company"><%= connection.company_name %></h2>
          <div class="flex flex-wrap gap-2">
            <% if read.error %>
              <span class="badge text-xs bg-warning/10 text-warning-ink border-warning/40" data-test="quickbooks-badge">Connected, but the read failed</span>
            <% else %>
              <span class="badge text-xs bg-success/10 text-success-ink border-success/40" data-test="quickbooks-badge">Connected</span>
            <% end %>
            <span class="badge text-xs" data-field="environment"><%= connection.sandbox? ? "Sandbox" : "Production" %></span>
          </div>
          <p class="text-muted text-xs" data-field="connected">Connected <%= stamp.(connection.connected_at) %><% if connection.connected_by.present? %> by <%= connection.connected_by %><% end %></p>
          <% if connection.last_refreshed_at %>
            <p class="text-muted text-xs" data-field="refreshed">Token last refreshed <%= stamp.(connection.last_refreshed_at) %></p>
          <% end %>
          <% if connection.refresh_token_expires_at %>
            <p class="text-muted text-xs" data-field="expires">Sign-in lapses <%= stamp.(connection.refresh_token_expires_at) %> unless it is used</p>
          <% end %>
        </div>
        <%= button_to "Disconnect", admin_quickbooks_disconnect_path(connection), method: :delete, class: "btn btn-danger btn-sm w-full sm:w-auto",
                      form: { class: "shrink-0", data: { test: "quickbooks-disconnect", turbo_confirm: "Disconnect QuickBooks for #{connection.company_name}?" } } %>
      </div>

      <% if read.error %>
        <p class="text-body" data-test="quickbooks-read-error"><%= read.error %></p>
      <% else %>
        <% report = read.report %>
        <div class="space-y-2" data-test="quickbooks-read" data-sections="<%= report.sections.size %>">
          <dl class="grid grid-cols-1 sm:grid-cols-[auto_1fr] gap-x-4 gap-y-1">
            <dt class="text-muted text-xs">Company info</dt>
            <dd class="text-heading break-words min-w-0" data-field="company-info"><%= read.company.name || "No name given" %><% if read.company.country %> · <%= read.company.country %><% end %></dd>
            <dt class="text-muted text-xs">Profit and loss</dt>
            <dd class="text-body" data-field="period"><%= report.start_date.strftime("%b %-d, %Y") %> to <%= report.end_date.strftime("%b %-d, %Y") %><% if report.basis %>, <%= report.basis.downcase %> basis<% end %></dd>
            <% if report.empty? %>
              <dt class="text-muted text-xs">Sections</dt>
              <dd class="text-muted" data-field="no-data">No activity in this period.</dd>
            <% else %>
              <% report.sections.reject { _1.group == "NetIncome" }.each do |section| %>
                <dt class="text-muted text-xs"><%= section.name %></dt>
                <dd class="text-body" data-field="section" data-group="<%= section.group %>"><%= money.(section.total, report.currency) %></dd>
              <% end %>
              <dt class="text-muted text-xs">Net income</dt>
              <dd class="text-heading font-medium" data-field="net-income"><%= money.(report.net_income, report.currency) %></dd>
            <% end %>
          </dl>
        </div>
      <% end %>
    </div>
  <% end %>

  <% unless can_connect %>
    <dl class="card p-4 space-y-3 text-sm border-warning/40" data-test="quickbooks-server">
      <% unless @configured %>
        <div>
          <dt class="text-muted text-xs mb-1">Intuit app</dt>
          <dd class="text-body break-words" data-field="client" data-set="false">
            <span class="font-semibold text-warning-ink">Not set.</span>
            Set <span class="font-mono text-xs">INTUIT_CLIENT_ID</span> and <span class="font-mono text-xs">INTUIT_CLIENT_SECRET</span>, and <span class="font-mono text-xs">INTUIT_ENVIRONMENT=production</span> for live keys (sandbox otherwise).
            <span class="text-muted">Its redirect URI must be <span class="font-mono text-xs break-all"><%= @callback_url %></span></span>
          </dd>
        </div>
      <% end %>
      <% unless @encryption_ready %>
        <div>
          <dt class="text-muted text-xs mb-1">Encryption</dt>
          <dd class="text-body break-words" data-field="encryption" data-ready="false">
            <span class="font-semibold text-warning-ink">Not ready.</span> Set <span class="font-mono text-xs"><%= QuickbooksConnection::ENCRYPTION_ENV.join(", ") %></span>: without them no connection can be stored.
          </dd>
        </div>
      <% end %>
    </dl>
  <% end %>
</section>
