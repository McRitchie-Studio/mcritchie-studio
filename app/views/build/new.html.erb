<% content_for :title, "Build an app · McRitchie Studio" %>
<%# /build: the agent shell (agent_chats/_shell) with Ritch at its head. The first message
    answers in place (build/_first_form, BuildController#create): the thread grows here,
    the address becomes /build/<token>, and the page never reloads. %>
<% content_for :head, tag.meta(name: "view-transition", content: "same-origin") %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<div data-test="build-page">
  <% head = render "agent_chats/header", name: BuildController::AGENT_NAME, agent: @intake_agent, role: BuildController::AGENT_ROLE %>
  <% chat = capture do %>
    <div id="build-chat-page" class="agent-shell-thread flex flex-col gap-3" data-test="build-chat-start">
      <%= render "build/first_form" %>
    </div>
  <% end %>
  <%= render "agent_chats/shell", page: "build", head: head, status: render("build/status_card"), chat: chat %>

  <%= render "build/gallery", examples: @examples %>
</div>
