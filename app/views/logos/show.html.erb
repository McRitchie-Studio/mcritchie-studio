<%# ONE BRAND'S LOGOS, TABBED BY TYPE: Icon, Navbar Logo (the default) or
    Stacked Logo. Each tab shows ONE logo (task logo-download-card), on the page's own
    background (no plates), in the hub theme's tone: the Context control sets
    the theme, and Watermark turns the page dark and shows the watermark logos
    (LogosController#set_context). The header holds the breadcrumb, the type tabs and
    Context (task brand-page-split-layout); under it the page is in halves: the
    controls beside the logo, then the words about it beside the Download card
    (logos/_download_card: the logo as an SVG or a PNG at a preset or custom size, in
    any tone, with Copy SVG) and the edit panel (one column on a phone; a guide
    drawing always takes the full width). The Navbar and Stacked tabs' Words control picks the text version
    (homogeneous, first or second word leads; ?text=, the kit's by default). The Navbar Logo tab
    has a Rule control (3, 4 or 6) and shows one rule at a time; it and the Stacked
    Logo tab has a Form control (the brand's own form, and With tagline where
    the brand has a tagline) and a Proportion control (3-2-1 or the rule of three); both can swap every logo for its guide drawing, which fits its frame
    until its labels would be too small, then scrolls sideways. Every control is a
    plain link or a GET form built from logo_page_params, so each keeps the
    others' settings, the edit panel's edits among them (logos/_edit_panel, on
    the Navbar and Stacked tabs; the Icon tab's is the icon's colour alone). The
    kit record (BrandKit) saves an Icon, a Navbar and a Stacked choice
    (logos/_kit_choice) and shows them on every tab (logos/_kit_card). The
    Icon is the kit's atomic unit (task kit-icon-atomic-unit): once saved, the
    Navbar and Stacked tabs draw it, and their Colouring sets the words.
    Admin only (LogosController, BrandKitsController). %>
<%= render "components/copy_text_script" %>
<% name = Logos::Variant.brand_name(@logo) %>
<%# A control's look, chosen or not. A chosen one gets a transparent border, because the neutral button has a 1 px
    border and the primary has none: without it the chosen control is 2 px smaller and the row shifts on a change. %>
<%# This page's focus ring, a fixed colour per hub theme (indigo on light, white on dark). The engine's own .btn
    ring is --color-cta at 70 percent, which measures about 2:1 on the light theme's white card. %>
<% ring = "focus-visible:outline-[#4338CA]! dark:focus-visible:outline-white!" %>
<% chosen = ->(on) { "btn btn-sm #{on ? 'btn-primary border border-transparent' : 'btn-neutral'} #{ring}" } %>
<%# An explicit context sets the hub theme from the first paint (the layout's html_theme; app/javascript/theme_context.js),
    and again on a Turbo visit (app/javascript/logo_gallery.js, data-logo-theme). %>
<% content_for :html_theme, @theme.to_s if @theme %>
<%= tag.div class: "max-w-6xl mx-auto px-4 py-6 space-y-5", data: { logo_theme: @theme } do %>
  <%# The header: where the page is, which brand, its kit's save line, the type tabs, and Context at the far right. %>
  <header class="space-y-2" data-test="logo-header">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
      <nav class="flex items-center gap-1.5 text-muted flex-wrap min-w-0" aria-label="Breadcrumb">
        <%= link_to "Logos", logos_path(logo_page_keeps), class: "text-sm hover:text-primary", data: { test: "logos-crumb" } %>
        <span aria-hidden="true">/</span>
        <h1 class="text-sm font-bold text-heading break-words min-w-0" aria-current="page"><%= name %></h1>
      </nav>
      <nav class="flex flex-wrap items-center gap-2" aria-label="Logo type" data-test="logo-tabs">
        <% Logos::Variant::TYPES.each do |type, label| %>
          <%= link_to label, logo_brand_path(@logo.brand, logo_page_params(type: (type unless type == :navbar))),
                      class: chosen.(type == @type), aria: { current: ("page" if type == @type) }, data: { test: "logo-tab", type: type } %>
        <% end %>
      </nav>
      <div class="ml-auto"><%= render "logos/context_form", url: logo_brand_path(@logo.brand) %></div>
    </div>
    <p class="text-2xs text-muted" data-test="kit-status"><%= link_to logo_kit_status(@kit_record, @savers), "#kit", class: "hover:text-primary", title: logo_kit_status(@kit_record, @savers, full: true) %></p>
  </header>

  <%# THE PAGE IN QUARTERS (task brand-page-split-layout): the one logo beside the edit panel, then the Download card
      beside the controls. A guide drawing needs the full width, so with guides on it takes the top row alone and the
      edit panel goes (Alex McRitchie 2026-10-27), the row keeping the height it had. On a phone everything is one column. %>
  <% variant = @shown.values.first %>
  <%# The Icon tab has no guide drawing, so it keeps its edit panel with ?guides=1 in the URL. %>
  <% split = !variant.guides %>
  <section class="space-y-5 min-w-0" data-test="logo-type" data-type="<%= @type %>" data-layout="<%= split ? 'split' : 'row' %>" aria-label="<%= Logos::Variant::TYPES.fetch(@type) %>">
    <%# The two halves share a height: the logo's card stretches to the edit panel's, and its frame fills it. %>
    <div class="grid gap-5 min-w-0 lg:grid-cols-2" data-test="logo-top">
      <div class="card p-4 sm:p-5 min-w-0 flex flex-col <%= 'lg:col-span-2 lg:col-start-1 lg:row-start-1' unless split %>" data-test="logo-example" data-tones="<%= @shown.keys.join(' ') %>" data-text="<%= variant.text %>">
        <% if variant.guides %>
          <%# A guide drawing fits its frame until its labels would be too small to read; from there it keeps its width
              and the frame scrolls sideways inside itself. The frame is a tab stop only while it scrolls:
              app/javascript/scroll_tab_stop.js takes the tabindex away when the drawing fits and puts it back when
              it does not (and checks again when the theme swaps the drawing). With JavaScript off it stays a tab
              stop, which costs one extra Tab. No plate: the frame has no background of its own. %>
          <div class="flex flex-1 flex-col justify-center overflow-x-auto rounded-lg border border-subtle p-3 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary"
               data-test="logo-frame" tabindex="0" data-scroll-tab-stop role="group" aria-label="Guide drawing: <%= variant.label.sub(", #{variant.tone}", '') %>">
            <%= logo_themed_images(@shown, height: logo_height(variant)) %>
          </div>
        <% else %>
          <%# The dotted outline is the Download card's PNG canvas, drawn around the logo where the canvas is not the
              logo's own shape (a custom size without its aspect, or the icon's 1:1 square). app/javascript/logo_download.js
              places it; the frame clips it. %>
          <div class="relative overflow-hidden flex flex-1 items-center justify-center rounded-lg border border-subtle p-4 sm:p-8 min-w-0" data-test="logo-frame">
            <%= logo_themed_images(@shown, height: logo_height(variant)) %>
            <div class="pointer-events-none absolute rounded-sm border-2 border-dashed border-primary" data-test="download-canvas-outline" data-download-outline aria-hidden="true" hidden></div>
          </div>
        <% end %>
      </div>
      <%# The edit panel (logos/_edit_panel): the Navbar and Stacked tabs' per-part colour, weight and tagline edits; the
          Icon tab's icon colour. %>
      <% if split %>
        <%= render "logos/edit_panel", kit: @kit %>
      <% else %>
        <%# Guides on: the edit panel goes, but the row keeps the height it gives the logo's card, so Show and Hide never
            move the page. At desktop width the panel is drawn here invisible, inert and hidden from assistive tech, in
            the half it would fill, under the drawing's card; on a phone, where the row is one column, it is not drawn. %>
        <div class="hidden lg:block invisible lg:col-start-1 lg:row-start-1 min-w-0" aria-hidden="true" inert data-test="edit-ghost">
          <%= render "logos/edit_panel", kit: @kit %>
        </div>
      <% end %>
    </div>

    <div class="grid gap-5 min-w-0 lg:grid-cols-2" data-test="logo-bottom">
      <%= render "logos/download_card", downloads: @downloads %>
      <div class="card p-4 sm:p-5 space-y-3 min-w-0" data-test="logo-control-card">
        <%# One control group per line, its name on the left and its options on the right: Colouring, then the tab's
            Rule or Form and Proportion, then Words. %>
        <div class="flex flex-col items-stretch gap-3" data-test="logo-controls">
          <%= render "logos/colouring_control", path: ->(page) { logo_brand_path(@logo.brand, page) }, chosen: @colouring, default: @default_colouring, logo: @logo, spread: true %>
          <% if @type == :navbar %>
            <div class="flex flex-wrap items-center justify-between gap-2" role="group" aria-label="Rule" data-test="rule-control">
              <span class="text-3xs font-semibold uppercase tracking-wide text-muted" aria-hidden="true">Rule</span>
              <div class="flex flex-wrap justify-end gap-2">
                <% Logos::Variant::RULES.each do |rule, label| %>
                  <%= link_to label, logo_brand_path(@logo.brand, logo_page_params(rule: (rule unless rule == @defaults[:rule]))),
                              class: chosen.(rule == @rule), aria: { current: ("true" if rule == @rule) }, data: { test: "rule-option", rule: rule } %>
                <% end %>
              </div>
            </div>
          <% end %>
          <% if @type == :stacked %>
            <div class="flex flex-wrap items-center justify-between gap-2" role="group" aria-label="Form" data-test="form-control">
              <span class="text-3xs font-semibold uppercase tracking-wide text-muted" aria-hidden="true">Form</span>
              <div class="flex flex-wrap justify-end gap-2">
                <% @logo.forms.each do |form| %>
                  <%= link_to Logos::Variant::FORMS.fetch(form), logo_brand_path(@logo.brand, logo_page_params(form: (form unless form == @defaults[:form]))),
                              class: chosen.(form == @form), aria: { current: ("true" if form == @form) }, data: { test: "form-option", form: form } %>
                <% end %>
              </div>
            </div>
            <%# Every form draws in either proportion (task stacked-rule-of-three): it sets only the icon's size. %>
            <div class="flex flex-wrap items-center justify-between gap-2" role="group" aria-label="Proportion" data-test="proportion-control">
              <span class="text-3xs font-semibold uppercase tracking-wide text-muted" aria-hidden="true">Proportion</span>
              <div class="flex flex-wrap justify-end gap-2">
                <% Logos::Variant::PROPORTIONS.each do |proportion, label| %>
                  <%= link_to label, logo_brand_path(@logo.brand, logo_page_params(proportion: (proportion unless proportion == @defaults[:proportion]))),
                              class: chosen.(proportion == @proportion), aria: { current: ("true" if proportion == @proportion) },
                              data: { test: "proportion-option", proportion: proportion } %>
                <% end %>
              </div>
            </div>
          <% end %>
          <%# The text version (task logo-download-card): one small control in place of the three versions the tab used to
              draw side by side. The edit panel's "As styled" weight and colour read from it, so it is still a choice. %>
          <% unless @type == :icon %>
            <div class="flex flex-wrap items-center justify-between gap-2" role="group" aria-label="Words" data-test="text-control">
              <span class="text-3xs font-semibold uppercase tracking-wide text-muted" aria-hidden="true">Words</span>
              <div class="flex flex-wrap justify-end gap-2">
                <% Logos::Variant::TEXTS.each do |text, label| %>
                  <%= link_to label, logo_brand_path(@logo.brand, logo_page_params(text: (text unless text == @default_text))),
                              class: chosen.(text == @text), aria: { current: ("true" if text == @text) }, data: { test: "text-option", text: } %>
                <% end %>
              </div>
            </div>
          <% end %>
          <%# Guidelines: a line like the others, its name on the left and a Show / Hide toggle on the right. %>
          <% unless @type == :icon %>
            <div class="flex flex-wrap items-center justify-between gap-2" role="group" aria-label="Guidelines" data-test="guides-control">
              <span class="text-3xs font-semibold uppercase tracking-wide text-muted" aria-hidden="true">Guidelines</span>
              <div class="flex flex-wrap justify-end gap-2">
                <%= link_to (@guides ? "Hide" : "Show"), logo_brand_path(@logo.brand, logo_page_params(guides: (1 unless @guides))),
                            class: chosen.(@guides), aria: { label: (@guides ? "Hide guidelines" : "Show guidelines"), pressed: @guides.to_s },
                            data: { test: "guides-toggle" } %>
              </div>
            </div>
          <% end %>
          <div class="flex flex-wrap items-center gap-2">
            <%# Save as default (task logo-original-and-alt, item 9): the tab's rule or form, text version, colouring and edits become the
                brand's kit choice, which this tab then opens on. On the Icon tab, its colouring and colour become the kit's
                icon, which every Navbar and Stacked Logo draws (task kit-icon-atomic-unit). A plain form, no JavaScript. %>
            <% unless @edit_refusal %>
              <%= form_with url: brand_kit_choice_path(@logo.brand), method: :patch, class: "contents", data: { test: "kit-save-default-form", turbo: false } do %>
                <% logo_kit_save_fields.merge(return: "top").compact.each do |name, value| %><%= hidden_field_tag name, value, id: nil %><% end %>
                <%= submit_tag "Save as default", name: nil, class: chosen.(false), disabled: @kit_default_shown,
                               data: { test: "kit-save-default", disable_with: false }, title: ("This is the kit default already" if @kit_default_shown) %>
              <% end %>
            <% end %>
          </div>
        </div>
        <%# Which defaults the tab is on: its kit's saved choice, changed from it, or the built-in style (none saved). %>
        <p class="text-2xs text-muted" data-test="kit-default-state" data-state="<%= @kit_default ? (@kit_default_shown ? 'shown' : 'changed') : 'none' %>">
          <% if @kit_default_shown %>
            Showing the kit default.
          <% elsif @kit_default %>
            Changed from the kit default · <%= link_to "Back to kit default", logo_tab_default_path, class: "font-semibold text-primary hover:underline", data: { test: "kit-default-back" } %>
          <% else %>
            No kit default saved for this type: showing the brand's style. Save as default to open this tab on what you pick.
          <% end %>
        </p>
        <% if @icon_from_kit %>
          <p class="text-2xs text-muted" data-test="kit-icon-note">The icon is the kit's (<%= logo_choice_summary(@kit_icon).presence || "as styled" %>), so Colouring here sets the words. Change the icon on the <%= link_to "Icon tab", logo_brand_path(@logo.brand, logo_page_params(type: :icon)), class: "font-semibold text-primary hover:underline", data: { test: "kit-icon-tab" } %>.</p>
        <% elsif @kit_icon && @icon_overridden %>
          <p class="text-2xs text-muted" data-test="kit-icon-note">This tab is exploring an icon other than the kit's. <%= link_to "Back to the kit icon", logo_brand_path(@logo.brand, logo_page_params(icon_colouring: nil).except(:icon_colour)), class: "font-semibold text-primary hover:underline", data: { test: "kit-icon-back" } %></p>
        <% end %>
        <div class="flex flex-wrap items-center gap-2">
          <%# This brand's kit beside another's (task logo-compare-and-original-edits): its other version, else the next brand. %>
          <%= link_to "Compare", logo_compare_path_for(@logo.brand, type: @type), class: chosen.(false), data: { test: "compare-link" } %>
          <%# The edit panel is below the logo; this takes the reader to it, the same on every tab (task
              logo-compare-and-original-edits, item 2). %>
          <%# Not with guides on, when the edit panel is put away. %>
          <%= link_to (@type == :icon ? "Edit colour" : "Edit parts"), "#edit", class: chosen.(false), data: { test: "edit-jump" } if split %>
        </div>
      </div>
    </div>
  </section>

  <%# Save this tab's choice to the brand's kit record (logos/_kit_choice), then the kit as saved (logos/_kit_card). %>
  <%= render "logos/kit_choice", kit_record: @kit_record %>
  <%= render "logos/kit_card", kit_record: @kit_record %>
  <%= render "logos/kit_originals", kit_record: @kit_record %>

  <div class="card p-4 sm:p-5 grid gap-6 lg:grid-cols-[3fr_2fr]" data-test="brand-kit">
    <section class="min-w-0 space-y-3" data-test="brand-colours" aria-labelledby="brand-colours-title">
      <h2 id="brand-colours-title" class="text-sm font-bold text-heading">Colours</h2>
      <%= render "logos/palette", kit: @kit %>
    </section>
    <section class="min-w-0 space-y-3" data-test="brand-typefaces" aria-labelledby="brand-typefaces-title">
      <h2 id="brand-typefaces-title" class="text-sm font-bold text-heading">Typefaces</h2>
      <%= render "logos/typefaces", kit: @kit %>
    </section>
  </div>

  <%# Every palette colour as a 50-950 ramp, each step copyable, and the lot as CSS tokens (logos/_spectrum). %>
  <section class="card p-4 sm:p-5 space-y-3" data-test="brand-spectrum" aria-labelledby="brand-spectrum-title">
    <div class="space-y-1">
      <h2 id="brand-spectrum-title" class="text-sm font-bold text-heading">Spectrum</h2>
      <p class="text-xs text-muted">Each colour from 50 (lightest) to 950 (darkest). The brand's own hex sits on its nearest step, marked Brand. Click a step to copy it.</p>
    </div>
    <%= render "logos/spectrum", kit: @kit %>
  </section>
<% end %>
