<%# locals: (card:, message:, request_row:) %>
<%# The CTO card: Xan's names (or one the visitor types) and the portrait grid (BuildIntake::Portraits, twelve original placeholders), one form, one tap. Upload is a placeholder until chat media lands. Works without JavaScript: plain radios. %>
<% keys = BuildIntake::Portraits::KEYS %>
<% picked_name = card["names"].include?(request_row.cto_name) ? request_row.cto_name : card["names"].first %>
<% picked_portrait = BuildIntake::Portraits.key?(request_row.cto_avatar) ? request_row.cto_avatar : (card["portrait"] || BuildIntake::Portraits.default_for(request_row.token)) %>
<% chosen = request_row.cto_name.present? %>
<%= form_with url: build_request_intake_path(request_row.token), method: :patch,
      class: "rounded-2xl border #{chosen ? 'border-primary' : 'border-subtle'} bg-surface p-3 sm:p-4 space-y-4",
      data: { test: "build-card-cto", chosen: chosen } do %>
  <%= hidden_field_tag :field, "cto" %>
  <%= hidden_field_tag :message_id, message.id %>
  <fieldset>
    <legend class="text-xs font-semibold uppercase tracking-wider text-muted mb-2">Name your CTO</legend>
    <div class="flex flex-wrap gap-2">
      <% card["names"].each do |name| %>
        <label class="cursor-pointer">
          <input type="radio" name="name" value="<%= name %>" class="peer sr-only" <%= "checked" if name == picked_name %> data-test="build-cto-name">
          <span class="inline-block rounded-full border border-subtle px-3 py-1.5 text-sm text-body peer-checked:border-primary peer-checked:bg-primary/10 peer-checked:text-heading peer-focus-visible:ring-2 peer-focus-visible:ring-primary"><%= name %></span>
        </label>
      <% end %>
    </div>
    <label class="mt-2 block">
      <span class="sr-only">Or type a name</span>
      <input type="text" name="custom_name" maxlength="24" autocomplete="off" placeholder="Or type your own name"
             class="input-field w-full sm:w-64 text-sm" data-test="build-cto-custom">
    </label>
  </fieldset>

  <fieldset>
    <legend class="text-xs font-semibold uppercase tracking-wider text-muted mb-2">Pick a portrait</legend>
    <div class="grid grid-cols-4 sm:grid-cols-7 gap-2" data-test="build-portraits">
      <% keys.each do |key| %>
        <label class="cursor-pointer" title="<%= BuildIntake::Portraits.label(key) %>">
          <input type="radio" name="portrait" value="<%= key %>" class="peer sr-only" <%= "checked" if key == picked_portrait %> data-test="build-portrait">
          <%= image_tag BuildIntake::Portraits.path(key), alt: "#{BuildIntake::Portraits.label(key)} portrait", loading: "lazy",
                class: "block w-full aspect-square rounded-full ring-offset-2 ring-offset-surface peer-checked:ring-2 peer-checked:ring-primary peer-focus-visible:ring-2 peer-focus-visible:ring-primary" %>
        </label>
      <% end %>
      <span class="flex aspect-square items-center justify-center rounded-full border border-dashed border-subtle text-3xs leading-tight text-center text-muted px-1"
            title="Uploading your own portrait is coming soon" data-test="build-portrait-upload" aria-disabled="true">Upload soon</span>
    </div>
  </fieldset>

  <button type="submit" class="btn <%= chosen ? 'btn-secondary' : 'btn-primary' %> btn-sm" data-test="build-choose-cto">
    <%= chosen ? "Update my CTO" : "Choose my CTO" %>
  </button>
<% end %>
