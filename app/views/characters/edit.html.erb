<%# Edit a character's profile. Admin only. %>
<div class="max-w-3xl mx-auto px-4 py-6 space-y-4">
  <%= render "studio/page_header", title: "Edit #{@character.name}", crumb_label: "Edit",
        crumbs: studio_crumbs(parent: :characters) + [{ label: @character.name, href: character_path(@character) }] %>
  <%= render "characters/form", character: @character %>
</div>
