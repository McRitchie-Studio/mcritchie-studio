<% content_for :title, "Build an app · McRitchie Studio" %>

<section class="max-w-3xl mx-auto px-4 pt-16 pb-24" data-test="build-page">
  <header class="text-center mb-8">
    <h1 class="text-3xl sm:text-5xl font-bold text-heading tracking-tight mb-3">What do you want to build?</h1>
    <p class="text-muted max-w-xl mx-auto">
      Describe your app. Our agents build it on the McRitchie Studio stack and host it free at
      <span class="font-mono text-body">yourapp.mcritchie.studio</span>.
    </p>
  </header>

  <% if @draft %>
    <p class="mb-4 text-center text-sm text-muted" data-test="resume-draft">
      You have an unfinished request.
      <%= link_to "Pick up where you left off", build_request_path(@draft.token), class: "text-primary hover:underline" %>
    </p>
  <% end %>

  <%# Signed out, Enter saves the draft in the background and opens the
      standard sign-in modal over the composer — the visitor never leaves the
      page. Signed in, the form submits normally, straight to the name step. %>
  <script>
    window.buildComposer = function (signedIn) {
      return {
        prompt: '', sending: false, draft: null,
        grow(el) { el.style.height = 'auto'; el.style.height = Math.min(el.scrollHeight, 320) + 'px' },
        async send(event) {
          if (!this.prompt.trim() || this.sending) { event.preventDefault(); return }
          if (signedIn) { this.sending = true; return }
          event.preventDefault();
          // Enter again on the SAME prompt reopens sign-in for the draft already
          // saved, instead of saving a duplicate.
          if (this.draft && this.draft.prompt === this.prompt.trim()) { this.openAuth(this.draft.path); return }
          this.sending = true;
          const form = event.target;
          try {
            const resp = await fetch(form.action, {
              method: 'POST', body: new FormData(form),
              headers: { Accept: 'application/json', 'X-CSRF-Token': document.querySelector('meta[name=csrf-token]')?.content || '' }
            });
            const data = await resp.json();
            if (!resp.ok) throw new Error(data.error || 'Could not save your description');
            this.draft = { prompt: this.prompt.trim(), path: data.path };
            this.openAuth(data.path);
          } catch (e) {
            form.submit(); // the plain-HTML path: the draft page, then sign-in
          } finally { this.sending = false }
        },
        openAuth(path) {
          Alpine.store('modals').open('auth', {
            returnTo: path,
            title: 'Create your free account',
            subtitle: "Your description is saved. Sign in and you'll pick your app's name next."
          });
        }
      }
    }
  </script>

  <%# A chat-style composer. Enter sends; Shift+Enter is a new line. The box grows
      with the text up to a cap, then scrolls. Without JavaScript it is a plain
      form with a submit button, and still works. %>
  <%= form_with model: AppRequest.new, url: build_path, method: :post, local: true,
                data: { test: "build-form" },
                html: { "x-data": "buildComposer(#{logged_in?.to_json})",
                        "@submit": "send($event)" } do |f| %>
    <div class="relative rounded-3xl border border-subtle bg-surface shadow-lg focus-within:border-primary transition-colors">
      <%= f.label :prompt, "Describe your app", class: "sr-only" %>
      <%= f.text_area :prompt, rows: 3, maxlength: AppRequest::PROMPT_LIMIT, required: true, autofocus: true,
            placeholder: "A booking site for my dog-grooming business, with a calendar and text reminders…",
            class: "block w-full resize-none bg-transparent px-5 pt-5 pb-16 text-base text-heading placeholder:text-muted focus:outline-none",
            "x-model": "prompt", "x-ref": "prompt",
            "@input": "grow($el)",
            "@keydown.enter": "if (!$event.shiftKey) { $event.preventDefault(); $el.form.requestSubmit() }",
            data: { test: "build-prompt" } %>
      <div class="absolute bottom-3 left-5 right-3 flex items-center justify-between gap-3">
        <span class="text-xs text-muted hidden sm:inline">Enter to send · Shift+Enter for a new line</span>
        <button type="submit" class="ml-auto inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary text-white disabled:opacity-40"
                :disabled="!prompt.trim() || sending" aria-label="Send" data-test="build-send">
          <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 19V5M5 12l7-7 7 7"/>
          </svg>
        </button>
      </div>
    </div>
  <% end %>


  <div class="mt-5 flex flex-wrap justify-center gap-2" data-test="build-examples" x-data>
    <% [
      "A waitlist page for my new product, with email signups",
      "A client portal where customers upload documents",
      "A league site with schedules, scores and standings",
      "An internal dashboard for tracking job quotes"
    ].each do |example| %>
      <button type="button" class="rounded-full border border-subtle px-3 py-1.5 text-sm text-body hover:border-primary hover:text-primary"
              @click="const box = document.querySelector('[data-test=build-prompt]'); box.value = <%= example.to_json %>; box.dispatchEvent(new Event('input')); box.focus()">
        <%= example %>
      </button>
    <% end %>
  </div>

  <% if @examples.any? || (logged_in? && current_user.admin?) %>
    <section class="mt-14" aria-labelledby="built-with" data-test="build-gallery">
      <div class="flex items-center justify-between gap-3 mb-4">
        <h2 id="built-with" class="text-sm font-semibold uppercase tracking-wider text-muted">Built with McRitchie Studio</h2>
        <% if logged_in? && current_user.admin? %>
          <%= link_to "See all apps →", build_requests_path(status: "all"), class: "text-sm font-semibold text-primary hover:underline",
                data: { test: "build-gallery-all" } %>
        <% end %>
      </div>

      <% if @examples.any? %>
        <%# A sideways row of every live app: about 3.3 cards wide on a laptop (1.25
            on a phone), so the partial card says "there is more". The edge that still
            has cards past it fades out (mask-image, the technique of
            components/_overflow_fade), measured on scroll AND on resize, since the
            row's width changes without the window moving. %>
        <div x-data="{ atStart: true, atEnd: true, _ro: null,
                       measure(el) { this.atStart = el.scrollLeft <= 2; this.atEnd = el.scrollLeft + el.clientWidth >= el.scrollWidth - 2 },
                       get mask() {
                         if (this.atStart && this.atEnd) return 'none';
                         const left = this.atStart ? 'black 0' : 'transparent 0, black 3rem';
                         const right = this.atEnd ? 'black 100%' : 'black calc(100% - 4rem), transparent 100%';
                         return 'linear-gradient(to right, ' + left + ', ' + right + ')';
                       } }"
             x-init="$nextTick(() => measure($refs.row)); _ro = new ResizeObserver(() => measure($refs.row)); _ro.observe($refs.row)"
             x-on:turbo:before-cache.window="_ro && _ro.disconnect()">
          <ul x-ref="row" @scroll.passive="measure($el)"
              class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-3 [scrollbar-width:thin]"
              :style="`-webkit-mask-image: ${mask}; mask-image: ${mask}`"
              data-test="build-gallery-row">
            <% @examples.each do |example| %>
              <li class="snap-start shrink-0 min-w-0 basis-[80%] sm:basis-[calc((100%-3rem)/3.3)]" data-test="build-gallery-item">
                <%= link_to example.url, target: "_blank", rel: "noopener",
                      class: "group flex h-full flex-col overflow-hidden rounded-2xl border border-subtle bg-surface hover:border-primary transition-colors",
                      data: { test: "build-example" } do %>
                  <%# Title on top, then the screenshot, then where it lives and what it is. %>
                  <span class="block px-4 pt-3 pb-2.5 text-center font-semibold text-heading group-hover:text-primary truncate"
                        data-test="build-example-name"><%= example.name %></span>
                  <span class="block aspect-[16/10] overflow-hidden bg-surface-alt border-y border-subtle">
                    <% if example.image %>
                      <%= image_tag example.image, alt: "#{example.name}, as it looks live", loading: "lazy",
                            class: "h-full w-full object-cover object-top group-hover:scale-[1.02] transition-transform duration-300",
                            data: { test: "build-example-image" } %>
                    <% else %>
                      <span class="flex h-full items-center justify-center text-5xl" aria-hidden="true"><%= example.emoji %></span>
                    <% end %>
                  </span>
                  <span class="block p-4 text-center">
                    <span class="block font-mono text-xs text-muted truncate" data-test="build-example-host"><%= URI.parse(example.url).host rescue example.url %></span>
                    <%# No `block` here: it would override line-clamp's display and let the text run on. %>
                    <span class="text-sm text-body mt-1 line-clamp-2" data-test="build-example-blurb"><%= example.blurb %></span>
                  </span>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      <% else %>
        <p class="text-sm text-muted" data-test="build-gallery-empty">Nothing live yet — admins see this line; visitors see no gallery at all.</p>
      <% end %>
    </section>
  <% end %>

  <ol class="mt-14 grid gap-4 sm:grid-cols-3 text-sm" aria-label="How it works">
    <li class="rounded-xl bg-surface-alt p-4">
      <p class="font-semibold text-heading mb-1">1. Describe it</p>
      <p class="text-muted">Say what the app is for and who uses it. Plain words are fine.</p>
    </li>
    <li class="rounded-xl bg-surface-alt p-4">
      <p class="font-semibold text-heading mb-1">2. Claim your name</p>
      <p class="text-muted">Create a free account and pick <span class="font-mono">yourapp</span>.mcritchie.studio.</p>
    </li>
    <li class="rounded-xl bg-surface-alt p-4">
      <p class="font-semibold text-heading mb-1">3. We build it</p>
      <p class="text-muted">Our agents build it on our stack. Follow its progress on your request page.</p>
    </li>
  </ol>
</section>
