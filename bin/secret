#!/usr/bin/env bash
# bin/secret <vault> <item> [field] — print a 1Password secret VALUE to stdout.
#
# The value goes to stdout (so `SECRET="$(bin/secret agents agent.heroku 'api key')"`
# works); all diagnostics go to stderr; the value is never logged or echoed.
# Verifies the op CLI is present and authenticated first. This is the sanctioned
# replacement for hand-rolling `op read` chains in agent scripts.
set -euo pipefail

OP="/opt/homebrew/bin/op"
vault="${1:-}"
item="${2:-}"
field="${3:-password}"

if [ -z "$vault" ] || [ -z "$item" ]; then
  echo "usage: bin/secret <vault> <item> [field]   (field defaults to 'password')" >&2
  exit 2
fi

[ -x "$OP" ] || { echo "secret: 1Password CLI not found at $OP" >&2; exit 1; }
"$OP" whoami >/dev/null 2>&1 || {
  echo "secret: op is not authenticated. Run 'op signin' or set OP_SERVICE_ACCOUNT_TOKEN (see bin/setup-1pass-token)." >&2
  exit 1
}

ref="op://${vault}/${item}/${field}"
value="$("$OP" read "$ref" 2>/dev/null)" || {
  echo "secret: could not read ${ref} (check vault/item/field against credential-inventory.md)" >&2
  exit 1
}
[ -n "$value" ] || { echo "secret: empty value at ${ref}" >&2; exit 1; }

printf '%s' "$value"
