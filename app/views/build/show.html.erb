<% content_for :title, "Your app · McRitchie Studio" %>
<% req = @app_request %>

<section class="max-w-2xl mx-auto px-4 pt-12 pb-24" data-test="build-request" data-status="<%= req.status %>">
  <%# The prompt, echoed back as the first message of the conversation. %>
  <div class="mb-8 flex justify-end">
    <div class="max-w-[85%] rounded-3xl rounded-br-md bg-surface-alt px-5 py-3 text-body whitespace-pre-line" data-test="build-echo"><%= req.prompt %></div>
  </div>

  <% if req.draft? && !logged_in? %>
    <%# STEP 1 — register. The emailed link returns to THIS page (the draft's
        token rides return_to), so the prompt survives even when the email is
        opened on another device. Google always lands on the home page, which
        forwards back here once (session[:build_draft_token]). %>
    <div class="rounded-3xl border border-subtle bg-surface p-6 sm:p-8" data-test="build-register">
      <h1 class="text-2xl font-bold text-heading mb-1">Create your free account to build it</h1>
      <p class="text-muted mb-6">Your description is saved. Sign in and you'll pick your app's name next.</p>

      <%= button_to "/auth/google_oauth2", method: :post, data: { turbo: false },
            class: "btn btn-neutral btn-lg w-full gap-3" do %>
        <%= render "components/google_logo" %>
        Continue with Google
      <% end %>

      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-strong"></div></div>
        <div class="relative flex justify-center text-sm"><span class="bg-surface px-3 text-secondary">or</span></div>
      </div>

      <form x-data="{
              sending: false, error: '',
              async submit(email) {
                if (!email || this.sending) return;
                this.error = ''; this.sending = true;
                try {
                  await window.postMagicLink(email, <%= build_request_path(req.token).to_json %>);
                  $store.modals.open('check-inbox', { sentEmail: email });
                } catch (e) {
                  this.error = 'Could not send the link — check your connection and try again.';
                } finally { this.sending = false; }
              }
            }"
            @submit.prevent="submit($refs.email.value)" novalidate data-test="build-email-form">
        <label for="build-email" class="block text-sm text-secondary mb-2 font-medium">Email</label>
        <input type="email" id="build-email" x-ref="email" required class="input-field mb-4" placeholder="you@example.com">
        <button type="submit" :disabled="sending" class="btn btn-primary btn-lg w-full disabled:cursor-wait">
          <span x-text="sending ? 'Sending…' : 'Email me a sign-in link'">Email me a sign-in link</span>
        </button>
        <p x-show="error" x-cloak class="text-xs text-red-400 text-center mt-2" x-text="error"></p>
        <p class="text-xs text-muted text-center mt-2">One tap from your inbox, no password. It brings you straight back here.</p>
      </form>
    </div>

  <% elsif req.draft? %>
    <%# STEP 2 — claim a subdomain. Availability is checked live as they type;
        the server re-checks on submit (the live answer is advice, not a lock). %>
    <div class="rounded-3xl border border-subtle bg-surface p-6 sm:p-8" data-test="build-claim">
      <h1 class="text-2xl font-bold text-heading mb-1">Name your app</h1>
      <p class="text-muted mb-6">Your free app lives at this address. You can move it to your own domain later.</p>

      <%= form_with model: req, url: build_request_path(req.token), method: :patch, local: true,
            html: { "x-data": "{
              name: #{req.subdomain.to_s.to_json}, state: 'idle', reason: '', timer: null,
              check() {
                clearTimeout(this.timer);
                const n = this.name.trim().toLowerCase();
                if (!n) { this.state = 'idle'; this.reason = ''; return }
                this.state = 'checking';
                this.timer = setTimeout(async () => {
                  try {
                    const r = await fetch('#{build_check_path}?subdomain=' + encodeURIComponent(n), { headers: { Accept: 'application/json' } });
                    const d = await r.json();
                    if (d.subdomain !== this.name.trim().toLowerCase()) return;
                    this.state = d.available ? 'available' : 'taken'; this.reason = d.reason || '';
                  } catch (e) { this.state = 'idle' }
                }, 300)
              }
            }" } do |f| %>
        <%= f.label :subdomain, "App address", class: "block text-sm text-secondary mb-2 font-medium" %>
        <div class="flex items-stretch rounded-xl border border-subtle focus-within:border-primary overflow-hidden">
          <span class="flex items-center pl-4 text-muted font-mono text-sm">https://</span>
          <%= f.text_field :subdomain, required: true, autofocus: true, autocomplete: "off", spellcheck: false,
                maxlength: 30, placeholder: "yourapp",
                class: "min-w-0 flex-1 bg-transparent px-1 py-3 font-mono text-heading focus:outline-none",
                "x-model": "name", "@input": "check()", data: { test: "build-subdomain" } %>
          <span class="flex items-center pr-4 text-muted font-mono text-sm">.mcritchie.studio</span>
        </div>
        <p class="mt-2 text-sm min-h-5" aria-live="polite" data-test="build-availability">
          <span x-show="state === 'checking'" x-cloak class="text-muted">Checking…</span>
          <span x-show="state === 'available'" x-cloak class="text-green-600 dark:text-green-400">Available</span>
          <span x-show="state === 'taken'" x-cloak class="text-red-500" x-text="reason"></span>
        </p>
        <% if req.errors[:subdomain].any? || req.errors[:base].any? %>
          <p class="mt-1 text-sm text-red-500" data-test="build-errors"><%= (req.errors[:subdomain] + req.errors[:base]).to_sentence %></p>
        <% end %>
        <button type="submit" class="btn btn-primary btn-lg w-full mt-4" :disabled="state === 'taken' || state === 'checking'" data-test="build-claim-submit">
          Build my app
        </button>
      <% end %>
    </div>

  <% else %>
    <%# STEP 3 — the request's status page. Builds are asynchronous. %>
    <div class="rounded-3xl border border-subtle bg-surface p-6 sm:p-8" data-test="build-status">
      <% steps = [ [ "queued", "In the build queue" ], [ "building", "Being built" ], [ "live", "Live" ] ] %>
      <% at = steps.index { |key, _| key == req.status } || 0 %>
      <h1 class="text-2xl font-bold text-heading mb-1">
        <%= req.status == "live" ? "Your app is live" : "Your app is in the queue" %>
      </h1>
      <p class="text-muted mb-6">
        <% if req.status == "live" %>
          It's served at <%= link_to req.host, req.url, class: "font-mono text-primary hover:underline", target: "_blank", rel: "noopener" %>.
        <% else %>
          Our agents build each app by hand, in the order they arrive. Its address is reserved for you:
          <span class="font-mono text-body" data-test="build-host"><%= req.host %></span>.
        <% end %>
      </p>
      <ol class="flex flex-col sm:flex-row gap-3" data-test="build-steps">
        <% steps.each_with_index do |(key, label), i| %>
          <li class="flex-1 rounded-xl border px-4 py-3 text-sm <%= i <= at ? 'border-primary text-heading' : 'border-subtle text-muted' %>"
              data-step="<%= key %>" data-done="<%= i <= at %>">
            <span class="font-semibold"><%= i + 1 %>.</span> <%= label %>
          </li>
        <% end %>
      </ol>
      <% if req.status == "cancelled" %>
        <p class="mt-4 text-sm text-muted">This request was cancelled.</p>
      <% end %>
      <p class="mt-6 text-sm text-muted">Bookmark this page to check on it. It's only visible to you.</p>
    </div>
  <% end %>
</section>
