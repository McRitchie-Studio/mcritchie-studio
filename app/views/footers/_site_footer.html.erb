<%# The site footer, after the Endeavor Exteriors layout: brand and social
    profiles at the left, plain link columns under bold headings, a centred
    Location band with a live map, then a quiet centred legal line. %>
<% facts = site_footer_facts %>
<%= render "footers/assets" %>
<footer class="ftr bg-surface-alt border-t border-subtle text-body" data-site-footer>
  <div class="max-w-6xl mx-auto px-4">
    <div class="ftr-cols py-16">
      <div class="ftr-brand">
        <%= link_to root_path, class: "inline-flex items-center gap-3" do %>
          <%= image_tag "logo-icon.svg", class: "w-12 h-12 invert dark:invert-0", alt: "" %>
          <span class="text-2xl font-extrabold text-heading uppercase leading-tight" style="letter-spacing: .14em;">McRitchie<br><span class="text-primary">Studio</span></span>
        <% end %>
        <p class="mt-6 text-secondary leading-relaxed"><%= facts[:tagline] %></p>
        <ul class="mt-8 flex items-center gap-3" aria-label="Social profiles">
          <% facts[:social].each do |label, icon, url| %>
            <li>
              <%= content_tag(url ? :a : :span,
                    render("footers/social_icon", icon: icon),
                    { class: "ftr-social", title: url ? label : "#{label} (handle needed)", "aria-label": label }
                      .merge(url ? { href: url, target: "_blank", rel: "noopener" } : { "data-pending": true })) %>
            </li>
          <% end %>
        </ul>
      </div>

      <% facts[:columns].each do |heading, links| %>
        <nav aria-label="<%= heading %>">
          <h2 class="font-bold text-heading mb-4"><%= heading %></h2>
          <ul class="space-y-4">
            <% links.each do |label, path| %>
              <%# An off-site link opens in a new tab; the visitor keeps the page. %>
              <li><%= link_to label, path, { class: "ftr-link" }.merge(path.start_with?("http") ? { target: "_blank", rel: "noopener" } : {}) %></li>
            <% end %>
          </ul>
        </nav>
      <% end %>
    </div>

    <div class="border-t border-subtle" style="padding-block: 3.5rem 2rem;">
      <h2 class="text-center text-3xl font-extrabold text-heading tracking-tight">Location</h2>
      <address class="not-italic text-center leading-relaxed" style="margin-top: 1rem;">
        <a href="<%= facts[:directions_url] %>" target="_blank" rel="noopener" class="ftr-link"
           aria-label="Get directions to <%= facts[:street] %>, <%= facts[:city_line] %>">
          <%= facts[:street] %><br><%= facts[:city_line] %>
        </a>
      </address>
    </div>
  </div>

  <%# Outside the centred column on purpose: the map runs edge to edge. %>
  <%= render "footers/map", facts: facts, classes: "ftr-map-wide border-t border-b border-subtle" %>

  <div class="max-w-6xl mx-auto px-4">
    <div class="py-8 text-center text-sm">
      <p>
        <% facts[:legal].each_with_index do |(label, path), index| %>
          <%= " · " unless index.zero? %><%= link_to label, path, class: "ftr-link" %>
        <% end %>
      </p>
      <p class="text-muted mt-2">© <%= Time.current.year %> <%= facts[:name] %></p>
    </div>
  </div>
</footer>
