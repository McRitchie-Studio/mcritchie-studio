<%# 3 · Terminal — the studio builds software, so the footer answers like a shell. %>
<footer class="ftr ftr-term bg-page border-t border-subtle text-body text-sm" data-footer="terminal">
  <div class="max-w-7xl mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-2 gap-8">
    <div class="ftr-term-window">
      <div class="ftr-term-bar text-muted">
        <i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i>
        <span class="ml-2">studio@denver — ~/contact</span>
      </div>
      <div class="p-5 space-y-5 leading-relaxed">
        <div>
          <p><span class="text-primary">$</span> whereis mcritchie-studio</p>
          <address class="not-italic text-heading pl-4">
            <%= facts[:street] %>, <%= facts[:city_line] %>
            <a href="<%= facts[:directions_url] %>" target="_blank" rel="noopener" class="ftr-link ml-1">[directions]</a>
          </address>
        </div>
        <div>
          <p><span class="text-primary">$</span> cat contact.yml</p>
          <dl class="pl-4 grid grid-cols-[5.5rem_1fr] gap-x-2">
            <dt class="text-muted">phone:</dt>
            <dd><a href="<%= facts[:phone_href] %>" class="ftr-link text-heading"><%= facts[:phone] %></a></dd>
            <dt class="text-muted">email:</dt>
            <dd><a href="mailto:<%= facts[:email] %>" class="ftr-link text-heading"><%= facts[:email] %></a></dd>
            <dt class="text-muted">hours:</dt>
            <dd class="text-heading"><%= facts[:hours] %></dd>
          </dl>
        </div>
        <div>
          <p><span class="text-primary">$</span> ls ./site ./legal</p>
          <ul class="pl-4 flex flex-wrap gap-x-5 gap-y-1">
            <% facts[:explore].each do |label, path| %>
              <li><%= link_to label.parameterize, path, class: "ftr-link text-heading" %></li>
            <% end %>
            <% facts[:legal].each do |label, path| %>
              <li><%= link_to "#{label.parameterize}.md", path, class: "ftr-link text-primary" %></li>
            <% end %>
          </ul>
        </div>
        <p><span class="text-primary">$</span> <span class="ftr-caret" aria-hidden="true"></span></p>
      </div>
    </div>

    <div class="ftr-term-window flex flex-col">
      <div class="ftr-term-bar text-muted">
        <i style="background:#ff5f57"></i><i style="background:#febc2e"></i><i style="background:#28c840"></i>
        <span class="ml-2">map — <%= facts[:lat].round(4) %>° N, <%= facts[:lng].abs.round(4) %>° W</span>
      </div>
      <%= render "footers/map", facts: facts, classes: "flex-1 min-h-64" %>
    </div>
  </div>

  <div class="border-t border-subtle">
    <p class="max-w-7xl mx-auto px-4 py-4 text-muted text-xs flex flex-wrap justify-between gap-2">
      <span>© <%= Time.current.year %> <%= facts[:name] %> · exit 0</span>
      <span>built in Denver, elevation 5,280 ft</span>
    </p>
  </div>
</footer>
