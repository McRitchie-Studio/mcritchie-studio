<%# locals: (task:, agents:, crew_board: :deploy, mascot: nil, type_enumerals: nil, latest_activity: nil, activity_count: 0, unresolved_feedback: nil, ever_blocked: nil, review_in_progress: nil) %>
<%#
  ONE board card. Extracted from _board so a single card can be re-rendered
  server-side and pushed over Turbo Streams (the "deployments" stream) for live
  board updates — the board loop passes its preloaded maps (mascot, latest_activity),
  while DeploymentsBroadcaster renders one card with per-task lookups. The markup
  is unchanged from the inline version; only the data source moved to locals
  (agents/mascot/latest_activity/activity_count instead of the board's @ivars).
%>
<%# Card tone tracks the block lifecycle (Task#block_state): red = blocked (an open
    QA block or the blocked stage), amber = a CLEARED block back in `submitted`
    awaiting re-review, plain otherwise. The board passes preloaded booleans; a
    single-card Turbo render falls back to per-task queries. %>
<% unresolved_feedback = local_assigns.key?(:unresolved_feedback) ? local_assigns[:unresolved_feedback] : task.unresolved_feedback_activity %>
<% review_in_progress = local_assigns.key?(:review_in_progress) ? local_assigns[:review_in_progress] : task.review_in_progress? %>
<% ever_blocked = local_assigns.key?(:ever_blocked) ? local_assigns[:ever_blocked] : nil %>
<% block_state = task.block_state(unresolved: unresolved_feedback.present?, ever_blocked: ever_blocked) %>
<% mascot_signature_color = mascot&.signature_color(type_enumerals).presence || task.devops["mascot_color"].presence %>
<% mascot_signature_color = nil unless mascot_signature_color.to_s.match?(/\A#[0-9a-f]{6}\z/i) %>
<% card_tone = case block_state
   when :blocked then "bg-red-50 border-red-200 hover:border-red-300 hover:bg-red-100/70 dark:bg-red-950/40 dark:border-red-800/60 dark:hover:border-red-600/70 dark:hover:bg-red-900/40"
   when :cleared then "bg-amber-50 border-amber-200 hover:border-amber-300 hover:bg-amber-100/70 dark:bg-amber-950/40 dark:border-amber-800/60 dark:hover:border-amber-600/70 dark:hover:bg-amber-900/40"
   else "bg-surface border-subtle hover:border-primary/40 hover:bg-surface-alt"
   end %>
<% card_glow_kind = if block_state == :blocked
     "blocked"
   elsif %w[submitted reviewed assembled].include?(task.stage)
     task.stage
   end %>
<% card_glow_classes = if card_glow_kind
     ["task-card-stage-glow", "task-card-stage-glow-#{card_glow_kind}", ("studio-border-glow" unless card_glow_kind == "blocked")].compact.join(" ")
   end %>
<% card_glow_color = case card_glow_kind
   when "blocked" then "#ef4444"
   when "submitted" then mascot_signature_color || "#22c55e"
   when "reviewed" then mascot_signature_color || "#22d3ee"
   when "assembled" then mascot_signature_color || "#a78bfa"
   else mascot_signature_color || "#f59e0b"
   end %>
<% card_glow_type_colors = if card_glow_kind == "assembled" && mascot && type_enumerals
     mascot.type_keys.filter_map { |type| type_enumerals[type]&.color.presence }
            .select { |color| color.to_s.match?(/\A#[0-9a-f]{6}\z/i) }
            .uniq
   else
     []
   end %>
<% card_glow_color_a = card_glow_type_colors.first || card_glow_color %>
<% card_glow_color_b = card_glow_type_colors.second || card_glow_color_a %>
<% card_glow_seed = if card_glow_kind && card_glow_kind != "blocked"
     task.slug.to_s.each_byte.reduce(0) { |memo, byte| ((memo * 33) + byte) % 10_000 }
   end %>
<% card_glow_motion_style = if card_glow_seed
     "--studio-border-glow-offset: #{card_glow_seed % 400}%; " \
       "--studio-border-glow-duration: #{18 + (card_glow_seed % 9)}s; " \
       "--studio-border-glow-angle: #{38 + (card_glow_seed % 18)}deg; "
   end %>
<% card_glow_border_mix = case card_glow_kind
   when "submitted" then 42
   when "reviewed" then 52
   when "assembled" then 58
   else 46
   end %>
<% card_glow_shadow = if card_glow_kind == "assembled"
     "0 0 0 1px color-mix(in srgb, var(--task-card-glow-color-a) 44%, transparent), " \
       "0 0 34px color-mix(in srgb, var(--task-card-glow-color-b) 38%, transparent), " \
       "0 0 82px color-mix(in srgb, var(--task-card-glow-color-a) 22%, transparent), " \
       "0 0 118px color-mix(in srgb, var(--task-card-glow-color-b) 12%, transparent)"
   elsif card_glow_kind == "reviewed"
     "0 0 0 1px color-mix(in srgb, var(--task-card-glow-color) 38%, transparent), " \
       "0 0 28px color-mix(in srgb, var(--task-card-glow-color) 30%, transparent), " \
       "0 0 64px color-mix(in srgb, var(--task-card-glow-color) 16%, transparent)"
   elsif card_glow_kind == "submitted"
     "0 0 0 1px color-mix(in srgb, var(--task-card-glow-color) 28%, transparent), " \
       "0 0 16px color-mix(in srgb, var(--task-card-glow-color) 20%, transparent), " \
       "0 0 36px color-mix(in srgb, var(--task-card-glow-color) 10%, transparent)"
   else
     "0 0 0 1px color-mix(in srgb, var(--task-card-glow-color) 34%, transparent), " \
       "0 0 22px color-mix(in srgb, var(--task-card-glow-color) 30%, transparent), " \
       "0 0 48px color-mix(in srgb, var(--task-card-glow-color) 14%, transparent)"
   end %>
<% card_glow_style = if card_glow_kind
     "#{card_glow_motion_style}" \
       "--task-card-glow-color: #{card_glow_color}; " \
       "--task-card-glow-color-a: #{card_glow_color_a}; " \
       "--task-card-glow-color-b: #{card_glow_color_b}; " \
       "--task-card-glow-border-color: color-mix(in srgb, var(--task-card-glow-color) #{card_glow_border_mix}%, transparent); " \
       "--task-card-glow-shadow: #{card_glow_shadow}; " \
       "border-color: var(--task-card-glow-border-color); " \
       "box-shadow: var(--task-card-glow-shadow);"
   end %>
<div id="card-<%= task.slug %>"
     data-slug="<%= task.slug %>"
     data-stage="<%= task.stage %>"
     data-agent="<%= task.agent_slug %>"
     data-apps="<%= task.devops_repositories.join(",") %>"
     data-href="<%= task_path(task.slug) %>"
     <% if card_glow_kind %>data-stage-glow="<%= card_glow_kind %>"<% end %>
     <%# Mascot's primary type colour — the live board tints its create/move glow with it. %>
     data-glow="<%= mascot_signature_color %>"
     x-data="{ hovered: false, mx: 0, my: 0 }"
     x-show="matchesFilter('<%= task.agent_slug %>') && appVisible('<%= task.devops_repositories.join(",") %>')"
     @mouseenter="hovered = true"
     @mouseleave="hovered = false"
     @mousedown="mx = $event.clientX; my = $event.clientY"
     @click="if (Math.abs($event.clientX - mx) < 6 && Math.abs($event.clientY - my) < 6 && !$event.target.closest('a, button')) window.location = $el.dataset.href"
     <% if card_glow_style %>style="<%= card_glow_style %>"<% end %>
     class="kanban-card relative <%= card_tone %> <%= card_glow_classes %> rounded-lg border p-3 cursor-pointer transition group">

  <%# Title — single-line overflow-fade: long names never wrap or break. They fade
      at the overflowing edge (mask-image) and marquee-scroll to the end while the
      card is hovered, snapping back on leave. Archive/delete live in the footer. %>
  <a href="<%= task_path(task.slug) %>"
     class="block mb-1.5 hover:text-primary transition"
     data-test="task-card-title"
     title="<%= task.title %>">
    <%= render "components/overflow_fade", text: task.title, scroll_when: "hovered",
          class: "text-heading font-semibold text-sm" %>
  </a>

  <%# Stage crew (agent-events summary) sits directly under the title — build-lane
      stages wear the task's mascot; deploy-lane shows who reviewed/assembled/
      shipped. Renders nothing when there are no events. %>
  <%= render "components/stage_agent_avatars", task: task, agents: agents, variant: :stack, board: crew_board, mascot: mascot %>

  <%# Slug (left) + affected-app emojis (right) now sits between the crew and
      footer timestamp. The slug fades on the right when it overflows
      (transparency mask, same as the footer) and the emojis sit OUTSIDE the fade
      as a normal flex item — no solid bg gradient, so nothing mismatches the card
      colour on hover. %>
  <div class="flex items-center gap-1 mt-0.5 mb-1.5" data-test="task-slug-row">
    <% if task.po_size.present? %>
      <span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-bold bg-surface-alt text-secondary border border-subtle" title="po_size (official planning size)" data-test="task-size-badge"><%= task.po_size == "xl" ? "XL" : task.po_size[0].upcase %></span>
    <% end %>
    <code class="block text-[10px] font-mono text-muted whitespace-nowrap overflow-hidden min-w-0 flex-1"
          style="<%= right_fade_style %>"><%= task.slug %></code>
    <%= app_emoji_badge(task.devops_repositories, css: "shrink-0 text-xs leading-none") %>
  </div>

  <%# Session resume + live cue live on the task READ view now (off the board
      cards). The board signals "live" via the pulsing crew time badge. %>

  <%# Planning badges (size / MIG / REL), right-aligned — only rendered when
      one is present, so the card never carries an empty meta row. The URG /
      HIGH priority badges and the assignee chip were dropped; the crew above
      and the stage attribute the rest. %>
  <% if task.requires_migration || task.requires_release_conductor? %>
    <div class="flex items-center justify-end gap-1 mb-1">
      <% if task.requires_migration %>
        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-orange-900/50 text-orange-300 border border-orange-700/50" title="Requires backend_migration lane">MIG</span>
      <% end %>
      <% if task.requires_release_conductor? %>
        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-orange-900/50 text-orange-300 border border-orange-700/50" title="Requires release_slug lane">REL</span>
      <% end %>
    </div>
  <% end %>

  <% if review_in_progress || unresolved_feedback || block_state == :cleared %>
    <div class="flex flex-wrap items-center gap-1 mb-1.5">
      <% if review_in_progress %>
        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-violet-900/50 text-violet-200 border border-violet-700/50"
              data-test="review-in-progress"
              title="Review has started; use a follow-up task for new changes.">REVIEW STARTED</span>
      <% end %>
      <% if unresolved_feedback %>
        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-900/60 text-red-200 border border-red-700/60"
              data-test="unresolved-feedback"
              title="<%= unresolved_feedback.description %>">UNRESOLVED QA</span>
      <% elsif block_state == :cleared %>
        <%# A prior QA block was resolved and the task is resubmitted — flag it so
            the reviewer knows to look again (pairs with the amber card tone). %>
        <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-amber-900/50 text-amber-200 border border-amber-700/50"
              data-test="cleared-feedback"
              title="A QA block was resolved — ready for another review.">RE-REVIEW</span>
      <% end %>
    </div>
  <% end %>

  <%# Secondary meta row — QA/Prod quick links, only when present. The release-slug
      badge was dropped from the card: it's pipeline plumbing, not useful at the
      board's high-level glance (it still shows on the task detail view). The kind/gem
      badges are gone too (features are implicit; bug/docs/gem surface as a footer
      emoji), and Local/PR moved down to the timestamp line. %>
  <% if task.devops? && (task.devops_url("qa") || task.devops_url("production")) %>
    <div class="flex flex-wrap items-center gap-x-2 gap-y-1 mb-1.5">
      <% if (qa_url = task.devops_url("qa")) %>
        <%= link_to "QA", qa_url, class: "text-[10px] text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
      <% end %>
      <% if (production_url = task.devops_url("production")) %>
        <%= link_to "Prod", production_url, class: "text-[10px] text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
      <% end %>
    </div>
  <% end %>

  <% if task.stage == 'failed' && task.error_message.present? %>
    <p class="text-xs text-red-700 dark:text-red-300 truncate mt-1"><%= task.error_message %></p>
  <% end %>

  <%# Footer meta line: Local + PR links + relative time on a SINGLE line that
      fades on the right when it overflows the column (mirrors the slug row, so
      the timestamp never wraps). The type emojis — gem (💎) then bug (🐛) /
      docs (📚) — sit OUTSIDE the fade so they stay crisp. Features stay unmarked. %>
  <div class="flex items-center gap-2 mt-1 text-[10px]">
    <div class="flex items-center gap-2 min-w-0 flex-1 whitespace-nowrap overflow-hidden"
         data-test="task-card-updated-row"
         style="<%= right_fade_style %>">
      <% if task.devops? && (local_url = task.devops_url("local")) %>
        <%= link_to "Local", local_url, class: "text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
      <% end %>
      <% if task.devops? && (pr_url = task.devops_url("pr")) %>
        <%= link_to "PR", pr_url, class: "text-primary hover:underline", target: "_blank", rel: "noopener", "@click.stop": true %>
      <% end %>
      <span class="text-muted"><%= time_ago_in_words(task.created_at) %> ago</span>
    </div>
    <% kind_emoji = { "bug" => "🐛", "docs" => "📚" }[task.devops_kind] %>
    <% if task.gem_release? || kind_emoji %>
      <span class="flex items-center gap-1.5 leading-none shrink-0">
        <% if task.gem_release? %>
          <span title="Gem release — published to RubyGems producer-first (before consuming apps)">💎</span>
        <% end %>
        <% if kind_emoji %>
          <span title="<%= task.devops_kind %> task"><%= kind_emoji %></span>
        <% end %>
      </span>
    <% end %>
  </div>

  <% if latest_activity %>
    <%# Activity note follows the slug + updated rows so status metadata stays grouped. %>
    <div class="mt-1 min-w-0 rounded-md border px-2 py-1 <%= task_activity_box_classes(latest_activity) %>"
         data-test="activity-box"
         data-activity-type="<%= latest_activity.activity_type %>">
      <div class="flex min-w-0 items-center gap-1.5 mb-0 leading-none">
        <span class="text-[9px] font-semibold uppercase tracking-wide text-heading"
              data-test="activity-type-label"
              title="<%= latest_activity.activity_type_description %>"><%= latest_activity.activity_type_label %></span>
        <% if activity_count.to_i > 1 %>
          <span class="text-[9px] text-muted normal-case tracking-normal"><%= activity_count %> notes</span>
        <% end %>
      </div>
      <%# Comment/notes preview — a single line that fades at its overflowing edge and
          marquee-scrolls to the end while the card is hovered (mirrors the title via the
          card-level Alpine `hovered`), snapping back on leave. The full note stays
          available through the title tooltip. %>
      <div class="mt-1 min-w-0" data-test="activity-description"
           title="<%= latest_activity.description %>">
        <%= render "components/overflow_fade", text: latest_activity.description,
              scroll_when: "hovered", class: "text-[11px] leading-snug text-secondary" %>
      </div>
    </div>
  <% end %>

  <%# Footer — archive + delete actions. Bleeds to the card edges with
      a slightly inset background; each tints on hover. @click.stop
      keeps them from triggering the card-open click (feature 2). %>
  <div class="-mx-3 -mb-3 mt-2 flex border-t border-subtle bg-inset/60 rounded-b-lg overflow-hidden">
    <% if task.stage != 'archived' %>
      <button type="button" @click.stop="archiveTask('<%= task.slug %>')"
              data-test="task-card-archive"
              class="flex-1 inline-flex items-center justify-center gap-1 px-2 py-1.5 text-[11px] font-medium text-muted hover:text-amber-700 hover:bg-amber-50 dark:hover:text-yellow-300 dark:hover:bg-yellow-900/20 transition" title="Archive">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
        </svg>
        <span>Archive</span>
      </button>
    <% end %>
    <button type="button" @click.stop="deleteTask('<%= task.slug %>')"
            data-test="task-card-delete"
            class="flex-1 inline-flex items-center justify-center gap-1 px-2 py-1.5 text-[11px] font-medium text-muted hover:text-red-700 hover:bg-red-50 dark:hover:text-red-300 dark:hover:bg-red-900/20 transition <%= 'border-l border-subtle' unless task.stage == 'archived' %>" title="Delete">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
      <span>Delete</span>
    </button>
  </div>
</div>
