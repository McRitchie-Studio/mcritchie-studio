<%# Who replaces this performer: an athlete in one of their looks, or keep as is. The operator's choice; editable after the cast is confirmed, and the prompts below follow. %>
<% athlete = performer.recast_person %>
<% recast_path = music_video_performer_recast_path(video, performer.ordinal) %>
<% looks_url = recast_athlete_looks_path("__slug__", format: :json) %>
<% sheet_row = local_assigns[:sheet_row] %>
<% sheet_ready = local_assigns[:sheet_ready] %>
<% state = if athlete then performer.recast? ? "recast" : "pending" elsif performer.recast_keep? then "keep" else "open" end %>
<div class="pt-3 border-t border-subtle min-w-0" data-test="performer-recast" data-state="<%= state %>">
  <p class="label-upper mb-1.5">Replaced by</p>
  <% if athlete %>
    <% choices = looks.fetch(athlete.slug, []) %>
    <div class="flex items-start justify-between gap-2 min-w-0">
      <p class="min-w-0 break-words font-semibold text-heading" data-test="recast-label"
         data-person="<%= performer.recast_person_slug %>" data-look="<%= performer.recast_appearance_slug %>"><%= performer.recast_label %></p>
      <%= button_to "Change", recast_path, method: :patch, params: { clear: "1" },
                    class: "btn btn-outline btn-sm shrink-0", form: { data: { test: "recast-clear" } } %>
    </div>
    <% if performer.recast_pending? && choices.any? %>
      <p class="text-sm text-warning-ink mt-1" data-test="recast-pending">No look chosen. Choose one of <%= athlete.full_name %>’s looks.</p>
    <% end %>
    <div x-data="lookPicker()" class="relative min-w-0" data-test="recast-looks" data-looks-url="<%= looks_url %>"
         data-saved-look="<%= performer.recast_appearance_slug %>"
         data-athlete="<%= { slug: athlete.slug, name: athlete.full_name, looks: choices.map(&:to_h) }.to_json %>">
      <%= render "music_videos/look_picker", performer: performer, video: video, sheet_row: sheet_row, sheet_ready: sheet_ready %>
    </div>
  <% elsif performer.recast_keep? %>
    <div class="flex items-center justify-between gap-2 min-w-0">
      <p class="text-sm text-muted" data-test="recast-keep">Kept as is: nobody replaces this person.</p>
      <%= button_to "Change", recast_path, method: :patch, params: { clear: "1" },
                    class: "btn btn-outline btn-sm shrink-0", form: { data: { test: "recast-clear" } } %>
    </div>
  <% else %>
    <div x-data="recastTypeahead()" data-search-url="<%= search_recast_athletes_path(format: :json) %>" data-looks-url="<%= looks_url %>"
         class="relative min-w-0" data-test="recast-typeahead">
      <div class="relative" @click.outside="open = false">
        <label class="sr-only" for="recast-search-<%= performer.ordinal %>">Who replaces <%= performer.name %>?</label>
        <input id="recast-search-<%= performer.ordinal %>" type="text" autocomplete="off" role="combobox"
               aria-autocomplete="list" :aria-expanded="open" aria-controls="recast-results-<%= performer.ordinal %>"
               placeholder="Search people by name"
               class="input-field py-2 text-sm" x-model="query" @input.debounce.250ms="search()"
               @keydown.arrow-down.prevent="move(1)" @keydown.arrow-up.prevent="move(-1)"
               @keydown.enter.prevent="pickActive()" @keydown.escape="open = false">

        <div x-show="open" x-cloak id="recast-results-<%= performer.ordinal %>" role="listbox"
             class="absolute z-30 left-0 right-0 mt-1 card shadow-lg max-h-80 overflow-y-auto p-1" data-test="recast-results">
          <template x-for="(r, i) in results" :key="r.slug">
            <%= render "music_videos/search_row", option_test: "recast-option", hint: "false",
                       badge: "r.hint",
                       badge_class: "r.looks.length ? 'bg-primary/10 text-primary border-primary/20' : 'bg-surface-alt text-secondary border-subtle'" %>
          </template>
          <p x-show="!loading && failed" class="px-3 py-2 text-sm text-warning-ink">Search failed. Try again.</p>
          <p x-show="!loading && !failed && results.length === 0" class="px-3 py-2 text-sm text-muted" data-test="recast-no-match">
            No person matches that name. Everyone we know is listed in
            <%= link_to "People", people_path, class: "text-primary hover:underline" %>.
          </p>
        </div>
      </div>
      <%= render "music_videos/look_picker", performer: performer, video: video, sheet_row: sheet_row, sheet_ready: sheet_ready %>
    </div>
    <%= button_to "Keep as is", recast_path, method: :patch, params: { keep: "1" },
                  class: "btn btn-outline btn-sm w-full mt-2", data: { test: "recast-keep-button" } %>
  <% end %>
</div>
