<%# A feature a card calls out (a `spotlight` row in config/workspace_packages.yml): its lead logo, its name and this tier's value, and the one-line promise. %>
<% value = feature.value_for(package.key) %>
<div class="mt-4 flex gap-2.5 rounded-xl border border-primary/30 bg-primary/5 p-3"
     data-test="package-spotlight" data-package="<%= package.key %>" data-feature="<%= feature.name.parameterize %>">
  <% if feature.brand? %>
    <%= render "packages/brand", key: feature.brand, size: :chip %>
  <% end %>
  <div class="min-w-0">
    <p class="text-sm font-semibold text-heading">
      <%= feature.name %><% if value.is_a?(String) %> <span class="font-normal text-muted">· <%= value %></span><% end %>
    </p>
    <p class="mt-0.5 text-xs text-body"><%= feature.spotlight %></p>
  </div>
</div>
