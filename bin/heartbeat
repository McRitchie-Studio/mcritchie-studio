#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/heartbeat <soul> --channel discord [--once] [--worker ID] [--dry-run]
#
# One soul's pass over the agent mailbox (docs/agents/system/agent-message-loop.md):
# claim the oldest message routed to <soul>, take the soul's ONE read-only action
# (avi: bin/release status; xan: bin/task list), answer with a headless Claude run
# that treats the message as untrusted data, and complete it so the reply posts
# back to Discord once. Drains what is waiting, or one message with --once.
# With nothing waiting it prints "nothing for <soul>" and exits 0.
#
#   --worker ID     the claim holder's id (default host-pid-random, unique per run)
#   --dry-run       peek instead of claim, and complete nothing; still runs the
#                   action and Claude so you can read the answer it would post
#   HEARTBEAT_CLAUDE_CMD  the Claude command, as a shell-split string (tests stub it)
#
# Exit: 0 done (answered or idle) · 1 a message was given back or the board refused · 2 usage.
require "shellwords"
require_relative "lib/agent_mailbox"

usage = "Usage: bin/heartbeat <soul> --channel discord [--once] [--worker ID] [--dry-run]"
args = ARGV.dup
soul = nil
opts = { channel: "discord", once: false, dry_run: false, worker: nil }
until args.empty?
  arg = args.shift
  case arg
  when "--channel" then opts[:channel] = args.shift.to_s
  when "--worker" then opts[:worker] = args.shift.to_s
  when "--once" then opts[:once] = true
  when "--dry-run" then opts[:dry_run] = true
  when "-h", "--help" then puts usage; exit 0
  else
    if arg.start_with?("-") || soul
      warn "bin/heartbeat: unknown argument #{arg}\n#{usage}"
      exit 2
    end
    soul = arg.strip.downcase
  end
end
if soul.nil? || soul.empty? || opts[:worker]&.empty?
  warn usage
  exit 2
end
unless opts[:channel] == "discord"
  warn "bin/heartbeat: only --channel discord exists today (got #{opts[:channel].inspect})"
  exit 2
end

cmd = ENV["HEARTBEAT_CLAUDE_CMD"].to_s.strip
claude_cmd = cmd.empty? ? AgentMailbox::Heartbeat::DEFAULT_CLAUDE_CMD : Shellwords.split(cmd)

heartbeat = AgentMailbox::Heartbeat.new(soul: soul, client: AgentMailbox::Client.new(soul: soul),
                                        channel: opts[:channel], once: opts[:once], worker: opts[:worker],
                                        dry_run: opts[:dry_run], claude_cmd: claude_cmd)
begin
  _answered, failed = heartbeat.run
  exit(failed ? 1 : 0)
rescue AgentMailbox::ApiError => e
  warn "bin/heartbeat: #{e.message}"
  exit 1
end
