<%# ONE soul heartbeat launcher — the avatar and the name (each LINKING to the soul's
    agent page, agent_path(slug), in a NEW TAB) with a column
    of copy chips: row 1 is the prompt-like soul heartbeat phrase (the rollup), then
    one row per ACTION the heartbeat groups. Each row is its own
    tasks/_workflow_copy_chip.

    TWO LAYOUTS:
      :slide   one soul filling the Workflows summary card's carousel frame
      :row     the Workflows SIDEBAR: avatar + name + purpose on the left, and each chip
               beside the one-line description of what it launches
               (ApplicationHelper::ACTION_DESCRIPTIONS) — room the sidebar has and a
               card cell never did.

    Locals:
      launcher  a heartbeat_launchers entry ({agent_slug, heartbeat, actions, label, title})
      soul      the Agent (optional; resolved from the slug when absent)
      actions   optional card-specific visual action order
      layout    :row (default) or :slide %>
<% launcher = local_assigns.fetch(:launcher) %>
<% soul = local_assigns[:soul] || Agent.find_by(slug: launcher[:agent_slug]) ||
          Agent.new(slug: launcher[:agent_slug], name: launcher[:agent_slug].titleize) %>
<% actions = local_assigns[:actions] || launcher[:actions] %>
<% layout = local_assigns.fetch(:layout, :row) %>
<%# A soul with no HEARTBEAT (the general Pokémon) renders its acts only. %>
<% rows = (launcher[:heartbeat].present? ? [["heartbeat", launcher[:heartbeat]]] : []) + actions.map { |a| ["action", a] } %>
<%# THE AGENT PAGE OPENS IN A NEW TAB. Agents is its own set of functions (Alex
    McRitchie, 2026-11-07): the operator reads a soul there without losing the board,
    the open sidebar or a half-turned wheel. A route helper, never a literal path, so
    the link follows wherever /agents is mounted. The avatar and the name are two links
    to one page; the avatar leaves the accessibility tree its duplicate (tabindex -1,
    aria-hidden), so a keyboard meets each soul's page once. %>
<% soul_name = soul.name.presence || launcher[:agent_slug].titleize %>
<% agent_href = agent_path(launcher[:agent_slug]) %>
<% avatar = capture do %>
  <%= link_to agent_href,
              class: "inline-flex shrink-0 rounded-full ring-2 ring-surface transition hover:ring-primary/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/60",
              title: launcher[:title],
              target: "_blank", rel: "noopener",
              tabindex: "-1", "aria-hidden": "true",
              data: { test: "heartbeat-avatar-link" } do %>
    <%= render "components/agent_avatar", agent: soul, size: "sm" %>
  <% end %>
<% end %>
<% name_link = capture do %>
  <%= link_to soul_name, agent_href,
              target: "_blank", rel: "noopener",
              class: "rounded-sm hover:text-primary hover:underline focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/60",
              title: "Open #{soul_name}'s agent page in a new tab",
              data: { test: "heartbeat-agent-link" } %>
<% end %>
<% if layout != :slide %>
  <div class="flex min-w-0 items-start gap-3"
       data-test="heartbeat-launcher"
       data-layout="row"
       data-agent="<%= launcher[:agent_slug] %>"
       data-heartbeat="<%= launcher[:heartbeat] %>">
    <%= avatar %>
    <div class="min-w-0 flex-1">
      <div class="flex items-baseline gap-2">
        <span class="text-sm font-semibold text-heading" data-test="heartbeat-soul-name"><%= name_link %></span>
        <span class="text-2xs text-muted"><%= launcher[:label] %></span>
      </div>
      <div class="mt-2 flex flex-col gap-1">
        <% rows.each_with_index do |(row_kind, text), row_index| %>
          <div class="grid grid-cols-[11rem_minmax(0,1fr)] items-center gap-2"
               data-test="heartbeat-copy-row"
               data-copy-row-index="<%= row_index + 1 %>">
            <%= render "tasks/workflow_copy_chip", text: text, row_kind: row_kind %>
            <% description = row_kind == "heartbeat" ? heartbeat_description(launcher) : action_description(text) %>
            <span class="truncate text-2xs text-muted" data-test="heartbeat-row-description"
                  title="<%= description %>"><%= description %></span>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% else %>
  <%# :slide — one soul filling the Workflows summary card's carousel frame. The name
      is spelled out because the card shows ONE soul at a time: a face alone would
      make the operator hover to learn who is up. The heartbeat chip spans the frame;
      the acts sit two to a line.

      TWO ACTS TO A LINE WAS MEASURED, not assumed: the card is narrowest at the xl
      breakpoint (1280px viewport, four cards → a 260px content box), which leaves each
      chip 128px and its text 98px, and the longest acts (`production-deploy`,
      `contest-rehearsal`, 17 characters) render 92px at 9px mono.
      test/system/workflows_card_chip_fit_test.rb re-measures it in a browser.

      ON THE TYPE SCALE the chip text is fine print, 10.5px on this dense page
      (task hub-adopts-type-scale), and the same acts measure ~107px: two to a line
      then needs an 18rem frame, which the 260px xl box is not. So the acts sit one
      to a line until the frame reaches 18rem (a container query on this frame),
      and two to a line from there. %>
  <div class="@container flex min-w-0 flex-col gap-2"
       data-test="heartbeat-launcher"
       data-layout="slide"
       data-agent="<%= launcher[:agent_slug] %>"
       data-heartbeat="<%= launcher[:heartbeat] %>">
    <div class="flex min-w-0 items-center gap-2">
      <%= avatar %>
      <div class="min-w-0">
        <div class="truncate text-sm font-semibold leading-tight text-heading" data-test="heartbeat-soul-name"><%= name_link %></div>
        <div class="truncate text-2xs leading-tight text-muted"><%= launcher[:label] %></div>
      </div>
    </div>
    <div class="grid min-w-0 grid-cols-1 gap-1 @[18rem]:grid-cols-2">
      <% rows.each_with_index do |(row_kind, text), row_index| %>
        <div class="min-w-0 <%= "@[18rem]:col-span-2" if row_kind == "heartbeat" %>"
             data-test="heartbeat-copy-row"
             data-copy-row-index="<%= row_index + 1 %>">
          <%= render "tasks/workflow_copy_chip", text: text, row_kind: row_kind %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
