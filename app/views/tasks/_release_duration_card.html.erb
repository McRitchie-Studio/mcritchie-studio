<% dashboard = local_assigns.fetch(:dashboard, nil) || {} %>
<% averages = dashboard["averages"] || {} %>
<% stage_averages = averages["stages"] || {} %>
<% deployment = averages["deployment"] || {} %>
<% sample_count = dashboard["sample_count"].to_i %>
<% card_class = ["rounded-xl border border-subtle bg-surface p-4", local_assigns[:card_class]].compact.join(" ") %>

<div id="release-duration-card" class="<%= card_class %>" data-test="release-duration-card">
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <span class="text-[11px] uppercase tracking-wide text-muted font-semibold">Release Times</span>
      <h3 class="mt-1 text-sm font-semibold text-heading">Last <%= dashboard["limit"] || 3 %> shipped releases</h3>
    </div>
    <%= link_to "All Deployments", all_deployments_path,
                class: "shrink-0 rounded bg-inset px-2 py-1 text-xs font-semibold text-secondary border border-subtle hover:text-heading" %>
  </div>

  <div class="mt-4 grid grid-cols-2 gap-2">
    <% Release::DurationCache::STAGE_DEFINITIONS.each_key do |key| %>
      <% row = stage_averages[key] || {} %>
      <div class="rounded-lg border border-subtle bg-inset px-3 py-2" data-test="release-duration-stage" data-stage="<%= key %>">
        <p class="text-[10px] uppercase tracking-wide text-muted font-semibold"><%= release_duration_stage_name(key) %></p>
        <p class="mt-1 font-mono text-lg font-bold text-heading tabular-nums"><%= release_duration_label(row["average_seconds"]) %></p>
        <p class="mt-1 text-[11px] text-muted"><%= row["sample_count"].to_i %> sample<%= "s" unless row["sample_count"].to_i == 1 %></p>
      </div>
    <% end %>
  </div>

  <div class="mt-3 rounded-lg border border-subtle bg-inset px-3 py-2" data-test="release-duration-deployment">
    <div class="flex items-center justify-between gap-3">
      <div>
        <p class="text-[10px] uppercase tracking-wide text-muted font-semibold">Deployment</p>
        <p class="mt-1 text-xs text-secondary">Release created → shipped</p>
      </div>
      <div class="text-right">
        <p class="font-mono text-lg font-bold text-heading tabular-nums"><%= release_duration_label(deployment["average_seconds"]) %></p>
        <p class="text-[11px] text-muted"><%= deployment["sample_count"].to_i %> release<%= "s" unless deployment["sample_count"].to_i == 1 %></p>
      </div>
    </div>
  </div>

  <% if sample_count.zero? %>
    <p class="mt-3 text-xs text-muted">No shipped releases have cached duration metrics yet.</p>
  <% end %>
</div>
