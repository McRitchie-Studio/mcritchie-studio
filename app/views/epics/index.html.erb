<%# /epics — every epic (the handle tasks carry in tasks.epic_slug), newest
    activity first, each with its tasks counted by stage and a done bar
    (EpicSummary.all, one grouped query). Read-only and public like the boards. %>
<% content_for(:title, "Epics") %>
<section class="space-y-6" data-test="epics-index">
  <% description = capture do %>
    Each epic with its tasks by stage and how much of it has shipped. Stamp a task
    with <code class="text-xs">bin/task update &lt;slug&gt; --epic &lt;epic-slug&gt;</code>.
  <% end %>
  <%= render "components/page_header", title: "Epics", description: description,
        sub_nav: { nav: :board_sections, current: :epics } %>
  <% if @epics.any? %>
    <ul class="space-y-3" data-test="epic-list">
      <% @epics.each do |epic| %>
        <%= render "epics/epic_row", epic: epic %>
      <% end %>
    </ul>
  <% else %>
    <p class="rounded-xl border border-dashed border-subtle p-6 text-sm text-muted" data-test="epics-empty">
      No task carries an epic yet.
    </p>
  <% end %>
</section>
