<section>
  <%# THE HEADER: the engine page header (docs/PAGE_HEADER.md). The old back links are the
      crumb trail (Admin, Deployments, the task); the Review Hub is a page elsewhere, in
      the Links menu; the stage and the slug are meta, with a phone copy below, since the
      engine hides the meta under 40rem. %>
  <% review_meta = capture do %>
    <span class="inline-flex flex-wrap items-center gap-2 normal-case tracking-normal" data-test="review-events-meta">
      <%= render "components/badge", text: @task.stage.humanize, scheme: stage_scheme(@task.stage) %>
      <span class="text-xs text-muted font-mono"><%= @task.slug %></span>
    </span>
  <% end %>
  <%= render "studio/page_header", title: "Review activity",
        crumbs: studio_crumbs(parent: :task, task: @task),
        meta: review_meta,
        menu: [{ label: "Review Hub", href: review_events_hub_path, data: { test: "review-events-link-hub" } }] %>
  <div class="sm:hidden mt-2"><%= review_meta %></div>
  <div class="mb-6"></div>

  <div class="card p-6">
    <p class="mb-5 max-w-3xl text-sm text-muted">
      Heavy and light reviewer check-ins are recorded as append-only review activity, so long-running reviews show their actual progress instead of only a final stage move.
    </p>

    <% lanes = review_event_lanes(@task, @agents, @review_events, process: @review_process) %>
    <div class="grid grid-cols-1 gap-4 xl:grid-cols-2" data-test="review-events-grid">
      <% lanes.each do |lane| %>
        <%= render "tasks/review_event_lane", lane: lane %>
      <% end %>
    </div>

    <div class="mt-5 rounded-lg border border-subtle bg-surface-alt p-3" data-test="review-api-contract">
      <p class="label-upper">Broadcast API</p>
      <code class="mt-2 block break-all rounded bg-surface px-3 py-2 text-xs text-secondary">POST /api/v1/tasks/<%= @task.slug %>/review_events</code>
      <p class="mt-2 text-xs text-muted">Roles accept <code>primary</code>, <code>light</code>, and the legacy <code>heavy_review</code>/<code>light_review</code> aliases. Completed and failed review check-ins include usage.</p>
    </div>
  </div>

  <%= render "tasks/review_pipeline_tasks", snapshots_by_stage: @review_pipeline_tasks %>
</section>
