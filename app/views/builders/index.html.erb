<% content_for :title, "Builders · McRitchie Studio" %>

<section class="space-y-6" x-data="{ selectedBuilder: null }">
  <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
    <div>
      <p class="text-sm font-semibold text-primary uppercase tracking-wider">Public Build Velocity</p>
      <h2 class="text-3xl font-bold text-heading mt-1"><%= @language.present? ? "#{@language} Builder Roster" : "Builder Roster" %></h2>
      <p class="text-secondary mt-2 max-w-3xl">
        Public GitHub commit pace for seeded and monitored builders.
      </p>
    </div>
    <div class="text-sm text-muted md:text-right">
      <p><%= builder_count(@builder_rows.size) %> included builders</p>
      <% if @ranges.any? %>
        <p>Trailing <%= @ranges.size %> cached Saturday-Friday UTC ranges</p>
      <% end %>
    </div>
  </div>

  <section class="card overflow-hidden">
    <div class="p-5 border-b border-subtle">
      <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between">
        <div>
          <h3 class="text-lg font-bold text-heading">Roster</h3>
          <p class="text-sm text-secondary">Avatar, GitHub identity, location, and recent public commit pace.</p>
        </div>
        <div class="flex flex-wrap gap-2">
          <%= link_to "All Builders", all_builders_path(language: @language), class: "btn btn-outline btn-sm" %>
          <%= link_to "Five-Year History", history_builders_path(language: @language), class: "btn btn-outline btn-sm" %>
          <%= link_to "AI Builder Multiple", admin_ai_builder_multiple_path(builder_limit: 1_000, anchor: "commit-log"), class: "btn btn-outline btn-sm" %>
        </div>
      </div>
    </div>

    <% if @builder_rows.any? %>
      <div class="overflow-x-auto">
        <table class="builders-sticky-table w-full table-fixed text-sm">
          <colgroup>
            <col>
            <col style="width: 100px;">
            <col style="width: 92px;">
            <% @ranges.each do |_range| %>
              <col style="width: 88px;">
            <% end %>
          </colgroup>
          <thead>
            <tr class="bg-surface-alt text-xs text-muted uppercase tracking-wider">
              <th class="sticky left-0 z-10 bg-surface-alt text-left py-3 px-4">Builder</th>
              <th class="text-left py-3 px-3" style="width: 100px; max-width: 100px;">Location</th>
              <th class="text-right py-3 px-3" title="Total commits across the displayed cached ranges">
                <span>Total</span>
                <span class="block text-[10px] text-muted normal-case tracking-normal"><%= @ranges.size %> weeks</span>
              </th>
              <% @ranges.each do |range| %>
                <th class="text-right py-3 px-3" title="<%= range.display_label %>">
                  <%= builder_week_header(range) %>
                </th>
              <% end %>
            </tr>
          </thead>
          <tbody class="divide-y divide-subtle">
            <% @builder_rows.each do |row| %>
              <% builder = row[:builder] %>
              <% person = builder.person %>
              <tr class="hover:bg-surface-alt/60 transition">
                <td class="sticky left-0 z-10 bg-surface py-3 px-4">
                  <div class="flex items-center gap-3">
                    <% if builder.avatar_url.present? %>
                      <img src="<%= builder.avatar_url %>"
                           alt="<%= builder.display_name %>"
                           loading="lazy"
                           class="w-12 h-12 rounded-full object-cover bg-surface-alt flex-shrink-0">
                    <% else %>
                      <div class="w-12 h-12 rounded-full bg-surface-alt flex items-center justify-center flex-shrink-0 text-secondary text-sm font-semibold">
                        <%= builder_initials(builder) %>
                      </div>
                    <% end %>
                    <div class="min-w-0">
                      <button type="button"
                              class="group block max-w-full text-left"
                              @click.stop='selectedBuilder = <%= {
                                name: builder.display_name,
                                login: builder.github_login,
                                githubUrl: builder.github_url,
                                cachedWeeks: @ranges.size.to_s,
                                archivePath: archive_builder_path(builder.github_login, redirect_to: request.fullpath)
                              }.to_json %>'>
                        <span class="block font-semibold text-heading truncate group-hover:text-primary transition"><%= builder.display_name %></span>
                      </button>
                      <div class="flex flex-wrap items-center gap-2 mt-0.5">
                        <%= link_to "@#{builder.github_login}",
                              builder.github_url,
                              target: "_blank",
                              rel: "noopener",
                              class: "text-xs text-primary hover:text-heading transition" %>
                        <% if person.website_url.present? %>
                          <%= link_to "Website", person.website_url, target: "_blank", rel: "noopener", class: "text-xs text-secondary hover:text-heading transition" %>
                        <% end %>
                        <% if person.x_url.present? %>
                          <%= link_to "X", person.x_url, target: "_blank", rel: "noopener", class: "text-xs text-secondary hover:text-heading transition" %>
                        <% end %>
                      </div>
                    </div>
                  </div>
                </td>
                <td class="py-3 px-3 text-secondary" style="width: 100px; max-width: 100px;" title="<%= person.location.presence || "No location" %>">
                  <span style="display: block; width: 100px; max-width: 100px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"><%= person.location.presence || "—" %></span>
                </td>
                <td class="py-3 px-3 text-right font-semibold text-heading"
                    title="Total commits across the displayed cached ranges">
                  <%= builder_count(row[:trailing_commits_count]) %>
                </td>
                <% @ranges.each do |range| %>
                  <% cache = row[:caches_by_range_id][range.id] %>
                  <% count = cache&.commits_count %>
                  <% normalized_score = cache ? @normalized_scores_by_cache_id[cache.id] : nil %>
                  <td class="py-3 px-3 text-right <%= count.to_i.positive? ? "font-semibold text-heading" : "text-muted" %>"
                      title="<%= cache ? "#{builder_count(cache.non_merge_commits_count)} non-merge, #{builder_count(cache.bot_adjusted_commits_count)} bot-adjusted" : "No cached row" %>">
                    <% if cache %>
                      <span><%= builder_count(count) %></span>
                      <%= builder_normalized_score_badge(normalized_score) %>
                    <% else %>
                      —
                    <% end %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <div class="p-5">
        <div class="empty-state">
          <p class="text-secondary">Import Ruby builders to populate this roster.</p>
        </div>
      </div>
    <% end %>
  </section>

  <%= render "archive_modal" %>
</section>
