<%# /tasks — Workflow 1 (Build lane): designed → building → submitted (+ an Archived
    toggle). Rebased onto the studio/board ENGINE PRIMITIVE (studio/board/_board):
    the primitive's `studioBoard` factory (studio/_board_assets, homed in the layout)
    owns drag / cross-column move (PATCH) / reorder (POST) / live Turbo-stream updates /
    counts / toasts, driving the VENDORED SortableJS (no CDN). This partial owns only
    what the neutral primitive deliberately doesn't: the header + app-filter chrome and
    the per-card archive / delete / filter behavior, in the OUTER `taskBoardChrome`
    Alpine component. The task cards render INSIDE the primitive's `studioBoard` scope
    but resolve `matchesFilter` / `appVisible` / `archiveTask` / `deleteTask` from THIS
    parent scope (Alpine nests scopes), so the card partial is unchanged.

    Locals: stages, title, archived:, current_page:, live_updates: (default true). %>
<% title        = local_assigns.fetch(:title, "Tasks") %>
<% archived     = local_assigns.fetch(:archived, false) %>
<% current_page = local_assigns.fetch(:current_page, "tasks") %>
<% stages       = local_assigns.fetch(:stages, Task::TASKS_BOARD_STAGES) %>
<% live_updates = local_assigns.fetch(:live_updates, true) %>
<%# Archived is a toggle-hidden column (drag-to-archive target), shown via showArchived. %>
<% column_keys = archived ? (stages + ["archived"]) : stages %>
<%# Mascot + type-colour maps built once — the 151 are tiny, so one query beats an
    N+1 across cards (each card's data-glow is then a hash lookup). %>
<% pokemon_by_slug = Pokemon.all.index_by(&:slug) %>
<% type_enumerals  = Pokemon.type_enumerals %>
<%# Build board (/tasks) → :build crew; the shared card partial reads it. %>
<% crew_board = stages.include?("reviewed") ? :deploy : :build %>
<%# App-filter chips are built from the repos actually present on the board. %>
<% board_apps = (@tasks_by_stage&.values&.flatten || []).flat_map(&:devops_repositories).uniq.sort %>

<%# taskBoardChrome — the app-specific board superset. Defined inline (before the
    deferred Alpine CDN evaluates x-data), OUTSIDE the primitive's cloned component
    subtree so it actually runs. Drag/move/reorder/live/toast-host/counts are the
    primitive's; this owns filters + archive/delete, delegating the shared bits
    (toast host, count refresh, exit animation) back to the inner studioBoard via
    Alpine.$data so there is ONE toast host and one animation path. %>
<script>
function taskBoardChrome() {
  return {
    agentFilter: '',
    hiddenApps: [],
    showArchived: false,
    _pending: {},
    stageLabels: <%= raw Task::STAGE_LABELS.to_json %>,

    init() {
      // $nextTick, not synchronous: x-init runs mid directive-walk, so the filter
      // chips' @click aren't bound yet here. The flag then means "interactive".
      // This parent inits before the inner studioBoard, so installing the archive
      // exit-stream handler here claims the primitive's fallback flag first.
      this.$nextTick(() => {
        this.installArchiveExitStream();
        this.markReadyWhenBoardLive();
      });
    },

    // The ready flag must mean the WHOLE composition is interactive, not just this
    // chrome. The CARDS live inside the inner studio/board primitive, and (per the
    // note above) this parent inits BEFORE it — so a flag stamped on our own
    // $nextTick can read true while a card's
    // x-show="matchesFilter(...) && appVisible(...)" has not been bound yet. A
    // click landing in that window mutates hiddenApps with nothing listening and
    // the card never hides. That is a CI-only race — a fast machine clicks inside
    // the window, a slower one never sees it — and it failed the board-filter e2e
    // three times across two unrelated PRs while passing every local run.
    //
    // So hold the flag until Alpine.$data resolves on the inner section, then give
    // the walk one more frame: $data appears when the primitive's component is set
    // up, which is the START of its init, not the end of its child walk.
    markReadyWhenBoardLive(attempt = 0) {
      // Bail out rather than never stamping: a chrome rendered without the inner
      // primitive still has to become "ready", or everything gating on the flag
      // waits forever. ~100 frames is far longer than a real init.
      if (!this.boardData() && attempt < 100) {
        requestAnimationFrame(() => this.markReadyWhenBoardLive(attempt + 1));
        return;
      }
      this.$nextTick(() => { this.$el.dataset.alpineReady = 'true'; });
    },

    // Own the archive exit STREAM. A stage→archived change broadcasts a Turbo
    // `remove` for the card; the neutral primitive's fallback would DELETE it, but
    // this board has an archived COLUMN, so an archived card must RE-PARENT there
    // (visible under the Archived toggle). Claim the primitive's guard flag (parent
    // inits first) so only this handler runs. A plain delete `remove` carries no
    // exit-action and falls through to Turbo's default (gone for good).
    installArchiveExitStream() {
      if (window.__studioBoardExitFallback) return;
      window.__studioBoardExitFallback = true;
      const self = this;
      document.addEventListener('turbo:before-stream-render', (event) => {
        const stream = event.target;
        if (stream.getAttribute('action') !== 'remove') return;
        const target = stream.getAttribute('target') || '';
        if (target.indexOf('card-') !== 0 || stream.dataset.exitAction !== 'archive') return;
        const renderNow = event.detail.render;
        event.detail.render = async (el) => {
          const card = document.getElementById(target);
          if (!card) { renderNow(el); return; }
          await self.boardExit(card, 'archive');
          const archivedZone = document.getElementById('dropzone-archived');
          if (archivedZone) {
            archivedZone.insertBefore(card, archivedZone.querySelector('.kanban-empty'));
            card.dataset.stage = 'archived';
            self.resetCardExit(card);
            self.boardRefreshCounts();
            return; // keep the card in the archived column — do NOT remove it
          }
          renderNow(el);
          self.boardRefreshCounts();
        };
      });
    },

    // --- filters (card x-show resolves these from this parent scope) ----------
    matchesFilter(agent) { return !this.agentFilter || agent === this.agentFilter; },
    toggleApp(app) {
      const i = this.hiddenApps.indexOf(app);
      if (i === -1) { this.hiddenApps.push(app); } else { this.hiddenApps.splice(i, 1); }
    },
    appHidden(app) { return this.hiddenApps.includes(app); },
    appVisible(csv) {
      if (!csv) return true; // a task with no mapped repo always shows
      return !csv.split(',').some(a => this.hiddenApps.includes(a));
    },

    // --- reach into the inner studio/board primitive (single source of truth) --
    boardData() {
      const section = this.$el.querySelector('[data-test="studio-board"]');
      return (section && window.Alpine && window.Alpine.$data) ? window.Alpine.$data(section) : null;
    },
    boardToast(msg, type) {
      const d = this.boardData();
      if (d && d.toast) { d.toast(msg, type); return; }
      if (type === 'error' && typeof window.alert === 'function') window.alert(msg);
    },
    boardRefreshCounts() { const d = this.boardData(); if (d && d.updateCounts) d.updateCounts(); },
    async boardExit(card, kind) {
      // Mark WHICH exit is running (archive vs delete) as an observable data-attr,
      // then defer the animation itself to the primitive's animateCardExit.
      if (card) card.dataset.exitAction = kind;
      const d = this.boardData();
      if (card && d && d.animateCardExit) await d.animateCardExit(card, kind);
    },
    resetCardExit(card) {
      if (!card) return;
      card.getAnimations({ subtree: false }).forEach((a) => a.cancel());
      delete card.dataset.exitAction;
      card.style.opacity = ''; card.style.transform = ''; card.style.filter = ''; card.style.pointerEvents = '';
    },
    responseError(resp, fallback) {
      return resp.json().then((err) => new Error(err.error || fallback)).catch(() => new Error(fallback));
    },

    // --- per-card archive / delete (app writes the primitive stays neutral on) -
    async archiveTask(slug) {
      if (this._pending[slug]) return;
      this._pending[slug] = true;
      const card = document.getElementById('card-' + slug);
      try {
        await this.boardExit(card, 'archive');
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/tasks/' + slug + '.json', {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json', 'Accept': 'application/json', 'X-CSRF-Token': csrf },
          body: JSON.stringify({ task: { stage: 'archived' } })
        });
        if (!resp.ok) throw await this.responseError(resp, 'Archive failed');
        const updated = await resp.json().catch(() => null);
        if (!updated || updated.stage !== 'archived') throw new Error('Archive failed');
        if (card) {
          const archivedZone = document.getElementById('dropzone-archived');
          if (archivedZone) {
            archivedZone.insertBefore(card, archivedZone.querySelector('.kanban-empty'));
            card.dataset.stage = 'archived';
            this.resetCardExit(card);
          } else {
            card.remove();
          }
          this.boardRefreshCounts();
        }
        this.boardToast('Task archived', 'success');
      } catch (err) {
        this.resetCardExit(card);
        this.boardToast(err.message || 'Archive failed', 'error');
      } finally {
        delete this._pending[slug];
      }
    },

    async deleteTask(slug) {
      if (!confirm('Delete this task?')) return;
      if (this._pending[slug]) return;
      this._pending[slug] = true;
      const card = document.getElementById('card-' + slug);
      try {
        await this.boardExit(card, 'delete');
        const csrf = document.querySelector('meta[name="csrf-token"]')?.content;
        const resp = await fetch('/tasks/' + slug + '.json', {
          method: 'DELETE',
          headers: { 'Accept': 'application/json', 'X-CSRF-Token': csrf }
        });
        if (resp.status !== 204) throw await this.responseError(resp, 'Delete failed');
        if (card) { card.remove(); this.boardRefreshCounts(); }
        this.boardToast('Task deleted', 'success');
      } catch (err) {
        this.resetCardExit(card);
        this.boardToast(err.message || 'Delete failed', 'error');
      } finally {
        delete this._pending[slug];
      }
    }
  }
}
</script>

<section x-data="taskBoardChrome()" data-test="kanban-board"
         class="min-h-screen tasks-board-hide-archived"
         :class="{ 'tasks-board-hide-archived': !showArchived }">
  <%# FOUC-safe archived hide: the static class hides the archived column before
      Alpine boots; :class then hands control to showArchived (no flash). The
      primitive column carries data-board-column="archived". %>
  <style>.tasks-board-hide-archived [data-board-column="archived"]{display:none}</style>

  <%# TEST-ONLY board hook: hands the Playwright e2e suite a signed API token so a
      spec can POST /api/v1/tasks and drive real board behavior. Gated to the test
      env — never rendered in development or production. %>
  <% if Rails.env.test? %>
    <meta name="e2e-api-token" content="<%= Rails.application.message_verifier("api_auth").generate("test", purpose: :api_auth) %>">
  <% end %>

  <!-- Header — Dashboard/Stages links above the title; the Tasks/Deployments
       toggle (page_nav) switches boards; New Task / Archived on the far right. -->
  <div class="mb-6">
    <%= render "board_top_links", current: current_page %>
    <div class="flex items-center gap-4 flex-wrap">
      <h2 class="text-2xl font-bold text-heading"><%= title %></h2>
      <%= render "page_nav", current: current_page %>
      <div class="flex w-full items-center gap-2 flex-wrap sm:ml-auto sm:w-auto sm:justify-end" data-test="board-header-actions">
        <% if archived %>
          <button @click="showArchived = !showArchived"
                  :class="showArchived ? 'bg-primary text-white' : 'bg-surface text-secondary border border-subtle hover:text-heading'"
                  class="px-3 py-1.5 rounded-lg text-sm font-medium transition">
            Archived
          </button>
        <% end %>
        <% if logged_in? %>
          <%= link_to "New Task", new_task_path, class: "btn btn-primary" %>
        <% end %>
        <% if Rails.env.local? %>
          <%# Local-only progression testers (self-contained Alpine components). %>
          <%= render "dev_board_tools" %>
          <%= render "dev_deploy_tools" %>
        <% end %>
      </div>
    </div>
  </div>

  <%# App filter — toggle a repo to hide all its cards (client-side, resets on
      reload). Built from the repos present on the board. %>
  <% if board_apps.any? %>
    <div class="flex flex-wrap items-center gap-2 mb-4" data-test="board-filter-row">
      <span class="text-xs font-semibold uppercase tracking-wider text-muted mr-1">Apps</span>
      <% board_apps.each do |app| %>
        <button type="button"
                @click="toggleApp('<%= app %>')"
                :class="appHidden('<%= app %>') ? 'opacity-40 line-through' : 'hover:border-primary/40 hover:text-heading'"
                class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg text-xs font-medium bg-surface text-secondary border border-subtle transition">
          <% if (emoji = app_emoji(app)) %><span class="leading-none"><%= emoji %></span><% end %>
          <span><%= app %></span>
        </button>
      <% end %>
    </div>
  <% end %>

  <%# The board — rendered by the engine primitive. Columns are the stage keys
      (+ archived); each card is tasks/_task_card, bound to :task with the same
      preloaded per-card locals the board loop always passed. A cross-column drop
      PATCHes { task: { stage } } (the update action); a reorder POSTs the DOM-
      ordered slugs to the shared reorder action. %>
  <%= render "studio/board/board",
        columns: column_keys.map { |stage|
          {
            key: stage,
            label: Task::STAGE_LABELS.fetch(stage),
            cards: Task.board_column_tasks(@tasks_by_stage, stage)
          }
        },
        card_partial: "tasks/task_card",
        card_as: :task,
        card_locals: ->(task) {
          {
            agents: @agents, crew_board: crew_board,
            mascot: pokemon_by_slug[task.devops_field("mascot")], type_enumerals: type_enumerals,
            latest_activity: @latest_task_activities[task.slug],
            activity_count: @task_activity_counts[task.slug].to_i,
            unresolved_feedback: @unresolved_feedback_activities[task.slug],
            ever_blocked: @ever_blocked_slugs&.include?(task.slug),
            ci_progress: @ci_progress_by_slug&.fetch(task.slug, nil),
            review_in_progress: task.review_in_progress?
          }
        },
        reorder_url: reorder_tasks_path(format: :json),
        reorder_payload: :slugs,
        move_url: "/tasks/:id.json",
        move_param: { resource: :task, attr: :stage },
        group: "kanban",
        id_attr: "slug",
        zone_attr: "stage",
        live_channel: (live_updates ? "deployments" : nil),
        toasts: true,
        empty_label: "Drop tasks here" %>
</section>
