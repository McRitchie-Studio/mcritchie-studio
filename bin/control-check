#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/control-check <task-slug> — EXECUTE the `test-only` shape's control.
#
# The control asks "does the changed test still bite?". Until now bin/dor-check
# only checked that an author had WRITTEN one (a `[control]` line naming a file in
# the diff) — structure, not execution, which is a declaration standing in for
# evidence. This runner performs the half that can be performed, and stamps a
# fingerprint-bound `[control@<fp>]` line the gate re-grades.
#
# WHAT IT DOES
#
#   1. Reads the committed diff (base...HEAD) with rename detection, and splits it
#      (ControlReplay.partition) into replayable / deferred / added.
#   2. Runs the changed test files AS THEY ARE in this tree.
#   3. Cuts a THROWAWAY worktree at the merge base and runs the replayable files
#      THERE. Sound only because `test-only` already proved the diff is 100% test
#      code, so production code at the merge base is identical to production code
#      at HEAD: the throwaway tree IS the parent state.
#   4. Removes the throwaway worktree and stamps the verdict.
#
# NOTHING IS SWAPPED OR RESTORED, BY CONSTRUCTION (guard catalog row 1.1). The
# harness used to overwrite the desk's test files with their pre-change blobs and
# check them out again, which needed three refusals: a dirty tree it would clobber,
# a swap that did not land (the `sed -i ''` lesson), and a restore-back that leaked.
# git writes the pre-change files itself in the throwaway tree, and the desk is
# never written, so none of those states can exist.
#
# WHAT IT DOES NOT DO: refuse on the verdict. `old GREEN` (NO-SIGNAL) is reported,
# never refused — see bin/lib/control_replay.rb's header for why a rename, a move,
# a consolidation and a deleted assertion are indistinguishable here, and why a
# false refusal on legitimate work would cost more than this gate collects.
#
# THE SENTENCE TRAVELS IN THE STAMP (guard catalog row 1.4). A NO-SIGNAL replay needs
# the author's sentence saying which of those it is. `--why "<sentence>"` writes it
# INTO the stamp, and a NO-SIGNAL run without one stamps nothing and asks for it, so
# a NO-SIGNAL stamp without a sentence never exists and bin/dor-check never checks
# for one. With nothing to replay (an added file, an e2e/ spec), `--why` records the
# author's `[control]` line itself, naming this diff's files, so that line always
# names a file from the diff.
#
# ENV SEAMS (tests):
#   CONTROL_CHECK_ROOT          repo root (default: cwd's git toplevel via RepoRoot)
#   CONTROL_CHECK_TASK_BIN      board CLI (default: bin/task)
#   CONTROL_CHECK_DIFF_BASE     diff base (default: origin/accepted → release → main)
#   CONTROL_CHECK_TEST_CMD      test runner prefix (default: bin/rails test)
#   CONTROL_CHECK_PREPARE_CMD   db/asset prep (default: bin/rails db:test:prepare test:prepare)
#   CONTROL_CHECK_SKIP_PREPARE  set to skip the prepare lane

require "English"
require "fileutils"
require "shellwords"
require "tmpdir"
require_relative "lib/cli_arg_guard"
require_relative "lib/repo_root"
require_relative "lib/fast_cert"
require_relative "lib/tree_fingerprint"
require_relative "lib/control_replay"
require_relative "lib/board_checks"
require_relative "lib/task_tree"

ROOT = File.expand_path("..", __dir__)
TASK_BIN = ENV.fetch("CONTROL_CHECK_TASK_BIN", File.expand_path("task", __dir__))

def die(msg)
  warn "control-check: #{msg}"
  exit 1
end

def note(msg)
  puts "control-check: #{msg}"
end

def git(root, *args)
  IO.popen(["git", "-C", root.to_s, *args], err: File::NULL, &:read).to_s
rescue SystemCallError
  ""
end

def git_ok?(root, *args)
  system("git", "-C", root.to_s, *args, out: File::NULL, err: File::NULL)
rescue SystemCallError
  false
end

# Send ONLY the line this runner owns and let the write funnel merge it against
# the board's current state (lib/cert_evidence.rb): a stale snapshot resent
# wholesale is what wiped newer tier lines.
def record_line!(slug, line)
  if BoardChecks.fetch(TASK_BIN, slug).nil?
    warn "control-check: ran, but couldn't read #{slug.inspect}'s checks_run (bin/task show), so the write " \
         "cannot be verified. Not writing. Re-run, or record by hand: bin/task update #{slug} " \
         "--checks #{Shellwords.escape(line)}"
    exit 1
  end

  unless system(TASK_BIN, "update", slug, "--checks", line, out: File::NULL, err: File::NULL)
    warn "control-check: ran, but FAILED to record evidence on #{slug.inspect} (bin/task update). Re-run, " \
         "or record by hand: bin/task update #{slug} --checks #{Shellwords.escape(line)}"
    exit 1
  end

  missing = BoardChecks.missing_after_write(TASK_BIN, slug, [line])
  if missing && !missing.empty?
    warn "control-check: bin/task update returned success but the control line is NOT on #{slug.inspect}. " \
         "Verify: bin/task show #{slug} -v, then record by hand: bin/task update #{slug} " \
         "--checks #{Shellwords.escape(line)}"
    exit 1
  end

  note "recorded: #{line}"
end

USAGE = <<~TXT
  usage: bin/control-check <task-slug> [--why "<sentence>"]

    Execute the `test-only` shape's control: run the changed test files at HEAD,
    then run their PRE-CHANGE content, and stamp the verdict.

    --why "<s>"   the author's sentence: which of rename/move/consolidation/… a
                  NO-SIGNAL replay is (required to stamp NO-SIGNAL), or, with
                  nothing to replay, the control you ran by hand (recorded as the
                  [control] line, naming this diff's files)
    --help, -h    this text — REPLAYS NOTHING

  Takes exactly one task slug. The pre-change files run in a
  throwaway worktree cut at the merge base; this tree is never written.
TXT

# EVERY ARGUMENT IS ACCOUNTED FOR BEFORE THE HARNESS RUNS.
#
# `slug = ARGV.shift` accepted ANY non-empty token, and only an empty one was
# refused. So `bin/control-check --help` took "--help" as the task slug and ran the
# replay harness for real: it prepared the test database and ran the replay.
#
# Same defect class that cost bin/archive-docs a docs ledger on 2026-08-31.
ARGS = CliArgGuard.guard!(
  ARGV,
  program: "control-check",
  usage: USAGE,
  allow_positional: true,
  value: ["--why"],
  help_exit: 0,
  consequence: "NOTHING was replayed — the tree was not touched and no verdict was stamped."
)
die "usage: bin/control-check <task-slug>" unless ARGS.positionals.size == 1

slug = ARGS.positionals.first
why = ARGS.first("--why").to_s.strip

root = RepoRoot.code_root(ENV["CONTROL_CHECK_ROOT"], ROOT)
die "#{root} is not a git repo — the control replays committed content, so it needs one" unless
  git_ok?(root, "rev-parse", "--git-dir")

base = ENV["CONTROL_CHECK_DIFF_BASE"].to_s.strip
base = FastCert.default_diff_base(root) if base.empty?
die "cannot resolve diff base #{base.inspect} — fetch it (git fetch origin) and re-run" unless
  git_ok?(root, "rev-parse", "--verify", base)
# The parent state the replay runs in: the commit `base...HEAD` diffs from.
merge_base = git(root, "merge-base", base, "HEAD").strip
die "cannot find the merge base of #{base} and HEAD — fetch it (git fetch origin) and re-run" if merge_base.empty?

# --- 1. partition the diff ----------------------------------------------------
raw = git(root, "diff", "--name-status", "-M", "#{base}...HEAD")
changes = ControlReplay.parse_name_status(raw)
if changes.empty?
  die "no committed diff against #{base} — nothing to control. Commit the test change first."
end

parts = ControlReplay.partition(changes)
replay = parts[:replay]
deferred = parts[:deferred]
added = parts[:added]

note "diff vs #{base}: #{replay.size} replayable, #{deferred.size} deferred, #{added.size} added"

# --- the un-mechanizable half, said out loud ----------------------------------
# No stamp is written here, deliberately. bin/dor-check then falls back to the
# author's `[control]` line, which stays the requirement for this population.
# Writing a stamp for a run that replayed NOTHING would be the fake lane the
# config's e2e_onchain removal exists to warn against.
if replay.empty?
  note "nothing to replay — no changed file has both a pre-change version and a runner here."
  note "  deferred (pre-change version, no runner in this ecosystem): #{deferred.join(', ')}" if deferred.any?
  note "  added (no pre-change version to replay):                   #{added.join(', ')}" if added.any?
  if why.empty?
    note "This is the REVIEWER-PROMPT half of the control. Record what you ran by hand:"
    note "  bin/control-check #{slug} --why '<the control you ran> → <what you observed>'"
    exit 0
  end
  # The author's line, written here so it names this diff's files by construction.
  record_line!(slug, "[control] #{(deferred + added).join(', ')} → #{why}")
  exit 0
end

# --- the fingerprint the stamp binds to: this tree, which the harness never writes
fingerprint = TreeFingerprint.working_tree(root)
die "cannot fingerprint #{root} (no git identity?) — the stamp must be bound to this exact code" if
  fingerprint.nil?

test_cmd = ENV.fetch("CONTROL_CHECK_TEST_CMD", "bin/rails test")
prepare_cmd = ENV.fetch("CONTROL_CHECK_PREPARE_CMD", "bin/rails db:test:prepare test:prepare")

def prepare!(dir, prepare_cmd)
  return if ENV["CONTROL_CHECK_SKIP_PREPARE"]

  note "preparing test DB/assets in #{dir}: #{prepare_cmd}"
  return if system({ "RAILS_ENV" => "test" }, prepare_cmd, chdir: dir.to_s)

  die "#{prepare_cmd} failed — the replay needs a prepared test DB to mean anything"
end
prepare!(root, prepare_cmd)

# Run a set of test paths, returning [ok, summary]. Exit status is the authority
# (a parsed count is a convenience and formats drift); the summary line is lifted
# out for the reviewer when minitest prints one.
def run_tests(root, test_cmd, paths)
  cmd = "#{test_cmd} #{paths.map { |p| Shellwords.escape(p) }.join(' ')}"
  out = +""
  ok = false
  IO.popen({ "RAILS_ENV" => "test" }, cmd, chdir: root.to_s, err: [:child, :out]) do |io|
    io.each_line do |line|
      out << line
      print line
    end
  end
  ok = $CHILD_STATUS.nil? ? false : $CHILD_STATUS.success?
  summary = out[/^\d+ runs?, .*$/].to_s.strip
  [ok, summary.empty? ? "(no summary line)" : summary]
end

# --- 2. the HEAD run ----------------------------------------------------------
head_paths = ControlReplay.head_runnable(changes)
head_ok = true
head_summary = "(no post-change runnable file — every replayed file was deleted by this diff)"
if head_paths.any?
  note "running the POST-change files: #{head_paths.join(', ')}"
  head_ok, head_summary = run_tests(root, test_cmd, head_paths)
end

# --- 3. the replay, in a throwaway worktree at the merge base -----------------
# The untracked env files and key a test boot reads (.env*, config/*.key) are copied
# in; everything else the tree holds is the merge base's own committed content.
replay_root = File.join(Dir.mktmpdir("control-check-"), "tree")
begin
  die "cannot cut a throwaway worktree at #{merge_base[0, 12]}" unless
    git_ok?(root, "worktree", "add", "--detach", replay_root, merge_base)
  (Dir.glob(File.join(root.to_s, ".env*")) + Dir.glob(File.join(root.to_s, "config", "*.key"))).each do |src|
    rel = src.delete_prefix("#{root}/")
    dest = File.join(replay_root, rel)
    FileUtils.cp(src, dest) if File.file?(src) && !File.exist?(dest)
  end
  prepare!(replay_root, prepare_cmd)
  note "replaying the PRE-change files in a worktree at #{merge_base[0, 12]}: #{replay.join(', ')}"
  old_ok, old_summary = run_tests(replay_root, test_cmd, replay)
ensure
  # --- 4. remove the throwaway tree -------------------------------------------
  git_ok?(root, "worktree", "remove", "--force", replay_root)
  FileUtils.rm_rf(File.dirname(replay_root))
  git_ok?(root, "worktree", "prune")
end

# --- 5. the verdict, and the stamp -------------------------------------------
verdict = ControlReplay.verdict(old_failed: !old_ok, head_failed: !head_ok)
detail = ControlReplay.detail(verdict: verdict, replay: replay, deferred: deferred, added: added,
                              old_failed: !old_ok, head_failed: !head_ok)
detail = "#{detail} [old: #{old_summary}] [head: #{head_summary}]"
line = CertEvidence.evidence_line(ControlReplay::LANE, fingerprint, detail,
                                  repo: TaskTree.repo_of_checkout(root))

puts
note "VERDICT: #{verdict}"
note ControlReplay.explanation(verdict)

if verdict == ControlReplay::NO_SIGNAL && why.empty?
  warn "control-check: NO-SIGNAL needs your sentence before it is stamped: a rename, a move, a " \
       "consolidation and a deleted assertion all look like this, and only you know which. Re-run with " \
       "it: bin/control-check #{slug} --why '<renamed/consolidated/…>, coverage preserved because …'. " \
       "Nothing was stamped."
  exit 1
end
line = "#{line} why: #{why}" unless why.empty?
record_line!(slug, line)
exit 0
