<%# EMAIL HEADER BRIEFS, by app: each brief's state, rounds and running spend,
    and the form that opens a new one. Admin only (EmailImagesController). %>
<div class="max-w-6xl mx-auto px-4 py-6 space-y-5">
  <%# The engine page header: the generator and the brand kits are pages elsewhere, in
      the Links menu (docs/PAGE_HEADER.md). Opening a brief is the form below. %>
  <%= render "studio/page_header", title: "Email images", crumbs: studio_crumbs(:email_images),
        menu: [{ label: "Email image generator", href: email_image_generators_path, data: { test: "generator-link" } },
               { label: "Brand kits", href: email_brand_kits_path, data: { test: "brand-kits-link" } }] %>
  <p class="text-sm text-secondary">Header art for transactional email, generated from each brand's kit and approved here.</p>

  <div class="card p-4 sm:p-5 space-y-3" data-test="briefs">
    <h2 class="text-sm font-bold text-heading">Briefs</h2>
    <% if @briefs.empty? %>
      <p class="text-2xs text-muted">No briefs yet. Open one below.</p>
    <% else %>
      <% @briefs.group_by(&:app).each do |app, briefs| %>
        <div class="space-y-1">
          <h3 class="text-2xs font-semibold uppercase tracking-wide text-muted"><%= app %></h3>
          <ul class="divide-y divide-subtle">
            <% briefs.each do |brief| %>
              <li class="py-2 flex flex-wrap items-center gap-2 min-w-0" data-test="brief-row" data-slug="<%= brief.slug %>">
                <%= link_to brief.catalog_key, email_image_path(brief), class: "font-mono text-xs text-primary hover:underline break-all" %>
                <span class="text-xs text-body truncate min-w-0">&ldquo;<%= brief.headline %>&rdquo;</span>
                <% if brief.approved_artifact_slug.present? %>
                  <span class="badge text-3xs bg-success/10 text-success-ink border-success/40">approved</span>
                <% elsif brief.building? %>
                  <span class="badge text-3xs bg-surface-alt text-muted border-subtle">generating</span>
                <% end %>
                <span class="text-3xs text-muted ml-auto">
                  <%= pluralize(brief.live_candidates.size, "candidate") %> &middot;
                  rounds <%= brief.rounds_used %>/<%= brief.max_rounds %>
                  <% if brief.billable_units_total.positive? %>&middot; <%= number_with_delimiter(brief.billable_units_total) %> tokens<% end %>
                </span>
              </li>
            <% end %>
          </ul>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="card p-4 sm:p-5 space-y-3">
    <h2 class="text-sm font-bold text-heading">Open a brief</h2>
    <%= render "form", brief: @brief %>
  </div>
</div>
