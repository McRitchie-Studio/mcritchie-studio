<% content_for :title, "Credentials · McRitchie Studio" %>

<section class="max-w-6xl mx-auto px-4 py-10" data-test="credentials-page">
  <header class="mb-8">
    <p class="text-xs font-semibold uppercase tracking-wider text-primary mb-2">Credentials</p>
    <h1 class="text-3xl font-bold text-heading mb-2">Software by entity</h1>
    <p class="text-muted max-w-2xl">
      Which software each entity holds credentials for, and in which 1Password vault. Records only,
      never the secrets themselves.
    </p>
  </header>

  <%# The table scrolls sideways inside its own box on a phone; the page never does. %>
  <div class="overflow-x-auto rounded-2xl border border-subtle bg-surface" data-test="credential-matrix">
    <table class="w-full min-w-[720px] text-sm border-collapse">
      <thead>
        <tr class="border-b border-subtle">
          <th scope="col" class="sticky left-0 z-10 bg-surface text-left align-bottom px-4 py-4 text-xs font-semibold uppercase tracking-wider text-muted w-40">Software</th>
          <% @entities.each do |entity| %>
            <% workspace = @workspaces.fetch(entity, {}) %>
            <% icon = "#{CredentialVault::ICON_DIR}/#{entity}.png" %>
            <th scope="col" class="px-3 py-4 align-bottom text-center" data-test="matrix-entity" data-entity="<%= entity %>">
              <div class="flex flex-col items-center gap-2">
                <% if Rails.root.join("app/assets/images", icon).file? %>
                  <%= image_tag icon, alt: "#{workspace['name'] || entity} 1Password vault icon", class: "w-16 h-16", data: { test: "entity-icon" } %>
                <% else %>
                  <div class="w-16 h-16 rounded-full border-2 border-dashed border-subtle flex items-center justify-center text-[10px] leading-tight text-muted p-2"
                       title="bin/onepass-icon --workspace <%= entity %> --badge PATH" data-test="entity-icon-missing">No badge</div>
                <% end %>
                <span class="font-semibold text-heading"><%= workspace["name"] || entity.titleize %></span>
              </div>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody class="divide-y divide-subtle">
        <% @services.each do |service| %>
          <tr data-test="matrix-software" data-service="<%= service %>">
            <th scope="row" class="sticky left-0 z-10 bg-surface text-left align-top px-4 py-3 font-semibold text-heading"><%= CredentialRecord.service_label(service) %></th>
            <% @entities.each do |entity| %>
              <% records = @matrix.dig(service, entity) || [] %>
              <td class="px-3 py-3 align-top" data-test="matrix-cell" data-entity="<%= entity %>" data-count="<%= records.size %>">
                <% if records.empty? %>
                  <span class="block text-center text-muted">—</span>
                <% else %>
                  <ul class="space-y-1.5">
                    <% records.sort_by { |r| [ r.live? ? 0 : 1, r.title ] }.each do |record| %>
                      <li class="<%= 'opacity-50 line-through' unless record.live? %>" title="<%= record.scope_summary.presence || record.notes %>" data-test="credential-record">
                        <span class="block font-mono text-xs text-heading break-all"><%= record.title %></span>
                        <span class="block text-[11px] text-muted">
                          <%= record.credential_vault.lane %><%= " · #{record.status}" unless record.status == "filed" %>
                        </span>
                      </li>
                    <% end %>
                  </ul>
                <% end %>
              </td>
            <% end %>
          </tr>
        <% end %>
        <% if @services.empty? %>
          <tr><td colspan="<%= @entities.size + 1 %>" class="px-4 py-6 text-center text-muted">No credential records yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
