#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/gh-token — THE one place a GitHub token comes from.
#
#   token="$(bin/gh-token)"                  # the lane's identity (agent unless GH_APP_ITEM says otherwise)
#   token="$(bin/gh-token --identity deployer)"   # the ship identity (pushes main, deploys)
#   bin/gh-token --status                    # human-readable cache state; prints NO token
#   bin/gh-token --reject "$token"           # retire a REJECTED session; prints nothing
#
# The identity comes from --identity, else GH_APP_ITEM, else `agent` (see LANE
# below). To install the result into `gh`'s own keyring, use bin/gh-auth-refresh —
# piping this command into `gh auth login` is REFUSED whenever GH_TOKEN is set.
#
# WHY THIS EXISTS. The 2026-07-29 org migration retired personal access tokens:
# every `gh` write now authenticates as a GitHub App INSTALLATION token that lives
# about an hour. Before this, each script solved that alone — bin/ship grew its own
# mint-and-retry, bin/pr-review never did, and every reviewer merge on 2026-08-10
# stopped so a human could mint by hand. N scripts meant N chances to forget, and a
# script written next year starts out broken the same way. So acquisition lives HERE
# and callers just ask.
#
# THE CACHE, and why it is a file. Agents run as separate processes, so an exported
# environment variable is invisible to a sibling — the shared state has to be on
# disk. `<projects>/.agents/github-tokens.json`, mode 0600, holding two SLOTS per
# identity:
#
#   { "agent": { "active": "a",
#                "a": { "token": "…", "created_at": "…" },
#                "b": { "token": "…", "created_at": "…" } },
#     "deployer": { … } }
#
# TWO SLOTS, TOGGLED (the operator's design, and it earns its keep): a GitHub App
# token stays valid until it expires EVEN AFTER a newer one is minted. So a fresh
# mint writes to the slot that is NOT active and then flips — which means an agent
# holding the previous token mid-operation never has the rug pulled, and there is
# always one prior token to compare against when something looks wrong. The read
# rule is simply "return the newest token that is still fresh", so the toggle can
# never hand back something older than what it replaced.
#
# KEYED BY IDENTITY, deliberately. `agent` opens and merges PRs; `deployer` pushes
# main and deploys and CANNOT merge, by design. One shared slot pair would hand a
# merge call a deployer token and fail in a way nobody would read correctly.
#
# THE LANE PICKS THE IDENTITY, via GH_APP_ITEM. `git` (through
# bin/gh-app-git-credential) and the SOPs already treat `export
# GH_APP_ITEM=github.mcritchie-deployer` as "this session is a ship session". This
# command used to read only --identity and IGNORE that export, so a ship session
# that asked the broker for a token got the AGENT identity — the one App holding
# `pull_requests: write`, which the deployer is denied ON PURPOSE. A privilege
# boundary that any caller crosses by forgetting a flag is not a boundary, so the
# env var is honoured here too and the two legs finally agree. Precedence is
# --identity > GH_APP_ITEM > agent: an explicit flag is a caller stating its lane
# outright (bin/ship genuinely needs the PR-writing App), which must still win.
#
# NO LOCK, DELIBERATELY. Five agents hitting expiry at the same moment will mint
# five tokens, and that is FINE: a mint takes seconds, every minted token is
# independently valid, and last-write-wins on the cache costs nothing because the
# read rule takes the newest anyway. Operator's call, and the right one — locking
# buys tidiness and pays for it with a whole class of wedge (a stale lockfile, a
# crashed holder, a hung wait) in the path that every GitHub call depends on. Be
# resilient rather than exclusive.
#
# SECRET HYGIENE: the file is 0600, the token is printed ONLY on the bare success
# path (so `$(bin/gh-token)` works), and `--status` deliberately prints ages and
# never a token. Nothing here logs it.

require "json"
require "fileutils"
require "time"
require_relative "../lib/task_usage_sandbox"
require_relative "lib/op_vaults"
require_relative "lib/op_meter"
require_relative "lib/gh_identity"

IDENTITIES = {
  # `lane` selects the VAULT and the TOKEN (see bin/lib/op_vaults.rb). The
  # deployer's credentials live in the admin vault and are deliberately
  # unreadable from an ordinary agent shell.
  "agent" => { item: "github.mcritchie-agent", pem: "mcritchie-agent.2026-07-29.private-key.pem",
               lane: :agent },
  "deployer" => { item: "github.mcritchie-deployer", pem: "mcritchie-deployer.2026-07-29.private-key.pem",
                  lane: :deployer }
}.freeze

# The lane this process belongs to, resolved by the shared map in bin/lib/gh_identity.rb
# (--identity > GH_APP_ITEM > agent). An UNRECOGNISED GH_APP_ITEM aborts instead of
# falling back to `agent`: falling back is precisely the bug this resolver exists to
# kill, and a typo'd item silently handing back the PR-writing App is the worst
# possible reading of an unclear instruction.
# Two things reach nil here and they are fixed at different knobs — an unreadable
# GH_APP_ITEM, and `--identity` handed an empty value — so the reason is derived from
# what this call actually passed rather than assumed to be the env's fault.
def resolve_identity(explicit)
  GhIdentity.resolve(explicit) || die!(GhIdentity.unresolved_reason(explicit))
end

# Installation tokens live ~60 minutes. Refresh at 50 so a token handed out now
# survives the operation it was fetched for — a caller that starts a 6-minute merge
# with 90 seconds left is the failure this margin exists to prevent.
LIFETIME_SECONDS = 3600
REFRESH_AFTER_SECONDS = 3000

# WHICH IDENTITIES MAY BE CACHED AT ALL — and `deployer` deliberately may not.
#
# THE DEFECT THIS CLOSES (found 2026-08-28 when the two-vault split was reviewed).
# The cache exists so sibling agent PROCESSES can share a token: an exported env
# var is invisible to a sibling, so the shared state has to be on disk. That is
# right for `agent`, which re-mints roughly hourly across many concurrent lanes.
#
# It is wrong for `deployer`. The two-vault split makes a build lane unable to
# MINT admin credentials — the 1Password read is what is blocked. But the cache
# is read BEFORE the mint, so for the 50 minutes after any admin-lane mint a
# deployer token sat in a 0600 file that ordinary lanes read by design, and
# `bin/gh-token --identity deployer` SUCCEEDED in a shell with no admin token.
# The isolation was real for minting and hollow for obtaining.
#
# Ship lanes run a handful of times a day, so re-minting per call costs almost
# nothing and removes the window entirely rather than narrowing it. Chosen by the
# operator over partitioning the cache, which is more machinery and still leaves
# a deployer token on disk.
CACHEABLE_IDENTITIES = %w[agent].freeze

def cacheable?(identity)
  CACHEABLE_IDENTITIES.include?(identity.to_s)
end

OP_BIN = ENV["GH_TOKEN_OP_BIN"].to_s.strip.empty? ? "/opt/homebrew/bin/op" : ENV["GH_TOKEN_OP_BIN"]
MINT_BIN = ENV["GH_TOKEN_MINT_BIN"].to_s.strip.empty? ? File.expand_path("gh-app-mint-token", __dir__) : ENV["GH_TOKEN_MINT_BIN"]
PROJECTS = ENV["CLAUDE_PROJECTS_DIR"].to_s.strip.empty? ? File.expand_path("~/projects") : ENV["CLAUDE_PROJECTS_DIR"]

# THE CACHE HOLDS A LIVE CREDENTIAL, so it is laundered through the same fail-closed
# guard as every other state store under <projects>/.agents. Under TASK_USAGE_SANDBOX
# an unpinned CLAUDE_PROJECTS_DIR ABORTS rather than falling back to the operator's
# real directory — which for this file means a test run can never deposit a real
# GitHub token in it. That is not a formality: this command printed a live token to a
# terminal once already (see --status), and the blast radius of a cached one is worse.
def store_path
  TaskUsageSandbox.enforce!(File.join(PROJECTS, ".agents", "github-tokens.json"), store: "github-token")
end

def die!(message)
  warn("gh-token: #{message}")
  exit 1
end

def read_store
  return {} unless File.exist?(store_path)

  parsed = JSON.parse(File.read(store_path))
  # WELL-FORMED JSON IS NOT A WELL-SHAPED CACHE. `{not json` raises and is caught
  # below, but `[]`, `null` and `"scalar"` parse CLEANLY and then blow up downstream
  # with a TypeError/NoMethodError/IndexError — an unhandled stack trace on the one
  # command every `gh` call depends on, wedging every agent until a human deletes the
  # file. Shape-check here so the promise on the next line is true for every corrupt
  # cache, not just the unparseable spelling.
  parsed.is_a?(Hash) ? parsed : {}
rescue StandardError
  {} # a corrupt cache is a cache miss, never a failure — we can always mint
end

def write_store(store)
  FileUtils.mkdir_p(File.dirname(store_path))
  # Write-then-rename so a reader never sees a half-written cache, and 0600 BEFORE
  # the secret lands in it.
  tmp = "#{store_path}.#{Process.pid}.tmp"
  File.open(tmp, File::CREAT | File::WRONLY | File::TRUNC, 0o600) { |f| f.write("#{JSON.pretty_generate(store)}\n") }
  File.rename(tmp, store_path)
  File.chmod(0o600, store_path)
rescue StandardError => e
  warn("gh-token: could not persist the cache (#{e.class}) — continuing with a fresh mint each call")
end

def age_of(slot)
  created = slot.is_a?(Hash) ? slot["created_at"] : nil
  return nil if created.to_s.strip.empty?

  Time.now.utc - Time.parse(created).utc
rescue StandardError
  nil
end

# The freshest USABLE token for this identity, or nil. "Freshest" is by created_at,
# never by which slot is flagged active — so a toggle can never serve something
# older than what it replaced.
def usable_token(entry)
  %w[a b].filter_map { |key|
    slot = entry[key]
    next unless slot.is_a?(Hash) && !slot["token"].to_s.strip.empty?

    age = age_of(slot)
    next if age.nil? || age >= REFRESH_AFTER_SECONDS

    [age, slot["token"]]
  }.min_by(&:first)&.last
end

def read_secret(ref, lane = OpVaults::DEFAULT_LANE)
  return "" unless File.executable?(OP_BIN)

  # op takes its credential from OP_SERVICE_ACCOUNT_TOKEN and nothing else, so a
  # non-default lane must REPLACE it for this child only. In an ordinary agent
  # shell the admin token is absent and op_env is {} — the read then fails with
  # the agent token, which is the isolation working, not a bug.
  # Metered (bin/lib/op_meter.rb) so a burst of mints is attributable to the
  # command that caused it. OpMeter.popen spawns nothing beyond this child, so
  # `$?` below still reports op's status and not the recorder's.
  out = OpMeter.popen(OpVaults.op_env(lane), [OP_BIN, "read", ref], via: "gh-token", err: File::NULL)
  $?.success? ? out : ""
rescue StandardError
  ""
end

def mint(identity)
  meta = IDENTITIES.fetch(identity)
  lane = meta.fetch(:lane)
  app_id = read_secret(OpVaults.ref(meta[:item], "app-id", lane), lane).strip
  pem = read_secret(OpVaults.ref(meta[:item], meta[:pem], lane), lane)
  if app_id.empty? || pem.strip.empty?
    # The parenthetical goes BEFORE the diagnosis, never after. OpVaults.diagnose
    # ends on an indented, copy-pasteable command; anything appended lands on that
    # same line, so `bin/setup-1pass-token --admin (is `op` signed in?)` is what the
    # operator would paste — a shell syntax error. The remedy must be the last
    # thing on the last line.
    die!("could not read the #{identity} App credentials from 1Password " \
         "(is `op` signed in?) — #{OpVaults.diagnose(lane)}")
  end

  token = IO.popen({ "GH_APP_ID" => app_id, "GH_APP_PEM" => pem }, [MINT_BIN], &:read).to_s.strip
  die!("the mint script produced no token for #{identity}") unless $?.success? && !token.empty?

  token
end

# Mint into the INACTIVE slot and flip. The previous token stays intact and valid,
# so an agent already using it is never interrupted.
# Retire a session GitHub has REJECTED, and only that one.
#
# The caller is bin/gh-app-git-credential's `erase` branch: git hands back the
# password it just failed with, which is the only evidence anyone gets that a
# cached token has gone bad before its clock runs out.
#
# MATCHING ON THE TOKEN IS THE WHOLE DESIGN, for two independent reasons.
#   1. The cache is SHARED. A sibling agent may already have hit the same
#      rejection and minted a replacement into the other slot; a blind purge of
#      the identity would discard that fresh session and send every sibling back
#      to 1Password, which is the cost this cache exists to avoid.
#   2. It makes the retirement EXACTLY ONCE for free. Once the slot is gone, a
#      second reject carrying the same token matches nothing — no counter, no
#      retry budget, no state to get wrong.
#
# Silent and non-fatal by contract: this runs on a path git has already decided
# has failed, and a bookkeeping error must not make that failure worse.
def reject!(identity, token)
  return if token.empty?

  store = read_store
  entry = store[identity]
  return unless entry.is_a?(Hash)

  doomed = %w[a b].select { |slot| entry[slot].is_a?(Hash) && entry[slot]["token"].to_s == token }
  return if doomed.empty?

  doomed.each { |slot| entry.delete(slot) }
  # `active` names a slot. If the rejected one WAS active, the pointer now dangles;
  # reads tolerate that (usable_token walks a/b and skips non-Hashes) but leaving it
  # would be a lie about the cache's state, so drop it when its target is gone.
  entry.delete("active") unless entry.key?(entry["active"].to_s)
  store[identity] = entry
  write_store(store)
end

def refresh(identity)
  token = mint(identity)

  # Re-read immediately before writing so a concurrent minter's slot is preserved
  # rather than clobbered — not for exclusion (there is none), just so both agents'
  # tokens survive in the two slots and the newest still wins on read.
  store = read_store

  # A NON-CACHEABLE IDENTITY IS NEVER WRITTEN, and any slot an earlier version of
  # this script left behind is PURGED here rather than merely ignored. Ignoring it
  # would leave a live deployer token on disk until it aged out — the exact window
  # this change exists to close, surviving the change that closes it.
  unless cacheable?(identity)
    if store.key?(identity)
      store.delete(identity)
      write_store(store)
    end
    return token
  end

  # Same shape rule one level down: read_store now guarantees a Hash, but an ENTRY
  # can still be a scalar ({"agent":"oops"}), and String#[]= raises IndexError.
  entry = store[identity]
  entry = {} unless entry.is_a?(Hash)
  target = entry["active"] == "a" ? "b" : "a"
  entry[target] = { "token" => token, "created_at" => Time.now.utc.iso8601 }
  entry["active"] = target
  store[identity] = entry
  write_store(store)

  # The token is returned from memory, never re-read from the cache: a failed
  # persist must not fail the CALL. Worst case we mint again next time.
  token
end

def status
  store = read_store
  if store.empty?
    puts "gh-token: no cache yet (#{store_path})"
    return
  end

  store.each do |identity, entry|
    puts "#{identity}: active=#{entry['active'] || '-'}"
    %w[a b].each do |key|
      slot = entry[key]
      unless slot.is_a?(Hash) && slot["token"]
        puts "  #{key}: empty"
        next
      end

      age = age_of(slot)
      state = age.nil? ? "unreadable" : (age >= REFRESH_AFTER_SECONDS ? "STALE" : "fresh")
      mins = age ? (age / 60).round : "?"
      puts "  #{key}: #{state}, minted #{mins}m ago#{entry['active'] == key ? ' (active)' : ''}"
    end
  end
end

identity = nil
force = false
reject = nil
args = ARGV.dup
while (arg = args.shift)
  case arg
  when "--identity" then identity = args.shift.to_s.strip
  when "--force" then force = true
  when "--reject" then reject = args.shift.to_s.strip
  when "--status"
    # NOT `status and exit 0`: `status` returns nil, the `and` short-circuits, the
    # exit never runs, and execution falls through to the bare token print — which
    # is exactly how this command leaked a live token to a terminal on 2026-08-10.
    # A flag whose whole purpose is "show state WITHOUT the secret" must exit
    # unconditionally.
    status
    exit 0
  when "-h", "--help"
    warn(File.read(__FILE__).lines.grep(/^#( |$)/).map { |l| l.sub(/^# ?/, "") }.join)
    exit 0
  else die!("unknown argument #{arg.inspect}")
  end
end
identity = resolve_identity(identity)
die!("unknown identity #{identity.inspect} (expected: #{IDENTITIES.keys.join(', ')})") unless IDENTITIES.key?(identity)

# A REJECTION IS A WRITE, NOT A READ: it never mints, never prints a token, and
# always exits 0 so a credential helper's cleanup cannot fail a git operation.
if reject
  reject!(identity, reject)
  exit 0
end

# `cacheable?` is checked BEFORE the read, not after: serving a token this script
# will no longer write is exactly the stale-credential path the purge above exists
# to prevent.
unless force || !cacheable?(identity)
  cached = usable_token(read_store[identity] || {})
  if cached
    puts cached
    exit 0
  end
end

puts refresh(identity)
