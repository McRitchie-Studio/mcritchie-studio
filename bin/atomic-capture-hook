#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/atomic-capture-hook — Claude Code PostToolUse hook that streams every tool
# call into the atomic-capture endpoint (Phase B live-capture). A FRESH Claude
# Code session, with this wired as a PostToolUse hook, populates the per-action
# trajectory at /alex/heartbeat LIVE — one AgentAction row per tool call.
#
# Claude Code invokes a PostToolUse hook with the event JSON on STDIN:
#   { session_id, transcript_path, cwd, hook_event_name,
#     tool_name, tool_input, tool_response }
# We map that to the AgentAction.capture contract (owned by the parallel task
# atomic-capture-api-endpoint) and POST it to
#   ${ATOMIC_CAPTURE_URL:-http://localhost:3000}/api/v1/agent_actions
# using the SAME agent token bin/task mints (POST /api/v1/auth { secret }).
#
# ── Telemetry must never break the work it observes ────────────────────────
# This hook is BEST-EFFORT and runs on EVERY tool call, so it is built to be
# invisible to the session:
#   * It ALWAYS exits 0 — every error is swallowed, no exception ever escapes.
#   * The network leg runs in a DETACHED child (fork) so the parent returns
#     immediately and the session never waits on HTTP. Set
#     ATOMIC_CAPTURE_FOREGROUND=1 to run it inline (the integration test does, so
#     it can observe the POST); fork-less platforms fall back to inline too.
#   * HTTP open/read timeouts are short (≈1.5s) so even an unreachable endpoint
#     fails fast.
#   * The 24h auth token is cached on disk so `op read` runs at most ~once/day,
#     never per tool call.
#
# Wire-up (the orchestrator installs this AFTER review via bin/install-agent-docs;
# do NOT hand-edit the operator's global ~/.claude/settings.json). See
# docs/agents/system/atomic-capture-hook.md for the settings.json snippet.

require "json"
require "time"
require_relative "lib/agent_api"

# All logic lives on this class so the unit test can `load` the file (the main
# guard below keeps it from executing) and exercise the pure builders directly.
class AtomicCaptureHook
  # AgentAction outcomes / actors (mirror app/models/agent_action.rb).
  OK    = "ok"
  ERROR = "error"
  AGENT = "agent"

  # tool_name → capture kind. Anything unmapped falls back to the tool name
  # downcased, so a new tool still captures (just under its own label).
  KIND_MAP = {
    "Read" => "read", "Glob" => "read", "Grep" => "read",
    "Edit" => "edit", "Write" => "edit", "NotebookEdit" => "edit",
    "Bash" => "bash",
    "Task" => "delegate", "Agent" => "delegate",
    "WebFetch" => "research", "WebSearch" => "research"
  }.freeze

  # NAVIGATION is DROPPED — the agent narrates meaningful ACTIVITIES (AgentActivity)
  # and raw tool-calls attribute to whichever activity is open; a bare directory move owns
  # no activity and is ~84% of the noise, so it never becomes a row. A Bash call is
  # navigation when its command's first token is cd / pushd / popd / pwd.
  NAV_COMMAND = /\A\s*(?:cd|pushd|popd|pwd)\b/.freeze

  # NARRATION is DROPPED too — a Bash call whose invocation IS `bin/agent-activity`
  # or the compatibility `bin/atomic-event` (the agent's self-narration CLI) is
  # the activity machinery itself, not work. The
  # PostToolUse hook fires on that call like any other, so storing it as a raw
  # action drops it into "Unlabeled" (it owns no activity — it declares one). So we
  # drop it, exactly like navigation. Matches ONLY a narration CLI INVOCATION —
  # any path prefix (`/abs/…/bin/agent-activity`, `./bin/atomic-event`) and optional
  # leading `ENV=val` assignments — never a command that merely MENTIONS the string
  # (`grep atomic-event`, `cat bin/atomic-event`, editing the file). A `cd … &&
  # bin/atomic-event` already drops as navigation (first token `cd`).
  NARRATION_COMMAND = %r{
    \A\s*
    (?:\w+=\S*\s+)*   # optional leading ENV=val assignments
    (?:[^\s]*/)?      # optional path prefix (/abs/…/, ./, ../…)
    bin/(?:atomic-event|agent-activity)
    (?:\s|\z)         # a bare invocation, or followed by args/whitespace
  }x.freeze

  # Truncate input/output to ≈3KB (within the task's 2-4KB cap) so a giant file
  # read or command dump never bloats a row.
  MAX_FIELD_BYTES = 3000

  # How much of the transcript tail to scan for the session model. Claude Code does
  # NOT put the model in the PostToolUse stdin payload or any env var (verified),
  # but the payload's `transcript_path` points at a JSONL whose assistant lines
  # carry `message.model`. At PostToolUse time the last written line is (almost
  # always) the assistant turn that issued the tool call, so a bounded tail read
  # off the END reliably finds the model without reading a multi-MB file per call.
  TRANSCRIPT_TAIL_BYTES = 131_072

  # Short timeouts — an unreachable endpoint must fail fast, never stall a tool.
  # These are the TIGHTEST in the stack (this hook fires on EVERY tool call);
  # they parameterize the shared AgentApi client below.
  OPEN_TIMEOUT = 1
  READ_TIMEOUT = 2

  def initialize(env: ENV)
    @env = env
    @api = AgentApi.new(env: env, open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT)
  end

  # ── Pure builders (unit-tested directly) ─────────────────────────────────

  # Map a PostToolUse event hash → the flat AgentAction.capture payload.
  # task_slug / stage / mascot come from the active-feature marker; model + token
  # usage + the source turn id come from the SAME assistant transcript line (read
  # once here). tokens_in/out are the FRESH spend and cache_read_tokens the re-used
  # context (kept apart so cost prices the cache tier correctly); cost itself is
  # derived server-side and event/result slugs stay absent (a hook can't know them).
  def build_payload(event, now: Time.now.utc)
    marker = resolve_marker(cwd: event["cwd"], session_id: event["session_id"])
    turn   = resolve_assistant_turn(event)
    usage  = turn_usage(turn["usage"])
    key_method = bash_key_method(event)
    {
      "session_id" => event["session_id"],
      "kind" => map_kind(event["tool_name"]),
      "task_slug" => marker["task_slug"],
      "stage" => marker["stage"],
      "mascot" => marker["mascot"],
      "model" => resolve_model(event, turn),
      "tokens_in" => usage[:tokens_in],
      "tokens_out" => usage[:tokens_out],
      "cache_read_tokens" => usage[:cache_read_tokens],
      "source_turn_uuid" => present?(turn["uuid"]) ? turn["uuid"] : nil,
      "summary" => bash_summary(event),
      "key_method" => key_method,
      "key_method_lang" => key_method ? "bash" : nil,
      "input" => redacted_field(serialize(event["tool_input"]), event, suppress: write_tool?(event)),
      "output" => redacted_field(serialize(event["tool_response"]), event, suppress: true),
      "outcome" => outcome_for(event["tool_response"]),
      "actor" => AGENT,
      "occurred_at" => now.iso8601
    }
  end

  def map_kind(tool_name)
    name = tool_name.to_s
    KIND_MAP[name] || name.downcase
  end

  # The session model, or nil — best-effort and never raises. Order: a direct
  # payload field (`model` / nested `message.model`) if a future Claude Code adds
  # one, else the most recent assistant `message.model` in the transcript the
  # payload's `transcript_path` points at. Reuses a turn already read for this
  # payload when passed one (build_payload reads the transcript once). nil ⇒ the
  # capture endpoint drops the key and the column stays null (no fabrication — we
  # only ever stamp a REAL model).
  def resolve_model(event, turn = nil)
    direct = event["model"] || event.dig("message", "model")
    return direct if present?(direct)

    turn ||= resolve_assistant_turn(event)
    model = turn["model"]
    present?(model) ? model : nil
  rescue StandardError
    nil
  end

  # The newest assistant turn from the transcript as { "model", "usage", "uuid" },
  # or {} — the single source of both the model and the token usage a payload
  # stamps. Best-effort and never raises.
  def resolve_assistant_turn(event)
    read_assistant_turn_from_transcript(event["transcript_path"]) || {}
  rescue StandardError
    {}
  end

  # Model-only helper kept for callers/tests that just want the model string.
  def read_model_from_transcript(path)
    turn = read_assistant_turn_from_transcript(path)
    turn && turn["model"]
  end

  # Scan the TAIL of the transcript JSONL for the newest assistant line carrying a
  # `message.model`, and return that SAME line's { "model", "usage", "uuid" } — the
  # model, its `message.usage` block, and the line's `uuid` (the assistant turn id).
  # Model and usage MUST come from one line: usage belongs to the turn that issued
  # the tool call. Reads at most TRANSCRIPT_TAIL_BYTES off the end (dropping a
  # leading partial line), parses lines back-to-front. Bounded + best-effort so a
  # huge or missing transcript never stalls or breaks the hook. nil when no
  # model-bearing line is found.
  def read_assistant_turn_from_transcript(path)
    return nil unless present?(path) && File.file?(path)

    size = File.size(path)
    if size > TRANSCRIPT_TAIL_BYTES
      content = IO.read(path, TRANSCRIPT_TAIL_BYTES, size - TRANSCRIPT_TAIL_BYTES, mode: "rb")
      partial = true
    else
      content = IO.read(path, mode: "rb")
      partial = false
    end
    return nil unless content

    lines = content.to_s.split("\n")
    lines.shift if partial && lines.length > 1 # a mid-line start is not valid JSON
    lines.reverse_each do |line|
      next if line.strip.empty?

      parsed = (JSON.parse(line) rescue nil)
      next unless parsed.is_a?(Hash)

      model = parsed.dig("message", "model")
      next unless present?(model)

      return {
        "model" => model,
        "usage" => parsed.dig("message", "usage"),
        "uuid"  => parsed["uuid"]
      }
    end
    nil
  rescue StandardError
    nil
  end

  # Fold an assistant turn's `message.usage` into the AgentAction token contract,
  # keeping FRESH spend and RE-USED context apart:
  #   * tokens_in  = input + cache_creation — the fresh prompt-side tokens actually
  #     processed this turn (cache_creation folded in at 1x; its true rate is 1.25x,
  #     an accepted best-effort so we don't split a third tier).
  #   * tokens_out = output.
  #   * cache_read_tokens = cache_read — context re-read from the prompt cache. It
  #     is NOT part of the displayed token count (that's the fresh in/out), only of
  #     cost, priced server-side at the cache-read tier (10% of the input rate).
  # Lumping cache_read into tokens_in is what overstated a long session as ~300K
  # tokens/action and priced it ~10x; splitting it here is the fix. Missing /
  # non-hash usage yields all-zero. Never raises.
  def turn_usage(usage)
    usage = usage.is_a?(Hash) ? usage : {}
    tokens_in = usage["input_tokens"].to_i + usage["cache_creation_input_tokens"].to_i
    {
      tokens_in: tokens_in,
      tokens_out: usage["output_tokens"].to_i,
      cache_read_tokens: usage["cache_read_input_tokens"].to_i
    }
  rescue StandardError
    { tokens_in: 0, tokens_out: 0, cache_read_tokens: 0 }
  end

  # True when the event is a NAVIGATION tool-call (dropped, never POSTed): a Bash
  # call whose command's first token is cd / pushd / popd / pwd. Anything else —
  # including every non-Bash tool — is not navigation.
  def navigation?(event)
    NAV_COMMAND.match?(bash_command(event))
  end

  # True when the event is a NARRATION tool-call (dropped, never POSTed): a Bash
  # call whose invocation IS `bin/agent-activity`/`bin/atomic-event` (the self-narration CLI is the activity
  # machinery, not work). Non-Bash tools and commands that merely mention the string
  # are NOT narration. See NARRATION_COMMAND.
  def narration?(event)
    NARRATION_COMMAND.match?(bash_command(event))
  end

  # The Bash command string for an event, or "" for a non-Bash tool / missing
  # input. The shared extractor behind navigation?/narration? — an empty string
  # matches neither pattern, so a non-Bash tool is never dropped.
  def bash_command(event)
    return "" unless event["tool_name"].to_s == "Bash"

    input = event.fetch("tool_input") { {} }
    input.is_a?(Hash) ? input["command"].to_s : ""
  end

  # The bash call's `description` param → the hook-derived AgentAction.summary
  # (the action's GOAL slug, outcome-free). Only Bash carries a description;
  # nil leaves the column empty. Pattern-redacted like any stored text.
  def bash_summary(event)
    return nil unless event["tool_name"].to_s == "Bash"

    input = event.fetch("tool_input") { {} }
    desc = input.is_a?(Hash) ? input["description"].to_s.strip : ""
    desc.empty? ? nil : redact_secrets(desc)
  end

  # The bash call's command → the hook-derived AgentAction.key_method (the
  # copy-and-rerun line on the heartbeat rows). SAME redaction policy as the
  # `input` field — this lands on the PUBLIC surface. nil for non-Bash tools.
  def bash_key_method(event)
    cmd = bash_command(event)
    return nil if cmd.strip.empty?

    redacted_field(cmd, event, suppress: write_tool?(event))
  end

  # JSON-encode anything that isn't already a string (the contract columns are
  # text). Never raises — a non-encodable value degrades to #inspect.
  def serialize(value)
    return "" if value.nil?
    return value if value.is_a?(String)

    JSON.generate(value)
  rescue StandardError
    value.inspect
  end

  # ── Secret redaction (audit 2026-07-02 high finding #6) ───────────────────
  # tool_input / tool_response are the SOLE source of AgentAction.input/output,
  # which render on the PUBLIC /alex/heartbeat surface — so a secret must never be
  # stored (and never leaves the box: we redact HERE, before the POST). Two layers:
  #   1. WHOLE-FIELD suppression when the tool touches secret MATERIAL — a Bash
  #      command that prints a secret, or a read/write of a secret FILE. A bare
  #      value (e.g. `bin/secret` output) has no key to pattern-match, so the whole
  #      field is dropped to REDACTED_FIELD.
  #   2. PATTERN redaction on whatever survives — KEY=VALUE pairs whose key names a
  #      secret, plus known credential value formats. The KEY is kept and only the
  #      VALUE masked, so the trajectory stays legible.
  REDACTED_FIELD = "[redacted: secret material]"
  REDACTED_VALUE = "[redacted]"

  # A basename that holds secret material (a Read/Write of it, or a `cat` of it).
  SECRET_FILE_BASENAME = /
    \.env(?:\.[\w.-]+)? | credentials(?:\.\w+)* | master\.key | secrets?\.ya?ml(?:\.enc)? |
    id_rsa | id_ed25519 | id_ecdsa | [\w.-]+\.pem | [\w.-]+\.key
  /xi.freeze

  # A command whose STDOUT is secret material — its output is suppressed wholesale.
  SECRET_READER = %r{
    (?:\A|[|&;]|\s)\s*
    (?:
      (?:\S*/)?bin/secret\b | op\s+read\b | op\s+item\s+get\b |
      printenv\b | env\s*\z | gh\s+auth\s+token\b | heroku\s+config(?::get)?\b |
      aws\s+configure\s+get\b | security\s+find-generic-password\b
    )
  }x.freeze

  # A file-dumping command (`cat`/`head`/…) — secret only when its target is a
  # SECRET_FILE_BASENAME (checked together in secret_reader_command?).
  FILE_DUMP = /(?:\A|[|&;]|\s)\s*(?:cat|bat|less|more|head|tail|xxd|strings|nl)\s/.freeze

  # An assignment whose KEY names a secret, masking the VALUE and keeping the key.
  # Covers shell `KEY=VALUE` / `KEY="VALUE"`, YAML `KEY: VALUE`, and — crucially —
  # JSON `"KEY":"VALUE"`. The key/separator group (2) tolerates a CLOSING QUOTE
  # before the `[:=]` so a JSON-serialized structured tool response (an MCP tool /
  # nested tool_response hash) can't slip a `"access_token":"…"` past: the key class
  # excludes `"`, so without this the key's closing quote sat between the key and the
  # separator and the match failed (the value then landed on the PUBLIC surface). The
  # value (group 4, up to whitespace/quote/comma) is masked; groups 1–3 are kept.
  SECRET_ASSIGNMENT = /
    ([A-Za-z0-9_.\-]*
     (?:SECRET|TOKEN|PASSWORD|PASSWD|API[_-]?KEY|PRIVATE[_-]?KEY|ACCESS[_-]?KEY|
        SECRET[_-]?KEY|_KEY|CREDENTIAL|WEBHOOK|SIGNING|MNEMONIC|SEED[_-]?PHRASE)
     [A-Za-z0-9_.\-]*)
    (['"]?\s*[:=]\s*)(['"]?)([^\s'",]+)
  /xi.freeze

  # The field value to store: REDACTED_FIELD when the tool touched secret material
  # (and this field should be suppressed), else the pattern-redacted, truncated
  # value. Redaction runs BEFORE truncation so a secret near the cut can't survive
  # as a prefix.
  def redacted_field(raw, event, suppress:)
    return truncate(REDACTED_FIELD) if suppress && reads_secret_material?(event)

    truncate(redact_secrets(raw))
  end

  # True when the tool call touches secret material: a Bash secret-reader command,
  # or a read/write of a secret file path. Non-Bash/non-file tools are never flagged.
  def reads_secret_material?(event)
    case event["tool_name"].to_s
    when "Bash"
      secret_reader_command?(bash_command(event))
    when "Read", "Write", "Edit", "NotebookEdit"
      secret_file_path?(file_path_of(event))
    else
      false
    end
  end

  def secret_reader_command?(command)
    cmd = command.to_s
    return false if cmd.empty?
    return true if cmd.match?(SECRET_READER)

    cmd.match?(FILE_DUMP) && cmd.match?(SECRET_FILE_BASENAME)
  end

  def secret_file_path?(path)
    return false unless present?(path)

    File.basename(path.to_s).match?(/\A(?:#{SECRET_FILE_BASENAME})\z/i)
  end

  def write_tool?(event)
    %w[Write Edit NotebookEdit].include?(event["tool_name"].to_s)
  end

  # The file_path from a Read/Write/Edit tool_input, or nil.
  def file_path_of(event)
    input = event.fetch("tool_input") { {} }
    input.is_a?(Hash) ? input["file_path"] : nil
  end

  # Mask secret VALUES in-place: secret-named assignments (key kept, value masked)
  # then known standalone credential formats. Never raises — a redaction hiccup
  # falls back to the raw string only if the whole thing blows up (it won't).
  def redact_secrets(str)
    s = str.to_s
    return s if s.empty?

    s = s.gsub(SECRET_ASSIGNMENT) { "#{Regexp.last_match(1)}#{Regexp.last_match(2)}#{Regexp.last_match(3)}#{REDACTED_VALUE}" }
    s = s.gsub(/-----BEGIN [A-Z0-9 ]*PRIVATE KEY-----.*?-----END [A-Z0-9 ]*PRIVATE KEY-----/m, REDACTED_VALUE)
    s = s.gsub(/\bsk_(?:live|test)_[A-Za-z0-9]{10,}/, REDACTED_VALUE)          # stripe
    s = s.gsub(/\bAKIA[0-9A-Z]{16}\b/, REDACTED_VALUE)                         # aws access key id
    s = s.gsub(/\b(?:ghp|gho|ghs|ghr|github_pat)_[A-Za-z0-9_]{20,}/, REDACTED_VALUE) # github
    s = s.gsub(/\bxox[baprs]-[A-Za-z0-9-]{10,}/, REDACTED_VALUE)              # slack
    s.gsub(/\b([Bb]earer)\s+[A-Za-z0-9._\-]{20,}/, "\\1 #{REDACTED_VALUE}")   # bearer token
  rescue StandardError
    REDACTED_FIELD
  end

  # Byte-safe truncation with a marker, so a multibyte tail never corrupts the
  # column and the reader can see how much was dropped.
  def truncate(value, max_bytes = MAX_FIELD_BYTES)
    str = value.to_s
    return str if str.bytesize <= max_bytes

    cut = str.byteslice(0, max_bytes).to_s
    cut = cut.scrub("") if cut.respond_to?(:scrub)
    "#{cut}…[truncated #{str.bytesize} bytes]"
  end

  # ok unless tool_response carries an explicit failure signal. Deliberately
  # conservative — a non-empty stderr is NOT a failure, only structured signals
  # (error/is_error/success:false/interrupted) are, so we never false-flag.
  def outcome_for(tool_response)
    return OK unless tool_response.is_a?(Hash)

    return ERROR if present?(fetch_either(tool_response, "error"))
    return ERROR if fetch_either(tool_response, "is_error") == true
    return ERROR if fetch_either(tool_response, "success") == false
    return ERROR if fetch_either(tool_response, "interrupted") == true

    OK
  end

  # Resolve task_slug / stage / mascot for a captured action. task_slug + stage
  # describe the DESK — the nearest .agent-context.json walking up from the tool's
  # cwd (the worktree) wins; else the per-session marker keyed by session id.
  #
  # The BASE `mascot`, though, is the session's OWN stable Pokémon — the
  # per-session marker (keyed by session_id, written by `bin/task session-mascot`
  # from SessionMascot) — NOT the desk's .agent-context.json mascot, which carries
  # the BOUND TASK's builder mascot and would FLIP the base when a session works a
  # task built by a different soul (the Shellder→Sandshrew switch). This keeps an
  # action's base mascot aligned with its activity's (see bin/agent-activity). The desk
  # mascot is only a fallback for a session with no mascot of its own yet. Returns
  # a hash with string keys (possibly nil values) and never raises.
  def resolve_marker(cwd:, session_id:)
    desk    = read_context_marker(cwd)
    session = read_session_marker(session_id) || {}
    context = desk || session
    {
      # worktree desk uses task_record_slug/task_slug; session marker uses
      # task_slug/slug — accept all, first present wins.
      "task_slug" => first_present(context, "task_record_slug", "task_slug", "slug"),
      "stage" => blank_to_nil(context["stage"]),
      "mascot" => blank_to_nil(session["mascot"]) || blank_to_nil((desk || {})["mascot"])
    }
  rescue StandardError
    { "task_slug" => nil, "stage" => nil, "mascot" => nil }
  end

  # ── Delivery (integration-tested via shell-out to a stub) ────────────────

  # Entry point: read the event off stdin and dispatch. Wrapped so NOTHING can
  # escape — the process always exits 0.
  def run(stdin: $stdin)
    raw = stdin.read
    event = JSON.parse(raw)
    return unless present?(event["session_id"]) # nothing to attribute → skip
    return if navigation?(event)                # navigation is dropped — never a row
    return if narration?(event)                 # bin/atomic-event narration is dropped too

    payload = build_payload(event)
    dispatch(payload)
  rescue StandardError
    # swallow — telemetry never breaks the session
  end

  # Run the network leg detached by default so the parent returns instantly;
  # inline when ATOMIC_CAPTURE_FOREGROUND=1 (tests) or fork is unavailable.
  def dispatch(payload)
    if foreground?
      deliver(payload)
      return
    end

    pid = fork do
      begin
        Process.setsid
        deliver(payload)
      rescue StandardError
        # swallow in the child too
      ensure
        exit!(0)
      end
    end
    Process.detach(pid) if pid
  rescue NotImplementedError, StandardError
    deliver(payload) # fork unsupported → inline with short timeouts
  end

  # Auth (cached token via the shared AgentApi client) then POST the action.
  # Best-effort; swallows everything. A 401 drops the shared token cache so the
  # next call re-mints.
  def deliver(payload)
    tok = @api.token
    return unless tok

    res = @api.http_json(:post, "/api/v1/agent_actions", payload, bearer: tok)
    @api.invalidate_token! if res && res.code.to_i == 401
  rescue StandardError
    # swallow
  end

  private

  def foreground?
    @env["ATOMIC_CAPTURE_FOREGROUND"].to_s == "1"
  end

  # ── Marker file resolution (mirrors bin/agent-marker) ────────────────────

  # Walk up from the tool's cwd to the nearest .agent-context.json.
  def read_context_marker(cwd)
    dir = present?(cwd) ? File.expand_path(cwd) : nil
    return nil unless dir

    loop do
      path = File.join(dir, ".agent-context.json")
      return JSON.parse(File.read(path)) if File.file?(path)

      parent = File.dirname(dir)
      return nil if parent == dir

      dir = parent
    end
  rescue StandardError
    nil
  end

  def read_session_marker(session_id)
    sid = session_id.to_s.strip
    return nil if sid.empty?

    safe = sid.gsub(/[^A-Za-z0-9._-]/, "")
    path = File.join(projects_dir, ".agents", "sessions", "#{safe}.json")
    return nil unless File.file?(path)

    JSON.parse(File.read(path))
  rescue StandardError
    nil
  end

  # ── Paths (honor CLAUDE_PROJECTS_DIR — resolution lives on AgentApi) ──────

  def projects_dir
    @api.projects_dir
  end

  # ── Tiny helpers ─────────────────────────────────────────────────────────

  def first_present(hash, *keys)
    keys.each do |key|
      value = hash[key]
      return value if present?(value)
    end
    nil
  end

  def fetch_either(hash, key)
    hash.fetch(key) { hash[key.to_sym] }
  end

  def blank_to_nil(value)
    present?(value) ? value : nil
  end

  def present?(value)
    @api.present?(value)
  end
end

# Only run when invoked directly (not when `load`ed by the unit test).
AtomicCaptureHook.new.run if $PROGRAM_NAME == __FILE__
