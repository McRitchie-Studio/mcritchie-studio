#!/usr/bin/env ruby
# frozen_string_literal: true

# archive-docs — retire frozen doc snapshots out of the live tree.
#
#   bin/archive-docs                        # perform it
#   bin/archive-docs --dry-run              # report only, change nothing
#   bin/archive-docs --json                 # machine summary only
#   bin/archive-docs --help                 # usage; SWEEPS NOTHING
#
# `bin/release archive` drives this beside the log sweep, same contract:
# --dry-run previews, the confirm authorizes it. Nothing is ever deleted; every
# retirement is a `git mv` into docs/agents/archive/. Files are left in place and
# NAMED in the report whenever something still-live cites them — a referenced
# snapshot is someone's live citation, and the referrer gets fixed first,
# deliberately, rather than being silently orphaned.
#
# Moves are STAGED, not committed: bin/release archive commits them, and a
# standalone run leaves a reviewable `git status`.

require "fileutils"
require "json"
require_relative "lib/cli_arg_guard"
require_relative "lib/docs_archive"
require_relative "lib/repo_root"

USAGE = <<~TXT
  usage: bin/archive-docs [--repo <path>] [--dry-run] [--json]

    Retire frozen doc snapshots out of the live tree into docs/agents/archive/.

    --repo <path>           repository to sweep (default: this script's checkout)
    --dry-run               report only; changes nothing
    --json                  print the machine summary line only
    --help, -h              this text — SWEEPS NOTHING

  Nothing is ever deleted: every retirement is a `git mv`, staged not committed.
  Both `--flag=value` and `--flag value` parse.
TXT

# EVERY ARGUMENT IS ACCOUNTED FOR BEFORE THE ROLL, and this guard is the whole
# reason the script is safe to probe.
#
# Until 2026-08-31 the four lines below were the ENTIRE parser: four exact
# spellings read out of ARGV, with no notion of an argument this script does not
# recognize. So `bin/archive-docs --help` matched nothing, was silently dropped,
# and fell straight through to a REAL archive roll, for an operator who was only
# asking what the command does.
#
# The guard runs FIRST, ahead of the sweep,
# because a probe has to be answerable before anything can mutate, and it has to
# work on a repo whose state would make the real action refuse.
ARGS = CliArgGuard.guard!(
  ARGV,
  program: "archive-docs",
  usage: USAGE,
  bool: %w[--dry-run --json],
  value: %w[--repo],
  # exit 0 because THIS script's 0 means only "it ran". Contrast bin/devops-shift,
  # whose 0 asserts "you are on shift", so it answers help with non-zero.
  help_exit: 0,
  consequence: "NOTHING was archived."
)

DRY       = ARGS.bool?("--dry-run")
JSON_ONLY = ARGS.bool?("--json")
# The repo whose docs are swept: an explicit --repo, else the checkout this
# script ships in (a worktree ships its own bin/, so it sweeps its own tree).
REPO      = ARGS.first("--repo") ||
            RepoRoot.git_toplevel(__dir__) ||
            File.expand_path("..", __dir__)

def say(message = "")
  puts(message) unless JSON_ONLY
end

# --- the doc sweep -----------------------------------------------------------
plan = DocsArchive.plan(REPO)

say("==> Archiving frozen doc snapshots#{DRY ? ' (dry-run — nothing will change)' : ''}")
say("    repo: #{REPO}")
say("    → #{DocsArchive::ARCHIVE_DIR}/ (git mv; nothing is ever deleted)")
say

if plan[:moves].empty?
  say("-- nothing to retire; the live tree carries no unreferenced snapshots.")
else
  say("-- retiring #{plan[:moves].size} frozen snapshot(s):")
  plan[:moves].each { |move| say(format("     %-58s → %s", move[:from], move[:to])) }
end

if plan[:skipped].any?
  say
  say("==> SKIPPED — still referenced by the live tree (fix the referrer first):")
  plan[:skipped].each do |entry|
    say(format("     %-58s cited by: %s", entry[:path], entry[:referrers].join(", ")))
  end
end

moved = DRY ? plan[:moves].size : DocsArchive.apply_moves!(REPO, plan[:moves])

say
say("==> #{DRY ? 'Would retire' : 'Retired'} #{moved} doc(s); " \
    "#{plan[:skipped].size} left in place as still-referenced")

puts DocsArchive.summary_line(
  dry_run: DRY,
  moved: moved,
  moved_paths: plan[:moves].map { |m| m[:from] },
  skipped: plan[:skipped].map { |s| { path: s[:path], referrers: s[:referrers] } }
)
