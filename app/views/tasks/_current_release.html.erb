<%# Current Release module for /deployments. Renders the active
    (assembling/assembled) release, or a muted empty state when none is active.
    Local: release (the Release, or nil for the empty state). The shipped
    release is NOT shown here; it renders read-only in _last_release.
    Layout: the status badge owns the top-right corner (in _release_summary);
    the one-trigger QA-release kickoff chip rides inline (right) with the task
    pills row. %>
<% rel = local_assigns.fetch(:release, nil) %>
<% if rel %>
  <%# data-glow tints the live-update flash (LiveBoardFx) with the conductor mascot's
      type colour; blank → the fx falls back to its default warm-orange pulse. %>
  <div id="current-release" data-glow="<%= rel.mascot&.signature_color %>" class="rounded-xl border border-subtle bg-surface p-4">
    <%# Operator's one-trigger QA-department workflow chip rides inline with the task
        pills: assess the active release, pull every reviewed/passing task in, deploy
        QA, then stop for ship. %>
    <% kickoff = render "tasks/kickoff_chip", command: qa_release_kickoff %>
    <%= render "tasks/release_summary", release: rel, variant: :current, trailing: kickoff -%>
  </div>
<% else %>
  <%# No active release: muted empty state mirroring the active card — the section
      label top-left, the kickoff chip floated bottom-right. %>
  <div id="current-release" class="rounded-xl border border-subtle bg-surface p-4">
    <div class="flex items-center gap-3 flex-wrap">
      <span class="text-[11px] uppercase tracking-wide text-muted font-semibold">Next Release</span>
      <span class="text-sm text-muted italic">none active</span>
    </div>
    <p class="mt-2 text-xs text-muted">Merge a reviewed task (or kick off below) to establish one.</p>
    <div class="mt-3 flex justify-end">
      <%= render "tasks/kickoff_chip", command: qa_release_kickoff %>
    </div>
  </div>
<% end %>
