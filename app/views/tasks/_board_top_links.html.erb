<%# Secondary board links above the page title: back to the admin dashboard
    (admins only), the Stages guide outside /deployments, the Intelligence dashboard, the
    Pokédex, and the reimagined cross-session Activities feed (/agents/activities). The Deploy lane additionally links
    the OPSD Pipeline, Insights, and Recent (the /tasks/recent recency list) surfaces.
    Epics (/epics, every epic with its progress by stage) shows on every surface. Wrapped in a nav so cross-page link
    checks and screen readers find them on every board surface.
    Local: current ("tasks" | "deployments" | "stages" | "epics") marks the active page. %>
<% current = local_assigns.fetch(:current, nil) %>
<nav class="flex flex-wrap items-center gap-3 gap-y-1 text-xs mb-1.5" aria-label="Board sections">
  <% if admin? %>
    <%= link_to "← Dashboard", admin_dashboard_path,
          class: "text-muted hover:text-heading transition" %>
  <% end %>
  <% unless current == "deployments" %>
    <%= link_to "Stages", stages_path,
          "aria-current": (current == "stages" ? "page" : nil),
          class: "transition #{current == 'stages' ? 'text-primary font-medium' : 'text-muted hover:text-heading'}" %>
  <% end %>
  <%= link_to "Epics", epics_path,
        data: { test: "board-link-epics" },
        "aria-current": (current == "epics" ? "page" : nil),
        class: "transition #{current == 'epics' ? 'text-primary font-medium' : 'text-muted hover:text-heading'}" %>
  <%= link_to "Intelligence", intelligence_path,
        class: "text-muted hover:text-heading transition" %>
  <%= link_to "🎭 Activities", activities_agents_path,
        class: "text-muted hover:text-heading transition" %>
  <%= link_to "Pokédex", pokedex_path,
        class: "text-muted hover:text-heading transition" %>
  <% if current == "deployments" %>
    <%= link_to "Pipeline", xan_pipeline_path,
          class: "text-muted hover:text-heading transition" %>
    <%= link_to "Insights", xan_insights_path,
          class: "text-muted hover:text-heading transition" %>
    <%= link_to "Recent", recent_tasks_path,
          class: "text-muted hover:text-heading transition" %>
  <% end %>
</nav>
