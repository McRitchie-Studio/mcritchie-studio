#!/usr/bin/env bash
# Install the projects-level agent entrypoints + user-global skills from McRitchie Studio.
#
# Sources of truth:
#   docs/agents/index.md        -> $PROJECTS_DIR/AGENTS.md        (Codex reads this natively)
#   docs/agents/claude.md       -> $PROJECTS_DIR/CLAUDE.md        (Claude Code adapter; @imports AGENTS.md)
#   docs/agents/skills/<name>/  -> $HOME/.claude/skills/<name>/   (user-global Claude Code skills)
#   docs/agents/skills/<name>/  -> $HOME/.codex/skills/<name>/    (user-global Codex skills)
#
# Claude Code auto-loads CLAUDE.md (and its @imports) but NOT AGENTS.md, so both
# files are required to give every agent the same operating model. This keeps the
# durable docs in GitHub while giving sessions a stable first file at the root.
#
# The skills under docs/agents/skills/ are USER-GLOBAL, so the platform owns them
# here exactly like the root docs: they survive a wiped machine and travel with
# the repo. This is distinct from PROJECT-scoped skills such as
# mcritchie-studio/.claude/skills/ (which load only when CWD is the studio) —
# those are deliberately NOT touched by this installer.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
default_projects_dir() {
  local candidate
  candidate="$(cd "$ROOT/.." && pwd)"
  if [ "$(basename "$candidate")" = ".worktrees" ]; then
    cd "$candidate/../.." && pwd
  else
    printf '%s\n' "$candidate"
  fi
}
runtime_root() {
  case "$ROOT" in
    */.worktrees/*) printf '%s\n' "${ROOT%%/.worktrees/*}" ;;
    *) printf '%s\n' "$ROOT" ;;
  esac
}
PROJECTS_DIR="${PROJECTS_DIR:-$(default_projects_dir)}"
RUNTIME_ROOT="${AGENT_DOCS_RUNTIME_ROOT:-$(runtime_root)}"
CODEX_REQUIREMENTS_PATH="${CODEX_REQUIREMENTS_PATH:-/etc/codex/requirements.toml}"
RUBY_PATH_PREFIX="${AGENT_RUNTIME_RUBY_PATH_PREFIX:-/opt/homebrew/opt/ruby@3.3/bin:/opt/homebrew/lib/ruby/gems/3.3.0/bin}"
ZPROFILE_PATH="${AGENT_RUNTIME_ZPROFILE:-$HOME/.zprofile}"
# The board the SessionStart insights hook reads (GET /api/v1/insights). Baked
# into the wired command as ATOMIC_CAPTURE_URL so a fresh session hatches with the
# curated PROD bank, exactly like the capture hook. Overridable for tests.
INSIGHTS_BOARD_URL="${AGENT_INSIGHTS_BOARD_URL:-https://mcritchie.studio}"
MODE="${1:-install}"

# "source:target" pairs (paths use /, so : is a safe delimiter).
PAIRS=(
  "$ROOT/docs/agents/index.md:$PROJECTS_DIR/AGENTS.md"
  "$ROOT/docs/agents/claude.md:$PROJECTS_DIR/CLAUDE.md"
)

# User-global skills: mirror every file under each docs/agents/skills/<name>/ tree
# into every supported runtime's user-global skill directory. A skill can carry
# more than a SKILL.md (helper scripts, reference files), so we expand the tree
# into the SAME "source:target" file pairs the docs use — install + check then
# share one code path. Built dynamically from whatever is tracked, so adding a
# skill needs no script change.
SKILLS_SRC_DIR="$ROOT/docs/agents/skills"
SKILLS_DEST_DIRS=(
  "$HOME/.claude/skills"
  "$HOME/.codex/skills"
)
SKILL_PAIRS=()
if [ -d "$SKILLS_SRC_DIR" ]; then
  # -mindepth 2: only mirror files INSIDE a <name>/ skill dir, so a top-level
  # README.md documenting the source tree never lands in an agent skills dir as a
  # stray non-skill.
  while IFS= read -r src; do
    rel="${src#"$SKILLS_SRC_DIR"/}"
    for dest_dir in "${SKILLS_DEST_DIRS[@]}"; do
      SKILL_PAIRS+=("$src:$dest_dir/$rel")
    done
  done < <(find "$SKILLS_SRC_DIR" -mindepth 2 -type f | sort)
fi

usage() {
  cat <<USAGE
Usage: bin/install-agent-docs [install|check]

install  Copy the agent entrypoints to \$PROJECTS_DIR (AGENTS.md + CLAUDE.md)
         and the user-global skills to ~/.claude/skills + ~/.codex/skills.
check    Verify \$PROJECTS_DIR/{AGENTS,CLAUDE}.md plus ~/.claude/skills and
         ~/.codex/skills match the tracked sources.
USAGE
}

# Compare one source against its installed target. Missing target counts as drift
# (a wiped ~/.claude or ~/.codex). Quiet on stdout; the callers narrate OK/ERROR.
check_pair() {
  local src="$1" tgt="$2"
  [ -f "$tgt" ] && cmp -s "$src" "$tgt"
}

# Copy one source onto its target, creating intermediate dirs (skill subdirs, and
# $PROJECTS_DIR for the root docs — mkdir -p is idempotent for both).
install_pair() {
  local src="$1" tgt="$2"
  mkdir -p "$(dirname "$tgt")"
  cp "$src" "$tgt"
}

case "$MODE" in
  install|check) ;;
  -h|--help|help) usage; exit 0 ;;
  *) echo "ERROR: unknown mode: $MODE" >&2; usage >&2; exit 64 ;;
esac

for pair in "${PAIRS[@]}"; do
  src="${pair%%:*}"
  if [ ! -f "$src" ]; then
    echo "ERROR: missing source doc: $src" >&2
    exit 1
  fi
done

# Iterate PAIRS, then SKILL_PAIRS. SKILL_PAIRS may be empty (no skills tracked
# yet); guard the expansion so `set -u` on bash 3.2 doesn't choke on "${arr[@]}".
ALL_PAIRS=("${PAIRS[@]}")
if [ "${#SKILL_PAIRS[@]}" -gt 0 ]; then
  ALL_PAIRS+=("${SKILL_PAIRS[@]}")
fi

if [ "$MODE" = "check" ]; then
  status=0
  for pair in "${ALL_PAIRS[@]}"; do
    src="${pair%%:*}"; tgt="${pair##*:}"
    if check_pair "$src" "$tgt"; then
      echo "OK: $tgt matches $src"
    else
      echo "ERROR: $tgt is out of date with $src" >&2
      status=1
    fi
  done
  [ "$status" -eq 0 ] || echo "Run: cd $ROOT && bin/install-agent-docs" >&2
  exit "$status"
fi

mkdir -p "$PROJECTS_DIR"
echo "Installed:"
for pair in "${ALL_PAIRS[@]}"; do
  src="${pair%%:*}"; tgt="${pair##*:}"
  install_pair "$src" "$tgt"
  echo "  $tgt (from $src)"
done

ensure_codex_tui_config() {
  local config="$1"
  mkdir -p "$(dirname "$config")"
  ruby - "$config" <<'RUBY'
path = ARGV.fetch(0)
text = File.exist?(path) ? File.read(path) : ""
lines = text.lines

def find_section(lines, name)
  start = lines.index { |line| line.match?(/^\s*\[#{Regexp.escape(name)}\]\s*$/) }
  return nil unless start

  finish = ((start + 1)...lines.length).find { |i| lines[i].match?(/^\s*\[[^\]]+\]\s*$/) } || lines.length
  [start, finish]
end

def ensure_array_item(lines, range, key, item, default_items)
  start, finish = range
  key_re = /^\s*#{Regexp.escape(key)}\s*=/
  index = (start + 1...finish).find { |i| lines[i].match?(key_re) }
  default_line = %(#{key} = [#{default_items.map(&:inspect).join(", ")}]\n)

  unless index
    lines.insert(finish, default_line)
    return [start, finish + 1]
  end

  return range if lines[index].include?(item)

  line = lines[index]
  if line.match?(/=\s*\[.*\]\s*(#.*)?$/)
    comment = line[/\s+#.*$/]
    body = comment ? line.sub(/\s+#.*$/, "") : line.chomp
    prefix, values = body.split("[", 2)
    values = values.sub(/\]\s*\z/, "").strip
    inserted = values.empty? ? item.inspect : "#{values}, #{item.inspect}"
    lines[index] = "#{prefix}[#{inserted}]#{comment}\n"
  else
    lines[index] = default_line
  end

  range
end

def ensure_scalar(lines, range, key, value)
  start, finish = range
  key_re = /^\s*#{Regexp.escape(key)}\s*=/
  return range if (start + 1...finish).any? { |i| lines[i].match?(key_re) }

  lines.insert(finish, "#{key} = #{value}\n")
  [start, finish + 1]
end

def ensure_top_level_scalar(lines, key, value)
  key_re = /^\s*#{Regexp.escape(key)}\s*=/
  index = lines.index { |line| line.match?(key_re) }
  if index
    lines[index] = "#{key} = #{value}\n"
    return
  end

  insert_at = lines.index { |line| line.match?(/^\s*\[/) } || lines.length
  lines.insert(insert_at, "#{key} = #{value}\n")
end

ensure_top_level_scalar(lines, "check_for_update_on_startup", "false")

range = find_section(lines, "tui")
unless range
  lines << "\n" unless lines.empty? || lines.last.end_with?("\n\n")
  lines << "[tui]\n"
  range = [lines.length - 1, lines.length]
end

range = ensure_array_item(lines, range, "status_line", "thread-title",
                          ["model-with-reasoning", "current-dir", "thread-title"])
range = ensure_array_item(lines, range, "terminal_title", "thread-title",
                          ["thread-title"])
ensure_scalar(lines, range, "status_line_use_colors", "true")

updated = lines.join
File.write(path, updated) if updated != text
RUBY
}

install_zprofile_ruby_path() {
  local zprofile="$1" ruby_path="$2"
  mkdir -p "$(dirname "$zprofile")"
  ruby - "$zprofile" "$ruby_path" <<'RUBY'
require "shellwords"

path = ARGV.fetch(0)
ruby_path = ARGV.fetch(1)
text = File.exist?(path) ? File.read(path) : ""
begin_marker = "# BEGIN McRitchie agent Ruby PATH"
end_marker = "# END McRitchie agent Ruby PATH"
quoted_path = Shellwords.escape(ruby_path)

block = <<~ZSH
  #{begin_marker}
  # Homebrew Ruby for Codex/agent non-interactive zsh login shells.
  mcritchie_ruby_path_prefix=#{quoted_path}
  case ":${PATH:-}:" in
    *":$mcritchie_ruby_path_prefix:"*) ;;
    *) export PATH="$mcritchie_ruby_path_prefix${PATH:+:$PATH}" ;;
  esac
  unset mcritchie_ruby_path_prefix
  #{end_marker}
ZSH

updated =
  if text.include?(begin_marker) && text.include?(end_marker)
    text.sub(/#{Regexp.escape(begin_marker)}.*?#{Regexp.escape(end_marker)}\n?/m, block)
  else
    prefix = text.empty? ? "" : text.sub(/\s*\z/, "\n\n")
    "#{prefix}#{block}"
  end

File.write(path, updated) if updated != text
RUBY
}

render_codex_managed_requirements() {
  local cmd="$1" managed_dir="$2" insights_cmd="$3"
  ruby - "$cmd" "$managed_dir" "$insights_cmd" <<'RUBY'
cmd = ARGV.fetch(0)
managed_dir = ARGV.fetch(1)
insights_cmd = ARGV.fetch(2)

def toml_string(value)
  %("#{value.to_s.gsub("\\", "\\\\\\").gsub('"', '\"').gsub("\n", "\\n")}")
end

puts <<~TOML
  # BEGIN McRitchie Codex mascot managed hook
  # Mirrors the session Pokemon/app marker into Codex's thread-title footer, and
  # feeds the curated Insight Bank forward into a fresh session (SessionStart).
  [hooks]
  managed_dir = #{toml_string(managed_dir)}

  [[hooks.SessionStart]]
  matcher = "startup|resume"

  [[hooks.SessionStart.hooks]]
  type = "command"
  command = #{toml_string(cmd)}
  timeout = 5
  statusMessage = "Setting session mascot"

  [[hooks.SessionStart.hooks]]
  type = "command"
  command = #{toml_string(insights_cmd)}
  timeout = 15
  statusMessage = "Loading insights…"

  [[hooks.PostToolUse]]
  matcher = "Bash"

  [[hooks.PostToolUse.hooks]]
  type = "command"
  command = #{toml_string(cmd)}
  timeout = 2
  # END McRitchie Codex mascot managed hook
TOML
RUBY
}

install_codex_managed_requirements() {
  local requirements="$1" cmd="$2" managed_dir="$3" staged="$4" insights_cmd="$5"
  mkdir -p "$(dirname "$staged")"
  render_codex_managed_requirements "$cmd" "$managed_dir" "$insights_cmd" > "$staged"

  ruby - "$requirements" "$cmd" "$managed_dir" "$insights_cmd" <<'RUBY'
require "fileutils"

path = ARGV.fetch(0)
cmd = ARGV.fetch(1)
managed_dir = ARGV.fetch(2)
insights_cmd = ARGV.fetch(3)
begin_marker = "# BEGIN McRitchie Codex mascot managed hook"
end_marker = "# END McRitchie Codex mascot managed hook"

def toml_string(value)
  %("#{value.to_s.gsub("\\", "\\\\\\").gsub('"', '\"').gsub("\n", "\\n")}")
end

block = <<~TOML
  #{begin_marker}
  # Mirrors the session Pokemon/app marker into Codex's thread-title footer, and
  # feeds the curated Insight Bank forward into a fresh session (SessionStart).
  [hooks]
  managed_dir = #{toml_string(managed_dir)}

  [[hooks.SessionStart]]
  matcher = "startup|resume"

  [[hooks.SessionStart.hooks]]
  type = "command"
  command = #{toml_string(cmd)}
  timeout = 5
  statusMessage = "Setting session mascot"

  [[hooks.SessionStart.hooks]]
  type = "command"
  command = #{toml_string(insights_cmd)}
  timeout = 15
  statusMessage = "Loading insights…"

  [[hooks.PostToolUse]]
  matcher = "Bash"

  [[hooks.PostToolUse.hooks]]
  type = "command"
  command = #{toml_string(cmd)}
  timeout = 2
  #{end_marker}
TOML

begin
  FileUtils.mkdir_p(File.dirname(path))
  text = File.exist?(path) ? File.read(path) : ""
  updated =
    if text.include?(begin_marker) && text.include?(end_marker)
      text.sub(/#{Regexp.escape(begin_marker)}.*?#{Regexp.escape(end_marker)}\n?/m, block)
    elsif text.match?(/^\s*\[hooks\]\s*$/) || text.match?(/^\s*\[\[hooks\./)
      exit 2
    else
      prefix = text.empty? ? "" : text.sub(/\s*\z/, "\n\n")
      "#{prefix}#{block}"
    end

  File.write(path, updated) if updated != text
rescue Errno::EACCES, Errno::EPERM, Errno::EROFS, Errno::ENOTDIR, Errno::EEXIST
  exit 13
end
RUBY
}

prune_codex_user_hook() {
  local hooks="$1"
  command -v jq >/dev/null 2>&1 || return 0
  [ -f "$hooks" ] || return 0

  local tmp
  tmp="$(mktemp)"
  if jq '
      def is_managed($c): ($c | contains("/bin/codex-session-title")) or ($c | contains("/bin/session-insights"));
      def prune_event($event):
        if .hooks[$event] then
          .hooks[$event] |= (
            map(.hooks = ((.hooks // []) | map(select((is_managed(.command // "")) | not))))
            | map(select(((.hooks // []) | length) > 0))
          )
          | if (.hooks[$event] | length) == 0 then del(.hooks[$event]) else . end
        else . end;
      prune_event("SessionStart") | prune_event("PostToolUse")
    ' "$hooks" > "$tmp"; then
    if ! cmp -s "$hooks" "$tmp"; then
      mv "$tmp" "$hooks"
      echo "  $hooks (removed user-level Codex mascot hooks)"
    else
      rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
  fi
}

install_codex_user_hook() {
  local hooks="$1" cmd="$2" insights_cmd="$3"
  command -v jq >/dev/null 2>&1 || return 0

  mkdir -p "$(dirname "$hooks")"
  [ -f "$hooks" ] || echo '{"hooks":{}}' > "$hooks"

  local tmp
  tmp="$(mktemp)"
  # Remove any prior managed entries (mascot AND insights) before re-appending, so
  # the fallback is idempotent for both. The insights hook is a SECOND SessionStart
  # entry (never merged into the mascot entry) so each stays independently prunable.
  if jq --arg cmd "$cmd" --arg insights_cmd "$insights_cmd" '
      def is_managed($c): ($c | contains("/bin/codex-session-title")) or ($c | contains("/bin/session-insights"));
      .hooks //= {}
      | .hooks.SessionStart = (
          (.hooks.SessionStart // [])
          | map(.hooks = ((.hooks // []) | map(select((is_managed(.command // "")) | not))))
          | map(select(((.hooks // []) | length) > 0))
        )
      | .hooks.PostToolUse = (
          (.hooks.PostToolUse // [])
          | map(.hooks = ((.hooks // []) | map(select((is_managed(.command // "")) | not))))
          | map(select(((.hooks // []) | length) > 0))
        )
      | .hooks.SessionStart += [
          {
            matcher: "startup|resume",
            hooks: [
              {
                type: "command",
                command: $cmd,
                timeout: 5,
                statusMessage: "Setting session mascot"
              }
            ]
          },
          {
            matcher: "startup|resume",
            hooks: [
              {
                type: "command",
                command: $insights_cmd,
                timeout: 15,
                statusMessage: "Loading insights…"
              }
            ]
          }
        ]
      | .hooks.PostToolUse += [
          {
            matcher: "Bash",
            hooks: [
              {
                type: "command",
                command: $cmd,
                timeout: 2
              }
            ]
          }
        ]
    ' "$hooks" > "$tmp"; then
    if ! cmp -s "$hooks" "$tmp"; then
      mv "$tmp" "$hooks"
      echo "  $hooks (installed user-level Codex SessionStart/PostToolUse fallback -> $cmd + $insights_cmd)"
    else
      rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
  fi
}

# Make the Claude Code status line recoverable too — point it at the stable repo
# script. When installing from a worktree, docs come from that worktree but global
# hooks must point at the primary checkout so they survive worktree cleanup.
# Idempotent: only added when absent, so it never clobbers user settings.
settings="$HOME/.claude/settings.json"
if command -v jq >/dev/null 2>&1; then
  mkdir -p "$HOME/.claude"
  [ -f "$settings" ] || echo '{}' > "$settings"
  if ! jq -e '.statusLine' "$settings" >/dev/null 2>&1; then
    tmp="$(mktemp)"
    if jq --arg cmd "$RUNTIME_ROOT/bin/statusline" '.statusLine = {type:"command", command:$cmd, padding:1, refreshInterval:5}' "$settings" > "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (added statusLine -> $RUNTIME_ROOT/bin/statusline)"
    else
      rm -f "$tmp"
    fi
  elif jq -e '.statusLine.command | contains("/.worktrees/")' "$settings" >/dev/null 2>&1; then
    tmp="$(mktemp)"
    if jq --arg cmd "$RUNTIME_ROOT/bin/statusline" '.statusLine.command = $cmd' "$settings" > "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (repointed statusLine -> $RUNTIME_ROOT/bin/statusline)"
    else
      rm -f "$tmp"
    fi
  fi

  # Wire the SessionStart hook so a brand-new session paints its random Pokémon +
  # the default app (mcritchie-studio) onto the status line within seconds:
  # bin/task session-mascot seeds the per-session marker before any task exists.
  # Idempotent — appended only when our command isn't already a SessionStart hook,
  # so it never duplicates our entry or clobbers the user's other hooks. Stale
  # worktree hooks are pruned because they break after cleanup.
  tmp="$(mktemp)"
  if jq 'if .hooks.SessionStart then
        .hooks.SessionStart |= (
          map(.hooks = ((.hooks // []) | map(select(((.command // "") | test("/\\.worktrees/.*/bin/task session-mascot") | not)))))
          | map(select(((.hooks // []) | length) > 0))
        )
      else . end' "$settings" > "$tmp"; then
    if ! cmp -s "$settings" "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (removed stale worktree SessionStart hooks)"
    else
      rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
  fi

  hook_cmd="$RUNTIME_ROOT/bin/task session-mascot"
  if ! jq -e --arg cmd "$hook_cmd" '[(.hooks.SessionStart // [])[]?.hooks[]?.command // empty | select(. == $cmd or contains($cmd))] | length > 0' "$settings" >/dev/null 2>&1; then
    tmp="$(mktemp)"
    if jq --arg cmd "$hook_cmd" '.hooks //= {} | .hooks.SessionStart = ((.hooks.SessionStart // []) + [{hooks: [{type: "command", command: $cmd}]}])' "$settings" > "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (added SessionStart hook -> $hook_cmd)"
    else
      rm -f "$tmp"
    fi
  fi

  # Wire the PostToolUse hook so every tool call streams into the atomic-capture
  # endpoint and a fresh session populates /alex/heartbeat live (Phase B live
  # capture). Same discipline as the SessionStart mascot hook: point at the
  # primary checkout (survives worktree cleanup), prune stale worktree copies,
  # and only append when our command isn't already wired — never clobbering the
  # user's other PostToolUse hooks. See docs/agents/system/atomic-capture-hook.md.
  tmp="$(mktemp)"
  if jq 'if .hooks.PostToolUse then
        .hooks.PostToolUse |= (
          map(.hooks = ((.hooks // []) | map(select(((.command // "") | test("/\\.worktrees/.*/bin/atomic-capture-hook") | not)))))
          | map(select(((.hooks // []) | length) > 0))
        )
      else . end' "$settings" > "$tmp"; then
    if ! cmp -s "$settings" "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (removed stale worktree PostToolUse hooks)"
    else
      rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
  fi

  capture_cmd="$RUNTIME_ROOT/bin/atomic-capture-hook"
  if ! jq -e --arg cmd "$capture_cmd" '[(.hooks.PostToolUse // [])[]?.hooks[]?.command // empty | select(. == $cmd or contains($cmd))] | length > 0' "$settings" >/dev/null 2>&1; then
    tmp="$(mktemp)"
    if jq --arg cmd "$capture_cmd" '.hooks //= {} | .hooks.PostToolUse = ((.hooks.PostToolUse // []) + [{hooks: [{type: "command", command: $cmd, timeout: 5}]}])' "$settings" > "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (added PostToolUse hook -> $capture_cmd)"
    else
      rm -f "$tmp"
    fi
  fi

  # Wire the SessionEnd hook so a session's last narrated span never hangs open
  # forever: `bin/atomic-event close-open` closes any still-open span (reading the
  # session id off the SessionEnd stdin payload) with a generic "session ended"
  # outcome, so trailing actions never fall into "Unlabeled". Same discipline as
  # the PostToolUse hook: point at the primary checkout (survives worktree
  # cleanup), prune stale worktree copies, and only append when our command isn't
  # already wired — never clobbering the user's other SessionEnd hooks.
  tmp="$(mktemp)"
  if jq 'if .hooks.SessionEnd then
        .hooks.SessionEnd |= (
          map(.hooks = ((.hooks // []) | map(select(((.command // "") | test("/\\.worktrees/.*/bin/atomic-event close-open") | not)))))
          | map(select(((.hooks // []) | length) > 0))
        )
      else . end' "$settings" > "$tmp"; then
    if ! cmp -s "$settings" "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (removed stale worktree SessionEnd hooks)"
    else
      rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
  fi

  close_open_cmd="$RUNTIME_ROOT/bin/atomic-event close-open"
  if ! jq -e --arg cmd "$close_open_cmd" '[(.hooks.SessionEnd // [])[]?.hooks[]?.command // empty | select(. == $cmd or contains($cmd))] | length > 0' "$settings" >/dev/null 2>&1; then
    tmp="$(mktemp)"
    if jq --arg cmd "$close_open_cmd" '.hooks //= {} | .hooks.SessionEnd = ((.hooks.SessionEnd // []) + [{hooks: [{type: "command", command: $cmd, timeout: 5}]}])' "$settings" > "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (added SessionEnd hook -> $close_open_cmd)"
    else
      rm -f "$tmp"
    fi
  fi

  # Wire the SessionStart insights hook so a FRESH session hatches with the top-N
  # curated Insight Bank lessons injected as context — the OPSD learning loop's
  # feed-forward (output) stage, so banked grades stop being write-only. The hook
  # (bin/session-insights) GETs /api/v1/insights and prints the SessionStart
  # hookSpecificOutput.additionalContext JSON; it is NON-FATAL (empty bank /
  # unreachable board / no token => prints nothing, exits 0), so it can never block
  # or slow a session start. Same discipline as the mascot SessionStart hook: point
  # at the primary checkout (survives worktree cleanup), prune stale worktree
  # copies, only append when absent. It also bakes ATOMIC_CAPTURE_URL into the
  # command so the injected lessons are the curated PROD bank, exactly like the
  # capture hook. See docs/agents/system/atomic-capture-hook.md.
  tmp="$(mktemp)"
  if jq 'if .hooks.SessionStart then
        .hooks.SessionStart |= (
          map(.hooks = ((.hooks // []) | map(select(((.command // "") | test("/\\.worktrees/.*/bin/session-insights") | not)))))
          | map(select(((.hooks // []) | length) > 0))
        )
      else . end' "$settings" > "$tmp"; then
    if ! cmp -s "$settings" "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (removed stale worktree SessionStart insights hooks)"
    else
      rm -f "$tmp"
    fi
  else
    rm -f "$tmp"
  fi

  insights_path="$RUNTIME_ROOT/bin/session-insights"
  insights_cmd="ATOMIC_CAPTURE_URL=$INSIGHTS_BOARD_URL $insights_path"
  if ! jq -e --arg path "$insights_path" '[(.hooks.SessionStart // [])[]?.hooks[]?.command // empty | select(contains($path))] | length > 0' "$settings" >/dev/null 2>&1; then
    tmp="$(mktemp)"
    if jq --arg cmd "$insights_cmd" '.hooks //= {} | .hooks.SessionStart = ((.hooks.SessionStart // []) + [{hooks: [{type: "command", command: $cmd, timeout: 15, statusMessage: "Loading insights…"}]}])' "$settings" > "$tmp"; then
      mv "$tmp" "$settings"
      echo "  $settings (added SessionStart insights hook -> $insights_cmd)"
    else
      rm -f "$tmp"
    fi
  fi
fi

# Make Codex show the McRitchie marker in its footer early. Codex does not run
# arbitrary status-line commands, but its footer can include the thread-title
# item. Managed hooks paint that title from the same session mascot marker
# Claude reads and refresh it after Bash tools create or claim a task. Managed
# hooks are trusted by policy, so a fresh Codex session should not require the
# user-level /hooks review ceremony.
codex_config="$HOME/.codex/config.toml"
ensure_codex_tui_config "$codex_config"
install_zprofile_ruby_path "$ZPROFILE_PATH" "$RUBY_PATH_PREFIX"
echo "  $codex_config (ensured status_line includes thread-title)"
echo "  $ZPROFILE_PATH (ensured agent zsh login shells prepend $RUBY_PATH_PREFIX)"

codex_hooks="$HOME/.codex/hooks.json"
codex_hook_cmd="$RUNTIME_ROOT/bin/codex-session-title"
# The Codex feed-forward hook mirrors the Claude one: same board (prod via
# ATOMIC_CAPTURE_URL), same non-fatal bin/session-insights, wired as a second
# SessionStart hook alongside the mascot.
codex_insights_cmd="ATOMIC_CAPTURE_URL=$INSIGHTS_BOARD_URL $RUNTIME_ROOT/bin/session-insights"
codex_requirements_staged="$HOME/.codex/mcritchie-requirements.toml"
if install_codex_managed_requirements "$CODEX_REQUIREMENTS_PATH" "$codex_hook_cmd" "$RUNTIME_ROOT" "$codex_requirements_staged" "$codex_insights_cmd"; then
  echo "  $CODEX_REQUIREMENTS_PATH (installed Codex managed SessionStart/PostToolUse hooks -> $codex_hook_cmd + $codex_insights_cmd)"
  prune_codex_user_hook "$codex_hooks"
else
  requirements_status="$?"
  case "$requirements_status" in
    2)
      echo "  $CODEX_REQUIREMENTS_PATH (already has Codex hooks; merge managed mascot hook manually)"
      ;;
    13)
      echo "  $CODEX_REQUIREMENTS_PATH (admin install required for organic Codex mascot)"
      install_codex_user_hook "$codex_hooks" "$codex_hook_cmd" "$codex_insights_cmd"
      ;;
    *)
      echo "  $CODEX_REQUIREMENTS_PATH (could not install Codex managed mascot hook)"
      ;;
  esac
  echo "  Staged managed requirements: $codex_requirements_staged"
  echo "  Install that file as admin, or merge its McRitchie block into $CODEX_REQUIREMENTS_PATH."
fi

echo
echo "Next reads for a fresh agent:"
echo "  - $PROJECTS_DIR/AGENTS.md"
echo "  - $PROJECTS_DIR/mcritchie-studio/docs/ECOSYSTEM.md"
echo "  - $PROJECTS_DIR/mcritchie-studio/docs/agents/modules/culture.md"
