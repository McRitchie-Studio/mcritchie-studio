<%# locals: (records:) %>
<%= admin_model_table(records, key: "coaches", min_width: 980, headers: ["Coach", "Team", "Role", "Lean", "Sport", "Headshot"], empty: "No coaches found.") do |coach| %>
  <% role_label = coach.role.to_s.titleize.gsub("Special Teams", "ST") %>
  <td class="px-4 py-3">
    <div class="font-semibold text-heading truncate"><%= coach.person.full_name %></div>
    <div class="text-xs text-muted font-mono truncate"><%= coach.slug %></div>
  </td>
  <td class="px-4 py-3">
    <div class="flex items-center gap-2">
      <span class="text-lg leading-none"><%= coach.team.emoji.presence || "*" %></span>
      <span class="min-w-0">
        <span class="block font-semibold text-heading truncate"><%= coach.team.name %></span>
        <span class="block text-xs text-muted font-mono truncate"><%= coach.team.short_name %> / <%= coach.team.slug %></span>
      </span>
    </div>
  </td>
  <td class="px-4 py-3">
    <span class="inline-flex items-center px-2 py-1 rounded text-[11px] font-bold uppercase bg-surface-alt text-secondary">
      <%= role_label %>
    </span>
  </td>
  <td class="px-4 py-3 text-muted"><%= coach.lean.to_s.titleize.presence || "-" %></td>
  <td class="px-4 py-3">
    <span class="inline-flex items-center px-2 py-1 rounded text-[11px] font-bold uppercase bg-surface-alt text-secondary">
      <%= coach.sport.presence || "-" %>
    </span>
  </td>
  <td class="px-4 py-3 text-muted">
    <% if coach.espn_headshot_url.present? %>
      <div class="max-w-[220px] truncate font-mono text-xs"><%= coach.espn_headshot_url %></div>
      <div class="text-[11px] text-muted"><%= coach.espn_id.presence || "ESPN" %></div>
    <% else %>
      <span class="text-xs text-muted">not set</span>
    <% end %>
  </td>
<% end %>
