<% content_for(:title, "McRitchie Studio — Your Idea Built for 2027") %>
<% content_for(:full_width, true) %>

<style>
  @keyframes hero-pan {
    0%   { transform: scale(1.3) translateX(-10%); }
    100% { transform: scale(1.3) translateX(10%); }
  }
  /* Scrim strength by theme: dark keeps its navy weight; light runs a lighter
     tint so the photo still shows through behind the dark headline. */
  .hero-scrim { --hero-scrim-edge: 75%; --hero-scrim-mid: 58%; }
  .dark .hero-scrim { --hero-scrim-edge: 85%; --hero-scrim-mid: 70%; }
  /* On the pale tint the secondary grey washes into the skyline; light mode
     takes the darker body ink at semibold. Dark mode keeps its secondary ink. */
  .hero-subtitle-ink { color: var(--color-text-body); font-weight: 600; }
  .dark .hero-subtitle-ink { color: var(--color-text-secondary); font-weight: 400; }
  /* The hero's one call to action, a size above btn-lg (Alex McRitchie, 2026-11-03):
     the type scale's subhead, with padding to match. */
  .hero-cta { font-size: calc(var(--type-base, 16px) * 1.5); padding: 1rem 2.5rem; white-space: nowrap; }
  /* Phones trim the sides, so the one-line label stays on screen. */
  @media (max-width: 399px) { .hero-cta { padding-inline: 1.25rem; } }
  /* The box clips only the drop: the sides stay open for Agent, which hangs past the
     box's right edge, and the bottom gives its g the last pixel. */
  .hero-title .dropping-texts {
    overflow: visible;
    clip-path: inset(0 -100vw -0.05em);
  }
</style>

<!-- Hero -->
<section class="relative overflow-hidden">
  <%# The skyline, sized to its box (lane-ui-infrastructure P2: the one 4700px
      master was 1.6MB on every phone). The box is about 390x554 on a phone and
      about 525 tall from 540px up, and object-fit: cover crops the panorama to
      it, so a phone only ever saw the middle quarter. Below 540px it gets that
      middle as its own portrait crop. Wider screens get the panorama, drawn
      about 1,230 to 1,370px wide below 1440px; from 1440px the box is wider
      than the panorama's shape, so it is drawn at the viewport's width.
      The variants are generated once from the 4700px master with the ImageMagick
      commands in docs/topics/deployment.md (Public Assets), and are fingerprinted
      assets, so they cache for a year. %>
  <% portrait_srcset = [ 390, 768, 1260 ].map { |w| "#{image_path("hero/denver-hero-portrait-#{w}.avif")} #{w}w" }.join(", ") %>
  <% panorama_srcset = [ 1280, 1920, 2560 ].map { |w| "#{image_path("hero/denver-hero-#{w}.avif")} #{w}w" }.join(", ") %>
  <div class="absolute inset-0">
    <picture class="block w-full h-full">
      <source media="(max-width: 539px)" type="image/avif" srcset="<%= portrait_srcset %>" sizes="100vw">
      <source type="image/avif" srcset="<%= panorama_srcset %>" sizes="(max-width: 1439px) 1380px, 100vw">
      <img src="<%= image_path("hero/denver-hero-1280.avif") %>" alt="" width="1280" height="490" fetchpriority="high"
           class="w-full h-full object-cover" data-hero-image style="animation: hero-pan 15s linear infinite alternate;">
    </picture>
  </div>
  <%# The scrim takes the page colour, so it shades the photo in dark mode
      (--color-page is the dark base, #1A1535) and tints it pale in light mode,
      where the headline is dark text. %>
  <div class="hero-scrim absolute inset-0" data-hero-scrim style="background: linear-gradient(135deg, color-mix(in srgb, var(--color-page) var(--hero-scrim-edge), transparent) 0%, color-mix(in srgb, var(--color-page) var(--hero-scrim-mid), transparent) 50%, color-mix(in srgb, var(--color-page) var(--hero-scrim-edge), transparent) 100%);"></div>
  <div class="relative z-10 max-w-4xl mx-auto px-4 text-center section-padding-lg">
    <%# Your ___ Built for 2027 (Alex McRitchie, 2026-11-03). Your and the cycling word
        share the first line at every width. The box never moves or resizes: it is as
        wide as the median word, Flow (data-spacer), so the row centres on that width
        and each word starts at the box's left edge, against Your. The first word is
        rendered active, so it starts in place. %>
    <h1 class="font-extrabold text-heading tracking-tight mb-6 flex items-baseline justify-center flex-wrap hero-title" style="line-height: 1.1; column-gap: 0.25em;">
      <span>Your</span>
      <span class="dropping-texts text-primary" data-spacer="Flow" data-interval="3000">
        <span class="drop-active">Idea</span>
        <span>Flow</span>
        <span>Agent</span>
        <span>Plan</span>
      </span>
      <span class="basis-full">Built for 2027</span>
    </h1>
    <p class="hero-subtitle-ink max-w-2xl mx-auto mb-10 leading-relaxed hero-subtitle">
      Build a best-in-class website in minutes
    </p>
    <%# The hero's call to action is the /build funnel (Alex McRitchie, 2026-10-19): Build
        Your App, in the CTA glow primitive's rainbow preset (cta-glow-rainbow,
        app/assets/tailwind/cta_glow.css) to draw the eye. Under the glass surfaces the rainbow
        gives way to the button's own lit glow. It stands alone: the
        Meet Alex link was dropped (Alex, 2026-10-20; /tasks/drop-hero-meet-alex). %>
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 sm:gap-6">
      <%= tag.span class: "cta-glow cta-glow-rainbow", data: { test: "hero-build-glow" } do %>
        <%= link_to "Launch Your Website", build_path, class: "btn btn-primary btn-lg hero-cta", data: { test: "hero-build-cta" } %>
      <% end %>
    </div>
  </div>
</section>

<!-- Portfolio -->
<%# The portfolio band over the logo grid backdrop (task logo-grid-backdrop; Alex
    McRitchie, 2026-11-07: a Cloudflare-style lit grid, of the agents and the
    apps). The copy is a placeholder until the portfolio section card. A soft wash
    of the page colour sits behind the words so they read over lit tiles. %>
<section class="relative overflow-hidden border-t border-subtle" data-logo-grid-host data-test="portfolio-band" style="min-height: clamp(30rem, 72vh, 46rem);">
  <%= render "shared/logo_grid" %>
  <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 42% 46% at 50% 50%, color-mix(in srgb, var(--color-page) 88%, transparent) 0%, color-mix(in srgb, var(--color-page) 55%, transparent) 60%, transparent 100%);"></div>
  <div class="relative z-10 max-w-2xl mx-auto px-4 text-center pointer-events-none" style="padding-block: clamp(8rem, 24vh, 15rem);">
    <h2 class="text-4xl font-extrabold text-heading mb-3">Check Out Our Portfolio</h2>
    <p class="text-secondary text-lg mb-8">Websites and Agents Built on the Studio Platform</p>
    <%= link_to "See the Portfolio", websites_path, class: "btn btn-primary btn-lg pointer-events-auto", data: { test: "portfolio-band-cta" } %>
  </div>
</section>

<!-- Get in Touch -->
<%# Its own band: a wash of the primary colour, so the booking section reads as
    separate from the portfolio band above and the surface-alt band below. %>
<section class="border-t border-subtle" data-get-in-touch
         style="background: linear-gradient(180deg, rgb(var(--color-primary-500-rgb, 139 92 246) / .16), rgb(var(--color-primary-500-rgb, 139 92 246) / .05));">
  <%# Side by side, 50/50, from xl up (task get-in-touch-side-by-side): a live
      chat with Alex on the left, the booking calendar on the right; stacked
      below xl, chat first. The band is max-w-7xl so each half is ~612px and
      Google keeps its month-beside-slots layout and the crop holds.

      TWO MATCHING SECTIONS. Each column opens with the same centred head
      (landing/_get_in_touch_head): a round portrait, the name, the role and a
      big title. Chat Now wears the AI Alex (/agents/alex.webp, AI Builder);
      Book a Call wears Alex McRitchie's own photo (/people/alex-mcritchie.webp,
      Builder), since the call is with him.

      EQUAL CARDS. The grid has three rows (head, card, note) and each
      column is a subgrid over them, so the calendar's note under its card
      (studio/booking/_frame) sits in its own row and the two cards share one.
      The chat card is h-0 + min-h-full at xl: it adds nothing to the row's
      height and fills it, so the calendar alone sets the height (and the
      chat follows it when the frame opens in use). Its thread grows into the
      card and scrolls there, never stretching it.

      The chat is the engine's compact chat in a card; this page holds no other chat (ONE PAGE HOLDS ONE CHAT). A viewer
      the engine refuses a chat gets a link to /chat instead. %>
  <div class="max-w-7xl mx-auto px-4 section-padding">
    <div class="text-center" style="margin-bottom: 1.75rem;">
      <h2 class="text-4xl font-extrabold text-heading mb-2">Get in Touch</h2>
      <p class="text-secondary text-lg">Talk to Alex right now, or book a video call.</p>
    </div>

    <div class="grid grid-cols-1 xl:grid-cols-2 xl:grid-rows-[auto_auto_auto] gap-x-6 gap-y-6 xl:gap-y-0" data-test="get-in-touch-grid">
      <div class="min-w-0 flex flex-col xl:row-span-3 xl:grid xl:grid-rows-subgrid" data-test="get-in-touch-chat">
        <%= render "landing/get_in_touch_head", section: "chat", title: "Chat Now", name: "Alex",
                   role: BuildController::AGENT_ROLE, photo: "/agents/alex.webp" %>
        <div class="card p-4 flex flex-col gap-3 min-h-0 xl:h-0 xl:min-h-full
                    [&_[data-test=agent-chat]]:flex-1 [&_[data-test=agent-chat]]:min-h-0
                    [&_[data-test=agent-chat]>div]:h-full [&_[data-test=agent-chat]>div]:min-h-0
                    xl:[&_[data-test=agent-chat-messages]]:flex-1 xl:[&_[data-test=agent-chat-messages]]:max-h-none"
             data-test="get-in-touch-chat-card">
          <% if Studio.agent_chat_allowed?(studio_agent_chat_viewer) %>
            <%= home_alex_chat %>
          <% else %>
            <%= link_to "Open the chat with Alex", chat_index_path, class: "btn btn-primary self-center", data: { test: "get-in-touch-chat-link" } %>
          <% end %>
        </div>
      </div>

      <div class="min-w-0 xl:row-span-3 xl:grid xl:grid-rows-subgrid [&_[data-booking-wrap]]:max-w-[610px] xl:[&_[data-booking-wrap]]:mx-0!" data-test="get-in-touch-booking">
        <%= render "landing/get_in_touch_head", section: "booking", title: "Book a Call", name: "Alex",
                   role: "Builder", photo: "/people/alex-mcritchie.webp", alt: "Alex McRitchie" %>
        <%# Its own crop: at this half-width column (~610px inside the border)
            Google's "Select an appointment time" box runs 211 to 551px, so the
            site-wide crop (config/initializers/studio.rb, measured for
            /schedule's wider column, bottom 613) would show Google's credit
            lines. The note under the card still credits Google and links the
            full booking page. The frame is capped at 610px (612 with its
            border) at every width, so a tablet's full-width column cannot
            change Google's layout under the crop (at 990px the box moves to
            188-528). Below xl it stays centred; at xl mx-0! drops the engine's
            auto margins, which shrink a grid item to its content. %>
        <%= studio_booking_frame(crop: { top: 211, bottom: 551, frame_height: 869 }) %>
      </div>
    </div>
  </div>
</section>

