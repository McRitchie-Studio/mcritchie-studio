#!/usr/bin/env bash
set -euo pipefail

# McRitchie agent-runtime bootstrap wrapper.
#
# This command is the stable fresh-machine surface. The older
# bin/install-agent-docs command remains as the implementation for now.

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
INSTALLER="${AGENT_RUNTIME_INSTALLER:-$ROOT/bin/install-agent-docs}"
MARKER_BIN="${AGENT_RUNTIME_MARKER:-$ROOT/bin/agent-marker}"
CODEX_ADAPTER="${AGENT_RUNTIME_CODEX_ADAPTER:-$ROOT/bin/codex-session-title}"

usage() {
  cat <<'USAGE'
Usage:
  bin/agent-runtime install   # install AGENTS/CLAUDE docs, skills, and agent runtime hooks
  bin/agent-runtime check     # verify installed docs/skills match tracked sources
  bin/agent-runtime doctor    # inspect local marker/runtime configuration
  bin/agent-runtime repair    # alias for install

Fresh machine:
  cd /Users/alex/projects/mcritchie-studio
  bin/agent-runtime install
  bin/agent-runtime doctor
USAGE
}

ok() {
  printf 'ok: %s\n' "$1"
}

warn_line() {
  printf 'warn: %s\n' "$1"
}

fail_line() {
  printf 'fail: %s\n' "$1" >&2
  AGENT_RUNTIME_DOCTOR_STATUS=1
}

contains_thread_title() {
  local file="$1"
  [ -f "$file" ] && grep -q 'thread-title' "$file"
}

contains_codex_adapter() {
  local file="$1"
  [ -f "$file" ] && grep -q '/bin/codex-session-title' "$file"
}

codex_user_hook_events() {
  local file="$1"
  [ -f "$file" ] || return 0

  ruby -rjson - "$file" <<'RUBY' 2>/dev/null || true
path = ARGV.fetch(0)
data = JSON.parse(File.read(path))
%w[SessionStart PostToolUse].each do |event|
  entries = Array(data.dig("hooks", event))
  found = entries.any? do |entry|
    Array(entry["hooks"]).any? { |hook| hook["command"].to_s.include?("/bin/codex-session-title") }
  end
  puts event if found
end
RUBY
}

codex_hook_event_key() {
  case "$1" in
    SessionStart) printf 'session_start' ;;
    PostToolUse) printf 'post_tool_use' ;;
    *) printf '%s' "$1" ;;
  esac
}

codex_hook_trusted() {
  local config="$1" hooks_file="$2" event="$3" key
  [ -f "$config" ] || return 1
  key="$(codex_hook_event_key "$event")"
  grep -F "[hooks.state.\"$hooks_file:$key:" "$config" >/dev/null 2>&1
}

probe_codex_adapter() {
  local adapter="$1" tmp_home err_file out status
  [ -x "$adapter" ] || return 1
  tmp_home="$(mktemp -d "${TMPDIR:-/tmp}/agent-runtime-codex.XXXXXX")" || return 1
  err_file="$tmp_home/probe.err"
  out="$(
    CODEX_HOME="$tmp_home" \
    CODEX_STATE_DB="$tmp_home/state_5.sqlite" \
    CODEX_SESSION_TITLE_RETRY_DELAYS=none \
    CODEX_THREAD_ID=agent-runtime-doctor \
    CLAUDE_PROJECTS_DIR="/Users/alex/projects" \
    "$adapter" <<'JSON' 2>"$err_file"
{"session_id":"agent-runtime-doctor","hook_event_name":"SessionStart"}
JSON
  )"
  status="$?"
  rm -rf "$tmp_home"
  [ "$status" -eq 0 ] || return 1
  # Stock-compatible success is intentionally silent. If output exists, it must
  # at least look like the JSON hook output shape the patched extension expects.
  [ -z "$out" ] || printf '%s' "$out" | ruby -rjson -e 'JSON.parse(STDIN.read); exit 0' >/dev/null 2>&1
}

doctor() {
  AGENT_RUNTIME_DOCTOR_STATUS=0

  [ -x "$MARKER_BIN" ] && ok "marker provider executable: $MARKER_BIN" || fail_line "missing marker provider: $MARKER_BIN"
  [ -x "$CODEX_ADAPTER" ] && ok "Codex adapter executable: $CODEX_ADAPTER" || fail_line "missing Codex adapter: $CODEX_ADAPTER"
  [ -x "$INSTALLER" ] && ok "runtime installer executable: $INSTALLER" || fail_line "missing runtime installer: $INSTALLER"

  if "$INSTALLER" check >/tmp/mcritchie-agent-runtime-check.$$ 2>/tmp/mcritchie-agent-runtime-check-err.$$; then
    ok "installed agent docs and skills match tracked sources"
  else
    fail_line "installed agent docs or skills are out of date; run bin/agent-runtime install"
    sed 's/^/  /' /tmp/mcritchie-agent-runtime-check-err.$$ >&2 || true
  fi
  rm -f /tmp/mcritchie-agent-runtime-check.$$ /tmp/mcritchie-agent-runtime-check-err.$$

  codex_config="$HOME/.codex/config.toml"
  if contains_thread_title "$codex_config"; then
    ok "Codex config includes thread-title status item"
  else
    fail_line "Codex config missing thread-title status item: $codex_config"
  fi

  codex_hooks="$HOME/.codex/hooks.json"
  requirements="${CODEX_REQUIREMENTS_PATH:-/etc/codex/requirements.toml}"
  staged="$HOME/.codex/mcritchie-requirements.toml"
  if contains_codex_adapter "$requirements"; then
    ok "Codex managed requirements include McRitchie hook"
  elif contains_codex_adapter "$codex_hooks"; then
    missing_trust=0
    missing_events=0
    events="$(codex_user_hook_events "$codex_hooks" | tr '\n' ' ')"
    for event in SessionStart PostToolUse; do
      case " $events " in
        *" $event "*) ;;
        *) missing_events=1 ;;
      esac
      if ! codex_hook_trusted "$codex_config" "$codex_hooks" "$event"; then
        missing_trust=1
      fi
    done

    if [ "$missing_events" -eq 0 ] && [ "$missing_trust" -eq 0 ]; then
      ok "Codex user hooks include trusted McRitchie fallback hooks"
    elif [ "$missing_events" -eq 0 ]; then
      fail_line "Codex user hooks include McRitchie fallback hooks but are not trusted; review them inside Codex with /hooks or install managed requirements"
    else
      fail_line "Codex user hooks are missing one of SessionStart/PostToolUse for $CODEX_ADAPTER"
    fi
  elif contains_codex_adapter "$staged"; then
    warn_line "managed Codex requirements are staged but not installed: $staged"
  else
    fail_line "Codex hooks do not reference $CODEX_ADAPTER"
  fi

  if probe_codex_adapter "$CODEX_ADAPTER"; then
    ok "Codex mascot adapter hook probe exits cleanly"
  else
    fail_line "Codex mascot adapter hook probe failed: $CODEX_ADAPTER"
  fi

  sentinel="$HOME/.codex/mcritchie-live-thread-title.enabled"
  extension="$HOME/.codex/mcritchie-thread-name-extension.enabled"
  if [ -f "$sentinel" ]; then
    if [ -f "$extension" ]; then
      ok "live Codex thread-title repaint extension sentinel enabled"
    else
      warn_line "legacy live Codex thread-title sentinel is ignored until the patched threadName extension is installed"
    fi
  else
    warn_line "live Codex thread-title repaint sentinel disabled; stock-compatible persistence still works"
  fi

  if command -v codex >/dev/null 2>&1; then
    ok "codex binary: $(command -v codex) ($(codex --version 2>/dev/null || printf 'version unavailable'))"
  else
    warn_line "codex binary not found on PATH"
  fi

  exit "$AGENT_RUNTIME_DOCTOR_STATUS"
}

command="${1:-install}"
case "$command" in
  install)
    shift
    exec "$INSTALLER" install "$@"
    ;;
  repair)
    shift
    exec "$INSTALLER" install "$@"
    ;;
  check)
    shift
    exec "$INSTALLER" check "$@"
    ;;
  doctor)
    shift
    [ "$#" -eq 0 ] || { usage >&2; exit 64; }
    doctor
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    printf 'agent-runtime: unknown command: %s\n' "$command" >&2
    usage >&2
    exit 64
    ;;
esac
