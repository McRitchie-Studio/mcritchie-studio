#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/fast-check — the OPTIONAL local pre-flight: run the tests the branch diff
# maps to plus the curated core spine, and rubocop on the CHANGED files only, then
# print the result.
#
# IT WRITES NOTHING. No receipt lands on the task, no gate attempt opens, no
# checkpoint fires. Since /tasks/dor-reads-settled-ci-verdict the one verdict per
# tree is the PR's settled green GitHub CI, which bin/dor-check reads at the
# submit seam and review's gate-zero reads again. This script buys EARLINESS —
# catch the obvious break in about a minute, before the push and the ~10-minute
# CI round-trip — and nothing else. A red pre-flight is information for the
# builder, never a gate: bin/ship runs it at step 2, prints its verdict loudly,
# and carries on to the PR whatever it said.
#
# Until DevOps v3 phase 2b (/tasks/retire-local-cert-evidence) this was the G1
# fast CERT: it fingerprinted the tree, stamped a fast-cert receipt on
# the task, opened and closed a g1_cert GateRun, and refused a wrong, dirty or
# orphan-holding tree so the receipt could be trusted. The receipts were inert to
# every reader by then (439 builder-side and 337 review-side DoR refusals came
# from stale ones), so the machinery that produced them is gone with them.
#
# Test selection (bin/lib/fast_cert.rb, unit-tested there):
#   mapped : each changed file → its test by path convention (app/models/x.rb →
#            test/models/x_test.rb, views → their controller test, bin/tool →
#            test/lib/tool_test.rb, a changed *_test.rb runs itself), a tool's test
#            FAMILY, and a grep for the subject's identity when nothing else maps.
#            Past the CAP (FastCert.cap_decision) the lane falls back to the
#            convention TWINS — 1-2 paths per changed file — or, when there are
#            none, to the spine alone: crossing the cap is a slope, not a cliff.
#   spine  : config/fast_cert_spine.yml — the always-run critical core (~10-20s).
#            Anchored in the HUB and filtered to paths that exist under the code
#            root, so a SATELLITE checkout (turf-monster, rolio, the gems) resolves
#            none of it and the mapped lane is the only lane that can run a test.
#   rubocop: the changed files rubocop can lint (never the whole repo).
#
# Lanes run from the repo root (the agent's worktree via RepoRoot, so a satellite
# task pre-flights the satellite). Given a task slug and an implicit root, the
# tree check (bin/lib/task_tree.rb) first verifies that root IS the task's tree
# and aborts otherwise — a pre-flight of an unrelated tree tells the builder
# nothing about their diff, and reads as green. FAST_CHECK_ROOT bypasses it.
#   test-prepare    : bin/rails db:test:prepare test:prepare (abort on red). BOTH
#                     tasks, in one boot: the test DB and Rails' test:prepare hook,
#                     which builds the gitignored app/assets/builds/tailwind.css.
#                     The lanes below pass explicit test PATHS, and Rails skips its
#                     own test:prepare whenever an argument looks like a path.
#   mapped-tests    : bin/rails test <mapped files>   (skipped when none map)
#   spine           : bin/rails test <spine entries>
#   rubocop-changed : bin/rubocop <changed lintable files> (skipped when none)
# A REGISTRY-GATED repo (a gem, or an `apps` row declaring `release_check:` in
# config/release_repos.yml — turf-vault) runs that declared command as its whole
# lane instead: there is no diff-mapped subset of a gem's suite.
#
# Usage:
#   bin/fast-check <task-slug>            # run all lanes from the task's desk
#   bin/fast-check                        # standalone, no task (no tree check)
#   bin/fast-check [<task-slug>] --list   # print the selected test files, run nothing
#
# Test/CI seams (so the orchestration is exercisable without a real Rails run):
#   FAST_CHECK_CHANGED_FILES       inject the changed-file list (newline/comma
#                                  separated; empty string = no diff)
#   FAST_CHECK_DIFF_BASE           committed-diff base (default: origin/release
#                                  when present, else origin/main)
#   FAST_CHECK_ROOT                repo dir to run in (default: the cwd's git
#                                  toplevel, else this repo)
#   FAST_CHECK_SPINE               spine config path (default: config/fast_cert_spine.yml)
#   FAST_CHECK_MAPPED_CAP          max mapped test files before the lane falls back to
#                                  the convention twins (default: 15, counted AFTER the
#                                  spine dedupe; it caps the fallback too)
#   FAST_CHECK_TEST_PREPARE_CMD    override the test-prepare lane
#   FAST_CHECK_SKIP_TEST_PREPARE   set to 1 only for non-Rails harness tests
#   FAST_CHECK_TEST_CMD            test runner prefix (default: bin/rails test)
#   FAST_CHECK_RUBOCOP_CMD         rubocop prefix (default: bin/rubocop)
#   FAST_CHECK_LANE_TIMEOUT        per-lane ceiling in seconds (default: 900). Past it the
#                                  lane is reported as a HUNG RUNNER, never as a red suite.
#   FAST_CHECK_TASK_BIN            board CLI, read only for the tree check (default: bin/task)
#
# Exit code: 0 = every lane that ran is green (a diff that maps to nothing and a
# checkout with no spine run no test lane, say so, and still exit 0 — CI is the
# net); 1 = a lane failed, hung, or could not launch, or the run was refused
# (wrong tree, a desk with no isolated test DB, a failed test-prepare).

require "optparse"
require "shellwords"
require_relative "lib/fast_lane"
require_relative "lib/repo_root"
require_relative "lib/fast_cert"
require_relative "lib/task_tree"
require_relative "lib/desk_guard"
require_relative "lib/release_registry"
require_relative "lib/lane_runner"

# ROOT = this script's OWN repo (the hub): CONFIG (the spine) anchors here. The
# CODE we run roots at the agent's worktree.
ROOT = File.expand_path("..", __dir__)
TASK_BIN = ENV.fetch("FAST_CHECK_TASK_BIN", File.expand_path("task", __dir__))
SPINE_CONFIG = ENV.fetch("FAST_CHECK_SPINE", File.join(ROOT, "config", "fast_cert_spine.yml"))

options = { list: false }
OptionParser.new do |o|
  o.banner = "Usage: #{$PROGRAM_NAME} [<task-slug>] [--list]"
  o.on("--list", "Print the selected test files (mapped + spine) and exit without running") { options[:list] = true }
  o.on("-h", "--help", "Show this help") do
    puts o
    exit 0
  end
end.parse!

slug = ARGV.shift
root = RepoRoot.code_root(ENV["FAST_CHECK_ROOT"], ROOT)

# --- selection ---------------------------------------------------------------

injected_changed = ENV.key?("FAST_CHECK_CHANGED_FILES")
diff_base = ENV.fetch("FAST_CHECK_DIFF_BASE") { FastCert.default_diff_base(root) } unless injected_changed

changed =
  if injected_changed
    ENV["FAST_CHECK_CHANGED_FILES"].to_s.split(/[\n,]/).map(&:strip).reject(&:empty?)
  else
    FastCert.changed_files(root, diff_base)
  end

breakdown = FastCert.mapping(root, changed)
mapped = breakdown.values.flatten.uniq.sort
spine = FastCert.spine(root, SPINE_CONFIG)
# WHAT THE CONFIG ASKED FOR, kept beside what the checkout RESOLVED: the gap is what
# tells "this diff maps to nothing" (a fact about the code) apart from "this checkout
# is not the hub" (a fact about where the builder is standing).
declared_spine = FastCert.declared_spine(SPINE_CONFIG)
mapped_only = mapped.reject { |t| FastCert.covered_by_spine?(t, spine) }
lintable = FastCert.lintable_files(root, changed)

# THE CAP'S FALLBACK, spine-deduped for the same reason the mapped set is. Both sides
# of the dedupe are kept so the narration can tell "no changed file HAS a twin" (a
# fact about the diff) from "every twin is already a spine entry" (a fact about the
# spine) — see FastCert.empty_fallback_cause.
twins_all = FastCert.convention_twins(root, changed)
spine_twins = twins_all.select { |t| FastCert.covered_by_spine?(t, spine) }
twins_only = twins_all - spine_twins

# THE CAP, decided before anything runs so --list reports the same lane the run
# would execute. See FastCert.cap_decision.
cap = FastCert.cap_decision(mapped_only, breakdown, twins: twins_only)

# THE MARGIN'S NARRATION — one text, so --list and the run cannot disagree about a
# cliff that has not happened yet. The fallback rule lives in cap_decision, so this
# asks that function about a hypothetical cap+1 set rather than restating the rule.
approaching_lines =
  if cap[:approaching]
    over = FastCert.cap_decision(Array.new(cap[:cap] + 1) { |i| "over-#{i}" }, breakdown,
                                 cap: cap[:cap], twins: twins_only)
    lines = ["fast-check: MAPPED LANE NEAR THE CAP — #{cap[:count]} of #{cap[:cap]}, " \
             "#{cap[:cap] - cap[:count]} path(s) of margin left."]
    if cap[:worst_path]
      lines << "  widest mapping: #{cap[:worst_path]} → #{cap[:worst_count]} test file(s)."
    end
    lines << if over[:fallback].any?
               "  over the cap this lane falls back to the #{over[:fallback].size} convention " \
                 "twin(s) of this diff — a NARROWER pre-flight, not none."
             else
               "  this diff has NO convention twin to fall back to, so one path over the cap " \
                 "the mapped lane runs ZERO tests and the pre-flight rests on the spine alone."
             end
    lines << "  what keeps it under: in new test prose cite the CONSTANT that names a path " \
             "rather than spelling the path — a spelling joins this set, a constant does not."
    lines
  else
    []
  end

if options[:list]
  warn "fast-check: #{changed.size} changed file(s) → #{mapped.size} mapped test path(s), " \
       "#{spine.size} spine entr#{spine.size == 1 ? 'y' : 'ies'}, #{lintable.size} lintable file(s)"
  warn "fast-check: mapped cap #{cap[:cap]} — #{cap[:capped] ? 'EXCEEDED' : 'not reached'} " \
       "(#{cap[:count]} after the spine dedupe)"
  approaching_lines.each { |l| warn l }
  if cap[:capped]
    warn "fast-check: capped → falling back to the #{cap[:fallback].size} convention twin(s) " \
         "of #{cap[:fallback_considered]} considered"
    if cap[:fallback].empty? &&
       FastCert.empty_fallback_cause(cap, spine_covered_twins: spine_twins) == :spine_covered
      warn "fast-check: (#{spine_twins.size} twin(s) DO exist — the spine already runs them, " \
           "so they are listed below as spine, not missing)"
    end
  end
  # ONE LINE PER PATH, labelled by what will actually happen to it. The fallback is
  # always a subset of mapped_only (pinned in test/lib/fast_cert_family_test.rb), so
  # this loop prints every twin exactly once.
  mapped_only.each do |t|
    label = if !cap[:capped] then "mapped"
            elsif cap[:fallback].include?(t) then "twin  "
            else "capped"
            end
    puts "#{label}  #{t}"
  end
  spine.each { |t| puts "spine   #{t}" }
  lintable.each { |f| puts "lint    #{f}" }
  exit 0
end

# --- tree check ----------------------------------------------------------------
# Given a slug and an IMPLICIT root (cwd, no FAST_CHECK_ROOT), the root must BE the
# task's tree (its branch, or its .worktrees/<worktree_slug> desk). Run from the
# wrong checkout — the hub primary on main, say — this would report on a tree the
# task never touched, and a green over the wrong tree reads exactly like a green.
if slug && ENV["FAST_CHECK_ROOT"].to_s.strip.empty?
  wrong_root = TaskTree.refusal(task_bin: TASK_BIN, slug: slug, root: root)
  abort "fast-check: #{wrong_root}" if wrong_root
end

# --- desk guard ----------------------------------------------------------------
# Right root, but is it a WHOLE desk? A worktree with no isolated test DB runs its
# suite against the SHARED base test database (config/database.yml falls back there
# when TEST_DATABASE_URL is blank) — so it would pollute, and be polluted by, every
# concurrent suite. Refuse before any lane, and name it as the ENV issue it is.
half_built = DeskGuard.refusal(root)
abort "fast-check: #{half_built}" if half_built

# --- lane plumbing -------------------------------------------------------------

# WHICH REPO THIS CHECKOUT IS, resolved from the tree itself. Every lane decision
# below depends on it: which test command to run, whether a test DB exists to
# prepare, and whether a lint lane is owed at all.
repo = TaskTree.repo_of_checkout(root)

# A GEM REPO HAS NO bin/rails AND NO bin/rubocop; turf-vault is Anchor/Rust. Their
# registry rows declare the command that IS their suite, and this script runs that
# as the whole lane — narrated as the whole thing, never as a chosen subset.
registry_test_cmd = ReleaseRegistry.release_check_cmd(repo)
registry_gate = ReleaseRegistry.registry_gated?(repo)

test_cmd = ENV.fetch("FAST_CHECK_TEST_CMD") { registry_test_cmd || "bin/rails test" }
rubocop_cmd = ENV.fetch("FAST_CHECK_RUBOCOP_CMD", "bin/rubocop")
test_prepare_cmd = ENV.fetch("FAST_CHECK_TEST_PREPARE_CMD", "bin/rails db:test:prepare test:prepare")
# A repo that declares its own gate has no Rails test database to prepare, so the
# lane does not APPLY to it. Declared from the registry, never inferred from whether
# bin/rails happens to exist: a skip inferred from a missing binary turns every
# broken install into a silent pass.
skip_test_prepare = ENV.fetch("FAST_CHECK_SKIP_TEST_PREPARE", "") == "1" || registry_gate

# --- the lane ceiling -----------------------------------------------------------
# NO LANE MAY RUN FOREVER. Measured 2026-08-21: a mapped-tests lane sat 41 minutes at
# 0.0% CPU (its forked workers had SIGSEGVed at the fork and the runner was parked on
# the DRb channel), and the verdict then printed "lane(s) RED". Naming the RUNNER
# instead of the tests is the point of the ceiling. 900s is ~10x the slowest
# legitimate lane on this hardware (a full turf-monster suite is 93s serially).
LANE_TIMEOUT = Integer(ENV.fetch("FAST_CHECK_LANE_TIMEOUT", "900"), exception: false) || 900

# The lane runs in its OWN process group (LaneRunner), so a signal aimed at this
# pre-flight reaps the SUITE too. Returns a LaneRunner::Result, not a bare boolean,
# so a TIMEOUT and an UNLAUNCHABLE command can be told apart from a red suite.
def run_lane(label, cmd, root, env: {}, timeout: LANE_TIMEOUT)
  warn "== #{label}: #{cmd} =="
  started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
  result = LaneRunner.run(env, cmd, chdir: root, timeout: timeout)
  elapsed = format("%.1fs", Process.clock_gettime(Process::CLOCK_MONOTONIC) - started)
  if result.timeout?
    warn "   #{label}: TIMED OUT after #{elapsed} — the RUNNER never produced a verdict"
  elsif result.unlaunchable?
    warn "   #{label}: COULD NOT RUN — #{result.detail}"
    warn "   Nothing ran in this lane. The command is the problem, not your diff."
  else
    warn(result.ok ? "   #{label}: PASS (#{elapsed})" : "   #{label}: FAIL")
  end
  result
end

def skip_lane(label, why)
  warn "== #{label}: skipped (#{why}) =="
  LaneRunner::Result.new(ok: true, outcome: :skipped)
end

# --- run ------------------------------------------------------------------------

overall_started = Process.clock_gettime(Process::CLOCK_MONOTONIC)

unless skip_test_prepare
  prepare_res = run_lane("test-prepare", test_prepare_cmd, root, env: { "RAILS_ENV" => "test" })
  if prepare_res.timeout?
    LaneRunner.timeout_report({ "test-prepare" => prepare_res }, ceiling: LANE_TIMEOUT,
                              tool: "fast-check", env_var: "FAST_CHECK_LANE_TIMEOUT").each { |l| warn l }
    exit 1
  end
  unless prepare_res.ok
    if prepare_res.unlaunchable?
      # A COMMAND THAT IS NOT THERE IS NOT AN ENV GAP. This checkout has no such
      # runner, so there was never a test database to prepare. A repo whose lane is
      # not Rails DECLARES one: a `release_check:` on its row in
      # config/release_repos.yml (turf-vault's row is the worked example). Refusing
      # rather than skipping: a skipped prepare lane reports green on a repo whose
      # tests never ran.
      warn "fast-check: the test-env prepare command COULD NOT RUN — #{prepare_res.detail}. " \
           "NOTHING ran, and this is NOT a diff problem: this checkout (#{root}) has no such runner. " \
           "If this repo's test lane is not Rails, DECLARE one: add a `release_check:` to its row in " \
           "config/release_repos.yml naming the command that IS its suite, and this script will run " \
           "that as the whole lane instead."
    else
      warn "fast-check: test-env prepare failed — see the output above. USUALLY an ENV gap (the test " \
           "DB, or the bundled-asset build), NOT a regression in your diff; but a broken stylesheet " \
           "IN your diff (a bad @apply, an unknown utility, a malformed @theme) fails this lane too. " \
           "Nothing ran; fix it and re-run."
    end
    exit 1
  end
end

# A REGISTRY-GATED REPO RUNS ITS WHOLE GATE AS THE "MAPPED" LANE — the declared
# command IS the suite — and the spine lane skips itself (no satellite has hub
# spine entries). No rubocop lane either: every declaring repo ships no rubocop.
if registry_gate
  mapped_res = run_lane("registry-gate", test_cmd, root)
  spine_res  = skip_lane("spine", "registry-gated repo — its declared gate above is the whole suite")
  rubocop_res = nil
else
  # NOTHING TO RUN is a fact worth stating, not a refusal. A diff that maps to no
  # test on a checkout that resolves none of the spine executes no test lane; the
  # PR's CI runs the whole suite on this exact tree, and that is the verdict.
  if FastCert.executed_test_paths(mapped_only, spine, cap).empty?
    because =
      if cap[:capped]
        "the mapped lane was CAPPED (#{cap[:count]} mapped path(s) over the cap of #{cap[:cap]}) " \
          "with no convention twin to fall back to"
      else
        "the diff maps to no test file"
      end
    where =
      if declared_spine.any? && spine.empty?
        "this checkout resolves NONE of the #{declared_spine.size} spine entries config/fast_cert_spine.yml " \
          "declares (the spine is anchored in the hub; a satellite resolves none of it)"
      else
        "no spine is declared for this run to fall back on"
      end
    warn "fast-check: NO TEST LANE TO RUN — #{because}, and #{where}. Nothing here is a verdict on the " \
         "diff; GitHub CI runs the full suite on the PR, and bin/dor-check reads that."
  end

  mapped_res =
    if mapped_only.empty?
      skip_lane("mapped-tests", mapped.empty? ? "no tests map from the diff" : "all mapped tests covered by the spine")
    elsif cap[:capped]
      # LOUD, because a silently-skipped lane is how a pre-flight stops meaning anything.
      warn ""
      warn "fast-check: MAPPED LANE CAPPED — #{cap[:count]} mapped test file(s) exceeds the cap of #{cap[:cap]}."
      if cap[:worst_path]
        warn "  widest mapping: #{cap[:worst_path]} → #{cap[:worst_count]} test file(s)"
        warn "  Two rungs map this wide. A file WITH a harness twin also pulls that twin's test"
        warn "  FAMILY; a file with none greps for the subject's identity. Either way, this many"
        warn "  matches tells you the selection is broad, not which tests are relevant."
      end
      if cap[:fallback].any?
        warn "  falling back to the CONVENTION TWINS — #{cap[:fallback].size} test file(s), one per changed"
        warn "  file, the set this lane ran before the family hop widened it:"
        cap[:fallback].each { |t| warn "    #{t}" }
        warn "  this is a NARROWER pre-flight, not none. CI runs the full mapped set on the PR."
      else
        case FastCert.empty_fallback_cause(cap, spine_covered_twins: spine_twins)
        when :over_cap
          warn "  the twin fallback is ITSELF over the cap (#{cap[:fallback_considered]} twins), so it degraded"
          warn "  again: running the SPINE ONLY. CI runs the full mapped set on the PR."
        when :spine_covered
          warn "  every existing test twin in this diff (#{spine_twins.size}) is ALREADY A SPINE ENTRY, so"
          warn "  the fallback has nothing to ADD — the spine below RUNS them. Nothing is missing."
        else
          warn "  no changed file has an existing test twin, so there is no fallback to take."
          warn "  running the SPINE ONLY. CI runs the full mapped set on the PR."
        end
      end
      warn "  (override deliberately with FAST_CHECK_MAPPED_CAP=<n>.)"
      warn ""
      if cap[:fallback].any?
        # THE LANE KEEPS ITS NAME: what narrowed is said in the reason, not the label.
        run_lane("mapped-tests", "#{test_cmd} #{cap[:fallback].map(&:shellescape).join(' ')}", root)
      else
        skip_lane("mapped-tests",
                  "#{cap[:count]} mapped file(s) over the cap of #{cap[:cap]}" \
                  "#{cap[:worst_path] ? " (widest: #{cap[:worst_path]} → #{cap[:worst_count]})" : ''}" \
                  " — spine only; CI runs the full set")
      end
    else
      # THE CLIFF ANNOUNCES ITSELF ONE RUN EARLY: this lane is green and runs its whole
      # mapped set; the NEXT one may not.
      unless approaching_lines.empty?
        warn ""
        approaching_lines.each { |l| warn l }
        warn ""
      end
      run_lane("mapped-tests", "#{test_cmd} #{mapped_only.map(&:shellescape).join(' ')}", root)
    end

  spine_res =
    if spine.empty?
      skip_lane("spine", "no spine entries exist in this checkout")
    else
      run_lane("spine", "#{test_cmd} #{spine.map(&:shellescape).join(' ')}", root)
    end

  rubocop_res =
    if lintable.empty?
      skip_lane("rubocop-changed", "no lintable files in the diff")
    else
      run_lane("rubocop-changed", "#{rubocop_cmd} #{lintable.map(&:shellescape).join(' ')}", root)
    end
end

total = Process.clock_gettime(Process::CLOCK_MONOTONIC) - overall_started

lanes = { (registry_gate ? "registry-gate" : "mapped-tests") => mapped_res, "spine" => spine_res }
lanes["rubocop-changed"] = rubocop_res if rubocop_res
unless lanes.each_value.all?(&:ok)
  # THREE VERDICTS, NOT ONE. A hung lane and an unlaunchable command are not red
  # lanes: no test ran, so "lane(s) RED" would send the reader to hunt a regression
  # in code that never executed. The hang is reported FIRST because it needs a
  # different action.
  hung = lanes.select { |_, result| result.timeout? }
  unlaunchable = lanes.select { |_, result| result.unlaunchable? }
  red = lanes.reject { |_, result| result.ok || result.timeout? || result.unlaunchable? }.keys

  if hung.any?
    LaneRunner.timeout_report(hung, ceiling: LANE_TIMEOUT, tool: "fast-check",
                              env_var: "FAST_CHECK_LANE_TIMEOUT").each { |l| warn l }
  end
  unlaunchable.each do |label, result|
    warn "fast-check: lane(s) COULD NOT RUN: #{label} — #{result.detail}. The COMMAND is missing from " \
         "this checkout; your tests neither passed nor failed."
  end
  if red.any?
    warn "fast-check: lane(s) RED: #{red.join(', ')}. Fix, then re-run. (#{format('%.1fs', total)})"
  end
  exit 1
end

ran = lanes.reject { |_, result| result.skipped? }.keys
summary =
  if registry_gate
    "pre-flight green: #{test_cmd} — the repo's whole registry gate (#{format('%.1fs', total)}; " \
      "the same command runs on CI)"
  elsif ran.empty?
    "pre-flight ran no lane (#{format('%.1fs', total)}); CI is the verdict"
  else
    mapped_detail =
      if cap[:capped] && cap[:fallback].any?
        "#{cap[:fallback].size} twin(s) (CAPPED: #{cap[:count]} mapped path(s) over the cap of #{cap[:cap]})"
      elsif cap[:capped]
        "0 mapped (CAPPED: #{cap[:count]} mapped path(s) over the cap of #{cap[:cap]}; spine only)"
      else
        "#{mapped_only.size} mapped"
      end
    "pre-flight green: #{mapped_detail} + #{spine.size} spine test path(s), rubocop on " \
      "#{lintable.size} changed file(s) (#{format('%.1fs', total)}; the full suite runs on CI)"
  end
warn "fast-check: #{summary}. Nothing is recorded on the task — the PR's settled green CI is the verdict."
exit 0
