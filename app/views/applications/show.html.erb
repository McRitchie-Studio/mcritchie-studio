<%# /applications/:slug: one app's identity, its health (a lazy frame) and its CTO. Owner or admin only. docs/agents/system/app-owners.md %>
<section class="max-w-3xl mx-auto px-4 py-10 space-y-6" data-test="application-page" data-app="<%= @app.slug %>">
  <div class="flex items-center gap-4 min-w-0">
    <%= render "applications/app_badge", app: @app, size: "lg" %>
    <div class="min-w-0">
      <h1 class="text-3xl font-bold text-heading break-words"><%= @app.name %></h1>
      <% if @app.description.present? %><p class="text-secondary mt-1"><%= @app.description %></p><% end %>
    </div>
  </div>

  <div class="card p-4 text-sm flex flex-col sm:flex-row sm:items-center gap-3" data-test="application-pipeline-card">
    <div class="min-w-0 flex-1">
      <h2 class="font-semibold text-heading text-base">Pipeline</h2>
      <p class="text-secondary">Your app's work by lane: queued, building, in review, on QA and shipped.</p>
    </div>
    <%= link_to "Open pipeline", pipeline_application_path(@app.slug), class: "btn btn-secondary btn-sm w-full sm:w-auto shrink-0", data: { test: "application-pipeline-link" } %>
  </div>

  <div class="card p-4 space-y-2 text-sm" data-test="application-health-card">
    <h2 class="font-semibold text-heading text-base">Health</h2>
    <%= turbo_frame_tag "application-health", src: health_application_path(@app.slug), loading: :lazy do %>
      <p class="text-muted" data-test="application-health-loading">Reading the latest health report…</p>
    <% end %>
  </div>

  <%# The brand kits this app takes (BrandKitApp; task brand-kit-applied-status), as the /logos brand column shows them. %>
  <% if @kit_links.any? %>
    <div class="card p-4 space-y-2 text-sm" data-test="application-brand-kits">
      <h2 class="font-semibold text-heading text-base">Brand kit</h2>
      <% @kit_links.each do |link| %>
        <% name = Logos::Variant.brand_name(Logos::NavbarLogo.new(link.brand)) %>
        <%= render "brand_kit_apps/status", link:, kit: @kits[link.brand],
                   label: @admin ? link_to(name, logo_brand_path(link.brand), class: "text-primary hover:underline") : name %>
      <% end %>
    </div>
  <% end %>

  <div class="card p-4 space-y-3 text-sm" data-test="application-cto-card">
    <h2 class="font-semibold text-heading text-base">CTO</h2>
    <% if @cto %>
      <div class="flex flex-col sm:flex-row sm:items-center gap-3">
        <div class="flex items-center gap-3 min-w-0 flex-1">
          <%= render "applications/cto_avatar", cto: @cto %>
          <div class="min-w-0">
            <p class="font-semibold text-heading" data-test="application-cto-name"><%= @cto.display_name %></p>
            <% if @cto.client? %>
              <p class="text-secondary"><%= @app.name %>'s CTO. Chat to shape the app, see it on QA, and approve each change.</p>
            <% else %>
              <p class="text-secondary"><%= @app.name %>'s CTO. Sends a daily report to the Discord channel you choose.</p>
            <% end %>
          </div>
        </div>
        <div class="flex flex-col sm:flex-row gap-2 w-full sm:w-auto shrink-0">
          <% if AgentMessages::WebIngest.available?(@cto) %>
            <%= link_to "Chat", chat_application_path(@app.slug), class: "btn btn-primary btn-sm w-full sm:w-auto", data: { test: "application-cto-chat" } %>
          <% end %>
          <% if @cto.settings? %>
            <%= link_to "Settings", settings_agent_path(@cto.slug), class: "btn btn-secondary btn-sm w-full sm:w-auto", data: { test: "application-cto-settings" } %>
          <% end %>
        </div>
      </div>
    <% else %>
      <p class="text-secondary" data-test="application-no-cto">This app has no CTO yet.</p>
    <% end %>
  </div>

  <div class="card p-4 space-y-3 text-sm" data-test="application-usage-card">
    <div class="flex items-baseline justify-between gap-2">
      <h2 class="font-semibold text-heading text-base">Agent usage</h2>
      <span class="text-muted text-xs"><%= Time.current.in_time_zone(AgentUsage::ZONE).strftime("%B") %></span>
    </div>
    <%= render "applications/usage_meter", meter: @meter %>
    <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-4 gap-y-2 border-t border-subtle pt-3" data-test="application-usage-totals">
      <div class="min-w-0">
        <dt class="text-muted text-xs">This month, every answer</dt>
        <dd class="text-body break-words" data-test="application-usage-month"><%= AgentUsage.totals_line(@meter.totals) %></dd>
      </div>
      <div class="min-w-0">
        <dt class="text-muted text-xs">Today</dt>
        <dd class="text-body break-words" data-test="application-usage-today"><%= AgentUsage.totals_line(@today) %></dd>
      </div>
    </dl>
    <% if @admin %>
      <%= form_with scope: :usage_cap, url: usage_cap_application_path(@app.slug), method: :patch,
                    class: "flex flex-col sm:flex-row sm:items-end gap-3 border-t border-subtle pt-3", data: { test: "application-usage-admin" } do |f| %>
        <label class="flex-1 min-w-0 space-y-1">
          <span class="text-muted text-xs block">Tier</span>
          <%= f.select :package_tier, options_for_select(WorkspacePackage.all.map { |p| [ p.name, p.key ] }, @app.package_tier),
                       { include_blank: "No tier" }, class: "input-field w-full min-w-0 text-sm", data: { test: "application-usage-tier" } %>
        </label>
        <label class="flex items-center gap-2 shrink-0 sm:pb-2">
          <%= f.check_box :lifted, { checked: @app.cto_cap_lifted_at.present?, data: { test: "application-usage-lift" } } %>
          <span class="text-body">Lift the cap</span>
        </label>
        <%= f.submit "Save", class: "btn btn-primary btn-sm w-full sm:w-auto shrink-0", data: { test: "application-usage-save" } %>
      <% end %>
      <p class="text-muted text-xs">Only admins see the tier and the lift.<% if @app.cto_cap_lifted_by.present? %> Lifted by <%= @app.cto_cap_lifted_by %>.<% end %></p>
    <% end %>
  </div>

  <% if @owners %>
    <div class="card p-4 space-y-2 text-sm" data-test="application-owners">
      <h2 class="font-semibold text-heading text-base">Owners</h2>
      <% if @owners.any? %>
        <ul class="text-body space-y-1">
          <% @owners.each do |owner| %><li class="break-all"><%= owner.email %></li><% end %>
        </ul>
      <% else %>
        <p class="text-secondary">No owner yet.</p>
      <% end %>
      <p class="text-muted text-xs">Only admins see this list.</p>
    </div>
  <% end %>
</section>
