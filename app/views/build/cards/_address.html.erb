<%# locals: (card:, message:, request_row:) %>
<%# The address card: Xan's suggestions, a field cleaned as they type, and the live availability check (/build/check, the same probe the name step used). The server checks again on the tap and again at Build (queue!), so the live answer is advice, not a lock. %>
<% initial = request_row.subdomain || card["names"].first %>
<%= form_with url: build_request_intake_path(request_row.token), method: :patch,
      class: "rounded-2xl border #{request_row.subdomain ? 'border-primary' : 'border-subtle'} bg-surface p-3 sm:p-4 space-y-3",
      data: { test: "build-card-address" },
      html: { "x-data": "buildAddressCard(#{initial.to_json}, #{build_check_path.to_json})" } do %>
  <%= hidden_field_tag :field, "address" %>
  <%= hidden_field_tag :message_id, message.id %>
  <p class="text-xs font-semibold uppercase tracking-wider text-muted">Your address</p>
  <div class="flex flex-wrap gap-2">
    <% card["names"].each do |name| %>
      <button type="button" class="rounded-full border border-subtle px-3 py-1 font-mono text-xs text-body hover:border-primary"
              :class="name === <%= name.to_json %> && 'border-primary text-heading'" @click="pick(<%= name.to_json %>)" data-test="build-address-suggestion"><%= name %></button>
    <% end %>
  </div>
  <label class="block">
    <span class="sr-only">App address</span>
    <span class="flex items-stretch rounded-xl border border-subtle focus-within:border-primary overflow-hidden">
      <input type="text" name="subdomain" value="<%= initial %>" required autocomplete="off" spellcheck="false" autocapitalize="none"
             class="min-w-0 flex-1 bg-transparent px-3 py-2 font-mono text-sm text-heading focus:outline-none"
             :value="name" @input="onInput($el)" data-test="build-address-input">
      <span class="flex items-center pr-3 text-muted font-mono text-xs whitespace-nowrap">.mcritchie.studio</span>
    </span>
  </label>
  <p class="text-xs min-h-4" aria-live="polite" data-test="build-address-availability">
    <span x-show="state === 'checking'" x-cloak class="text-muted">Checking…</span>
    <span x-show="state === 'available'" x-cloak class="text-success-ink">Available</span>
    <span x-show="state === 'taken'" x-cloak class="text-danger-ink" x-text="reason"></span>
  </p>
  <button type="submit" class="btn btn-primary btn-sm" :disabled="state === 'taken'" data-test="build-choose-address">
    <%= request_row.subdomain ? "Update address" : "Use this address" %>
  </button>
<% end %>
