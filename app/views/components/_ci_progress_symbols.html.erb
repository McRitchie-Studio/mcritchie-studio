<%# locals: (progress:, label: "CI", test_id: "ci-progress-bar", compact: false) %>
<%#
  The SYMBOLIC CI row (v1.2 of visual-ci-progress-bars): when a suite has FEW checks
  (Ci::CheckProgress#symbolic?, under SYMBOLIC_THRESHOLD), each check draws a clean
  line ICON — a green check passed, a red x failed, an amber loader spinning for
  running/queued — mapped 1:1 to the real CI jobs. The slot renders this OVER the
  shared components/_ci_progress_track, so the bar shows alongside the symbols.

  role=img + one summary aria-label so assistive tech reads "6 of 8 checks passed",
  not eight bare icons; each icon still carries its job name as a hover title.
%>
<% if progress.respond_to?(:present?) && progress.present? %>
  <div class="ci-progress-symbols flex items-center gap-x-2 gap-y-1 flex-wrap"
       data-test="<%= test_id %>-symbols"
       data-ci-state="<%= progress.state %>"
       role="img"
       aria-label="<%= progress.passed %> of <%= progress.total %> CI checks passed">
    <span class="font-semibold uppercase tracking-wide text-muted text-[10px] leading-none"><%= label %></span>
    <span class="flex items-center gap-1 flex-wrap">
      <% progress.checks.each do |check| %>
        <% symbol = ci_check_symbol(check) %>
        <span class="ci-check-symbol inline-flex items-center justify-center <%= symbol[:color] %> <%= "animate-spin" if symbol[:spin] %>"
              data-test="ci-check-symbol"
              data-ci-check-state="<%= check.state %>"
              title="<%= check.name.presence || symbol[:label].capitalize %> — <%= symbol[:label] %>"><%
          case check.state
          when :passed %><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4.5 12.75l6 6 9-13.5"/></svg><%
          when :failed %><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18 18 6M6 6l12 12"/></svg><%
          else %><svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" aria-hidden="true"><circle class="opacity-25" cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5"/><path class="opacity-90" d="M12 3a9 9 0 0 1 9 9" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg><%
          end %></span>
      <% end %>
    </span>
  </div>
<% end %>
