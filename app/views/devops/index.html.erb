<section class="space-y-8">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="label-upper">Operations</p>
      <h2 class="text-2xl font-bold text-heading mt-1">DevOps Test Suites</h2>
      <p class="text-secondary text-sm mt-2 max-w-3xl">
        Catalog of local, QA, devnet, and production checks. Mutating suites require an explicit target environment and should not run against production unless named as a production-safe smoke.
      </p>
    </div>
    <%= link_to "Task Board", tasks_path, class: "btn btn-outline" %>
  </div>

  <div class="grid gap-6">
    <% @apps.each do |slug, app| %>
      <article class="border border-subtle rounded-lg bg-surface overflow-hidden">
        <header class="flex flex-wrap items-center justify-between gap-3 px-5 py-4 border-b border-subtle">
          <div>
            <h3 class="text-xl font-bold text-heading"><%= app.fetch("display_name", slug) %></h3>
            <div class="flex flex-wrap gap-3 text-xs mt-2">
              <% if app["qa_url"].present? %>
                <%= link_to "QA", app["qa_url"], class: "text-primary hover:underline", target: "_blank", rel: "noopener" %>
              <% end %>
              <% if app["production_url"].present? %>
                <%= link_to "Production", app["production_url"], class: "text-primary hover:underline", target: "_blank", rel: "noopener" %>
              <% end %>
            </div>
          </div>
          <span class="text-xs text-muted font-mono"><%= slug %></span>
        </header>

        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead class="bg-surface-alt text-secondary">
              <tr>
                <th class="text-left px-4 py-3 font-semibold">Suite</th>
                <th class="text-left px-4 py-3 font-semibold">Env</th>
                <th class="text-left px-4 py-3 font-semibold">When Run</th>
                <th class="text-left px-4 py-3 font-semibold">Command</th>
                <th class="text-left px-4 py-3 font-semibold">Risk</th>
              </tr>
            </thead>
            <tbody>
              <% app.fetch("suites", []).each do |suite| %>
                <tr class="border-t border-subtle align-top">
                  <td class="px-4 py-3">
                    <p class="font-semibold text-heading"><%= suite.fetch("name") %></p>
                    <% if suite["notes"].present? %>
                      <p class="text-xs text-muted mt-1"><%= suite["notes"] %></p>
                    <% end %>
                  </td>
                  <td class="px-4 py-3">
                    <span class="px-2 py-1 rounded text-[11px] font-bold uppercase bg-surface-alt text-secondary border border-subtle">
                      <%= suite.fetch("environment") %>
                    </span>
                  </td>
                  <td class="px-4 py-3 text-secondary"><%= suite.fetch("trigger") %></td>
                  <td class="px-4 py-3">
                    <code class="block text-xs text-body bg-inset rounded px-2 py-1 whitespace-nowrap"><%= suite.fetch("command") %></code>
                  </td>
                  <td class="px-4 py-3">
                    <% if suite["mutates"] %>
                      <span class="px-2 py-1 rounded text-[11px] font-bold bg-orange-900/50 text-orange-300 border border-orange-700/50">MUTATES</span>
                    <% else %>
                      <span class="px-2 py-1 rounded text-[11px] font-bold bg-green-900/50 text-green-300 border border-green-700/50">READ ONLY</span>
                    <% end %>
                  </td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </article>
    <% end %>
  </div>
</section>

<% reg = @worktree_registry %>
<section class="space-y-6 mt-12">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <p class="label-upper">Local Fleet</p>
      <h2 class="text-2xl font-bold text-heading mt-1">Worktrees &amp; Slots</h2>
      <p class="text-secondary text-sm mt-2 max-w-3xl">
        Live agent worktree registry: Redis-slot capacity, per-worktree health, and cleanup signals
        sourced from <code class="text-xs text-muted font-mono">.agents/worktree-registry.json</code>.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <% if reg.generated_at.present? %>
        <span class="text-xs text-muted font-mono">updated <%= time_ago_in_words(reg.generated_at) %> ago</span>
      <% end %>
      <%= link_to "Refresh", devops_path(refresh: 1), class: "btn btn-outline" %>
    </div>
  </div>

  <% if reg.empty? %>
    <div class="border border-subtle rounded-lg bg-surface px-6 py-12 text-center">
      <p class="text-heading font-semibold">No worktree registry found</p>
      <p class="text-secondary text-sm mt-2 max-w-xl mx-auto">
        Run <code class="text-xs text-muted font-mono">bin/agent-worktree snapshot --write</code>
        from the hub, or use Refresh, to generate the registry.
      </p>
    </div>
  <% else %>
    <%
      cap   = reg.capacity
      range = reg.redis_db_range
      sum   = reg.summary
      db_min = range["min"].to_i
      db_max = range["max"].to_i
      ceiling = db_min + cap["physical_max"].to_i - 1 if cap["physical_max"].present?
      by_db = reg.worktrees_by_redis_db
    %>

    <%# Capacity band %>
    <article class="border border-subtle rounded-lg bg-surface overflow-hidden">
      <header class="px-5 py-4 border-b border-subtle">
        <h3 class="text-lg font-bold text-heading">Redis Slot Capacity</h3>
      </header>
      <div class="px-5 py-4">
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
          <% [["Floor", cap["floor"]], ["Step", cap["step"]], ["Current", cap["current"]], ["Used", cap["used"]], ["Free", cap["free"]], ["Physical Max", cap["physical_max"]]].each do |label, value| %>
            <div class="border border-subtle rounded bg-inset px-3 py-2">
              <p class="label-upper text-[10px]"><%= label %></p>
              <p class="text-xl font-bold text-heading mt-1"><%= value.nil? ? "—" : value %></p>
            </div>
          <% end %>
        </div>

        <p class="text-xs text-muted font-mono mt-4">
          DB range <%= db_min %>–<%= db_max %><% if ceiling %> · physical ceiling DB <%= ceiling %><% end %>
        </p>

        <%# Slot strip: one cell per allocatable DB in the current band. %>
        <% if db_max >= db_min %>
          <div class="flex flex-wrap gap-1 mt-3">
            <% (db_min..db_max).each do |db| %>
              <% wt = by_db[db] %>
              <% if wt %>
                <span class="px-2 py-1 rounded text-[11px] font-mono bg-green-900/50 text-green-300 border border-green-700/50"
                      title="<%= wt["label"] %>">
                  <%= db %>
                </span>
              <% else %>
                <span class="px-2 py-1 rounded text-[11px] font-mono bg-surface-alt text-muted border border-subtle">
                  <%= db %>
                </span>
              <% end %>
            <% end %>
          </div>
          <p class="text-[11px] text-muted mt-2">
            <span class="inline-block w-2 h-2 rounded-sm bg-green-700/70 align-middle"></span> occupied
            <span class="inline-block w-2 h-2 rounded-sm bg-surface-alt border border-subtle align-middle ml-3"></span> free
          </p>
        <% end %>
      </div>
    </article>

    <%# Summary counts %>
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      <% [["Worktrees", sum["worktrees"]], ["Issues", sum["issues"]], ["Cleanup", sum["cleanup_candidates"]], ["Dirty", sum["dirty_worktrees"]], ["Running/Busy", sum["running_or_port_busy"]], ["Behind main", sum["behind_origin_main"]]].each do |label, value| %>
        <div class="border border-subtle rounded bg-surface px-3 py-2">
          <p class="label-upper text-[10px]"><%= label %></p>
          <p class="text-lg font-bold text-heading mt-1"><%= value.nil? ? "—" : value %></p>
        </div>
      <% end %>
    </div>

    <%# Worktree table %>
    <article class="border border-subtle rounded-lg bg-surface overflow-hidden">
      <header class="px-5 py-4 border-b border-subtle">
        <h3 class="text-lg font-bold text-heading">Active Worktrees</h3>
      </header>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead class="bg-surface-alt text-secondary">
            <tr>
              <th class="text-left px-4 py-3 font-semibold">Worktree</th>
              <th class="text-left px-4 py-3 font-semibold">App</th>
              <th class="text-left px-4 py-3 font-semibold">Branch</th>
              <th class="text-left px-4 py-3 font-semibold">Health</th>
              <th class="text-left px-4 py-3 font-semibold">Port</th>
              <th class="text-left px-4 py-3 font-semibold">Redis</th>
              <th class="text-left px-4 py-3 font-semibold">State</th>
              <th class="text-left px-4 py-3 font-semibold">Issues</th>
            </tr>
          </thead>
          <tbody>
            <% reg.worktrees.each do |wt| %>
              <tr class="border-t border-subtle align-top">
                <td class="px-4 py-3">
                  <p class="font-semibold text-heading font-mono text-xs"><%= wt["task"] %></p>
                  <% if wt["commit_subject"].present? %>
                    <p class="text-xs text-muted mt-1"><%= wt["commit_subject"] %></p>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-secondary"><%= wt["app"] %></td>
                <td class="px-4 py-3">
                  <code class="text-xs text-body"><%= wt["branch"] %></code>
                  <span class="block text-[11px] text-muted font-mono mt-1"><%= wt["head"] %></span>
                </td>
                <td class="px-4 py-3">
                  <% health = wt["health"].to_s %>
                  <% health_class = case health
                       when "up" then "bg-green-900/50 text-green-300 border-green-700/50"
                       when "port-busy" then "bg-orange-900/50 text-orange-300 border-orange-700/50"
                       else "bg-surface-alt text-secondary border-subtle"
                     end %>
                  <span class="px-2 py-1 rounded text-[11px] font-bold uppercase border <%= health_class %>">
                    <%= health.presence || "?" %>
                  </span>
                  <% if wt["up_code"].present? %>
                    <span class="block text-[11px] text-muted font-mono mt-1"><%= wt["up_code"] %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3">
                  <% if wt["local_url"].present? %>
                    <%= link_to wt["app_port"], wt["local_url"], class: "text-primary hover:underline font-mono text-xs", target: "_blank", rel: "noopener" %>
                  <% else %>
                    <span class="text-muted font-mono text-xs"><%= wt["app_port"] %></span>
                  <% end %>
                </td>
                <td class="px-4 py-3 text-muted font-mono text-xs"><%= wt["redis_db"] %></td>
                <td class="px-4 py-3">
                  <div class="flex flex-wrap gap-1">
                    <% if wt["equivalent_to_origin_main"] || wt["merged_to_origin_main"] %>
                      <span class="px-2 py-1 rounded text-[11px] font-bold bg-blue-900/50 text-blue-300 border border-blue-700/50">MERGED</span>
                    <% end %>
                    <% if wt["dirty"] %>
                      <span class="px-2 py-1 rounded text-[11px] font-bold bg-yellow-900/50 text-yellow-300 border border-yellow-700/50">DIRTY</span>
                    <% end %>
                    <% if wt["cleanup_candidate"] %>
                      <span class="px-2 py-1 rounded text-[11px] font-bold bg-red-900/50 text-red-300 border border-red-700/50">CLEANUP</span>
                    <% end %>
                  </div>
                </td>
                <td class="px-4 py-3">
                  <% issue_count = Array(wt["issues"]).size %>
                  <% if wt["compare_url"].present? %>
                    <%= link_to "#{issue_count} issue#{'s' unless issue_count == 1}", wt["compare_url"], class: "text-primary hover:underline text-xs", target: "_blank", rel: "noopener" %>
                  <% else %>
                    <span class="text-muted text-xs"><%= issue_count %></span>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </article>
  <% end %>
</section>
