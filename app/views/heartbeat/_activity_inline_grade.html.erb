<%# Inline quick-grade for an activity — the good/not disposition radios for ONE grader
    (Alex, or the McRitchie audit of Alex). The activity analogue of the per-action
    _feedback_cell radios: they POST grader + disposition to the JSON activity grade
    endpoint via the activity row's `quickGrade` fetch (@change), which dispatches
    hb:activity-graded so the row's live markers update in place. The fuller "grade ▸"
    drawer stays the home for the slug / long-form / bank detail — these are the fast
    lane. The checked state is server-rendered (Nokogiri-visible, no-JS correct) and
    bound to the row's Alpine `grades.<grader>` so a drawer/quick save syncs it live.
    Locals: activity, grader ("alex" | "mcr"), grade (ActionGrade | nil). %>
<form action="<%= heartbeat_activity_grade_path(activity) %>" method="post"
      class="hb-radioform hb-evtquick-form" data-test="event-inline-grade"
      data-grader="<%= grader %>" @submit.prevent>
  <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
  <input type="hidden" name="grader" value="<%= grader %>">
  <span class="hb-evtquick-role"><%= grader == "mcr" ? "M" : "A" %></span>
  <span class="hb-radiogrp" @click.stop>
    <label class="hb-rb <%= "on-good" if grade&.good? %>"
           :class="{ 'on-good': grades.<%= grader %> && grades.<%= grader %>.disposition === 'good' }">
      <input type="radio" name="disposition" value="good" <%= "checked" if grade&.good? %>
             :checked="grades.<%= grader %> && grades.<%= grader %>.disposition === 'good'"
             @change="quickGrade($event)">
      Good
    </label>
    <label class="hb-rb <%= "on-not" if grade&.not_good? %>"
           :class="{ 'on-not': grades.<%= grader %> && grades.<%= grader %>.disposition === 'not' }">
      <input type="radio" name="disposition" value="not" <%= "checked" if grade&.not_good? %>
             :checked="grades.<%= grader %> && grades.<%= grader %>.disposition === 'not'"
             @change="quickGrade($event)">
      Not
    </label>
  </span>
  <button type="button" class="hb-gradeclear <%= "is-visible" if grade.present? %>"
          data-test="event-grade-clear" title="Clear feedback"
          aria-label="Clear <%= grader == "mcr" ? "McRitchie" : "Alex" %> feedback"
          :class="{ 'is-visible': !!grades.<%= grader %> }"
          :disabled="!grades.<%= grader %>"
          @click.stop="clearGrade($event)">&times;</button>
</form>
