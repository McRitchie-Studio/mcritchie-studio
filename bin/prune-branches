#!/usr/bin/env ruby
# frozen_string_literal: true

# prune-branches — delete remote feat/* branches that are merged into main and done.
#
#   bin/prune-branches                 # dry run: counts and the first 20 names
#   bin/prune-branches --yes           # delete them from origin
#   bin/prune-branches --repo <path>   # a checkout other than the hub primary
#
# `bin/release archive` drives it: the dry run in its preview, --yes after the
# confirm. What is deleted and what is refused: bin/lib/branch_prune.rb.
#
# Both modes run `git fetch --prune origin` first, which refreshes the checkout's
# remote-tracking refs and moves nothing on the remote.
#
# The last line of output is the tagged summary (BRANCH_PRUNE_SUMMARY {json}) the
# archive reads. Exit 1 when the plan refused.

require_relative "lib/cli_arg_guard"
require_relative "lib/branch_prune"
require_relative "lib/projects_root"

USAGE = <<~TXT
  usage: bin/prune-branches [--repo <path>] [--dry-run] [--yes]

    Delete remote feat/* branches whose tip is in origin/main and whose task is
    shipped or archived. Never main, release or accepted; never a branch with an
    open PR or one a desk has checked out.

    --repo <path>   the checkout whose origin is pruned (default: the hub primary)
    --dry-run       report only (the default without --yes)
    --yes           delete the branches
    --help, -h      this text — DELETES NOTHING
TXT

ARGS = CliArgGuard.guard!(
  ARGV,
  program: "prune-branches",
  usage: USAGE,
  bool: %w[--dry-run --yes],
  value: %w[--repo],
  help_exit: 0,
  consequence: "NOTHING was deleted."
)

apply = ARGS.bool?("--yes") && !ARGS.bool?("--dry-run")
repo = File.expand_path(ARGS.first("--repo") || File.join(ProjectsRoot.default_projects_dir, "mcritchie-studio"))
task_bin = ENV["PRUNE_BRANCHES_TASK_BIN"].to_s.strip
task_bin = File.expand_path("task", __dir__) if task_bin.empty?

def refused(reason)
  BranchPrune::Plan.new(prune: [], skipped: {}, refusal: reason)
end

gh_env, refusal = BranchPrune.agent_env
refusal ||= BranchPrune.fetch!(repo, env: gh_env || {})
remote, refusal = BranchPrune.remote_branches(repo) unless refusal
merged, refusal = BranchPrune.merged_into_main(repo) unless refusal
desks, refusal = BranchPrune.desk_branches(repo) unless refusal
heads, refusal = BranchPrune.open_pr_heads(repo, env: gh_env) unless refusal
slugs, branches, refusal = BranchPrune.done_tasks(task_bin: task_bin) unless refusal

plan =
  if refusal
    refused(refusal)
  else
    BranchPrune.plan(remote: remote, merged: merged, open_pr_heads: heads, desk_branches: desks,
                     done_slugs: slugs, done_branches: branches)
  end

puts "remote branches: #{repo}"
if plan.refusal
  puts "  refused: #{plan.refusal}"
else
  puts "  #{plan.prune.size} merged feat/* branch(es) #{apply ? 'to delete' : 'would go'}"
  plan.skipped.each { |reason, n| puts "  kept #{n}: #{reason}" }
  plan.names.first(BranchPrune::SAMPLE_SIZE).each { |n| puts "    #{n}" }
  puts "    …(+#{plan.prune.size - BranchPrune::SAMPLE_SIZE})" if plan.prune.size > BranchPrune::SAMPLE_SIZE
end

applying = apply && !plan.refusal
removed, push_refusal = applying ? BranchPrune.apply!(plan, repo, env: gh_env) : [nil, nil]
puts "  deleted #{removed.size} branch(es)" if removed
puts "  refused: #{push_refusal}" if push_refusal
refusal = plan.refusal || push_refusal
puts BranchPrune.summary_line(BranchPrune.summary(plan, applied: applying, removed: removed, refusal: refusal))
exit(refusal ? 1 : 0)
