#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/atomic-event — compatibility entrypoint for the agent's SELF-NARRATION CLI.
# The canonical name is bin/agent-activity. The agent declares the meaningful
# ACTIVITIES of its own trajectory as it works:
#
#   bin/atomic-event start --category Explore --reason "find issue with api"
#   … (the agent's raw tool-calls attribute server-side to this open activity) …
#   bin/atomic-event next  --outcome "found the nil-guard" \
#                          --category Edit --reason "add the guard"
#   … (more work under the new activity) …
#   bin/atomic-event end   --outcome "guard added, tests green"
#
# `start` opens an activity (auto-closing any prior open one); `end` closes the
# session's open activity with an outcome. `start`/`next` also take `--agent <soul>`
# (avi/carl/…) to stamp the ACTING soul on the activity, distinct from the base
# session mascot — an unknown slug is coerced to nil server-side. They also take
# `--task <slug>` to stamp the activity's task EXPLICITLY — so the FIRST working activity
# is task-attributed immediately, instead of a blank TASK until a later
# `bin/task`/`bind-task` write populates the session marker. `--task` wins over
# the desk/session marker; absent it, resolve_marker still infers the task from a
# `feat/<slug>` checkout branch. `next` is the
# BOUNDARY transition — it
# closes the prior activity WITH an outcome and opens the next one WITH a reason in
# ONE call, so activities resolve instead of hanging half-narrated (`start` also
# accepts `--outcome` for the same crossover). `close-open` is the session-end
# teardown (wired to the Claude Code SessionEnd hook): it closes any activity still
# open so the last one never hangs open forever. `next`/`end` also take
# `--key-method <code>` (+ optional `--key-lang bash|ruby|sql|js`) to stamp the
# COMPLETED activity's one load-bearing call — the copyable line another agent would
# rerun (e.g. `User.find_by(email: ...)`); most activities have none, so it's optional.
# There is NO per-call classifier
# and NO reader sub-agent — the agent narrates. Raw tool-calls attribute to
# whichever activity is open (see AgentAction.capture), so the activity vocabulary +
# outcomes are the coarse, meaningful layer over the raw stream.
#
# Targets the SAME endpoint as bin/atomic-capture-hook (ATOMIC_CAPTURE_URL,
# default http://localhost:3000) — events and actions MUST land on the same
# server for the server-side activity attribution to work. Token + HTTP live on the
# shared AgentApi client (bin/lib/agent_api.rb): the agent secret sources the
# same way bin/task does (AGENT_API_SECRET → 1Password → repo .env) and the
# on-disk token cache is shared with the hook.
#
# NON-FATAL: this never breaks the agent's flow. Every error is swallowed, a one
# line note goes to stderr, and the process always exits 0.

require "json"
require "fileutils"
require_relative "lib/agent_api"

class AgentActivityCli
  CATEGORIES = %w[
    Explore Edit Verify Version Workflow Delegate Clarify Remote Research Plan
  ].freeze

  OPEN_TIMEOUT = 2
  READ_TIMEOUT = 5

  def initialize(env: ENV, out: $stdout, err: $stderr, input: $stdin)
    @env = env
    @out = out
    @err = err
    @in  = input
    @api = AgentApi.new(env: env, open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT)
  end

  # Entry point. Parses argv, dispatches the command, and ALWAYS returns (the main
  # guard exits 0 regardless) — nothing here may break the calling session.
  def run(argv)
    command = argv.shift
    flags = parse_flags(argv)

    case command
    when "start", "next" then start(flags) # `next` = boundary open (carries --outcome)
    when "end"           then finish(flags)
    when "close-open"    then close_open(flags)
    when "heartbeat"     then heartbeat(argv, flags) # sticky acting-agent for a soul run
    when "grade"         then grade_activity(argv, flags) # bearer AGENT grade of a resolved activity
    when "awaiting"      then awaiting(flags)             # resolved activities still awaiting an Alex grade
    else
      warn_note("usage: atomic-event start --category <C> --reason <text> [--outcome <text>] [--agent <soul>] [--task <slug>] | " \
                "next --outcome <text> --category <C> --reason <text> [--key-method <code> [--key-lang <lang>]] [--agent <soul>] [--task <slug>] | " \
                "end [--outcome <text>] [--key-method <code> [--key-lang <lang>]] | close-open [--outcome <text>] | " \
                "heartbeat <soul> | heartbeat --clear | " \
                "grade <activity-id> --disposition good|not [--slug <text>] [--long-form <text>] [--bank|--discard] | " \
                "awaiting [--limit <n>]")
    end
  rescue StandardError => e
    warn_note("atomic-event failed (ignored): #{e.class}: #{e.message}")
  end

  # ── Commands ──────────────────────────────────────────────────────────────

  def start(flags)
    sid = resolve_session_id(flags)
    return warn_note("atomic-event: no session id — nothing to narrate") unless present?(sid)

    category = flags["category"].to_s.strip
    reason   = flags["reason"].to_s.strip
    return warn_note("atomic-event start needs --category and --reason") if category.empty? || reason.empty?
    unless CATEGORIES.include?(category)
      return warn_note("atomic-event: unknown --category #{category.inspect} " \
                       "(one of: #{CATEGORIES.join(', ')})")
    end

    # BOUNDARY transition: --outcome (the `next` idiom, also valid on `start`)
    # stamps the auto-closed prior activity's outcome as we cross into this one, so an
    # activity resolves in the same call that opens the next instead of hanging with a
    # NULL outcome. Empty ⇒ dropped below ⇒ legacy behavior (prior auto-closes null).
    prior_outcome = flags["outcome"].to_s.strip

    # --agent stamps the ACTING soul on the activity, distinct from the base session
    # mascot. Passed through verbatim — the server coerces an unknown slug to nil
    # (AgentActivity::SOULS), so we never validate it here. When --agent is ABSENT,
    # fall back to the session's STICKY acting-agent (set by `atomic-event heartbeat
    # <soul>`), so a `<Soul> Heartbeat` self-attributes EVERY activity as the soul —
    # stacked over the stable base mascot — without re-passing --agent each call.
    # Explicit --agent always WINS over the sticky (a delegated reviewer keeps its
    # own soul); the sticky clears at session end (close-open) or `heartbeat --clear`.
    agent = flags["agent"].to_s.strip
    agent = read_acting_agent(sid).to_s if agent.empty?

    # --task stamps the activity's task EXPLICITLY and WINS over the desk/session
    # marker — so a session's FIRST activity is task-attributed immediately, without
    # waiting for a `bin/task`/`bind-task` write to populate the session marker
    # (the observed blank-TASK-until-late-bind case). Absent it, resolve_marker
    # still resolves the task from the desk marker or a `feat/<slug>` branch.
    task = flags["task"].to_s.strip

    marker = resolve_marker(session_id: sid)
    res = post("/api/v1/agent_activities", {
      "session_id"    => sid,
      "category"      => category,
      "reason"        => reason,
      "prior_outcome" => prior_outcome,
      # `next --key-method` stamps the COMPLETED (auto-closed) activity's one
      # load-bearing call, same crossover semantics as --outcome.
      "prior_key_method"      => flags["key-method"].to_s.strip,
      "prior_key_method_lang" => flags["key-lang"].to_s.strip,
      "task_slug"     => present?(task) ? task : marker["task_slug"],
      "mascot"        => marker["mascot"],
      "stage"         => marker["stage"],
      "agent"         => agent
    }.reject { |_, v| v.to_s.empty? })

    opened = "opened #{category} · #{reason}"
    report(res, prior_outcome.empty? ? opened : "#{prior_outcome} → #{opened}")
  end

  def finish(flags)
    sid = resolve_session_id(flags)
    return warn_note("atomic-event: no session id — nothing to narrate") unless present?(sid)

    outcome = flags["outcome"].to_s.strip
    # Resolve the acting soul the SAME way `start` does (explicit --agent, else the
    # session's sticky heartbeat agent) and send it, so close targets THIS soul's
    # LANE — a reviewer's `end` resolves its own activity, not whichever soul opened
    # last in the shared session. Empty ⇒ the nil lane (the orchestrator's).
    agent = flags["agent"].to_s.strip
    agent = read_acting_agent(sid).to_s if agent.empty?

    res = post("/api/v1/agent_activities/close", {
      "session_id" => sid,
      "agent"      => agent,
      "outcome"    => outcome,
      # `end --key-method` stamps the closing activity's one load-bearing call
      # (e.g. `User.find_by(email: ...)`); --key-lang overrides the inferred badge.
      "key_method"      => flags["key-method"].to_s.strip,
      "key_method_lang" => flags["key-lang"].to_s.strip
    }.reject { |_, v| v.to_s.empty? })

    report(res, outcome.empty? ? "closed activity" : "closed · #{outcome}")
  end

  # Session-end teardown — closes ANY activity still open for the session so the last
  # one never hangs open forever (and trailing actions never fall into
  # "Unlabeled"). Wired to the Claude Code SessionEnd hook, which pipes its event
  # JSON on stdin; we take the session id from a --session flag or the harness env
  # first, then fall back to that stdin payload.
  def close_open(flags)
    sid = resolve_session_id(flags)
    sid = session_from_stdin unless present?(sid)
    return warn_note("atomic-event: no session id — nothing to close") unless present?(sid)

    outcome = flags["outcome"].to_s.strip
    outcome = "session ended" if outcome.empty?
    res = post("/api/v1/agent_activities/close_all", {
      "session_id" => sid,
      "outcome"    => outcome
    })

    # Session end also drops any STICKY heartbeat agent so it can never leak into a
    # later run that happens to reuse this session id.
    clear_acting_agent(sid)

    report(res, "closed open activities · #{outcome}")
  end

  # Sets (or clears) the session's STICKY acting-agent — the soul that EVERY
  # subsequent activity attributes to until session end or `heartbeat --clear`. This is
  # how a `<Soul> Heartbeat` self-attributes its OWN top-level activities (orient,
  # workflow, verify) as the soul, stacked over the stable base session mascot,
  # instead of the observed fall-back to the base mascot alone. An explicit
  # `--agent` on an individual `start`/`next` still WINS over the sticky, so a
  # delegated reviewer keeps its own soul. Local-only (no HTTP) — writes a tiny
  # per-session file beside the session marker; a fresh session never inherits it.
  def heartbeat(argv, flags)
    sid = resolve_session_id(flags)
    return warn_note("atomic-event: no session id — nothing to set") unless present?(sid)

    # The soul (if any) is the LEADING positional — `heartbeat <soul>` — never a
    # flag VALUE elsewhere in argv (so `heartbeat --session X` doesn't read X as the
    # soul). `--agent <soul>` is the explicit alternative and wins.
    first = argv.first.to_s.strip
    positional = first.start_with?("--") ? "" : first

    if flags.key?("clear") || positional == "clear" || positional == "off"
      clear_acting_agent(sid)
      @out.puts("atomic-event: heartbeat cleared — activities return to the base session mascot")
      return
    end

    soul = flags["agent"].to_s.strip
    soul = positional if soul.empty?
    return warn_note("atomic-event: heartbeat needs a soul (e.g. `heartbeat avi`) or `heartbeat --clear`") if soul.empty?

    write_acting_agent(sid, soul)
    @out.puts("atomic-event: heartbeat set — every activity attributes to #{soul} " \
              "(stacked over the base mascot) until `heartbeat --clear` or session end")
  end

  # `grade <activity-id> --disposition good|not [--slug …] [--long-form …] [--bank|--discard]`
  # — the bearer AGENT grade of a resolved activity (the CLI half of the Alex heartbeat
  # grade-events loop; the browser drawer is admin-only). The activity id is the LEADING
  # positional. The server FORCES the grader to alex (the mcr audit stays admin-only),
  # so no --grader flag exists. Reports what landed, but ALWAYS exits 0.
  def grade_activity(argv, flags)
    first = argv.first.to_s.strip
    activity_id = first.start_with?("--") ? "" : first
    if activity_id.empty?
      return warn_note("atomic-event grade needs an activity id " \
                       "(e.g. `grade 42 --disposition good --slug \"clean sharp outcome\"`)")
    end

    intent = "bank" if flags["bank"]
    intent = "discard" if flags["discard"]
    body = {
      "disposition" => flags["disposition"].to_s.strip,
      "slug"        => flags["slug"].to_s.strip,
      "long_form"   => flags["long-form"].to_s.strip,
      "intent"      => intent
    }.reject { |_, v| v.to_s.empty? }

    res = post("/api/v1/agent_activities/#{activity_id}/grade", body)
    if res && res.code.to_i.between?(200, 299)
      data = parse_data(res)
      mark = data["disposition"] == "not" ? "✗" : "✓"
      tail = data["banked"] ? " · banked" : (data["discarded"] ? " · discarded" : "")
      @out.puts("atomic-event: graded activity #{activity_id} #{mark} #{data['slug']}#{tail}")
    elsif res
      warn_note("atomic-event: grade failed — server said #{res.code}")
    else
      warn_note("atomic-event: grade failed — no response")
    end
  end

  # `awaiting [--limit <n>]` — the resolved activities still awaiting an Alex grade (the
  # READ half of grade-events), so the agent knows WHAT to grade and their ids
  # without scraping the HTML page. One line per activity; ALWAYS exits 0.
  def awaiting(flags)
    limit = flags["limit"].to_s.strip
    path = "/api/v1/agent_activities/awaiting_grade"
    path += "?limit=#{limit}" unless limit.empty?

    res = get(path)
    unless res && res.code.to_i.between?(200, 299)
      return warn_note("atomic-event: couldn't fetch activities awaiting grade")
    end

    rows = parse_data(res)
    rows = [] unless rows.is_a?(Array)
    return @out.puts("atomic-event: no activities awaiting grade") if rows.empty?

    @out.puts("Activities awaiting an Alex grade (#{rows.size}):")
    rows.each do |r|
      outcome = present?(r["outcome"]) ? r["outcome"] : "(no outcome)"
      task = present?(r["task_slug"]) ? "  [#{r['task_slug']}]" : ""
      @out.puts("  ##{r['id']}  #{r['category']} · #{r['reason']} → #{outcome}#{task}")
    end
  end

  # ── argv + session/marker resolution ──────────────────────────────────────

  # Minimal --flag value parser (repeats: last wins). Bare/unknown args ignored.
  # A flag whose next token is ANOTHER flag (or the end) is a valueless BOOLEAN
  # (stored as true) — so `--clear --session X` reads clear=true + session=X rather
  # than clear swallowing "--session" as its value. Values never legitimately start
  # with "--" in this CLI (categories/reasons/outcomes/slugs/souls), so this is a
  # strict improvement over consuming the next token unconditionally.
  def parse_flags(argv)
    flags = {}
    i = 0
    while i < argv.length
      arg = argv[i]
      if arg.start_with?("--")
        nxt = argv[i + 1]
        if nxt.nil? || nxt.start_with?("--")
          flags[arg.delete_prefix("--")] = true
          i += 1
        else
          flags[arg.delete_prefix("--")] = nxt
          i += 2
        end
      else
        i += 1
      end
    end
    flags
  end

  # --session override (tests / explicit), else the agent session id the harness
  # exposes (Claude: CLAUDE_CODE_SESSION_ID, Codex: CODEX_THREAD_ID).
  def resolve_session_id(flags)
    explicit = flags["session"].to_s.strip
    return explicit unless explicit.empty?

    claude = @env["CLAUDE_CODE_SESSION_ID"].to_s.strip
    return claude unless claude.empty?

    @env["CODEX_THREAD_ID"].to_s.strip
  end

  # The Claude Code SessionEnd hook pipes its event JSON ({session_id, reason, …})
  # on stdin. Read it ONLY when stdin is a pipe (a hook), never a tty (a manual
  # `close-open` run), so an interactive invocation never hangs waiting on input.
  def session_from_stdin
    return nil if @in.respond_to?(:tty?) && @in.tty?

    raw = @in.read
    return nil if raw.to_s.strip.empty?

    JSON.parse(raw)["session_id"].to_s.strip
  rescue StandardError
    nil
  end

  # Resolve the activity's context. task_slug / stage describe the DESK — the nearest
  # .agent-context.json walking up from cwd (the worktree) wins, else the
  # per-session marker.
  #
  # The BASE `mascot`, though, is the session's OWN stable Pokémon — the
  # per-session marker (keyed by session_id) that `bin/task session-mascot` writes
  # from SessionMascot. It is deliberately NOT the desk's .agent-context.json
  # mascot: that carries the BOUND TASK's builder mascot, which FLIPS the base when
  # a session works a task built by a different soul (the observed Shellder→Sandshrew
  # switch in a conductor session). So the base stays constant and the `agent`
  # stacks on top. The desk mascot is only a last-resort fallback for a session
  # that has no mascot of its own yet, and the task's builder mascot remains
  # reachable via `task_slug`. Never raises.
  def resolve_marker(session_id:)
    desk    = read_context_marker(Dir.pwd)
    session = read_session_marker(session_id) || {}
    context = desk || session
    {
      # task_slug: the desk/session marker first, then infer from a `feat/<slug>`
      # checkout branch so an activity is task-attributed even before a task-bind write
      # populates the marker. (The base-mascot split below is unchanged — mascot is
      # the SESSION's own Pokémon, never the desk/task builder mascot.)
      "task_slug" => first_present(context, "task_record_slug", "task_slug", "slug") || infer_task_from_branch,
      "mascot"    => blank_to_nil(session["mascot"]) || blank_to_nil((desk || {})["mascot"]),
      "stage"     => blank_to_nil(context["stage"])
    }
  rescue StandardError
    { "task_slug" => nil, "mascot" => nil, "stage" => nil }
  end

  # ── HTTP + auth (the shared AgentApi client; 401 drops the cached token) ───

  def post(path, body)
    tok = @api.token
    return nil unless tok

    res = @api.http_json(:post, path, body, bearer: tok)
    @api.invalidate_token! if res && res.code.to_i == 401
    res
  rescue StandardError => e
    warn_note("atomic-event POST #{path} failed (ignored): #{e.class}")
    nil
  end

  def get(path)
    tok = @api.token
    return nil unless tok

    res = @api.http_json(:get, path, nil, bearer: tok)
    @api.invalidate_token! if res && res.code.to_i == 401
    res
  rescue StandardError => e
    warn_note("atomic-event GET #{path} failed (ignored): #{e.class}")
    nil
  end

  # The `data` payload of a JSON API response (a Hash for a single record, an Array
  # for a collection), or {} on any parse failure. Best-effort — never raises.
  def parse_data(res)
    body = JSON.parse(res.body)
    body.is_a?(Hash) ? (body["data"] || {}) : {}
  rescue StandardError
    {}
  end

  def report(res, ok_message)
    if res && res.code.to_i.between?(200, 299)
      @out.puts("atomic-event: #{ok_message}")
    elsif res
      warn_note("atomic-event: server said #{res.code} (ignored)")
    else
      warn_note("atomic-event: no response (ignored)")
    end
  end

  private

  # ── Marker files (mirror bin/atomic-capture-hook) ──────────────────────────

  def read_context_marker(cwd)
    dir = present?(cwd) ? File.expand_path(cwd) : nil
    return nil unless dir

    loop do
      path = File.join(dir, ".agent-context.json")
      return JSON.parse(File.read(path)) if File.file?(path)

      parent = File.dirname(dir)
      return nil if parent == dir

      dir = parent
    end
  rescue StandardError
    nil
  end

  def read_session_marker(session_id)
    sid = session_id.to_s.strip
    return nil if sid.empty?

    safe = sid.gsub(/[^A-Za-z0-9._-]/, "")
    path = File.join(projects_dir, ".agents", "sessions", "#{safe}.json")
    return nil unless File.file?(path)

    JSON.parse(File.read(path))
  rescue StandardError
    nil
  end

  # ── Sticky heartbeat acting-agent (per-session, session-scoped) ────────────
  # A sibling of the session marker keyed by session_id, holding ONE soul slug in
  # plain text. Presence = a `<Soul> Heartbeat` is running and every activity should
  # attribute to that soul. Deliberately a SEPARATE file from the mascot marker
  # (which `bin/task` owns) so we never read-modify-write / clobber it.
  def acting_agent_path(session_id)
    safe = session_id.to_s.gsub(/[^A-Za-z0-9._-]/, "")
    File.join(projects_dir, ".agents", "sessions", "#{safe}.acting-agent")
  end

  def read_acting_agent(session_id)
    path = acting_agent_path(session_id)
    return nil unless File.file?(path)

    value = File.read(path).to_s.strip
    present?(value) ? value : nil
  rescue StandardError
    nil
  end

  def write_acting_agent(session_id, soul)
    path = acting_agent_path(session_id)
    FileUtils.mkdir_p(File.dirname(path))
    File.write(path, "#{soul.to_s.strip}\n")
  rescue StandardError
    nil
  end

  def clear_acting_agent(session_id)
    path = acting_agent_path(session_id)
    File.delete(path) if File.file?(path)
  rescue StandardError
    nil
  end

  # ── Task-from-branch inference (marker fallback) ───────────────────────────

  # Infer the task slug from a `feat/<slug>` checkout branch when neither the desk
  # nor the session marker carries one — so a session working a task from a feature
  # checkout stamps the TASK from its FIRST activity, without waiting for a
  # `bin/task`/`bind-task` write. The `--task <slug>` flag is the EXPLICIT stamp
  # (it wins over this); this is the branch-name fallback. The pure split is
  # task_slug_from_branch, unit-testable without a git checkout.
  def infer_task_from_branch(dir = Dir.pwd)
    task_slug_from_branch(current_git_branch(dir))
  end

  # Pure: the <slug> of a `feat/<slug>` branch, else nil (the `feat/` prefix is the
  # McRitchie feature-branch convention, seeded from the task slug).
  def task_slug_from_branch(branch)
    m = branch.to_s.strip.match(%r{\Afeat/(.+)\z})
    m && present?(m[1]) ? m[1] : nil
  end

  # The checkout's git branch, or nil — best-effort (a non-repo / detached HEAD /
  # git failure yields nil). Bounded shell-out; never raises. Only reached when the
  # markers lack a task_slug, so it costs a git call at most once per activity.
  def current_git_branch(dir = Dir.pwd)
    return nil unless present?(dir) && File.directory?(dir.to_s)

    out = IO.popen(["git", "-C", dir.to_s, "rev-parse", "--abbrev-ref", "HEAD"],
                   err: File::NULL, &:read).to_s.strip
    present?(out) && out != "HEAD" ? out : nil
  rescue StandardError
    nil
  end

  # ── Paths + tiny helpers (shared resolution lives on AgentApi) ─────────────

  def projects_dir
    @api.projects_dir
  end

  def first_present(hash, *keys)
    keys.each do |key|
      value = hash[key]
      return value if present?(value)
    end
    nil
  end

  def blank_to_nil(value)
    present?(value) ? value : nil
  end

  def present?(value)
    @api.present?(value)
  end

  def warn_note(message)
    @err.puts(message)
    nil
  end
end

# Only run when invoked directly (not when `load`ed by a test).
if $PROGRAM_NAME == __FILE__
  AgentActivityCli.new.run(ARGV)
  exit 0 # ALWAYS succeed — narration must never fail the session
end
