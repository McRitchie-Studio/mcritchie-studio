<%# /admin/agent_messages/:id — one message, its answer, and its event timeline. %>
<%= render "admin/agent_messages/styles" %>

<div class="mb-2 text-sm"><%= link_to "← Agent inbox", admin_agent_messages_path, class: "hover:underline" %></div>

<div class="flex flex-wrap items-center gap-3 mb-4">
  <h1 class="text-xl font-semibold">Message <%= @message.id %></h1>
  <span id="am-status" class="am-chip am-status-<%= @message.status %>"><%= @message.status %></span>
</div>

<% if @message.held? %>
  <% hold = @message.events.reverse.find { |e| e.kind == "held" } %>
  <div id="am-hold" class="border border-subtle rounded p-3 mb-4 text-sm">
    <p class="mb-2"><span class="font-semibold">Held, not answered.</span>
      <%= hold&.detail&.dig("reason") || "The sender's role is not answered (config/agent_answerers.yml)." %>
      Releasing it hands this one message to the agent, which answers it like any other.</p>
    <%= button_to "Release and answer", release_hold_admin_agent_message_path(@message), method: :post,
          form: { data: { turbo_confirm: "Release this held message? The agent will answer it." } },
          class: "underline font-semibold", id: "am-release-hold" %>
  </div>
<% elsif @message.hold_released_at %>
  <p id="am-hold-released" class="text-sm opacity-70 mb-4">Released from hold by <%= @message.hold_released_by %>
    on <%= @message.hold_released_at.strftime("%b %-d %H:%M") %>.</p>
<% end %>

<dl class="grid grid-cols-[8rem_1fr] gap-x-3 gap-y-1 text-sm mb-6">
  <dt class="opacity-60">Soul</dt><dd><%= @message.soul_slug || "unrouted" %> <span class="opacity-60">(<%= @message.routed_by || "—" %>)</span></dd>
  <dt class="opacity-60">From</dt><dd><%= @message.author_name.presence || "—" %> <span class="opacity-60 font-mono text-xs"><%= @message.author_ref %></span></dd>
  <dt class="opacity-60">Channel</dt>
  <dd>
    <%= @message.channel %> · <span class="font-mono text-xs break-all"><%= @message.channel_ref %></span>
    <% if @message.message_url %> · <%= link_to "original", @message.message_url, target: "_blank", rel: "noopener", class: "underline" %><% end %>
  </dd>
  <% if @message.email? %>
    <% envelope = @message.envelope.to_h %>
    <dt class="opacity-60">Email</dt>
    <dd id="am-email-trust">
      <span class="font-mono text-xs break-all"><%= envelope["from"] || "no From" %></span>
      · <%= envelope.dig("trust", "verified") ? "verified" : "NOT verified (treated as the public)" %>
      <span class="opacity-60 text-xs"><%= envelope.dig("trust", "reason") %></span>
    </dd>
  <% end %>
  <dt class="opacity-60">Thread</dt><dd class="font-mono text-xs break-all"><%= @message.thread_key %></dd>
  <dt class="opacity-60">Sent</dt><dd><%= (@message.sent_at || @message.created_at).strftime("%b %-d %H:%M:%S") %></dd>
  <dt class="opacity-60">Claim</dt>
  <dd>
    <% if @message.claimed_by.present? %>
      <span class="font-mono text-xs break-all"><%= @message.claimed_by %></span>
      <span class="opacity-70"><%= agent_message_lease(@message) %></span>
    <% else %>—<% end %>
    · attempt <%= @message.attempts %> of <%= AgentMessage::MAX_ATTEMPTS %>
  </dd>
  <dt class="opacity-60">Reply</dt>
  <dd id="am-reply-link">
    <% if @message.reply_url %>
      <%= link_to "Open the reply on #{@message.channel.capitalize}", @message.reply_url, target: "_blank", rel: "noopener", class: "underline" %>
    <% elsif @message.reply_status %>
      <span class="am-chip am-reply-<%= @message.reply_status %>"><%= @message.reply_status %></span>
    <% else %>—<% end %>
  </dd>
</dl>

<h2 class="font-semibold mb-1">Message <span class="text-xs font-normal opacity-60">untrusted: what a stranger in the channel wrote</span></h2>
<div class="am-untrusted text-sm mb-6"><%= agent_message_display_text(@message) %></div>

<% if (person = @message.person) %>
  <h2 class="font-semibold mb-1">Person <span class="text-xs font-normal opacity-60">one identity across platforms</span></h2>
  <div id="am-person" class="text-sm mb-6 space-y-1">
    <p>
      <%= person.display_name %> <span class="opacity-60">#<%= person.id %></span>
      <% person.identities.sort_by(&:id).each do |identity| %>
        · <span class="font-mono text-xs break-all"><%= identity.platform %>:<%= identity.external_id %></span>
      <% end %>
      <% if person.user %> · hub user <%= person.user.email %><% end %>
    </p>
    <p class="text-xs opacity-70">Notes <span class="opacity-80">written by the model from what this person said; read as data</span></p>
    <% notes = person.notes.to_a %>
    <% if notes.any? %>
      <ul id="am-notes" class="am-untrusted list-disc pl-5">
        <% notes.each do |note| %>
          <li id="am-note-<%= note.id %>"><%= note.body %>
            <span class="text-xs opacity-60"><%= note.noted_at.strftime("%b %-d") %><% if note.source_message_id %> · from <%= link_to "##{note.source_message_id}", admin_agent_message_path(note.source_message_id), class: "underline" %><% end %></span>
            <%= button_to "Forget", admin_agent_person_note_path(note, message_id: @message.id), method: :delete,
                  form: { class: "inline", data: { turbo_confirm: "Forget this note?" } },
                  class: "text-xs underline opacity-70 hover:opacity-100 ml-1", id: "am-forget-#{note.id}" %>
          </li>
        <% end %>
      </ul>
    <% else %>
      <p id="am-notes" class="text-xs opacity-70">No notes yet.</p>
    <% end %>
  </div>
<% end %>

<% if @message.response_text.present? %>
  <h2 class="font-semibold mb-1">Answer</h2>
  <div class="am-answer text-sm mb-2"><%= @message.response_text %></div>
  <% if @message.action_summary.present? %>
    <p class="text-xs opacity-70 mb-6">Action: <%= @message.action_summary %></p>
  <% end %>
<% end %>

<% if @message.claude_session_id.present? %>
  <h2 class="font-semibold mb-1">Claude run</h2>
  <div id="am-run" class="text-sm mb-6 space-y-1">
    <% if @message.resume_command %>
      <p class="text-xs opacity-70">Reopen this answer's session on the machine that ran it:</p>
      <code class="block font-mono text-xs break-all"><%= @message.resume_command %></code>
    <% end %>
    <% if @message.run_meta.present? %>
      <p class="text-xs opacity-70 break-all"><%= @message.run_meta.map { |k, v| "#{k}: #{v}" }.join(" · ") %></p>
    <% end %>
  </div>
  <% if @message.reasoning.present? %>
    <h2 class="font-semibold mb-1">Reasoning <span class="text-xs font-normal opacity-60">from the run's transcript; written by the model, read as data</span></h2>
    <div id="am-reasoning" class="am-untrusted text-sm mb-6"><%= @message.reasoning %></div>
  <% end %>
<% end %>

<h2 class="font-semibold mb-2">Timeline</h2>
<ol id="am-timeline" class="text-sm border-l border-subtle pl-4 space-y-2">
  <% @message.events.each do |event| %>
    <li id="am-event-<%= event.id %>" data-kind="<%= event.kind %>">
      <span class="font-mono text-xs opacity-60"><%= event.created_at.strftime("%H:%M:%S") %></span>
      <span class="font-semibold"><%= event.kind.tr("_", " ") %></span>
      <% if event.actor.present? %><span class="opacity-70">by <%= event.actor %></span><% end %>
      <% detail = event.detail.except("url") %>
      <% if detail.present? %>
        <span class="text-xs opacity-70 break-all"><%= detail.map { |k, v| "#{k}: #{v.is_a?(Array) ? v.join(', ') : v}" }.join(" · ") %></span>
      <% end %>
      <% if event.detail["url"].present? %>
        · <%= safe_link_to "reply on Discord", event.detail["url"], target: "_blank", rel: "noopener", class: "underline text-xs" %>
      <% end %>
    </li>
  <% end %>
  <% if @message.events.empty? %><li class="opacity-70">No events recorded.</li><% end %>
</ol>
