<%# Testing gates — the task-owned gate VERDICTS (GateRun: G1 Cert, DoR builder,
    DoR review, G2a Primary, G2b Light), the sibling of the testing-phases card
    above: phases are duration telemetry, gates are attempt-aware pass/fail records
    with the test SOPs each attempt executed. Rendered only once at least one gate
    has a run. %>
<% gate_runs = (task_gate_runs || {}) %>
<% if gate_runs.any? %>
  <div class="card p-6 mb-6">
    <div class="flex items-baseline justify-between mb-1">
      <h3 class="text-lg font-bold text-heading">Testing gates</h3>
      <span class="text-[10px] text-muted uppercase tracking-wide">gate verdicts</span>
    </div>
    <p class="text-muted text-xs mb-4">
      The task-owned gates and their latest attempt — G1 Cert (full suite + lint) → DoR (builder + review gate-zero) → G2 Review (primary + light).
    </p>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
      <% GateRun::TASK_KEYS.each do |key| %>
        <% run = gate_runs[key] %>
        <div class="bg-surface-alt rounded-lg p-3">
          <p class="label-upper"><%= GateRun::GATES.dig(key, "label") %></p>
          <p class="text-heading text-sm font-semibold"><%= gate_attempt_label(run) || "—" %></p>
          <p class="text-[10px] uppercase tracking-wide <%= gate_status_class(run) %>">
            <%= run ? run.status.humanize : "Not run" %>
          </p>
          <% if run && run.sops.any? %>
            <details class="mt-2">
              <summary class="text-[10px] text-muted uppercase tracking-wide cursor-pointer select-none">
                <%= pluralize(run.sops.size, "SOP") %>
              </summary>
              <ul class="mt-1 space-y-0.5">
                <% run.sops.each do |entry| %>
                  <%# `running` is a THIRD result, not a pass. Painting everything that is
                      not "fail" green reported an in-flight — or ABANDONED — lane as PASSED.
                      GateRun::NO_VERDICT_RESULTS is the FOURTH arm, for the same reason in
                      the other direction: CI was never READ (`unreadable` — the credential was
                      refused), never SPOKE (`no_checks` — the PR reported none yet;
                      `unverified` — `gh` fell over), or never had a PR to run against at all
                      (`no_pr` — devops.pr_url is blank). None of the four may be a ✓ (a CI
                      nobody heard is not a CI that passed) and none may be an ✗ (that is the
                      false red /tasks/gate-logs-auth-as-red, /tasks/refused-review-records-fail
                      and /tasks/no-pr-records-as-fail took out of the record). NOTE the default
                      below is ✓ — any result value added upstream without an arm here
                      silently becomes a pass, which is why the set, not a literal, is what this
                      arm tests. %>
                  <% result = entry["result"].to_s %>
                  <% glyph, tone = if result == "fail" then ["✗", "text-rose-400"]
                                   elsif result == GateRun::RUNNING_RESULT then ["◌", "text-amber-400"]
                                   elsif GateRun::NO_VERDICT_RESULTS.include?(result) then ["⚠", "text-amber-400"]
                                   else ["✓", "text-emerald-400"]
                                   end %>
                  <li class="text-[11px] text-muted flex items-baseline gap-1" data-result="<%= result %>">
                    <span class="<%= tone %>" data-test="gate-sop-glyph"><%= glyph %></span>
                    <span class="text-body"><%= entry["sop"] %></span>
                    <% if (sop_duration = gate_sop_duration_label(entry["duration_ms"])) %>
                      <span><%= sop_duration %></span>
                    <% end %>
                  </li>
                <% end %>
              </ul>
            </details>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>
