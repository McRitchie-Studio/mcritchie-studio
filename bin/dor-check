#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/dor-check — deterministic Definition-of-Ready gate for the two workflows.
#
# Reads a task's devops.shape and config/feature_shapes.yml, then confirms the
# task is ready to cross a workflow boundary. Two gates (pick with --gate):
#
#   --gate merge (default) — DoR-to-Merge, at submitted → reviewed.
#       Requires the shape's full required_metadata, its dor_tiers green (tagged
#       in devops.checks_run, e.g. "[unit] ..."), AND — for a shaped code feature
#       — FRESH full-suite + full-rubocop evidence (the FULL-suite gate below).
#   --gate build           — DoR-to-Build, at designed → building.
#       Lighter: the spec must be complete (shape + acceptance + repositories +
#       risk_tags + test_plan). No test tiers yet — there's no code to test.
#
# DETERMINISTIC — no model, no judgment. A failed check is an instant, cheap
# send-back that never burns review tokens.
#
#   * Feature agents run --gate build before coding, --gate merge before handoff.
#   * The heartbeat DevOps agent re-runs --gate merge as gate-zero of review.
#
# FULL-suite gate (merge gate, shaped code feature): the dor_tiers tags prove the
# agent WROTE the right tiers, but a tag is free text — an agent can satisfy a
# tier by running only the FILES it touched, so the full suite or rubocop breaks
# post-merge (devops retro, lines 54 + 58). So this gate ALSO demands fingerprint-
# bound evidence that a FULL `bin/rails test` and a FULL `bin/rubocop` went green
# against the EXACT code being shipped. bin/full-suite-check runs both lanes and
# records "[full-suite@<fp>]" / "[rubocop@<fp>]" checks_run lines; here we re-grade
# them against the local code fingerprint (a git tree hash, stable across the
# commit boundary), so a STALE (post-edit) or PARTIAL (one-lane / touched-files)
# record is REFUSED. Escape hatch = a RECORD, like the post_deploy "none" hatch: a
# "[full-suite-bypass] <reason>" checks_run line is honored but flagged loudly.
# FAST route: a FRESH "[fast-cert@<fp>]" line (bin/fast-check — diff-mapped tests
# + core spine + rubocop on changed files, ~1 min) satisfies this gate too,
# alongside a GREEN GitHub CI — CI runs the full suite + test:system on every
# PR push, so the full net still runs; the fast cert buys local earliness.
# CI seam (ci-gate-review-handoff): the CI WAIT lives on the REVIEW side, not the
# builder's wall-clock. The builder's submit-side run (--gate-role builder, the
# default) treats a still-running CI as a LOUD suggestion — and credits a fresh
# fast cert PROVISIONALLY while CI is pending (or not yet reported) on an OPEN PR
# — so the builder certs, opens the PR, and moves submitted immediately. RED CI
# (and a closed/merged pr_url, and a merge-CONFLICTED PR — mergeStateStatus
# DIRTY, whose CI never fires because GitHub can't compute the merge commit)
# still blocks both roles. The AUTHORITATIVE CI
# verdict is the review side: bin/pr-review's supervisor checks the live CI
# before spawning reviewers, and the primary's gate-zero (--gate-role review)
# keeps the strict semantics (red AND pending both block; fast evidence needs
# the settled green). Format + fingerprint live in bin/lib/full_suite_gate.rb.
# Fingerprint ROOTING — the gate must grade the TASK's tree, not the checkout the
# caller happens to stand in. The fingerprint is a git TREE hash, so a foreign root
# can NEVER match a recorded cert; it doesn't read as "wrong root", it reads as
# "STALE". Both lanes have now been bitten by that:
#   * REVIEW — reviewers run --gate-role review from the PRIMARY checkout (on
#     release/main) by design, so it roots the suite fingerprint at the TASK
#     BRANCH's committed tree (origin/feat/<slug>'s ^{tree}, content-addressed ==
#     what the builder certified) via review_fingerprint/FullSuiteGate.fingerprint_of_ref.
#   * BUILDER — a builder-lane run from the wrong checkout had NO such cure and
#     false-read STALE for 6 of 6 tasks on 2026-07-14, including certs 90 seconds
#     old. The task-root GUARD (bin/lib/cert_root_guard.rb — which both cert runners
#     already required, and which dor-check alone never consulted) now catches it and
#     RE-ROOTS at the task's tree, loudly. See the guard block below for refuse-vs-
#     resolve and the exact scope.
# And when a lane really IS stale, the refusal prints the fingerprint DELTA
# (certified for @abc…, but <the tree it actually hashed> is @def…) — so "STALE"
# names its cause instead of hiding it (stale_delta). The tree it names is the tree
# it HASHED, always: recompute the root in the message and you get the hash in the
# message. In the review lane that root is the task BRANCH's committed tree, never
# the reviewer's checkout, and never HEAD (the working-tree fingerprint includes
# uncommitted edits by design).
#
# dor-check still does NOT run the suite itself — it stays a fast, deterministic
# verdict; bin/full-suite-check is the (slower) runner that produces the evidence.
#
# Non-code kinds (devops.kind chore/cleanup/docs) carry no shape and no test
# tiers, so the shape gate does not apply: they PASS with a "DoR n/a" note.
#
# Post-deploy nudge (merge gate): if the branch diff touches a seed or a
# data-migration (db/seeds, db/migrate/), the task must declare
# devops.post_deploy_cmd — the command bin/release runs on the deployed app so a
# seed/backfill isn't run by hand post-ship. Set it to "none" to acknowledge a
# schema-only migration the release phase auto-runs.
#
# Post-deploy SAFETY gate (both gates): bin/release runs devops.post_deploy_cmd
# VERBATIM against PRODUCTION, so it must be a NARROW, prod-safe, idempotent
# command. A bare full-suite seed (bin/rails db:seed / db:seed:replant / rake
# db:seed) is REJECTED: db/seeds.rb loads EVERY db/seeds/*.rb — it would inject
# demo News/Content/Tasks into prod AND abort the release on a non-idempotent
# seed file. Require a scoped single-file runner (rails runner 'load
# Rails.root.join("db/seeds/NN_x.rb").to_s') or a dedicated rake task instead.
# Near-miss: merge-docs-reviewer-into-alex shipped post_deploy_cmd='bin/rails
# db:seed' because reviewers read the diff, not the deploy metadata.
#
# Auth: AGENT_API_SECRET from ENV, else 1Password, else repo .env (same as
# bin/task). Base URL via TASK_API_BASE (default https://mcritchie.studio).
#
# Usage:
#   bin/dor-check <task-slug>                  # DoR-to-Merge (default), fetch + evaluate
#   bin/dor-check <task-slug> --gate build     # DoR-to-Build (spec complete, no tiers)
#   bin/dor-check <task-slug> --json           # machine-readable verdict (heartbeat agent)
#   bin/dor-check --file task.json             # evaluate a local task JSON (offline/tests)
#
# Exit code: 0 = ready, 1 = not ready (or error).

require "net/http"
require "json"
require "uri"
require "yaml"
require "optparse"
require_relative "lib/full_suite_gate"
require_relative "lib/repo_root"
require_relative "lib/ci_status"
require_relative "lib/code_diff"
require_relative "lib/task_board"
require_relative "lib/cert_root_guard"

# ROOT = the gate script's OWN repo (the hub). CONFIG (feature_shapes.yml) and the
# token .env resolve from here and STAY here — the shape taxonomy is studio-owned.
# The code DIFF roots at the agent's worktree (diff_root). The suite FINGERPRINT
# usually does too — but not always: the review lane and the reclaimed-worktree
# remedy hash a committed BRANCH TREE instead, so the fingerprint carries its own
# provenance (full_suite.fingerprint_root/_repo/_source) rather than borrowing
# diff_root's name.
ROOT = File.expand_path("..", __dir__)
CONFIG_PATH = File.join(ROOT, "config", "feature_shapes.yml")
# The board CLI the task-root guard reads devops.branch/worktree_slug through when
# a caller has no task in hand. dor-check always DOES (it just fetched one), so it
# passes `devops:` and this stays unused on the normal path; tests stub it.
TASK_BIN = ENV.fetch("DOR_CHECK_TASK_BIN", File.expand_path("task", __dir__))
# Where the root guard globs for the task's worktree (…/<app>/.worktrees/<slug>).
# nil → ProjectsRoot's default. The test seam: it redirects the glob at a temp
# projects root, and (see the guard block below) it is what opts a --file run into
# the guard at all.
PROJECTS_DIR = ENV["DOR_CHECK_PROJECTS_DIR"]
# Kinds that MAY skip the shape/test-tier gate — chore/cleanup/docs. The label
# alone NEVER earns the skip: the exemption must be EARNED by an observed
# doc-only diff (CodeDiff.code_files empty). "There is no size exemption"
# (CLAUDE.md/AGENTS.md) — and there is no LABEL exemption either. See
# bin/lib/code_diff.rb for why the classifier is a denylist, and for the PR #512
# escape (a kind:chore that shipped .github/workflows/ci.yml) that motivated it.
EXEMPT_KINDS = CodeDiff::EXEMPT_KINDS
# Path prefixes whose changes ship DATA, not just schema/behavior: a new seed or
# a data-migration (a backfill) needs a one-off rake AFTER the deploy — Heroku's
# release phase auto-runs `db:migrate`, but NOT `db:seed` or a backfill task. The
# mechanism to run it on ship already exists end-to-end (devops.post_deploy_cmd,
# which bin/release executes against the deployed app, aborting on non-zero), but
# features that add a seed/migration routinely forget to DECLARE it, so someone
# runs the rake by hand post-ship (pokemon:seed, pokemon:resync_mascots, …). The
# merge gate nudges: a diff under these prefixes must carry a post_deploy_cmd (or
# declare "none" to acknowledge a schema-only migration the release phase runs).
DATA_CHANGE_PREFIXES = %w[db/migrate/ db/seeds].freeze
# A devops.post_deploy_cmd that runs the FULL seed suite. bin/release executes
# post_deploy_cmd VERBATIM against the deployed app (prod on ship), and Rails'
# db:seed task loads db/seeds.rb — which in this app loads EVERY db/seeds/*.rb
# (demo News/Content/Tasks + any non-idempotent file). So the bare task is
# forbidden as a post-deploy command; a scoped runner or a dedicated rake task is
# required instead. This matches the rake TASK token `db:seed` (and
# `db:seed:replant` / any `db:seed:*` subtask) as a standalone word — the COLON is
# the tell: `db:seed` is the rake task; the safe scoped form `db/seeds/NN.rb`
# (slash) must NOT match, nor a dedicated task like `pokemon:seed`.
BARE_SEED_TASK = %r{(?<![\w:/])db:seed(?::\w+)?(?![\w:/])}i
BASE_URL = ENV.fetch("TASK_API_BASE", "https://mcritchie.studio")
# The gate-run CLI (GateRun markers). A merge-gate verdict opens+closes the
# task's DoR gate — `dor` (builder) or `dor_review` (review gate-zero) — see the
# emit at the bottom; fire-and-forget.
GATE_BIN = File.expand_path("gate", __dir__)

def warn!(msg)
  $stderr.puts(msg)
end

def die!(msg)
  warn!("error: #{msg}")
  exit 1
end

options = { json: false, file: nil, gate: "merge", gate_role: "builder", diff_base: false, suite_fingerprint: false }
GATES = %w[merge build].freeze
GATE_ROLES = %w[builder review].freeze
OptionParser.new do |o|
  o.banner = "Usage: bin/dor-check <task-slug> [--gate merge|build] [--gate-role builder|review] [--json] | bin/dor-check --file task.json"
  o.on("--gate GATE", "Boundary to check: merge (default, submitted→reviewed) or build (designed→building)") { |v| options[:gate] = v }
  o.on("--gate-role ROLE", "Who is running the gate: builder (default; the verdict opens+closes the task's DoR " \
                           "gate `dor`) or review (the primary reviewer's gate-zero; opens+closes `dor_review`)") { |v| options[:gate_role] = v }
  o.on("--json", "Emit a machine-readable verdict") { options[:json] = true }
  o.on("--diff-base", "Resolve and print the committed-diff base for this repo, then exit (debug/resolver seam)") { options[:diff_base] = true }
  o.on("--suite-fingerprint", "Print the code fingerprint the full-suite gate would validate against, then exit (debug/resolver seam)") { options[:suite_fingerprint] = true }
  o.on("--file PATH", "Evaluate a local task JSON instead of fetching") { |v| options[:file] = v }
  o.on("-h", "--help", "Show this help") do
    puts o
    exit 0
  end
end.parse!
die!("--gate must be one of: #{GATES.join(", ")}") unless GATES.include?(options[:gate])
die!("--gate-role must be one of: #{GATE_ROLES.join(", ")}") unless GATE_ROLES.include?(options[:gate_role])

# --- task board auth + fetch (mirrors bin/task) ---------------------------

def agent_secret
  dotenv = File.join(ROOT, ".env")
  TaskBoard.agent_secret(dotenv) ||
    die!("AGENT_API_SECRET not found (checked ENV, 1Password, #{dotenv})")
end

def token
  @token ||= api(:post, "/api/v1/auth", { secret: agent_secret }, auth: false).fetch("token")
end

def api(method, path, body = nil, auth: true)
  res = TaskBoard.request(method, path, base_url: BASE_URL, token: (auth ? token : nil), body: body)
  parsed = TaskBoard.parse_body(res)
  unless res.code.to_i.between?(200, 299)
    die!("#{method.upcase} #{path} -> #{res.code}: #{parsed["error"] || res.body}")
  end
  parsed
end

def load_task(slug, file)
  if file
    raw = JSON.parse(File.read(file))
    raw["data"] || raw
  else
    die!("usage: bin/dor-check <task-slug> [--json]") if slug.nil? || slug.empty?
    api(:get, "/api/v1/tasks/#{slug}")["data"] || die!("task #{slug} not found")
  end
rescue JSON::ParserError => e
  die!("could not parse task JSON: #{e.message}")
rescue Errno::ENOENT
  die!("file not found: #{file}")
end

# --- evaluation -----------------------------------------------------------

# A devops field is "present" when it is a non-blank string or a non-empty list.
def present?(value)
  case value
  when nil then false
  when Array then value.any? { |v| v.to_s.strip != "" }
  else value.to_s.strip != ""
  end
end

# A tier is satisfied when a checks_run line is tagged "[tier]" at its start.
def tier_satisfied?(checks, tier)
  checks.any? { |line| line.to_s =~ /\A\s*\[\s*#{Regexp.escape(tier)}\s*[\]:]/i }
end

# Files changed on this branch — the FULL working-tree diff, so the code-diff
# chore gate fires whether dor-check runs BEFORE the feature commit (the SOP
# order: dor-check → fix → commit) or after it. Tests inject a deterministic list
# via DOR_CHECK_CHANGED_FILES (newline/comma separated; empty string = no diff),
# which stays authoritative when set.
#
# Otherwise we union four git views, de-duped:
#   * uncommitted, base-independent (a positive signal — these gate even pre-commit):
#       staged    git diff --cached --name-only
#       unstaged  git diff --name-only
#       untracked git ls-files --others --exclude-standard
#   * committed against the release-aware base (see diff_base/default_diff_base):
#     git diff <base>...HEAD. Default base is origin/release when it exists, else
#     origin/main — because post-cutover branches are cut off `release` (which runs
#     AHEAD of `main`), so diffing against origin/main drags in everyone else's
#     already-merged-to-release work → a false code diff. DOR_CHECK_DIFF_BASE
#     overrides the default. Best-effort; the base can be unfetched on a fresh
#     branch, which is fine — the working-tree views above don't depend on it.
# Diff dir defaults to the agent's worktree (cwd's git toplevel) so a SATELLITE
# task diffs the satellite, not the hub this script lives in; DOR_CHECK_DIFF_ROOT
# overrides (deterministic tests against a temp repo). If git can't read the
# working tree at all (no repo), the diff is INDETERMINATE and the merge gate
# ENFORCES the tiers (resolve_branch_diff) — it never defaults to exempt. A gate
# that cannot see must not wave things through.
# MEMOIZED, because the task-root guard below can RE-ROOT it: when the cwd turns out
# not to be the task's tree, every later reader (the diff, the Gemfile pair, the
# suite fingerprint) must see the SAME corrected root, resolved once.
def diff_root
  @diff_root ||= RepoRoot.code_root(ENV["DOR_CHECK_DIFF_ROOT"], ROOT)
end

# The diff under gate, resolved ONCE as [files, source]. Sources, in priority:
#
#   :injected — DOR_CHECK_CHANGED_FILES (the deterministic test seam).
#   :pr       — the PR's OWN file list, via `gh pr view --json files`. At the merge
#               boundary the artifact under gate is the PULL REQUEST, not whatever
#               tree the caller happens to be standing in — and the caller is often
#               standing somewhere blind: the reviewer's gate-zero
#               (`--gate-role review`) runs from a PRIMARY checkout where the task
#               branch isn't checked out at all, so a local-only detector sees an
#               EMPTY diff and (pre-fix) called that "no code". Reading the PR makes
#               the verdict correct from anywhere.
#   :git      — the local working tree + committed view (union of staged, unstaged,
#               untracked, and base...HEAD). This is the BUILDER's view: it fires
#               pre-commit and pre-PR, before a PR exists to read.
#   :indeterminate — nothing could be read. NEVER an exemption (see below).
#
# FAIL-CLOSED. "We couldn't see a code diff" is not "there is no code diff." The
# old resolver returned [] on an unreadable repo AND on a blind checkout, and []
# bought a full exemption — the gate defaulted to OFF whenever it couldn't see.
# Now the exemption demands positive proof (a non-empty, observed, all-prose
# diff); anything else enforces the tiers.
def branch_diff
  @branch_diff ||= resolve_branch_diff
end

def changed_files
  branch_diff.first
end

def diff_source
  branch_diff.last
end

def resolve_branch_diff
  if ENV.key?("DOR_CHECK_CHANGED_FILES")
    return [ENV["DOR_CHECK_CHANGED_FILES"].to_s.split(/[\n,]/).map(&:strip).reject(&:empty?), :injected]
  end

  pr = pr_changed_files
  return [pr, :pr] if pr.is_a?(Array) && pr.any?

  git = git_changed_files
  return [git, :git] if git.is_a?(Array) && git.any?

  # Nothing observed anywhere. A genuinely clean tree and a blind/unreadable
  # checkout are INDISTINGUISHABLE from here, so both fail closed.
  [[], :indeterminate]
end

# The PR's changed files (merge gate's source of truth). DOR_CHECK_PR_FILES is the
# test seam (a file list, or the token "unverified" to simulate gh being down),
# mirroring DOR_CHECK_CI_STATUS. Any failure → nil, and the caller falls back to
# the local git view rather than failing closed on a diff it CAN still read.
def pr_changed_files
  injected = ENV["DOR_CHECK_PR_FILES"]
  if injected
    return nil if injected.strip == "unverified"

    return injected.split(/[\n,]/).map(&:strip).reject(&:empty?)
  end

  pr = @pr_url.to_s.strip
  return nil if pr.empty?

  # The REST files endpoint, NOT `gh pr view --json files` — that surface exposes
  # only {additions, changeType, deletions, path}, so a RENAME appears as its
  # destination alone and a code→doc rename would read as prose (the bug Shannon
  # caught). REST carries `status` + `previous_filename`, so we can classify BOTH
  # sides. A renamed entry with no previous_filename shouldn't happen per the API
  # contract — if it ever does, the sentinel below has no prose extension, so it
  # classifies as behavioral and the diff GATES. Fail closed by construction.
  owner, repo, number = pr.match(%r{github\.com/([^/]+)/([^/]+)/pull/(\d+)})&.captures
  return nil unless owner

  raw = IO.popen(
    ["gh", "api", "--paginate", "repos/#{owner}/#{repo}/pulls/#{number}/files", "--jq",
     '.[] | .filename, (if .status == "renamed" then (.previous_filename // "unknown-rename-source") else empty end)'],
    err: File::NULL, &:read
  )
  return nil unless $?.success?

  files = raw.to_s.split("\n").map(&:strip).reject(&:empty?)
  files.empty? ? nil : files
rescue SystemCallError
  nil
end

# The local view: uncommitted (staged/unstaged/untracked — base-independent, so it
# fires on the pre-commit SOP order) UNION the committed view against the
# release-aware base. Returns nil when git can't read the tree at all (no repo).
def git_changed_files
  return @git_changed_files if defined?(@git_changed_files)

  @git_changed_files = compute_git_changed_files
end

def compute_git_changed_files
  root = diff_root
  base = diff_base(root)
  files = []

  # --name-status -M (NOT --name-only): a rename must surface BOTH paths, or a
  # `bin/deploy.sh → docs/deploy-notes.md` rename reads as one prose file and
  # takes an exemption while deleting an executable. See CodeDiff.paths_from_name_status.
  worktree_ok = true
  [
    %w[diff --cached --name-status -M],
    %w[diff --name-status -M]
  ].each do |args|
    out = IO.popen(["git", "-C", root, *args], err: File::NULL, &:read)
    $?.success? ? files.concat(CodeDiff.paths_from_name_status(out)) : (worktree_ok = false)
  end

  # Untracked files have no status line — they are always plain adds.
  untracked = IO.popen(["git", "-C", root, "ls-files", "--others", "--exclude-standard"], err: File::NULL, &:read)
  $?.success? ? files.concat(untracked.to_s.split("\n")) : (worktree_ok = false)

  # Committed view: catches a post-commit run (change already in HEAD). The base
  # may be unfetched on a release-cut branch — best-effort, never fatal.
  committed = IO.popen(["git", "-C", root, "diff", "--name-status", "-M", "#{base}...HEAD"], err: File::NULL, &:read)
  files.concat(CodeDiff.paths_from_name_status(committed)) if $?.success?

  return nil unless worktree_ok

  files.map(&:strip).reject(&:empty?).uniq
rescue SystemCallError
  nil
end

# The committed-diff base for `root`. DOR_CHECK_DIFF_BASE is authoritative when
# set (tests/edge cases); otherwise the default is release-aware.
def diff_base(root)
  ENV.fetch("DOR_CHECK_DIFF_BASE") { default_diff_base(root) }
end

# Release-aware DEFAULT committed-diff base. Post-cutover every repo keeps a
# persistent `release` branch that feature branches cut from and PR into, and
# `origin/release` runs AHEAD of `origin/main` (merged-but-unshipped work). So we
# diff against origin/release when it exists, falling back to origin/main when it
# doesn't — mirroring bin/agent-worktree's base_ref_for. Resolved against `root`
# (DOR_CHECK_DIFF_ROOT) so tests can drive it at a temp repo. Git missing or no
# repo → origin/main, consistent with changed_files' best-effort committed view.
def default_diff_base(root)
  IO.popen(["git", "-C", root, "rev-parse", "--verify", "origin/release"], err: File::NULL, &:read)
  $?.success? ? "origin/release" : "origin/main"
rescue SystemCallError
  "origin/main"
end

# The task's feature branch — devops.branch when set, else feat/<worktree_slug or
# slug>. Feeds the review-role suite fingerprint below so the reviewer grades the
# builder's cert against the branch tree, not the primary checkout's tree. `devops`
# is {} in the --suite-fingerprint debug seam (no task fetched there); it then
# derives feat/<slug> from the positional arg — a fine offline approximation, since
# a task branch is feat/<slug> unless explicitly overridden.
def review_branch(devops, slug)
  branch = devops["branch"].to_s.strip
  return branch unless branch.empty?

  base = devops["worktree_slug"].to_s.strip
  base = slug.to_s.strip if base.empty?
  base.empty? ? nil : "feat/#{base}"
end

# The fingerprint the REVIEW gate-zero must grade the suite cert against — the
# TASK's tree, not the reviewer's cwd working tree. Reviewers run --gate-role
# review from the PRIMARY checkout (on release/main by SOP), so fingerprinting the
# working tree there reads a totally different tree and the cert false-reads STALE
# (the bug both the guard-conductor-gate-checkout and resolve-flag-handoff-guard
# reviewers hit tonight). A git tree hash is content-addressed, so the branch's
# committed ^{tree} equals the working-tree fingerprint the builder certified
# before pushing. Prefer origin/<branch> (what CI/QA graded), fall back to a local
# <branch>.
#
# Returns { fingerprint:, ref:, root: } — the hash AND the ref expression that
# produced it, in the repo it was resolved in — or nil when the branch isn't
# resolvable locally (unfetched); the caller then falls back to the working-tree
# fingerprint of diff_root (still honoring DOR_CHECK_DIFF_ROOT, the manual reviewer
# workaround). The PROVENANCE rides along because every message that prints this
# hash must name the tree that produced it: printing `root:` here — the reviewer's
# primary checkout, which is never what an override hashed — is the exact bug this
# now makes unrepresentable.
def review_fingerprint(root, branch)
  return nil if branch.to_s.strip.empty?

  FullSuiteGate.fingerprint_of_first_ref(root, "origin/#{branch}", branch)
end

# The subset of changed files that ships BEHAVIOR (CodeDiff's type-only rule:
# everything that isn't provably prose or inert media). Empty == doc-only.
def code_changed_files
  CodeDiff.code_files(changed_files)
end

# The subset of changed files that ship a seed or a data-migration (under
# DATA_CHANGE_PREFIXES) — the diff that should declare a post-deploy command so
# the conductor runs it on ship instead of someone running the rake by hand.
def data_changed_files
  changed_files.select { |f| DATA_CHANGE_PREFIXES.any? { |prefix| f.start_with?(prefix) } }
end

# The gem-publish seam (merge gate). When this branch touched the Gemfile, every
# versioned `gem "name", "constraint"` whose constraint the Gemfile.lock CANNOT
# satisfy — i.e. the Gemfile was bumped to a version the lock (and almost
# certainly RubyGems) doesn't have yet. That is exactly the state that turned
# mcritchie#157 CI fully red (a frozen/deployment `bundle install` can't resolve
# an unpublished gem) and got it blocked in review: a shared-gem feature (engine
# model + app consumer) whose consumer constraint was bumped BEFORE the gem
# published. Deterministic + OFFLINE — Gemfile vs Gemfile.lock only, no RubyGems
# call (fits the gate's no-network ethos). git/path sources (the local-dev bridge)
# don't match the `name, "version"` shape, so they're never flagged. Returns
# [{name, constraint, locked}].

# The gem guard READS Gemfile/Gemfile.lock CONTENT from diff_root, so its trigger
# must come from that SAME tree — not from the PR's file list. When the diff was
# resolved from the PR (:pr) the caller may be standing anywhere (a reviewer's
# gate-zero runs from a primary checkout whose Gemfile/lock are release's own
# self-consistent pair): "the PR touched Gemfile" + "the primary's Gemfile" is a
# comparison of two unrelated trees — it can never fire truthfully, and could fire
# on the REVIEWER's dirty Gemfile. The builder's submit run is unaffected: their
# worktree IS the branch's tree, so the local view sees the Gemfile.
def local_diff_files
  @local_diff_files ||= diff_source == :injected ? changed_files : (git_changed_files || [])
end

def gem_constraint_violations
  return [] unless local_diff_files.include?("Gemfile")

  root = diff_root
  gemfile = File.join(root, "Gemfile")
  lockfile = File.join(root, "Gemfile.lock")
  return [] unless File.exist?(gemfile) && File.exist?(lockfile)

  lock_text = File.read(lockfile)
  File.read(gemfile).each_line.each_with_object([]) do |line, violations|
    m = line.match(/^\s*gem\s+["']([A-Za-z0-9_.\-]+)["']\s*,\s*["']([^"':]+)["']/)
    next unless m

    name = m[1]
    constraint = m[2].strip
    locked = lock_text[/^\s{4}#{Regexp.escape(name)} \(([^)]+)\)/, 1]
    next unless locked # only gems pinned in the lock (skip git/path/new gems)

    req = (Gem::Requirement.new(constraint) rescue nil)
    next if req.nil? || req.satisfied_by?(Gem::Version.new(locked))

    violations << { "name" => name, "constraint" => constraint, "locked" => locked }
  end
end

# True when a post_deploy_cmd is a bare full-suite seed (db:seed / db:seed:replant
# / rake db:seed / bundle exec rails db:seed), which loads ALL of db/seeds.rb. The
# safe forms — a scoped runner (`rails runner 'load …db/seeds/NN.rb…'`) and a
# dedicated rake task (`pokemon:seed`) — do NOT match (no `db:seed` colon-token).
def bare_full_suite_seed?(cmd)
  BARE_SEED_TASK.match?(cmd.to_s)
end

# Human-readable refusal for the suite gate, from FullSuiteGate.evaluate's
# verdict. Spells out which lane is stale/missing and how to fix it — and that the
# fix REFUSES a touched-files subset or a lint-red tree, the whole point. `ci` is
# the CI-status verdict: a FRESH fast cert refused here is refused for its CI
# PAIRING (fast evidence only counts alongside a green GitHub CI — or, submit-side,
# a pending one on an OPEN PR), and the message must say that instead of
# pretending the evidence is bad. `review_role` picks the guidance: the review
# gate-zero says "defer until CI settles"; the builder says "open the PR" — and a
# CONFLICTED PR overrides both (its CI is never coming; "open the PR"/"defer"
# would each be wrong advice — the fix is rebase/merge release).

# The STALE fingerprint DELTA: what the evidence was certified FOR, what the code IS
# now, and WHERE "now" was read from.
#
# A bare "STALE (certified for older code)" states a verdict and hides its cause. It
# reads as "you edited since certifying" — but the fingerprint is a git TREE hash, so
# the SAME message appears when nothing was edited at all and the gate is simply
# standing in a different checkout (the 2026-07-14 false STALE: a cert taken in the
# task's worktree can never match a primary checkout's tree). The two causes want
# OPPOSITE fixes — re-certify vs. re-root — and an agent that can't tell them apart
# re-runs the cert, watches it go green, watches dor-check still say STALE, and
# stops. Naming both hashes and the root makes them distinguishable at a glance.
#
# THE ROOT IT NAMES IS THE ROOT IT HASHED. That is the invariant, and it takes NO
# `root` argument precisely so no caller can hand it a different one: the provenance
# rides in the verdict (FullSuiteGate#provenance), which is the only thing that
# actually knows. The first cut of this message printed dor-check's `diff_root`
# unconditionally — so in the review lane, where the fingerprint ALWAYS comes from
# the branch tree, it printed the reviewer's primary checkout beside a hash the
# primary never produced, and recomputing the named root gave a THIRD number. A
# precise-looking hash that sends the reader to the wrong tree is worse than the
# opaque STALE this replaced: it is a lie with an air of authority.
#
# So the wording follows the SOURCE, and each form is recomputable by hand:
#   working-tree → `bin/dor-check <slug> --suite-fingerprint` (or hash the path)
#   branch-tree  → `git -C <repo> rev-parse <ref>^{tree}`
# It is deliberately NOT called "HEAD": the working-tree fingerprint is the
# as-if-committed tree INCLUDING uncommitted edits — which is usually the very
# reason it moved — so an agent verifying it with `git rev-parse HEAD^{tree}` would
# get a different hash and conclude the tool is broken.
#
# Falls back to the old wording when there is nothing to compare: the bypass /
# injected / unverifiable verdicts carry no fingerprint, and so no provenance.
def stale_delta(eval, lane)
  recorded = Array(eval.dig(:recorded, lane)).reject { |fp| fp.to_s.strip.empty? }
  current = eval[:fingerprint].to_s
  return "certified for older code" if recorded.empty? || current.empty?

  "certified for #{recorded.map { |fp| "@#{fp[0, 12]}" }.join(', ')}, " \
    "but #{current_code_phrase(eval)} is @#{current[0, 12]}"
end

# WHAT the current fingerprint is a hash OF — named so it can be recomputed.
def current_code_phrase(eval)
  root = eval[:fingerprint_root].to_s
  return "the code now" if root.empty?

  if eval[:fingerprint_source] == FullSuiteGate::BRANCH_TREE_SOURCE
    # The override lanes: the hash came from a COMMITTED ref, not from any working
    # tree — least of all the one you are standing in. Name the ref and the repo it
    # resolves in, which is the whole recompute command.
    "the branch tree #{root} (in #{eval[:fingerprint_repo]}) — NOT this checkout —"
  else
    "the working tree at #{root} (as-if-committed, uncommitted edits included; not HEAD)"
  end
end

def suite_evidence_error(eval, slug, ci, review_role)
  unless eval[:verifiable]
    return "FULL-suite gate unverifiable — couldn't fingerprint the working tree (no git repo / git identity?). " \
      "Run bin/full-suite-check (or bin/fast-check) from inside the repo so the evidence is fingerprint-bound."
  end

  lanes = eval[:lanes] || {}
  if lanes[FullSuiteGate::FAST_LANE] == :fresh
    state = ci && ci[:state] ? ci[:state].to_s.upcase : "UNKNOWN"
    guidance =
      if ci && ci[:state] == :conflicted
        "This PR is merge-CONFLICTED (mergeStateStatus DIRTY), so its CI will NEVER fire — rebase or merge " \
          "release into the branch, resolve the conflicts, and push; the refreshed PR then runs CI"
      elsif ci && ci[:state] == :unreadable
        # The rolio bug, verbatim: the OLD text below told a builder whose PR was
        # ALREADY open and ALREADY green to "push the branch and open the PR". They
        # do, nothing changes, and they learn the gate is noise. The fast route is
        # genuinely unavailable here — but the reason is a TOKEN, and the reader must
        # be sent at the token, not at a re-run that cannot possibly help.
        # (@pr_url, not the `devops` local — a top-level def cannot see top-level locals.)
        CiStatus.unreadable_remedy(CiStatus.repo_from_pr_url(@pr_url), cause: ci[:cause])
      elsif review_role
        "The review gate-zero needs the SETTLED green — defer until CI finishes (red bounces the task back)"
      else
        "Submit-side, a fresh fast cert is credited PROVISIONALLY once an OPEN PR exists with CI pending — " \
          "push the branch and open the PR, then re-run dor-check"
      end
    return "fast-cert evidence is FRESH for this exact code, but a fast cert only satisfies the suite gate " \
      "alongside a GREEN GitHub CI — CI carries the FULL suite + test:system as the net, and it is currently " \
      "#{state}. #{guidance}; or certify locally " \
      "in full: bin/full-suite-check #{slug}."
  end

  parts = []
  FullSuiteGate::LANES.each do |lane|
    case lanes[lane]
    when :stale
      parts << "#{lane}: STALE (#{stale_delta(eval, lane)} — re-run after your latest edits, " \
               "or re-run from the task's tree if those hashes differ only because you are standing elsewhere)"
    when :missing
      parts << "#{lane}: MISSING (never certified for this exact code)"
    end
  end
  if lanes[FullSuiteGate::FAST_LANE] == :stale
    parts << "fast-cert: STALE (#{stale_delta(eval, FullSuiteGate::FAST_LANE)} — re-run bin/fast-check " \
             "after your latest edits, or re-run from the task's tree if those hashes differ only because you " \
             "are standing elsewhere)"
  end
  "the FULL suite + FULL rubocop are not certified green for this code — #{parts.join("; ")}. " \
    "Run `bin/full-suite-check #{slug}` (runs `bin/rails test` + `bin/rubocop` IN FULL and records " \
    "fingerprint-bound evidence) — it REFUSES a touched-files subset or a lint-red tree. Or take the FAST " \
    "route: `bin/fast-check #{slug}` (diff-mapped tests + core spine + rubocop on changed files, ~1 min), " \
    "accepted once the PR's GitHub CI is green. " \
    "Conscious, justified skip? Record a bypass: bin/task update #{slug} --checks \"[full-suite-bypass] <why>\"."
end

# The FRAGILE post_deploy_cmd shape: a rails runner that LOADs a seed file via
# `Rails.root.join(...)`, e.g. `bin/rails runner "load Rails.root.join(%q(db/
# seeds/54.rb)).to_s"`. It WORKS, but its parens + quotes are exactly what made
# the `heroku run` round-trip brittle (the seed-54 ship-blocker): bin/release's
# conductor interpolates this command and heroku's remote re-quoting choked on
# the `(`. `rails runner` accepts a FILE PATH directly, so the paren-free
# `runner <path>` form is canonical and robust. This is a SUGGESTION matcher
# only — the command stays valid; we never reject it on this basis.
FRAGILE_RUNNER_LOAD = %r{runner\s+['"]?\s*load\s+Rails\.root\.join\(}i

def fragile_runner_load?(cmd)
  FRAGILE_RUNNER_LOAD.match?(cmd.to_s)
end

# Best-effort: the seed path inside `Rails.root.join(...)`, so the suggestion can
# show the exact canonical command. Pulls each quoted / %q() segment AFTER the
# `Rails.root.join` token and joins them with `/` (handles a single "a/b.rb" arg
# AND a multi-segment join("a", "b", "c.rb")). nil when nothing extractable, so
# the caller falls back to a generic `<path>` placeholder.
def canonical_runner_path(cmd)
  after = cmd.to_s.split("Rails.root.join", 2)[1].to_s
  segs = after.scan(/%q[(\[{<]([^)\]}>]+)[)\]}>]|"([^"]+)"|'([^']+)'/).map { |m| m.compact.first }
  segs.empty? ? nil : segs.join("/")
end

# Resolver/debug seam: print the committed-diff base this repo would diff against
# and exit, before any task fetch. Honors DOR_CHECK_DIFF_ROOT/_BASE like changed_files.
if options[:diff_base]
  puts diff_base(diff_root)
  exit 0
end

# Resolver/debug seam: print the code fingerprint the full-suite gate validates
# against (a git tree hash), then exit. Honors DOR_CHECK_DIFF_ROOT like the gate.
# --gate-role review prints the TASK BRANCH tree (feat/<slug> derived from the
# positional slug offline), the same tree the review gate-zero grades against —
# so a reviewer can eyeball it against a "[fast-cert@<fp>]" line. Falls back to the
# working tree when the branch isn't resolvable locally.
if options[:suite_fingerprint]
  if options[:gate_role] == "review"
    branch = review_branch({}, ARGV.first)
    origin = review_fingerprint(diff_root, branch)
    puts(origin ? origin[:fingerprint] : FullSuiteGate.fingerprint(diff_root))
  else
    puts FullSuiteGate.fingerprint(diff_root)
  end
  exit 0
end

slug = ARGV.shift
config = YAML.load_file(CONFIG_PATH)
shapes = config.fetch("shapes")
defaults = config.fetch("defaults", {})

gate = options[:gate]
boundary = gate == "build" ? "designed → building" : "submitted → reviewed"
gate_label = gate == "build" ? "DoR-to-Build" : "DoR-to-Merge"

task = load_task(slug, options[:file])
devops = task.dig("metadata", "devops") || {}
shape = devops["shape"].to_s.strip
shape_def = shapes[shape]
kind = devops["kind"].to_s.strip.downcase
review_role = options[:gate_role] == "review"
# Feeds the :pr diff source (resolve_branch_diff). Set BEFORE the first
# changed_files call below, which memoizes the resolution.
@pr_url = devops["pr_url"]

# --- task-root guard (bin/lib/cert_root_guard.rb) -----------------------------
#
# The suite gate grades a cert's fingerprint — a git TREE hash — against the code at
# diff_root, so diff_root MUST BE the task's tree. It wasn't, and nothing checked:
# run `bin/dor-check <task>` from the hub PRIMARY for a task whose code lives in a
# worktree and it fingerprints the PRIMARY's tree, which is CONTENT-ADDRESSED and
# therefore can never equal the tree the builder certified. A perfectly fresh cert
# reads "STALE (certified for older code)". Live 2026-07-14: STALE for 6 of 6 tasks,
# including ones certified green 90 seconds earlier — and an agent that hits an
# unexplainable STALE stops, so this stranded finished tasks in `building` behind
# green PRs nobody handed off. The guard already EXISTED for exactly this: both cert
# runners require it (bin/fast-check, bin/full-suite-check). dor-check — the one
# command in the family that READS the evidence — never consulted it.
#
# REFUSE vs RESOLVE. The cert writers REFUSE, and must: they stamp evidence about
# the tree they stand in, so a chdir could green-cert a stale worktree while the
# operator's real edits sat untested where they ran from. dor-check WRITES NO
# EVIDENCE — it grades what is already recorded — so re-rooting cannot forge a cert.
# It can only make the gate judge the RIGHT code. So dor-check RESOLVES. But
# cert_root_guard.rb is explicit that a SILENT chdir is its own hazard, and it is
# right: a gate that quietly judges a different tree than the one you are looking at
# is how you end up arguing with a verdict instead of reading it. Every re-root
# below therefore ANNOUNCES itself on stderr, naming both roots.
#
# Remedies, in order, once the root is found foreign:
#   1. the task's worktree is ON DISK → re-root the whole gate there. Its working
#      tree is exactly what the builder certified (uncommitted edits included).
#   2. else its BRANCH resolves in this repo → root the FINGERPRINT at that branch's
#      committed tree. Content-addressed, so it equals the certified tree. This is
#      the same mechanism --gate-role review has used since the reviewers hit this
#      from the other side; the builder lane simply never got it.
#   3. else → no tree here can honestly grade this cert. REFUSE (below, at the suite
#      gate) rather than grade a foreign tree and call a fresh cert STALE.
#
# Scope — the BUILDER lane at the MERGE gate, with a positional slug and an IMPLICIT
# root. Deliberately NOT:
#   * --gate-role review — it already roots at the branch tree and runs from a
#     primary checkout BY DESIGN. It is not the broken lane; leave it alone.
#   * --gate build — the task is at `designed`. No code, no branch, no worktree yet;
#     there is no tree to root at, and nothing that reads one.
#   * DOR_CHECK_DIFF_ROOT — an EXPLICIT declaration by the caller (the CI/test seam,
#     and the documented manual reviewer workaround). It bypasses the guard exactly
#     as FAST_CHECK_ROOT / FULL_SUITE_ROOT do for the cert writers.
#   * --file without DOR_CHECK_PROJECTS_DIR — the offline seam has no board and no
#     on-disk tree relationship to assert (no production caller passes --file).
foreign_root = nil
task_fingerprint_override = nil
if gate != "build" && !review_role && !slug.to_s.strip.empty? &&
   ENV["DOR_CHECK_DIFF_ROOT"].to_s.strip.empty? &&
   (options[:file].nil? || !PROJECTS_DIR.to_s.strip.empty?)
  foreign_root = CertRootGuard.assess(
    task_bin: TASK_BIN, slug: slug, root: diff_root, devops: devops, projects_dir: PROJECTS_DIR
  )
end

if foreign_root
  standing = diff_root
  standing_branch = foreign_root[:actual_branch] || "unknown"
  if foreign_root[:resolved_root]
    warn!("⚠ dor-check: RE-ROOTING. You are standing in #{standing} (branch #{standing_branch}), which is " \
          "NOT #{slug}'s tree — every check below would have graded the wrong code, and the cert would have " \
          "read STALE no matter how fresh it is (the fingerprint is a git TREE hash; a foreign checkout can " \
          "never match one). Re-rooted at the task's worktree: #{foreign_root[:resolved_root]}. dor-check " \
          "READS evidence and never writes a cert, so it re-roots rather than refusing — but it will not do " \
          "it silently: the verdict below is about THAT tree, not the one you are in.")
    @diff_root = foreign_root[:resolved_root]
    foreign_root = nil # the root IS the task's tree now
  else
    task_fingerprint_override = review_fingerprint(diff_root, foreign_root[:expected_branch])
    if task_fingerprint_override
      warn!("⚠ dor-check: RE-ROOTING the cert fingerprint. You are standing in #{standing} (branch " \
            "#{standing_branch}), which is NOT #{slug}'s tree, and no worktree " \
            ".worktrees/#{foreign_root[:worktree_slug]} exists here — so the cert is graded against branch " \
            "#{foreign_root[:expected_branch]}'s committed tree — #{task_fingerprint_override[:ref]} " \
            "= @#{task_fingerprint_override[:fingerprint][0, 12]} — not against this checkout's. Announced, " \
            "not silent, and NAMED so you can recompute it: the verdict below is about the BRANCH's code.")
    end
  end
end

# An EXEMPT kind (chore/cleanup/docs) may skip the shape/test-tier gate — but it
# has to EARN the skip with an observed doc-only diff. Three outcomes:
#
#   code in the diff   → gate it exactly like a feature (no size, and no LABEL,
#                        exemption). gated_code_files names the offenders below.
#   doc-only diff      → skip, LOUDLY: say what was observed and where it came
#                        from, so a wrong skip is visible in the transcript
#                        instead of hiding behind a bare "n/a (kind: chore)".
#   nothing observed   → FAIL CLOSED at the merge gate. An empty view is not
#                        evidence of a doc-only PR; it is the absence of evidence
#                        (a blind checkout, an unreadable repo, a bad diff root).
#                        The BUILD gate stays lenient: at design time no code
#                        exists yet, that empty diff is the expected state, and
#                        the build gate enforces no tiers anyway — so leniency
#                        there cannot disarm the test gate. The merge gate can.
gated_code_files = []
if EXEMPT_KINDS.include?(kind)
  gated_code_files = code_changed_files
  observed = changed_files
  # An EMPTY observation is never positive proof of a doc-only PR, whatever its
  # source claims — "we saw nothing" and "there is nothing" are different facts.
  # At the merge gate they fail closed alike; at the build gate an empty diff IS
  # the expected state (no code written yet), so it stays exempt.
  indeterminate = observed.empty? && gate != "build"

  if gated_code_files.any?
    # fall through to the full shape/test-tier gate below.
  elsif indeterminate
    errors_preamble = "kind: #{kind} could not be proven doc-only — no diff could be observed " \
                      "(no PR files readable, and the git tree at #{diff_root} is clean or unreadable), " \
                      "so the shape/test-tier gate is ENFORCED rather than skipped (fail-closed). Re-run " \
                      "this from the task's worktree, or set devops.pr_url, so the gate can see the diff " \
                      "it is meant to judge"
    if options[:json]
      puts JSON.pretty_generate(
        task: task["slug"] || slug,
        shape: shape.empty? ? nil : shape,
        kind: kind,
        gate: gate,
        ready: false,
        exempt: false,
        diff_source: "indeterminate",
        code_files: [],
        note: errors_preamble,
        errors: [errors_preamble],
        suggestions: [],
        missing_metadata: [],
        missing_tiers: []
      )
    else
      title = task["title"] || task["slug"] || slug || "(task)"
      puts "✗ #{gate_label} NOT met for #{title.inspect}"
      puts "  · #{errors_preamble}"
    end
    exit 1
  else
    source_label = { injected: "injected diff", pr: "PR files", git: "git working tree" }
      .fetch(diff_source, diff_source.to_s)
    sample = observed.first(3).join(", ") + (observed.size > 3 ? ", …" : "")
    note = if observed.empty?
      "no code written yet (kind: #{kind}); DoR n/a"
    else
      "doc-only diff (kind: #{kind}): #{observed.size} file(s), none behavioral — #{sample} " \
        "[source: #{source_label}]; DoR n/a"
    end
    if options[:json]
      puts JSON.pretty_generate(
        task: task["slug"] || slug,
        shape: shape.empty? ? nil : shape,
        kind: kind,
        gate: gate,
        ready: true,
        exempt: true,
        diff_source: diff_source.to_s,
        code_files: [],
        changed_files: observed,
        note: note,
        errors: [],
        suggestions: [],
        missing_metadata: [],
        missing_tiers: []
      )
    else
      title = task["title"] || task["slug"] || slug || "(task)"
      puts "✓ #{gate_label} n/a for #{title.inspect} — #{note}"
      puts "  → ready to advance #{boundary} (shape/test-tier gate skipped: the OBSERVED diff ships no behavior)"
    end
    exit 0
  end
  # else: this kind ships code — fall through and gate it like a feature.
end

errors = []
if shape.empty?
  errors << if gated_code_files.any?
    sample = gated_code_files.first(3).join(", ") + (gated_code_files.size > 3 ? ", …" : "")
    "kind: #{kind} ships a code diff (#{sample}) so the test gate applies — set " \
      "devops.shape (#{shapes.keys.join(", ")}) and record its tiers, or move the code out of this #{kind}"
  else
    "devops.shape is not set (expected one of: #{shapes.keys.join(", ")})"
  end
elsif shape_def.nil?
  errors << "unknown shape #{shape.inspect} (valid: #{shapes.keys.join(", ")})"
end

# DoR-to-Build checks only spec completeness (the base defaults). local_url and
# the test tiers are build artifacts — not knowable at design time, so the build
# gate never asks for them. DoR-to-Merge asks for the shape's full contract.
if gate == "build"
  required_meta = defaults["required_metadata"] || []
  dor_tiers = []
else
  required_meta = (shape_def && shape_def["required_metadata"]) || defaults["required_metadata"] || []
  dor_tiers = (shape_def && shape_def["dor_tiers"]) || []
end
missing_meta = required_meta.reject { |field| present?(devops[field]) }

checks = Array(devops["checks_run"])
missing_tiers = dor_tiers.reject { |tier| tier_satisfied?(checks, tier) }

# Post-deploy nudge (merge gate only). A diff that adds or edits a seed or a
# data-migration should declare devops.post_deploy_cmd so the conductor runs it
# on ship (bin/release) instead of someone running the rake by hand afterward.
# Like local_url and the test tiers, the command is a BUILD artifact — you only
# know it once the migration exists — so the build gate (spec-complete, no code
# yet) never asks for it. Escape hatch, consistent with the chore gate (satisfy
# the contract; don't bypass it): declare the command, OR set post_deploy_cmd to
# "none" to acknowledge a schema-only migration the release phase auto-runs. The
# explicit "none" is the point — it forces a conscious decision instead of a
# silent omission.
if gate != "build"
  data_files = data_changed_files
  if data_files.any? && !present?(devops["post_deploy_cmd"])
    sample = data_files.first(3).join(", ") + (data_files.size > 3 ? ", …" : "")
    errors << "diff touches a seed/migration (#{sample}) but devops.post_deploy_cmd is blank — this " \
      "change should declare a post-deploy command so the conductor runs it on ship and nobody runs the " \
      "rake by hand (e.g. bin/task update #{task["slug"] || slug} --post-deploy-cmd 'bin/rails pokemon:seed'); " \
      "set it to 'none' if no command is needed (a schema-only migration the release phase auto-runs)"
  end

  # Gem-publish seam: a Gemfile bumped past what the lock can satisfy will fail CI
  # (frozen bundle can't resolve an unpublished version). Catch it HERE, before
  # submit, instead of as a red-CI surprise + a review block (the mcritchie#157
  # studio-engine 0.9.0 case — see docs/agents/audits/session-retrospective-2026-06-25.md).
  gem_constraint_violations.each do |v|
    errors << "Gemfile sets #{v["name"]} #{v["constraint"].inspect} but Gemfile.lock pins #{v["locked"]}, " \
      "which doesn't satisfy it — the new version is almost certainly NOT published, so CI will fail " \
      "`bundle install --frozen` (the gem-publish seam). Sequence it: release/publish #{v["name"]} first, " \
      "then `bundle update #{v["name"]}` to relock; OR hold the constraint bump until the gem ships; OR " \
      "bridge the consumer via a git source. A shared-gem feature ships the gem BEFORE the app adopts it."
  end
end

# Post-deploy SAFETY gate (BOTH gates — value-based, so gate-independent). A
# declared post_deploy_cmd is run VERBATIM against PRODUCTION by bin/release, so it
# must be NARROW, prod-safe, and idempotent. Reject a bare full-suite seed: db:seed
# (and db:seed:replant) loads db/seeds.rb → EVERY db/seeds/*.rb, which would inject
# demo News/Content/Tasks into prod AND abort the release on a non-idempotent seed
# file. The near-miss: merge-docs-reviewer-into-alex shipped post_deploy_cmd=
# 'bin/rails db:seed'; reviewers read the diff, not the deploy metadata, so it only
# surfaced when QA aborted. (An exempt no-code task short-circuits above and never
# reaches here; any task that actually ships a seed/migration touches db/ → non-
# exempt → gated.)
post_deploy_cmd = devops["post_deploy_cmd"].to_s
if present?(post_deploy_cmd) && bare_full_suite_seed?(post_deploy_cmd)
  errors << "devops.post_deploy_cmd #{post_deploy_cmd.inspect} is a bare full-suite seed — bin/release " \
    "runs it VERBATIM against PRODUCTION, and db:seed loads db/seeds.rb which loads EVERY db/seeds/*.rb: it " \
    "would inject demo News/Content/Tasks into prod AND abort the release if any seed file is non-idempotent " \
    "(the merge-docs-reviewer-into-alex near-miss). Declare a NARROW command instead — a scoped single-file " \
    "runner, e.g. rails runner 'load Rails.root.join(\"db/seeds/NN_x.rb\").to_s', or a dedicated idempotent " \
    "rake task (e.g. bin/rails pokemon:seed)"
end

# CI-status gate (merge gate only). Local certification proves the code is green on
# THIS machine; this proves it's green on GITHUB — closing the gap where a PR passes
# `bin/rails test` locally but fails the browser `test:system` lane CI also runs
# (the report's #1 blocker class). BLOCKS on a failing PR in both roles; a
# STILL-RUNNING CI is role-split (ci-gate-review-handoff): the builder's submit-side
# run downgrades it to a LOUD suggestion — the CI wait moved to the review handoff,
# where bin/pr-review's supervisor checks the live verdict before spawning reviewers
# — while the review gate-zero (--gate-role review) keeps the strict block (it IS
# the authoritative CI verdict). A missing PR / no checks / gh error stays a
# non-blocking note (the gate re-runs at review).
# Evaluated BEFORE the suite gate because the suite gate's fast route depends on it.
# Non-blocking SUGGESTIONS collect here too (never affect `ready`); more join below.
suggestions = []
ci = nil
if gate != "build"
  ci = CiStatus.evaluate(devops["pr_url"], ENV["DOR_CHECK_CI_STATUS"])
  case ci[:state]
  when :red
    errors << "GitHub CI is RED for the PR (#{Array(ci[:failing]).join(", ")}) — a red PR handed to review is the " \
      "#1 blocker class (the local cert doesn't run the browser test:system lane CI does). Fix, push, and re-run " \
      "dor-check once CI is green."
  when :conflicted
    # HARD blocker in BOTH roles, distinct from :pending/:none ("CI still coming",
    # genuinely deferrable): a conflicted PR's CI is never coming, so anything
    # softer strands the task in submitted forever (the PR-#509 stall).
    errors << "the PR is merge-CONFLICTED against its base (mergeStateStatus DIRTY) — GitHub cannot compute the " \
      "merge commit, so the pull_request workflow NEVER fires: this PR has NO CI coming, not a pending one, and " \
      "review's gate-zero would defer it forever while the board looks healthy. Rebase or merge release into the " \
      "branch (git fetch origin && git merge origin/release), resolve the conflicts, push, and re-run dor-check."
  when :pending
    if review_role
      errors << "GitHub CI is still RUNNING for the PR (#{Array(ci[:pending]).join(", ")}) — not green YET. The " \
        "review gate-zero is the authoritative CI verdict, so defer this review until CI settles (the supervisor's " \
        "defer machinery re-queries); a red finish bounces the task back."
    else
      suggestions << "GitHub CI is still RUNNING for the PR (#{Array(ci[:pending]).join(", ")}) — not green YET, " \
        "but submit-side this NO LONGER blocks: hand off now. The review gate-zero (bin/pr-review's supervisor + " \
        "the primary's dor-check --gate-role review) holds the authoritative verdict — a red CI bounces the task " \
        "back with the failing checks named, so expect that round-trip if CI fails."
    end
  when :closed, :merged
    errors << "the PR is #{ci[:state].to_s.upcase}, not an OPEN review target — `gh pr checks` returns the head " \
      "commit's HISTORICAL checks even on a closed/merged PR, so a green here is NOT a live pass. Reconcile " \
      "devops.pr_url (a stale or already-merged PR?) before advancing to review."
  end
end

# Suite gate (merge gate, shaped code feature only). The dor_tiers tags above
# prove the agent WROTE the right tiers; this proves the code being shipped is
# CERTIFIED — the retro gap where a touched-FILES subset passed but the full
# suite/lint broke post-merge (lines 54 + 58). Two evidence routes, both
# fingerprint-bound so a stale (post-edit) or partial record is REFUSED:
#   * FULL  — bin/full-suite-check's "[full-suite@<fp>]" + "[rubocop@<fp>]" lines
#     (the whole suite + full rubocop ran locally). Accepted on its own.
#   * FAST  — bin/fast-check's "[fast-cert@<fp>]" line (diff-mapped tests + core
#     spine + rubocop on changed files, ~1 min). Accepted alongside a GREEN
#     GitHub CI — CI runs the full suite + test:system on every PR push, so the
#     full net still runs; the fast cert buys the local earliness. Submit-side
#     (builder role) it is ALSO credited PROVISIONALLY while an OPEN PR's CI is
#     still pending / not yet reported — the review gate-zero enforces the
#     settled green (strict), so the net still closes before merge. A red,
#     closed/merged, unverified, or missing-PR CI never credits a fast cert.
# The "[full-suite-bypass] <reason>" hatch keeps working (loudly flagged).
# Skips the build gate (no code yet) and unshaped tasks (already errored above).
# DOR_CHECK_SUITE_EVIDENCE injects the verdict for tests (see the script header).
suite_eval = nil
suite_route = nil # "full" | "fast" | "fast-provisional" | "bypass" when satisfied
if gate != "build" && shape_def && !dor_tiers.empty?
  if foreign_root && task_fingerprint_override.nil?
    # Root guard, remedy 3 (see the guard block above). The root is NOT the task's
    # tree, its worktree isn't on disk, and its branch isn't in this repo — so there
    # is no tree here that can honestly grade this cert. Grading the checkout we
    # happen to stand in is precisely the bug: it would report a FRESH cert as STALE.
    # Refuse, and say which of the three fixes to reach for. This is a TRUTHFUL exit
    # 1 replacing a LYING one — the old code exited 1 here too, just with "STALE".
    errors << "root guard: this run roots at #{diff_root} (branch " \
      "#{foreign_root[:actual_branch] || 'unknown'}), which is NOT #{task["slug"] || slug}'s tree — its " \
      "worktree (.worktrees/#{foreign_root[:worktree_slug]}) is not on disk and its branch " \
      "#{foreign_root[:expected_branch]} is not in this repo, so NO tree here can grade its cert. The cert " \
      "fingerprint is a git TREE hash: grading the checkout you are standing in would report a perfectly " \
      "FRESH cert as STALE (the false STALE that stranded six tasks on 2026-07-14), so this refuses instead " \
      "of lying. Fix it one of three ways: run dor-check from the task's worktree; or fetch its branch " \
      "(git fetch origin #{foreign_root[:expected_branch]}); or declare the root explicitly with " \
      "DOR_CHECK_DIFF_ROOT=<path to the task's checkout>."
  else
    # Root the suite fingerprint at the TASK's tree, not at whatever checkout the
    # caller stands in. Two overrides feed the same seam:
    #   * review gate-zero — the reviewer runs from the PRIMARY (on release/main) BY
    #     DESIGN, so fingerprinting their cwd grades the wrong tree; root at the task
    #     BRANCH's committed tree instead (content-addressed == what was certified).
    #   * builder from a foreign root with no worktree on disk — the root guard's
    #     remedy 2, the same branch-tree rooting, announced above.
    # Both nil (the normal builder run, already standing in the task's tree) → the
    # working-tree fingerprint of diff_root, unchanged.
    #
    # Whichever fires, the override travels as { fingerprint:, ref:, root: } — the
    # hash AND the ref that produced it — and evaluate REFUSES a hash with no origin.
    # The verdict therefore always knows what it hashed, so the STALE message can
    # name it instead of naming diff_root, which in the review lane is the reviewer's
    # primary checkout and was never hashed at all.
    review_branch_ref = review_role ? review_branch(devops, task["slug"] || slug) : nil
    review_fp = review_branch_ref ? review_fingerprint(diff_root, review_branch_ref) : nil
    override = review_fp || task_fingerprint_override
    suite_eval = FullSuiteGate.evaluate(
      checks: checks,
      root: diff_root,
      injected: ENV["DOR_CHECK_SUITE_EVIDENCE"],
      fingerprint_override: override && override[:fingerprint],
      fingerprint_origin: override
    )
    if review_role && review_branch_ref && review_fp.nil? && ENV["DOR_CHECK_SUITE_EVIDENCE"].to_s.empty?
      suggestions << "review gate-zero: couldn't resolve branch #{review_branch_ref.inspect} locally to root the " \
        "suite fingerprint at the PR tree, so it fell back to the cwd working tree — which reads STALE from a " \
        "primary checkout. Fetch the branch (git fetch origin #{review_branch_ref}) or set " \
        "DOR_CHECK_DIFF_ROOT=<task worktree>, then re-run."
    end
    fast_fresh = suite_eval.dig(:lanes, FullSuiteGate::FAST_LANE) == :fresh
    if suite_eval[:ok]
      suite_route = suite_eval[:bypass] ? "bypass" : "full"
    elsif fast_fresh && ci && ci[:state] == :green
      suite_route = "fast"
    elsif fast_fresh && !review_role && ci && %i[pending none].include?(ci[:state])
      # ci-gate-review-handoff: the builder submits without the CI wait. The PR is
      # OPEN and its CI will settle; review's gate-zero holds the strict verdict.
      suite_route = "fast-provisional"
    else
      errors << suite_evidence_error(suite_eval, task["slug"] || slug, ci, review_role)
    end
  end
end

ready = errors.empty? && missing_meta.empty? && missing_tiers.empty?

# More non-blocking SUGGESTIONS (the list starts at the CI gate above). The
# canonical post_deploy_cmd form is the paren-free `bin/rails runner <path>` —
# `rails runner` accepts a file path directly. A valid-but-fragile
# `runner "load Rails.root.join(...)"` command is the shape that made the
# seed-54 ship brittle through `heroku run`, so we nudge toward the canonical
# form WITHOUT rejecting the (working) command.
if present?(post_deploy_cmd) && fragile_runner_load?(post_deploy_cmd)
  path = canonical_runner_path(post_deploy_cmd)
  canonical = path ? "bin/rails runner #{path}" : "bin/rails runner <path>"
  suggestions << "devops.post_deploy_cmd uses the fragile `runner \"load Rails.root.join(...)\"` form — " \
    "rails runner accepts a file path directly, so the canonical paren-free command is `#{canonical}` " \
    "(the parens/quotes are what made the seed-54 ship brittle through `heroku run`). Suggestion only — " \
    "the current command is valid and not blocking."
end

# A PR that EXISTS but whose CI couldn't be confirmed green is flagged (non-blocking):
# it never lowers `ready` (blocking on infra flakiness would be its own churn), but it
# says loudly that CI is unverified so the handoff isn't blind. A task with NO PR yet
# is SILENT — dor-check runs before the PR exists on the normal path, so there's
# nothing to verify and no note to make.
case ci && ci[:state]
when :none
  suggestions << "CI gate: the PR reports no GitHub checks yet — CI is UNVERIFIED. Confirm the workflow triggered " \
    "before handing off."
when :unreadable
  # NOT the same fact as :unverified, and the difference is the whole point: the CI
  # may well be GREEN — this token simply may not read it. Saying "check `gh pr
  # checks` manually" here would send the reader to the command that just failed.
  suggestions << "CI gate: the token was REFUSED when reading GitHub CI (#{ci[:reason]}) — status UNREADABLE, " \
    "which is NOT the same as no-CI. " \
      "#{CiStatus.unreadable_remedy(CiStatus.repo_from_pr_url(devops["pr_url"]), cause: ci[:cause])}"
when :unverified
  suggestions << "CI gate: couldn't read GitHub CI (#{ci[:reason]}) — status UNVERIFIED. Check `gh pr checks` " \
    "manually before the handoff."
end

# --- DoR gate-run emit (durable GateRun markers) ----------------------------
# A REAL merge-gate verdict is the Definition-of-Ready gate — its OWN gate now,
# distinct from G1 Cert (cert self-closes in full-suite-check). The builder's run
# opens+closes the `dor` gate; the primary reviewer's gate-zero (--gate-role
# review) opens+closes `dor_review` (was: a sop appended to G2a — the review
# supervisor still owns the G2a/G2b review-lane closes). Both carry the verdict
# evidence as sops. Skipped for --json (the heartbeat monitor polls read-only),
# --file (offline/test evaluation), and the build gate (no DoR verdict yet).
# Fire-and-forget: a board blip never changes the verdict or the exit code.
def emit_gate_verdict(slug, ready, role, sops)
  key = role == "review" ? "dor_review" : "dor"
  system(GATE_BIN, "open", "task", slug, key, out: File::NULL, err: File::NULL)
  close = ["close", "task", slug, key, ready ? "--success" : "--failed"]
  sops.each { |entry| close += ["--sop-json", JSON.generate(entry)] }
  system(GATE_BIN, *close, out: File::NULL, err: File::NULL)
rescue StandardError
  nil
end

if !options[:json] && options[:file].nil? && gate != "build" && !slug.to_s.empty?
  gate_sops = [{ "sop" => "dor-check", "cmd" => "bin/dor-check #{slug} --gate #{gate}", "result" => ready ? "pass" : "fail" }]
  unless dor_tiers.empty?
    gate_sops << { "sop" => "tiers", "tier" => dor_tiers.join("+"), "result" => missing_tiers.empty? ? "pass" : "fail" }
  end
  if suite_eval
    entry = { "sop" => "full-suite-evidence", "result" => suite_route ? "pass" : "fail" }
    if suite_eval[:fingerprint]
      fp12 = suite_eval[:fingerprint][0, 12]
      entry["cmd"] =
        case suite_route
        when "fast" then "fast-cert@#{fp12}+ci-green"
        when "fast-provisional" then "fast-cert@#{fp12}+ci-pending"
        else "certified@#{fp12}"
        end
    end
    gate_sops << entry
  end
  if ci
    # DoR-close semantics (ci-gate-review-handoff): the builder's verdict closes
    # the `dor` gate at submit — a not-yet-settled CI records as "pending"
    # (provisional, never a fail), and the AUTHORITATIVE ci verdict lands on
    # `dor_review` via the review gate-zero. One verdict per gate; no DoR row
    # lingers in flight waiting on CI.
    ci_result =
      case ci[:state]
      when :green then "pass"
      when :pending then review_role ? "fail" : "pending"
      when :red, :conflicted, :closed, :merged then "fail"
      else "unverified"
      end
    repo = CiStatus.repo_from_pr_url(devops["pr_url"])
    gate_sops << { "sop" => "ci", "result" => ci_result }.merge(CiStatus.gate_evidence(ci, repo: repo))
  end
  emit_gate_verdict(slug, ready, options[:gate_role], gate_sops)
end

# --- output ---------------------------------------------------------------

if options[:json]
  puts JSON.pretty_generate(
    task: task["slug"] || slug,
    shape: shape.empty? ? nil : shape,
    gate: gate,
    ready: ready,
    errors: errors,
    suggestions: suggestions,
    missing_metadata: missing_meta,
    missing_tiers: missing_tiers,
    # The checkout the DIFF was read from (after the root guard's re-root) — the ONE
    # fact that made the false STALE unreadable when it was absent. It is NOT
    # necessarily what the suite fingerprint was hashed from: when an override is in
    # play (the review lane ALWAYS, and the reclaimed-worktree remedy) the hash comes
    # from a committed BRANCH TREE, and saying otherwise here is how a confident,
    # wrong root label gets born. The fingerprint's own provenance therefore travels
    # WITH the fingerprint, in full_suite below.
    code_root: diff_root,
    ci: ci && { state: ci[:state], cause: ci[:cause], reason: ci[:reason], failing: ci[:failing],
                pending: ci[:pending], count: ci[:count] }.compact,
    full_suite: suite_eval && {
      ok: suite_eval[:ok],
      route: suite_route,
      bypass: suite_eval[:bypass],
      verifiable: suite_eval[:verifiable],
      fingerprint: suite_eval[:fingerprint],
      # WHAT was hashed to produce `fingerprint` — the invariant a monitor can CHECK:
      #   fingerprint_source "working-tree" → fingerprint_root is a PATH; recompute by
      #     hashing that tree (bin/dor-check <slug> --suite-fingerprint).
      #   fingerprint_source "branch-tree"  → fingerprint_root is a REF EXPRESSION;
      #     recompute: git -C <fingerprint_repo> rev-parse <fingerprint_root>.
      # Either way, recomputing the root NAMED here returns the fingerprint printed
      # here. There is no third number.
      fingerprint_root: suite_eval[:fingerprint_root],
      fingerprint_repo: suite_eval[:fingerprint_repo],
      fingerprint_source: suite_eval[:fingerprint_source],
      lanes: suite_eval[:lanes],
      # What each lane's evidence was certified FOR — the machine-readable half of
      # the STALE delta (fingerprint is what the code IS now).
      recorded: suite_eval[:recorded]
    }
  )
  exit(ready ? 0 : 1)
end

title = task["title"] || task["slug"] || slug || "(task)"
print_suggestions = -> { suggestions.each { |s| puts "  ⓘ suggestion: #{s}" } unless suggestions.empty? }
if ready
  puts "✓ #{gate_label} met for #{title.inspect} (shape: #{shape})"
  puts "  tiers green in checks_run: #{dor_tiers.join(", ")}" unless dor_tiers.empty?
  if suite_eval && suite_eval[:bypass]
    puts "  ⚠ FULL-SUITE GATE BYPASSED: #{suite_eval[:bypass]}"
  elsif suite_route == "fast"
    fp = suite_eval[:fingerprint]
    puts "  fast cert accepted#{fp ? " at #{fp[0, 12]}" : ""} (GitHub CI green carries the full suite)"
  elsif suite_route == "fast-provisional"
    fp = suite_eval[:fingerprint]
    puts "  ⚠ fast cert accepted PROVISIONALLY#{fp ? " at #{fp[0, 12]}" : ""} — CI hasn't settled; " \
         "the review gate-zero enforces the green"
  elsif suite_eval && suite_eval[:fingerprint]
    puts "  full suite + rubocop certified green at #{suite_eval[:fingerprint][0, 12]}"
  end
  if ci && ci[:state] == :green
    puts "  GitHub CI green#{ci[:count] ? " (#{ci[:count]} checks)" : ""}"
  elsif ci && ci[:state] == :pending
    puts "  ⚠ GitHub CI still RUNNING — handoff is provisional; see the suggestion below"
  elsif ci && ci[:state] == :conflicted
    # Defensive: :conflicted always lands in `errors` above, so a ready verdict
    # shouldn't reach here — but if a future reordering ever lets it, say it loudly.
    puts "  ⚠ PR merge-CONFLICTED (mergeStateStatus DIRTY) — CI never fires; rebase/merge release"
  elsif ci && %i[none unverified unreadable].include?(ci[:state])
    puts "  ⚠ GitHub CI UNVERIFIED (#{ci[:state]}) — see the suggestion below"
  end
  puts "  → ready to advance #{boundary}"
  print_suggestions.call
  exit 0
end

puts "✗ #{gate_label} NOT met for #{title.inspect}#{shape.empty? ? "" : " (shape: #{shape})"}"
errors.each { |e| puts "  - #{e}" }
unless missing_meta.empty?
  puts "  missing metadata:"
  missing_meta.each { |f| puts "    - devops.#{f}" }
end
unless missing_tiers.empty?
  puts "  missing test tiers (add a tagged checks_run line, e.g. \"[#{missing_tiers.first}] <command>\"):"
  missing_tiers.each { |t| puts "    - #{t}" }
end
puts "  → not ready to advance #{boundary}; resolve the above"
print_suggestions.call
exit 1
