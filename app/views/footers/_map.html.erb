<%# One live map of the studio's address. Leaflet mounts on this element (see
    footers/_assets); until it does, and if it never does, the link inside is the
    whole map: an address that opens directions. `classes` sizes and shapes it. %>
<div class="ftr-map <%= local_assigns[:classes] %>"
     data-footer-map
     data-lat="<%= facts[:lat] %>" data-lng="<%= facts[:lng] %>"
     data-zoom="<%= local_assigns[:zoom] || 15 %>"
     role="region" aria-label="Map of <%= facts[:street] %>, <%= facts[:city_line] %>">
  <a href="<%= facts[:directions_url] %>" target="_blank" rel="noopener" class="ftr-map-fallback">
    <%= facts[:street] %>, <%= facts[:city_line] %> · Open in Maps
  </a>
</div>
