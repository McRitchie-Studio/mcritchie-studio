<%# One clip candidate: its preview, window, seam, cast shape, target and prompt. %>
<% url = clip_urls[clip.object_key] %>
<% target = clip.target %>
<% status_chip = { "approved" => "bg-success/10 text-success-ink border-success/40",
                   "rejected" => "bg-danger/10 text-danger-ink border-danger/30",
                   "proposed" => "bg-surface-alt text-secondary border-subtle" }.fetch(clip.status) %>
<article id="clip-<%= clip.ordinal %>" class="card overflow-hidden scroll-mt-24 min-w-0"
         x-data="clipRow()" data-src="<%= url %>"
         data-test="clip-row" data-ordinal="<%= clip.ordinal %>" data-status="<%= clip.status %>">
  <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,2fr)_minmax(0,3fr)]">
    <div class="relative bg-inset aspect-video" data-test="clip-preview" data-key="<%= clip.object_key %>">
      <% if url %>
        <video x-ref="player" x-show="open" x-cloak controls playsinline preload="none"
               class="absolute inset-0 w-full h-full bg-black" data-test="clip-player"
               @error="failed = true"></video>
        <button type="button" x-show="!open" @click="preview()"
                class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-heading hover:text-primary"
                data-test="clip-preview-button">
          <svg class="w-10 h-10" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
          <span class="text-sm font-semibold">Preview <%= clip.name.downcase %></span>
        </button>
        <p x-show="failed" x-cloak class="absolute bottom-0 inset-x-0 p-2 text-xs text-center bg-surface/90 text-warning-ink"
           data-test="clip-load-failed">The clip did not load: <%= clip.object_key.split("/").last %></p>
      <% else %>
        <p class="absolute inset-0 flex items-center justify-center p-3 text-xs text-muted text-center break-all"
           data-test="clip-unreachable">Clip not reachable: <%= clip.object_key.split("/").last %></p>
      <% end %>
    </div>

    <div class="p-4 flex flex-col gap-3 min-w-0">
      <header class="flex flex-wrap items-start justify-between gap-2 min-w-0">
        <div class="min-w-0">
          <h3 class="text-lg font-bold text-heading"><%= clip.name %></h3>
          <p class="text-sm text-body font-mono tabular-nums" data-test="clip-window">
            <%= video_timecode(clip.start_ms) %>–<%= video_timecode(clip.end_ms) %>
            <span class="text-muted">· <%= format("%.1f", clip.duration_ms / 1000.0) %> s<% if clip.seam_ms %> · seam at <%= video_timecode(clip.seam_ms) %><% end %></span>
          </p>
        </div>
        <span class="badge text-3xs shrink-0 <%= status_chip %>" data-test="clip-status"><%= clip.status.humanize %></span>
      </header>

      <div class="flex flex-wrap gap-1.5">
        <span class="badge text-xs bg-primary/10 text-primary border-primary/20" data-test="clip-seam"><%= clip_seam_label(clip.seam) %></span>
        <span class="badge text-xs bg-surface-alt text-body border-subtle" data-test="clip-shape"><%= clip_shape_label(clip.cast_shape) %></span>
      </div>

      <p class="text-sm text-body min-w-0" data-test="clip-target">
        <span class="label-upper mr-1">Target</span>
        <% if target %>
          <%= target.name %><% if target.artist %> · <span class="font-semibold text-heading"><%= target.artist.name %></span><% end %>
          <span class="text-muted">(<%= target.label %>)</span>
        <% else %>
          <span class="text-muted">No labelled artist in this window; the prompt says “the singer”.</span>
        <% end %>
      </p>

      <div class="min-w-0">
        <div class="flex items-center justify-between gap-2 mb-1.5">
          <p class="label-upper">Swap prompt</p>
          <button type="button" @click="copy()" class="btn btn-outline btn-sm" data-test="clip-copy">
            <span x-text="copied ? 'Copied' : 'Copy'">Copy</span>
          </button>
        </div>
        <p x-ref="prompt" class="text-sm text-body bg-surface-alt border border-subtle rounded-lg p-3 whitespace-pre-wrap break-words select-all"
           data-test="clip-prompt"><%= clip.prompt %></p>
        <p x-show="manual" x-cloak class="text-xs text-warning-ink mt-1" data-test="clip-copy-manual">Copy is blocked here: the prompt is selected, press ⌘C.</p>
      </div>

      <div class="flex flex-col sm:flex-row gap-2 mt-auto pt-3 border-t border-subtle" data-test="clip-decision">
        <%= button_to "Approve", music_video_clip_path(video, clip.ordinal), method: :patch, params: { status: "approved" },
                      disabled: clip.approved?, class: "btn btn-primary btn-sm w-full sm:w-auto",
                      form: { class: "contents" } %>
        <%= button_to "Reject", music_video_clip_path(video, clip.ordinal), method: :patch, params: { status: "rejected" },
                      disabled: clip.status == "rejected", class: "btn btn-outline btn-sm w-full sm:w-auto",
                      form: { class: "contents" } %>
      </div>
    </div>
  </div>
</article>
