#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/devops-shift — the DevOps SHIFT LEASE cli. It keeps two same-role conductor
# sessions from colliding (two Avi heartbeats, or an Avi heartbeat + a standalone
# pr-review), the mirror of bin/task's build-claim lease at the ROLE granularity.
#
#   bin/devops-shift acquire <lane> [--label <text>]   # take the shift, or stand down
#   bin/devops-shift renew   <lane>                     # one heartbeat (bin/statusline calls this)
#   bin/devops-shift release <lane>                     # clean drop at session end
#   bin/devops-shift status                             # who's on shift, per lane
#   bin/devops-shift renew-loop <lane> --anchor-pid <p> --anchor-start <s>   # internal
#   bin/devops-shift <cmd> --help | -h                  # usage; takes NO shift
#
# EVERY ARGUMENT IS ACCOUNTED FOR BEFORE ANY SHIFT IS TAKEN. --help/-h anywhere on the
# line prints usage and mutates nothing; an unrecognized flag, a single-dash token, a
# positional the subcommand does not take, and a value-flag that consumed no value all
# REFUSE (exit CANT_RUN) instead of running the side effect. Before this, unknown flags
# fell through parse_flags into an ignored key and the command ran anyway: `acquire avi
# --help` PRINTED NO USAGE AND TOOK THE avi SHIFT — POSTing the acquire, writing the
# held-shift marker, and spawning a detached renewer to hold the lane — and a
# single-dash token was not even recorded as an ignored key: it vanished, side effect
# and all. The lane was read with a bare `argv.find { !start_with?("--") }` too, so
# `acquire --label Mew avi` took a shift on a lane called "Mew" that nothing else
# contends. This is the third and last member of the family closed on
# bin/lib/review_claim_cli.rb (PR #974) and bin/lib/release_claim_cli.rb (PR #980).
#
# HELP EXITS CANT_RUN (1) HERE, not OK — the same call release_claim_cli made, for a
# reason that is stronger here than in either sibling. In THIS CLI exit 0 is not "the
# command worked", it is the assertion "YOU ARE ON SHIFT", and it is the ONLY channel
# that assertion travels on: review_claim_cli could afford 0 because its claim rides on
# STDOUT (a caller reads `slug=$(bin/task claim-next-review)`, so a 0 with empty stdout
# is self-evidently not a claim), while `acquire` here prints prose for a human and
# hands the machine 0-vs-10 and nothing else. Answering a help probe with 0 would tell
# clean-up's review wave it holds the avi lane when it holds nothing — the exact
# two-concurrent-supervisors failure this lease exists to prevent. Every caller treats
# 1 safely: bin/statusline discards the exit code entirely, the detached renewer is
# never reaped for status, and a conductor SOP reading 1 fails OPEN — proceeding while
# KNOWING it is not on shift, which is the honest state.
#
# CHANGING COMMAND_FLAGS IS A WALL RISK, not a formality. The guard must refuse a bad
# line without refusing a real one, and the expensive direction is the second: the
# detached renewer re-enters this very CLI with its own spawned argv, out:/err: pinned
# at File::NULL, so a guard that refused it would print the refusal into /dev/null and
# every shift would lapse ~120s into a multi-minute act. Every real invocation in the
# ecosystem is enumerated and replayed through the guard in
# test/lib/devops_shift_argument_guard_test.rb (REAL_ARGV), including the renewer's own
# line, captured from a live acquire rather than hand-copied.
#
# A LANE is a role/shift key — `avi`, `alex` (the `steffon` lane was RETIRED when the
# qa-release lock moved onto the release record; see LANES below). Two live instances of
# the same lane contend; different lanes coexist (a clean-up vs an alex act). Identity is
# the SAME live-instance identity the build claim uses (session id + per-process
# nonce, SessionIdentity), so the heartbeat renews the right shift.
#
# RENEWAL IS OWNED BY THE RUN, NOT BY THE UI. `acquire` starts a detached renewer
# (`renew-loop`, see bin/lib/shift_renewer.rb) anchored to the agent process, and
# `release` stops it. Before this, the ONLY renewer was bin/statusline's status-line
# paint — so a headless holder (a background agent run, the autonomous heartbeat)
# renewed nothing and lost the lane ~120s in, while still working. bin/statusline
# still calls `renew`; it is now a harmless second renewer, not the only one.
#
# EXIT CODES make the acquire gate scriptable (and the SOP branch on it). This is the
# same table usage() prints, and the two must stay in step:
#   0  — acquired (you hold the shift; proceed)
#   10 — stood down (a DIFFERENT live instance holds the lane; do NOT proceed)
#   1  — could not run (no session id / no board / usage error, INCLUDING an argument
#        this CLI cannot account for) — fail OPEN so a telemetry hiccup never wedges a
#        real shift.
# Best-effort and never raises. `renew`/`release`/`status` exit 0 on the happy path, but
# they are NOT unconditionally 0: a missing lane, a board `status` cannot read, and any
# refused argument all exit 1 from those subcommands too.

require "json"
require "fileutils"
require "rbconfig"
require_relative "lib/agent_api"
require_relative "lib/session_identity"
require_relative "lib/session_markers"
require_relative "lib/shift_renewer"

class DevopsShiftCli
  OPEN_TIMEOUT = 2
  READ_TIMEOUT = 5

  # Acquire exit codes (see header).
  OK = 0
  STOOD_DOWN = 10
  CANT_RUN = 1

  # `steffon` RETIRED (release-conductor-claims): the qa-release lock moved onto the
  # release record (the `assembler` conductor claim, inside bin/release prepare), and
  # avi-ship onto the `deployer` claim. `avi` stays for `clean-up`'s board sweep.
  LANES = %w[avi alex].freeze

  # --help/-h from ANY position prints usage and mutates nothing. The same two
  # spellings bin/task, review_claim_cli, and release_claim_cli honor, because an agent
  # probing this CLI has no way to know it is a different parser.
  HELP_FLAGS = %w[--help -h].freeze

  # The flags each subcommand understands — the dictionary an unrecognized argument is
  # rejected against. A command with NO flags is still keyed here, so this hash doubles
  # as the set of subcommands run() dispatches; a key without a `when` arm below is
  # drift, and a test pins the two together. See the WALL RISK note in the header
  # before adding to it.
  COMMAND_FLAGS = {
    "acquire"    => %w[--label],
    "renew"      => [],
    "renew-loop" => %w[--anchor-pid --anchor-start],
    "release"    => [],
    "status"     => []
  }.freeze

  # Every flag above takes a VALUE — this CLI has no boolean flags. parse_flags stores
  # `true` for a flag that consumed no token, and `true.to_s` is the string "true", so
  # a trailing `--label` silently labelled the shift "true" and the stand-down message
  # then named a holder called "true". A flag that consumed nothing is a usage error,
  # not a boolean. A future BOOLEAN flag must be left out of this list ON PURPOSE; a
  # drift test fails until someone does so deliberately.
  VALUE_FLAGS = %w[--label --anchor-pid --anchor-start].freeze

  # The subcommands that name their own lane. `status` deliberately does NOT: it is the
  # CROSS-lane read that reports every lane, so a lane on that line is a caller who
  # asked about one lane and would have been answered about all of them — the same
  # silent substitution as the dropped flag, one seam over.
  LANE_COMMANDS = %w[acquire renew renew-loop release].freeze

  # What a refusal COST the caller, per subcommand. One sentence for all of them would
  # be wrong in the DANGEROUS direction: "NOTHING was claimed" on a refused `release`
  # reads as "the lane is free" when in fact the shift is still held AND its detached
  # renewer is still renewing it, so it will not even lapse on the TTL. And `renew` is
  # the opposite hazard — it is the status line's REDUNDANT second beat, so claiming
  # the lease is dying would send an operator chasing a perfectly healthy shift. Name
  # the state the caller is actually left in.
  REFUSAL_CONSEQUENCE = {
    "acquire"    => "NOTHING was claimed — this session is NOT on shift.",
    "renew"      => "this heartbeat never reached the board (the detached renewer, if any, is unaffected).",
    "renew-loop" => "the renewer never started — this shift lapses unless something else renews it.",
    "release"    => "the shift was NOT released — it is STILL HELD, and its renewer keeps renewing it.",
    "status"     => "nothing was read; this says nothing about who is on shift."
  }.freeze

  def initialize(env: ENV, out: $stdout, err: $stderr)
    @env = env
    @out = out
    @err = err
    @api = AgentApi.new(env: env, open_timeout: OPEN_TIMEOUT, read_timeout: READ_TIMEOUT)
    # Injected in tests so no test ever forks a real renewer or signals a real pid.
    @spawner = method(:spawn_detached)
    @killer  = method(:terminate)
  end

  # Entry point. Returns the process exit code.
  #
  # ARGUMENT VALIDATION RUNS BEFORE DISPATCH, and that ordering is the whole point.
  # Unknown flags used to fall through parse_flags into an ignored key and the command
  # ran anyway on a line nobody had accounted for: `acquire avi --help` took a real
  # shift lease, and a single-dash token vanished without even becoming an ignored key.
  # An argument this CLI cannot account for now REFUSES rather than assuming the rest
  # of the line was what you meant.
  def run(argv)
    return usage(CANT_RUN) if argv.any? { |arg| HELP_FLAGS.include?(arg) }

    command = argv.shift
    return usage(CANT_RUN) unless COMMAND_FLAGS.key?(command)

    unknown, valueless = bad_arguments(command, argv)
    return refuse(command, unknown, valueless) if unknown.any? || valueless.any?

    # The lane is the first POSITIONAL — a value-flag's value must NOT be mistaken for
    # it. A bare `argv.find { !start_with?("--") }` read `acquire --label Mew avi` as a
    # shift on the lane "Mew", a lane nothing else contends, so the lease looked held
    # and protected nothing.
    lane = positionals(argv).first
    flags = parse_flags(argv)

    case command
    when "acquire"    then acquire(lane, flags)
    when "renew"      then renew(lane)
    when "renew-loop" then renew_loop(lane, flags)
    when "release"    then release(lane)
    when "status"     then status
    else usage(CANT_RUN) # drift guard: a COMMAND_FLAGS key with no arm here
    end
  rescue StandardError => e
    @err.puts("devops-shift failed (ignored): #{e.class}: #{e.message}")
    CANT_RUN
  end

  # ── Commands ────────────────────────────────────────────────────────────────

  def acquire(lane, flags)
    return usage_lane("acquire") unless present?(lane)

    sid = session_id
    return cant_run("no session id — cannot identify this shift") unless present?(sid)

    label = flags["label"].to_s.strip
    label = session_mascot(sid) if label.empty?
    res = post("/api/v1/devops_shifts/acquire",
               { "lane" => lane, "session" => sid, "nonce" => nonce, "label" => label })
    return cant_run("no response from the board — proceeding without a shift lease") unless ok?(res)

    data = parse_data(res)
    if data["acquired"]
      write_marker(sid, lane)
      start_renewer(sid, lane)
      @out.puts("devops-shift: ✅ #{lane} shift acquired — you're on shift.")
      OK
    else
      report_stand_down(lane, data["holder"] || {})
      STOOD_DOWN
    end
  end

  def renew(lane)
    return usage_lane("renew") unless present?(lane)

    sid = session_id
    return OK unless present?(sid) # best-effort heartbeat — never a failure

    post("/api/v1/devops_shifts/renew", { "lane" => lane, "session" => sid, "nonce" => nonce })
    OK
  end

  # The detached renewer body (started by `acquire`; not for hand invocation). Renews
  # while the anchor process lives, so the lease follows the RUN and not the UI. It
  # inherits DEVOPS_SHIFT_SESSION + TASK_CLAIM_NONCE from its parent because, once
  # detached, it can no longer re-derive the live-instance identity by walking its own
  # ancestry — a renewer that guessed its nonce would renew NOTHING, and every renew
  # would 204 silently, which is indistinguishable from the bug it exists to fix.
  def renew_loop(lane, flags)
    return usage_lane("renew-loop") unless present?(lane)

    pid = flags["anchor-pid"]
    start = flags["anchor-start"]
    ShiftRenewer.run(
      alive:   -> { SessionIdentity.process_alive?(pid, start) },
      renew:   -> { renewed?(lane) },
      sleeper: ->(seconds) { sleep(seconds) },
      clock:   -> { Time.now },
      interval: ShiftRenewer.interval_from(@env["DEVOPS_SHIFT_RENEW_INTERVAL"])
    )
    OK
  end

  def release(lane)
    return usage_lane("release") unless present?(lane)

    sid = session_id
    res = (post("/api/v1/devops_shifts/release", { "lane" => lane, "session" => sid, "nonce" => nonce }) if present?(sid))
    stop_renewer(sid)
    clear_marker(sid, lane)
    report_release(lane, res)
    OK
  end

  def status
    res = get("/api/v1/devops_shifts")
    return cant_run("could not read shift status") unless ok?(res)

    rows = parse_data(res)
    rows = [] unless rows.is_a?(Array)
    live = rows.select { |r| r["live"] }
    if live.empty?
      @out.puts("devops-shift: no shifts are currently held.")
    else
      @out.puts("devops-shift: on shift now:")
      live.each { |r| @out.puts("  #{r['lane']} — #{holder_line(r)}") }
    end
    OK
  end

  # ── The detached renewer ─────────────────────────────────────────────────────

  # Start a renewer for the shift we just took. No anchor process ⇒ no renewer: we
  # will not start a background process whose owner we cannot identify, because
  # nothing would ever tell it to stop. That case (a plain shell, CI) simply keeps
  # the old status-line/manual renewal, and we say so rather than implying cover we
  # are not providing.
  def start_renewer(sid, lane)
    anchor = anchor_process
    unless anchor
      @out.puts("devops-shift: note — no agent process to anchor a renewer to; " \
                "this shift lapses in ~#{lease_ttl_seconds}s unless something renews it.")
      return nil
    end

    argv = [RbConfig.ruby, __FILE__, "renew-loop", lane,
            "--anchor-pid", anchor[:pid].to_s, "--anchor-start", anchor[:start].to_s]
    pid = @spawner.call(renewer_env(sid), argv)
    write_renewer_marker(sid, pid) if pid
    pid
  rescue StandardError => e
    @err.puts("devops-shift: could not start the shift renewer (#{e.class}) — " \
              "the lease will rely on the status line as before.")
    nil
  end

  # The identity the renewer must carry. Detached, it cannot walk its way back to the
  # agent process, so both halves of the live-instance identity are handed down
  # explicitly — the nonce especially, since a wrong one renews nothing, silently.
  def renewer_env(sid)
    { "DEVOPS_SHIFT_SESSION" => sid.to_s, "TASK_CLAIM_NONCE" => nonce.to_s }
  end

  # The process to anchor the lease lifetime to. DEVOPS_SHIFT_ANCHOR_PID lets a
  # headless runner (or a test) name its own long-lived owner instead of relying on a
  # `claude`/`codex` ancestor being present.
  def anchor_process
    override = @env["DEVOPS_SHIFT_ANCHOR_PID"].to_s.strip
    return { pid: override.to_i, start: SessionIdentity.proc_start(override) } unless override.empty?

    SessionIdentity.agent_process
  end

  # One heartbeat from inside the loop. TRUE keeps the loop running.
  #
  # A definitive 204 means the board says we are no longer the holder — released
  # elsewhere, or the lane changed hands — so we stop. An unreachable board is NOT
  # that: it is no evidence either way, and stopping there would guarantee losing a
  # lane we probably still hold. So a network blip keeps renewing (bounded by the
  # renewer's safety cap), while a clear "you don't hold this" stops.
  def renewed?(lane)
    res = post("/api/v1/devops_shifts/renew", { "lane" => lane, "session" => session_id, "nonce" => nonce })
    return true if res.nil? # board unreachable — not proof we lost the shift

    res.code.to_i != 204
  end

  def stop_renewer(sid)
    pid = read_renewer_marker(sid)
    @killer.call(pid) if pid
    clear_renewer_marker(sid)
  rescue StandardError
    nil
  end

  def spawn_detached(env, argv)
    pid = Process.spawn(env, *argv, out: File::NULL, err: File::NULL, pgroup: true)
    Process.detach(pid)
    pid
  end

  def terminate(pid)
    Process.kill("TERM", pid.to_i)
  rescue StandardError
    nil # already gone, or never ours to kill
  end

  # ── Rendering ────────────────────────────────────────────────────────────────

  # Report what the BOARD did, not what we hoped it did.
  #
  # This used to print "shift released." unconditionally. The board answers 204 when
  # the caller is not the holder — nothing is released — so `release` claimed success
  # while `status` went on showing the shift, and the operator had two commands
  # disagreeing about one fact. Both now speak from the board: the verdict comes from
  # the release response, and the holder line is re-read from the very endpoint
  # `status` renders.
  def report_release(lane, res)
    if res.nil?
      @out.puts("devops-shift: could not reach the board — the #{lane} shift will lapse " \
                "on its own within ~#{lease_ttl_seconds}s.")
    elsif res.code.to_i == 204
      @out.puts("devops-shift: #{lane} shift was not held by this session — nothing released.")
      report_live_holder(lane)
    elsif ok?(res)
      @out.puts("devops-shift: #{lane} shift released.")
    else
      @out.puts("devops-shift: the board refused the #{lane} release (HTTP #{res.code}) — " \
                "it will lapse within ~#{lease_ttl_seconds}s.")
    end
  end

  # Who `status` would show for this lane, read from the same endpoint status reads.
  def report_live_holder(lane)
    res = get("/api/v1/devops_shifts")
    return unless ok?(res)

    rows = parse_data(res)
    row = rows.is_a?(Array) ? rows.find { |r| r["lane"] == lane && r["live"] } : nil
    @out.puts(row ? "  still on shift: #{holder_line(row)}" : "  the #{lane} lane is free.")
  end

  # The stand-down message: name the live holder so the operator/agent knows WHO is
  # already on shift and can stop cleanly.
  def report_stand_down(lane, holder)
    @out.puts("devops-shift: 🛑 #{lane} shift already held — STAND DOWN.")
    @out.puts("  #{holder_line(holder)}")
    @out.puts("  Another #{lane} session is live. Do not review/merge/ship; let it finish " \
              "(its lease lapses ~#{lease_ttl_seconds}s after it stops).")
  end

  def holder_line(holder)
    label = holder["label"].to_s.strip
    who = label.empty? ? "session #{short(holder['session'])}" : "#{label} · session #{short(holder['session'])}"
    age = holder["heartbeat_age"]
    since = holder["acquired_at"].to_s
    age_txt = age.nil? ? "" : ", last heartbeat ~#{age}s ago"
    since_txt = since.empty? ? "" : " since #{since}"
    "#{who}#{since_txt}#{age_txt}"
  end

  # ── HTTP + helpers ───────────────────────────────────────────────────────────

  def post(path, body)
    tok = @api.token
    return nil unless tok

    res = @api.http_json(:post, path, body, bearer: tok)
    @api.invalidate_token! if res && res.code.to_i == 401
    res
  rescue StandardError
    nil
  end

  def get(path)
    tok = @api.token
    return nil unless tok

    res = @api.http_json(:get, path, nil, bearer: tok)
    @api.invalidate_token! if res && res.code.to_i == 401
    res
  rescue StandardError
    nil
  end

  def ok?(res)
    res && res.code.to_i.between?(200, 299)
  end

  def parse_data(res)
    body = JSON.parse(res.body)
    body.is_a?(Hash) ? (body["data"] || {}) : {}
  rescue StandardError
    {}
  end

  def parse_flags(argv)
    flags = {}
    i = 0
    while i < argv.length
      arg = argv[i]
      if arg.start_with?("--")
        nxt = argv[i + 1]
        if nxt.nil? || nxt.start_with?("--")
          flags[arg.delete_prefix("--")] = true
          i += 1
        else
          flags[arg.delete_prefix("--")] = nxt
          i += 2
        end
      else
        i += 1
      end
    end
    flags
  end

  # ── Argument validation (runs BEFORE any command dispatch) ───────────────────

  # The positional args — argv with every `--flag`/`--flag value` pair removed, and
  # every dashed token excluded. Derived from the SAME each_argument walk the guard
  # uses (which in turn mirrors parse_flags), so the three can never disagree about
  # where a flag's value ends. The lane is positionals.first.
  #
  # A DASHED TOKEN IS NEVER A POSITIONAL, so it can never become the lane either —
  # unknown_flags reports it instead. Before the guard, `acquire -l Mew` resolved its
  # lane to the literal string "-l" and asked the board for a shift on it.
  def positionals(argv)
    found = []
    each_argument(argv) { |arg, _value| found << arg unless arg.start_with?("-") }
    found
  end

  # Everything this command cannot account for, as [unknown, valueless]:
  #
  #   unknown   — an unrecognized flag, a single-dash token (which parse_flags drops
  #               on the floor entirely), and a positional the command does not take.
  #   valueless — a KNOWN value-flag that consumed no token, so parse_flags stored
  #               `true` for it and the command would have read the string "true".
  #
  # Two lists, not one, because they need different copy: `--label` is a real flag
  # typed wrong, not an argument nobody recognizes. Both walks consume flag values the
  # SAME way parse_flags does, so `--label Mew` is never mistaken for a stray
  # positional — that fidelity is what keeps a VALID invocation taking its shift
  # instead of turning this guard into "refuse everything".
  def bad_arguments(command, argv)
    valid = COMMAND_FLAGS.fetch(command, [])
    extra = positionals(argv)
    extra = extra.drop(1) if LANE_COMMANDS.include?(command)
    [unknown_flags(argv, valid) + extra, valueless_flags(argv, valid)]
  end

  def unknown_flags(argv, valid)
    bad = []
    each_argument(argv) do |arg, _value|
      if arg.start_with?("--")
        bad << arg unless valid.include?(arg)
      elsif arg.start_with?("-")
        # A single-dash token is never a lane and never a flag parse_flags reads —
        # before this guard `-l` (and `-h`) vanished silently, side effect and all.
        # It consumes nothing, so whatever followed it lands in `extra` on its own.
        bad << arg
      end
    end
    bad
  end

  # A known value-flag that consumed NO token. Scoped to `valid` on purpose: an
  # unrecognized flag is already reported by unknown_flags, and naming it twice would
  # make a single typo look like two separate mistakes.
  def valueless_flags(argv, valid)
    bad = []
    each_argument(argv) do |arg, value|
      bad << arg if valid.include?(arg) && VALUE_FLAGS.include?(arg) && value.nil?
    end
    bad
  end

  # The ONE walk of the line, shared by every reader above so they can never disagree
  # about where a flag's value ends. Yields [token, consumed_value] — value is nil when
  # the token consumed nothing (a bare positional, a single-dash token, or a flag at
  # the end of the line or followed by another flag). The consumption rule is
  # parse_flags's, deliberately: a guard that split the line differently from the
  # parser would refuse lines the parser handles, or pass lines it mangles.
  #
  # AN EMPTY STRING IS A CONSUMED VALUE, not a missing one. start_renewer spawns
  # `--anchor-start ""` whenever SessionIdentity.proc_start cannot read the anchor's
  # start signature, and refusing that would kill the renewer over a case the renewer
  # already handles (a blank signature reads as "stop renewing", the safe direction).
  def each_argument(argv)
    i = 0
    while i < argv.length
      arg = argv[i]
      if arg.start_with?("--")
        nxt = argv[i + 1]
        consumed = (nxt.nil? || nxt.start_with?("--")) ? nil : nxt
        yield(arg, consumed)
        i += consumed.nil? ? 1 : 2
      else
        # Everything that is not a `--flag` consumes NOTHING — a bare positional, and
        # a single-dash token alike, matching parse_flags exactly. So whatever follows
        # a `-x` is classified on its own, which is honest: the parser would have read
        # it as a positional too.
        yield(arg, nil)
        i += 1
      end
    end
  end

  # Refuse LOUDLY: name every argument, list what IS valid, and say plainly what the
  # caller is left holding — an operator who typo'd a flag on `release` must never be
  # left believing the lane is free. Exit CANT_RUN (1), the same code every other usage
  # error gives, so bin/statusline still discards it and a conductor SOP still fails
  # OPEN, exactly as they already do.
  def refuse(command, unknown, valueless)
    valid = COMMAND_FLAGS.fetch(command, [])
    cost = REFUSAL_CONSEQUENCE.fetch(command, "NOTHING was done.")

    if unknown.any?
      noun = unknown.length == 1 ? "argument" : "arguments"
      hint = valid.empty? ? " (this subcommand takes no flags)" : " (valid flags: #{valid.join(', ')})"
      @err.puts("devops-shift #{command}: unrecognized #{noun} #{unknown.map(&:inspect).join(', ')}#{hint} — #{cost}")
    end
    if valueless.any?
      verb = valueless.length == 1 ? "needs a value" : "need values"
      @err.puts("devops-shift #{command}: #{valueless.join(', ')} #{verb} — #{cost}")
    end
    # A lane typed at `status` is a caller who wants one lane's holder. Name what they
    # will actually get: a refusal that only says no leaves them re-typing the line.
    if command == "status" && unknown.any? { |arg| !arg.start_with?("-") }
      @err.puts("devops-shift status takes NO lane — it reports EVERY lane's holder in one read.")
    end

    usage(CANT_RUN)
  end

  # The usage block --help prints and every refusal ends with. STDERR deliberately:
  # acquire/status/release print their human verdict on STDOUT and a conductor SOP
  # echoes both streams into its log, so usage text on stdout would read as a verdict.
  # Returns the exit code it was handed, so a caller reads `return usage(CANT_RUN)`.
  def usage(code)
    @err.puts(<<~TEXT)
      usage: bin/devops-shift acquire <lane> [--label <text>]
             bin/devops-shift renew   <lane>
             bin/devops-shift release <lane>
             bin/devops-shift status                       # every lane, in one read
             bin/devops-shift renew-loop <lane> --anchor-pid <p> --anchor-start <s>  # internal
      lanes: #{LANES.join(' | ')}
      `acquire` is a WRITE, not a read: it takes a real ~#{lease_ttl_seconds}s shift lease on the lane
      and starts a detached renewer that holds it for as long as this session lives.
      Release what you take: bin/devops-shift release <lane>
      exit: 0 acquired (you ARE on shift) · 10 stood down (another live session holds the lane)
            · 1 could not run / usage — NOT a shift-state answer
    TEXT
    code
  end

  def session_id
    explicit = @env["DEVOPS_SHIFT_SESSION"].to_s.strip
    return explicit unless explicit.empty?

    SessionIdentity.id(@env)
  end

  def nonce
    SessionIdentity.nonce(@env)
  end

  # The session's stable base mascot (for the step-down message), or "".
  def session_mascot(sid)
    marker = SessionMarkers.read_session_marker(sid, @api.projects_dir) || {}
    marker["mascot"].to_s.strip
  rescue StandardError
    ""
  end

  # ── Local held-shift marker (so bin/statusline knows what to renew) ───────────
  # Path resolution AND the fail-closed sandbox guard both live on SessionMarkers
  # — this marker shares the narration store with .open-activity/.acting-agent, so
  # it shares their one choke point rather than re-deriving the path here.
  DEVOPS_SHIFT = ".devops-shift"

  # The renewer's pid lives in its OWN marker rather than as a second line of
  # .devops-shift: bin/statusline reads that file for the lane, and widening a file
  # another reader parses is how a small change breaks a distant one.
  DEVOPS_SHIFT_RENEWER = ".devops-shift-renewer"

  def write_marker(sid, lane)
    SessionMarkers.write(sid, @api.projects_dir, DEVOPS_SHIFT, "#{lane}\n", env: @api.env)
  end

  def clear_marker(sid, _lane)
    SessionMarkers.delete(sid, @api.projects_dir, DEVOPS_SHIFT, env: @api.env)
  end

  def write_renewer_marker(sid, pid)
    SessionMarkers.write(sid, @api.projects_dir, DEVOPS_SHIFT_RENEWER, "#{pid}\n", env: @api.env)
  end

  def read_renewer_marker(sid)
    pid = SessionMarkers.read(sid, @api.projects_dir, DEVOPS_SHIFT_RENEWER).to_s.strip.to_i
    pid.positive? ? pid : nil
  rescue StandardError
    nil
  end

  def clear_renewer_marker(sid)
    SessionMarkers.delete(sid, @api.projects_dir, DEVOPS_SHIFT_RENEWER, env: @api.env)
  end

  def usage_lane(cmd)
    @err.puts("devops-shift #{cmd} needs a lane (e.g. `devops-shift #{cmd} avi`)")
    CANT_RUN
  end

  def cant_run(message)
    @err.puts("devops-shift: #{message}")
    CANT_RUN
  end

  def short(value)
    s = value.to_s
    s.length > 4 ? "…#{s[-4..]}" : s
  end

  def present?(value)
    @api.present?(value)
  end

  # The lease TTL for the stand-down copy — read from ClaimLease when the app libs
  # are loadable (they are in-repo), else the documented 120s default.
  def lease_ttl_seconds
    require_relative "../lib/claim_lease"
    ClaimLease::DEFAULT_TTL_SECONDS
  rescue StandardError
    120
  end
end

if $PROGRAM_NAME == __FILE__
  exit(DevopsShiftCli.new.run(ARGV))
end
