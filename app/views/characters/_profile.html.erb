<%# A character's profile card: avatar, name, kind, brand (linked to its kit
    page), bio, personality and voice notes. Locals: character, kit (or nil),
    avatar_url (or nil). %>
<div class="card p-4 sm:p-5" data-test="character-profile">
  <div class="flex flex-col sm:flex-row gap-4">
    <div class="w-32 h-32 shrink-0 rounded-lg bg-surface-alt border border-subtle flex items-center justify-center overflow-hidden">
      <% if avatar_url.present? %>
        <img src="<%= avatar_url %>" alt="<%= character.name %>" class="max-h-full max-w-full object-contain" data-test="profile-avatar">
      <% else %>
        <span class="text-4xl font-bold text-muted" aria-hidden="true"><%= character.name.first %></span>
      <% end %>
    </div>
    <div class="min-w-0 flex-1 space-y-2">
      <div class="flex flex-wrap items-start justify-between gap-2">
        <h1 class="text-xl sm:text-2xl font-bold text-heading break-words"><%= character.name %></h1>
        <%= link_to "Edit", edit_character_path(character), class: "btn btn-sm btn-neutral", data: { test: "edit-character" } %>
      </div>
      <div class="flex flex-wrap gap-1.5">
        <span class="badge text-3xs bg-primary/10 text-primary border-primary/40" data-test="profile-kind"><%= character.kind %></span>
        <% if character.retired? %>
          <span class="badge text-3xs bg-surface-alt text-muted border-subtle">retired</span>
        <% end %>
        <% if kit %>
          <%= link_to "Brand kit: #{kit.label} →", email_brand_kit_path(kit.key),
                      class: "badge text-3xs bg-surface-alt text-body border-subtle hover:text-primary", data: { test: "profile-brand-kit" } %>
        <% elsif character.brand.present? %>
          <span class="badge text-3xs bg-surface-alt text-muted border-subtle"><%= character.brand %></span>
        <% end %>
      </div>
      <dl class="grid gap-3 sm:grid-cols-3 text-sm">
        <div class="min-w-0" data-test="profile-bio">
          <dt class="text-2xs font-semibold text-heading">Bio</dt>
          <dd class="text-body break-words whitespace-pre-line"><%= character.bio.presence || "—" %></dd>
        </div>
        <div class="min-w-0" data-test="profile-personality">
          <dt class="text-2xs font-semibold text-heading">Personality</dt>
          <dd class="text-body break-words whitespace-pre-line"><%= character.personality.presence || "—" %></dd>
        </div>
        <div class="min-w-0" data-test="profile-voice">
          <dt class="text-2xs font-semibold text-heading">Voice notes</dt>
          <dd class="text-body break-words whitespace-pre-line"><%= character.voice_notes.presence || "—" %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>
