#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/triage — file and list TRIAGE FINDINGS, the inbox where agent-discovered
# follow-ups land INSTEAD of becoming board tasks. A finding costs nothing
# sitting in the inbox; a task costs a worktree, a review, and a release slot —
# so the default destination for "we should also…" is HERE, and only an operator
# promote (admin-gated on /triage) mints a task.
#
#   bin/triage file --title "Short finding title" [--body "..."]
#                   [--prior-art none|"<what was already there>"]
#                   [--source <who>] [--repo <app>]
#   bin/triage list [--status open|promoted|dismissed] [--json]
#
# --prior-art answers "did this surface already exist, and under what controls?"
# It has THREE states, and the default is the point:
#
#   (omitted)              -> unknown  "nobody looked" — recorded, not implied
#   --prior-art none       -> none     "I looked; this surface is new here"
#   --prior-art "<text>"   -> found    "I looked; here is what was already there"
#
# Omitting it is fine and costs nothing — it just says so out loud, because a
# BLANK prior art gets read as "none found" and that read is how a long-standing
# defect gets reported as a fresh one (finding-6a5fdcd157b3: the consuming app's
# deleted view had carried the identical unsandboxed iframe all along).
#
# --json prints the full finding rows (BODY included) as one JSON array, which is
# what a caller needs to tell two findings apart — the human line shows only the
# title, and `bin/release retro` matches title AND body verbatim before filing.
#
# Auth: AGENT_API_SECRET from ENV, else 1Password, else the repo .env — the same
# resolution as bin/task (TaskBoard.agent_secret). Base URL via TASK_API_BASE.

require "json"
require_relative "lib/task_board"

BASE_URL = ENV.fetch("TASK_API_BASE", "https://mcritchie.studio")

def die!(message, code: 1)
  warn("triage: #{message}")
  exit(code)
end

def agent_secret
  dotenv = File.join(__dir__, "..", ".env")
  TaskBoard.agent_secret(dotenv) ||
    die!("AGENT_API_SECRET not found (checked ENV, 1Password, #{dotenv})")
end

def token
  @token ||= api(:post, "/api/v1/auth", { secret: agent_secret }, auth: false).fetch("token")
end

def api(method, path, body = nil, opts = {})
  auth = opts.fetch(:auth, true)
  res = TaskBoard.request(method, path, base_url: BASE_URL, token: (auth ? token : nil), body: body)
  parsed = TaskBoard.parse_body(res)
  die!("#{method.upcase} #{path} -> #{res.code}: #{parsed["error"] || res.body}") unless res.code.to_i.between?(200, 299)
  parsed
end

def take_flag(argv, flag)
  !argv.delete(flag).nil?
end

# EVERY page, not just the first. Api::Paginatable caps per_page at 100 and the
# open inbox is already at 84 — a single-page read would go blind past the cap
# with no error, which is exactly how a duplicate guard stops guarding without
# anyone noticing. Ordering is created_at DESC (TriageFinding.recent).
#
# STRICT count (TaskBoard.rows!), for the same reason the paging exists. `api`
# die!s on a non-2xx, but a 2xx whose BODY is unreadable — a proxy's HTML error
# page, a truncated response — used to parse leniently to `{}`, making `batch`
# `[]`, which ends the loop as though the last page had been read. The duplicate
# guard then compares against a SHORT list and files a finding it already has,
# and the inbox reports "(0 finding(s))" — the reassuring answer. `rows!` refuses
# an unreadable page instead of scoring it empty; `[]` from it means genuinely
# none. `api` still owns the non-2xx rendering, so its HTML-error-page verdict
# is untouched.
def all_findings(status)
  rows = []
  page = 1
  loop do
    payload = api(:get, "/api/v1/triage_findings?status=#{status}&per_page=100&page=#{page}")
    batch = TaskBoard.rows!(payload)
    rows.concat(batch)
    total_pages = payload.dig("meta", "total_pages").to_i
    break if batch.empty? || page >= total_pages

    page += 1
  end
  rows
rescue TaskBoard::UnreadableResponse => e
  die!("UNREADABLE INBOX — page #{page} of the triage findings could not be read: #{e.message}\n" \
       "  An unreadable page is NOT an empty inbox. Listing a short set makes the duplicate\n" \
       "  guard file a finding that already exists. Fix the read, then re-run.")
end

# Underscores included on purpose: `--prior_art` is a near-miss worth naming, and
# a pattern that did not match it would drop that spelling into the generic
# "unexpected argument(s)" branch with no suggestion attached.
FLAG_SHAPED = /\A--[a-z][a-z0-9_-]*\z/

def take_value(argv, flag)
  idx = argv.index(flag)
  return nil unless idx

  value = argv[idx + 1] || die!("#{flag} needs a value — nothing was filed")
  # `--title --body "x"` must not file a finding titled "--body". A value that
  # is itself flag-shaped is a MISSING value, not a value.
  die!("#{flag} needs a value, got the flag #{value} — nothing was filed") if value.match?(FLAG_SHAPED)
  argv.slice!(idx, 2)
  value
end

# The flags each subcommand accepts, and the near-misses worth naming.
KNOWN_FLAGS = {
  "file" => %w[--title --body --prior-art --source --repo],
  "list" => %w[--status --json]
}.freeze

NEAR_MISS = {
  "--detail" => "--body", "--details" => "--body", "--description" => "--body",
  "--desc" => "--body", "--note" => "--body", "--notes" => "--body",
  "--text" => "--body", "--message" => "--body", "--content" => "--body",
  "--name" => "--title", "--summary" => "--title",
  "--app" => "--repo", "--repository" => "--repo", "--project" => "--repo",
  "--agent" => "--source", "--who" => "--source", "--from" => "--source",
  "--prior_art" => "--prior-art", "--priorart" => "--prior-art", "--prior" => "--prior-art"
}.freeze

# REFUSE loudly. This guard already existed and already exited 1 — but it said
#   triage: unknown argument(s): --detail <the entire body you just typed>
# which reads like the command ECHOING your text back, not like a refusal. On
# 2026-08-11 `--detail` was typed seven times, seven findings were reported as
# filed, and NONE existed. Same disease as the finding this whole change is
# about: a tool reporting success it did not achieve. So the refusal now leads
# with the CONSEQUENCE, names the FLAG rather than the value tail, and points at
# the near-miss.
def refuse_unknown_args!(argv, cmd, consequence)
  return if argv.empty?

  flags = argv.grep(FLAG_SHAPED)
  warn("triage: REFUSED — #{consequence}.")
  if flags.empty?
    warn("triage:   unexpected argument(s): #{argv.join(' ')}")
  else
    flags.each do |flag|
      hint = NEAR_MISS[flag]
      warn("triage:   unrecognized flag #{flag}#{hint ? " — did you mean #{hint}?" : ''}")
    end
  end
  warn("triage:   #{cmd} accepts: #{KNOWN_FLAGS.fetch(cmd).join(' ')}")
  exit(1)
end

# Map the one --prior-art flag onto the model's [state, note] pair. One flag
# keeps filing cheap; the literal words `none` and `unknown` are the two
# reserved values and ANYTHING else is read as the evidence itself. The
# confirmation line echoes the RESOLVED state, so a value that lands in a state
# you did not mean is visible the moment you file.
def prior_art_pair(value)
  return ["unknown", nil] if value.nil?

  case value.strip.downcase
  when "none", "no", "n/a" then ["none", nil]
  when "unknown", "?" then ["unknown", nil]
  else ["found", value.strip]
  end
end

def usage!
  warn(File.read(__FILE__).lines.grep(/^#( |$)/).map { |l| l.sub(/^# ?/, "") }.join)
  exit(1)
end

cmd = ARGV.shift
case cmd
when "file"
  title = take_value(ARGV, "--title") || die!("--title is required — nothing was filed")
  body = take_value(ARGV, "--body")
  source = take_value(ARGV, "--source")
  repo = take_value(ARGV, "--repo")
  prior_art, prior_art_note = prior_art_pair(take_value(ARGV, "--prior-art"))
  refuse_unknown_args!(ARGV, "file", "nothing was filed")
  finding = api(:post, "/api/v1/triage_findings",
                { title: title, body: body, source: source, repo: repo,
                  prior_art: prior_art, prior_art_note: prior_art_note }.compact)["data"]
  puts("filed #{finding["slug"]}  #{finding["title"]}")
  # Echoed in all three states, and ONE line in each. The uninvestigated line is
  # a nudge, not a gate: requiring prior art would make the cheapest path "don't
  # file it", and this inbox exists because filing must stay free. It is one line
  # because `bin/release retro` files follow-ups in bulk through this same path —
  # a paragraph per finding would train everyone to scroll past it. The teaching
  # lives in the usage header and in modules/pr-review-sop.md.
  if finding["prior_art"] == "unknown"
    warn("  prior art: NOT INVESTIGATED — recorded as such, not as \"none\". " \
         "Checked what was already there? Refile with --prior-art.")
  else
    puts("  prior art: #{finding['prior_art']}#{finding['prior_art_note'] ? " — #{finding['prior_art_note']}" : ''}")
  end
when "list"
  status = take_value(ARGV, "--status") || "open"
  as_json = take_flag(ARGV, "--json")
  refuse_unknown_args!(ARGV, "list", "nothing was listed")
  rows = all_findings(status)
  if as_json
    puts(JSON.generate(rows))
  else
    # The human line stays a SCAN line. Marking all ~90 legacy rows "unknown"
    # would be noise everyone tunes out within a day, so only an INVESTIGATED
    # finding earns a marker — the list rewards the check instead of nagging
    # about its absence. The loud unknown lives where the finding is actually
    # acted on: the file confirmation, the /triage card, and the promoted brief.
    rows.each do |f|
      mark = f["prior_art"] && f["prior_art"] != "unknown" ? "  [prior art: #{f['prior_art']}]" : ""
      puts("#{f["slug"]}  [#{f["status"]}]#{mark}  #{f["title"]}")
    end
    puts("(#{rows.size} finding(s))")
  end
else
  usage!
end
