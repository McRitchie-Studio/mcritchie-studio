#!/usr/bin/env ruby
# frozen_string_literal: true

# bin/heroku-secret-set — set a SECRET Heroku config var with the value on stdin,
# never on a command line.
#
#   <producer> | bin/heroku-secret-set <app> <NAME>     # stdin is the value
#   <producer> | bin/heroku-secret-set <app> --json     # stdin is {"NAME": "value", ...}
#
#   <an op read of the item's field> | bin/heroku-secret-set mcritchie-studio ANTHROPIC_API_KEY
#   printf '%s' "$NEW" | bin/heroku-secret-set turf-monster-qa SOLANA_ADMIN_KEY
#   bin/heroku-secret-set mcritchie-studio GOOGLE_SERVICE_ACCOUNT_JSON < "$KEYFILE"
#
# WHY. `heroku config:set NAME=value` takes the value as an argument, and `ps`
# shows every process's arguments to every local process, so the value is one
# listing away from a transcript (secrets-never-on-argv-or-desk-env). This makes
# the same call the CLI makes, a Platform API PATCH of /apps/<app>/config-vars,
# which creates one release like config:set does, with the value in the request
# body and the token in a header, neither of them an argument.
#
# The single-value form strips ONE trailing newline (`op read` prints one). The
# --json form writes every name in one PATCH, so one release carries them all
# (a key and its PREVIOUS twin must never land apart).
#
# REFUSES an empty value, a JSON null and a malformed name before any network
# call: an empty stdin is what a failed read produces, and writing it would blank
# the var on the app.
#
# Token: HEROKU_API_KEY when set, else `heroku auth:token` (read from its stdout).
# The API answers with EVERY config var on the app, secrets included, so the body
# is discarded; only the HTTP status is printed. HEROKU_API_BASE overrides the API
# host for tests, and only to a loopback http:// address: any other base is
# refused before the token is read, so the bearer token can only ever be sent to
# https://api.heroku.com or this machine (secrets-scrub-follow-ups, N6).
#
# Exit: 0 the API answered 200 · 1 refused or the API said otherwise · 2 usage.
require "json"
require "net/http"
require "open3"
require "optparse"
require "uri"

NAME = /\A[A-Z][A-Z0-9_]*\z/

def refuse(message)
  warn "heroku-secret-set: refusing — #{message}. NOTHING WAS SET."
  exit 1
end

json = false
parser = OptionParser.new do |o|
  o.banner = "usage: <producer> | bin/heroku-secret-set <app> <NAME>\n" \
             "       <producer> | bin/heroku-secret-set <app> --json"
  o.on("--json", "stdin is a JSON object of NAME => value, written in one release") { json = true }
  o.on("-h", "--help", "print this help") do
    puts o
    puts "heroku-secret-set: help only. SETS NOTHING: no stdin read, no Heroku call."
    exit 0
  end
end

begin
  args = parser.parse(ARGV)
rescue OptionParser::ParseError => e
  warn "heroku-secret-set: #{e.message}\n#{parser}"
  exit 2
end

expected = json ? 1 : 2
unless args.length == expected
  warn "heroku-secret-set: expected #{expected == 1 ? '<app> --json' : '<app> <NAME>'}, got #{args.length} argument(s)\n#{parser}"
  exit 2
end
app = args[0]
refuse("#{app.inspect} is not a Heroku app name") unless app.match?(/\A[a-z][a-z0-9-]{1,29}\z/)

input = $stdin.read.to_s
vars =
  if json
    begin
      parsed = JSON.parse(input)
    rescue JSON::ParserError
      refuse("stdin is not JSON")
    end
    refuse("stdin JSON must be an object of NAME => value") unless parsed.is_a?(Hash) && !parsed.empty?
    parsed
  else
    { args[1] => input.delete_suffix("\n") }
  end

vars.each do |name, value|
  refuse("#{name.inspect} is not an env-var name") unless name.is_a?(String) && name.match?(NAME)
  refuse("#{name} has no value (an empty read would blank it on #{app})") unless value.is_a?(String) && !value.empty?
end

# The only API hosts the token may travel to: the real Platform API over TLS,
# or a loopback stand-in (tests). Checked before the token is read.
API_BASE = "https://api.heroku.com"
LOOPBACK = %w[127.0.0.1 localhost ::1 [::1]].freeze
base = ENV.fetch("HEROKU_API_BASE", API_BASE)
begin
  base_uri = URI(base)
rescue URI::InvalidURIError
  refuse("HEROKU_API_BASE is not a URL")
end
real = base_uri.scheme == "https" && base_uri.host.to_s.downcase == "api.heroku.com" && base_uri.port == 443
local = base_uri.scheme == "http" && LOOPBACK.include?(base_uri.host.to_s.downcase)
clean = base_uri.userinfo.nil? && base_uri.query.nil? && base_uri.fragment.nil? && ["", "/"].include?(base_uri.path)
unless (real || local) && clean
  refuse("HEROKU_API_BASE may name only #{API_BASE} or a loopback http:// stand-in, so the token cannot be sent elsewhere")
end

token = ENV["HEROKU_API_KEY"].to_s
if token.empty?
  out, status = Open3.capture2("heroku", "auth:token", err: File::NULL)
  token = out.strip if status.success?
end
refuse("no Heroku token: set HEROKU_API_KEY (source ~/.zprofile) or log in with the heroku CLI") if token.empty?

uri = URI("#{base.chomp('/')}/apps/#{app}/config-vars")
request = Net::HTTP::Patch.new(uri)
request["Accept"] = "application/vnd.heroku+json; version=3"
request["Content-Type"] = "application/json"
request["Authorization"] = "Bearer #{token}"
request.body = JSON.generate(vars)

begin
  response = Net::HTTP.start(uri.host, uri.port, use_ssl: uri.scheme == "https", open_timeout: 15, read_timeout: 60) do |http|
    http.request(request)
  end
rescue StandardError => e
  refuse("the Heroku API was unreachable (#{e.class})")
end

names = vars.keys.join(", ")
if response.code == "200"
  puts "#{app}: set #{names} (HTTP 200, one release)"
else
  warn "heroku-secret-set: #{app}: HTTP #{response.code} setting #{names}; nothing is certain to have changed. Body withheld."
  exit 1
end
