<%# locals: (request_row:, messages:) %>
<%#
  The lower half of the /build shell on a draft (agent_chats/_shell): Ray's thread,
  then the chat box (the shared agent_chats composer). BuildController#show renders
  it, and #create streams it in place of /build's empty thread (id build-chat-page),
  so the first message never leaves the page. A signed-out visitor has no /cable
  socket, so the page POLLS for answers (app/javascript/build_chat.js reads
  data-build-chat-poll-url and asks about every turn still pending). Cards render
  inside their turn (build/_turn). The log reuses AgentMessages::WebChat::MESSAGES_TARGET
  (a cto-chat-* id, as agent_chats/_chat does), so ONE PAGE HOLDS ONE CHAT.
%>
<div id="build-chat-page" class="flex flex-col gap-3" data-test="build-chat-page"
     data-build-chat data-build-chat-poll-url="<%= build_request_turns_path(request_row.token) %>">
  <div id="<%= AgentMessages::WebChat::MESSAGES_TARGET %>" role="log" aria-live="polite" aria-label="Conversation with <%= BuildController::AGENT_NAME %>"
       class="flex flex-col gap-4 px-1 py-2 overflow-y-auto max-h-[60vh]" data-test="build-chat-messages" data-cto-chat-scroll>
    <p class="hidden only:block text-center text-secondary text-sm py-6" data-test="build-chat-empty">Tell <%= BuildController::AGENT_NAME %> what you want to build.</p>
    <% messages.each do |message| %>
      <%= render "build/turn", message: message, request_row: request_row %>
    <% end %>
  </div>
  <%= render "agent_chats/form", **composer_locals %>
</div>
